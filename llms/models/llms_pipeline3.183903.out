      }
    }
  },
  "AND": {
    "left": {
      "raw_text": "Questionable validity of consent: Subjects with a history of psychiatric disease, intellectual deficiency, poor motivation or other conditions that will limit the validity of informed consent to participate in the study or the potential compliance to study procedures."
