  "{\n  \"AND\": {\n    \"left\": {\n      \"OR\": {\n        \"left\": {\n          \"raw_text\": \"Patient has been permanently discontinued from pasireotide study treatment in the parent study due to unacceptable toxicity, non-compliance to study procedures, withdrawal of consent or any other reason\"\n        },\n        \"right\": {\n          \"AND\": {\n            \"left\": {\n              \"raw_text\": \"Patient has participated in a Novartis sponsored combination trial where pasireotide was dispensed in combination with another study medication and is still receiving combination therapy.\"\n            },\n            \"right\": {\n              \"NOT\": {\n                \"raw_text\": \"(only patients receiving pasireotide monotherapy can be included)\"\n              }\n            }\n          }\n        }\n      }\n    },\n    \"right\": {\n      \"AND\": {\n        \"left\": {\n          \"OR\": {\n            \"left\": {\n              \"raw_text\": \"Pregnant or nursing (lactating) women, where pregnancy is defined as the state of a female after conception and until the termination of gestation, confirmed by a positive hCG laboratory test\"\n            },\n            \"right\": {\n              \"raw_text\": \"Total abstinence (when this is in line with the preferred and usual lifestyle of the subject. Periodic abstinence (e.g., calendar, ovulation, symptothermal, post-ovulation methods) and withdrawal are not acceptable methods of contraception\"\n            }\n          }\n        },\n        \"right\": {\n          \"AND\": {\n            \"left\": {\n              \"OR\": {\n                \"left\": {\n                  \"raw_text\": \"Female sterilization (have had surgical bilateral oophorectomy with or without hysterectomy) or tubal ligation at least six weeks before taking study treatment.\"\n                },\n                \"right\": {\n                  \"AND\": {\n                    \"left\": {\n                      \"raw_text\": \"In case of oophorectomy alone, only when the reproductive status of the woman has been confirmed by follow up hormone level assessment\"\n                    },\n                    \"right\": {\n                      \"OR\": {\n                        \"left\": {\n                          \"raw_text\": \"Male sterilization (at least 6 months prior to screening).\"\n                        },\n                        \"right\": {\n                          \"AND\": {\n                            \"left\": {\n                              \"raw_text\": \"For female subjects on the study the vasectomized male partner should be the sole partner for that subject.\"\n                            },\n                            \"right\": {\n                              \"OR\": {\n                                \"left\": {\n                                  \"raw_text\": \"Use of oral, injected or implanted hormonal methods of contraception or other forms of hormonal contraception that have comparable efficacy (failure rate <1%), for example hormone vaginal ring or transdermal hormone contraception\"\n                                },\n                                \"right\": {\n                                  \"AND\": {\n                                    \"left\": {\n                                      \"raw_text\": \"Placement of an intrauterine device (IUD) or intrauterine system (IUS)\"\n                                    },\n                                    \"right\": {\n                                      \"OR\": {\n                                        \"left\": {\n                                          \"raw_text\": \"Barrier methods of contraception: Condom or Occlusive cap diaphragm or cervical/vault caps) with spermicidal foam/gel/film/cream/vaginal suppository\"\n                                        },\n                                        \"right\": {\n                                          \"AND\": {\n                                            \"left\": {\n                                              \"raw_text\": \"In case of use of oral contraception women should have been stable on the same pill for a minimum of 3 months before taking study treatment\"\n                                            },\n                                            \"right\": {\n                                              \"OR\": {\n                                                \"left\": {\n                                                  \"raw_text\": \"Sexually active males unless they use a condom during intercourse while taking drug and for 1 months after pasireotide s.c. last dose and 3 months after pasireotide LAR last dose and should not father a child in this period.\"\n                                                },\n                                                \"right\": {\n                                                  \"AND\": {\n                                                    \"left\": {\n                                                      \"raw_text\": \"A condom is required to be used also by vasectomized men in order to prevent delivery of the drug via seminal fluid\"\n                                                    },\n                                                    \"right\": {\n                                                      \"AND\": {\n                                                        \"left\": {\n                                                          \"raw_text\": \"If a study patient or partner becomes pregnant or suspects being pregnant during the study or within 1 month after the final dose of pasireotide s.c. or 3 months after the final dose of pasireotide LAR, the Study Doctor needs to be informed immediately and ongoing study treatment with pasireotide has to be stopped immediately\"\n                                                        },\n                                                        \"right\": {\n                                                          \"AND\": {\n                                                            \"left\": {\n                                                              \"raw_text\": \"For patients taking pasireotide LAR, the future dose injections will be cancelled.\"\n                                                            }\n                                                          }\n                                                        }\n                                                      }\n                                                    }\n                                                  }\n                                                }\n                                              }\n                                            }\n                                          }\n                                        }\n                                      }\n                                    }\n                                  }\n                                }\n                              }\n                            }\n                          }\n                        }\n                      }\n                    }\n                  }\n                }\n              }\n            }\n          }\n        }\n      }\n    }\n  }\n}" 

