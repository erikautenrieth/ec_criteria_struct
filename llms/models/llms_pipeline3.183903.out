ects deemed to be healthy as judged by the Medically Accountable Investigator (MAI) and determined by medical history, physical examination and medication history\"\n                                }\n                              }\n                            },\n                            \"right\": {\n                              \"AND\": {\n                                \"left\": {\n                                  \"NOT\": {\n                                    \"left\": {\n                                      \"OR\": {\n                                        \"left\": {\n                                          \"raw_text\": \"ongoing acute or intermittent pain\"\n                                        },\n                                        \"right\": {\n                                          \"OR\": {\n                                            \"left\": {\n                                              \"raw_text\": \"postoperative pain\"\n                                            },\n                                            \"right\": {\n                                              \"OR\": {\n                                                \"left\": {\n                                                  \"raw_text\": \"respiratory compromise\"\n                                                },\n                                                \"right\": {\n                                                  \"OR\": {\n                                                    \"left\": {\n                                                      \"raw_text\": \"acute or severe asthma\"\n                                                    },\n                                                    \"right\": {\n                                                      \"raw_text\": \"or constipation (less than 1 bowel movement every 2 days)\"\n                                                    }\n                                                  }\n       