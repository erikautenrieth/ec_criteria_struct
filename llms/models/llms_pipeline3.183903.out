itive serum pregnancy test\"\n                                                                                                },\n                                                                                                \"right\": {\n                                                                                                  \"OR\": {\n                                                                                                    \"left\": {\n                                                                                                      \"raw_text\": \"Subjects unwilling to use acceptable methods of contraception.\"\n                                                                                                    },\n                                                                                                    \"right\": {\n                                                                                                      \"OR\": {\n                                                                                                        \"left\": {\n                                                                                                          \"raw_text\": \"Female subjects should refrain from breastfeeding throughout this period.\"\n                                                                                                        },\n                                                                                                        \"right\": {\n                                                                                                          \"OR\": {\n                                                                                                            \"left\": {\n                                                                                                              \"raw_text\": \"Any condition that, in the clinical judgment of the treating physician, is likely to prevent the subject from complyi