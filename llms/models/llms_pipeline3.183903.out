      "raw_text": "End stage chronic renal disease: Subjects will be excluded if on renal replacement therapy (hemodialysis or peritoneal)."
    },
    "right": {
      "AND": {
        "left": {
          "raw_text": "Drug/food allergy: Subjects with a history of hypersensitivity to any of the study medications (e.g. beta-agonists, corticosteroid) or components of the inhalation powder (e.g. lactose, magnesium stearate)."
        },
        "right": {
