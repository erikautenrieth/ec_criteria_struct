n                                    \"left\": {\n                                      \"raw_text\": \"The participant has received transcranial magnetic stimulation within 6 months.\"\n                                    },\n                                    \"right\": {\n                                      \"OR\": {\n                                        \"left\": {\n                                          \"raw_text\": \"The participant has received selegiline, pethidine, tramadol, reserpine or methyldopa within 90 days.\"\n                                        },\n                                        \"right\": {\n                                          \"OR\": {\n                                            \"left\": {\n                                              \"raw_text\": \"The participant has received levodopa monotherapy, any psychoneurotic agent or antiemetic medication of dopamine agonist within 14 days.\"\n                                            },\n                                            \"right\": {\n                                              \"OR\": {\n                                                \"left\": {\n                                                  \"raw_text\": \"However, the participant has been receiving quetiapine or domperidone with a stable dose regimen for >= 14 days may be included in the study.\"\n                                                },\n                                                \"right\": {\n                                                  \"OR\": {\n                                                    \"left\": {\n                                                      \"raw_text\": \"The participant is required to take any of the excluded medications or treatments.\"\n                                                    },\n                                                    \"right\": {\n                                                      \"OR\": {\n                              