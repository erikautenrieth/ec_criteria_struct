dy result within 3 months of screening\"\n                                    }\n                                  }\n                                }\n                              }\n                            },\n                            \"right\": {\n                              \"AND\": {\n                                \"left\": {\n                                  \"OR\": {\n                                    \"left\": {\n                                      \"raw_text\": \"Urinary cotinine levels indicative of smoking\"\n                                    },\n                                    \"right\": {\n                                      \"OR\": {\n                                        \"left\": {\n                                          \"raw_text\": \"or history or regular use of tobacco- or nicotine-containing products within 6 months prior to screening.\"\n                                        }\n                                      }\n                                    }\n                                  }\n                                },\n                                \"right\": {\n                                  \"AND\": {\n                                    \"left\": {\n                                      \"raw_text\": \"A positive pre-study drug/alcohol screen.\"\n                                    },\n                                    \"right\": {\n                                      \"AND\": {\n                                        \"left\": {\n                                          \"OR\": {\n                                            \"left\": {\n                                              \"raw_text\": \"A positive test for Human Immunodeficiency Virus (HIV) antibody.\"\n                                            }\n                                          }\n                                        },\n                                        \"right\": {\n                                      