  "{\n  \"OR\": {\n    \"left\": {\n      \"AND\": {\n        \"left\": {\n          \"raw_text\": \"Congestive heart failure;\"\n        },\n        \"right\": {\n          \"raw_text\": \"2. CABG or Percutaneous Coronary Intervention (PCI) procedure;\"\n        }\n      }\n    },\n    \"right\": {\n      \"AND\": {\n        \"left\": {\n          \"raw_text\": \"3. Planned need for major surgery (e.g. valve surgery or resection of aortic or left ventricular aneurysm, carotid end-arterectomy, abdominal aortic aneurysm surgery etc.);\"\n        },\n        \"right\": {\n          \"OR\": {\n            \"left\": {\n              \"raw_text\": \"4. Congenital heart disease;\"\n            },\n            \"right\": {\n              \"AND\": {\n                \"left\": {\n                  \"raw_text\": \"5. Transmural myocardial infarction within the previous seven days and CK has not returned to normal;\"\n                },\n                \"right\": {\n                  \"OR\": {\n                    \"left\": {\n                      \"raw_text\": \"6. Chest pain lasting longer than 30 minutes within 12 hours pre-procedure, if CK enzymes positive (≥ 2x the normal upper limit).\"\n                    }\n                  }\n                }\n              }\n            }\n          }\n        }\n      }\n    },\n    \"right\": {\n      \"AND\": {\n        \"left\": {\n          \"raw_text\": \"7. History of any cerebrovascular accident;\"\n        },\n        \"right\": {\n          \"OR\": {\n            \"left\": {\n              \"raw_text\": \"8. Left main stenosis of 50% or more;\"\n            },\n            \"right\": {\n              \"AND\": {\n                \"left\": {\n                  \"raw_text\": \"9. Intention to treat more than 1 totally occluded major epicardial vessel;\"\n                },\n                \"right\": {\n                  \"raw_text\": \"10. Single vessel (single territory) disease.\"\n                }\n              }\n            }\n          }\n        }\n      }\n    }\n  }\n}" 

