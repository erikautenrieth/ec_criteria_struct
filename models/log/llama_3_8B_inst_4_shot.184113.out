          "raw_text": "Total occluded vessels. One total occluded major epicardial vessel or side branch can be included and targeted as long as one other major vessel has a significant stenosis amenable for SA, provided the age of occlusion is less than one month e.g. recent instability, infarction with ECG changes in the area subtended by the occluded vessel",
          "Condition": ["total occluded vessels"],
          "Qualifier": ["one total occluded major epicardial vessel", "one other major vessel", "significant stenosis amenable for SA", "recent instability", "infarction with ECG changes"]
        },
        {
          "raw_text": "Patients with total occluded vessels of unknown duration or existing longer than one month and a reference over 1.50 mm should not be included, not even as a third or fourth vessel to be dilated",
          "Condition": ["total occluded vessels"],
          "Qualifier": ["unknown duration", "existing longer than one month", "reference over 1.50 mm"]
        }
      ]
    },
    {
      "AND": [
        {
          "raw_text": "Significant stenosis has been defined as a stenosis of more than 50% in luminal diameter (in at least one view, on visual interpretation or preferably by QCA",
          "Condition": ["significant stenosis"],
          "Qualifier": ["50% in luminal diameter", "at least one view", "on visual interpretation", "preferably by QCA"]
        }
      ]
    }
