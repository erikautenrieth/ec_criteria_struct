  "{\n  \"AND\": {\n    \"left\": {\n      \"OR\": {\n        \"left\": {\n          \"raw_text\": \"1. Must have given written informed consent (signed and dated) and any authorizations required by local law\"\n        },\n        \"right\": {\n          \"OR\": {\n            \"left\": {\n              \"raw_text\": \"2. 18 to 75 years old (inclusive)\"\n            },\n            \"right\": {\n              \"OR\": {\n                \"left\": {\n                  \"raw_text\": \"3. Male or female with a diagnosis of PBC, by at least two of the following criteria:\"\n                },\n                \"right\": {\n                  \"OR\": {\n                    \"left\": {\n                      \"raw_text\": \"History of AP above ULN for at least six months\"\n                    },\n                    \"right\": {\n                      \"OR\": {\n                        \"raw_text\": \"Positive Anti-Mitochondrial Antibodies (AMA) titers (>1/40 on immunofluorescence or M2 positive by enzyme linked immunosorbent assay (ELISA) or positive PBC-specific antinuclear antibodies\"\n                    },\n                    \"right\": {\n                      \"OR\": {\n                        \"raw_text\": \"Documented liver biopsy result consistent with PBC\"\n                    }\n                  }\n                }\n            }\n          }\n        },\n        \"right\": {\n          \"AND\": {\n            \"left\": {\n              \"OR\": {\n                \"left\": {\n                  \"raw_text\": \"4. On a stable and recommended dose of UDCA for the past twelve months\"\n                },\n                \"right\": {\n                  \"OR\": {\n                    \"left\": {\n                      \"raw_text\": \"5. AP ≥ 1.67 × ULN\"\n                    },\n                    \"right\": {\n                      \"OR\": {\n                        \"left\": {\n                          \"raw_text\": \"6. For females of reproductive potential, use of at least one barrier contraceptive and a second effective birth control method during the study and for at least two weeks after the last dose. For male subjects, use of appropriate contraception (e.g., condoms), so their female partners of reproductive potential do not become pregnant during the study and for at least two weeks after the last dose.\"\n                        }\n                    }\n                  }\n                }\n            }\n          }\n        }\n      }\n  }\n}" 

