"right\": {\n                                          \"OR\": {\n                                            \"left\": {\n                                              \"raw_text\": \"7. When available, subjects will be screened for stability of blood CD4 and HIV RNA levels.\"\n                                            }\n                                          }\n                                        }\n                                    }\n                                }\n                            }\n                          }\n                        }\n                      }\n                    }\n                  }\n                }\n              }\n            }\n          }\n        }\n      }\n  }\n}" 

