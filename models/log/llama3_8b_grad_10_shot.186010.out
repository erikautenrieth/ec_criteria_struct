 {\n                                  \"OR\": {\n                                    \"left\": {\n                                      \"raw_text\": \"Three or more failed trials of pharmacotherapy for the current GAD episode\"\n                                    },\n                                    \"right\": {\n                                      \"OR\": {\n                                        \"left\": {\n                                          \"raw_text\": \"Recently commenced psychotherapy (within four weeks of study entry)\"\n                                        }\n                                      }\n                                    }\n                                  }\n                                }\n                            }\n                          }\n                        }\n                      }\n                    }\n                }\n              }\n            }\n          }\n        }\n      }\n    }\n  }\n}" 

