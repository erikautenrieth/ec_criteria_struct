  "{\n  \"AND\": {\n    \"left\": {\n      \"AND\": {\n        \"left\": {\n          \"raw_text\": \"Adult (= 18 years old) subjects\"\n        },\n        \"right\": {\n          \"AND\": {\n            \"left\": {\n              \"raw_text\": \"with chronic genotype 1 HCV\"\n            },\n            \"right\": {\n              \"AND\": {\n                \"left\": {\n                  \"raw_text\": \"and NCI with a GDS greater than or equal to 0.5\"\n                },\n                \"right\": {\n                  \"raw_text\": \"(n=60).\"\n                }\n              }\n            }\n          }\n        }\n      }\n    },\n    \"right\": {\n      \"AND\": {\n        \"left\": {\n          \"OR\": {\n            \"left\": {\n              \"raw_text\": \"Presence of chronic HCV infection based on chart review will be defined as positive for anti-HCV antibody\"\n            },\n            \"right\": {\n              \"raw_text\": \"or HCV RNA at least 6 months before screening.\"\n            }\n          }\n        },\n        \"right\": {\n          \"AND\": {\n            \"left\": {\n              \"raw_text\": \"For the HIV/HCV co-infected group only, subjects must have HIV.\"\n            },\n            \"right\": {\n              \"AND\": {\n                \"left\": {\n                  \"raw_text\": \"HIV status will be obtained through self report.\"\n                },\n                \"right\": {\n                  \"AND\": {\n                    \"left\": {\n                      \"raw_text\": \"Self report will be confirmed at screening using a HIV-1 point of care test.\"\n                    },\n                    \"right\": {\n                      \"AND\": {\n                        \"left\": {\n                          \"raw_text\": \"In the event that point of care test and self-report are discordant, then HIV status will be confirmed by a licensed Western blot or a second antibody test.\"\n                        }\n          