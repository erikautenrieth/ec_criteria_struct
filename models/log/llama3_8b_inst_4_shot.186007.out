  "{\n  \"AND\": {\n    \"left\": {\n      \"AND\": {\n        \"left\": {\n          \"raw_text\": \"Histological confirmation of relapsed/refractory diffuse large B-cell lymphoma\"\n        },\n        \"right\": {\n          \"AND\": {\n            \"left\": {\n              \"raw_text\": \"after prior rituximab and anthracycline-containing systemic treatment regimen such as R-CHOP\"\n            },\n            \"right\": {\n              \"OR\": {\n                \"left\": {\n                  \"raw_text\": \"R-EPOCH\"\n                },\n                \"right\": {\n                  \"OR\": {\n                    \"left\": {\n                      \"raw_text\": \"R-HyperCVAD\"\n                    },\n                    \"right\": {\n                      \"raw_text\": \"etc.\"\n                    }\n                  }\n                }\n              }\n            }\n          }\n        }\n      },\n      \"right\": {\n        \"AND\": {\n          \"left\": {\n            \"raw_text\": \"Subjects must have received no more than 2 prior systemic therapies for lymphoma.\"\n          },\n          \"right\": {\n            \"AND\": {\n              \"left\": {\n                \"raw_text\": \"Prior therapy with systemic rituximab monotherapy or conventional chemotherapy (i.e. bendamustine, CVP\"\n                },\n                \"right\": {\n                  \"OR\": {\n                    \"left\": {\n                      \"raw_text\": \"± rituximab for indolent non-Hodgkin's lymphoma (NHL) ± maintenance/extended-use rituximab will count as 1 line of systemic therapy.\"\n                    }\n                  }\n                }\n              }\n            }\n          }\n        }\n      }\n    },\n    \"right\": {\n      \"AND\": {\n        \"left\": {\n          \"raw_text\": \"Eastern Cooperative Oncology Group (ECOG) Performance status ≤ 2\"\n        },\n        \"right\": {\n          \"AND\": {\n            \"left\": {\n              \"raw_text\": \"Subjects must have normal organ and marrow function as defined below:\"\n            },\n            \"right\": {\n              \"AND\": {\n                \"left\": {\n                  \"raw_text\": \"Hemoglobin ≥ 8.0 g/dl\"\n                },\n                \"right\": {\n                  \"AND\": {\n                    \"left\": {\n                      \"raw_text\": \"Absolute neutrophil count ≥ 1,000/mcL\"\n                    },\n                    \"right\": {\n                      \"AND\": {\n                        \"left\": {\n                          \"raw_text\": \"Platelet count ≥ 75,000/mcL\"\n                        },\n                        \"right\": {\n                          \"AND\": {\n                            \"left\": {\n                              \"raw_text\": \"Total bilirubin ≤ 1.5 X the upper limit of normal (ULN) unless a known history of impaired bilirubin conjugation such as Gilbert's, for whom the maximum will be 2.5 ULN.\"\n                            },\n                            \"right\": {\n                              \"AND\": {\n                                \"left\": {\n                                  \"raw_text\": \"Aspartate transaminase (AST) (SGOT) ≤ 2.5 X institutional ULN\"\n                                },\n                                \"right\": {\n                                  \"AND\": {\n                                    \"left\": {\n                                      \"raw_text\": \"Alanine transaminase (ALT) (SGPT) ≤ 2.5 X institutional ULN\"\n                                    },\n                                    \"right\": {\n                                      \"raw_text\": \"International normalized ratio (INR) > 1.5 ×ULN\"\n                                    }\n                                  }\n                                }\n                              }\n                            }\n                          }\n                        }\n                      }\n                    }\n                  }\n                }\n              }\n            }\n          }\n        }\n      }\n    }\n  }\n}" 

