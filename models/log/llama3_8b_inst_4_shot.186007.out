 }\n                              }\n                            }\n                          }\n                        }\n                      }\n                    },\n                    \"right\": {\n                      \"AND\": {\n                        \"left\": {\n                          \"OR\": {\n                            \"left\": {\n                              \"raw_text\": \"Systolic pulmonary artery pressure (SPAP) >40 mmHg (and/or tricuspid regurgitation [TR] jet velocity >2.9 m/s)\"\n                            },\n                            \"right\": {\n                              \"raw_text\": \"In cases where an actual SPAP value is not measurable due to lack of adequate TR jet, the pulmonary flow acceleration time measured at the right ventricular outflow tract (RVOTAT) will be used to assess eligibility. Participants with a RVOTAT =100 milliseconds (msec) will be excluded, suggesting an elevated mean SPAP; eligibility for the those participants with RVOTAT between 100 and 120 msec will be determined based on combined assessment of the TR jet, septal motion, and right ventricular size.\"\n                            }\n                          }\n                        },\n                        \"right\": {\n                          \"OR\": {\n                            \"left\": {\n                              \"raw_text\": \"Left ventricular ejection fraction <45%\"\n                            },\n                            \"right\": {\n                              \"OR\": {\n                                \"left\": {\n                                  \"raw_text\": \"Intracardiac mass, tumor, or thrombus\"\n                                },\n                                \"right\": {\n                                  \"OR\": {\n                                    \"left\": {\n                                      \"raw_text\": \"Evidence of congenital heart disease\"\n                                    },\n     