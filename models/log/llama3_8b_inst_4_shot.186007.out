ho is unmarried or dose not bear child\"\n                                                                                },\n                                                                                \"right\": {\n                                                                                  \"OR\": {\n                                                                                    \"left\": {\n                                                                                      \"raw_text\": \"17. Subject with life expectancy less than 6 months as assessed by investigators\"\n                                                                                    },\n                                                                                    \"right\": {\n                                                                                      \"OR\": {\n                                                                                        \"left\": {\n                                                                                          \"raw_text\": \"18. Subject participated in any other clinical trial within the previous three months\"\n                                                                                        },\n                                                                                        \"right\": {\n                                                                                          \"OR\": {\n                                                                                            \"left\": {\n                                                                                              \"raw_text\": \"19. Subject with previous history of tumor, or current tumor patient, or subject with pre-cancerous disease manifested by pathological examination (such as ductal carcinoma in situ or cervical epithelial dysplasia)\"\n                                                                                            },\n 