  "{\n  \"AND\": {\n    \"left\": {\n      \"OR\": {\n        \"left\": {\n          \"raw_text\": \"Prior exposure to doxorubicin, PLD or any other anthracycline, motolimod and other TLR agonists, MEDI4736 or checkpoint inhibitors, such as anti-CTLA4 and anti-PD1/anti-PD-L1 antibodies.\"\n        },\n        \"right\": {\n          \"OR\": {\n            \"left\": {\n              \"raw_text\": \"Subjects with platinum-refractory disease, defined as disease progression while receiving first line platinum-based therapy.\"\n            },\n            \"right\": {\n              \"OR\": {\n                \"left\": {\n                  \"raw_text\": \"Clinically significant persistent immune-related adverse events following prior therapy.\"\n                },\n                \"right\": {\n                  \"OR\": {\n                    \"left\": {\n                      \"raw_text\": \"Subjects with history or evidence upon physical examination of CNS disease, including primary brain tumor, seizures not controlled with standard medical therapy, any brain metastases, or, within six months prior to Day 1 of this study, history of cerebrovascular accident (CVA, stroke), transient ischemic attack (TIA) or subarachnoid hemorrhage.\"\n                    },\n                    \"right\": {\n                      \"OR\": {\n                        \"left\": {\n                          \"raw_text\": \"Subjects with clinically significant cardiovascular disease. This includes:\"\n                        },\n                        \"right\": {\n                          \"OR\": {\n                            \"left\": {\n                              \"raw_text\": \"1. Resisted hypertension\"\n                            },\n                            \"right\": {\n                              \"OR\": {\n                                \"left\": {\n                                  \"raw_text\": \"2. Myocardial infarction or unstable angina within 6 months prior to Day 1 of the study.\"\n                                },\n                                \"right\": {\n                                  \"OR\": {\n                                    \"left\": {\n                                      \"raw_text\": \"3. History of serious ventricular arrhythmia (i.e., ventricular tachycardia or ventricular fibrillation) or cardiac arrhythmias requiring anti-arrhythmic medications, except for atrial fibrillation that is well controlled with anti-arrhythmic medication.\"\n                                    },\n                                    \"right\": {\n                                      \"OR\": {\n                                        \"left\": {\n                                          \"raw_text\": \"4. Baseline ejection fraction ≤ 50% as assessed by echocardiogram or MUGA.\"\n                                        },\n                                        \"right\": {\n                                          \"OR\": {\n                                            \"left\": {\n                                              \"raw_text\": \"5. New York Heart Association (NYHA) Class II or higher congestive heart failure.\"\n                                            },\n                                            \"right\": {\n                                              \"OR\": {\n                                                \"left\": {\n                                                  \"raw_text\": \"6. Grade 2 or higher peripheral ischemia, except for brief (< 24 hrs) episodes of ischemia managed non-surgically and without permanent deficit.\"\n                                                },\n                                                \"right\": {\n                                                  \"OR\": {\n                                                    \"left\": {\n                                                      \"raw_text\": \"History of pneumonitis or interstitial lung disease.\"\n                                                    },\n                                                    \"right\": {\n                                                      \"OR\": {\n                                                        \"left\": {\n                                                          \"raw_text\": \"Active, suspected or prior documented autoimmune disease (including inflammatory bowel disease, celiac disease, Wegner's granulomatosis, active Hashimoto's thyroiditis, rheumatoid arthritis, lupus, scleroderma and its variants, multiple sclerosis, myasthenia gravis). Vitiligo, type I diabetes mellitus, residual hypothyroidism due to autoimmune condition only requiring hormone replacement, psoriasis not requiring systemic treatment, or conditions not expected to recur in the absence of an external trigger are permitted.\"\n                                                        },\n                                                        \"right\": {\n                                                          \"OR\": {\n                                                            \"left\": {\n                                                              \"raw_text\": \"Other malignancy within 2 years prior to Day 1 of the study, except for those treated with surgical intervention only.\"\n                                                            },\n                                                            \"right\": {\n                                                              \"OR\": {\n                                                                \"left\": {\n                                                                  \"raw_text\": \"Subjects with clinical symptoms or signs of gastrointestinal obstruction and/or who require drainage gastrostomy tube and/or parenteral hydration or nutrition.\"\n                                                                },\n                                                                \"right\": {\n                                                                  \"OR\": {\n                                                                    \"left\": {\n                                                                      \"raw_text\": \"Known immunodeficiency or HIV, Hepatitis B or Hepatitis C positivity.\"\n                                                                    },\n                                                                    \"right\": {\n                                                                      \"OR\": {\n                                                                        \"left\": {\n                                                                          \"raw_text\": \"History of severe allergic reactions to any unknown allergens or components of the study drugs.\"\n                                                                        },\n                                                                        \"right\": {\n                                                                          \"OR\": {\n                                                                            \"left\": {\n                                                                              \"raw_text\": \"Other serious illnesses (e.g., serious infections requiring antibiotics, bleeding disorders).\"\n                                                                            },\n                                                                            \"right\": {\n                                                                              \"OR\": {\n                                                                                \"left\": {\n                                                                                  \"raw_text\": \"Prior treatment in any other interventional clinical trial within 4 weeks prior to Day 1 of the study.\"\n                                                                                },\n                                                                                \"right\": {\n                                                                                  \"OR\": {\n                                                                                    \"left\": {\n                                                                                      \"raw_text\": \"Mental impairment that may compromise compliance with the requirements of the study.\"\n                                                                                    },\n                                                                                    \"right\": {\n                                                                                      \"OR\": {\n                                                                                        \"left\": {\n                                                                                          \"raw_text\": \"Lack of availability for immunological and clinical follow-up assessment.\"\n                                                                                        },\n                                                                                        \"right\": {\n                                                                                          \"OR\": {\n                                                                                            \"left\": {\n                                                                                              \"raw_text\": \"Women who are breastfeeding or pregnant as evidenced by positive serum pregnancy test\"\n                                                                                            },\n                                                                                            \"right\": {\n                                                                                              \"OR\": {\n                                                                                                \"left\": {\n                                                                                                  \"raw_text\": \"Subjects unwilling to use acceptable methods of contraception.\"\n                                                                                                },\n                                                                                                \"right\": {\n                                                                                                  \"OR\": {\n                                                                                                    \"left\": {\n                                                                                                      \"raw_text\": \"Female subjects should refrain from breastfeeding throughout this period.\"\n                                                                                                    },\n                                                                                                    \"right\": {\n                                                                                                      \"OR\": {\n                                                                                                        \"left\": {\n                                                                                                          \"raw_text\": \"Any condition that, in the clinical judgment of the treating physician, is likely to prevent the subject from complying with any aspect of the protocol or that may put the subject at unacceptable risk.\"\n                                                                                                        },\n                                                                                                        \"right\": {\n                                                                                                          \"OR\": {\n                      