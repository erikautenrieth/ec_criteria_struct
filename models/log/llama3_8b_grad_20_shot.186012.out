 {\n                          \"AND\": {\n                            \"left\": {\n                              \"raw_text\": \"Patients with a history of, or at imminent risk for, colectomy; who required gastrointestinal surgery within 2 months before screening;\"\n                            }\n                          }\n                        }\n                      }\n                    }\n                  }\n                }\n              }\n            }\n          }\n        }\n      }\n    },\n    \"right\": {\n      \"AND\": {\n        \"left\": {\n          \"OR\": {\n            \"left\": {\n              \"raw_text\": \"History of colonic mucosal dysplasia or adenomatous colonic polyps that were not removed\"\n            },\n            \"right\": {\n              \"OR\": {\n                \"left\": {\n                  \"raw_text\": \"Screening stool study positive for enteric pathogens or Clostridium difficile toxin.\"\n                }\n              }\n            }\n          }\n        }\n      }\n    },\n    \"right\": {\n      \"AND\": {\n        \"left\": {\n          \"OR\": {\n            \"left\": {\n              \"raw_text\": \"Oral corticosteroids at a dose >40 mg prednisone or its equivalent per day; receipt of cyclosporine, tacrolimus, sirolimus, or mycophenolate mofetil within 8 weeks before the first study agent injection; or use of an investigational agent within 5 half-lives of that agent before the first study agent injection.\"\n            },\n            \"right\": {\n              \"OR\": {\n                \"raw text\": \"Patients in recent receipt of live vaccinations within 4 weeks prior to enrolment.\"\n              }\n            }\n          }\n        }\n      }\n    }\n  }\n}" 

