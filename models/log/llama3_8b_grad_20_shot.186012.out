rgy to cis-UCA, or any constituents of the placebo emulsion cream or any constituents of Protopic® ointment\"\n            },\n            \"right\": {\n              \"AND\": {\n                \"OR\": {\n                  \"left\": {\n                    \"raw_text\": \"History of any skin-related cancer\"\n                },\n                \"right\": {\n                  \"AND\": {\n                    \"left\": {\n                      \"raw_text\": \"Congenital or acquired immunodeficiency or ongoing therapy that cause immunosuppression\"\n                },\n                \"right\": {\n                  \"AND\": {\n                    \"left\": {\n                      \"raw\": \"Earlier participation in a clinical study performed with cis-UCA\"\n                    },\n                    \"right\": {\n                      \"AND\": {\n                        \"left\": {\n                          \"raw\": \"Any clinically significant laboratory test result\"\n                        },\n                        \"right\": {\n                          \"AND\": {\n                            \"left\": {\n                              \"raw\": \"Suspected current drug or alcohol abuse\"\n                            },\n                            \"right\": {\n                              \"AND\": {\n                                \"left\": {\n                                  \"raw\": \"Clinically significant illness during the 4 weeks prior to the first dose administration\"\n                                },\n                                \"right\": {\n                                  \"AND\": {\n                                    \"left\": {\n                                      \"raw\": \"Any other condition that in the opinion of the Investigator would interfere with the evaluation of the study results or constitute a health hazard for the patient\"\n                                    },\n                                    \"right\": {\n     