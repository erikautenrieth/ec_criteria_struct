: {\n                                        \"left\": {\n                                          \"raw_text\": \"Subject has history of previous myocardial infarction or percutaneous intervention during the last three months.\"\n                                        },\n                                        \"right\": {\n                                          \"AND\": {\n                                            \"raw_text\": \"Subject has symptomatic carotid stenosis.\"\n                                            }\n                                          }\n                                        }\n                                      }\n                                    }\n                                  }\n                                }\n                            }\n                        }\n                    }\n                }\n              }\n            }\n          }\n        }\n      }\n    },\n    \"right\": {\n      \"AND\": {\n        \"left\": {\n          \"OR\": {\n            \"left\": {\n              \"raw_text\": \"Subject has chronic obstructive pulmonary disease with detected pulmonary hypertension or any other evidence of significant lung disease.\"\n            },\n            \"right\": {\n              \"AND\": {\n                \"left\": {\n                  \"OR\": {\n                    \"left\": {\n                      \"raw_text\": \"Subject has any contraindication for oral anticoagulation.\"\n                    },\n                    \"right\": {\n                      \"AND\": {\n                        \"left\": {\n                          \"raw_text\": \"Subject has any history of previous transient ischemic attack or stroke.\"\n                        },\n                        \"right\": {\n                          \"AND\": {\n                            \"left\": {\n                              \"raw_text\": \"Subject has known intra-cardiac thrombus formation.\"\n                         