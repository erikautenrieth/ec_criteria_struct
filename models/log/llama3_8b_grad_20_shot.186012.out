  "{\n  \"AND\": {\n    \"left\": {\n      \"OR\": {\n        \"left\": {\n          \"raw_text\": \"Male or female = 18 years of age at Visit 1.\"\n        },\n        \"right\": {\n          \"OR\": {\n            \"left\": {\n              \"raw_text\": \"Sweat chloride equal or greater than 60 mEq/L by quantitative pilocarpine iontophoresis test.\"\n            },\n            \"right\": {\n              \"OR\": {\n                \"left\": {\n                  \"raw_text\": \"Two well-characterized mutations in the cystic fibrosis transmembrane conductance regulator (CFTR) gene.\"\n                },\n                \"right\": {\n                  \"OR\": {\n                    \"left\": {\n                      \"raw_text\": \"Abnormal nasal potential difference (NPD) as measured by a change in NPD in response to a low chloride solution and isoproterenol of less than -5 mV.\"\n                    },\n                    \"right\": {\n                      \"OR\": {\n                        \"left\": {\n                          \"raw_text\": \"Documentation of the presence of an acute pulmonary exacerbation, based on CF Foundation guidelines, as diagnosed by a faculty member of the Denver Adult CF Program.\"\n                        },\n                        \"right\": {\n                          \"OR\": {\n                            \"left\": {\n                              \"raw_text\": \"Respiratory culture(s) demonstrating evidence of Pseudomonas aeruginosa or Achromobacter species airway infection.\"\n                            },\n                            \"right\": {\n                              \"OR\": {\n                                \"left\": {\n                                  \"raw_text\": \"Subject is able to produce sputum, undergo phlebotomy, and provide written consent.\"\n                                },\n                                \"right\": {\n                                  \"AND\": {\n                               