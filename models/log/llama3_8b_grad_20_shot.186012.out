n                                          \"OR\": {\n                                            \"left\": {\n                                              \"raw_text\": \"Planned revascularization of any vessel within 30 days post-index procedure and/or of the target vessel(s) within 12 months post-procedure\"\n                                            },\n                                            \"right\": {\n                                              \"OR\": {\n                                                \"raw text\": \"Anticipated discontinuation of clopidogrel or ticagrelor within the 12 month follow up period, example for elective surgery\"\n                                                }\n                                            }\n                                          }\n                                        }\n                                      }\n                                    }\n                                }\n                            }\n                        }\n                    }\n                }\n            }\n          }\n        }\n      }\n    },\n    \"right\": {\n      \"AND\": {\n        \"left\": {\n          \"OR\": {\n            \"left\": {\n              \"raw text\": \"Serum creatinine >2.5 mg/dL within 7 days of index procedure\"\n            },\n            \"right\": {\n              \"OR\": {\n                \"left\": {\n                  \"raw text\": \"Platelet count <80,000 or >700,000 cells/mm3, or white blood cell count <3,000 cells/mm3 if persistent (at least 2 abnormal values) within 7 days prior to index procedure.\"\n                }\n            }\n          }\n        }\n      }\n    },\n    \"right\": {\n      \"AND\": {\n        \"left\": {\n          \"OR\": {\n            \"left\": {\n              \"raw text\": \"History of intracranial hemorrhage\"\n            },\n            \"right\": {\n              \"OR\": {\n                \"raw text\": \"Known hypersensitivity to clopidogrel or ticagrelor or any of its components\"\n            }\n          }\n        }\n      }\n    },\n    \"right\": {\n      \"AND\": {\n        \"left\": {\n          \"OR\": {\n            \"left\": {\n              \"raw text\": \"Patient is participating in an investigational drug or device clinical trial that has not reached its primary endpoint\"\n            },\n            \"right\": {\n              \"OR\": {\n                \"raw text\": \"Patient previously enrolled in this study\"\n            }\n          }\n        }\n      }\n    },\n    \"right\": {\n      \"AND\": {\n        \"left\": {\n          \"OR\": {\n            \"left\": {\n              \"raw text\": \"Patient is pregnant, lactating, or planning to become pregnant within 12 months\"\n            },\n            \"right\": {\n              \"OR\": {\n                \"raw text\": \"Patient has received an organ transplant or is on a waiting list for an organ transplant\"\n            }\n          }\n        }\n      },\n    \"right\": {\n      \"AND\": {\n        \"left\": {\n          \"OR\": {\n            \"left\": {\n              \"raw text\": \"Patient is receiving or scheduled to receive chemotherapy within 30 days before or after the procedure\"\n            },\n            \"right\": {\n              \"OR\": {\n                \"raw text\": \"Patient is receiving immunosuppressive therapy or has known immunosuppressive or autoimmune disease (e.g., human immunodeficiency virus, systemic lupus erythematous, etc.)\"\n            }\n          }\n        }\n      },\n    \"right\": {\n      \"AND\": {\n        \"left\": {\n          \"OR\": {\n            \"left\": {\n              \"raw text\": \"Patient is receiving chronic oral anticoagulation therapy (i.e., vitamin K antagonist, direct thrombin inhibitor, Factor Xa inhibitor)\"\n            },\n            \"right\": {\n              \"OR\": {\n                \"raw text\": \"Concomitant use of simvastatin/lovastatin >40 mg qd\"\n            }\n          }\n        }\n      },\n    \"right\": {\n      \"AND\": {\n        \"left\": {\n          \"OR\": {\n            \"left\": {\n              \"raw text\": \"Concomitant use of potent CYP3A4 inhibitors (atazanavir, clarithromycin, indinavir, itraconazole, ketoconazole, nefazodone, nelfinavir, ritonavir, saquinavir, telithromycin and voriconazole) or inducers (carbamazepine, dexamethasone, phenobarbital, phenytoin, rifampin, and rifapentine)\"\n            },\n            \"right\": {\n              \"OR\": {\n                \"raw text\": \"Non-cardiac condition limiting life expectancy to less than one year, per physician judgment (e.g. cancer)\"\n            }\n          }\n        }\n      },\n    \"right\": {\n      \"AND\": {\n        \"left\": {\n          \"OR\": {\n            \"left\": {\n              \"raw text\": \"Known history of severe hepatic impairment\"\n            },\n            \"right\": {\n              \"OR\": {\n                \"raw text\": \"Patient has a history of bleeding diathesis or coagulopathy or will refuse blood transfusions\"\n            }\n          }\n        }\n      },\n    \"right\": {\n      \"AND\": {\n        \"left\": {\n          \"OR\": {\n            \"left\": {\n              \"raw text\": \"Patient has an active pathological bleeding, such as active gastrointestinal (GI) bleeding\"\n            },\n            \"right\": {\n              \"OR\": {\n                \"raw text\": \"Inability to take aspirin at a dosage of 100 mg or less\"\n            }\n          }\n        }\n      },\n    \"right\": {\n      \"AND\": {\n        \"left\": {\n          \"OR\": {\n            \"left\": {\n              \"raw text\": \"Current substance abuse (e.g., alcohol, cocaine, heroin, etc.)\"\n            }\n          }\n        }\n      }\n    }\n  }\n}" 

