tered medicinal product within 30 days prior to informed consent.\"\n                    }\n                  }\n                }\n            }\n          }\n        },\n        \"right\": {\n          \"AND\": {\n            \"left\": {\n              \"OR\": {\n                \"left\": {\n                  \"raw text\": \"Any other clinical condition that, in the opinion of the investigator, might pose additional risk to the subject due to participation in the study.\"\n                },\n                \"right\": {\n                  \"OR\": {\n                    \"left\": {\n                      \"raw text\": \"Any history of meningococcal vaccination or meningococcal and gonorrhoea diseases.\"\n                    }\n                  }\n                }\n            }\n          }\n        },\n        \"right\": {\n          \"AND\": {\n            \"left\": {\n              \"OR\": {\n                \"left\": {\n                  \"raw text\": \"Enrolment in any activity requiring a blood donation greater than 50 mL during the period starting 30 days before the first study visit (Day -83, Day -60 or Day -30) or for the duration of the study period.\"\n                },\n                \"right\": {\n                  \"OR\": {\n                    \"raw text\": \"Administration of long-acting immune-modifying drugs at any time during the study period.\"\n                }\n              }\n            }\n          }\n        },\n        \"right\": {\n          \"AND\": {\n            \"left\": {\n              \"OR\": {\n                \"left\": {\n                  \"raw text\": \"Subjects with blood disorders.\"\n                },\n                \"right\": {\n                  \"OR\": {\n                    \"raw text\": \"Subjects with a history of difficulty in providing blood samples.\"\n                }\n              }\n            }\n          }\n        },\n        \"right\": {\n          \"AND\": {\n            \"left\": {\n              \"OR\": {\n                \"left\": {\n                  \"raw text\": \"Any antibiotic intake 7 days prior to blood collection.\"\n                },\n                \"right\": {\n                  \"OR\": {\n                    \"raw text\": \"Subjects who donated >450 mL of blood within 60 days prior to any blood collection visits.\"\n                }\n              }\n            }\n          }\n        },\n        \"right\": {\n          \"AND\": {\n            \"left\": {\n              \"OR\": {\n                \"raw text\": \"Subjects who lost >200 mL during a single apheresis or who lost red blood cells on more than one occasion during apheresis within the previous 60 days.\"\n                }\n              }\n            }\n          }\n        },\n        \"right\": {\n          \"AND\": {\n            \"left\": {\n              \"OR\": {\n                \"raw text\": \"Concurrently participating in another clinical study, at any time during the study period, in which the subject has been or will be exposed to an investigational or a non-investigational vaccine/product.\"\n                },\n                \"right\": {\n                  \"OR\": {\n                    \"raw text\": \"Ongoing anaemia as indicated by haemoglobin values below the lower limit of the laboratory-specified reference range. If the finger prick method demonstrates an anaemia, no further protocol procedures will be performed, and the subject will be referred for appropriate medical management. The subject may participate in this study following therapy and evidence that the anaemia has been resolved.\"\n                }\n              }\n            }\n          }\n        },\n        \"right\": {\n          \"AND\": {\n            \"left\": {\n              \"OR\": {\n                \"raw text\": \"History of any reaction or hypersensitivity likely to be exacerbated by any component of the vaccines.\"\n                },\n                \"right\": {\n                  \"OR\": {\n                    \"raw text\": \"Pregnant or lactating female.\"\n                }\n              }\n            }\n          }\n        },\n        \"right\": {\n          \"AND\": {\n            \"left\": {\n              \"OR\": {\n                \"raw text\": \"Female planning to become pregnant or planning to discontinue contraceptive precautions.\"\n                },\n                \"right\": {\n                  \"OR\": {\n                    \"raw text\": \"Any confirmed or suspected immunosuppressive or immunodeficiency condition based on medical history and physical examination.\"\n                }\n              }\n            }\n          }\n        },\n        \"right\": {\n          \"AND\": {\n            \"left\": {\n              \"OR\": {\n                \"raw text\": \"Family history of congenital or hereditary immunodeficiency.\"\n                },\n                \"right\": {\n                  \"OR\": {\n                    \"raw text\": \"Serious chronic illness.\"\n                }\n              }\n            }\n          }\n        },\n        \"right\": {\n          \"AND\": {\n            \"left\": {\n              \"OR\": {\n                \"raw text\": \"History of chronic alcohol consumption and/or drug abuse.\"\n                },\n                \"right\": {\n                  \"OR\": {\n                    \"raw text\": \"Subjects with a history of autoimmune disease.\"\n                }\n              }\n            }\n          }\n    }\n  }\n}" 

