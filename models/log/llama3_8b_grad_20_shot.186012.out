  "{\n  \"AND\": {\n    \"left\": {\n      \"OR\": {\n        \"left\": {\n          \"raw_text\": \"Any MS relapse in the last five years, as determined at the screen visit by the PI\"\n        },\n        \"right\": {\n          \"AND\": {\n            \"left\": {\n              \"OR\": {\n                \"left\": {\n                  \"raw_text\": \"Any new or definitely enlarging T2/FLAIR lesion or new gadolinium-enhancing lesion within the past three years (at least two scans separated by at least three years must be reviewed) on brain or spine MRI scan. Lesions must be 3mm or larger to be exclusionary.\"\n                },\n                \"right\": {\n                  \"raw_text\": \"Use of inhaled or topical steroids are not an exclusion criteria. Use of oral steroids for no greater than 14 days given for a non-MS condition is not exclusionary.\"\n                }\n              }\n            }\n          }\n        },\n        \"right\": {\n          \"AND\": {\n            \"left\": {\n              \"OR\": {\n                \"left\": {\n                  \"raw_text\": \"Prior use of any experimental agent used as a DMT for MS in the last five years\"\n                },\n                \"right\": {\n                  \"OR\": {\n                    \"left\": {\n                      \"raw_text\": \"uncontrolled hypertension, uncontrolled diabetes, uncontrolled asthma, or uncontrolled depression\"\n                    },\n                    \"right\": {\n                      \"OR\": {\n                        \"left\": {\n                          \"raw_text\": \"Cancers other than basal cell skin cancers within the last 5 years\"\n                        },\n                        \"right\": {\n                          \"OR\": {\n                            \"left\": {\n                              \"raw_text\": \"Unable to give informed consent or follow the protocol\"\n                            },\n                            \"right\": {\n                              \"OR\": {\n                                \"left\": {\n                                  \"raw_text\": \"Unable to undergo brain MRI\"\n                                },\n                                \"right\": {\n                                  \"OR\": {\n                                    \"raw_text\": \"Unwilling to be randomized per this protocol\"\n                                    }\n                                  }\n                                }\n                            }\n                          }\n                        }\n                    }\n                }\n            }\n          }\n        }\n      }\n    }\n  }\n}" 

