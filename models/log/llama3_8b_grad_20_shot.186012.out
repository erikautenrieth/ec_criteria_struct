: {\n                                      \"OR\": {\n                                        \"raw_text\": \"Total bilirubin level exceeded 2 mg / dL\"\n                                        },\n                                        \"right\": {\n                                      \"OR\": {\n                                        \"raw_text\": \"Serum albumin level less than 2 g / dL\"\n                                        },\n                                        \"right\": {\n                                      \"OR\": {\n                                        \"raw text\": \"Ascites\"\n                                        },\n                                        \"right\": {\n                                      \"OR\": {\n                                        \"raw text\": \"Hepatic encephalopathy\"\n                                        },\n                                        \"right\": {\n                                      \"OR\": {\n                                        \"raw text\": \"Hepatitis B, hepatitis C (excluding healthy carriers) or HIV positive\"\n                                        },\n                                        \"right\": {\n                                      \"OR\": {\n                                        \"raw text\": \"MDRD(Modification of Diet in Renal Disease) Estimated Glomerular filtration rate less than 60 mL / m2\"\n                                        },\n                                        \"right\": {\n                                      \"OR\": {\n                                        \"raw text\": \"Patients with hyperkalemia (over 5.5 meq / L)\"\n                                        },\n                                        \"right\": {\n                                      \"OR\": {\n                                        \"raw text\": \"history of asthma, acute rhinitis, nasal polyps, angioedema, urticaria or allergic reactions to aspirin or other non-steroidal anti-inflammatory drugs(including COX-2 inhibitors).\"}\n                                        }\n                                      }\n                                    }\n                                }\n                            }\n                        }\n                    }\n                }\n            }\n          }\n        },\n        \"right\": {\n          \"AND\": {\n            \"left\": {\n              \"OR\": {\n                \"left\": {\n                  \"raw text\": \"Malignant tumors other than basal cell or squamous cell carcinoma of the skin, CIN(Cervical Intraepitherial Neoplasia) and CIS(Carcinoma in situ) of the cervix, and intraepithelial carcinoma of other areas Within 5 years of consent date.\"\n                },\n                \"right\": {\n                  \"OR\": {\n                    \"left\": {\n                      \"raw text\": \"Medical history of hypersensitivity to the components of the investigational products. (The components of test drug 1 and 2, including the Rhein-based drug)\"\n                    },\n                    \"right\": {\n                      \"OR\": {\n                        \"raw text\": \"Patients with an allergic reaction to sulfonamide.\"\n                        },\n                        \"right\": {\n                          \"OR\": {\n                            \"raw text\": \"Patients with galactose intolerance, lapp lactase deficiency or glucose-galactose malabsorption.\"\n                            },\n                            \"right\": {\n                              \"OR\": {\n                                \"raw text\": \"Subjects who have not reached the prescribed period after receiving contraindicated medication or treatment before participation in this clinical trial.\"\n                                },\n                                \"right\": {\n                                  \"OR\": {\n                                    \"raw text\": \"Patients receiving contraindicated medication.\"\n                                    },\n                                    \"right\": {\n                                      \"OR\": {\n                                        \"raw text\": \"Alcohol and other drug abuse cases based on 6 months before screening.\"\n                                        },\n                                        \"right\": {\n                                          \"OR\": {\n                                            \"raw text\": \"Pregnant women or nursing mothers who are not willing to stop breastfeeding.\"\n                                            },\n                                            \"right\": {\n                                              \"OR\": {\n                                                \"(1) Menopause (non-therapy-induced amenorrhea of more than 12 months) Female\"\n                                                },\n                                                \"right\": {\n                                                  \"OR\": {\n                                                    \"(2) Female infertility due to surgery (no ovaries and / or uterus)\"\n                                                    },\n                                                    \"right\": {\n                                                      \"OR\": {\n                                                        \"(3) If you have sexual intercourse with only one male partner who has been confirmed to have no semen after fertilization.\"\n                                                        },\n                                                        \"right\": {\n                                                          \"OR\": {\n                                                            \"(4) Female subjects who agreed to abstinence during the clinical trial period. If the subject is assured of an abstinence throughout the trial period.(e.g. clergy) H