  "{\n  \"AND\": {\n    \"left\": {\n      \"OR\": {\n        \"left\": {\n          \"raw_text\": \"1. Age 18 years or older\"\n        },\n        \"right\": {\n          \"OR\": {\n            \"left\": {\n              \"raw_text\": \"2. Diagnosis of venous leg ulcer(s), as clinically determined by the investigator by a positive venous reflux test (venous refilling <20 seconds) using Doppler ultrasound for at least 4 weeks prior to screening day, which have not adequately responded to conventional ulcer therapy.\"\n        }\n      }\n    },\n    \"right\": {\n      \"AND\": {\n        \"left\": {\n          \"AND\": {\n            \"left\": {\n              \"OR\": {\n                \"left\": {\n                  \"raw_text\": \"3. Designated venous leg ulcer meets the following criteria at both the screening and baseline visits. If the patient has multiple ulcers, at least one ulcer must meet the following criteria at both the screening and baseline visits:\"\n            },\n            \"right\": {\n              \"AND\": {\n                \"left\": {\n                  \"raw_text\": \"1. Present for at least 4 weeks\"\n                },\n                \"right\": {\n                  \"AND\": {\n                    \"left\": {\n                      \"raw_text\": \"2. CEAP Classification Stage 6\"\n                    },\n                    \"right\": {\n                      \"AND\": {\n                        \"left\": {\n                          \"raw_text\": \"3. Surface ulcer with an area > 15cm2 post debridement\"\n                        },\n                        \"right\": {\n                          \"AND\": {\n                            \"left\": {\n                              \"raw_text\": \"4. Viable, granulating wound (investigator discretion)\"\n                            },\n                            \"right\": {\n                              \"AND\": {\n                                \"left\": {\n                            