"{\n  \"AND\": {\n    \"left\": {\n      \"raw_text\": \"Subject has documented typical atrial flutter.\"\n    },\n    \"right\": {\n      \"AND\": {\n        \"left\": {\n          \"NOT\": {\n            \"left\": {\n              \"raw_text\": \"Subject has any history of successful or unsuccessful treatment of AF with class I or III antiarrhythmic or sotalol with the intention to prevent an AF recurrence.\"\n            }\n          }\n        },\n        \"right\": {\n          \"AND\": {\n            \"left\": {\n              \"NOT\": {\n                \"left\": {\n                  \"raw_text\": \"Patients pretreated with above AAD at maximum 48 hours with the intention to convert an AF episode are allowed.\"\n                }\n              }\n            },\n            \"right\": {\n              \"AND\": {\n                \"left\": {\n                  \"raw_text\": \"Subject had any previous left atrial ablation.\"\n                },\n                \"right\": {\n                  \"AND\": {\n                    \"left\": {\n                      \"raw_text\": \"Subject had any previous cardiac surgery, e.g. prosthetic valves.\"\n                    },\n                    \"right\": {\n                      \"AND\": {\n                        \"left\": {\n                          \"raw_text\": \"Subject has permanent pacemaker or defibrillator implant.\"\n                        },\n                        \"right\": {\n                          \"AND\": {\n                            \"left\": {\n                              \"raw_text\": \"Subject has 2° type II, 3° degree AV-block or left/right bundle branch block pattern.\"\n                            },\n                            \"right\": {\n                              \"AND\": {\n                                \"left\": {\n                                  \"raw_text\": \"Subject has unstable angina pectoris.\"\n                                },\n                                \"right\": {\n                                  \"AND\": {\n                                    \"left\": {\n                                      \"raw_text\": \"Subject has history of previous myocardial infarction or percutaneous intervention during the last three months.\"\n                                    },\n                                    \"right\": {\n                                      \"AND\": {\n                                        \"left\": {\n                                          \"raw_text\": \"Subject has symptomatic carotid stenosis.\"\n                                        },\n                                        \"right\": {\n                                          \"AND\": {\n                                            \"left\": {\n                                              \"raw_text\": \"Subject has chronic obstructive pulmonary disease with detected pulmonary hypertension or any other evidence of significant lung disease.\"\n                                            },\n                                            \"right\": {\n                                              \"AND\": {\n                                                \"left\": {\n                                                  \"raw_text\": \"Subject has any contraindication for oral anticoagulation.\"\n                                                },\n                                                \"right\": {\n                                                  \"AND\": {\n                                                    \"left\": {\n                                                      \"raw_text\": \"Subject has any history of previous transient ischemic attack or stroke.\"\n                                                    },\n                                                    \"right\": {\n                                                      \"AND\": {\n                                                        \"left\": {\n                                                          \"raw_text\": \"Subject has known intra-cardiac thrombus formation.\"\n                                                        },\n                                                        \"right\": {\n                                                          \"AND\": {\n                                                            \"left\": {\n                                                              \"raw_text\": \"Subject has any significant congenital heart defect corrected or not (except for patent foramen ovale that is allowed).\"\n                                                            },\n                                                            \"right\": {\n                                                              \"AND\": {\n                                                                \"left\": {\n                                                                  \"raw_text\": \"Subject has evidence of congestive heart failure (NYHA class II, III or IV) in sinus rhythm.\"\n                                                                },\n                                                                \"right\": {\n                                                                  \"AND\": {\n                                                                    \"left\": {\n                                                                      \"raw_text\": \"Subject has hypertrophic cardiomyopathy.\"\n                                                                    },\n                                                                    \"right\": {\n                                                                      \"AND\": {\n                                                                        \"left\": {\n                                                                          \"raw_text\": \"Subject has abnormal long or short QT interval, signs of Brugada syndrome, known inheriting ion channel disease on the family, arrhythmogenic right ventricular dysplasia.\"\n                                                                        },\n                                                                        \"right\": {\n                                                                          \"AND\": {\n                                                                            \"left\": {\n                                                                              \"raw_text\": \"Subject has sarcoidosis.\"\n                                                                            },\n                                                                            \"right\": {\n                                                                              \"AND\": {\n                                                                                \"left\": {\n                                                                                  \"raw_text\": \"Subject has pulmonary vein stent.\"\n                                                                                },\n                                                                                \"right\": {\n                                                                                  \"AND\": {\n                                                                                    \"left\": {\n                                                                                      \"raw_text\": \"Subject has myxoma.\"\n                                                                                    },\n                                                                                    \"right\": {\n                                                                                      \"AND\": {\n                                                                                        \"left\": {\n                                                                                          \"raw_text\": \"Exclusion criteria based on laboratory abnormalities\"\n                                                                                        },\n                                                                                        \"right\": {\n                                                                                          \"AND\": {\n                                                                                            \"left\": {\n                                                                                              \"raw_text\": \"Subject has thrombocytosis (platelet count > 600,000 / µl) or thrombocytopenia (platelet count <100,000 / µl).\"\n                                                                                            },\n                                                                                            \"right\": {\n                                                                                              \"AND\": {\n                                                                                                \"left\": {\n                                                                                                  \"raw_text\": \"Subject has any untreated or uncontrolled hyperthyroidism or hypothyroidism.\"\n                                                                                                },\n                                                                                                \"right\": {\n                                                                                                  \"AND\": {\n                                                                                                    \"left\": {\n                                                                                                      \"raw_text\": \"Subject has renal dysfunction with glomerular filtration rate < 60 ml / min.\"\n                                                                                                    },\n                                                                                                    \"right\": {\n                                                                                                      \"AND\": {\n                                                                                                        \"left\": {\n                                                                                                          \"raw_text\": \"Subject has known cryoglobulinaemia.\"\n                                                                                                        },\n                                                                                                        \"right\": {\n                                                                                                          \"AND\": {\n                                                                                                            \"left\": {\n                                                                                                              \"raw_text\": \"General exclusion criteria\"\n                                                                                                            },\n                                                                                                            \"right\": {\n                                                                                                              \"AND\": {\n                                                                                                                \"left\": {\n                                                                                                                  \"raw_text\": \"Subject has a reversible causes for AF like hyperthyroidism and alcoholism.\"\n                                                                                                                },\n                                   