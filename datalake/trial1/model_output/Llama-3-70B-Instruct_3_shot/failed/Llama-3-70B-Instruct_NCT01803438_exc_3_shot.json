   \"left\": {\n                                                                                                                              \"raw_text\": \"Subject has an active systemic infection.\"\n                                                                                                                            },\n                                                                                                                            \"right\": {\n                                                                                                                              \"AND\": {\n                                                                                                                                \"left\": {\n                                                                                                                                  \"raw_text\": \"Subject is employed by Medtronic or by the department of any of the investigators or is a close relative of any of the investigators.\"\n                                                                                                                                },\n                                                                                                                                \"right\": {\n                                                                                                                                  \"AND\": {\n                                                                                                                                    \"left\": {\n                                                                                                                                      \"raw_text\": \"Subject is unwilling or unable to comply fully with study procedures and follow-up due to any disease condition, which can raise doubt about compliance and influencing the study outcome especially any kind of cancer, severe bleeding in history or a suspected