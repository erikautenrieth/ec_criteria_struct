{
  "AND": {
    "left": {
      "AND": {
        "left": {
          "raw_text": "Male and/or female patients"
        },
        "right": {
          "AND": {
            "left": {
              "raw_text": "from 30-80 years of age"
            },
            "right": {
              "raw_text": "with a diagnosis of Type 2 diabetes (WHO criteria)."
            }
          }
        }
      }
    },
    "right": {
      "AND": {
        "left": {
          "AND": {
            "left": {
              "raw_text": "Incipient and established diabetic nephropathy"
            },
            "right": {
              "raw_text": "(urinary albumin excretion ≥ 100 mg/day but ≤ 2000 mg/day)."
            }
          }
        },
        "right": {
          "AND": {
            "left": {
              "raw_text": "Glomerular filtration rate (GFR) ≥ 40 ml/min"
            },
            "right": {
              "raw_text": "(estimated using Modification of Diet in Renal Disease (MDRD) formula) in the last 4 months."
            }
          }
        }
      }
    }
  },
  "AND": {
    "left": {
      "AND": {
        "left": {
          "raw_text": "Female patients must be postmenopausal"
        },
        "right": {
          "OR": {
            "left": {
              "raw_text": "or must have had a bilateral oophorectomy"
            },
            "right": {
              "OR": {
                "left": {
                  "raw_text": "or must have been surgically sterilized"
                },
                "right": {
                  "raw_text": "or hysterectomized at least 6 months prior to screening."
                }
              }
            }
          }
        }
      }
    },
    "right": {
      "AND": {
        "left": {
          "AND": {
            "left": {
              "raw_text": "To be eligible patients must fulfill the following criteria:"
            },
            "right": {
              "AND": {
                "left": {
                  "raw_text": "Patients on ongoing hypertensive therapy must have a blood pressure ≥ 135/85 mm Hg but lower than 170/105 mm Hg at baseline (Day -1)"
                },
                "right": {
                  "AND": {
                    "left": {
                      "raw_text": "AND patients must be on stable antihypertensive medications for at least 8 weeks prior to baseline (Day -1)."
                    },
                    "right": {
                      "OR": {
                        "left": {
                          "raw_text": "Newly diagnosed hypertensive patients must have a blood pressure ≥ 135/85 mm Hg but lower than 170/105 mm Hg at baseline (Day -1)."
                        },
                        "right": {
                          "AND": {
                            "left": {
                              "raw_text": "Patients must be on stable hypoglycemic medications for at least 8 weeks prior to Visit 2 ( Day -1)."
                            },
                            "right": {
                              "AND": {
                                "left": {
                                  "raw_text": "Patients must be willing and medically able to discontinue all Angiotensin-converting enzyme inhibitor (ACEI), Angiotensin receptor blocker (ARB), aldosterone receptor antagonist and potassium sparing diuretic medications for the duration of the study."
                                },
                                "right": {
                                  "AND": {
                                    "left": {
                                      "raw_text": "Oral body temperature within the range 35.0-37.5 °C"
                                    },
                                    "right": {
                                      "AND": {
                                        "left": {
                                          "raw_text": "Able to provide written informed consent prior to study participation."
                                        },
                                        "right": {
                                          "raw_text": "Able to communicate well with the investigator and comply with the requirements of the study."
                                        }
                                      }
                                    }
                                  }
                                }
                              }
                            }
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}