                                    },
                                    "right": {
                                      "raw_text": "Subjects with a measured post-albuterol/salbutamol FEV1 >=50 and <=70% of predicted normal values calculated using NHANES III reference equations [Hankinson, 1999; Hankinson, 2010] at Screening (Visit 1)."
                                    }
                                  }
                                },
                                "right": {
                                  "AND": {
                                    "left": {
                                      "raw_text": "Post-bronchodilator spirometry will be performed approximately 15 minutes after the subject has self-administered 4 inhalations (i.e., total 400mcg) of albuterol/salbutamol via a metered dose inhaler (MDI )with a valved-holding chamber."
                                    },
                                    "right": {
                                      "AND": {
                                        "left": {
                                          "raw_text": "The FEV1/FVC ratio and FEV1 percent predicted values will be calculated."
