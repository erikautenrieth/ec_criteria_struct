"{\n  \"AND\": {\n    \"left\": {\n      \"OR\": {\n        \"left\": {\n          \"raw_text\": \"Uncontrolled hypertension or metabolic disease\"\n        },\n        \"right\": {\n          \"OR\": {\n            \"left\": {\n              \"raw_text\": \"Neurodegenerative disorders (i.e. Parkinson disease. LBD, or FTD).\"\n            },\n            \"right\": {\n              \"OR\": {\n                \"left\": {\n                  \"raw_text\": \"Dementia or Mild cognitive impairment at baseline\"\n                },\n                \"right\": {\n                  \"OR\": {\n                    \"left\": {\n                      \"raw_text\": \"Long life major depression. Baseline scores =16 on the 17-item Hamilton Depression Scale at baseline.\"\n                    },\n                    \"right\": {\n                      \"OR\": {\n                        \"left\": {\n                          \"raw_text\": \"Long-life DSM-IV axis 1 disorders.\"\n                        },\n                        \"right\": {\n                          \"OR\": {\n                            \"raw_text\": \"Mental retardation.\"\n                            }\n                          }\n                        }\n                      }\n                    }\n                  }\n                }\n              }\n            }\n          }\n        },\n        \"right\": {\n          \"AND\": {\n            \"left\": {\n              \"OR\": {\n                \"left\": {\n                  \"raw_text\": \"Substance abuse.\"\n                },\n                \"right\": {\n                  \"OR\": {\n                    \"left\": {\n                      \"raw_text\": \"Concurrent medication limiting validity of neuropsychological tests or imaging.\"\n                    },\n                    \"right\": {\n                      \"OR\": {\n                        \"left\": {\n                          \"raw_text\": \"Anti-depressants with anti-cholinergic properties\"\n                        },\n                        \"right\": {\n                          \"OR\": {\n                            \"left\": {\n                              \"raw_text\": \"Monoamine oxidase inhibitors (MAOi)\"\n                            },\n                            \"right\": {\n                              \"OR\": {\n                                \"left\": {\n                                  \"raw_text\": \"Regular use of narcotic analgesics (>2 doses per week).\"\n                                },\n                                \"right\": {\n                                  \"OR\": {\n                                    \"raw_text\": \"Use of neuroleptics\"\n                                    },\n                                    \"right\": {\n                                      \"OR\": {\n                                        \"left\": {\n                                          \"raw_text\": \"Use of anti-dementia medications (Aricept, Exelon, Razadyne) and memantine (Namenda)) or anti-Parkinsonian medications (Sinemet, amantadine, bromocriptine, pergolide, selegeline).\"\n                                        }\n                                      }\n                                    }\n                                }\n                            }\n                          }\n                        }\n                      }\n                    }\n                  }\n                }\n              }\n            }\n          }\n        },\n        \"right\": {\n          \"AND\": {\n            \"left\": {\n              \"OR\": {\n                \"left\": {\n                  \"raw_text\": \"Individuals taking over the counter memory enhancing or protecting medications (e.g. ginkgo biloba, vitamins) are not excluded.\"\n                },\n                \"right\": {\n                  \"OR\": {\n                    \"left\": {\n                      \"raw_text\": \"Implanted medical devices that are incompatible with MRI imaging.\"\n                    },\n                    \"right\": {\n                      \"OR\": {\n                        \"left\": {\n                          \"raw_text\": \"Radiation exposures exceeding annual Rad Worker limits.\"\n                        },\n                        \"right\": {\n                          \"OR\": {\n                            \"raw text\": \"Heart failure stage D as defined by American Heart Association (7).\"\n                            },\n                            \"right\": {\n                              \"OR\": {\n                                \"raw text\": \"Chronic kidney disease in stages = 4, as defined per National Kidney Foundation (8).\"\n                                },\n                                \"right\": {\n                                  \"OR\": {\n                                    \"raw text\": \"Brain tumor and other neoplastic disorders outside the brain where disease itself or its treatment (radiation, chemotherapy) is likely to affect brain structure or function.\"\n                                    },\n                                    \"right\": {\n                                      \"OR\": {\n                                        \"raw text\": \"Stroke when meeting criteria for total anterior, partial anterior or posterior circulation infarct according to the Oxford Community Stroke Project classification. Patients with clinically silent of lacunar strokes and transient ischemic attacks will not be excluded.\"\n                                        },\n                                        \"right\": {\n                                          \"OR\": {\n                                            \"raw text\": \"Significant head trauma.\"\n                                            },\n                                            \"right\": {\n                                              \"OR\": {\n                                                \"raw text\": \"Hydrocephalus.\"\n                                                },\n                                                \"right\": {\n                                                  \"OR\": {\n                                                    \"raw text\": \"Hostility or refusal to cooperate.\"\n                                                    }\n                                                  }\n                                                }\n                                              }\n                                            }\n                                          }\n                                        }\n                                      }\n                                    }\n                                }\n                            }\n                          }\n                        }\n                      }\n                    }\n                  }\n                }\n              }\n            }\n          }\n        }\n      }\n    }\n  }\n}"