"{\n  \"AND\": {\n    \"left\": {\n      \"OR\": {\n        \"left\": {\n          \"raw_text\": \"1. Males and females ≥ 18 years old.\"\n        },\n        \"right\": {\n          \"OR\": {\n            \"left\": {\n              \"raw_text\": \"2. Clinical diagnosis of type 1 diabetes for at least one year.\"\n            },\n            \"right\": {\n              \"OR\": {\n                \"left\": {\n                  \"raw_text\": \"3. The subject will have been on insulin pump therapy for at least 3 months and currently using a fast actin insulin analog (Lispro, Aspart or Guilisine).\"\n                },\n                \"right\": {\n                  \"OR\": {\n                    \"left\": {\n                      \"raw_text\": \"4. Last (less than 3 months) HbA1c ≤ 10%.\"\n                    },\n                    \"right\": {\n                      \"OR\": {\n                        \"raw_text\": \"5. Currently using carbohydrate counting as the meal insulin dose strategy.\"\n                        }\n                  }\n                }\n              }\n            }\n          }\n        }\n    }\n  }\n}"