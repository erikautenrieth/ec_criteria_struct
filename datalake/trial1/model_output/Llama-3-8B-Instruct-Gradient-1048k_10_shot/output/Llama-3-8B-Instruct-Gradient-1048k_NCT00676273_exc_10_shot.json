"{\n  \"AND\": {\n    \"left\": {\n      \"OR\": {\n        \"left\": {\n          \"raw_text\": \"Patients: Who are pregnant or planning to become pregnant during the study or in the future.\"\n        },\n        \"right\": {\n          \"OR\": {\n            \"left\": {\n              \"raw_text\": \"With a elevated post-void residual (defined as PVR > 100cc).\"\n            },\n            \"right\": {\n              \"OR\": {\n                \"left\": {\n                  \"raw_text\": \"With a bleeding condition or on anti-coagulant therapy.\"\n                },\n                \"right\": {\n                  \"OR\": {\n                    \"left\": {\n                      \"raw_text\": \"With immunosuppression (i.e. HIV, lymphoma).\"\n                    },\n                    \"right\": {\n                      \"OR\": {\n                        \"left\": {\n                          \"raw_text\": \"With multiple sclerosis or other progressive neurological disease.\"\n                        }\n                      }\n                    }\n                }\n              }\n            }\n          }\n        },\n        \"right\": {\n          \"OR\": {\n            \"left\": {\n              \"raw_text\": \"With evidence of a local or systemic infection, including urinary tract infection.\"\n            },\n            \"right\": {\n              \"OR\": {\n                \"left\": {\n                  \"raw_text\": \"With evidence of intrinsic sphincter deficiency as defined by a maximal urethral closure pressure of <20 cm H2O.\"\n                },\n                \"right\": {\n                  \"OR\": {\n                    \"left\": {\n                      \"raw_text\": \"Previous sub-urethral sling.\"\n                    },\n                    \"right\": {\n                      \"OR\": {\n                        \"raw_text\": \"Predominant overactive bladder symptoms.\"\n                        }\n                      }\n              