"{\n  \"AND\": {\n    \"left\": {\n      \"OR\": {\n        \"left\": {\n          \"raw_text\": \"1. Expected performance of PCI < 60 minutes from diagnosis (qualifying ECG) or inability to arrive at the catheterisation laboratory within 3 hours\"\n        },\n        \"right\": {\n          \"OR\": {\n            \"left\": {\n              \"raw_text\": \"Previous CABG\"\n            },\n            \"right\": {\n              \"OR\": {\n                \"left\": {\n                  \"raw_text\": \"Left bundle branch block or ventricular pacing\"\n                },\n                \"right\": {\n                  \"OR\": {\n                    \"left\": {\n                      \"raw_text\": \"Patients with cardiogenic shock - Killip Class 4\"\n                    },\n                    \"right\": {\n                      \"OR\": {\n                        \"left\": {\n                          \"raw_text\": \"Patients with a body weight < 55 kg (known or estimated)\"\n                        },\n                        \"right\": {\n                          \"OR\": {\n                            \"raw_text\": \"Uncontrolled hypertension, defined as sustained blood pressure = 180/110 mm Hg (systolic BP = 180 mm Hg and/or diastolic BP = 110 mm Hg) prior to randomisation\"}\n                            }\n                      }\n                    }\n                }\n              }\n            }\n          }\n        },\n        \"right\": {\n          \"OR\": {\n            \"left\": {\n              \"raw_text\": \"Known prior stroke or TIA\"\n            },\n            \"right\": {\n              \"OR\": {\n                \"left\": {\n                  \"raw_text\": \"Recent administration of any i.v. or s.c. anticoagulation within 12 hours, including unfractionated heparin, enoxaparin, and/or bivalirudin or current use of oral anticoagulation (i.e. warfarin or a NOACs)\"\n            },\n            \"right\": {\n              \"OR\": {\n                \"left\": {\n                  \"raw_text\": \"Active bleeding or known bleeding disorder/diathesis\"\n            },\n            \"right\": {\n              \"OR\": {\n                \"left\": {\n                  \"raw_text\": \"Known history of central nervous system damage (i.e. neoplasm, aneurysm, intracranial or spinal surgery) or recent trauma to the head or cranium (i.e. < 3 months)\"\n            },\n            \"right\": {\n              \"OR\": {\n                \"raw_text\": \"Major surgery, biopsy of a parenchymal organ, or significant trauma within the past 2 months (this includes any trauma associated with the current myocardial infarction)\"\n            },\n            \"right\": {\n              \"OR\": {\n                \"raw_text\": \"Clinical diagnosis associated with increased risk of bleeding including known active peptic ulceration and/or neoplasm with increased bleeding risk\"}\n            },\n            \"right\": {\n              \"OR\": {\n                \"raw text\": \"Prolonged cardiopulmonary resuscitation (> 2 minutes) within the past 2 weeks\"}\n            },\n            \"right\": {\n              \"OR\": {\n                \"raw text\": \"Known acute pericarditis and/or subacute bacterial endocarditis\"}\n            },\n            \"right\": {\n              \"OR\": {\n                \"raw text\": \"Known acute pancreatitis or known severe hepatic dysfunction, including hepatic failure, cirrhosis, portal hypertension (oesophageal varices) and active hepatitis\"}\n            },\n            \"right\": {\n              \"OR\": {\n                \"raw text\": \"Dementia\"}\n            },\n            \"right\": {\n              \"OR\": {\n                \"raw text\": \"Known severe renal insufficiency\"}\n            },\n            \"right\": {\n              \"OR\": {\n                \"raw text\": \"Previous enrolment in this study or treatment with an investigational drug or device under another study protocol in the past 7 days\"}\n            },\n            \"right\": {\n              \"OR\": {\n                \"raw text\": \"Known allergic reactions to tenecteplase, clopidogrel, enoxaparin and aspirin\"}\n            },\n            \"right\": {\n              \"OR\": {\n                \"raw text\": \"Inability to follow the protocol and comply with follow-up requirements or any other reason that the investigator feels would place the patient at increased risk if the investigational therapy is initiated.\"\n            }\n          }\n        }\n    }\n  }\n}"