"{\n  \"AND\": {\n    \"left\": {\n      \"OR\": {\n        \"left\": {\n          \"raw_text\": \"History of hypersensitivity or allergy to any of the study drugs, drugs of similar chemical classes, ACE inhibitors (ACEIs), angiotensin II receptor blockers (ARBs), or neprilysin inhibitors, as well as known or suspected contraindications to the study drugs.\"\n        },\n        \"right\": {\n          \"AND\": {\n            \"left\": {\n              \"OR\": {\n                \"left\": {\n                  \"raw_text\": \"Previous history of intolerance to recommended target doses of ACEIs or ARBs.\"\n                },\n                \"right\": {\n                  \"OR\": {\n                    \"left\": {\n                      \"raw_text\": \"Known history of angioedema.\"\n                    },\n                    \"right\": {\n                      \"OR\": {\n                        \"left\": {\n                          \"raw_text\": \"Requirement for treatment with both ACEIs and ARBs.\"\n                        },\n                        \"right\": {\n                          \"OR\": {\n                            \"left\": {\n                              \"raw_text\": \"Current acute decompensated heart failure (exacerbation of chronic heart failure manifested by signs and symptoms that may require intravenous therapy).\"\n                            },\n                            \"right\": {\n                              \"OR\": {\n                                \"left\": {\n                                  \"raw_text\": \"Symptomatic hypotension.\"\n                                },\n                                \"right\": {\n                                  \"OR\": {\n                                    \"left\": {\n                                      \"raw_text\": \"Estimated glomerular filtration rate (eGFR) <30%.\"\n                                    },\n                                    \"right\": {\n                                      \"OR\": {\n                                        \"left\": {\n                                          \"raw_text\": \"Serum potassium >5.4 mmol/L.\"\n                                        },\n                                        \"right\": {\n                                          \"OR\": {\n                                            \"left\": {\n                                              \"raw_text\": \"Acute coronary syndrome, stroke, transient ischaemic attack, cardiac, carotid, or other major cardiovascular surgery, percutaneous coronary intervention, or carotid angioplasty within the 3 months.\"\n                                            },\n                                            \"right\": {\n                                              \"OR\": {\n                                                \"raw text\": \"Coronary or carotid artery disease likely to require surgical or percutaneous intervention within the 6 months.\"\n                                                },\n                                                \"right\": {\n                                                  \"OR\": {\n                                                    \"raw text\": \"Implantation of a cardiac resynchronization therapy (CRT) device within 3 months or intent to implant a CRT.\"\n                                                    },\n                                                    \"right\": {\n                                                      \"OR\": {\n                                                        \"raw text\": \"History of heart transplant or on a transplant list or with left ventricular (LV) assistance device.\"\n                                                        },\n                                                        \"right\": {\n                                                          \"OR\": {\n                                                            \"raw text\": \"History of severe pulmonary disease.\"\n                                                            },\n                                                            \"right\": {\n                                                              \"OR\": {\n                                                                \"raw text\": \"Diagnosis of peripartum- or chemotherapy-induced cardiomyopathy within the 12 months.\"\n                                                                },\n                                                                \"right\": {\n                                                                  \"OR\": {\n                                                                    \"raw text\": \"Documented untreated ventricular arrhythmia with syncopal episodes within the 3 months.\"\n                                                                    },\n                                                                    \"right\": {\n                                                                      \"OR\": {\n                                                                        \"raw text\": \"Symptomatic bradycardia or second- or third-degree atrioventricular block without a pacemaker.\"\n                                                                        },\n                                                                        \"right\": {\n                                                                          \"OR\": {\n                                                                            \"raw text\": \"Presence of haemodynamically significant mitral and/or aortic valve disease, except mitral regurgitation secondary to LV dilatation.\"\n                                                                            },\n                                                                            \"right\": {\n                                                                              \"OR\": {\n                                                                                \"raw text\": \"Presence of other haemodynamically significant obstructive lesions of the LV outflow tract, including aortic and subaortic stenosis.\"\n                                                                                }\n                                                                              }\n                                                                  }\n                                                              }\n                                                          }\n                                                        }\n                                                      }\n                                                    }\n                                                  }\n                                                }\n                                              }\n                                            }\n                                          }\n                                        }\n                                      }\n                                    }\n                                  }\n            }\n          }\n        }\n      }\n    }\n  }\n}"