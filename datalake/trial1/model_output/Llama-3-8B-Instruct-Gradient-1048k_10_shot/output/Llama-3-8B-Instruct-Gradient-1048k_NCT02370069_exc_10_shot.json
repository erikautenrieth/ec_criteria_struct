"{\n  \"AND\": {\n    \"left\": {\n      \"OR\": {\n        \"left\": {\n          \"raw_text\": \"immunization with PPV23 within the last year\"\n        },\n        \"right\": {\n          \"AND\": {\n            \"left\": {\n              \"OR\": {\n                \"left\": {\n                  \"raw_text\": \"any confirmed or suspected immunodeficiency condition, including human immunodeficiency virus (HIV) infection, haematological malignancy, or a congenital immunodeficiency\"\n                },\n                \"right\": {\n                  \"OR\": {\n                    \"left\": {\n                      \"raw_text\": \"history of allergic disease or reactions likely to be exacerbated by any component of the vaccine\"\n                    },\n                    \"right\": {\n                      \"OR\": {\n                        \"left\": {\n                          \"raw_text\": \"history of allergic disease likely to be stimulated by the vaccination\"\n                        },\n                        \"right\": {\n                          \"OR\": {\n                            \"left\": {\n                              \"raw_text\": \"history or records of immunosuppressive therapy (with the exception of topical corticosteroids) for more than 14 days and within 6 months of vaccination\"\n                            },\n                            \"right\": {\n                              \"OR\": {\n                                \"left\": {\n                                  \"raw_text\": \"history or evidence of administration of immunoglobulins and/or any blood products during the study period or within the three months preceding the study vaccine\"\n                                },\n                                \"right\": {\n                                  \"OR\": {\n                                    \"raw_text\": \"use of any other investigational or non-registered drug or vaccine during the study period or within 30 days preceding the study vaccine\"\n                                    },\n                                    \"right\": {\n                                      \"OR\": {\n                                        \"raw_text\": \"administration of a vaccine during the period starting one month before the dose of vaccine and ending one month after\"\n                                        },\n                                        \"right\": {\n                                          \"OR\": {\n                                            \"raw_text\": \"pregnancy\"\n                                            }\n                                          }\n                                        }\n                                    }\n                                }\n                            }\n                          }\n                        }\n                      }\n                    }\n                  }\n                }\n              }\n            }\n          }\n        }\n      }\n    }\n  }\n}"