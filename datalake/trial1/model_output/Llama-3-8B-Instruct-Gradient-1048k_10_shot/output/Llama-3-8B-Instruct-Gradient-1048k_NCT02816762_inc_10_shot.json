"{\n  \"AND\": {\n    \"left\": {\n      \"OR\": {\n        \"left\": {\n          \"raw_text\": \"Subjects aged 18 to 80 years old\"\n        },\n        \"right\": {\n          \"AND\": {\n            \"left\": {\n              \"OR\": {\n                \"left\": {\n                  \"raw_text\": \"Overweight or obesity (BMI =25 kg/m2)\"\n                },\n                \"right\": {\n                  \"OR\": {\n                    \"left\": {\n                      \"raw_text\": \"Previous diagnosis of type 2 diabetes, fulfilling at least one of the following criteria:\"\n                    },\n                    \"right\": {\n                      \"OR\": {\n                        \"left\": {\n                          \"raw_text\": \"1) current treatment with oral antidiabetic drugs and/or insulin;\"\n                        },\n                        \"right\": {\n                          \"OR\": {\n                            \"left\": {\n                              \"raw_text\": \"2) a fasting glucose value above 126 mg/dl on at least 2 occasions;\"\n                            },\n                            \"right\": {\n                              \"OR\": {\n                                \"left\": {\n                                  \"raw_text\": \"3) blood glucose level at 2 hours after an oral glucose tolerance test is equal to or more than 200 mg/dl;\"\n                                },\n                                \"right\": {\n                                  \"OR\": {\n                                    \"raw_text\": \"4) a glycated hemoglobin (HbA1c) level > 6.5 %\"}\n                                    }\n                                }\n                            }\n                        }\n                    }\n                }\n            },\n            \"right\": {\n              \"AND\": {\n                \"left\": {\n                  \"raw_text\": \"Clinical diagnosis of diabetic nephropathy, with a urinary albumin/creatinine ratio >30 mg/g and an estimated glomerular filtration rate more than 20 ml/min per 1.73 m2.\"\n                },\n                \"right\": {\n                  \"AND\": {\n                    \"left\": {\n                      \"raw_text\": \"Treatment with stable doses of angiotensin-converting enzyme inhibitors, angiotensin II receptor blockers or anti-aldosterone agents in the last four weeks.\"\n                    }\n                  }\n                }\n            }\n          }\n        }\n      }\n  }\n}"