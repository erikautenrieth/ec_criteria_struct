"{\n  \"AND\": {\n    \"left\": {\n      \"OR\": {\n        \"left\": {\n          \"raw_text\": \"History of neuropathy\"\n        },\n        \"right\": {\n          \"OR\": {\n            \"left\": {\n              \"raw_text\": \"Regularly taking prescribed analgesia\"\n            },\n            \"right\": {\n              \"OR\": {\n                \"left\": {\n                  \"raw_text\": \"History of a chronic pain condition\"\n                },\n                \"right\": {\n                  \"OR\": {\n                    \"raw_text\": \"History of severe mental illness (as their experience of symptoms may already be altered)\"\n                    },\n                    \"right\": {\n                      \"OR\": {\n                        \"raw_text\": \"Current use of fibrates (because of the risk of interaction with statins but will not exclude participants taking ezetimibe).\"\n                        },\n                        \"right\": {\n                          \"OR\": {\n                            \"left\": {\n                              \"raw_text\": \"Severe previous reaction or reaction considered immunological, such as anaphylaxis, facial swelling, severe rash, muscle ache with rise in serum creatine kinase, inflammatory myopathy, rhabdomyolysis or liver function abnormalities (aspartate transaminase (AST) or alanine transaminase (ALT) greater than 3 times upper limit or normal).\"\n                            },\n                            \"right\": {\n                              \"OR\": {\n                                \"left\": {\n                                  \"raw_text\": \"Side-effects taking longer than 2 weeks to develop (because in such participants much longer blocks of treatment would be required, if the present study is positive such studies will be planned for the future)*.\"\n                                },\n                                \"right\": {\n                                  \"OR\": {\n                                    \"left\": {\n                                      \"raw_text\": \"History of statin intolerance with drug interaction to antiretroviral drugs.\"\n                                    },\n                                    \"right\": {\n                                      \"OR\": {\n                                        \"left\": {\n                                          \"raw_text\": \"History of statin intolerance to any other drug.\"\n                                        },\n                                        \"right\": {\n                                          \"OR\": {\n                                            \"raw_text\": \"Pregnant or breast feeding.\"\n                                            },\n                                            \"right\": {\n                                              \"OR\": {\n                                                \"raw_text\": \"Side effects taking longer than 2 weeks to present.\"\n                                                },\n                                                \"right\": {\n                                                  \"OR\": {\n                                                    \"left\": {\n                                                      \"raw_text\": \"In clinical judgement of study doctor, participant should not participate.\"\n                                                    }\n                                                  }\n                                                }\n                                              }\n                                            }\n                                          }\n                                        }\n                                      }\n                                    }\n                                  }\n                                }\n                            }\n                        }\n                    }\n                  }\n            