"{\n  \"AND\": {\n    \"left\": {\n      \"AND\": {\n        \"left\": {\n          \"raw_text\": \"18 years or older\"\n        },\n        \"right\": {\n          \"AND\": {\n            \"left\": {\n              \"raw_text\": \"Chest radiograph showing new opacities.\"\n            },\n            \"right\": {\n              \"AND\": {\n                \"left\": {\n                  \"OR\": {\n                    \"left\": {\n                      \"raw_text\": \"Cough\"\n                    },\n                    \"right\": {\n                      \"OR\": {\n                        \"left\": {\n                          \"raw_text\": \"Production of sputum\"\n                        }\n                      }\n                    }\n                }\n              }\n            },\n            \"right\": {\n              \"AND\": {\n                \"OR\": {\n                  \"left\": {\n                    \"raw_text\": \"Temp >38,0 °C or <36,0 °C\"\n                    },\n                    \"right\": {\n                      \"OR\": {\n                        \"left\": {\n                          \"raw_text\": \"Audible abnormalities by chest examination compatible with pneumonia\"\n                        }\n                      }\n                    }\n                }\n              }\n            },\n            \"right\": {\n              \"AND\": {\n                \"OR\": {\n                  \"left\": {\n                    \"raw_text\": \"Leukocytosis (>10.000 cells/mm3)\"\n                    },\n                    \"right\": {\n                      \"OR\": {\n                        \"left\": {\n                          \"raw_text\": \"leftward shift (>10%) or leucopenia (<4000 cells/mm3)\"\n                        }\n                      }\n                    }\n                }\n              }\n            }\n          }\n        },\n        \"right\": {\n          \"AND\": {\n            \"left\": {\n              \"OR\": {\n