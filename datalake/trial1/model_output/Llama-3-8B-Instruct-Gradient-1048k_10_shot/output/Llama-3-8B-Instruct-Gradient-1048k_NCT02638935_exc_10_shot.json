"{\n  \"AND\": {\n    \"left\": {\n      \"OR\": {\n        \"left\": {\n          \"raw_text\": \"Pregnant or lactating women\"\n        },\n        \"right\": {\n          \"OR\": {\n            \"left\": {\n              \"raw_text\": \"Women with breast implants on the same side as the lesion\"\n            },\n            \"right\": {\n              \"OR\": {\n                \"left\": {\n                  \"raw_text\": \"Women that underwent local radiation or chemotherapy within the last 12 months\"\n                },\n                \"right\": {\n                  \"OR\": {\n                    \"left\": {\n                      \"raw_text\": \"Women with history of breast cancer or breast surgery in the same quadrant\"\n                    },\n                    \"right\": {\n                      \"OR\": {\n                        \"left\": {\n                          \"raw_text\": \"Lesions in or close to scar tissue (< 1cm)\"\n                        },\n                        \"right\": {\n                          \"OR\": {\n                            \"left\": {\n                              \"raw_text\": \"Skin lesions or lesions that have been biopsied previously\"\n                            },\n                            \"right\": {\n                              \"OR\": {\n                                \"left\": {\n                                  \"raw_text\": \"Lesion larger than 4 cm in the longest dimension\"\n                                },\n                                \"right\": {\n                                  \"AND\": {\n                                    \"left\": {\n                                      \"raw_text\": \"No lesion should be included when more than 50% of the lesion is further down than 4 cm beneath the skin level.\"\n                                    }\n                                  }\n                                }\n                            }\n                          }\n                        }\n                    }\n                  }\n                }\n              }\n            }\n          }\n    }\n  }\n}"