"{\n  \"AND\": {\n    \"left\": {\n      \"OR\": {\n        \"left\": {\n          \"raw_text\": \"Contraindications to empagliflozin, Sitagliptin\"\n        },\n        \"right\": {\n          \"OR\": {\n            \"left\": {\n              \"raw_text\": \"DPP4 inhibitors or Sodium-glucose cotransporter-2(SGLT2) inhibitors within the previous 4 weeks\"\n            },\n            \"right\": {\n              \"OR\": {\n                \"left\": {\n                  \"raw_text\": \"Insulin requiring diabetes\"\n                },\n                \"right\": {\n                  \"OR\": {\n                    \"raw_text\": \"Poor glucose control (HbA1C>10 %)\"\n                    },\n                    \"right\": {\n                      \"OR\": {\n                        \"raw_text\": \"Acute coronary syndrome\"\n                        },\n                        \"right\": {\n                          \"OR\": {\n                            \"raw_text\": \"Stent placement within the previous 6 months\"\n                            },\n                            \"right\": {\n                              \"OR\": {\n                                \"raw_text\": \"Previous coronary artery bypass graft surgery within the previous 6 months\"\n                                },\n                                \"right\": {\n                                  \"OR\": {\n                                    \"raw_text\": \"Planned revascularization within 6 months\"\n                                    },\n                                    \"right\": {\n                                      \"OR\": {\n                                        \"raw_text\": \"Heart failure requiring loop diuretics\"\n                                        },\n                                        \"right\": {\n                                          \"OR\": {\n                                            \"raw_text\": \"Severe left ventricular hypertrophy (left ventricular septal wall thickness > 13mm)\"\n                                            },\n                                            \"right\": {\n                                              \"OR\": {\n                                                \"raw_text\": \"Significant renal disease manifested by creatinine clearance of < 30 ml/min)\"\n                                                },\n                                                \"right\": {\n                                                  \"OR\": {\n                                                    \"raw_text\": \"Hepatic disease or biliary tract obstruction, or significant hepatic enzyme elevation (alanine transaminase or Aspartate Aminotransferase > 3 times upper limit of normal)\"\n                                                    },\n                                                    \"right\": {\n                                                      \"OR\": {\n                                                        \"raw_text\": \"Radiopaque material implanted in the chest wall (metal, silicone, etc.)\"\n                                                        },\n                                                        \"right\": {\n                                                          \"OR\": {\n                                                            \"raw_text\": \"Contraindication to adenosine stress test\"}\n                                                          }\n                                                      }\n                                                    }\n                                                  }\n                                                }\n                                              }\n                                            }\n                                          }\n                                        }\n                                      }\n                                    }\n                                  }\n                   