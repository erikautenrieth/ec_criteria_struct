"{\n  \"AND\": {\n    \"left\": {\n      \"OR\": {\n        \"left\": {\n          \"raw_text\": \"Exclusion criteria include patients following resuscitation from cardiac arrest who are treated on the cooling protocol\"\n        },\n        \"right\": {\n          \"OR\": {\n            \"left\": {\n              \"raw_text\": \"patients who have suffered a neurologic event (seizure, stroke) or who have baseline dementia, both of which could limit delirium assessment\"\n            },\n            \"right\": {\n              \"OR\": {\n                \"raw_text\": \"patients with child class B and C liver disease\"\n            },\n            \"right\": {\n              \"OR\": {\n                \"raw_text\": \"patients with known allergy to study medications.\"\n            }\n          }\n        }\n      }\n    }\n  }\n}"