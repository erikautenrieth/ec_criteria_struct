"{\n  \"AND\": {\n    \"left\": {\n      \"AND\": {\n        \"left\": {\n          \"raw_text\": \"Women of child-bearing potential, who are biologically able to conceive, not employing two forms of highly effective contraception or who are pregnant.\"\n        },\n        \"right\": {\n          \"AND\": {\n            \"left\": {\n              \"raw_text\": \"Women who are breast-feeding.\"\n            },\n            \"right\": {\n              \"AND\": {\n                \"left\": {\n                  \"raw_text\": \"Fertile males unwilling to use contraception.\"\n                },\n                \"right\": {\n                  \"AND\": {\n                    \"left\": {\n                      \"raw_text\": \"Patients with brain metastases or any history of brain metastases.\"\n                    },\n                    \"right\": {\n                      \"AND\": {\n                        \"left\": {\n                          \"raw_text\": \"Patients who have undergone major surgery (e.g., intra-thoracic, -abdominal, or -pelvic) <= 4 weeks prior to starting study treatment or who have not recovered from such therapy.\"\n                        },\n                        \"right\": {\n                          \"AND\": {\n                            \"raw_text\": \"Patients with a history of pulmonary embolism, or untreated deep vein thrombosis within the past 6 months.\"\n                            },\n                            \"right\": {\n                              \"AND\": {\n                                \"left\": {\n                                  \"raw_text\": \"Impairment of gastrointestinal (GI) function or GI disease that may significantly alter the absorption of dovitinib.\"\n                                },\n                                \"right\": {\n                                  \"AND\": {\n                                    \"left\": {\n                                      \"raw_text\": \"The subject has had another active malignancy within the past 5 years except for cervical cancer in situ, in situ carcinoma of the bladder or non-melanoma carcinoma of the skin.\"\n                                    },\n                                    \"right\": {\n                                      \"AND\": {\n                                        \"raw_text\": \"Patients who have received the last administration of an anticancer therapy including chemotherapy, immunotherapy, hormonal therapy and monoclonal antibodies <= 2 weeks prior to starting the study drug, or who have not recovered from the side effects of such therapy.\"\n                                        },\n                                        \"right\": {\n                                          \"AND\": {\n                                            \"raw_text\": \"Cirrhosis, chronic active hepatitis or chronic persistent hepatitis.\"\n                                            },\n                                            \"right\": {\n                                              \"AND\": {\n                                                \"raw_text\": \"Patients who are currently receiving prasugrel.\"\n                                                },\n                                                \"right\": {\n                                                  \"AND\": {\n                                                    \"raw_text\": \"No concurrent use of isoniazid, labetolol, trovafloxacin, tolcapone, and felbamate.\"\n                                                    },\n                                                    \"right\": {\n                                                      \"AND\": {\n                                                        \"raw_text\": \"No concurrent use of other investigational drugs or antineoplastic therapies.\"\n                                                        },\n                                                        \"right\": {\n                                                          \"AND\": {\n                                                            \"raw_text\": \"Patients with impaired cardiac function or clinically significant cardiac diseases.\"\n                                                            }\n                                                          }\n                                                      }\n                                                    }\n                                                  }\n                                                }\n                                              }\n                                            }\n                                          }\n                                        }\n                                      }\n                                    }\n                                  }\n                                }\n                              }\n                            }\n                          }\n                        }\n                      }\n                    }\n                  }\n                }\n              }\n            }\n          }\n        }\n      }\n  }\n}"