"{\n  \"AND\": {\n    \"left\": {\n      \"OR\": {\n        \"left\": {\n          \"raw_text\": \"Patients Level III or greater on the American Society of Anesthesiologists (ASA) physical status classification system (as determined by the anesthesiologist)\"\n        },\n        \"right\": {\n          \"AND\": {\n            \"left\": {\n              \"raw_text\": \"Patients with chronic conditions that would limit our ability to develop the study according to objectives, such as neurodevelopmental conditions preventing patients from understanding the Oucher tool\"}\n            },\n            \"right\": {\n              \"AND\": {\n                \"OR\": {\n                  \"left\": {\n                    \"raw_text\": \"Hepatic or renal disease\"}\n                },\n                \"right\": {\n                  \"OR\": {\n                    \"raw_text\": \"cardiac disease\"}\n                }\n              }\n            },\n            \"right\": {\n              \"AND\": {\n                \"OR\": {\n                  \"left\": {\n                    \"raw_text\": \"active infection\"}\n                },\n                \"right\": {\n                  \"OR\": {\n                    \"raw_text\": \"diabetes mellitus\"}\n                }\n              }\n            },\n            \"right\": {\n              \"AND\": {\n                \"OR\": {\n                  \"left\": {\n                    \"raw_text\": \"sickle cell disease\"}\n                },\n                \"right\": {\n                  \"OR\": {\n                    \"raw_text\": \"known coagulation disorders\"}\n                }\n              }\n            },\n            \"right\": {\n              \"AND\": {\n                \"OR\": {\n                  \"left\": {\n                    \"raw_text\": \"pre- operative treatment with anti-emetics, steroids, or analgesics\"}\n                },\n                \"right\": {\n                  \"OR\": {\n                    \"raw_text\": \"Acetaminophen allergy or already receiving acetaminophen within 24 h of surgery\"}\n                }\n              }\n            },\n            \"right\": {\n              \"AND\": {\n                \"OR\": {\n                  \"left\": {\n                    \"raw_text\": \"Complicating health factors precluding the use of opioids or acetaminophen\"}\n                },\n                \"right\": {\n                  \"OR\": {\n                    \"raw_text\": \"any other factors which would interfere with pain assessment and management\"}\n                }\n              }\n            },\n            \"right\": {\n              \"AND\": {\n                \"OR\": {\n                  \"left\": {\n                    \"raw_text\": \"Patients weighing more than 30 kg that would exceed maximum dexamethasone dose\"}\n                },\n                \"right\": {\n                  \"OR\": {\n                    \"raw_text\": \"Patients who live without a home telephone\"}\n                }\n              }\n            },\n            \"right\": {\n              \"AND\": {\n                \"OR\": {\n                  \"left\": {\n                    \"raw_text\": \"patient living without parental supervision.\"\n                }\n              }\n            }\n          }\n        }\n      }\n  }\n}"