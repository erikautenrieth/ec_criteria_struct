"{\n  \"AND\": {\n    \"left\": {\n      \"AND\": {\n        \"left\": {\n          \"raw_text\": \"Diagnosis of Type 1 diabetes (for at least a year)\"\n        },\n        \"right\": {\n          \"AND\": {\n            \"left\": {\n              \"OR\": {\n                \"left\": {\n                  \"raw_text\": \"On multiple daily insulin injections, including basal long-acting insulin and rapid-acting insulin before each meal.\"\n                },\n                \"right\": {\n                  \"AND\": {\n                    \"left\": {\n                      \"raw_text\": \"HbA1c < 75 mmol/mol (9.0%)\"\n                    },\n                    \"right\": {\n                      \"AND\": {\n                        \"left\": {\n                          \"raw_text\": \"Participant and/or parent/legal guardian willing and able to give informed consent for participation in the study.\"\n                        },\n                        \"right\": {\n                          \"AND\": {\n                            \"left\": {\n                              \"raw_text\": \"Family have a freezer in which to safely store the test meals.\"\n                            },\n                            \"right\": {\n                              \"AND\": {\n                                \"left\": {\n                                  \"raw_text\": \"In the Investigator's opinion, is able and willing to comply with all trial requirements.\"\n                                }\n                              }\n                            }\n                          }\n                        }\n                      }\n                    }\n                  }\n                }\n              }\n            }\n          }\n        }\n      }\n    }\n  }\n}"