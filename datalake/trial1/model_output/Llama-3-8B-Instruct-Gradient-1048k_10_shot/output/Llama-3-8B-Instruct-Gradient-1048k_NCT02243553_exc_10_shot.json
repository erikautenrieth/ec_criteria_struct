"{\n  \"AND\": {\n    \"left\": {\n      \"OR\": {\n        \"left\": {\n          \"raw_text\": \"1. History or presence of allergy to the study drugs or their components or drugs of their class, or a history of drug or other allergy that, in the opinion of the physician responsible, contraindicates their participation\"\n        },\n        \"right\": {\n          \"OR\": {\n            \"left\": {\n              \"raw_text\": \"2. Any finding of the medical examination (including blood pressure, pulse rate and electrocardiogram) deviating from normal and of clinical relevance\"\n            },\n            \"right\": {\n              \"OR\": {\n                \"raw_text\": \"3. History or diagnosis of any significant medical conditions: Including but not limited to gastrointestinal, hepatic, renal, respiratory, cardiovascular, metabolic, immunologic, hematological, psychiatric, neurological, oncological or hormonal disorders\"\n            },\n            \"right\": {\n              \"OR\": {\n                \"raw_text\": \"4. Known elevated liver enzymes in past clinical trials with any compound (experimental or marketed)\"\n            },\n            \"right\": {\n              \"OR\": {\n                \"raw_text\": \"5. Clinically relevant laboratory abnormalities (e.g. Hgb<11g/dL, Hct<30g/dL, total cholesterol >240mg/dL, triglycerides >500mg/dL, fasting glucose >130mg/dL, liver function tests >2.5x upper limit of normal, baseline international normalized ratio >1.2)\"\n            },\n            \"right\": {\n              \"OR\": {\n                \"raw_text\": \"6. History of evidence of clinically significant hepatic, cardiac, pulmonary, endocrine, immunological, gastrointestinal, hematological, vascular or collagen disease\"\n            },\n            \"right\": {\n              \"OR\": {\n                \"raw_text\": \"7. History of alcohol abuse or use of any illicit drugs\"\n            },\n            \"right\": {\n              \"OR\": {\n                \"raw_text\": \"8. Unable to abstain from more than one beer or alcohol equivalent per day for the duration of the study\"\n            },\n            \"right\": {\n              \"OR\": {\n                \"raw_text\": \"9. Use of tobacco products and/or history of smoking within the past 2 months\"\n            },\n            \"right\": {\n              \"OR\": {\n                \"raw_text\": \"10. Pregnant or breast feeding\"\n            },\n            \"right\": {\n              \"OR\": {\n                \"rawtext\": \"11. Sexually active women of childbearing age who do not use an acceptable barrier method of birth control\"\n            },\n            \"right\": {\n              \"OR\": {\n                \"rawtext\": \"12. Hypersensitivity to caffeine, warfarin, vitamin K, omeprazole, dextromethorphan, midazolam, tipranavir, ritonavir or their excipients\"\n            },\n            \"right\": {\n              \"OR\": {\n                \"rawtext\": \"13. Concomitant treatment with other experimental compounds\"\n            },\n            \"right\": {\n              \"OR\": {\n                \"rawtext\": \"14. Concomitant administration of any prescription or over the counter medications known to alter P450 enzyme or P-gp activity\"\n            },\n            \"right\": {\n              \"OR\": {\n                \"rawtext\": \"15. Concomitant administration of any prescription or over the counter medications known to be highly dependent on P450 or P-gp for clearance for which elevated plasma concentrations are known to be associated with serious toxicity\"\n            },\n            \"right\": {\n              \"OR\": {\n                \"rawtext\": \"16. Concomitant administration of any food product known to alter P450 enzyme or P-gp activity such as grapefruit juice, Seville oranges\"\n            },\n            \"right\": {\n              \"OR\": {\n                \"rawtext\": \"17. Concomitant administration of any drug that could affect bleeding (e.g., aspirin, clopidogrel, ticlopidine, warfarin, heparin, low-molecular weight heparin)\"\n            },\n            \"right\": {\n              \"OR\": {\n                \"rawtext\": \"18. Concomitant administration of oral contraceptives (may be included with 7-day washout period)\"\n            },\n            \"right\": {\n              \"OR\": {\n                \"rawtext\": \"19. Concomitant administration of any herbal medications\"\n            },\n            \"right\": {\n              \"OR\": {\n                \"rawtext\": \"20. Inadequate venous access\"\n            },\n            \"right\": {\n              \"OR\": {\n                \"rawtext\": \"21. Renal or hepatic insufficiency\"\n            },\n            \"right\": {\n              \"OR\": {\n                \"rawtext\": \"22. Clinically unacceptable result at the screening physical examination\"\n            },\n            \"right\": {\n              \"OR\": {\n                \"rawtext\": \"23. Use of investigational medications within 30 days before study entry\"\n            },\n            \"right\": {\n              \"OR\": {\n                \"rawtext\": \"24. HIV-positive\"\n            },\n            \"right\": {\n              \"OR\": {\n                \"rawtext\": \"25. Body Mass Index (BMI) > 30 kg/m²\"\n            }\n          }\n        }\n      }\n    }\n  }\n}"