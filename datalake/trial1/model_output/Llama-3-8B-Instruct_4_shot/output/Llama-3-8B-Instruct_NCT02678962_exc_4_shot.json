"{\n  \"AND\": {\n    \"left\": {\n      \"OR\": {\n        \"left\": {\n          \"raw_text\": \"Preexisting ocular diseases or conditions other than age related cataracts\"\n        },\n        \"right\": {\n          \"raw_text\": \"have contraindications for cataract surgery;\"\n        }\n      }\n    },\n    \"right\": {\n      \"AND\": {\n        \"left\": {\n          \"OR\": {\n            \"left\": {\n              \"raw_text\": \"Preexisting systemic diseases or conditions that may confound the results of the study;\"\n            },\n            \"right\": {\n              \"raw_text\": \"previous ocular surgery history or ocular trauma that may confound the results of the study;\"\n            }\n          }\n        },\n        \"right\": {\n          \"AND\": {\n            \"left\": {\n              \"OR\": {\n                \"left\": {\n                  \"raw_text\": \"require combined surgery that may confound the results of the study;\"\n                },\n                \"right\": {\n                  \"raw_text\": \"previous participation in other clinical trial within 30 days of this study start;\"\n                }\n              }\n            },\n            \"right\": {\n              \"AND\": {\n                \"left\": {\n                  \"OR\": {\n                    \"left\": {\n                      \"raw_text\": \"systemic or ocular medications that may confound the outcome of the intervention\"\n                    },\n                    \"right\": {\n                      \"OR\": {\n                        \"left\": {\n                          \"raw_text\": \"Pregnant\"\n                        },\n                        \"right\": {\n                          \"OR\": {\n                            \"left\": {\n                              \"raw_text\": \"lactating\"\n                            },\n                            \"right\": {\n                              \"raw_text\": \"or planning to become pregnant during the course of the trial;\"\n                            }\n                          }\n                        }\n                      }\n                    }\n                  }\n                }\n              }\n            }\n          }\n        }\n      }\n    }\n  }\n}"