"{\n  \"AND\": {\n    \"left\": {\n      \"OR\": {\n        \"left\": {\n          \"raw_text\": \"Males\"\n        },\n        \"right\": {\n          \"raw_text\": \"and females\"\n        }\n      },\n      \"right\": {\n        \"AND\": {\n          \"left\": {\n            \"AND\": {\n              \"left\": {\n                \"raw_text\": \"aged between 18 to 75 years\"\n              }\n            }\n          },\n          \"right\": {\n            \"AND\": {\n              \"left\": {\n                \"raw_text\": \"Adult patient under guardianship\"\n              },\n              \"right\": {\n                \"AND\": {\n                  \"left\": {\n                    \"raw_text\": \"with consent obtained\"\n                  },\n                  \"right\": {\n                    \"raw_text\": \"and the legal guardian's authorisation obtained\"\n                  }\n                }\n              }\n            }\n          }\n        }\n      }\n    },\n    \"right\": {\n      \"AND\": {\n        \"left\": {\n          \"AND\": {\n            \"left\": {\n              \"raw_text\": \"Single stroke having occurred more than 6 months before\"\n            },\n            \"right\": {\n              \"raw_text\": \"(previous TIA is accepted).\"\n            }\n          }\n        },\n        \"right\": {\n          \"AND\": {\n            \"left\": {\n              \"raw_text\": \"Capable of understanding instructions and participating in the definition of a therapeutic goal\"\n            },\n            \"right\": {\n              \"raw_text\": \"(Boston Diagnostic Aphasia Examination (BDAE) < 3).\"\n            }\n          }\n        }\n      },\n      \"right\": {\n        \"AND\": {\n          \"left\": {\n            \"raw_text\": \"Having previously undergone BTI.\"\n          },\n          \"right\": {\n            \"AND\": {\n              \"left\": {\n                \"raw_text\": \"The last injection must have been performed at least 4 months prior to inclusion.\"\n              }\n            }\n          }\n        },\n        \"right\": {\n          \"AND\": {\n            \"left\": {\n              \"raw_text\": \"Affiliation to the French social security regime or a similar regime.\"\n            },\n            \"right\": {\n              \"AND\": {\n                \"left\": {\n                  \"raw_text\": \"Patient (or the legal guardian if under guardian adult patient) has signed the informed consent form.\"\n                }\n              }\n            }\n          }\n        }\n      }\n    }\n  }\n}"