"{\n  \"AND\": {\n    \"left\": {\n      \"OR\": {\n        \"left\": {\n          \"raw_text\": \"the child has temperature > 39.0◦C\"\n        },\n        \"right\": {\n          \"raw_text\": \"or a severe acute illness as defined by the examining nurse\"\n        }\n      }\n    },\n    \"right\": {\n      \"OR\": {\n        \"left\": {\n          \"raw_text\": \"the child has as a mid upper arm circumference < 110 mm\"\n        },\n        \"right\": {\n          \"AND\": {\n            \"left\": {\n              \"raw_text\": \"and is older than 6 months\"\n            },\n            \"right\": {\n              \"raw_text\": \"(most feasible local indicator of AIDS and chronic immunosuppressive disease)\"\n            }\n          }\n        }\n      }\n    }\n  },\n  \"OR\": {\n    \"left\": {\n      \"raw_text\": \"the child has experienced a severe allergic reaction after previous vaccination, drug or food.\"\n    }\n  },\n  \"OR\": {\n    \"left\": {\n      \"AND\": {\n        \"left\": {\n          \"raw_text\": \"the child is enrolled in an ongoing study of Bacillus Calmette Guerin vaccine\"\n        },\n        \"right\": {\n          \"raw_text\": \"and is < 2 months old\"\n        }\n      }\n    }\n  },\n  \"OR\": {\n    \"left\": {\n      \"raw_text\": \"For the RECAMP-MV trial: the child is enrolled in RECAMP-OPV\"\n    }\n  }\n}"