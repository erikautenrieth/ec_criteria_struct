"{\n  \"AND\": {\n    \"left\": {\n      \"AND\": {\n        \"left\": {\n          \"OR\": {\n            \"left\": {\n              \"raw_text\": \"Over 18 years of age\"\n            },\n            \"right\": {\n              \"raw_text\": \"; Systemically healthy\"\n            }\n          }\n        },\n        \"right\": {\n          \"AND\": {\n            \"left\": {\n              \"OR\": {\n                \"left\": {\n                  \"raw_text\": \"Non-smoking\"\n                },\n                \"right\": {\n                  \"raw_text\": \"; With good oral hygiene\"\n                }\n              }\n            },\n            \"right\": {\n              \"AND\": {\n                \"left\": {\n                  \"raw_text\": \"Absent irreversible pulpal alteration\"\n                },\n                \"right\": {\n                  \"AND\": {\n                    \"left\": {\n                      \"OR\": {\n                        \"left\": {\n                          \"raw_text\": \"With the presence of a non-carious cervical lesion (LCNCs) that needs to be restored.\"\n                        },\n                        \"right\": {\n                          \"AND\": {\n                            \"left\": {\n                              \"raw_text\": \"This lesion should be non-carious, non-retentive, with at least 1 mm and up to 3 mm depth,\"\n                            },\n                            \"right\": {\n                              \"AND\": {\n                                \"left\": {\n                                  \"raw_text\": \"should involve both enamel and dentin of vital teeth without mobility,\"\n                                },\n                                \"right\": {\n                                  \"raw_text\": \"and present hypersensitivity;\"\n                                }\n                              }\n                            }\n                          }\n                   