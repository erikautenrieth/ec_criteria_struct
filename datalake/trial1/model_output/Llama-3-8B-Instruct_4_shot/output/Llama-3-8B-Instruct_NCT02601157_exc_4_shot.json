"{\n  \"AND\": {\n    \"left\": {\n      \"OR\": {\n        \"left\": {\n          \"AND\": {\n            \"left\": {\n              \"OR\": {\n                \"left\": {\n                  \"raw_text\": \"High risk profiles for ischemic adverse events\"\n                },\n                \"right\": {\n                  \"AND\": {\n                    \"left\": {\n                      \"OR\": {\n                        \"left\": {\n                          \"raw_text\": \"such as A. ST-segment elevation myocardial infarction (STEMI)\"\n                        },\n                        \"right\": {\n                          \"OR\": {\n                            \"left\": {\n                              \"raw_text\": \"B. Patients with cardiogenic shock or concomitant severe decompensated heart failure\"\n                            },\n                            \"right\": {\n                              \"OR\": {\n                                \"left\": {\n                                  \"raw_text\": \"C. Myocardial infarction or stent thrombosis in spite of the maintenance of antiplatelet therapy\"\n                                },\n                                \"right\": {\n                                  \"OR\": {\n                                    \"left\": {\n                                      \"raw_text\": \"D. Restenosis in stented segments or previous sites of balloon angioplasty\"\n                                    }\n                                  }\n                                }\n                              }\n                            }\n                          }\n                        }\n                      }\n                    }\n                  }\n                }\n              }\n            },\n            \"right\": {\n              \"OR\": {\n                \"left\": {\n                  \"raw_text\": \"2. Patients who cannot follow allocated DAPT schedule due to the planned surgery or elective procedure within 3 months after the stenting\"\n                },\n                \"right\": {\n                  \"OR\": {\n                    \"left\": {\n                      \"raw_text\": \"3. Recent history of major surgery or evident events of gastrointestinal bleeding within 1 month from the procedure\"\n                    },\n                    \"right\": {\n                      \"OR\": {\n                        \"left\": {\n                          \"raw_text\": \"4. Patients on anticoagulation therapy with warfarin or other anticoagulants\"\n                        },\n                        \"right\": {\n                          \"OR\": {\n                            \"left\": {\n                              \"raw_text\": \"5. Life expectancy less than 1 year (such as malignancies or other chronic systemic diseases)\"\n                            },\n                            \"right\": {\n                              \"OR\": {\n                                \"left\": {\n                                  \"raw_text\": \"6. Pregnant women\"\n                                },\n                                \"right\": {\n                                  \"OR\": {\n                                    \"left\": {\n                                      \"raw_text\": \"7. Past history of allergy or other contraindications for the following medications/materials: aspirin, clopidogrel, heparin, cobalt chromium, sirolimus\"\n                                    }\n                                  }\n                                }\n                              }\n                            }\n                          }\n                        }\n                      }\n                    }\n                  }\n                }\n              }\n            }\n          }\n        }\n      }\n    }\n  }\n}"