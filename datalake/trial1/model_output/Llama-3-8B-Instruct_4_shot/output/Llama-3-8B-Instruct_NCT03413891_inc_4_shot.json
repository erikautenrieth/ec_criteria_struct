"{\n  \"AND\": {\n    \"left\": {\n      \"OR\": {\n        \"left\": {\n          \"raw_text\": \"Patients scheduled for dental extraction\"\n        },\n        \"right\": {\n          \"AND\": {\n            \"left\": {\n              \"OR\": {\n                \"left\": {\n                  \"raw_text\": \"and treated with edoxaban\"\n                },\n                \"right\": {\n                  \"OR\": {\n                    \"left\": {\n                      \"raw_text\": \"apixaban\"\n                    },\n                    \"right\": {\n                      \"OR\": {\n                        \"left\": {\n                          \"raw_text\": \"rivaroxaban\"\n                        },\n                        \"right\": {\n                          \"raw_text\": \"or dabigatran\"\n                        }\n                      }\n                    }\n                  }\n                }\n              }\n            }\n          }\n        }\n      }\n    },\n    \"right\": {\n      \"AND\": {\n        \"left\": {\n          \"NOT\": {\n            \"left\": {\n              \"raw_text\": \"Not having taken the direct oral anticoagulant on the day of the extraction\"\n            }\n          }\n        },\n        \"right\": {\n          \"AND\": {\n            \"left\": {\n              \"raw_text\": \"Provision of signed and dated informed consent form\"\n            },\n            \"right\": {\n              \"AND\": {\n                \"left\": {\n                  \"raw_text\": \"Stated willingness to comply with all study procedures\"\n                },\n                \"right\": {\n                  \"raw_text\": \"and availability for the duration of the study\"\n                }\n              }\n            }\n          }\n        }\n      }\n    }\n  }\n}"