"{\n  \"AND\": {\n    \"left\": {\n      \"OR\": {\n        \"left\": {\n          \"raw_text\": \"1. Atrial fibrillation\"\n        },\n        \"right\": {\n          \"OR\": {\n            \"left\": {\n              \"raw_text\": \"2. Subject underwent cardiac pacemaker treatment\"\n            },\n            \"right\": {\n              \"OR\": {\n                \"left\": {\n                  \"raw_text\": \"3. Subject underwent metal graft treatment\"\n                },\n                \"right\": {\n                  \"OR\": {\n                    \"left\": {\n                      \"raw_text\": \"4. Claustrophobia\"\n                    },\n                    \"right\": {\n                      \"AND\": {\n                        \"left\": {\n                          \"OR\": {\n                            \"left\": {\n                              \"raw_text\": \"5. Acute myocardial infarction, cardiac ischemia indicated by 6-minute walk test, hypertrophic cardiomyopathy, constrictive pericarditis, significant valve disease or congenital heart disease, severe pulmonary hypertension\"\n                            },\n                            \"right\": {\n                              \"OR\": {\n                                \"left\": {\n                                  \"raw_text\": \"6. Ischemic heart failure without the revascularization or undergone the revascularization within last 6 months\"\n                                },\n                                \"right\": {\n                                  \"OR\": {\n                                    \"left\": {\n                                      \"raw_text\": \"7. Subject underwent cardiac surgery or cerebrovascular events within the previous six months\"\n                                    },\n                                    \"right\": {\n                                      \"OR\": {\n                                        \"left\": {\n                                          \"raw_text\": \"8. Subjects who plan to have cardiac transplantation\"\n                                        },\n                                        \"right\": {\n                                          \"AND\": {\n                                            \"left\": {\n                                              \"OR\": {\n                                                \"left\": {\n                                                  \"raw_text\": \"9. Severe hepatic and renal insufficiency (serum creatinine>2.0 mg /dl, AST or ALT is five times higher than the upper limit of normal range)\"\n                                                },\n                                                \"right\": {\n                                                  \"OR\": {\n                                                    \"left\": {\n                                                      \"raw_text\": \"10. Subject needs mechanical ventilation\"\n                                                    },\n                                                    \"right\": {\n                                                      \"AND\": {\n                                                        \"left\": {\n                                                          \"OR\": {\n                                                            \"left\": {\n                                                              \"raw_text\": \"11. Systolic blood pressure < 90mmHg, or > 160mmHg\"\n                                                            },\n                                                            \"right\": {\n                                                              \"OR\": {\n                                                                \"left\": {\n                                                                  \"raw_text\": \"12. Chronic heart failure complicated with acute hemodynamic disturbance or acute decompensation within last 1 month\"\n                                                                },\n                                                                \"right\": {\n                                                                  \"OR\": {\n                                                                    \"left\": {\n                                                                      \"raw_text\": \"13. Mobitz Type II or III° atrial ventricular block，severe ventricular arrhythmia (polymorphic and frequent premature ventricular beats, frequent non-sustained ventricular tachycardia)\"\n                                                                    },\n                                                                    \"right\": {\n                                                                      \"OR\": {\n                                                                        \"left\": {\n                                                                          \"raw_text\": \"14. Serum potassium<3.2mmol/L, or>5.5mmol/L\"\n                                                                        },\n                                                                        \"right\": {\n                                                                          \"OR\": {\n                                                                            \"left\": {\n                                                                              \"raw_text\": \"15. Female subject is pregnant or plan to become pregnant\"\n                                                                            },\n                                                                            \"right\": {\n                                                                              \"OR\": {\n                                                                                \"left\": {\n                                                                                  \"raw_text\": \"16. Childbearing-aged female subject who is unmarried or dose not bear child\"\n                                                                                },\n                                                                                \"right\": {\n                                                                                  \"OR\": {\n                                                                                    \"left\": {\n                                                                                      \"raw_text\": \"17. Subject with life expectancy less than 6 months as assessed by investigators\"\n                                                                                    },\n                                                                                    \"right\": {\n                                                                                      \"OR\": {\n                                                                                        \"left\": {\n                                                                                          \"raw_text\": \"18. Subject participated in any other clinical trial within the previous three months\"\n                                                                                        },\n                                                                                        \"right\": {\n                                                                                          \"OR\": {\n                                                                                            \"left\": {\n                                                                                              \"raw_text\": \"19. Subject with previous history of tumor, or current tumor patient, or subject with pre-cancerous disease manifested by pathological examination (such as ductal carcinoma in situ or cervical epithelial dysplasia)\"\n                                                                                            },\n                                                                                            \"right\": {\n                                                                                              \"OR\": {\n                                                                                                \"left\": {\n                                                                                                  \"raw_text\": \"20. Examinations (physical examination, X-ray examination, type-B ultrasonic detection or other methods) reveal that the subject has malignant mass, gland hyperplasia or adenoma with endocrine activity, or impact on heart, or endocrine function (such as pheochromocytoma, thyroid enlargement)\"\n                                                                                                },\n                                                                                                \"right\": {\n                                                                                                  \"OR\": {\n                                                                                                    \"left\": {\n                                                                                                      \"raw_text\": \"21. The Investigator deemed for whatever reason that the subject is not likely to complete the study or comply with the study procedures (due to administration or any other reason)\"\n                                                                                                    }\n                                                                                                  }\n                                                                                                }\n                                                                                          }\n                                                                                        }\n                                                                                      }\n                                                                                    }\n                                                                                  }\n                                                                                }\n                                                                              }\n                                                                            }\n                                                                          }\n                                                                        }\n                                                                      }\n                                                                    }\n                                                                  }\n                                                                }\n                                                              }\n                                                            }\n                                                          }\n                                                        }\n                                                      }\n                                                    }\n                                                  }\n                                                }\n                                              }\n                                            }\n                                          }\n                                        }\n                                      }\n                                    }\n                                  }\n                                }\n                              }\n                            }\n                          }\n                        }\n                      }\n                    }\n                  }\n                }\n              }\n            }\n          }\n        }\n      }\n    }\n  }\n}"