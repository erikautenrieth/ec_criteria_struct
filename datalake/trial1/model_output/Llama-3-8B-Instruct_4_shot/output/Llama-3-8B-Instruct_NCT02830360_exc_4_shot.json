"{\n  \"AND\": {\n    \"left\": {\n      \"OR\": {\n        \"left\": {\n          \"raw_text\": \"Unable or unwilling to provide informed consent.\"\n        },\n        \"right\": {\n          \"AND\": {\n            \"left\": {\n              \"OR\": {\n                \"left\": {\n                  \"raw_text\": \"Active ischemia\"\n                },\n                \"right\": {\n                  \"OR\": {\n                    \"left\": {\n                      \"raw_text\": \"(acute thrombus diagnosed by coronary angiography, or dynamic ST segment changes demonstrated on ECG)\"\n                    },\n                    \"right\": {\n                      \"OR\": {\n                        \"left\": {\n                          \"raw_text\": \"or another reversible cause of VT (e.g. drug-induced arrhythmia)\"\n                        },\n                        \"right\": {\n                          \"OR\": {\n                            \"left\": {\n                              \"raw_text\": \"had recent acute coronary syndrome within 30 days\"\n                            },\n                            \"right\": {\n                              \"OR\": {\n                                \"left\": {\n                                  \"raw_text\": \"coronary revascularization (<90 days bypass surgery, <30 days percutaneous coronary intervention)\"\n                                },\n                                \"right\": {\n                                  \"OR\": {\n                                    \"left\": {\n                                      \"raw_text\": \"or have CCS functional class IV angina.\"\n                                    }\n                                  }\n                                }\n                              }\n                            }\n                          }\n                        }\n                      }\n                    }\n                  }\n                }\n              }\n            },\n            \"right\": {\n              \"AND\": {\n                \"left\": {\n                  \"OR\": {\n                    \"left\": {\n                      \"raw_text\": \"Are ineligible to take the antiarrhythmic drug to which they would be assigned due to allergy, intolerance or contraindication\"\n                    }\n                  },\n                  \"right\": {\n                    \"OR\": {\n                      \"left\": {\n                        \"raw_text\": \"Are known to have protruding left ventricular thrombus or mechanical aortic and mitral valves\"\n                      },\n                      \"right\": {\n                        \"OR\": {\n                          \"left\": {\n                            \"raw_text\": \"Have had a prior catheter ablation procedure for VT\"\n                          },\n                          \"right\": {\n                            \"OR\": {\n                              \"left\": {\n                                \"raw_text\": \"Are in renal failure (Creatinine clearance <15 mL/min)\"\n                              },\n                              \"right\": {\n                                \"OR\": {\n                                  \"left\": {\n                                    \"raw_text\": \"have NYHA Functional class IV heart failure\"\n                                  },\n                                  \"right\": {\n                                    \"OR\": {\n                                      \"left\": {\n                                        \"raw_text\": \"or a systemic illness likely to limit survival to <1 year\"\n                                      }\n                                    }\n                                  }\n                                }\n                              }\n                            }\n                          }\n                        }\n                      }\n                    }\n                  }\n                }\n              }\n            }\n          }\n        }\n      }\n    },\n    \"right\": {\n      \"AND\": {\n        \"left\": {\n          \"OR\": {\n            \"left\": {\n              \"raw_text\": \"Have had recent ST elevation myocardial infarction or non-ST elevation MI (< 30 days)\"\n            },\n            \"right\": {\n              \"raw_text\": \"; note that biomarker elevation alone after ventricular arrhythmias does not denote MI.\"\n            }\n          }\n        },\n        \"right\": {\n          \"OR\": {\n            \"left\": {\n              \"raw_text\": \"Are pregnant.\"\n            }\n          }\n        }\n      }\n    }\n  }\n}"