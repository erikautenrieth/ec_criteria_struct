"{\n  \"AND\": {\n    \"left\": {\n      \"OR\": {\n        \"left\": {\n          \"raw_text\": \"Have a history of myocardial infarction in the past 6 months\"\n        },\n        \"right\": {\n          \"OR\": {\n            \"left\": {\n              \"raw_text\": \"Have a contraindication to NRT with no medical clearance from the primary care provider or study physician\"\n            },\n            \"right\": {\n              \"OR\": {\n                \"left\": {\n                  \"raw_text\": \"Use and unwillingness to stop use of other forms of nicotine such as cigars, pipes, or chewing tobacco\"\n                },\n                \"right\": {\n                  \"OR\": {\n                    \"left\": {\n                      \"raw_text\": \"Are pregnant\"\n                    },\n                    \"right\": {\n                      \"OR\": {\n                        \"left\": {\n                          \"raw_text\": \"Meet criteria for a current manic episode based on structured clinical interview\"\n                        },\n                        \"right\": {\n                          \"OR\": {\n                            \"left\": {\n                              \"raw_text\": \"Are currently enrolled in another smoking cessation trial\"\n                            },\n                            \"right\": {\n                              \"raw_text\": \"Are currently imprisoned or in psychiatric hospitalization\"\n                            }\n                          }\n                        }\n                      }\n                    }\n                  }\n                }\n              }\n            }\n          }\n        }\n      }\n    }\n  }\n}"