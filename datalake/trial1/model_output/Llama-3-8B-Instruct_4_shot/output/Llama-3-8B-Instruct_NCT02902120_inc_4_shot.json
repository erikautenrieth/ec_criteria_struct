"{\n  \"AND\": {\n    \"left\": {\n      \"AND\": {\n        \"left\": {\n          \"raw_text\": \"At least 18 years of age at the time of screening\"\n        },\n        \"right\": {\n          \"AND\": {\n            \"left\": {\n              \"raw_text\": \"Have stable renal function for one month (30 days) prior to enrollment\"\n            },\n            \"right\": {\n              \"AND\": {\n                \"left\": {\n                  \"AND\": {\n                    \"left\": {\n                      \"raw_text\": \"Have Chronic HCV infection prior to transplantation\"\n                    },\n                    \"right\": {\n                      \"AND\": {\n                        \"left\": {\n                          \"raw_text\": \"with documented HCV viremia = 1,000 IU/ml at screening\"\n                        },\n                        \"right\": {\n                          \"OR\": {\n                            \"left\": {\n                              \"raw_text\": \"and either documented HCV Ab positivity\"\n                            },\n                            \"right\": {\n                              \"OR\": {\n                                \"left\": {\n                                  \"raw_text\": \"or HCV viremia = 1,000 IU/ml at least 6 months prior to enrollment.\"\n                                }\n                              }\n                            }\n                          }\n                        }\n                      }\n                    }\n                  }\n                },\n                \"right\": {\n                  \"AND\": {\n                    \"left\": {\n                      \"raw_text\": \"Documented genotype 1 HCV infection prior to enrollment\"\n                    },\n                    \"right\": {\n                      \"AND\": {\n                        \"left\": {\n                          \"raw_text\": \"and after their transplant in the post-transplantation cohort\"\n                        }\n                      }\n                    }\n                  }\n                }\n              }\n            }\n          }\n        }\n      }\n    },\n    \"right\": {\n      \"AND\": {\n        \"left\": {\n          \"AND\": {\n            \"left\": {\n              \"raw_text\": \"HCV disease staging within 12 months prior to enrollment\"\n            },\n            \"right\": {\n              \"OR\": {\n                \"left\": {\n                  \"raw_text\": \"by liver biopsy\"\n                },\n                \"right\": {\n                  \"OR\": {\n                    \"left\": {\n                      \"raw_text\": \"or transient elastography\"\n                    },\n                    \"right\": {\n                      \"raw_text\": \"or biochemical testing\"\n                    }\n                  }\n                }\n              }\n            }\n          },\n          \"right\": {\n            \"AND\": {\n              \"left\": {\n                \"raw_text\": \"Be able to give informed consent and comply with study guidelines\"\n                },\n              \"right\": {\n                \"AND\": {\n                  \"left\": {\n                    \"OR\": {\n                      \"left\": {\n                        \"raw_text\": \"Women of childbearing age will be required to have a negative pregnancy test at enrollment\"\n                      },\n                      \"right\": {\n                        \"raw_text\": \"and use birth control throughout the duration of treatment.\"\n                      }\n                    }\n                  }\n                }\n              }\n            }\n          }\n        },\n        \"right\": {\n          \"AND\": {\n            \"left\": {\n              \"OR\": {\n                \"left\": {\n                  \"raw_text\": \"On the transplant waiting list followed by the University of Maryland's nephrology clinic\"\n                },\n                \"right\": {\n                  \"OR\": {\n                    \"left\": {\n                      \"raw_text\": \"or the Baltimore VA's nephrology clinic\"\n                    }\n                  }\n                }\n              }\n            },\n            \"right\": {\n              \"OR\": {\n                \"left\": {\n                  \"raw_text\": \"On chronic hemodialysis not yet on the transplant list and followed in the University's hemodialysis center\"\n                },\n                \"right\": {\n                  \"raw_text\": \"or in the University's nephrology clinic\"\n                }\n              }\n            }\n          }\n        }\n      }\n    },\n    \"right\": {\n      \"AND\": {\n        \"left\": {\n          \"raw_text\": \"Have chronic kidney disease with GFR <50\"\n        }\n      }\n    }\n  }\n}"