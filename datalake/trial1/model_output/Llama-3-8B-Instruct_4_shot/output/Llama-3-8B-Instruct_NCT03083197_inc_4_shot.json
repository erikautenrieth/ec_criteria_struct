"{\n  \"AND\": {\n    \"left\": {\n      \"EQ\": {\n        \"left\": {\n          \"raw_text\": \"Age\"\n        },\n        \"right\": {\n          \"raw_text\": \"= 15 years old\"\n        }\n      }\n    },\n    \"right\": {\n      \"OR\": {\n        \"left\": {\n          \"AND\": {\n            \"left\": {\n              \"raw_text\": \"Hospitalization with acute undifferentiated fever\"\n            },\n            \"right\": {\n              \"raw_text\": \"(temperature > 37.5 C, tympanic) =14 days\"\n            }\n          }\n        },\n        \"right\": {\n          \"OR\": {\n            \"left\": {\n              \"raw_text\": \"or patients admitted to hospital with a history of fever\"\n            },\n            \"right\": {\n              \"AND\": {\n                \"left\": {\n                  \"raw_text\": \"= 14 days\"\n                },\n                \"right\": {\n                  \"raw_text\": \"who subsequently develop fever within 24 hours of admission\"\n                }\n              }\n            }\n          }\n        }\n      }\n    },\n    \"right\": {\n      \"AND\": {\n        \"left\": {\n          \"raw_text\": \"Clinically suspected scrub typhus: defined as acute undifferentiated fever with no clear focus of infection and negative malaria blood smear and/or negative malaria RDT.\"\n        },\n        \"right\": {\n          \"OR\": {\n            \"left\": {\n              \"raw_text\": \"Patients may have one, none, or a combination of other clinical findings such as eschar, rash, lymphadenopathy, headache, myalgia, cough, nausea and abdominal discomfort.\"\n            }\n          }\n        }\n      },\n      \"right\": {\n        \"AND\": {\n          \"left\": {\n            \"raw_text\": \"A positive scrub typhus RDT (Scrub Typhus IgM RDT, InBios International, Seattle, WA, USA) and/or positive PCR-based detection of O. tsutsugamushi DNA from the admission blood sample\"\n          }\n        },\n        \"right\": {\n          \"AND\": {\n            \"left\": {\n              \"raw_text\": \"Written informed consent and/or, written informed assent as required\"\n            },\n            \"right\": {\n              \"raw_text\": \"Able to take oral medication\"\n            }\n          }\n        }\n      }\n    }\n  }\n}"