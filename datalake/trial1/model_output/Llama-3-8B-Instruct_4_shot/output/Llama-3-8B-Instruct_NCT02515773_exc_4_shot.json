"{\n  \"AND\": {\n    \"left\": {\n      \"OR\": {\n        \"left\": {\n          \"AND\": {\n            \"left\": {\n              \"raw_text\": \"Patients will be excluded if they have had exposure to a total daily dose of MET\"\n            },\n            \"right\": {\n              \"AND\": {\n                \"left\": {\n                  \"raw_text\": \"1000 mg bid for at least 2 weeks in the past 3 months;\"\n                }\n              }\n            }\n          }\n        },\n        \"right\": {\n          \"AND\": {\n            \"left\": {\n              \"raw_text\": \"Patients will be excluded if they could not tolerate MET during the recommended titration schedule outlined in the protocol;\"\n            },\n            \"right\": {\n              \"AND\": {\n                \"left\": {\n                  \"OR\": {\n                    \"left\": {\n                      \"raw_text\": \"Major neurological or medical illnesses that affect weight gain\"\n                    },\n                    \"right\": {\n                      \"OR\": {\n                        \"left\": {\n                          \"raw_text\": \"(e.g., unstable thyroid disease)\"\n                        },\n                        \"right\": {\n                          \"OR\": {\n                            \"left\": {\n                              \"raw_text\": \"or require a systemic medication that might impact weight or glucose regulation\"\n                            },\n                            \"right\": {\n                              \"OR\": {\n                                \"left\": {\n                                  \"raw_text\": \"(e.g., diabetes mellitus [insulin], chronic renal failure [steroids])\"\n                                }\n                              }\n                            }\n                          }\n                        }\n                      }\n                    }\n                  }\n                },\n                \"right\": {\n                  \"AND\": {\n                    \"left\": {\n                      \"raw_text\": \"Fasting glucose = 126 mg/dL on 2 occasions during screening indicating need for prompt treatment;\"\n                    },\n                    \"right\": {\n                      \"AND\": {\n                        \"left\": {\n                          \"OR\": {\n                            \"left\": {\n                              \"raw_text\": \"If lab results are available in the last 6 months, then a serum creatinine =1.3 mg/dL on 2 occasions during screening and/or follow-up, indicating potential impairment of renal functioning;\"\n                            }\n                          }\n                        },\n                        \"right\": {\n                          \"OR\": {\n                            \"left\": {\n                              \"raw_text\": \"Pregnant or breast feeding;\"\n                            },\n                            \"right\": {\n                              \"OR\": {\n                                \"left\": {\n                                  \"raw_text\": \"Children and caregivers who are unable to complete assessments for any reason;\"\n                                }\n                              }\n                            }\n                          }\n                        }\n                      }\n                    }\n                  }\n                }\n              }\n            }\n          }\n        }\n      }\n    }\n  }\n}"