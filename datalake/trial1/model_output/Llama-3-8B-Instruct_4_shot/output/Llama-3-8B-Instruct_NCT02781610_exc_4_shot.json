"{\n  \"AND\": {\n    \"left\": {\n      \"OR\": {\n        \"left\": {\n          \"raw_text\": \"Previous randomization in this study\"\n        },\n        \"right\": {\n          \"OR\": {\n            \"left\": {\n              \"raw_text\": \"Treatment with IV antibiotics in the 6 weeks prior to Visit 1\"\n            },\n            \"right\": {\n              \"AND\": {\n                \"left\": {\n                  \"OR\": {\n                    \"left\": {\n                      \"raw_text\": \"Admission to the intensive care unit for current pulmonary exacerbation in the two weeks prior to Visit 2\"\n                    },\n                    \"right\": {\n                      \"NOT\": {\n                        \"left\": {\n                          \"raw_text\": \"unless admission was due to a desensitization protocol\"\n                        }\n                      }\n                    }\n                  }\n                },\n                \"right\": {\n                  \"OR\": {\n                    \"left\": {\n                      \"raw_text\": \"Pneumothorax in the two weeks prior to Visit 2\"\n                    },\n                    \"right\": {\n                      \"NOT\": {\n                        \"left\": {\n                          \"raw_text\": \"Primary diagnosis for current hospitalization is unrelated to worsening lower respiratory symptoms (e.g., pulmonary clean out, distal intestinal obstruction syndrome (DIOS), sinusitis)\"\n                        }\n                      }\n                    }\n                  }\n                }\n              }\n            }\n          }\n        }\n      }\n    },\n    \"right\": {\n      \"AND\": {\n        \"left\": {\n          \"OR\": {\n            \"left\": {\n              \"raw_text\": \"Massive hemoptysis defined as > 250 cc in a 24 hour period or 100 cc/day over 4 consecutive days occurring in the two weeks prior to Visit 2\"\n            },\n            \"right\": {\n              \"OR\": {\n                \"left\": {\n                  \"raw_text\": \"Current pulmonary exacerbation thought to be due to allergic bronchopulmonary aspergillosis (ABPA)\"\n                },\n                \"right\": {\n                  \"AND\": {\n                    \"left\": {\n                      \"raw_text\": \"At Visit 1, receiving ongoing treatment with a duration of more than 2 weeks with prednisone equivalent to >10mg/day\"\n                    },\n                    \"right\": {\n                      \"OR\": {\n                        \"left\": {\n                          \"raw_text\": \"History of solid organ transplantation\"\n                        },\n                        \"right\": {\n                          \"OR\": {\n                            \"left\": {\n                              \"raw_text\": \"Receiving antimicrobial therapy to treat non-tuberculous mycobacterium (e.g., M. abscessus, M. avium complex) in the two weeks prior to Visit 2\"\n                            }\n                          }\n                        }\n                      }\n                    }\n                  }\n                }\n              }\n            }\n          }\n        }\n      }\n    }\n  }\n}"