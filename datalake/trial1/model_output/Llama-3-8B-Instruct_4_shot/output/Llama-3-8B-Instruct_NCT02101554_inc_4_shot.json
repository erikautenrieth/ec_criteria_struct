"{\n  \"AND\": {\n    \"left\": {\n      \"AND\": {\n        \"left\": {\n          \"OR\": {\n            \"left\": {\n              \"raw_text\": \"Children 7-17\"\n            },\n            \"right\": {\n              \"raw_text\": \"with moderate to severe pain\"\n            }\n          }\n        },\n        \"right\": {\n          \"raw_text\": \"requiring around the clock treatment with an opioid analgesic.\"\n        }\n      }\n    },\n    \"right\": {\n      \"AND\": {\n        \"left\": {\n          \"OR\": {\n            \"left\": {\n              \"raw_text\": \"Be an experienced opioid user\"\n            },\n            \"right\": {\n              \"raw_text\": \", defined as any subject treated with opioid therapy\"\n            }\n          }\n        },\n        \"right\": {\n          \"AND\": {\n            \"left\": {\n              \"raw_text\": \"equivalent or equal to >20 mg per day of morphine\"\n            },\n            \"right\": {\n              \"AND\": {\n                \"left\": {\n                  \"raw_text\": \"for a period of 3 consecutive days\"\n                },\n                \"right\": {\n                  \"raw_text\": \"immediately prior to first day of dosing.\"\n                }\n              }\n            }\n          }\n        }\n      }\n    }\n  }\n}"