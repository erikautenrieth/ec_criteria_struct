"{\n  \"AND\": {\n    \"left\": {\n      \"AND\": {\n        \"left\": {\n          \"raw_text\": \"Patients aged greater than 18 years of age\"\n        },\n        \"right\": {\n          \"AND\": {\n            \"left\": {\n              \"raw_text\": \"Ability to understand and willingness to comply with the study protocol\"\n            },\n            \"right\": {\n              \"raw_text\": \"and Written informed consent\"\n            }\n          }\n        }\n      }\n    },\n    \"right\": {\n      \"AND\": {\n        \"left\": {\n          \"raw_text\": \"Patients meeting the Rotterdam PCOS workshop criteria for polycystic ovary syndrome, defined by oligomenorrhea or amenorrhea\"\n        },\n        \"right\": {\n          \"OR\": {\n            \"left\": {\n              \"raw_text\": \"and at least one of the following two signs: clinical or biochemical evidence of hyperandrogenism\"\n            },\n            \"right\": {\n              \"OR\": {\n                \"left\": {\n                  \"raw_text\": \"or ultrasound finding of polycystic appearing ovaries.\"\n                }\n              }\n            }\n          }\n        }\n      }\n    }\n  }\n}"