"{\n  \"AND\": {\n    \"left\": {\n      \"AND\": {\n        \"left\": {\n          \"AND\": {\n            \"left\": {\n              \"raw_text\": \"Habitual exerciser defined as\"\n            },\n            \"right\": {\n              \"raw_text\": \"= 30 minutes of at least moderate or high intensity exercise\"\n            }\n          },\n          \"right\": {\n            \"raw_text\": \"= 3 times per week.\"\n          }\n        }\n      },\n      \"right\": {\n        \"AND\": {\n          \"left\": {\n            \"raw_text\": \"After consent, and at the subsequent screening visit, a VO2 max test will be performed, and subjects with a low value (< 35 mL/kg/min) will be excluded (screen failure).\"\n          },\n          \"right\": {\n            \"AND\": {\n              \"left\": {\n                \"raw_text\": \"Based on our previous experience, we anticipate that <10% of the subjects will fall into this category\"\n              }\n            }\n          }\n        }\n      }\n    },\n    \"right\": {\n      \"AND\": {\n        \"left\": {\n          \"AND\": {\n            \"left\": {\n              \"raw_text\": \"Men:\"\n            },\n            \"right\": {\n              \"raw_text\": \"(0.006012 x H3) + (14.6 x W) + 604 = TBV\"\n            }\n          },\n          \"right\": {\n            \"raw_text\": \"Women: (0.005835 x H3) + (15 x W) + 183 = TBV [H=height in inches; W=weight in pounds]\"\n          }\n        }\n      },\n      \"right\": {\n        \"AND\": {\n          \"left\": {\n            \"raw_text\": \"Has access to transportation to visit the blood collection facility and to return to Stony Brook for all study visits.\"\n          }\n        }\n      }\n    }\n  }\n}"