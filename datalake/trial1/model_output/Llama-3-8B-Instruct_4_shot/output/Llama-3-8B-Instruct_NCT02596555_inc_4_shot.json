"{\n  \"AND\": {\n    \"left\": {\n      \"AND\": {\n        \"left\": {\n          \"raw_text\": \"Age =18 years\"\n        },\n        \"right\": {\n          \"OR\": {\n            \"left\": {\n              \"raw_text\": \"Objectively confirmed diagnosis of acute PE\"\n            },\n            \"right\": {\n              \"OR\": {\n                \"left\": {\n                  \"raw_text\": \"by multidetector CT angiography\"\n                },\n                \"right\": {\n                  \"OR\": {\n                    \"left\": {\n                      \"raw_text\": \"or ventilation/perfusion lung scan\"\n                    },\n                    \"right\": {\n                      \"OR\": {\n                        \"left\": {\n                          \"raw_text\": \"or selective invasive pulmonary angiography\"\n                        },\n                        \"right\": {\n                          \"raw_text\": \", according to established diagnostic criteria, with or without symptomatic deep vein thrombosis\"\n                        }\n                      }\n                    }\n                  }\n                }\n              }\n            }\n          }\n        }\n      },\n      \"right\": {\n        \"AND\": {\n          \"left\": {\n            \"NOT\": {\n              \"left\": {\n                \"raw_text\": \"Hemodynamic collapse or decompensation\"\n                }\n              }\n            },\n            \"right\": {\n              \"AND\": {\n                \"left\": {\n                  \"OR\": {\n                    \"left\": {\n                      \"raw_text\": \"At least one sign of RV pressure overload/dysfunction\"\n                    },\n                    \"right\": {\n                      \"raw_text\": \"on CT angiography or echocardiography\"\n                    }\n                  }\n                },\n                \"right\": {\n                  \"AND\": {\n                    \"left\": {\n                      \"OR\": {\n                        \"left\": {\n                          \"raw_text\": \"Signs of myocardial injury as indicated by elevated troponin levels\"\n                        },\n                        \"right\": {\n                          \"raw_text\": \"or Signs of (RV) failure as indicated by NT-proBNP levels >600 pg/ml at baseline.\"\n                        }\n                      }\n                    },\n                    \"right\": {\n                      \"AND\": {\n                        \"left\": {\n                          \"raw_text\": \"Ability of the subject to understand the character and individual consequences of the clinical trial\"\n                        },\n                        \"right\": {\n                          \"raw_text\": \"; signed and dated informed consent of the subject available before the start of any specific trial procedures\"\n                        }\n                      }\n                    }\n                  }\n                }\n              }\n            }\n          }\n        }\n      }\n    }\n  }\n}"