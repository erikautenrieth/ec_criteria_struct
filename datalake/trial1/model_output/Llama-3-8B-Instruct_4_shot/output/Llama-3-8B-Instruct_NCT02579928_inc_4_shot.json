"{\n  \"AND\": {\n    \"left\": {\n      \"AND\": {\n        \"left\": {\n          \"AND\": {\n            \"left\": {\n              \"OR\": {\n                \"left\": {\n                  \"raw_text\": \"Meet DSM-5 criteria for Major Depressive Disorder\"\n                },\n                \"right\": {\n                  \"raw_text\": \"by structured interview (MINI-KID)\"\n                }\n              }\n            },\n            \"right\": {\n              \"AND\": {\n                \"left\": {\n                  \"raw_text\": \"CDRS-R score >40\"\n                },\n                \"right\": {\n                  \"AND\": {\n                    \"left\": {\n                      \"raw_text\": \"Failure to achieve remission with at least 1 adequate prior antidepressant trial\"\n                    },\n                    \"right\": {\n                      \"AND\": {\n                        \"left\": {\n                          \"raw_text\": \"meaning at least 8 weeks at therapeutic dosing\"\n                        },\n                        \"right\": {\n                          \"AND\": {\n                            \"left\": {\n                              \"raw_text\": \"including at least 4 weeks of stable dosing\"\n                            }\n                          }\n                        }\n                      }\n                    }\n                  }\n                }\n              }\n            }\n          }\n        },\n        \"right\": {\n          \"OR\": {\n            \"left\": {\n              \"AND\": {\n                \"left\": {\n                  \"OR\": {\n                    \"left\": {\n                      \"raw_text\": \"Meet DSM-5 criteria for any of the following anxiety disorders\"\n                    },\n                    \"right\": {\n                      \"raw_text\": \"Social Anxiety Disorders\"\n                    }\n                  }\n                },\n                \"right\": {\n                  \"OR\": {\n                    \"left\": {\n                      \"raw_text\": \"Generalized Anxiety Disorder\"\n                    },\n                    \"right\": {\n                      \"OR\": {\n                        \"left\": {\n                          \"raw_text\": \"Separation Anxiety Disorder\"\n                        },\n                        \"right\": {\n                          \"OR\": {\n                            \"left\": {\n                              \"raw_text\": \"and/or Panic Disorder\"\n                            }\n                          }\n                        }\n                      }\n                    }\n                  }\n                }\n              },\n              \"right\": {\n                \"AND\": {\n                  \"left\": {\n                    \"raw_text\": \"ADIS Clinical Severity Rating ≥4 (moderately severe)\"\n                  },\n                  \"right\": {\n                    \"AND\": {\n                      \"left\": {\n                        \"raw_text\": \"for any of the 4 included anxiety disorders\"\n                        },\n                        \"right\": {\n                          \"AND\": {\n                            \"left\": {\n                              \"raw_text\": \"Failure to achieve remission with at least 1 adequate prior anxiolytic medication trial\"\n                            },\n                            \"right\": {\n                              \"AND\": {\n                                \"left\": {\n                                  \"raw_text\": \"meaning at least 8 weeks at therapeutic dosing\"\n                                },\n                                \"right\": {\n                                  \"AND\": {\n                                    \"left\": {\n                                      \"raw_text\": \"including at least 4 weeks of stable dosing\"\n                                    }\n                                  }\n                                }\n                              }\n                            }\n                          }\n                        }\n                      }\n                    }\n                  }\n                }\n              }\n            }\n          }\n        }\n      }\n    },\n    \"right\": {\n      \"AND\": {\n        \"left\": {\n          \"AND\": {\n            \"left\": {\n              \"raw_text\": \"Stable psychiatric medications and doses for the month prior to enrollment\"\n            },\n            \"right\": {\n              \"AND\": {\n                \"left\": {\n                  \"raw_text\": \"Subjects may continue to engage in any ongoing psychotherapy\"\n                }\n              }\n            }\n          }\n        },\n        \"right\": {\n          \"AND\": {\n            \"left\": {\n              \"raw_text\": \"Medically and neurologically healthy on the basis of physical examination and medical history\"\n            },\n            \"right\": {\n              \"AND\": {\n                \"left\": {\n                  \"raw_text\": \"Parents able to provide written informed consent\"\n                },\n                \"right\": {\n                  \"AND\": {\n                    \"left\": {\n                      \"raw_text\": \"and adolescents must additionally provide assent\"\n                    }\n                  }\n                }\n              }\n            }\n          }\n        }\n      }\n    }\n  }\n}"