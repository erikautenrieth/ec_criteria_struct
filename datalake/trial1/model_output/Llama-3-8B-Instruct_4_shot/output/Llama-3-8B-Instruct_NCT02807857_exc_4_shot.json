"{\n  \"AND\": {\n    \"left\": {\n      \"AND\": {\n        \"left\": {\n          \"OR\": {\n            \"left\": {\n              \"raw_text\": \"Use of investigational drugs either within 5 half-lives of enrollment\"\n            },\n            \"right\": {\n              \"OR\": {\n                \"left\": {\n                  \"raw_text\": \"or within 30 days\"\n                },\n                \"right\": {\n                  \"OR\": {\n                    \"left\": {\n                      \"raw_text\": \"or until the expected pharmacodynamic effect has returned to baseline\"\n                    },\n                    \"right\": {\n                      \"raw_text\": \"whichever is longer.\"\n                    }\n                  }\n                }\n              }\n            }\n          }\n        },\n        \"right\": {\n          \"AND\": {\n            \"left\": {\n              \"OR\": {\n                \"left\": {\n                  \"raw_text\": \"Major surgery in the last 3 months prior to baseline\"\n                },\n                \"right\": {\n                  \"OR\": {\n                    \"left\": {\n                      \"raw_text\": \"or planned major surgery or cardiac intervention during the study.\"\n                    }\n                  }\n                }\n              }\n            },\n            \"right\": {\n              \"AND\": {\n                \"left\": {\n                  \"OR\": {\n                    \"left\": {\n                      \"raw_text\": \"Cancer or other significant co-morbidities implying that the patient's condition is unstable.\"\n                    }\n                  }\n                },\n                \"right\": {\n                  \"AND\": {\n                    \"left\": {\n                      \"OR\": {\n                        \"left\": {\n                          \"raw_text\": \"Comorbidities that can be associated with elevated natriuretic peptide (NP) levels:\"\n                        },\n                        \"right\": {\n                          \"OR\": {\n                            \"left\": {\n                              \"raw_text\": \"renal insufficiency, (eGFR < 25 ml/min/1.73 m² calculated according to MDRD formula)\"\n                            },\n                            \"right\": {\n                              \"OR\": {\n                                \"left\": {\n                                  \"raw_text\": \"recent (less than 3 months) cerebral trauma or recent (less than 3 months) cerebrovascular incident\"\n                                },\n                                \"right\": {\n                                  \"OR\": {\n                                    \"left\": {\n                                      \"raw_text\": \"novel diagnosis or acute exacerbation of COPD within the last 3 months.\"\n                                    }\n                                  }\n                                }\n                              }\n                            }\n                          }\n                        }\n                      }\n                    }\n                  }\n                }\n              }\n            }\n          }\n        }\n      }\n    },\n    \"right\": {\n      \"AND\": {\n        \"left\": {\n          \"OR\": {\n            \"left\": {\n              \"raw_text\": \"Patients who are primarily managed and regularly followed-up by a cardiologist for their HF\"\n            }\n          }\n        },\n        \"right\": {\n          \"AND\": {\n            \"left\": {\n              \"OR\": {\n                \"left\": {\n                  \"raw_text\": \"Highly frail patients whose estimated lifespan due to comorbidities by the judgement of the investigator is less than 6 months.\"\n                }\n              }\n            }\n          }\n        }\n      }\n    }\n  }\n}"