"{\n  \"AND\": {\n    \"left\": {\n      \"AND\": {\n        \"left\": {\n          \"AND\": {\n            \"left\": {\n              \"OR\": {\n                \"left\": {\n                  \"raw_text\": \"Age: 18-75 years old\"\n                },\n                \"right\": {\n                  \"raw_text\": \"no limitation in gender;\"\n                }\n              }\n            },\n            \"right\": {\n              \"AND\": {\n                \"left\": {\n                  \"raw_text\": \"Left ventricular ejection fraction (LVEF) ≤ 40%\"\n                },\n                \"right\": {\n                  \"raw_text\": \"(ECHO);\"\n                }\n              }\n            }\n          }\n        },\n        \"right\": {\n          \"AND\": {\n            \"left\": {\n              \"AND\": {\n                \"left\": {\n                  \"raw_text\": \"Patients with chronic heart failure\"\n                },\n                \"right\": {\n                  \"OR\": {\n                    \"left\": {\n                      \"raw_text\": \"(NYHA class II or III)\"\n                    }\n                  }\n                }\n              }\n            },\n            \"right\": {\n              \"AND\": {\n                \"left\": {\n                  \"raw_text\": \"In the past one month, the clinical condition\"\n                },\n                \"right\": {\n                  \"raw_text\": \"(including history, clinical symptoms and signs) was relatively stable;\"\n                }\n              }\n            }\n          }\n        }\n      },\n      \"right\": {\n        \"AND\": {\n          \"left\": {\n            \"AND\": {\n              \"left\": {\n                \"AND\": {\n                  \"left\": {\n                    \"AND\": {\n                      \"left\": {\n                        \"raw_text\": \"Patients on standard treatment of chronic heart failure\"\n                      },\n                      \"