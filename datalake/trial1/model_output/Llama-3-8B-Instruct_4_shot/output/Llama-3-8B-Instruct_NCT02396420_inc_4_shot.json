"{\n  \"AND\": {\n    \"left\": {\n      \"AND\": {\n        \"left\": {\n          \"raw_text\": \"Patient has provided signed informed consent\"\n        },\n        \"right\": {\n          \"AND\": {\n            \"left\": {\n              \"AND\": {\n                \"left\": {\n                  \"OR\": {\n                    \"left\": {\n                      \"raw_text\": \"Patient is aged greater than or equal to 40\"\n                    },\n                    \"right\": {\n                      \"raw_text\": \"and less than or equal to 89 years of age\"\n                    }\n                  }\n                },\n                \"right\": {\n                  \"AND\": {\n                    \"left\": {\n                      \"raw_text\": \"Patient has a prostate size between 90g and 200g, as determined by MRI\"\n                    },\n                    \"right\": {\n                      \"AND\": {\n                        \"left\": {\n                          \"raw_text\": \"Patient has experienced lower urinary tract symptoms (LUTS) for at least 6 months prior to study enrollment\"\n                        },\n                        \"right\": {\n                          \"AND\": {\n                            \"left\": {\n                              \"raw_text\": \"Patient has an IPSS score of at least 13 at baseline\"\n                            },\n                            \"right\": {\n                              \"AND\": {\n                                \"left\": {\n                                  \"OR\": {\n                                    \"left\": {\n                                      \"raw_text\": \"Patient is either: refractory to medical treatment, contraindicated to medical treatment, OR refuses medical treatment\"\n                                    },\n                                    \"right\": {\n                                      \"OR\": {\n                                        \"left\": {\n       