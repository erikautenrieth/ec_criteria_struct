"{\n  \"AND\": {\n    \"left\": {\n      \"OR\": {\n        \"left\": {\n          \"raw_text\": \"Antiretroviral naive\"\n        },\n        \"right\": {\n          \"AND\": {\n            \"left\": {\n              \"OR\": {\n                \"left\": {\n                  \"raw_text\": \"Taking Kaletra containing regimen\"\n                },\n                \"right\": {\n                  \"AND\": {\n                    \"left\": {\n                      \"raw_text\": \"with suppressed viral load.\"\n                    }\n                  }\n                }\n              }\n            },\n            \"right\": {\n              \"OR\": {\n                \"left\": {\n                  \"raw_text\": \"Taking an NNRTI or integrase containing regimen\"\n                },\n                \"right\": {\n                  \"AND\": {\n                    \"left\": {\n                      \"raw_text\": \"without prior history of use of PI for more than 2 weeks\"\n                    }\n                  }\n                }\n              }\n            }\n          }\n        },\n        \"right\": {\n          \"OR\": {\n            \"left\": {\n              \"raw_text\": \"Taking an NNRTI or integrase containing regimen\"\n            },\n            \"right\": {\n              \"AND\": {\n                \"left\": {\n                  \"raw_text\": \"with prior exposure to PI greater than 2 weeks.\"\n                },\n                \"right\": {\n                  \"raw_text\": \"It must be clearly stated in the source document that PI was switched to another agent for convenience.\"\n                }\n              }\n            }\n          }\n        }\n      }\n    },\n    \"right\": {\n      \"AND\": {\n        \"left\": {\n          \"OR\": {\n            \"left\": {\n              \"raw_text\": \"Taking another PI containing regimens\"\n            },\n            \"right\": {\n              \"AND\": {\n                \"left\": {\n                  \"raw_text\": \"with suppressed viral load.\"\n                },\n                \"right\": {\n                  \"raw_text\": \"It must be clearly stated in source document that if another PI was used for greater than 2 weeks the regimen was switched to another agent for convenience.\"\n                }\n              }\n            }\n          },\n          \"right\": {\n            \"AND\": {\n              \"left\": {\n                \"OR\": {\n                  \"left\": {\n                    \"raw_text\": \"Subjects with prior history of PI use may be enrolled\"\n                    },\n                    \"right\": {\n                      \"AND\": {\n                        \"left\": {\n                          \"raw_text\": \"if there is a genotype showing no resistance to Kaletra\"\n                        }\n                      }\n                    }\n                  }\n                },\n                \"right\": {\n                  \"AND\": {\n                    \"left\": {\n                      \"raw_text\": \"Other Inclusion criteria\"\n                    }\n                  }\n                }\n              }\n            }\n          }\n        }\n      }\n    }\n  }\n}\n  \"AND\": {\n    \"left\": {\n      \"AND\": {\n        \"left\": {\n          \"raw_text\": \"Be at least 18 years of age\"\n        },\n        \"right\": {\n          \"raw_text\": \"and able to give informed consent.\"\n        }\n      },\n      \"right\": {\n        \"AND\": {\n          \"left\": {\n            \"OR\": {\n              \"left\": {\n                \"raw_text\": \"Diagnosed with TB by criteria per Brazilian Ministry of Health\"\n                },\n                \"right\": {\n                  \"raw_text\": \"Have a good clinical response to TB.\"\n                }\n              }\n            }\n          },\n          \"right\": {\n            \"AND\": {\n              \"left\": {\n                \"raw_text\": \"Tolerating tuberculosis therapy containing rifampin for the 2 weeks prior to screening,\"\n                },\n                \"right\": {\n                  \"raw_text\": \"except for persons taking protease inhibitors at time of diagnosis of TB.,.\"\n                }\n              }\n            }\n          }\n        }\n      }\n    },\n    \"right\": {\n      \"AND\": {\n        \"left\": {\n          \"OR\": {\n            \"left\": {\n              \"raw_text\": \"HIV positive with documentation present in source document.\"\n            },\n            \"right\": {\n              \"raw_text\": \"Have a CD4 cell count greater than 50 cells/mm3if not taking ART.\"\n            }\n          }\n        },\n        \"right\": {\n          \"AND\": {\n            \"left\": {\n              \"raw_text\": \"Persons with cd4 < 50 may be enrolled,\"\n              \"right\": {\n                \"raw_text\": \"if it is felt that in the best interest of the patient, that enrollment in the study will allow for quicker initiation of antiretroviral therapy than referral to another treatment center.\"\n              }\n            }\n          }\n        }\n      }\n    }\n  }\n}"