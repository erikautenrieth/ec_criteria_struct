"{\n  \"AND\": {\n    \"left\": {\n      \"OR\": {\n        \"left\": {\n          \"raw_text\": \"Preoperative history of schizophrenia\"\n        },\n        \"right\": {\n          \"OR\": {\n            \"left\": {\n              \"raw_text\": \"epilepsy\"\n            },\n            \"right\": {\n              \"OR\": {\n                \"left\": {\n                  \"raw_text\": \"parkinsonism\"\n                },\n                \"right\": {\n                  \"raw_text\": \"or myasthenia gravis;\"\n                }\n              }\n            }\n          }\n        }\n      },\n      \"right\": {\n        \"AND\": {\n          \"left\": {\n            \"OR\": {\n              \"left\": {\n                \"raw_text\": \"Preoperative radio-\"\n              },\n              \"right\": {\n                \"raw_text\": \"or chemotherapy;\"\n              }\n            }\n          },\n          \"right\": {\n            \"AND\": {\n              \"left\": {\n                \"OR\": {\n                  \"left\": {\n                    \"raw_text\": \"Inability to communicate in the preoperative period because of coma\"\n                  },\n                  \"right\": {\n                    \"OR\": {\n                      \"left\": {\n                        \"raw_text\": \"profound dementia\"\n                      },\n                      \"right\": {\n                        \"raw_text\": \"or language barrier;\"\n                      }\n                    }\n                  }\n                }\n              },\n              \"right\": {\n                \"AND\": {\n                  \"left\": {\n                    \"OR\": {\n                      \"left\": {\n                        \"raw_text\": \"Preoperative obstructive sleep apnea\"\n                      },\n                      \"right\": {\n                        \"OR\": {\n                          \"left\": {\n                            \"raw_text\": \"previously diagnosed