{
  "AND": {
    "left": {
      "OR": {
        "left": {
          "raw_text": "(1)Women who are pregnant and/or lactating; or women who intend to conceive within a year;"
        },
        "right": {
          "raw_text": "(2)History of allergies to enalapril, folic acid or other components of the compound drug;"
        }
      }
    },
    "right": {
      "AND": {
        "left": {
          "OR": {
            "left": {
              "raw_text": "(3)History of adverse reactions or intolerance to enalapril or other ACE inhibitors, or drugs or supplements containing folic acid;"
            },
            "right": {
              "raw_text": "(4)Diagnosis or suspicion of secondary hypertension;"
            }
          }
        },
        "right": {
          "AND": {
            "left": {
              "OR": {
                "left": {
                  "raw_text": "(5)Known serious medical conditions, including:"
                },
                "right": {
                  "AND": {
                    "left": {
                      "OR": {
                        "left": {
                          "raw_text": "Cardiovascular: patients with clinically diagnosed cardiac dysfunction (NYHA class III and above), hypertrophic obstructive cardiomyopathy, clinically significant valvular heart disease, acute coronary syndrome within the last 3 months, or percutaneous coronary intervention (PCI), or coronary artery bypass graft (CABG);"
                        },
                        "right": {
                          "OR": {
                            "left": {
                              "raw_text": "or abnormal pre-enrollment ECG test results with clinically significant arrhythmias (atrial flutter, atrial fibrillation, grade II-III atrioventricular block, etc.);"
                            },
                            "right": {
                              "raw_text": "Digestive: a previous diagnosis of various types of viral hepatitis that are still in the active phase;"
                            }
                          }
                        }
                      }
                    },
                    "right": {
                      "AND": {
                        "left": {
                          "OR": {
                            "left": {
                              "raw_text": "abnormal pre-enrollment liver function test results (ALT, AST, GGT, TBIL, or DBIL 3 times higher than normal, ALB = 30g/L);"
                            },
                            "right": {
                              "OR": {
                                "left": {
                                  "raw_text": "gastrectomy and/or gastrojejunostomy;"
                                },
                                "right": {
                                  "raw_text": "gastrointestinal dysfunction;"
                                }
                              }
                            }
                          }
                        },
                        "right": {
                          "AND": {
                            "left": {
                              "OR": {
                                "left": {
                                  "raw_text": "Urinary: pre-enrollment serum creatinine greater than 200umol/L;"
                                },
                                "right": {
                                  "OR": {
                                    "left": {
                                      "raw_text": "clinical diagnosis of renal artery stenosis, isolated kidney, kidney transplantation and/or other diseases;"
                                    },
                                    "right": {
                                      "raw_text": "Endocrine: type 1 diabetes or uncontrolled type 2 diabetes (fasting blood glucose above 11.1 mmol/L at pre-enrollment);"
                                    }
                                  }
                                }
                              }
                            },
                            "right": {
                              "AND": {
                                "left": {
                                  "OR": {
                                    "left": {
                                      "raw_text": "previous diagnosis of hyperthyroidism and failure to correct;"
                                    },
                                    "right": {
                                      "raw_text": "Respiratory: pulmonary heart disease;"
                                    }
                                  }
                                },
                                "right": {
                                  "AND": {
                                    "left": {
                                      "OR": {
                                        "left": {
                                          "raw_text": "Neuropsychiatric: recent transient ischemic attack or stroke (within the last 3 months);"
                                        },
                                        "right": {
                                          "OR": {
                                            "left": {
                                              "raw_text": "peripheral or severe autonomic dysfunction;"
                                            },
                                            "right": {
                                              "raw_text": "mental or nervous system dysfunction, inability to express desire;"
                                            }
                                          }
                                        }
                                      }
                                    },
                                    "right": {
                                      "OR": {
                                        "left": {
                                          "raw_text": "known drug or alcohol dependence;"
                                        },
                                        "right": {
                                          "raw_text": "Malignancy, malnutrition, hematopoietic disorders and other serious diseases."
                                        }
                                      }
                                    }
                                  }
                                }
                              }
                            }
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
