{
  "AND": {
    "left": {
      "AND": {
        "left": {
          "raw_text": "Provision of written informed consent"
        },
        "right": {
          "raw_text": "(by patient or appropriate designee according to local regulations) prior to any study specific procedures."
        }
      }
    },
    "right": {
      "AND": {
        "left": {
          "OR": {
            "left": {
              "raw_text": "Aged 18 years or older"
            },
            "right": {
              "OR": {
                "left": {
                  "raw_text": "male or female."
                }
              }
            }
          }
        },
        "right": {
          "AND": {
            "left": {
              "AND": {
                "left": {
                  "OR": {
                    "left": {
                      "raw_text": "History of stable angina pectoris"
                    },
                    "right": {
                      "AND": {
                        "left": {
                          "raw_text": "with angiographic evidence of CAD"
                        },
                        "right": {
                          "raw_text": "(diameter stenosis = 50%) in major, i.e., left main, left anterior descending, left circumflex, and right coronary arteries."
                        }
                      }
                    }
                  }
                },
                "right": {
                  "AND": {
                    "left": {
                      "raw_text": "History of previous myocardial infarction (MI)"
                    },
                    "right": {
                      "raw_text": "or History of coronary revascularization, i.e., percutaneous coronary intervention (PCI) or coronary artery bypass graft (CABG), not including the elective PCI during the index hospitalization"
                    }
                  }
                }
              },
              "right": {
                "AND": {
                  "left": {
                    "raw_text": "Documented history of type 2 diabetes mellitus."
                  },
                  "right": {
                    "AND": {
                      "left": {
                        "raw_text": "Post-procedural residual diameter stenosis of the treated lesions < 20% in patients with stent implantation or < 50% in those with balloon angioplasty"
                        },
                        "right": {
                          "raw_text": "or Post-procedural thrombolysis in myocardial infarction (TIMI) grade 3 flow in treated vessels"
                        }
                      }
                    }
                  }
                }
              }
            },
            "right": {
              "AND": {
                "left": {
                  "raw_text": "Negative cardiac troponin test before the index elective PCI."
                },
                "right": {
                  "AND": {
                    "left": {
                      "OR": {
                        "left": {
                          "raw_text": "Taking Clopidogrel 75 mg daily dose for at least 7 days"
                        },
                        "right": {
                          "OR": {
                            "left": {
                              "raw_text": "or taking Clopidogrel 75 mg daily dose for less than 7 days but with 300 to 600 mg Clopidogrel loading dose before PCI."
                            }
                          }
                        }
                      }
                    },
                    "right": {
                      "AND": {
                        "left": {
                          "OR": {
                            "left": {
                              "raw_text": "Taking acetylsalicylic acid (ASA) 100 mg daily treatment for at least 7 days"
                            },
                            "right": {
                              "OR": {
                                "left": {
                                  "raw_text": "or taking ASA 100 mg daily dose for less than 7 days but with 300 mg ASA loading dose before PCI."
                                }
                              }
                            }
                          }
                        },
                        "right": {
                          "AND": {
                            "left": {
                              "raw_text": "have a negative urine or blood pregnancy test at enrolment and prior to randomization;"
                            },
                            "right": {
                              "AND": {
                                "left": {
                                  "raw_text": "currently be using a hormonal contraceptive and agree to continue its use in addition to using double-barrier local contraception (i.e., intra-uterine device plus spermicidal and condom for male partner) from screening through study completion."
                                }
                              }
                            }
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}