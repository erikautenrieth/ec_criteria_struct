{
  "AND": {
    "left": {
      "OR": {
        "left": {
          "raw_text": "Male"
        },
        "right": {
          "raw_text": "or female"
        }
      },
      "right": {
        "AND": {
          "left": {
            "raw_text": "= 18 years of age at Visit 1."
          },
          "right": {
            "AND": {
              "left": {
                "raw_text": "Sweat chloride equal or greater than 60 mEq/L"
                },
                "right": {
                  "raw_text": "by quantitative pilocarpine iontophoresis test."
                }
              },
              "right": {
                "AND": {
                  "left": {
                    "OR": {
                      "left": {
                        "raw_text": "Two well-characterized mutations"
                      },
                      "right": {
                        "raw_text": "in the cystic fibrosis transmembrane conductance regulator (CFTR) gene"
                      }
                    }
                  },
                  "right": {
                    "AND": {
                      "left": {
                        "raw_text": "Abnormal nasal potential difference (NPD)"
                      },
                      "right": {
                        "raw_text": "as measured by a change in NPD in response to a low chloride solution and isoproterenol of less than -5 mV."
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "right": {
      "AND": {
        "left": {
          "OR": {
            "left": {
              "raw_text": "Documentation of the presence of an acute pulmonary exacerbation"
            },
            "right": {
              "raw_text": ", based on CF Foundation guidelines, as diagnosed by a faculty member of the Denver Adult CF Program."
            }
          }
        },
        "right": {
          "AND": {
            "left": {
              "OR": {
                "left": {
                  "raw_text": "Respiratory culture(s) demonstrating evidence of Pseudomonas aeruginosa"
                },
                "right": {
                  "raw_text": "or Achromobacter species airway infection."
                }
              }
            },
            "right": {
              "AND": {
                "left": {
                  "OR": {
                    "left": {
                      "raw_text": "Subject is able to produce sputum"
                    },
                    "right": {
                      "OR": {
                        "left": {
                          "raw_text": "undergo phlebotomy"
                        },
                        "right": {
                          "raw_text": "and provide written consent."
                        }
                      }
                    }
                  }
                },
                "right": {
                  "AND": {
                    "left": {
                      "raw_text": "The subject's treating physician has determined that they should receive either tobramycin or colistin intravenously as one of the designated agents for their APE treatment."
                    },
                    "right": {
                      "OR": {
                        "left": {
                          "raw_text": "Subjects who are able to receive either tobramycin or colistin as part of their antibiotic regimen will be randomized into one of three arms."
                        },
                        "right": {
                          "raw_text": "If a treating physician deems that a subject cannot receive tobramycin due to vestibular toxicity, ototoxicity or bacterial resistance, the subject will be randomized to either standard or PK-adjusted colistin."
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
