"{\n  \"AND\": {\n    \"left\": {\n      \"OR\": {\n        \"left\": {\n          \"raw_text\": \"1. Personal history of stroke, brain lesions, previous neurosurgery, any personal history of seizure or fainting episode of unknown cause, or head trauma resulting in loss of consciousness, lasting over 30 minutes or with sequela lasting longer than two days.\"\n        },\n        \"right\": {\n          \"AND\": {\n            \"left\": {\n              \"raw_text\": \"Screening tool: TMS adult safety questionnaire, Medical History.\"\n            },\n            \"right\": {\n              \"AND\": {\n                \"left\": {\n                  \"raw_text\": \"2. First-degree family history of any neurological disorder with a potentially hereditary basis, including migraines, epilepsy, or multiple sclerosis.\"\n                },\n                \"right\": {\n                  \"raw_text\": \"Screening tool: TMS adult safety screening, Medical History.\"\n                }\n              }\n            }\n          }\n        },\n        \"right\": {\n          \"AND\": {\n            \"left\": {\n              \"OR\": {\n                \"left\": {\n                  \"raw_text\": \"3. Cardiac pacemakers, neural stimulators, implantable defibrillator, implanted medication pumps, intracardiac lines, or acute, unstable cardiac disease, with intracranial implants (e.g. aneurysm clips, shunts, stimulators, cochlear implants, or electrodes) or any other metal object within or near the head that precludes MRI scanning.\"\n                },\n                \"right\": {\n                  \"raw_text\": \"Screening tool: TMS adult safety screening, MRI safety screening, Medical History.\"\n                }\n              }\n            }\n          }\n        },\n        \"right\": {\n          \"AND\": {\n            \"left\": {\n              \"OR\": {\n                \"left\": {\n                  \"raw_text\": \"4. Noise-induced hearing loss or tinnitus.\"\n                },\n                \"right\": {\n                  \"raw_text\": \"Screening tools: TMS adult safety screening.\"\n                }\n              }\n            }\n          }\n        },\n        \"right\": {\n          \"AND\": {\n            \"left\": {\n              \"OR\": {\n                \"left\": {\n                  \"rawtext\": \"5. Current use (any use in the past 4 weeks, chronic use within 6 past six months) of any investigational drug or of any medications with psychotropic, anti or pro-convulsive action.\"\n                },\n                \"right\": {\n                  \"rawtext\": \"Screening tools: MRI safety screening questionnaire, Medical history, Medical Assessments: Urine toxicology analyzes for presence of a broad range of prescription and nonprescription drugs.\"\n                }\n              }\n            }\n          }\n        },\n        \"right\": {\n          \"AND\": {\n            \"left\": {\n              \"OR\": {\n                \"left\": {\n                  \"rawtext\": \"6. Lifetime history of major depressive disorder, schizophrenia, bipolar disorder, mania, or hypomania.\"\n                },\n                \"right\": {\n                  \"rawtext\": \"Screening tools: SCID Screen Patient Questionnaire. Potential diagnoses will be further evaluated by a counsellor.\"\n                }\n              }\n            }\n          }\n        },\n        \"right\": {\n          \"AND\": {\n            \"left\": {\n              \"OR\": {\n                \"left\": {\n                  \"rawtext\": \"7. Meet current DSM V criteria for moderate to severe substance use disorder (excluding nicotine), smoke daily, or urine toxicology positive for any illicit substance inconsistent with history given.\"\n                },\n                \"right\": {\n                  \"rawtext\": \"Screening tools: SCID Screen Patient Questionnaire. Potential diagnoses will be further evaluated by a counsellor, Drug Use Survey (DUS), Substance Use Disorder Evaluation, Medical Assessments: urine qualitative drug screen is performed for methadone, benzodiazepines, cocaine, amphetamine/methamphetamine, opiates, barbiturates, and tetrahydrocannabinol.\"\n                }\n              }\n            }\n          }\n        },\n        \"right\": {\n          \"AND\": {\n            \"left\": {\n              \"OR\": {\n                \"left\": {\n                  \"rawtext\": \"8. Have met DSM V criteria for moderate to severe substance use disorder (excluding nicotine, alcohol and cannabis) in the past, or have met DSM V criteria for moderate to severe substance use disorder for cannabis or alcohol in the past 5 years.\"\n                },\n                \"right\": {\n                  \"rawtext\": \"Screening tools: SCID Screen Patient Questionnaire. Potential diagnoses will be further evaluated by a counselor. Drug Use Survey (DUS), Substance Use Disorder Evaluation.\"\n                }\n              }\n            }\n          }\n        },\n        \"right\": {\n          \"AND\": {\n            \"left\": {\n              \"OR\": {\n                \"left\": {\n                  \"rawtext\": \"9. History of myocardial infarction, angina, congestive heart failure, cardiomyopathy, stroke or transient ischemic attack, or any heart condition currently under medical care.\"\n                },\n                \"right\": {\n                  \"rawtext\": \"Screening tool: physical assessment (EKG), medical history.\"\n                }\n              }\n            }\n          }\n        },\n        \"right\": {\n          \"AND\": {\n            \"left\": {\n              \"OR\": {\n                \"left\": {\n                  \"rawtext\": \"10. Pregnant women or women with reproductive potential who are sexually active and not using an acceptable form of contraception.\"\n                },\n                \"right\": {\n                  \"rawtext\": \"Screening tool: Medical assessments (urine pregnancy test) at the beginning of each visit that involves TMS or MRI.\"\n                }\n              }\n            }\n          }\n        },\n        \"right\": {\n          \"AND\": {\n            \"left\": {\n              \"OR\": {\n                \"left\": {\n                  \"rawtext\": \"11. History of learning disability or current ADHD.\"\n                },\n                \"right\": {\n                  \"rawtext\": \"Screening tools: Wechsler Abbreviated Scale of Intelligence, Medical history, Adult ADHD Self-Report Scale.\"\n                }\n              }\n            }\n          }\n        },\n        \"right\": {\n          \"AND\": {\n            \"left\": {\n              \"OR\": {\n                \"left\": {\n                  \"rawtext\": \"12. Participation in an rTMS session less than two weeks ago.\"\n                },\n                \"right\": {\n                  \"rawtext\": \"Screening tool: TMS safety screening questionnaire.\"\n                }\n              }\n            }\n          }\n        }\n    }\n  }\n}"