"{\n  \"AND\": {\n    \"left\": {\n      \"OR\": {\n        \"left\": {\n          \"raw_text\": \"Patients refuse to follow the research\"\n        },\n        \"right\": {\n          \"AND\": {\n            \"left\": {\n              \"OR\": {\n                \"left\": {\n                  \"raw_text\": \"Patient has had previous eradication therapy of Helicobacter pylori infection.\"\n                },\n                \"right\": {\n                  \"OR\": {\n                    \"left\": {\n                      \"raw_text\": \"The patient is pregnant or breastfeeding\"\n                    },\n                    \"right\": {\n                      \"OR\": {\n                        \"left\": {\n                          \"raw_text\": \"Patients have a history of allergy to one component of triple therapy regimen (proton pump inhibitor, penicillin, and / or macrolide) before.\"\n                        },\n                        \"right\": {\n                          \"OR\": {\n                            \"left\": {\n                              \"raw_text\": \"Patients are known to have impaired liver function, evidenced by ALT values within normal limits, and no previous liver disease.\"\n                            },\n                            \"right\": {\n                              \"OR\": {\n                                \"left\": {\n                                  \"raw_text\": \"Patients were found to have arrhythmias or obtained QT wave elongation on electrocardiographic examination.\"\n                                }\n                              }\n                            }\n                        }\n                      }\n                    }\n                }\n              }\n            }\n          }\n        }\n      }\n    }\n  }\n}"