"{\n  \"AND\": {\n    \"left\": {\n      \"OR\": {\n        \"left\": {\n          \"raw_text\": \"Prior treatment toxicities have not resolved to < Grade 2 according to NCI CTCAE Version 4.0 (except clinically insignificant toxicities such as alopecia).\"\n        },\n        \"right\": {\n          \"AND\": {\n            \"left\": {\n              \"OR\": {\n                \"left\": {\n                  \"raw_text\": \"Subjects receiving any other investigational agents.\"\n                },\n                \"right\": {\n                  \"OR\": {\n                    \"left\": {\n                      \"raw_text\": \"Patients with active tumor lysis syndrome (TLS) either from laboratory or clinical changes.\"\n                    },\n                    \"right\": {\n                      \"OR\": {\n                        \"left\": {\n                          \"raw_text\": \"Patients with active central nervous system (CNS) disease defined as symptomatic meningeal lymphoma or known CNS parenchymal lymphoma.\"\n                        },\n                        \"right\": {\n                          \"OR\": {\n                            \"raw_text\": \"History of severe allergic reactions attributed to compounds of similar chemical or biologic composition to rituximab or other agents used in this study.\"\n                            },\n                            \"right\": {\n                              \"OR\": {\n                                \"raw_text\": \"Subjects with uncontrolled intercurrent illness.\"\n                                },\n                                \"right\": {\n                                  \"OR\": {\n                                    \"raw_text\": \"HIV-positive subjects on combination antiretroviral therapy are ineligible because of the potential for pharmacokinetic interactions with Venetoclax. In addition, these subjects are at increased risk of lethal infections when treated with marrow suppressive therapy.