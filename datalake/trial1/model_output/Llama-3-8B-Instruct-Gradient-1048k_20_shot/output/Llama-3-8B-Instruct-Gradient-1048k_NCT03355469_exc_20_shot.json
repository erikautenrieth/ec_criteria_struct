"{\n  \"AND\": {\n    \"left\": {\n      \"OR\": {\n        \"left\": {\n          \"raw_text\": \"Morbidly obese patients (BMI >47 kg/m2) and overweight/lean patients (BMI <27 kg/m2)\"},\n        \"right\": {\n          \"AND\": {\n            \"left\": {\n              \"OR\": {\n                \"left\": {\n                  \"raw_text\": \"Evidence of type 1 diabetes and diabetics requiring insulin therapy.\"\n                },\n                \"right\": {\n                  \"AND\": {\n                    \"left\": {\n                      \"raw_text\": \"Subjects who have not been weight stable (>2 kg weight change in past 3 months)\"},\n                    \"right\": {\n                      \"AND\": {\n                        \"left\": {\n                          \"raw_text\": \"Subjects who have been recently active (>30 min of moderate/high intensity exercise, 2 times/week).\"},\n                        \"right\": {\n                          \"AND\": {\n                            \"left\": {\n                              \"raw_text\": \"Subjects who are smokers or who have quit smoking <5 years ago\"},\n                            \"right\": {\n                              \"AND\": {\n                                \"left\": {\n                                  \"raw_text\": \"Subjects prescribed metformin or have taken metformin within 1 year.\"\n                                },\n                                \"right\": {\n                                  \"AND\": {\n                                    \"left\": {\n                                      \"raw_text\": \"Subjects with abnormal estimated glomerular filtration rate (eGFR).\"},\n                                    \"right\": {\n                                      \"AND\": {\n                                        \"left\": {\n                                          \"raw_text\": \"Hypertriglyceridemic (>400 mg/dl) and hypercholesterolemic (>260 mg/dl) subjects\"},\n                                        \"right\": {\n                                          \"AND\": {\n                                            \"raw text\": \"Hypertensive (>160/100 mmHg)\"},\n                                            \"right\": {\n                                              \"AND\": {\n                                                \"raw text\": \"Subjects currently taking medications that affect heart rate and rhythm (i.e. Ca++ channel blockers, nitrates, alpha- or beta-blockers).\"},\n                                                \"right\": {\n                                                  \"AND\": {\n                                                    \"left\": {\n                                                      \"raw text\": \"Subjects with a history of significant metabolic, cardiac, congestive heart failure, cerebrovascular, hematological, pulmonary, gastrointestinal, liver, renal, or endocrine disease or cancer that in the investigator's opinion would interfere with or alter the outcome measures, or impact subject safety.\"\n                                                    }\n                                                  }\n                                                }\n                                              }\n                                            }\n                                          }\n                                        }\n                                      }\n                                    }\n                                }\n                            }\n                        }\n                    }\n                }\n              }\n            }\n          }\n        }\n      }\n    }\n  }\n}"