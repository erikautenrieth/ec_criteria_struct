"{\n  \"AND\": {\n    \"left\": {\n      \"OR\": {\n        \"left\": {\n          \"raw_text\": \"intolerance of or allergy to ticagrelor or prasugrel\"\n        },\n        \"right\": {\n          \"AND\": {\n            \"left\": {\n              \"OR\": {\n                \"left\": {\n                  \"raw_text\": \"history of any stroke, transient ischemic attack or intracranial bleeding\"\n                },\n                \"right\": {\n                  \"OR\": {\n                    \"left\": {\n                      \"raw_text\": \"known intracranial neoplasm, intracranial arteriovenous malformation or intracranial aneurysm\"\n                    },\n                    \"right\": {\n                      \"OR\": {\n                        \"left\": {\n                          \"raw_text\": \"active bleeding, clinical findings, that in the judgement of the investigator are associated with an increased risk of bleeding\"\n                        }\n                      }\n                    }\n                }\n              }\n            }\n          }\n        },\n        \"right\": {\n          \"AND\": {\n            \"left\": {\n              \"OR\": {\n                \"left\": {\n                  \"raw_text\": \"known platelet count < 100.000/µL at the time of screening\"\n                },\n                \"right\": {\n                  \"OR\": {\n                    \"left\": {\n                      \"raw_text\": \"known anemia (hemoglobin <10 g/dL) at the time of screening\"\n                    },\n                    \"right\": {\n                      \"OR\": {\n                        \"raw_text\": \"oral anticoagulation that cannot be safely discontinued for the duration of the study\"\n                        },\n                        \"right\": {\n                          \"OR\": {\n                            \"raw_text\": \"INR known to be greater than 1.5 at the time of screening\"\n                            }\n                      }\n                    }\n                }\n              }\n            }\n          }\n        },\n        \"right\": {\n          \"AND\": {\n            \"left\": {\n              \"OR\": {\n                \"left\": {\n                  \"raw text\": \"chronic renal insufficiency requiring dialysis\"\n                },\n                \"right\": {\n                  \"OR\": {\n                    \"left\": {\n                      \"raw text\": \"moderate or severe hepatic dysfunction (Child Pugh B or C)\"\n                    }\n                  }\n                }\n              }\n            }\n          }\n        },\n        \"right\": {\n          \"AND\": {\n            \"left\": {\n              \"OR\": {\n                \"left\": {\n                  \"raw text\": \"increased risk of bradycardia events (Sick Sinus, AV block grade II or III, bradycardia-induced syncope)\"\n                },\n                \"right\": {\n                  \"OR\": {\n                    \"left\": {\n                      \"raw text\": \"index event is an acute complication (< 30 days) of PCI\"\n                    }\n                  }\n                }\n              }\n            }\n          }\n        },\n        \"right\": {\n          \"AND\": {\n            \"left\": {\n              \"OR\": {\n                \"left\": {\n                  \"raw text\": \"concomitant medical illness that in the opinion of the investigator is associated with a life expectancy < 1 year\"\n                },\n                \"right\": {\n                  \"OR\": {\n                    \"left\": {\n                      \"raw text\": \"concomitant oral or i.v. therapy with strong CYP3A Inhibitors (e.g. ketoconazole, itraconazole, voriconazole, telithromycin, clarithromycin, nefazodone, ritonavir, saquinavir, nelfinavir, indinavir, atazanavir, grapefruit juice > 1 L/d), CYP3A substrates with narrow therapeutic indices (e.g. cyclosporine, quinidine), or strong CYP3A inducers (e.g. rifampin/rifampicin, phenytoin, carbamazepine, dexamethason, phenobarbital ) that cannot be safely discontinued\"\n                }\n                  \"right\": {\n                    \"OR\": {\n                      \"raw text\": \"=1 doses of ticagrelor or prasugrel within 5 days before randomisation\"\n                    }\n                  }\n                }\n              }\n            }\n          }\n        },\n        \"right\": {\n          \"AND\": {\n            \"left\": {\n              \"OR\": {\n                \"left\": {\n                  \"raw text\": \"no written informed consent\"\n                },\n                \"right\": {\n                  \"OR\": {\n                    \"raw text\": \"participation in another investigational drug study\"\n                    }\n                  }\n                }\n              }\n            }\n          }\n        },\n        \"right\": {\n          \"AND\": {\n            \"left\": {\n              \"OR\": {\n                \"left\": {\n                  \"raw text\": \"previous enrolment in this study\"\n                },\n                \"right\": {\n                  \"OR\": {\n                    \"raw text\": \"for women of childbearing potential no negative pregnancy test and no agree to use reliable method of birth control during the study\"\n                    }\n                  }\n                }\n              }\n            }\n          }\n        },\n        \"right\": {\n          \"AND\": {\n            \"left\": {\n              \"OR\": {\n                \"left\": {\n                  \"raw text\": \"Pregnancy, giving birth within the last 90 days, or lactation\"\n                },\n                \"right\": {\n                  \"OR\": {\n                    \"raw text\": \"inability to cooperate with protocol requirements\"\n                    }\n                  }\n                }\n              }\n            }\n          }\n        }