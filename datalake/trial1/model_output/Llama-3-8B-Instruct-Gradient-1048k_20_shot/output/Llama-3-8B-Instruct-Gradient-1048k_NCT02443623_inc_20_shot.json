"{\n  \"AND\": {\n    \"left\": {\n      \"raw_text\": \"Signed written informed consent.\"\n    },\n    \"right\": {\n      \"AND\": {\n        \"left\": {\n          \"raw_text\": \"Age 18 to 65.\"\n        },\n        \"right\": {\n          \"AND\": {\n            \"left\": {\n              \"raw_text\": \"Normal and healthy (immune competent) as determined by medical history, physical exam, vital signs and clinical laboratory tests during the screening period.\"\n            },\n            \"right\": {\n              \"AND\": {\n                \"left\": {\n                  \"raw_text\": \"If all lab results for quantitative IgA immunoglobulin level are lower than 15% below normal range, the subject may not proceed further in the screening process.\"\n                },\n                \"right\": {\n                  \"AND\": {\n                    \"left\": {\n                      \"raw_text\": \"Subject must meet all required subject suitability criteria that pertain to normal source plasma donors.\"\n                    },\n                    \"right\": {\n                      \"AND\": {\n                        \"left\": {\n                          \"raw_text\": \"Negative HIV serology during screening period.\"\n                        },\n                        \"right\": {\n                          \"AND\": {\n                            \"left\": {\n                              \"raw_text\": \"Subject must have been previously immunized for smallpox, at =3 years prior to commencement of screening assessments, and vaccination history must be confirmed by oral or written history and the presence of a visible pathognomonic smallpox vaccination scar.\"\n                            },\n                            \"right\": {\n                              \"AND\": {\n                                \"left\": {\n                                  \"raw_text\": \"Female subjects of childbearing potential must agree to use highly effective birth control methods.\"\n                                }\n                              }\n                            }\n                          }\n                        }\n                      }\n                    }\n                  }\n                }\n              }\n            }\n          }\n        }\n      }\n    }\n  }\n}"