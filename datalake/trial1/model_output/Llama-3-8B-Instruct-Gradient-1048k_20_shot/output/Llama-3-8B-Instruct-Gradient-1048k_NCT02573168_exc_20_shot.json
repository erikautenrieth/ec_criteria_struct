"{\n  \"AND\": {\n    \"left\": {\n      \"OR\": {\n        \"left\": {\n          \"raw_text\": \"Patients posing a serious suicidal risk and/or violence as judged by the investigator;\"\n        },\n        \"right\": {\n          \"AND\": {\n            \"left\": {\n              \"OR\": {\n                \"left\": {\n                  \"raw_text\": \"Delirium\"\n                },\n                \"right\": {\n                  \"OR\": {\n                    \"left\": {\n                      \"raw_text\": \"Dementia\"\n                    },\n                    \"right\": {\n                      \"OR\": {\n                        \"left\": {\n                          \"raw_text\": \"Amnestic and other cognitive disorder;\"\n                        }\n                      }\n                    }\n                }\n              }\n            }\n          }\n        },\n        \"right\": {\n          \"AND\": {\n            \"left\": {\n              \"OR\": {\n                \"left\": {\n                  \"raw_text\": \"Patients with a history of hypothyroidism unless taking a stable dose of thyroid medication and asymptomatic or euthyroid for 6 months;\"\n                },\n                \"right\": {\n                  \"OR\": {\n                    \"left\": {\n                      \"raw_text\": \"Patients who meet DSM-IV-TR criteria for any significant current substance abuse;\"\n                    },\n                    \"right\": {\n                      \"OR\": {\n                        \"left\": {\n                          \"raw_text\": \"hepatic insufficiency (three times the upper limit of normal (ULN) for aspartate aminotransferase (AST) and/or alanine aminotransferase (ALT)); liver transplant recipient; cirrhosis of the liver;\"\n                        }\n                      }\n                    }\n                }\n              }\n            }\n          }\n        },\n        \"right\": {\n          \"AND\": {\n            \"left\": {\n              \"OR\": {\n                \"left\": {\n                  \"raw_text\": \"malignancy (except basal cell carcinoma) and/or chemotherapy within 1 year prior to screening; malignancy more than 1 year prior to screening must have been local and without metastasis and/or recurrence, and if treated with chemotherapy, without nervous system complications;\"\n                },\n                \"right\": {\n                  \"OR\": {\n                    \"left\": {\n                      \"raw_text\": \"significant unstable medical condition or life threatening disease with anticipated survival of less than 6 months;\"\n                    },\n                    \"right\": {\n                      \"OR\": {\n                        \"left\": {\n                          \"raw_text\": \"need for therapies that may obscure the results of treatment and/or of the study\";\n                        }\n                      }\n                    }\n                }\n              }\n            }\n          }\n        },\n        \"right\": {\n          \"AND\": {\n            \"left\": {\n              \"OR\": {\n                \"left\": {\n                  \"rawtext\": \"Participation in another clinical trial within 30 days of the screening visit;\";\n                },\n                \"right\": {\n                  \"OR\": {\n                    \"left\": {\n                      \"rawtext\": \"Anticipated inability to attend scheduled study visits;\";\n                    },\n                    \"right\": {\n                      \"OR\": {\n                        \"rawtext\": \"Patients who in the judgment of the Investigator may be unreliable or uncooperative with the evaluation procedure outlined in this protocol;\";\n                    }\n                  }\n                }\n              }\n            }\n          }\n        },\n        \"right\": {\n          \"AND\": {\n            \"left\": {\n              \"OR\": {\n                \"left\": {\n                  \"rawtext\": \"Patients with a history of prior pharmacogenomic testing;\";\n                },\n                \"right\": {\n                  \"OR\": {\n                    \"left\": {\n                      \"rawtext\": \"Patients who are known to be pregnant or lactating;\";\n                    },\n                    \"right\": {\n                      \"OR\": {\n                        \"rawtext\": \"Patients with a history of gastric bypass surgery.\"\n                        }\n                      }\n                    }\n                }\n              }\n            }\n          }\n        }\n      }\n  }\n}"