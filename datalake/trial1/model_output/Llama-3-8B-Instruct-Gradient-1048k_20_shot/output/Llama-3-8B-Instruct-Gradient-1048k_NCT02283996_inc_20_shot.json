"{\n  \"AND\": {\n    \"left\": {\n      \"raw_text\": \"Patient must be 18 years or older\"\n    },\n    \"right\": {\n      \"AND\": {\n        \"left\": {\n          \"AND\": {\n            \"left\": {\n              \"raw_text\": \"Must meet the following definition for adhesive capsulitis as defined by the American Academy of Orthopedic Surgeons: Self-limiting condition resulting from any inflammatory process about the shoulder in which capsular scar tissue is produced, resulting in pain and limited range of motion; also called frozen shoulder\"\n            },\n            \"right\": {\n              \"raw_text\": \"Must be amenable to randomization into either cohort\"\n            }\n          }\n        }\n      }\n    }\n  }\n}"