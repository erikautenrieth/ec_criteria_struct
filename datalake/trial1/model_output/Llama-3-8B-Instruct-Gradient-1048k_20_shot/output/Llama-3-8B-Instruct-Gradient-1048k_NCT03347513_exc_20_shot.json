"{\n  \"AND\": {\n    \"left\": {\n      \"OR\": {\n        \"left\": {\n          \"raw_text\": \"Severe Iron deficiency anemia (hemoglobin < 8.0 g/dL).\"\n        },\n        \"right\": {\n          \"OR\": {\n            \"left\": {\n              \"raw_text\": \"Parasitic worm infection e.g. schistosomiasis, and hook worm by stool analysis.\"\n            },\n            \"right\": {\n              \"OR\": {\n                \"left\": {\n                  \"raw_text\": \"Any cases giving clinical symptoms of gastritis e.g. nausea, vomiting, dull aching pain or soreness in the epigastrium.\"\n                },\n                \"right\": {\n                  \"OR\": {\n                    \"left\": {\n                      \"raw_text\": \"Cases with history of gastric ulcer diagnosed by upper endoscopy.\"\n                    },\n                    \"right\": {\n                      \"OR\": {\n                        \"left\": {\n                          \"raw_text\": \"Cases complaining of hematemesis.\"\n                        }\n                      }\n                    }\n                }\n              }\n            }\n          }\n        }\n      }\n    }\n  }\n}"