"{\n  \"AND\": {\n    \"left\": {\n      \"OR\": {\n        \"left\": {\n          \"raw_text\": \"Personal or family history of pancreatitis\"\n        },\n        \"right\": {\n          \"OR\": {\n            \"left\": {\n              \"raw_text\": \"Medullary thyroid carcinoma (MTC) or Multiple Endocrine Neoplasia Syndrome Type 2 (MEN 2)\"\n            },\n            \"right\": {\n              \"OR\": {\n                \"left\": {\n                  \"raw_text\": \"Gastroparesis\"\n                },\n                \"right\": {\n                  \"OR\": {\n                    \"left\": {\n                      \"raw_text\": \"Allergy to liraglutide or any of the active ingredients in liraglutide or other GLP-1 analogue\"\n                    },\n                    \"right\": {\n                      \"OR\": {\n                        \"left\": {\n                          \"raw_text\": \"Weight loss drugs other than metformin\"\n                        },\n                        \"right\": {\n                          \"OR\": {\n                            \"left\": {\n                              \"raw_text\": \"Type 1 diabetes mellitus or diabetic ketoacidosis\"\n                            },\n                            \"right\": {\n                              \"OR\": {\n                                \"left\": {\n                                  \"raw_text\": \"Known major cognitive deficit dementia, history of head trauma with loss of consciousness >30 min, history of stroke, current central nervous system (CNS) disorder such as seizures or opportunistic CNS infection\"\n                                },\n                                \"right\": {\n                                  \"OR\": {\n                                    \"left\": {\n                                      \"raw_text\": \"Renal insufficiency defined as creatinine clearance < 60 mL/min\"\n                                    },\n                                    \"ri