"{\n  \"AND\": {\n    \"left\": {\n      \"AND\": {\n        \"left\": {\n          \"raw_text\": \"The use of beta blockers within 2 months of randomization\"\n        },\n        \"right\": {\n          \"AND\": {\n            \"left\": {\n              \"raw_text\": \"Patients actively listed for transplantation at time of entry into the study or anticipated to undergo heart transplantation, interventional catheterization, or corrective cardiac surgery during the 7 months following entry into the study\"\n            },\n            \"right\": {\n              \"AND\": {\n                \"left\": {\n                  \"OR\": {\n                    \"left\": {\n                      \"raw_text\": \"Sustained or symptomatic ventricular dysrhythmias uncontrolled by drug therapy or the use of an implantable defibrillator, and/or significant cardiac conduction defects, e.g., 2nd degree or 3rd degree AV block, or sick sinus syndrome, unless a functioning pacemaker is in place\"\n                    },\n                    \"right\": {\n                      \"AND\": {\n                        \"left\": {\n                          \"raw_text\": \"Uncorrected obstructive or severe regurgitant valve disease, nondilated cardiomyopathy, or significant systemic ventricular outflow obstruction\"\n                        },\n                        \"right\": {\n                          \"AND\": {\n                            \"left\": {\n                              \"raw_text\": \"Known renovascular hypertension or evidence of pulmonary hypertension (pulmonary vascular resistance > 6 Wood units) unresponsive to vasodilator agents such as oxygen, nitroprusside, or nitric oxide\"\n                            },\n                            \"right\": {\n                              \"AND\": {\n                                \"left\": {\n                                  \"raw_text\": \"History or current clinical evidence of moderate-to-severe fixed obstructive pulmonary disease or severe reactive airway diseases (e.g., asthma) requiring hospitalization within the past 2 years or patient currently using long-term inhaled bronchodilators\"\n                                },\n                                \"right\": {\n                                  \"AND\": {\n                                    \"raw_text\": \"Renal, hepatic, gastrointestinal, or biliary disorder that could impair absorption, metabolism or excretion of orally administered medication\"\n                                    },\n                                    \"right\": {\n                                      \"AND\": {\n                                        \"left\": {\n                                          \"raw_text\": \"Concurrent terminal illness or other severe disease (e.g., active neoplasm) or other significant laboratory value(s) which, in the opinion of the investigator, could preclude participation or survival\"\n                                        }\n                                      }\n                                    }\n                                }\n                            }\n                        }\n                    }\n                }\n            }\n          }\n        },\n        \"right\": {\n          \"AND\": {\n            \"left\": {\n              \"AND\": {\n                \"left\": {\n                  \"raw_text\": \"Endocrine disorders such as primary aldosteronism, pheochromocytoma, hyper- or hypothyroidism, insulin-dependent diabetes mellitus\"\n                },\n                \"right\": {\n                  \"AND\": {\n                    \"left\": {\n                      \"raw_text\": \"Unwillingness or inability to cooperate, or for the parents or guardians to give consent, or for the child to give assent, or any condition of sufficient severity to impair cooperation in the study\"\n                    },\n                    \"right\": {\n                      \"AND\": {\n                        \"left\": {\n                          \"raw_text\": \"Pregnancy or possible pregnancy at time of randomization, or female of child bearing potential who are lactating, or sexually active and not taking adequate contraceptive precautions (e.g., intrauterine device or oral contraceptives for 3 months prior to entry into the study)\"\n                        },\n                        \"right\": {\n                          \"AND\": {\n                            \"raw_text\": \"Use of an investigational drug within 30 days of randomization, or within 5 half-lives of the investigational drug (the longer period will apply)\"\n                            }\n                        }\n                    }\n                }\n            }\n          }\n        },\n        \"right\": {\n          \"AND\": {\n            \"left\": {\n              \"AND\": {\n                \"left\": {\n                  \"raw text\": \"History of drug sensitivity or allergic reaction to alpha-blockers or beta-blockers\"\n                },\n                \"right\": {\n                  \"AND\": {\n                    \"left\": {\n                      \"raw text\": \"Use of any of the following medications within two weeks of randomization: MAO inhibitors, Calcium channel blockers, alpha blockers, beta blockers, disopyramide, flecainide, encainide, moricizine, propafenone, sotalol, or beta adrenergic agonists\"\n                },\n                \"right\": {\n                  \"AND\": {\n                    \"raw text\": \"Hospital admission for protein losing enteropathy or plastic bronchitis within 3 months of randomization\"\n                },\n                \"right\": {\n                  \"AND\": {\n                    \"raw text\": \"Active and/or chronic protein losing enteropathy or plastic bronchitis (on inhaled medication to control the plastic bronchitis).\"}\n                }\n            }\n          }\n        },\n        \"right\": {\n          \"AND\": {\n            \"left\": {\n              \"AND\": {\n                \"left\": {\n                  \"raw text\": \"Hypoalbuminemia defined as serum albumin <2.0g/dL\"\n                },\n                \"right\": {\n                  \"AND\": {\n                    \"raw text\": \"Renal dysfunction defined as serum creatinine >2.0mg/dL\"\n                },\n                \"right\": {\n                  \"AND\": {\n                    \"raw text\": \"Hepatic dysfunction defined as serum AST and/or ALT> 3 times upper limit of normal (approximately 120 IU/L however, will vary depending on age),\"}\n                }\n            }\n          }\n        },\n        \"right\": {\n          \"AND\": {\n            \"left\": {\n              \"AND\": {\n                \"left\": {\n                  \"raw text\": \"Significant anemia or polycythemia defined as hemoglobin >18gm/dL or hemoglobin <7gm/dL\"}\n                },\n                \"right\": {\n                  \"AND\": {\n                    \"raw text\": \"Severely elevated serum BNP defined as BNP>300pg/ml\"}\n                }\n            }\n          }\n      }\n    }\n  }\n}"