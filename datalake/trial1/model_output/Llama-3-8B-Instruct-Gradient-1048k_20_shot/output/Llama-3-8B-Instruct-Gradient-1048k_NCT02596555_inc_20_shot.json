"{\n  \"AND\": {\n    \"left\": {\n      \"OR\": {\n        \"left\": {\n          \"raw_text\": \"Age =18 years\"\n        },\n        \"right\": {\n          \"AND\": {\n            \"left\": {\n              \"raw_text\": \"Objectively confirmed diagnosis of acute PE by multidetector CT angiography, ventilation/perfusion lung scan, or selective invasive pulmonary angiography, according to established diagnostic criteria, with or without symptomatic deep vein thrombosis\"\n            },\n            \"right\": {\n              \"AND\": {\n                \"left\": {\n                  \"NOT\": {\n                    \"left\": {\n                      \"raw_text\": \"Hemodynamic collapse or decompensation\"\n                    }\n                  }\n                }\n              }\n            }\n          }\n        },\n        \"right\": {\n          \"AND\": {\n            \"left\": {\n              \"OR\": {\n                \"left\": {\n                  \"raw_text\": \"At least one sign of RV pressure overload/dysfunction on CT angiography or echocardiography\"\n                },\n                \"right\": {\n                  \"OR\": {\n                    \"left\": {\n                      \"raw_text\": \"Signs of myocardial injury as indicated by elevated troponin levels\"\n                    },\n                    \"right\": {\n                      \"OR\": {\n                        \"left\": {\n                          \"raw_text\": \"Signs of (RV) failure as indicated by NT-proBNP levels >600 pg/ml at baseline.\"\n                        }\n                      }\n                    }\n                  }\n                }\n              }\n            }\n          }\n        },\n        \"right\": {\n          \"AND\": {\n            \"left\": {\n              \"AND\": {\n                \"left\": {\n                  \"raw_text\": \"Ability of the subject to understand the character and individual consequences of the clinical trial; signed and dated informed consent of the subject available before the start of any specific trial procedures\"\n                }\n              }\n            }\n          }\n        }\n      }\n    }\n  }\n}"