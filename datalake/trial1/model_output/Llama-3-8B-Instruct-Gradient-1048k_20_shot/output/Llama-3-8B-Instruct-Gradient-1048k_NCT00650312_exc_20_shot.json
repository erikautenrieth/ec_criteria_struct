"{\n  \"AND\": {\n    \"left\": {\n      \"AND\": {\n        \"left\": {\n          \"raw_text\": \"1. Institutionalized subjects will not be used.\"\n        },\n        \"right\": {\n          \"AND\": {\n            \"left\": {\n              \"OR\": {\n                \"left\": {\n                  \"raw_text\": \"2. Social Habits:\"\n                },\n                \"right\": {\n                  \"AND\": {\n                    \"left\": {\n                      \"OR\": {\n                        \"left\": {\n                          \"raw_text\": \"1. Use of any tobacco products.\"\n                        },\n                        \"right\": {\n                          \"OR\": {\n                            \"left\": {\n                              \"raw_text\": \"2. Ingestion of any alcoholic, caffeine- or xanthine-containing food or beverage within the 48 hours prior to the initial dose of study medication.\"\n                            },\n                            \"right\": {\n                              \"OR\": {\n                                \"left\": {\n                                  \"raw_text\": \"3. Ingestion of any vitamins or herbal products within the 48 hours prior to the initial dose of the study medication.\"\n                                },\n                                \"right\": {\n                                  \"OR\": {\n                                    \"raw_text\": \"4. Any recent, significant change in dietary or exercise habits.\"\n                                    },\n                                    \"right\": {\n                                      \"OR\": {\n                                        \"raw_text\": \"5. Positive test for any drug included in the urine drug screen.\"\n                                        }\n                                      }\n                                  }\n                                }\n                            }\n                        }\n                    }\n                }\n              }\n            }\n          }\n        },\n        \"right\": {\n          \"AND\": {\n            \"left\": {\n              \"OR\": {\n                \"left\": {\n                  \"raw_text\": \"3. Medications:\"\n                },\n                \"right\": {\n                  \"AND\": {\n                    \"left\": {\n                      \"OR\": {\n                        \"left\": {\n                          \"raw_text\": \"1. Use of any medication within the 14 days prior to the initial dose of study medication.\"\n                        },\n                        \"right\": {\n                          \"OR\": {\n                            \"left\": {\n                              \"raw_text\": \"2. Use of any medication known to alter hepatic enzyme activity within 28 days prior to the initial dose of study medication.\"\n                            },\n                            \"right\": {\n                              \"OR\": {\n                                \"left\": {\n                                  \"raw_text\": \"3. Use of hormonal contraceptives and hormonal replacement therapy within three months prior to the initial dose of study medication.\"\n                                },\n                                \"right\": {\n                                  \"OR\": {\n                                    \"raw text\": \"4. Diseases:\"\n                                  }\n                                }\n                            }\n                        }\n                    }\n                }\n              }\n            }\n          }\n        },\n        \"right\": {\n          \"AND\": {\n            \"left\": {\n              \"OR\": {\n                \"left\": {\n                  \"raw text\": \"a. History of any significant chronic disease and/or hepatitis.\"\n                },\n                \"right\": {\n                  \"OR\": {\n                    \"left\": {\n                      \"raw text\": \"b. History of drug and/or alcohol abuse.\"\n                    },\n                    \"right\": {\n                      \"OR\": {\n                        \"raw text\": \"c. Acute illness at the time of either the prestudy medical evaluation or dosing.\"\n                    },\n                    \"right\": {\n                      \"OR\": {\n                        \"raw text\": \"d. Positive HIV, Hepatitis B, or Hepatitis C test.\"\n                    },\n                    \"right\": {\n                      \"OR\": {\n                        \"raw text\": \"e. Renal disease or renal dysfunction (as suggested by serum creatinine levels greater than or equal to 1.5 mg/dL (for males) and greater than or equal to 1.4 mg/dL (for females) or abnormal creatinine clearance.\"\n                    }\n                  }\n                }\n              }\n            }\n          }\n        },\n        \"right\": {\n          \"AND\": {\n            \"left\": {\n              \"OR\": {\n                \"left\": {\n                  \"raw text\": \"5. Abnormal and clinically significant laboratory test results:\"\n                },\n                \"right\": {\n                  \"OR\": {\n                    \"left\": {\n                      \"raw text\": \"1. Clinically significant deviation from the Guide for Clinically Relevant Abnormalities (see Part II ADMINISTRATIVE ASPECTS OF BIOEQUIVALENCE PROTOCOLS).\"\n                    },\n                    \"right\": {\n                      \"OR\": {\n                        \"raw text\": \"2. Abnormal and clinically relevant ECG tracing.\"\n                    }\n                  }\n                }\n              }\n            }\n          }\n        },\n        \"right\": {\n          \"AND\": {\n            \"left\": {\n              \"OR\": {\n                \"left\": {\n                  \"raw text\": \"6. Donation or loss of a significant volume of blood or plasma (> 450 mL) within 28 days prior to the initial dose of study medication.\"\n                },\n                \"right\": {\n                  \"OR\": {\n                    \"raw text\": \"7. Subjects who have received an investigational drug within 30 days prior to the initial dose of study medication.\"\n                },\n                \"right\": {\n                  \"OR\": {\n                    \"raw text\": \"8. Allergy or hypersensitivity to metformin hydrochloride.\"\n                },\n                \"right\": {\n                  \"OR\": {\n                    \"raw text\": \"9. History of difficulty in swallowing medication, or any gastrointestinal disorder which could affect the drug absorption.\"\n                }\n              }\n            }\n          }\n    }\n  }\n}"