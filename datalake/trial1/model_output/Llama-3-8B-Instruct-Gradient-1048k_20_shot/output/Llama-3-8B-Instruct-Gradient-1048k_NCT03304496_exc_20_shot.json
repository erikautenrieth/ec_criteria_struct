"{\n  \"AND\": {\n    \"left\": {\n      \"OR\": {\n        \"left\": {\n          \"raw_text\": \"Pregnant.\"\n        },\n        \"right\": {\n          \"AND\": {\n            \"left\": {\n              \"OR\": {\n                \"left\": {\n                  \"raw_text\": \"Not have informed consent for the present clinical trial, or do not fully understand the meaning of informed consent.\"\n                },\n                \"right\": {\n                  \"AND\": {\n                    \"left\": {\n                      \"raw_text\": \"With acute myocardial infarction with ST segment elevation in the first 12 hours from the onset of symptoms.\"\n                    },\n                    \"right\": {\n                      \"AND\": {\n                        \"left\": {\n                          \"raw_text\": \"With any acute coronary syndrome complicated with acute pulmonary edema, cardiogenic shock and / or malignant ventricular arrhythmias.\"\n                        },\n                        \"right\": {\n                          \"AND\": {\n                            \"left\": {\n                              \"raw_text\": \"In which a cardiac catheterization is planned a priori to be performed via femoral, brachial or ulnar.\"\n                            },\n                            \"right\": {\n                              \"AND\": {\n                                \"left\": {\n                                  \"Patients in whom first attempt of arterial puncture is performed by 2nd year interventional cardiology fellow or by physician in charge.\"\n                                },\n                                \"right\": {\n                                  \"AND\": {\n                                    \"left\": {\n                                      \"Participating in another clinical trial.\"\n                                    },\n                                    \"right\": {\n                                      \"Be allergic or have contraindications to nitroglycerin or other nitrates.\"\n                                    },\n                                    \"right\": {\n                                      \"Any phosphodiesterase 5 inhibitor (sildenafil, tadalafil, avanafil, vardenafil) has been taken within 72 hours prior to the study.\"\n                                    }\n                                  }\n                                }\n                            }\n                        }\n                    }\n                }\n              }\n            }\n          }\n        }\n      }\n    }\n  }\n}"