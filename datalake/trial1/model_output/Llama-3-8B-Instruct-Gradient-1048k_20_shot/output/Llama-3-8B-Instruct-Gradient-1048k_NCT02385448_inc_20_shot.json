"{\n  \"AND\": {\n    \"left\": {\n      \"OR\": {\n        \"left\": {\n          \"raw_text\": \"Good general health\"\n        },\n        \"right\": {\n          \"AND\": {\n            \"left\": {\n              \"raw_text\": \"Older than the age of legal consent (i.e. 18 years old)\"\n            },\n            \"right\": {\n              \"AND\": {\n                \"OR\": {\n                  \"left\": {\n                    \"raw_text\": \"Sonographic diagnosis of ovarian endometrioma with diameter at least 4cm on 2 separate scans at least 6 weeks apart\"}\n                },\n                \"right\": {\n                  \"AND\": {\n                    \"left\": {\n                      \"raw_text\": \"No contraindication to use of progesterone or combined oral contraceptive pills\"}\n                    },\n                    \"right\": {\n                      \"AND\": {\n                        \"left\": {\n                          \"raw_text\": \"Not attempting to conceive either at the time of study entry or for at least 2 years after surgery\"}\n                        },\n                        \"right\": {\n                          \"AND\": {\n                            \"raw_text\": \"Willing and able to participate after the study has been explained\"}\n                            }\n                      }\n                    }\n                }\n              }\n            }\n          }\n      }\n    }\n  }\n}"