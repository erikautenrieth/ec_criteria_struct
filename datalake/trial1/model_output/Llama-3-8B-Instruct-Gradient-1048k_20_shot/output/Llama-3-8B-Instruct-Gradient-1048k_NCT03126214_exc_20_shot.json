"{\n  \"AND\": {\n    \"left\": {\n      \"OR\": {\n        \"left\": {\n          \"raw_text\": \"Uncontrolled hypertension (defined as average SBP = 160 mmHg [2 readings taken at time of screening]).\"\n        },\n        \"right\": {\n          \"AND\": {\n            \"left\": {\n              \"raw_text\": \"End stage renal disease (CrCl < 15 ml/min)\"\n            },\n            \"right\": {\n              \"AND\": {\n                \"left\": {\n                  \"raw_text\": \"Valvular Heart Disease including those with prosthetic valve, mitral stenosis (moderate to severe) or valve repair.\"\n                },\n                \"right\": {\n                  \"AND\": {\n                    \"left\": {\n                      \"raw_text\": \"Excess alcohol intake (males: = 28 units/week, females: = 21 units/week. One unit of alcohol = 8 oz beer, 1 oz hard liquor or 4 oz wine).\"\n                    },\n                    \"right\": {\n                      \"AND\": {\n                        \"left\": {\n                          \"raw_text\": \"Intracranial bleed at any point.\"\n                        },\n                        \"right\": {\n                          \"AND\": {\n                            \"left\": {\n                              \"raw_text\": \"History of \"Major Bleeding\" at any point (defined as overt bleeding at a critical site including intracranial, intraspinal, intraocular, pericardial, or retroperitoneal; or bleed requiring hospitalization).\"\n                            }\n                        }\n                      }\n                    }\n                  }\n                }\n              }\n            }\n          }\n        }\n      }\n    },\n    \"right\": {\n      \"AND\": {\n        \"left\": {\n          \"raw_text\": \"Foreshortened life-expectancy or severe comorbidities precluding study follow-up period\"\n        },\n        \"right\": {\n          \"AND\": {\n            \"left\": {\n            