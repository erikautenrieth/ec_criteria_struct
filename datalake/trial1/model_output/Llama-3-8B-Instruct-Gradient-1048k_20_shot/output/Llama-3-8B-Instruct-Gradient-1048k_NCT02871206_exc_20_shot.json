"{\n  \"AND\": {\n    \"left\": {\n      \"OR\": {\n        \"left\": {\n          \"raw_text\": \"Anaphylactic reaction to a previous dose of influenza vaccine or to any of its components\"\n        },\n        \"right\": {\n          \"AND\": {\n            \"left\": {\n              \"OR\": {\n                \"left\": {\n                  \"raw_text\": \"Known Immunoglobulin E (IgE)-mediated hypersensitivity to eggs manifested as hives, swelling of the mouth and throat, difficulty in breathing, hypotension, or shock\"\n                },\n                \"right\": {\n                  \"raw_text\": \"Guillain- Barré syndrome within eight weeks of a previous influenza vaccine\"\n                }\n              }\n            }\n          },\n          \"right\": {\n            \"AND\": {\n              \"left\": {\n                \"OR\": {\n                  \"left\": {\n                    \"raw_text\": \"Use of aspirin or salicylate- containing products within 30 days before enrollment\"\n                    },\n                    \"right\": {\n                      \"AND\": {\n                        \"left\": {\n                          \"raw_text\": \"Household members of children in Group A\"\n                        }\n                      }\n                    }\n                  }\n                }\n              }\n            }\n          }\n        }\n      }\n    }\n  }\n}"