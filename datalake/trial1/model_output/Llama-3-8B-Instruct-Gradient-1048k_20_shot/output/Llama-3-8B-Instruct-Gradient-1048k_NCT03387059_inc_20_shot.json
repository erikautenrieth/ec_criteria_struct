"{\n  \"AND\": {\n    \"left\": {\n      \"OR\": {\n        \"left\": {\n          \"raw_text\": \"All infertile women treated with intracytoplasmic sperm injection (ICSI)/Fertilization in Vitro and Embryo Transfer (FIVET)\"\n        },\n        \"right\": {\n          \"AND\": {\n            \"left\": {\n              \"raw_text\": \"Less than or equal to (<=) 1 previous failed embryo transfer\"\n            },\n            \"right\": {\n              \"AND\": {\n                \"left\": {\n                  \"OR\": {\n                    \"left\": {\n                      \"raw_text\": \"Eumenorrheic normo-gonadotropic women\"\n                    },\n                    \"right\": {\n                      \"AND\": {\n                        \"left\": {\n                          \"raw_text\": \"Basal follicle-stimulating hormone (FSH) <=12 International unit per liter (IU/L)\"\n                        },\n                        \"right\": {\n                          \"AND\": {\n                            \"left\": {\n                              \"raw_text\": \"Anti-mullerian hormone (AMH) greater than (>) 1.1 nanogram per milliliter (ng/mL)\"\n                            },\n                            \"right\": {\n                              \"AND\": {\n                                \"raw_text\": \"Ovarian Reserve: number of antral follicles 2 millimeter (mm) between 6 <= antral follicle count (AFC) <= 16\"\n                                },\n                                \"right\": {\n                                  \"AND\": {\n                                    \"raw_text\": \"Follicles > 16 mm at the triggering day between 5-14\"\n                                    },\n                                    \"right\": {\n                                      \"AND\": {\n                                        \"raw_text\": \"Body Mass Index (BMI) between 18 <= BMI <= 27 kilogram per meter square (kg/m^2)\"\n                                     