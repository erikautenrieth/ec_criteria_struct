"{\n  \"AND\": {\n    \"left\": {\n      \"AND\": {\n        \"left\": {\n          \"raw_text\": \"men and women 30-55 years with BMI 30-40 and waist 95 cm or more\"\n        },\n        \"right\": {\n          \"AND\": {\n            \"left\": {\n              \"OR\": {\n                \"left\": {\n                  \"raw_text\": \"normal OGTT\"\n                },\n                \"right\": {\n                  \"OR\": {\n                    \"left\": {\n                      \"raw_text\": \"normal treadmill stress test\"\n                    }\n                  }\n                }\n              }\n            },\n            \"right\": {\n              \"AND\": {\n                \"OR\": {\n                  \"left\": {\n                    \"raw_text\": \"plus 2 of 4:\"\n                  },\n                  \"right\": {\n                    \"AND\": {\n                      \"left\": {\n                        \"OR\": {\n                          \"left\": {\n                            \"raw_text\": \"1. low serum levels of HDL cholesterol (<40 mg⁄dL for men or < 50 mg ⁄dL for women)\"\n                        },\n                        \"right\": {\n                          \"OR\": {\n                            \"left\": {\n                              \"raw_text\": \"2. hypertriglyceridemia (triglyceride levels of 150 mg⁄dL or greater)\"\n                            },\n                            \"right\": {\n                              \"OR\": {\n                                \"left\": {\n                                  \"raw_text\": \"3. impaired glucose homeostasis (fasting plasma glucose concentration of 110 mg⁄dL or greater or glucose of 140 mg⁄dL or greater after OGTT or\"}\n                                },\n                                \"right\": {\n                                  \"OR\": {\n                                    \"raw_text\": \"4. hypertension (systolic blood pressure ≥ 140 or diastolic blood pressure ≥90 mmHg