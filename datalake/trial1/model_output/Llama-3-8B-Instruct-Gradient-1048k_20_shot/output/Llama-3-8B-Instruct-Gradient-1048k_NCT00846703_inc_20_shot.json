"{\n  \"AND\": {\n    \"left\": {\n      \"AND\": {\n        \"left\": {\n          \"raw_text\": \"Cytologically proven acute lymphoblastic leukemia (ALL)\"\n        },\n        \"right\": {\n          \"AND\": {\n            \"left\": {\n              \"raw_text\": \"No relapse of a previously unrecognized ALL\"\n            },\n            \"right\": {\n              \"AND\": {\n                \"left\": {\n                  \"OR\": {\n                    \"left\": {\n                      \"raw_text\": \"Patients must meet one of the following risk criteria:\"\n                    },\n                    \"right\": {\n                      \"AND\": {\n                        \"left\": {\n                          \"raw_text\": \"Standard-risk (SR) group meeting all of the following criteria:\"\n                        },\n                        \"right\": {\n                          \"AND\": {\n                            \"left\": {\n                              \"raw_text\": \"Blasts < 1,000/µL in peripheral blood (PB) on day 8\"\n                            },\n                            \"right\": {\n                              \"AND\": {\n                                \"left\": {\n                                  \"raw_text\": \"Aged 1 to < 6 years\"\n                                },\n                                \"right\": {\n                                  \"AND\": {\n                                    \"raw_text\": \"Initial WBC < 20,000/µL\"\n                                    },\n                                    \"right\": {\n                                      \"AND\": {\n                                        \"raw_text\": \"M1 (5%) or M2 (= 5% to < 25%) blasts in bone marrow on day 15; M1 marrow on day 33.\"\n                                        }\n                                    }\n                                  }\n                                }\n                            }\n                          }\n      