"{\n  \"AND\": {\n    \"left\": {\n      \"OR\": {\n        \"left\": {\n          \"raw_text\": \"History of sensitivity to study medications or any of their excipients\"\n        },\n        \"right\": {\n          \"AND\": {\n            \"left\": {\n              \"OR\": {\n                \"left\": {\n                  \"raw_text\": \"RA cohort: Previous intolerance to MTX\"\n                },\n                \"right\": {\n                  \"raw_text\": \"or Current treatment with antiplatelet therapy\"\n                }\n              }\n            },\n            \"right\": {\n              \"AND\": {\n                \"OR\": {\n                  \"left\": {\n                    \"raw_text\": \"Absolute indication for anti-platelet therapy\"\n                },\n                \"right\": {\n                  \"OR\": {\n                    \"left\": {\n                      \"raw_text\": \"or Need for chronic oral anticoagulant therapy\"\n                }\n              }\n            }\n          }\n        },\n        \"right\": {\n          \"AND\": {\n            \"left\": {\n              \"OR\": {\n                \"left\": {\n                  \"raw_text\": \"Severe hepatic impairment (eg, ascites and/or clinical signs of coagulopathy)\"\n                },\n                \"right\": {\n                  \"OR\": {\n                    \"left\": {\n                      \"raw_text\": \"or Renal failure (eGFR <30 or requiring dialysis)\"\n                }\n              }\n            }\n          }\n        },\n        \"right\": {\n          \"AND\": {\n            \"left\": {\n              \"OR\": {\n                \"left\": {\n                  \"raw_text\": \"A known bleeding diathesis, hemostatic or coagulation disorder, or prior major bleeding\"\n                },\n                \"right\": {\n                  \"OR\": {\n                    \"left\": {\n                      \"raw_text\": \"or Prior stroke\"\n                }\n      