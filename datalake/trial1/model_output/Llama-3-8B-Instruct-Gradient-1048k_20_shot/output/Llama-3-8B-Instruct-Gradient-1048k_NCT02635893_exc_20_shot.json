"{\n  \"AND\": {\n    \"left\": {\n      \"OR\": {\n        \"left\": {\n          \"raw_text\": \"Uncontrolled medical problems including pulmonary, cardiovascular or orthopedic disease,\"\n        },\n        \"right\": {\n          \"OR\": {\n            \"left\": {\n              \"raw_text\": \"Any debilitating disease prior to the SCI that caused exercise intolerance\"\n            },\n            \"right\": {\n              \"OR\": {\n                \"left\": {\n                  \"raw_text\": \"Premorbid, ongoing major depression or psychosis, altered cognitive status\"\n                },\n                \"right\": {\n                  \"OR\": {\n                    \"left\": {\n                      \"raw_text\": \"History of head injury or stroke,\"\n                    },\n                    \"right\": {\n                      \"OR\": {\n                        \"left\": {\n                          \"raw_text\": \"Metal plate in skull\"\n                        },\n                        \"right\": {\n                          \"OR\": {\n                            \"left\": {\n                              \"raw_text\": \"History of seizures\"\n                            },\n                            \"right\": {\n                              \"OR\": {\n                                \"left\": {\n                                  \"raw_text\": \"Receiving drugs acting primarily on the central nervous system, which lower the seizure threshold such as antipsychotic drugs (chlorpromazine, clozapine) or tricyclic antidepressants.\"\n                                },\n                                \"right\": {\n                                  \"OR\": {\n                                    \"left\": {\n                                      \"raw_text\": \"Pregnant females, and\"\n                                    },\n                                    \"right\": {\n                                      \"OR\": {\n                            