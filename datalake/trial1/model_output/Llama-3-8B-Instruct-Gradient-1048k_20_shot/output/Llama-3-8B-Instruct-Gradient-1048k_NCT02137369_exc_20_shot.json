"{\n  \"AND\": {\n    \"left\": {\n      \"OR\": {\n        \"left\": {\n          \"raw_text\": \"Lifetime history of Bipolar Disorder, Dementia, Autism Spectrum Disorder, Schizophrenia, or any other Psychotic Disorder.\"\n        },\n        \"right\": {\n          \"AND\": {\n            \"left\": {\n              \"raw_text\": \"Psychotic symptoms occurring at any time during the current major depressive episode.\"\n            },\n            \"right\": {\n              \"AND\": {\n                \"left\": {\n                  \"OR\": {\n                    \"left\": {\n                      \"raw_text\": \"Current (past 12 months) diagnosis of Panic disorder, Obsessive Compulsive Disorder, Posttraumatic Stress Disorder, Anorexia Nervosa, or Bulimia Nervosa.\"\n                    },\n                    \"right\": {\n                      \"AND\": {\n                        \"left\": {\n                          \"raw_text\": \"Alcohol or Drug Dependence within 12 months or Abuse within 3 months (excluding nicotine and caffeine) of baseline visit, as assessed by history and urine drug screen.\"\n                        }\n                      }\n                    }\n                  }\n                }\n              }\n            }\n          }\n        },\n        \"right\": {\n          \"AND\": {\n            \"left\": {\n              \"AND\": {\n                \"left\": {\n                  \"raw_text\": \"Clinical evidence of a severe Personality Disorder, as assessed by the study psychiatrist, which would impede participation or completion of the trial.\"\n                },\n                \"right\": {\n                  \"AND\": {\n                    \"left\": {\n                      \"raw_text\": \"Known neurological disorders or documented serious head injury.\"\n                    }\n                  }\n                }\n              }\n            }\n          }\n        },\n        \"right\": {\n          \"AND\": {\n            \"left\": {\n              \"AND\": {\n                \"left\": {\n                  \"raw_text\": \"Active medical conditions with known mood changes (endocrine, autoimmune disorders).\"\n                },\n                \"right\": {\n                  \"AND\": {\n                    \"left\": {\n                      \"raw_text\": \"Current diabetes mellitus.\"\n                    }\n                  }\n                }\n              }\n            }\n          }\n        },\n        \"right\": {\n          \"AND\": {\n            \"left\": {\n              \"AND\": {\n                \"left\": {\n                  \"rawtext\": \"For women, pregnancy, lactation, or unwillingness to comply with birth control requirements.\"\n                },\n                \"right\": {\n                  \"AND\": {\n                    \"left\": {\n                      \"Use of any of the following treatments or any other alternative therapy within 2 weeks of the pre-treatment PET scan that may have beneficial effects on mood, including St John's Wort, S-adenosyl methionine (SAMe), n-3 fatty acids, or light therapy.\"\n                    }\n                  }\n                }\n              }\n            }\n          }\n        },\n        \"right\": {\n          \"AND\": {\n            \"left\": {\n              \"AND\": {\n                \"left\": {\n                  \"rawtext\": \"Use of antidepressant medication within 1 month of the pre-treatment PET scan (within 5 weeks for fluoxetine and protryptyline).\"\n                },\n                \"right\": {\n                  \"AND\": {\n                    \"Failure to achieve a much improved status (i.e. equivalent to >50% symptom reduction) with any lifetime treatment course of CBT (defined as a minimum of 4 sessions of a specified manual-driven therapy by a CBT-trained therapist) or escitalopram (defined as a minimum of 6 weeks of at least 10 mg/day).\"\n                    }\n                  }\n                }\n              }\n            }\n          }\n        },\n        \"right\": {\n          \"AND\": {\n            \"left\": {\n              \"AND\": {\n                \"left\": {\n                  \"rawtext\": \"Clinically significant active suicidal ideation or self-injurious behavior necessitating immediate treatment, as determined by the investigator.\"\n                },\n                \"right\": {\n                  \"AND\": {\n                    \"Received electroconvulsive therapy in the past 6 months or during the current depressive episode.\"\n                    }\n                  }\n                }\n              }\n            }\n          }\n        },\n        \"right\": {\n          \"AND\": {\n            \"left\": {\n              \"AND\": {\n                \"left\": {\n                  \"rawtext\": \"Currently responding to medication treatment, without clinical reasons to change.\"\n                },\n                \"right\": {\n                  \"AND\": {\n                    \"Current treatment with weekly individual or group psychotherapy of any type targeted at depressive symptoms.\"\n                    }\n                  }\n                }\n              }\n            }\n          }\n        },\n        \"right\": {\n          \"AND\": {\n            \"left\": {\n              \"AND\": {\n                \"left\": {\n                  \"rawtext\": \"QTc >500 milliseconds on EKG at screening.\"\n                },\n                \"right\": {\n                  \"AND\": {\n                    \"Contraindications for MRI, including, but not limited to pacemaker, aneurysm clips, neurostimulators, cochlear implants, metal in eyes, steel worker, intra-uterine devices for birth control.\"\n                    }\n                  }\n                }\n              }\n            }\n          }\n        },\n        \"right\": {\n          \"AND\": {\n            \"left\": {\n              \"AND\": {\n                \"left\": {\n                  \"rawtext\": \"Maintenance or prophylactic therapy for stable medical conditions.\"\n                },\n                \"right\": {\n                  \"AND\": {\n                    \"Hypnotic medication prescribed or approved by the study physician, (up to a three doses per week) for insomnia, as long if not the night before a PET/MRI or clinic ratings visit. Antipsychotic medications, whether prescribed for sleep or other indications, are prohibited.\"\n                    }\n                  }\n                }\n              }\n            }\n          }\n        }\n      }\n    }\n  }\n}"