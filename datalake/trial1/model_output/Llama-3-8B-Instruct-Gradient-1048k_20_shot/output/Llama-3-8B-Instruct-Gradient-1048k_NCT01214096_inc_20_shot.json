"{\n  \"AND\": {\n    \"left\": {\n      \"OR\": {\n        \"left\": {\n          \"raw_text\": \"1. Age: 18-75 years old, no limitation in gender;\"\n        },\n        \"right\": {\n          \"AND\": {\n            \"left\": {\n              \"AND\": {\n                \"left\": {\n                  \"raw_text\": \"2. Left ventricular ejection fraction (LVEF) ≤ 40% (ECHO);\"\n                },\n                \"right\": {\n                  \"AND\": {\n                    \"left\": {\n                      \"raw_text\": \"3. Patients with chronic heart failure (NYHA class II or III);\"\n                    },\n                    \"right\": {\n                      \"AND\": {\n                        \"left\": {\n                          \"raw_text\": \"4. In the past one month, the clinical condition (including history, clinical symptoms and signs) was relatively stable;\"\n                        },\n                        \"right\": {\n                          \"AND\": {\n                            \"left\": {\n                              \"raw_text\": \"5. Patients on standard treatment of chronic heart failure at the target dose or maximum tolerance dose for over 1 month,or unchanged dose in last 1 month;\"\n                            },\n                            \"right\": {\n                              \"AND\": {\n                                \"left\": {\n                                  \"raw_text\": \"6. Understand and sign the informed consent form;\"\n                                }\n                              }\n                            }\n                          }\n                        }\n                      }\n                    }\n                  }\n                }\n              }\n            }\n          }\n        }\n      }\n  }\n}"