"{\n  \"AND\": {\n    \"left\": {\n      \"OR\": {\n        \"left\": {\n          \"raw_text\": \"Had dose increase of anti-TNF agent or DMARD in the last 6 months\"\n        },\n        \"right\": {\n          \"OR\": {\n            \"left\": {\n              \"raw_text\": \"Had change of anti-TNF agent or DMARD in the last 6 months\"\n            },\n            \"right\": {\n              \"OR\": {\n                \"left\": {\n                  \"raw_text\": \"Treated currently with golimumab or certolizumab\"\n                },\n                \"right\": {\n                  \"OR\": {\n                    \"left\": {\n                      \"raw_text\": \"Treated with greater than 10 mg of prednisone (or equivalent) daily in the last 6 months\"\n                    },\n                    \"right\": {\n                      \"OR\": {\n                        \"left\": {\n                          \"raw_text\": \"Treated with greater than 5 mg of prednisone (or equivalent) daily in the last 3 months\"\n                        },\n                        \"right\": {\n                          \"OR\": {\n                            \"raw_text\": \"Treated with intramuscular or intravenous corticosteroids in the last 6 months for RA activity\"\n                            },\n                            \"right\": {\n                              \"OR\": {\n                                \"left\": {\n                                  \"raw_text\": \"Treated with anakinra, abatacept, or tocilizumab in the last 6 months\"\n                                },\n                                \"right\": {\n                                  \"OR\": {\n                                    \"raw_text\": \"Treated with rituximab in the last 12 months\"\n                                    },\n                                    \"right\": {\n                                      \"OR\": {\n                                        \"raw text\": \"Treated with an investigational RA drug in the last 6 months\"\n                                        }\n                                      }\n                                }\n                              }\n                            }\n                          }\n                        }\n                      }\n                    }\n                  }\n                }\n              }\n            }\n          }\n        }\n      }\n    },\n    \"right\": {\n      \"AND\": {\n        \"left\": {\n          \"OR\": {\n            \"left\": {\n              \"raw text\": \"Pregnant (or anticipate pregnancy during the study period) or lactating women\"\n            },\n            \"right\": {\n              \"AND\": {\n                \"left\": {\n                  \"OR\": {\n                    \"left\": {\n                      \"raw text\": \"Absence of documentation in the medical record of clinical remission for the last 6 months\"\n                    },\n                    \"right\": {\n                      \"OR\": {\n                        \"raw text\": \"Unwilling to discontinue anti-TNF agent\"\n                        },\n                        \"right\": {\n                          \"OR\": {\n                            \"raw text\": \"Absence of documentation of negative tuberculin skin test, negative QuantiFERON-TB Gold test, or treatment for latent tuberculosis prior to starting treatment with the anti-TNF agent\"\n                            },\n                            \"right\": {\n                              \"OR\": {\n                                \"raw text\": \"Treatment of solid malignancy or non-melanoma skin cancer within the past 5 years, or any history of melanoma or hematologic or lymphoproliferative malignancy\"\n                                },\n                                \"right\": {\n                                  \"OR\": {\n                                    \"raw text\": \"Absence of documentation of age-appropriate cancer screening at the time of randomization\"\n                                    },\n                                    \"right\": {\n                                      \"OR\": {\n                                        \"raw text\": \"Absence of documentation of negative hepatitis B serologies, absence of completion of treatment for chronic hepatitis B, or absence of suppressive antiviral treatment\"\n                                        },\n                                        \"right\": {\n                                          \"OR\": {\n                                            \"raw text\": \"Unable to provide informed consent\"\n                                            },\n                                            \"right\": {\n                                              \"OR\": {\n                                                \"raw text\": \"Anticipate not being available or able to comply with the schedule of study visits\"\n                                                }\n                                              }\n                                          }\n                                        }\n                                      }\n                                  }\n                                }\n                              }\n                            }\n                          }\n                        }\n                      }\n                    }\n                  }\n                }\n              }\n            }\n          }\n        }\n      }\n    }\n  }\n}"