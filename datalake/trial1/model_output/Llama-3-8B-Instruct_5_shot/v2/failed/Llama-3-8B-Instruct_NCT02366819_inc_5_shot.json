"{\n  \"AND\": {\n    \"left\": {\n      \"OR\": {\n        \"left\": {\n          \"raw_text\": \"Histologically confirmed locally advanced gastric\"\n        },\n        \"right\": {\n          \"raw_text\": \"or esophagogastric adenocarcinoma; distal gastric (antral) adenocarcinomas are eligible for enrolment but will not be included in the primary analysis\"\n        }\n      }\n    },\n    \"right\": {\n      \"AND\": {\n        \"left\": {\n          \"OR\": {\n            \"left\": {\n              \"raw_text\": \"Locally advanced disease as determined by endoscopic ultrasound (EUS) stage > primary tumor (T) 3 and/or any T, lymph nodes (N)+ disease without metastatic disease (Mx)\"\n            },\n            \"right\": {\n              \"raw_text\": \"All patients must have diagnostic laparoscopy with diagnostic washings for cytology; both cytology positive and negative patients are eligible for enrolment, but only cytology negative patients will be included in the primary analyses; gross peritoneal disease is not eligible\"\n            }\n          }\n        },\n        \"right\": {\n          \"AND\": {\n            \"left\": {\n              \"OR\": {\n                \"left\": {\n                  \"raw_text\": \"Eastern Cooperative Oncology Group (ECOG) performance status =< 1\"\n                },\n                \"right\": {\n                  \"raw_text\": \"Eligible for surgery with curative intent\"\n                }\n              }\n            },\n            \"right\": {\n              \"AND\": {\n                \"left\": {\n                  \"OR\": {\n                    \"left\": {\n                      \"raw_text\": \"Absolute neutrophil count (ANC) >= 1250/ul\"\n                    },\n                    \"right\": {\n                      \"raw_text\": \"Hemoglobin >= 9 g/dL\"\n                    }\n                  }\n                },\n                \"right\": {\n                  \"AND\": {\n                    \"left\": {\n                      \"raw_text\": \"Platelets >= 100,000/ul\"\n                    },\n                    \"right\": {\n                      \"raw_text\": \"Total bilirubin < 1.5 x upper limit of normal\"\n                    }\n                  }\n                }\n              }\n            \"right\": {\n              \"AND\": {\n                \"left\": {\n                  \"raw_text\": \"Women of child-bearing potential and men must agree to use adequate contraception (hormonal or barrier method of birth control; abstinence) prior to study entry and for the duration of study participation, up until 30 days after final study treatment; should a woman become pregnant or suspect that she is pregnant while participating in this study, she should inform her treating physician immediately.