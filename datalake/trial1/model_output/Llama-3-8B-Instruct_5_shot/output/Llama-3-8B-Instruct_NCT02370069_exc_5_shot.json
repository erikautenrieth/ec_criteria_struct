"{\n  \"AND\": {\n    \"left\": {\n      \"OR\": {\n        \"left\": {\n          \"raw_text\": \"immunization with PPV23 within the last year\"\n        }\n      }\n    },\n    \"right\": {\n      \"AND\": {\n        \"left\": {\n          \"OR\": {\n            \"left\": {\n              \"raw_text\": \"any confirmed or suspected immunodeficiency condition\"\n            },\n            \"right\": {\n              \"OR\": {\n                \"left\": {\n                  \"raw_text\": \"including human immunodeficiency virus (HIV) infection\"\n                },\n                \"right\": {\n                  \"OR\": {\n                    \"left\": {\n                      \"raw_text\": \"haematological malignancy\"\n                    },\n                    \"right\": {\n                      \"raw_text\": \"or a congenital immunodeficiency\"\n                    }\n                  }\n                }\n              }\n            }\n          }\n        },\n        \"right\": {\n          \"AND\": {\n            \"left\": {\n              \"OR\": {\n                \"left\": {\n                  \"raw_text\": \"history of allergic disease or reactions likely to be exacerbated by any component of the vaccine\"\n                },\n                \"right\": {\n                  \"raw_text\": \"history of allergic disease likely to be stimulated by the vaccination\"\n                }\n              }\n            },\n            \"right\": {\n              \"AND\": {\n                \"left\": {\n                  \"OR\": {\n                    \"left\": {\n                      \"raw_text\": \"history or records of immunosuppressive therapy\"\n                    },\n                    \"right\": {\n                      \"raw_text\": \"(with the exception of topical corticosteroids) for more than 14 days and within 6 months of vaccination\"\n                    }\n                  }\n                },\n                \"right\": {\n                  