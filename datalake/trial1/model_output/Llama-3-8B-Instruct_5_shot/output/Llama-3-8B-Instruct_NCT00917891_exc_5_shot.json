"{\n  \"AND\": {\n    \"left\": {\n      \"OR\": {\n        \"left\": {\n          \"raw_text\": \"1. Currently pregnant or last pregnancy outcome within 3 months prior to enrolment\"\n        },\n        \"right\": {\n          \"OR\": {\n            \"left\": {\n              \"raw_text\": \"2. Currently breast-feeding\"\n            },\n            \"right\": {\n              \"OR\": {\n                \"left\": {\n                  \"raw_text\": \"3. Participated in any other research study within 60 days prior to screening\"\n                },\n                \"right\": {\n                  \"OR\": {\n                    \"left\": {\n                      \"raw_text\": \"4. Previously participated in any HIV vaccine study\"\n                    },\n                    \"right\": {\n                      \"AND\": {\n                        \"left\": {\n                          \"OR\": {\n                            \"left\": {\n                              \"raw_text\": \"5. Untreated urogenital infections (either symptomatic or asymptomatic) within 2 weeks prior to enrollment\"\n                            },\n                            \"right\": {\n                              \"OR\": {\n                                \"left\": {\n                                  \"raw_text\": \"6. Presence of abnormal physical finding on the vulva, vaginal walls or cervix during pelvic/speculum examination and/or colposcopy\"\n                                }\n                              }\n                            }\n                          }\n                        },\n                        \"right\": {\n                          \"AND\": {\n                            \"left\": {\n                              \"OR\": {\n                                \"left\": {\n                                  \"raw_text\": \"7. History of significant urogenital or uterine prolapse, undiagnosed vaginal bleeding, urethral obstruction\"\n                             