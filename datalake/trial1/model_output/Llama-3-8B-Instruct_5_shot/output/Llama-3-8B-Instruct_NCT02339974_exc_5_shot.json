"{\n  \"AND\": {\n    \"left\": {\n      \"AND\": {\n        \"left\": {\n          \"raw_text\": \"Heart Team assessment of operability\"\n        },\n        \"right\": {\n          \"raw_text\": \"(the heart team considers the patient to be a good surgical candidate).\"\n        }\n      }\n    },\n    \"right\": {\n      \"AND\": {\n        \"left\": {\n          \"OR\": {\n            \"left\": {\n              \"raw_text\": \"Evidence of an acute myocardial infarction\"\n            },\n            \"right\": {\n              \"raw_text\": \"= 1 month (30 days) before the intended treatment [defined as: Q wave MI, or non-Q wave MI with total CK elevation of CK-MB = twice normal in the presence of MB elevation and/or troponin level elevation (WHO definition)].\"\n            }\n          }\n        },\n        \"right\": {\n          \"AND\": {\n            \"left\": {\n              \"OR\": {\n                \"left\": {\n                  \"raw_text\": \"Untreated, severe, left sided valvular heart disease including mitral regurgitation or stenosis, and aortic regurgitation or stenosis.\"\n                }\n              }\n            },\n            \"right\": {\n              \"AND\": {\n                \"left\": {\n                  \"raw_text\": \"Mean pulmonary artery pressures =40mmHG and PVR >4 woods units as assessed by right heart catheterization.\"\n                }\n              }\n            }\n          }\n        }\n      }\n    }\n  }\n}"