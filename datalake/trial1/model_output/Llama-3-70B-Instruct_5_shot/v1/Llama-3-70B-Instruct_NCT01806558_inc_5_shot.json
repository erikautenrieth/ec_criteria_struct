"{\n  \"OR\": {\n    \"left\": {\n      \"AND\": {\n        \"left\": {\n          \"AND\": {\n            \"left\": {\n              \"raw_text\": \"Have a finding of a mass lesion on mammography or breast MRI\"\n            },\n            \"right\": {\n              \"raw_text\": \"(BIRADS 0, 4 or 5) that is >0.5 cm and < 2 cm in size\"\n            }\n          }\n        },\n        \"right\": {\n          \"raw_text\": \"and has had or will have additional workup with focused ultrasound.\"\n        }\n      }\n    },\n    \"right\": {\n      \"OR\": {\n        \"left\": {\n          \"AND\": {\n            \"left\": {\n              \"raw_text\": \"Have a finding of a mass lesion on ultrasound\"\n            },\n            \"right\": {\n              \"raw_text\": \"(BIRADS 0, 4 or 5) that is > 0.5 cm and < 2 cm in size\"\n            }\n          }\n        },\n        \"right\": {\n          \"AND\": {\n            \"left\": {\n              \"raw_text\": \"Have a positive finding on MBI that is < 2 cm in size\"\n            },\n            \"right\": {\n              \"raw_text\": \"and requires additional diagnostic workup with focused ultrasound\"\n            }\n          }\n        }\n      }\n    }\n  }\n}"