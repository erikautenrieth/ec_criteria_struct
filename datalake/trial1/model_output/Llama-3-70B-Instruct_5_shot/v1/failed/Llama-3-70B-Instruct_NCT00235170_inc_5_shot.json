"{\n  \"AND\": {\n    \"left\": {\n      \"AND\": {\n        \"left\": {\n          \"OR\": {\n            \"left\": {\n              \"raw_text\": \"Patients with stable (Canadian Cardiovascular Society 1, 2, 3 or 4)\"\n            },\n            \"right\": {\n              \"OR\": {\n                \"left\": {\n                  \"raw_text\": \"or unstable (Braunwald class IB, IC, IIB, IIC, IIIB, IIIC) angina pectoris and ischemia\"\n                },\n                \"right\": {\n                  \"OR\": {\n                    \"left\": {\n                      \"raw_text\": \"or patients with atypical chest pain\"\n                    },\n                    \"right\": {\n                      \"raw_text\": \"or even those who are asymptomatic provided they have documented myocardial ischaemia (e.g. treadmill exercise test, radionuclide scintigraphy, stress echocardiography, Holter tape)\"\n                    }\n                  }\n                }\n              }\n            }\n          }\n        },\n        \"right\": {\n          \"AND\": {\n            \"left\": {\n              \"raw_text\": \"Patients who are eligible for coronary revascularization (angioplasty or CABG)\"\n            },\n            \"right\": {\n              \"AND\": {\n                \"left\": {\n                  \"raw_text\": \"At least 2 lesions (located in different vessels and in different territories) potentially amenable to stent implantation\"\n                },\n                \"right\": {\n                  \"AND\": {\n                    \"left\": {\n                      \"raw_text\": \"de novo native vessels\"\n                    },\n                    \"right\": {\n                      \"AND\": {\n                        \"left\": {\n                          \"raw_text\": \"Multivessel disease with at least one significant stenosis in LAD and with treatment of the lesion in another major epicardial coronary artery. A two-vessel disease or a three-vessel disease may be viewed as a combination of a side branch and a main epicardial vessel provided they supply different territories; left anterior descending, left circumflex and right coronary artery)\"\n                        },\n                        \"right\": {\n                          \"AND\": {\n                            \"left\": {\n                              \"raw_text\": \"Total occluded vessels. One total occluded major epicardial vessel or side branch can be included and targeted as long as one other major vessel has a significant stenosis amenable for SA, provided the age of occlusion is less than one month e.g. recent instability, infarction with ECG changes in the area subtended by the occluded vessel\"\n                            },\n                            \"right\": {\n                              \"AND\": {\n                                \"left\": {\n                                  \"raw_text\": \"Significant stenosis has been defined as a stenosis of more than 50% in luminal diameter\"\n                                },\n                                \"right\": {\n                                  \"raw_text\": \"Left ventricular ejection fraction should be at least 30%\"\n                                }\n                              }\n                            }\n                            \"right\": {\n                              \"raw_text\": \"Left ventricular ejection fraction should be at least 30%\"\n                              }\n                            }\n                            \"right\": {\n                              \"raw_text\": \"Left ventricular ejection fraction should at least 30%\"\n                            }\n                            \"right\": {\n                              \"raw_text\": \"raw_text\": \"Left ventricular ejection fraction should                              \"raw_text\": \"Left ventricular ejection fraction\": \"raw_text\": \"Left ventricular ejection \"raw_text