g home\"\n                                                        },\n                                                        \"right\": {\n                                                          \"raw_text\": \"Significant cognitive impairment, defined as a known diagnosis of dementia or a Mini-Mental State Examination exam score < 24\"\n                                                        },\n                                                        \"right\": {\n                                                          \"raw_text\": \"Unable to communicate because of severe hearing loss or speech disorder\"\n                                                    \"right\": {\n                                                      \"raw_text\": \"Unable to participate in another clinical study\"\n                                                    \"right\": {\n                                                      \"raw_text\": \"raw_text\": \"Unable to participate in another clinical study