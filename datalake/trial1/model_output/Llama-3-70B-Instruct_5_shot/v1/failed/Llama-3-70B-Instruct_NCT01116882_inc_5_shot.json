"{\n  \"AND\": {\n    \"left\": {\n      \"raw_text\": \"Subject is at least 18 years old.\"\n    },\n    \"right\": {\n      \"AND\": {\n        \"left\": {\n          \"raw_text\": \"Subject requires single- or multi-vessel percutaneous coronary intervention (PCI) of de novo or restenotic target lesion (including in-stent restenotic lesions).\"\n        },\n        \"right\": {\n          \"AND\": {\n            \"left\": {\n              \"raw_text\": \"Subject's lesion(s) is (are) amenable to stent treatment with currently available FDA-approved bare metal or drug eluting stents.\"\n            },\n            \"right\": {\n              \"AND\": {\n                \"left\": {\n                  \"raw_text\": \"Subject is an acceptable candidate for elective, urgent or emergency coronary artery bypass graft (CABG).\"\n                },\n                \"right\": {\n                  \"AND\": {\n                    \"left\": {\n                      \"raw_text\": \"Subject has clinical evidence of ischemic heart disease in terms of a positive functional study, or documented symptoms.\"\n                    },\n                    \"right\": {\n                      \"AND\": {\n                        \"left\": {\n                          \"raw_text\": \"Documented stable angina pectoris [Canadian Cardiovascular Society Classification (CCS) 1, 2, 3, or 4], unstable angina pectoris with documented ischemia (Braunwald Class IB-C, IIB-C, or IIIB-C), non-ST segment elevation myocardial infarction, or documented silent ischemia.\"\n                        },\n                        \"right\": {\n                          \"AND\": {\n                            \"left\": {\n                              \"raw_text\": \"Subject is willing and able to undergo percutaneous intervention at SOS hospital, if randomized to SOS study arm.\"\n                            },\n                            \"right\": {\n                              \"AND\": {\n                                \"left\": {\n                                  \"raw_text\": \"Subject and the treating physician agree that the subject will comply with all follow-up evaluations.\"\n                                },\n                                \"right\": {\n                                  \"AND\": {\n                                    \"left\": {\n                                      \"raw_text\": \"Subject has been informed of the nature of the study and agrees to its provisions and has provided written informed consent as approved by the Institutional Review Board/Ethics Committee of the respective clinical site.\"\n                                    },\n                                    \"right\": {\n                                      \"AND\": {\n                                        \"left\": {\n                                          \"raw_text\": \"The target lesion(s) is (are) de novo or restenotic native coronary artery lesion(s) with greater than 50 and less than 100% stenosis (visual estimate), or the target lesion is an acute total occlusion as evidenced by clinical symptoms, or abnormal stress test.\"\n                                        },\n                                      \"right\": {\n                                        \"raw_text\": \"Target lesions(s) is (are) de novo or restenotic native coronary artery lesion(s) is (are) amenable to document\": \"raw_text\": \"The target lesion(s) is (are)\"raw_text\": \"The raw_text\": \"Target lesions(s) is (are) \"right\": \"raw_text\": \"left\": \"raw_text\": \"The raw_text\": \"raw_text\": \"\"raw_text\": \"The raw_text\": \"left\": \"raw_text\": \"raw_text\": \"left\": \"raw_text\": \"right\": \"left\": \"raw_text\": \"\"right\": \"raw_text\": \"left\": \"raw_text\": \"\"rightassistantassistant