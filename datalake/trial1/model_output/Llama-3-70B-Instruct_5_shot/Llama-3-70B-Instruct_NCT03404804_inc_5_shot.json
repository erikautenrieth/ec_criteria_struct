"{\n  \"AND\": {\n    \"left\": {\n      \"AND\": {\n        \"left\": {\n          \"raw_text\": \"Children aged 3-16\"\n        },\n        \"right\": {\n          \"AND\": {\n            \"left\": {\n              \"raw_text\": \"with a parent/guardian (hereafter termed parent) reported history of allergy to a penicillin antibiotic\"\n            },\n            \"right\": {\n              \"raw_text\": \"in which the reported allergic reaction occurred at least six months prior to the current PED visit.\"\n            }\n          }\n        }\n      }\n    },\n    \"right\": {\n      \"raw_text\": \"Only children well enough to be discharged to home at the conclusion of the PED visit are eligible.\"\n    }\n  }\n}"