"{\n  \"AND\": {\n    \"left\": {\n      \"OR\": {\n        \"left\": {\n          \"raw_text\": \"Congestive heart failure\"\n        },\n        \"right\": {\n          \"OR\": {\n            \"left\": {\n              \"raw_text\": \"history of ventricular tachycardia\"\n            },\n            \"right\": {\n              \"OR\": {\n                \"left\": {\n                  \"raw_text\": \"ventricular fibrillation\"\n                },\n                \"right\": {\n                  \"OR\": {\n                    \"left\": {\n                      \"raw_text\": \"or multifocal ventricular extrasystoles\"\n                    },\n                    \"right\": {\n                      \"raw_text\": \"or QTc prolongation\"\n                    }\n                  }\n                }\n              }\n            }\n          }\n        }\n      }\n    },\n    \"right\": {\n      \"AND\": {\n        \"left\": {\n          \"AND\": {\n            \"left\": {\n              \"raw_text\": \"Patients with atrial fibrillation\"\n            },\n            \"right\": {\n              \"raw_text\": \"taking any anticoagulant therapy\"\n            }\n          }\n        },\n        \"right\": {\n          \"OR\": {\n            \"left\": {\n              \"raw_text\": \"or patients with a history of cardioembolic ischemic stroke\"\n            },\n            \"right\": {\n              \"raw_text\": \"or hemorrhagic stroke\"\n            }\n          }\n        }\n      },\n      \"right\": {\n        \"AND\": {\n          \"left\": {\n            \"AND\": {\n              \"left\": {\n                \"raw_text\": \"Patients with a history (= 12 months) of acute coronary syndrome\"\n              },\n              \"right\": {\n                \"raw_text\": \"receiving dual antiplatelet therapy\"\n              }\n            }\n          },\n          \"right\": {\n            \"OR\": {\n              \"left\": {\n                \"raw_text\": \"or patient