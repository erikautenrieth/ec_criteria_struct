"{\n  \"AND\": {\n    \"left\": {\n      \"OR\": {\n        \"left\": {\n          \"raw_text\": \"Patients with either Relapsing-remitting MS (RRMS)\"\n        },\n        \"right\": {\n          \"OR\": {\n            \"left\": {\n              \"raw_text\": \", Secondary progressive MS (SPMS)\"\n            },\n            \"right\": {\n              \"raw_text\": \", or Primary progressive MS (PPMS) by McDonald 2010 criteria.\"\n            }\n          }\n        }\n      }\n    },\n    \"right\": {\n      \"AND\": {\n        \"left\": {\n          \"raw_text\": \"Patients defined by subtype based on 2013 updated phenotypic criteria.\"\n        },\n        \"right\": {\n          \"AND\": {\n            \"left\": {\n              \"OR\": {\n                \"left\": {\n                  \"raw_text\": \"prospectively with an EDSS change of at least 1.0 points over the last two years\"\n                },\n                \"right\": {\n                  \"raw_text\": \"or retrospectively, with any significant change in motor function over at least one year, unrelated to relapse.\"\n                }\n              }\n            },\n            \"right\": {\n              \"AND\": {\n                \"left\": {\n                  \"raw_text\": \"55 years of age or older at time of randomization;\"\n                },\n                \"right\": {\n                  \"AND\": {\n                    \"left\": {\n                      \"raw_text\": \"No evidence of recent new inflammatory disease activity (inactive by the Lublin criteria16) with no new relapse for at least five years and no new MRI lesion for at least three years\"\n                    },\n                    \"right\": {\n                      \"AND\": {\n                        \"left\": {\n                          \"OR\": {\n                            \"left\": {\n                              \"raw_text\": \"interferon ß-1a\"\n                            },\n                            \"right\": {\n                              \"OR\": {\n                                \"left\": {\n                                  \"raw_text\": \"interferon ß-1b\"\n                                },\n                                \"right\": {\n                                  \"OR\": {\n                                    \"left\": {\n                                      \"raw_text\": \"glatiramer acetate\"\n                                    },\n                                    \"right\": {\n                                      \"OR\": {\n                                        \"left\": {\n                                          \"raw_text\": \"natalizumab\"\n                                        },\n                                        \"right\": {\n                                          \"OR\": {\n                                            \"left\": {\n                                              \"raw_text\": \"fingolimod\"\n                                            },\n                                            \"right\": {\n                                              \"raw_text\": \"dimethyl fumarate, or teriflunomide\"\n                                            }\n                                          }\n                                        }\n                                      }\n                                    }\n                                  }\n                                }\n                              }\n                            }\n                          }\n                        }\n                      }\n                    }\n                  }\n                }\n              }\n            }\n          }\n        }\n      }\n    }\n  }\n}"