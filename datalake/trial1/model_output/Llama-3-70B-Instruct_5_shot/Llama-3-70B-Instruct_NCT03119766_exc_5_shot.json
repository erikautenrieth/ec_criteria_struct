"{\n  \"AND\": {\n    \"left\": {\n      \"OR\": {\n        \"left\": {\n          \"raw_text\": \"Organic diseases of the digestive system (gastro-oesophageal reflux disease (GERD), ulcer, chronic pancreatitis, cholelithiasis, fatty liver disease, hepatitis, cirrhosis of liver, etc.)\"\n        },\n        \"right\": {\n          \"OR\": {\n            \"left\": {\n              \"raw_text\": \"Diagnosis of other functional diseases of the digestive system, such as dyskinesia of cystic duct or gallbladder, irritable bowel syndrome, etc.\"\n            },\n            \"right\": {\n              \"AND\": {\n                \"left\": {\n                  \"raw_text\": \"Discontinuation of proton pump inhibitors, propulsives, antispasmodics, antacids, or bismuth preparations less than 7 days prior to randomization.\"\n                },\n                \"right\": {\n                  \"AND\": {\n                    \"left\": {\n                      \"raw_text\": \"H. Pylori eradication within 2 months before study entry.\"\n                    },\n                    \"right\": {\n                      \"AND\": {\n                        \"left\": {\n                          \"raw_text\": \"Intestinal infection within 2 months before study entry.\"\n                        },\n                        \"right\": {\n                          \"AND\": {\n                            \"left\": {\n                              \"raw_text\": \"Known history of/suspected malignant neoplasm of various sites.\"\n                            },\n                            \"right\": {\n                              \"AND\": {\n                                \"left\": {\n                                  \"raw_text\": \"Prior diagnosis of a class IV cardiovascular disease (according to the New York Heart Association, 1964), hypothyroidism, diabetes mellitus, chronic kidney disease (С3-5), or disease of liver with portal hypertension and/or severe decompensation (Child-Pugh score > 6).\"\n                                },\n                                \"right\": {\n                                  \"AND\": {\n                                    \"left\": {\n                                      \"raw_text\": \"Other severe coexisting morbidity which, in the investigator's opinion, can prevent the patient from participating in the study.\"\n                                    },\n                                    \"right\": {\n                                      \"AND\": {\n                                        \"left\": {\n                                          \"raw_text\": \"Allergy/intolerance to any of the components of medications used in the treatment.\"\n                                        },\n                                        \"right\": {\n                                          \"AND\": {\n                                            \"left\": {\n                                              \"raw_text\": \"Pregnancy, breast-feeding.\"\n                                            },\n                                            \"right\": {\n                                              \"AND\": {\n                                                \"left\": {\n                                                  \"raw_text\": \"Patients who, from investigator's point of view, will fail to comply with the observation requirements of the trial or with the dosing regimen of the investigational drugs.n                                              \"right\": {\n                                                  \"raw_text\": \"Participation in other clinical trials within 3 months to the enrollment in this study.n                                              \"right\": {\n                                              \"raw_text\": \"Plannedassistant \"raw_text\": \"Patients whoassistant \"raw_text\": \"raw_text\": \"Refusalassistant \"raw_text\": \"Discontinuation \"raw_text\": \"Patients whoassistant \"raw_text\": 