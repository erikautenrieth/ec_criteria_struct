"{\n  \"AND\": {\n    \"left\": {\n      \"AND\": {\n        \"left\": {\n          \"raw_text\": \"Between the age of 25 to 65 at baseline\"\n        },\n        \"right\": {\n          \"raw_text\": \"Be willing to participate in a smoking cessation program\"\n        }\n      }\n    },\n    \"right\": {\n      \"AND\": {\n        \"left\": {\n          \"raw_text\": \"Be willing to attend all clinic visits\"\n        },\n        \"right\": {\n          \"AND\": {\n            \"left\": {\n              \"AND\": {\n                \"left\": {\n                  \"raw_text\": \"Must be currently smoking at least ½ pack/day at baseline\"\n                },\n                \"right\": {\n                  \"raw_text\": \"(confirmed with cotinine level and CO Smokerlyzer\"\n                }\n              }\n            },\n            \"right\": {\n              \"AND\": {\n                \"left\": {\n                  \"raw_text\": \">5 pack-year history of smoking\"\n                },\n                \"right\": {\n                  \"OR\": {\n                    \"left\": {\n                      \"raw_text\": \"Global Initiative for Chronic Obstructive Lung Disease (GOLD) 0: FEV1=0.80 and FEV1/FVC>0.70 Forced Expiratory Volume in 1 second (FEV1), Forced Vital Capacity (FVC)\"\n                    },\n                    \"right\": {\n                      \"OR\": {\n                        \"left\": {\n                          \"raw_text\": \"GOLD 1: FEV1=0.80 and FEV1/FVC < 0.70\"\n                        },\n                        \"right\": {\n                          \"raw_text\": \"GOLD 2: 0.50=FEV1<0.80 and FEV1/FVC < 0.70\"\n                        }\n                      }\n                    }\n                  }\n                }\n              }\n            }\n          }\n        }\n      }\n    }\n  }\n}"