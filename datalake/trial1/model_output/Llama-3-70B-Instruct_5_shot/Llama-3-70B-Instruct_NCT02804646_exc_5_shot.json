"{\n  \"AND\": {\n    \"left\": {\n      \"OR\": {\n        \"left\": {\n          \"AND\": {\n            \"left\": {\n              \"raw_text\": \"pregnancy\"\n            },\n            \"right\": {\n              \"OR\": {\n                \"left\": {\n                  \"raw_text\": \"breast-feeding women\"\n                },\n                \"right\": {\n                  \"AND\": {\n                    \"left\": {\n                      \"raw_text\": \"female patients of childbearing potential\"\n                    },\n                    \"right\": {\n                      \"NOT\": {\n                        \"left\": {\n                          \"raw_text\": \"take contraceptive measures\"\n                        }\n                      }\n                    }\n                  }\n                }\n              }\n            }\n          }\n        },\n        \"right\": {\n          \"OR\": {\n            \"left\": {\n              \"AND\": {\n                \"left\": {\n                  \"raw_text\": \"existing severe acute infection\"\n                },\n                \"right\": {\n                  \"NOT\": {\n                    \"left\": {\n                      \"raw_text\": \"is not controlled\"\n                    }\n                  }\n                }\n              }\n            },\n            \"right\": {\n              \"OR\": {\n                \"left\": {\n                  \"raw_text\": \"purulent and chronic infection\"\n                },\n                \"right\": {\n                  \"raw_text\": \"delayed healing wounds\"\n                }\n              }\n            }\n          }\n        }\n      }\n    },\n    \"right\": {\n      \"AND\": {\n        \"left\": {\n          \"raw_text\": \"the original severe heart disease, including congestive heart failure, uncontrolled high-risk arrhythmias, unstable angina, myocardial infarction, severe heart valve disease and resistant hypertension\"\n        },\n    