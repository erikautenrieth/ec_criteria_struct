"{\n  \"AND\": {\n    \"left\": {\n      \"raw_text\": \"45 years old\"\n    },\n    \"right\": {\n      \"AND\": {\n        \"left\": {\n          \"OR\": {\n            \"left\": {\n              \"raw_text\": \"A diagnosis or previous diagnosis of essential hypertension\"\n            },\n            \"right\": {\n              \"AND\": {\n                \"left\": {\n                  \"raw_text\": \"including anyone currently taking antihypertensive drugs\"\n                },\n                \"right\": {\n                  \"NOT\": {\n                    \"left\": {\n                      \"raw_text\": \"for those who have not taken antihypertensive drugs within the last 2 weeks\"\n                    },\n                    \"right\": {\n                      \"AND\": {\n                        \"left\": {\n                          \"raw_text\": \"two consecutive examinations were conducted at least one day apart\"\n                        },\n                        \"right\": {\n                          \"AND\": {\n                            \"left\": {\n                              \"raw_text\": \"and both sitting blood pressure (mean value of 3 measurements) met the following criteria:\"\n                            },\n                            \"right\": {\n                              \"OR\": {\n                                \"left\": {\n                                  \"raw_text\": \"diastolic blood pressure (DBP) =90 mmHg\"\n                                },\n                                \"right\": {\n                                  \"raw_text\": \"or systolic blood pressure (SBP) =140 mmHg\"\n                                }\n                              }\n                            }\n                          }\n                        }\n                      }\n                    }\n                  }\n                }\n              }\n            }\n          }\n        },\n        \"right\": {\n          \"AND\": {\n 