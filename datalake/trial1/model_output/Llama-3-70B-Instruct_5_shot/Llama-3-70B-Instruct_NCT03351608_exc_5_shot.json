"{\n  \"AND\": {\n    \"left\": {\n      \"raw_text\": \"Has any clinically significant condition or situation (eg, anatomical malformation that complicates intubation) other than the condition being studied that, in the opinion of the investigator, would interfere with the trial evaluations or optimal participation in the trial.\"\n    },\n    \"right\": {\n      \"AND\": {\n        \"left\": {\n          \"raw_text\": \"Has a neuromuscular disorder that may affect NMB and/or trial assessments.\"\n        },\n        \"right\": {\n          \"AND\": {\n            \"left\": {\n              \"OR\": {\n                \"left\": {\n                  \"raw_text\": \"Is dialysis-dependent\"\n                },\n                \"right\": {\n                  \"raw_text\": \"or has (or is suspected of having) severe renal insufficiency (defined as estimated glomerular filtration rate (eGFR) <30 ml/min).\"\n                }\n              }\n            },\n            \"right\": {\n              \"AND\": {\n                \"left\": {\n                  \"OR\": {\n                    \"left\": {\n                      \"raw_text\": \"Has or is suspected of having a family or personal history of malignant hyperthermia.\"\n                    },\n                    \"right\": {\n                      \"raw_text\": \"Has or is suspected of having an allergy to study treatments or its/their excipients, to opioids/opiates, muscle relaxants or their excipients, or other medication(s) used during general anesthesia.\"\n                    }\n                  }\n                },\n                \"right\": {\n                  \"AND\": {\n                    \"left\": {\n                      \"raw_text\": \"Has received or is planned to receive toremifene and/or fusidic acid via IV administration within 24 hours before or within 24 hours after administration of study treatment.\"\n                    },\n                    \"right\": {\n                      \"AND\": {\n                        \"left\": {\n                          \"raw_text\": \"Has been previously treated with sugammadex or has participated in a sugammadex clinical trial.\"\n                        },\n                        \"right\": {\n                          \"raw_text\": \"Is currently participating in or has participated in an interventional clinical trial with an investigational compound or device within 30 days of signing the informed consent/assent for this current trial.\"\n                        }\n                      }\n                    }\n                  }\n                }\n              }\n            }\n          }\n        }\n      }\n    }\n  }\n}"