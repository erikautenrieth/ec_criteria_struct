"{\n  \"AND\": {\n    \"left\": {\n      \"raw_text\": \"Participation in another clinical trial.\"\n    },\n    \"right\": {\n      \"AND\": {\n        \"left\": {\n          \"OR\": {\n            \"left\": {\n              \"raw_text\": \"Known or suspected (or history of) malignancy\"\n            },\n            \"right\": {\n              \"raw_text\": \"or chronic illness.\"\n            }\n          }\n        },\n        \"right\": {\n          \"AND\": {\n            \"left\": {\n              \"raw_text\": \"Serious organic or mental disease diagnosed by a psychiatrist (e.g., major depression currently treated with antidepressant medication) suspected on the basis of the medical history and/or clinical examination.\"\n            },\n            \"right\": {\n              \"AND\": {\n                \"left\": {\n                  \"raw_text\": \"Conditions that may affect the compliance to the study.\"\n                },\n                \"right\": {\n                  \"raw_text\": \"Contraindications to therapy with the study drug or hypersensitivity to the study drug (active ingredient or excipients of the formulation).\"\n                }\n              }\n            }\n          }\n        }\n      }\n    }\n  }\n}"