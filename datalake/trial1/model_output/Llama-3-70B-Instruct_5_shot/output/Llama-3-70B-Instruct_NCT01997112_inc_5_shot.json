"{\n  \"AND\": {\n    \"left\": {\n      \"AND\": {\n        \"left\": {\n          \"raw_text\": \"=18 years old\"\n        },\n        \"right\": {\n          \"OR\": {\n            \"left\": {\n              \"raw_text\": \"men\"\n            },\n            \"right\": {\n              \"AND\": {\n                \"left\": {\n                  \"raw_text\": \"post-menopausal women\"\n                },\n                \"right\": {\n                  \"OR\": {\n                    \"left\": {\n                      \"raw_text\": \"women with no periods for 12 months or more\"\n                    },\n                    \"right\": {\n                      \"raw_text\": \"or those who have had a surgical menopause\"\n                    }\n                  }\n                }\n              }\n            }\n          }\n        }\n      }\n    },\n    \"right\": {\n      \"AND\": {\n        \"left\": {\n          \"OR\": {\n            \"left\": {\n              \"raw_text\": \"Treated hypertensive patients with an average daytime ambulatory blood pressure measurement (ABPM) <150/95mmHg\"\n            },\n            \"right\": {\n              \"raw_text\": \"on stable doses of one or more antihypertensive medication (at least one of which should be; an ACE inhibitor, angiotensin receptor blocker or diuretic) for 3 months\"\n            }\n          }\n        },\n        \"right\": {\n          \"OR\": {\n            \"left\": {\n              \"raw_text\": \"or untreated hypertensive patients with an average daytime ABPM =135/85\"\n            },\n            \"right\": {\n              \"raw_text\": \"but <150/95.\"\n            }\n          }\n        }\n      }\n    }\n  }\n}"