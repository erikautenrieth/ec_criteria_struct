"{\n  \"AND\": {\n    \"left\": {\n      \"AND\": {\n        \"left\": {\n          \"raw_text\": \"Male and female subjects must be 18 years of age or older\"\n        },\n        \"right\": {\n          \"raw_text\": \"and ambulatory.\"\n        }\n      }\n    },\n    \"right\": {\n      \"AND\": {\n        \"left\": {\n          \"AND\": {\n            \"left\": {\n              \"raw_text\": \"Females of child-bearing potential (FOCP)\"\n            },\n            \"right\": {\n              \"raw_text\": \"must have a negative serum beta human chorionic gonadotropin (HCG) pregnancy test.\"\n            }\n          }\n        },\n        \"right\": {\n          \"AND\": {\n            \"left\": {\n              \"raw_text\": \"A documented history of severe Symptomatic Orthostatic Hypotension (SOH)\"\n            },\n            \"right\": {\n              \"AND\": {\n                \"left\": {\n                  \"raw_text\": \"that, in the judgment of the treating physician, has required treatment with midodrine HCl\"\n                },\n                \"right\": {\n                  \"raw_text\": \"and has been at a stable dose for at least 3 months.\"\n                }\n              }\n            }\n          }\n        }\n      }\n    }\n  },\n  \"right\": {\n    \"OR\": {\n      \"left\": {\n        \"raw_text\": \"dizziness\"\n      },\n      \"right\": {\n        \"OR\": {\n          \"left\": {\n            \"raw_text\": \"lightheadedness\"\n          },\n          \"right\": {\n            \"OR\": {\n              \"left\": {\n                \"raw_text\": \"feeling faint\"\n              },\n              \"right\": {\n                \"raw_text\": \"or feeling like they might black out.\"\n              }\n            }\n          }\n        }\n      }\n    }\n  }\n}"