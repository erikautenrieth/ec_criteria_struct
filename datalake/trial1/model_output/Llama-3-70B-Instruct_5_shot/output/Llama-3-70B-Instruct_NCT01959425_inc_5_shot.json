"{\n  \"AND\": {\n    \"left\": {\n      \"raw_text\": \"Successful cardiac ablation for AF\"\n    },\n    \"right\": {\n      \"AND\": {\n        \"left\": {\n          \"raw_text\": \"Documented freedom from AF recurrence (symptomatic or asymptomatic arrhythmic recurrences lasting longer than 30 seconds) 3 months after successful cardiac ablation (AF recurrence during 3-month blanking period is excluded).\"\n        },\n        \"right\": {\n          \"AND\": {\n            \"left\": {\n              \"raw_text\": \"Patient must have been on a commercially approved anticoagulation therapy for at least two (2) months prior to randomization in the OAT Study.\"\n            },\n            \"right\": {\n              \"AND\": {\n                \"left\": {\n                  \"OR\": {\n                    \"left\": {\n                      \"raw_text\": \"CHADS2 score = 2\"\n                    },\n                    \"right\": {\n                      \"raw_text\": \"CHA2DS2-VASc score = 3\"\n                    }\n                  }\n                },\n                \"right\": {\n                  \"AND\": {\n                    \"left\": {\n                      \"raw_text\": \"Left ventricular ejection fraction > 25%\"\n                    },\n                    \"right\": {\n                      \"AND\": {\n                        \"left\": {\n                          \"raw_text\": \"LA size < 65\"\n                        },\n                        \"right\": {\n                          \"AND\": {\n                            \"left\": {\n                              \"raw_text\": \"High risk for thromboembolic events (i.e., CHADS2 score = 2 or CHA2DS2-VASc score = 3) and require OAT before undergoing cardiac ablation\"\n                            },\n                            \"right\": {\n                              \"AND\": {\n                                \"left\": {\n                                  \"raw_text\": \"Able and willing to comply with all pre- and follow-up testing and requirements\"\n                                },\n                                \"right\": {\n                                  \"AND\": {\n                                    \"left\": {\n                                      \"raw_text\": \"Signed informed consent form\"\n                                    },\n                                    \"right\": {\n                                      \"raw_text\": \"Age 18 years or older\"\n                                    }\n                                  }\n                                }\n                              }\n                            }\n                          }\n                        }\n                      }\n                    }\n                  }\n                }\n              }\n            }\n          }\n        }\n      }\n    }\n  }\n}"