"{\n  \"AND\": {\n    \"left\": {\n      \"OR\": {\n        \"left\": {\n          \"raw_text\": \"Diagnosis of primary immunodeficiency with established plan to undergo myeloablative or non-myeloablative allogeneic hematopoietic stem cell transplant for treatment thereof\"\n        },\n        \"right\": {\n          \"raw_text\": \"or diagnosis of a form of primary immunodeficiency for which hematopoietic stem cell transplantation is not indicated.\"\n        }\n      }\n    },\n    \"right\": {\n      \"AND\": {\n        \"left\": {\n          \"NOT\": {\n            \"left\": {\n              \"raw_text\": \"Active infection with EBV, CMV, and/or Adenovirus, unable to be successfully controlled with standard therapy.\"\n            }\n          }\n        },\n        \"right\": {\n          \"AND\": {\n            \"left\": {\n              \"raw_text\": \"Steroids less than 0.5 mg/kg/day prednisone\"\n            },\n            \"right\": {\n              \"AND\": {\n                \"left\": {\n                  \"raw_text\": \"Karnofsky/Lansky score of ≥ 50\"\n                },\n                \"right\": {\n                  \"AND\": {\n                    \"left\": {\n                      \"raw_text\": \"ANC greater than 500/µL.\"\n                    },\n                    \"right\": {\n                      \"AND\": {\n                        \"left\": {\n                          \"raw_text\": \"Bilirubin <2x, AST <3x, Serum creatinine <2x upper limit of normal, Hgb >8.0\"\n                        },\n                        \"right\": {\n                          \"AND\": {\n                            \"left\": {\n                              \"raw_text\": \"Pulse oximetry of > 90% on room air\"\n                            },\n                            \"right\": {\n                              \"AND\": {\n                                \"left\": {\n                                  \"raw_text\": \"Negative pregnancy test (if female of childbearing potential)\"\n                                },\n                                \"right\": {\n                                  \"raw_text\": \"Patient or parent/guardian capable of providing informed consent.\"\n                                }\n                              }\n                            }\n                          }\n                        }\n                      }\n                    }\n                  }\n                }\n              }\n            }\n          }\n        }\n      }\n    }\n  }\n}"