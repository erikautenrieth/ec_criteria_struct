"{\n  \"AND\": {\n    \"left\": {\n      \"AND\": {\n        \"left\": {\n          \"OR\": {\n            \"left\": {\n              \"raw_text\": \"Healthy male\"\n            },\n            \"right\": {\n              \"raw_text\": \"or female adolescents\"\n            }\n          }\n        },\n        \"right\": {\n          \"AND\": {\n            \"left\": {\n              \"raw_text\": \"age 12 to 17 years (inclusive) at Screening\"\n            },\n            \"right\": {\n              \"AND\": {\n                \"left\": {\n                  \"raw_text\": \"with a body mass index (BMI) that is greater than or equal to the United States-weighted mean of the 95th percentile based on age and sex\"\n                },\n                \"right\": {\n                  \"raw_text\": \"with a body weight greater than 60 kilograms (kg)\"\n                }\n              }\n            }\n          }\n        }\n      }\n    },\n    \"right\": {\n      \"AND\": {\n        \"left\": {\n          \"OR\": {\n            \"left\": {\n              \"raw_text\": \"Participants with Type 2 diabetes mellitus (T2DM) may have a pre-existing\"\n            },\n            \"right\": {\n              \"raw_text\": \"or new diagnosis of T2DM\"\n            }\n          }\n        },\n        \"right\": {\n          \"AND\": {\n            \"left\": {\n              \"AND\": {\n                \"left\": {\n                  \"raw_text\": \"HbA1c =6.5%\"\n                },\n                \"right\": {\n                  \"raw_text\": \"fasting plasma glucose (FPG) =126 mg/dL (7.0 mmol/L)\"\n                }\n              }\n            },\n            \"right\": {\n              \"AND\": {\n                \"left\": {\n                  \"raw_text\": \"Participants and their families not planning to move away from the area for the duration of the study\"\n                },\n                \"right\": {\n                  \"AND\": {\n                    \"left\": {\n                      \"raw_text\": \"Participants able and willing to comply with all aspects of the study, including a standardized, reduced calorie diet and an age appropriate, increased physical activity program\"\n                    },\n                    \"right\": {\n                      \"AND\": {\n                        \"left\": {\n                          \"raw_text\": \"Participants considered in stable health in the opinion of the investigator\"\n                        },\n                        \"right\": {\n                          \"AND\": {\n                            \"left\": {\n                              \"raw_text\": \"Able and willing to support and supervise study participation in the opinion of the investigator, including consideration of any existing physical, medical, or mental condition that prevents compliance with the protocol\"\n                            },\n                            \"right\": {\n                              \"raw_text\": \"Able and willing to personally comply with and execute all aspects of the study requirements for the caregivers or guardians\"\n                            }\n                          }\n                        }\n                      }\n                    }\n                  }\n                }\n              }\n            }\n          }\n        }\n      }\n    }\n  }\n}"