{
  "AND": {
    "left": {
      "AND": {
        "left": {
          "OR": {
            "left": {
              "raw_text": "Men"
            },
            "right": {
              "raw_text": "and women"
            }
          }
        },
        "right": {
          "AND": {
            "left": {
              "raw_text": "older than 18 years"
            },
            "right": {
              "AND": {
                "left": {
                  "raw_text": "scheduled consecutively to perform a coronary procedure in the department of hemodynamics of the National Institute of Cardiology "Ignacio Chavez""
                }
              }
            }
          }
        }
      }
    },
    "right": {
      "AND": {
        "left": {
          "OR": {
            "left": {
              "raw_text": "Patients may have any of the following indications for cardiac catheterization:"
            },
            "right": {
              "AND": {
                "left": {
                  "OR": {
                    "left": {
                      "raw_text": "Thoracic pain under study."
                    },
                    "right": {
                      "OR": {
                        "left": {
                          "raw_text": "Stable chronic coronary disease."
                        },
                        "right": {
                          "OR": {
                            "left": {
                              "raw_text": "Acute myocardial infarction with ST segment elevation, not perfused (without timely reperfusion therapy) with less than 4 weeks of evolution."
                            },
                            "right": {
                              "OR": {
                                "left": {
                                  "raw_text": "Acute myocardial infarction with ST-segment elevation, successful thrombolytic therapy, which will undergo drug-invasive therapy."
                                },
                                "right": {
                                  "OR": {
                                    "left": {
                                      "raw_text": "Acute myocardial infarction without ST segment elevation."
                                    },
                                    "right": {
                                      "OR": {
                                        "left": {
                                          "raw_text": "Unstable angina."
                                        },
                                        "right": {
                                          "OR": {
                                            "left": {
                                              "raw_text": "Any acute coronary syndrome, to intervene non-infarct-related artery."
                                            }
                                          }
                                        }
                                      }
                                    }
                                  }
                                }
                              }
                            }
                          }
                        }
                      }
                    }
                  }
                },
                "right": {
                  "OR": {
                    "left": {
                      "raw_text": "Disease of any heart valve."
                    },
                    "right": {
                      "OR": {
                        "left": {
                          "raw_text": "Myocarditis or pericarditis."
                        },
                        "right": {
                          "OR": {
                            "left": {
                              "raw_text": "Dilated cardiomyopathy."
                            },
                            "right": {
                              "OR": {
                                "left": {
                                  "raw_text": "Patients in renal or cardiac transplantation protocol for any etiology."
                                },
                                "right": {
                                  "OR": {
                                    "left": {
                                      "raw_text": "Congenital heart disease that requires knowing the coronary anatomy prior to surgical correction."
                                    }
                                  }
                                }
                              }
                            }
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "right": {
      "AND": {
        "left": {
          "OR": {
            "left": {
              "raw_text": "The planned procedure can be any of the following:"
            },
            "right": {
              "AND": {
                "left": {
                  "OR": {
                    "left": {
                      "raw_text": "For diagnostic purposes (coronary angiography only, left catheterization, left and right catheterization)."
                    },
                    "right": {
                      "OR": {
                        "left": {
                          "raw_text": "For therapeutic purposes: percutaneous coronary intervention (PCI), with or without stent placement."
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "right": {
          "AND": {
            "left": {
              "raw_text": "A priori access must be right or left radial artery."
            },
            "right": {
              "AND": {
                "left": {
                  "OR": {
                    "left": {
                      "raw_text": "Radial arterial pulse may be present or absent by palpation."
                    }
                  }
                },
                "right": {
                  "AND": {
                    "left": {
                      "raw_text": "Modified Allen or Barbeau test should be positive (presence of collateral palmar flow)."
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}