"{\n  \"AND\": {\n    \"left\": {\n      \"OR\": {\n        \"left\": {\n          \"raw_text\": \"Richter's syndrome\"\n        },\n        \"right\": {\n          \"OR\": {\n            \"left\": {\n              \"raw_text\": \"Burkitt's lymphoma\"\n            },\n            \"right\": {\n              \"raw_text\": \"or Burkitt-like Lymphoma (transformed DLBCL from Follicular NHL are eligible).\"\n            }\n          }\n        }\n      }\n    },\n    \"right\": {\n      \"AND\": {\n        \"left\": {\n          \"NOT\": {\n            \"left\": {\n              \"OR\": {\n                \"left\": {\n                  \"raw_text\": \"Prior transplant with stem cell infusion 90 days or active graft-versus-host treatment within 8 weeks of Day 1.\"\n                },\n                \"right\": {\n                  \"raw_text\": \"or Prior therapy with SYK inhibitors.\"\n                }\n              }\n            }\n          }\n        },\n        \"right\": {\n          \"AND\": {\n            \"left\": {\n              \"OR\": {\n                \"left\": {\n                  \"raw_text\": \"Chronic treatment with strong CYP3A4 inhibitor/ inducer, acid reducing agent, Proton pump inhibitors\"\n                },\n                \"right\": {\n                  \"OR\": {\n                    \"left\": {\n                      \"raw_text\": \"Known lymphomatous involvement of the CNS.\"\n                    },\n                    \"right\": {\n                      \"raw_text\": \"Persistent, unresolved NCI CTCAE v4.0 ≥ Grade 2, previous drug-related toxicity (except alopecia, erectile impotence, hot flashes, libido, neuropathy).\"\n                    }\n                  }\n                }\n              }\n            },\n            \"right\": {\n              \"AND\": {\n                \"left\": {\n                  \"OR\": {\n                    \"left\": {\n                      \"raw_text\": \"Prior monoclonal antibody, radioimmunoconjugate, antibody drug conjugate, phototherapy, radiotherapy, chemotherapy, immunotherapy, immunosuppressive therapy, or any test agent within 3 weeks or for alemtuzumab 8 weeks of Day 1.\"\n                    },\n                    \"right\": {\n                      \"raw_text\": \"or For CTCL: (TSEBT) within 12 weeks, or initiation of topical steroid, nitrogen mustard, or topical retinoid within 2 weeks. (Stable topical ≥ 4 weeks prior to Day 1 allowed).\"\n                    }\n                  }\n                },\n                \"right\": {\n                  \"AND\": {\n                    \"left\": {\n                      \"OR\": {\n                        \"left\": {\n                          \"raw_text\": \"Known carrier or infection for HIV/Hep B or C.\"\n                        },\n                        \"right\": {\n                          \"OR\": {\n                            \"left\": {\n                              \"raw_text\": \"HCV ab+ must be PCR-.\"\n                            },\n                            \"right\": {\n                              \"OR\": {\n                                \"left\": {\n                                  \"raw_text\": \"HBV ab+ must be HBsAg- or undetectable DNA\"\n                                }\n                              }\n                            }\n                          }\n                        }\n                      },\n                      \"right\": {\n                        \"OR\": {\n                          \"left\": {\n                            \"raw_text\": \"Active infection requiring systemic treatment,\"\n                          },\n                          \"right\": {\n                            \"OR\": {\n                              \"left\": {\n                                \"raw_text\": \"Significant GI disease, previous major gastric/bowel surgery, difficulty swallowing or malabsorption syndrome.\"\n                              },\n              