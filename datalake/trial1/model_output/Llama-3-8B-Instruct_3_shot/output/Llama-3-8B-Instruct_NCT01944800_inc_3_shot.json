"{\n  \"AND\": {\n    \"left\": {\n      \"OR\": {\n        \"left\": {\n          \"raw_text\": \"intolerance of or allergy to ticagrelor or prasugrel\"\n        }\n      }\n    },\n    \"right\": {\n      \"AND\": {\n        \"left\": {\n          \"OR\": {\n            \"left\": {\n              \"raw_text\": \"history of any stroke\"\n            },\n            \"right\": {\n              \"OR\": {\n                \"left\": {\n                  \"raw_text\": \"or transient ischemic attack\"\n                },\n                \"right\": {\n                  \"raw_text\": \"or intracranial bleeding\"\n                }\n              }\n            }\n          }\n        },\n        \"right\": {\n          \"AND\": {\n            \"left\": {\n              \"OR\": {\n                \"left\": {\n                  \"raw_text\": \"known intracranial neoplasm\"\n                },\n                \"right\": {\n                  \"OR\": {\n                    \"left\": {\n                      \"raw_text\": \"or intracranial arteriovenous malformation\"\n                    },\n                    \"right\": {\n                      \"raw_text\": \"or intracranial aneurysm\"\n                    }\n                  }\n                }\n              }\n            },\n            \"right\": {\n              \"AND\": {\n                \"left\": {\n                  \"OR\": {\n                    \"left\": {\n                      \"raw_text\": \"active bleeding\"\n                    },\n                    \"right\": {\n                      \"raw_text\": \"or clinical findings that in the judgement of the investigator are associated with an increased risk of bleeding\"\n                    }\n                  }\n                }\n              }\n            }\n          }\n        }\n      }\n    }\n  }\n}"