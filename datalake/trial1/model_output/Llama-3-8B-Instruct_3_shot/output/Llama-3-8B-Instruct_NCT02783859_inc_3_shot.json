"{\n  \"AND\": {\n    \"left\": {\n      \"AND\": {\n        \"left\": {\n          \"raw_text\": \"Hospitalised children\"\n        },\n        \"right\": {\n          \"AND\": {\n            \"left\": {\n              \"AND\": {\n                \"left\": {\n                  \"raw_text\": \"aged 3-mo to 5-yrs\"\n                },\n                \"right\": {\n                  \"OR\": {\n                    \"left\": {\n                      \"raw_text\": \"(in Darwin, children have to be Indigenous)\"\n                    }\n                  }\n                }\n              }\n            }\n          }\n        }\n      },\n      \"right\": {\n        \"AND\": {\n          \"left\": {\n            \"AND\": {\n              \"left\": {\n                \"raw_text\": \"Have features of severe pneumonia on admission\"\n              },\n              \"right\": {\n                \"AND\": {\n                  \"left\": {\n                    \"OR\": {\n                      \"left\": {\n                        \"raw_text\": \"temperature >37.5 celsius\"\n                      },\n                      \"right\": {\n                        \"OR\": {\n                          \"left\": {\n                            \"raw_text\": \"or a history of fever at home\"\n                          },\n                          \"right\": {\n                            \"OR\": {\n                              \"left\": {\n                                \"raw_text\": \"or observed at the referring clinic\"\n                              }\n                            }\n                          }\n                        }\n                      }\n                    },\n                    \"right\": {\n                      \"AND\": {\n                        \"left\": {\n                          \"raw_text\": \"age-adjusted tachypnoea\"\n                        },\n                        \"right\": {\n                          \"OR\": {\n                       