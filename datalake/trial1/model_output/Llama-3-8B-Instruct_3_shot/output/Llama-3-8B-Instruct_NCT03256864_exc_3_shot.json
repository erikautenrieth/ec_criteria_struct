"{\n  \"AND\": {\n    \"left\": {\n      \"OR\": {\n        \"left\": {\n          \"raw_text\": \"Patients who are recipients of multiple solid organ or islet cell tissue transplants\"\n        },\n        \"right\": {\n          \"raw_text\": \"or have previously received an organ or tissue transplant.\"\n        }\n      },\n      \"right\": {\n        \"OR\": {\n          \"left\": {\n            \"raw_text\": \"Patients who have a combined liver-kidney transplant.\"\n          }\n        }\n      }\n    }\n  },\n  \"AND\": {\n    \"left\": {\n      \"raw_text\": \"History of malignancy of any organ system (other than localized basal cell carcinoma of the skin), treated or untreated, within the past 5 years, regardless of whether there is evidence of local recurrence or metastases.\"\n    }\n  },\n  \"AND\": {\n    \"left\": {\n      \"raw_text\": \"Existence of any surgical, medical or mental conditions, other than the current transplantation, which, in the opinion of the investigator, might interfere with the objectives of the study.\"\n    }\n  },\n  \"AND\": {\n    \"left\": {\n      \"OR\": {\n        \"left\": {\n          \"raw_text\": \"Pregnant\"\n        },\n        \"right\": {\n          \"raw_text\": \"or nursing (lactating) women.\"\n        }\n      }\n    }\n  }\n}"