"{\n  \"AND\": {\n    \"left\": {\n      \"OR\": {\n        \"left\": {\n          \"raw_text\": \"Presence of a significant medical or psychiatric condition\"\n        },\n        \"right\": {\n          \"OR\": {\n            \"left\": {\n              \"raw_text\": \"(Examples include: Diagnosis and treatment of tuberculosis (TB) or HIV; renal insufficiency; hepatic disease; oral or parenteral medication known to affect the immune function, such as corticosteroids, other immunosuppressant drugs; or behavioural or memory issues)\"\n            }\n          }\n        }\n      }\n    },\n    \"right\": {\n      \"AND\": {\n        \"left\": {\n          \"NOT\": {\n            \"left\": {\n              \"raw_text\": \"Ever having received oral cholera vaccine.\"\n            }\n          }\n        },\n        \"right\": {\n          \"AND\": {\n            \"left\": {\n              \"raw_text\": \"Receipt of an investigational product (within 30 days before vaccination).\"\n            },\n            \"right\": {\n              \"AND\": {\n                \"left\": {\n                  \"OR\": {\n                    \"left\": {\n                      \"raw_text\": \"History of diarrhoea in 7 days prior to first dose of vaccine\"\n                    },\n                    \"right\": {\n                      \"raw_text\": \"(defined as =3 unformed loose stools in 24 hours).\"\n                    }\n                  }\n                },\n                \"right\": {\n                  \"OR\": {\n                    \"left\": {\n                      \"raw_text\": \"History of chronic diarrhea (lasting for more than 2 weeks in the past 6 months)\"\n                    }\n                  }\n                }\n              }\n            }\n          }\n        }\n      }\n    }\n  }\n}"