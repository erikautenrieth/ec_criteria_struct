"{\n  \"AND\": {\n    \"left\": {\n      \"OR\": {\n        \"left\": {\n          \"raw_text\": \"Men\"\n        },\n        \"right\": {\n          \"raw_text\": \"or women\"\n        }\n      },\n      \"right\": {\n        \"AND\": {\n          \"left\": {\n            \"raw_text\": \"aged 18 years or older\"\n          }\n        }\n      }\n    },\n    \"right\": {\n      \"AND\": {\n        \"left\": {\n          \"AND\": {\n            \"left\": {\n              \"raw_text\": \"Patients presenting for CMR\"\n            },\n            \"right\": {\n              \"OR\": {\n                \"left\": {\n                  \"raw_text\": \"with the clinical diagnosis of hypertrophic cardiomyopathy\"\n                },\n                \"right\": {\n                  \"AND\": {\n                    \"left\": {\n                      \"raw_text\": \"based on left ventricular wall thickness of at least\"\n                    },\n                    \"right\": {\n                      \"raw_text\": \"=15 mm in the absence of any other cardiac or systemic cause of hypertrophy\"\n                    }\n                  }\n                }\n              }\n            }\n          },\n          \"right\": {\n            \"AND\": {\n              \"left\": {\n                \"AND\": {\n                  \"left\": {\n                    \"raw_text\": \"Patients presenting for CMR\"\n                    },\n                    \"right\": {\n                      \"OR\": {\n                        \"left\": {\n                          \"raw_text\": \"with the clinical diagnosis of idiopathic dilated cardiomyopathy\"\n                        },\n                        \"right\": {\n                          \"AND\": {\n                            \"left\": {\n                              \"raw_text\": \"based upon left ventricular ejection fraction\"\n                            },\n                            \"right\": {\n                              \"raw_text\"