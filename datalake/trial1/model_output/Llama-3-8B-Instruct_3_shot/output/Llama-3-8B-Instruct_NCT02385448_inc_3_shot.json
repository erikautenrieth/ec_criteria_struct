"{\n  \"AND\": {\n    \"left\": {\n      \"AND\": {\n        \"left\": {\n          \"raw_text\": \"Good general health\"\n        },\n        \"right\": {\n          \"AND\": {\n            \"left\": {\n              \"raw_text\": \"Older than the age of legal consent\"\n            },\n            \"right\": {\n              \"raw_text\": \"(i.e. 18 years old)\"\n            }\n          }\n        }\n      }\n    },\n    \"right\": {\n      \"AND\": {\n        \"left\": {\n          \"AND\": {\n            \"left\": {\n              \"raw_text\": \"Sonographic diagnosis of ovarian endometrioma\"\n            },\n            \"right\": {\n              \"AND\": {\n                \"left\": {\n                  \"raw_text\": \"with diameter at least 4cm\"\n                },\n                \"right\": {\n                  \"AND\": {\n                    \"left\": {\n                      \"raw_text\": \"on 2 separate scans\"\n                    },\n                    \"right\": {\n                      \"raw_text\": \"at least 6 weeks apart\"\n                    }\n                  }\n                }\n              }\n            }\n          },\n          \"right\": {\n            \"AND\": {\n              \"left\": {\n                \"NOT\": {\n                  \"left\": {\n                    \"OR\": {\n                      \"left\": {\n                        \"raw_text\": \"contraindication to use of progesterone\"\n                      },\n                      \"right\": {\n                        \"raw_text\": \"or combined oral contraceptive pills\"\n                      }\n                    }\n                  }\n                }\n              },\n              \"right\": {\n                \"AND\": {\n                  \"left\": {\n                    \"NOT\": {\n                      \"left\": {\n                        \"OR\": {\n                          \"left\": {\n                            \"raw_text\": \"attempting to conceive\"