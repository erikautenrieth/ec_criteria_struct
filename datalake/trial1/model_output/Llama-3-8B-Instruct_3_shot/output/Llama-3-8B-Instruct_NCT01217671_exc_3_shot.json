"{\n  \"OR\": {\n    \"left\": {\n      \"AND\": {\n        \"left\": {\n          \"raw_text\": \"FEV1 >= 80%\"\n        },\n        \"right\": {\n          \"raw_text\": \"or FEV1 < 20% of predicted value post-bronchodilator.\"\n        }\n      }\n    },\n    \"right\": {\n      \"AND\": {\n        \"left\": {\n          \"raw_text\": \"FEV1/SVC>=70%\"\n        }\n      }\n    }\n  },\n  \"AND\": {\n    \"left\": {\n      \"OR\": {\n        \"left\": {\n          \"raw_text\": \"History of lung transplant.\"\n        },\n        \"right\": {\n          \"OR\": {\n            \"left\": {\n              \"raw_text\": \"Any lung surgery within the past two years.\"\n            },\n            \"right\": {\n              \"raw_text\": \"On any thoracic surgery waiting list.\"\n            }\n          }\n        }\n      }\n    },\n    \"right\": {\n      \"AND\": {\n        \"left\": {\n          \"raw_text\": \"End of last exacerbation less than 6 weeks prior to screening/re-screening visit.\"\n        },\n        \"right\": {\n          \"OR\": {\n            \"left\": {\n              \"raw_text\": \"Clinically significant intercurrent illnesses (except for respiratory or liver disease secondary to AAT deficiency), including:\"\n            },\n            \"right\": {\n              \"OR\": {\n                \"left\": {\n                  \"raw_text\": \"cardiac, hepatic, renal, endocrine, neurological, hematological, neoplastic, immunological, skeletal or other) that in the opinion of the investigator, could interfere with the safety, compliance or other aspects of this study.\"\n                },\n                \"right\": {\n                  \"raw_text\": \"Patients with well-controlled, chronic diseases could possibly be included after consultation with the treating physician and the sponsor.\"\n                }\n              }\n            }\n          }\n        }\n      }\n    }\n  },\n  \"OR\": {\n    \"left\": {\n      \"AND\": {\n        \"left\": {\n          \"raw_text\": \"Active smoking during the last 12 months from screening date.\"\n        },\n        \"right\": {\n          \"OR\": {\n            \"left\": {\n              \"raw_text\": \"Pregnancy or lactation.\"\n            },\n            \"right\": {\n              \"OR\": {\n                \"left\": {\n                  \"raw_text\": \"Woman of child-bearing potential not taking adequate contraception deemed reliable by the investigator.\"\n                },\n                \"right\": {\n                  \"raw_text\": \"Presence of psychiatric/ mental disorder or any other medical disorder which might impair the patient's ability to give informed consent or to comply with the requirements of the study protocol.\"\n                }\n              }\n            }\n          }\n        }\n      }\n    },\n    \"right\": {\n      \"AND\": {\n        \"left\": {\n          \"raw_text\": \"Evidence of ongoing viral infection with HCV, HBV and/or HIV.\"\n        },\n        \"right\": {\n          \"OR\": {\n            \"left\": {\n              \"raw_text\": \"Evidence of alcohol abuse or history of alcohol abuse or illegal and/or legally prescribed drugs.\"\n            },\n            \"right\": {\n              \"OR\": {\n                \"left\": {\n                  \"raw_text\": \"IgA Deficiency\"\n                },\n                \"right\": {\n                  \"raw_text\": \"History of life threatening allergy, anaphylactic reaction, or systemic response to human plasma derived products.\"\n                }\n              }\n            }\n          }\n        }\n      }\n    }\n  },\n  \"AND\": {\n    \"left\": {\n      \"raw_text\": \"Participation in another clinical trial within 30 days prior to baseline visit.\"\n    },\n    \"right\": {\n      \"OR\": {\n        \"left\": {\n          \"raw_text\": \"Inability to attend scheduled clinic visits and/or comply with the study protocol.\"\n        },\n        \"right\": {\n          \"raw_text\": \"Any other factor that, in the opinion of the investigator, would prevent the patient from complying with the requirements of the protocol.\"\n        }\n      }\n    }\n  }\n}"