"{\n  \"AND\": {\n    \"left\": {\n      \"AND\": {\n        \"left\": {\n          \"AND\": {\n            \"left\": {\n              \"raw_text\": \"Subjects must:\"\n            },\n            \"right\": {\n              \"AND\": {\n                \"left\": {\n                  \"raw_text\": \"1. Be able to give valid informed consent\"\n                },\n                \"right\": {\n                  \"AND\": {\n                    \"left\": {\n                      \"raw_text\": \"2. Be 18-55 years of age.\"\n                    },\n                    \"right\": {\n                      \"AND\": {\n                        \"left\": {\n                          \"raw_text\": \"Justification: Many neural processes change with age, and these changes could introduce unwanted variability in both behavioral and MRI signals. In addition, the risk of difficult-to-detect medical abnormalities such as silent cerebral infarcts increases with age.\"\n                        },\n                        \"right\": {\n                          \"AND\": {\n                            \"left\": {\n                              \"raw_text\": \"Screening tool: History. Government-issued forms of identification (e.g. driver s license, birth certificate) will be required when participant appears to be out of age range.\"\n                            }\n                          }\n                        }\n                      }\n                    }\n                  }\n                }\n              }\n            }\n          }\n        },\n        \"right\": {\n          \"AND\": {\n            \"left\": {\n              \"AND\": {\n                \"left\": {\n                  \"raw_text\": \"3. Be in good health.\"\n                },\n                \"right\": {\n                  \"AND\": {\n                    \"left\": {\n                      \"raw_text\": \"Justification: Many illnesses may alter neural functioning as well as fMRI signals.\"\n                    },\n                    \"right\": {\n                      \"AND\": {\n                        \"left\": {\n                          \"raw_text\": \"Screening tools: Medical Assessment, Medical History and Physical Examination.\"\n                        },\n                        \"right\": {\n                          \"AND\": {\n                            \"left\": {\n                              \"raw_text\": \"Medical assessments include: Vital Signs, EKG, oral HIV test, height/weight measurements, urinalysis and blood sample.\"\n                            },\n                            \"right\": {\n                              \"AND\": {\n                                \"left\": {\n                                  \"raw_text\": \"Tests on the blood sample include CBC, complete metabolic profile, TSH, ESR, STS and HIV (if needed to confirm a positive salivary test for HIV).\"\n                                },\n                                \"right\": {\n                                  \"AND\": {\n                                    \"left\": {\n                                      \"raw_text\": \"The following individual laboratory results will independently disqualify individuals: Cholesterol >250 mg/dl, Hemoglobin < 10.5 g/dl, WBC < 2400/microl, LFTs > 3Xnormal, HCG positive, Casual serum glucose > 200 mg/dl, Urine protein > 1+.\"\n                                    },\n                                    \"right\": {\n                                      \"AND\": {\n                                        \"left\": {\n                                          \"raw_text\": \"The MAI will retain discretion to exclude at less extreme values, depending on the clinical presentation.\"\n                                        },\n                                        \"right\": {\n                                          \"raw_text\": \"(Serum glucose over 140 mg/dl will be followed up with a fasting serum glucose assessment. Those with fasting glucose below 100 mg/dl may be considered for the protocol. Others will be rejected and referred for work-up.) MAI will make the final judgment on any questionable lab results.\"\n                                        }\n                                      }\n                                    }\n                                  }\n                                }\n                              }\n                            }\n                          }\n                        }\n                      }\n                    }\n                  }\n                }\n              }\n            }\n          }\n        }\n      }\n    },\n    \"right\": {\n      \"AND\": {\n        \"left\": {\n          \"AND\": {\n            \"left\": {\n              \"raw_text\": \"4. Right-handed.\"\n            },\n            \"right\": {\n              \"AND\": {\n                \"left\": {\n                  \"raw_text\": \"Justification: Using right-handed individuals will reduce variability in BOLD MRI data.\"\n                },\n                \"right\": {\n                  \"raw_text\": \"Screening tool: Edinburgh Handedness Inventory.\"\n                }\n              }\n            }\n          },\n          \"right\": {\n            \"AND\": {\n              \"left\": {\n                \"raw_text\": \"5. Estimated IQ greater than or equal to 85\"\n              },\n              \"right\": {\n                \"AND\": {\n                  \"left\": {\n                    \"raw_text\": \"Justification: Subjects must be able to perform a cognitively challenging task to a high standard.\"\n                    },\n                    \"right\": {\n                      \"raw_text\": \"Screening tool: Wechsler Abbreviated Scale of Intelligence.\"\n                    }\n                  }\n                }\n              }\n            }\n          }\n        }\n      }\n    }\n  }\n}"