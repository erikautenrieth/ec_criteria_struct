"{\n  \"AND\": {\n    \"left\": {\n      \"OR\": {\n        \"left\": {\n          \"raw_text\": \"1. Does not have a documented history of generalized seizures.\"\n        },\n        \"right\": {\n          \"AND\": {\n            \"left\": {\n              \"raw_text\": \"2. Has not had a GTC seizure within the last year\"\n            },\n            \"right\": {\n              \"AND\": {\n                \"left\": {\n                  \"raw_text\": \"AND is not expected to have a reduction of anti-epileptic drugs during their hospital admission.\"\n                }\n              }\n            }\n          }\n        }\n      }\n    },\n    \"right\": {\n      \"AND\": {\n        \"left\": {\n          \"raw_text\": \"3. Intracranial EEG electrodes are being used\"\n        },\n        \"right\": {\n          \"AND\": {\n            \"left\": {\n              \"raw_text\": \"4. The subject's upper arm circumference not adequate for proper fit of the EMG monitor (less than 14cm).\"\n            },\n            \"right\": {\n              \"OR\": {\n                \"left\": {\n                  \"raw_text\": \"5. Pregnant female.\"\n                },\n                \"right\": {\n                  \"raw_text\": \"6. Subject/Caregiver is unable to provide consent.\"\n                }\n              }\n            }\n          }\n        }\n      }\n    }\n  }\n}"