"{\n  \"AND\": {\n    \"left\": {\n      \"AND\": {\n        \"left\": {\n          \"raw_text\": \"Participants must have completed 3 cycles of a bortezomib-based induction regimen\"\n        },\n        \"right\": {\n          \"AND\": {\n            \"left\": {\n              \"raw_text\": \"(as defined by current NCCN guidelines)\"\n            },\n            \"right\": {\n              \"NOT\": {\n                \"left\": {\n                  \"raw_text\": \"and have evidence of disease progression as defined by IMWG criteria.\"\n                }\n              }\n            }\n          }\n        }\n      }\n    },\n    \"right\": {\n      \"AND\": {\n        \"left\": {\n          \"OR\": {\n            \"left\": {\n              \"raw_text\": \"Participants with light chain\"\n            },\n            \"right\": {\n              \"raw_text\": \"and free light chain (FLC) only may be enrolled if they meet all the criteria for a diagnosis of MM.\"\n            }\n          }\n        },\n        \"right\": {\n          \"AND\": {\n            \"left\": {\n              \"raw_text\": \"Participants must be considered by their physician eligible to receiving the IRD regimen.\"\n            }\n          }\n        }\n      }\n    },\n    \"right\": {\n      \"AND\": {\n        \"left\": {\n          \"raw_text\": \"Eastern Cooperative Oncology Group (ECOG) performance status and/or other performance status 0, 1, or 2 at time of enrollment.\"\n        }\n      }\n    }\n  }\n}"