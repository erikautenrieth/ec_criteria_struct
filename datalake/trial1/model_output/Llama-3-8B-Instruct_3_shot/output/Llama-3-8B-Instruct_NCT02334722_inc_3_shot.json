"{\n  \"AND\": {\n    \"left\": {\n      \"AND\": {\n        \"left\": {\n          \"raw_text\": \"Adult (>18 years of age and older)\"\n        },\n        \"right\": {\n          \"AND\": {\n            \"left\": {\n              \"raw_text\": \"patients who have or will have undergone\"\n            },\n            \"right\": {\n              \"OR\": {\n                \"left\": {\n                  \"raw_text\": \"surgical resection\"\n                },\n                \"right\": {\n                  \"raw_text\": \"or biopsy of a supratentorial brain tumor\"\n                }\n              }\n            }\n          }\n        },\n        \"right\": {\n          \"AND\": {\n            \"left\": {\n              \"raw_text\": \"and are able to consent for themselves.\"\n            }\n          }\n        }\n      }\n    },\n    \"right\": {\n      \"AND\": {\n        \"left\": {\n          \"raw_text\": \"Able to be randomized\"\n        },\n        \"right\": {\n          \"OR\": {\n            \"left\": {\n              \"raw_text\": \"prior to\"\n            },\n            \"right\": {\n              \"raw_text\": \"or up to 48 hours after surgery.\"\n            }\n          }\n        }\n      }\n    }\n  }\n}"