"{\n  \"AND\": {\n    \"left\": {\n      \"OR\": {\n        \"left\": {\n          \"raw_text\": \"Age 18 years or older\"\n        }\n      }\n    },\n    \"right\": {\n      \"AND\": {\n        \"left\": {\n          \"raw_text\": \"Diagnosis of venous leg ulcer(s), as clinically determined by the investigator by a positive venous reflux test (venous refilling <20 seconds) using Doppler ultrasound for at least 4 weeks prior to screening day, which have not adequately responded to conventional ulcer therapy.\"\n        },\n        \"right\": {\n          \"AND\": {\n            \"left\": {\n              \"AND\": {\n                \"left\": {\n                  \"raw_text\": \"Designated venous leg ulcer meets the following criteria at both the screening and baseline visits.\"\n                },\n                \"right\": {\n                  \"OR\": {\n                    \"left\": {\n                      \"raw_text\": \"If the patient has multiple ulcers, at least one ulcer must meet the following criteria at both the screening and baseline visits:\"\n                    }\n                  }\n                }\n              }\n            },\n            \"right\": {\n              \"AND\": {\n                \"left\": {\n                  \"AND\": {\n                    \"left\": {\n                      \"raw_text\": \"Present for at least 4 weeks\"\n                    },\n                    \"right\": {\n                      \"raw_text\": \"CEAP Classification Stage 6\"\n                    }\n                  },\n                  \"right\": {\n                    \"AND\": {\n                      \"left\": {\n                        \"raw_text\": \"Surface ulcer with an area > 15cm2 post debridement\"\n                      },\n                      \"right\": {\n                        \"raw_text\": \"Viable, granulating wound (investigator discretion)\"\n                      }\n                    }\n                  }\n                },\n                \"right\": {\n                  \"AND\": {\n                    \"left\": {\n                      \"raw_text\": \"Ulcers that extend through the epidermis but not through the muscle, tendon, or bone (Stage II or III ulcers as defined by the IAET).\"\n                    }\n                  }\n                }\n              }\n            }\n          }\n        },\n        \"right\": {\n          \"AND\": {\n            \"left\": {\n              \"OR\": {\n                \"left\": {\n                  \"raw_text\": \"Female patients of childbearing potential must have a negative pregnancy test at screening and must agree to use hormonal contraceptive, intrauterine device, diaphragm with spermicide, condom with spermicide, or abstinence throughout until 2 weeks after the last administration of study drug\"\n                }\n              }\n            },\n            \"right\": {\n              \"raw_text\": \"Signed informed consent\"\n            }\n          }\n        }\n      }\n    }\n  }\n}"