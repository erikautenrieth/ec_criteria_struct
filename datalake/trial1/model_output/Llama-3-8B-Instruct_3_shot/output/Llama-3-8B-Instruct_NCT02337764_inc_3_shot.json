"{\n  \"AND\": {\n    \"left\": {\n      \"AND\": {\n        \"left\": {\n          \"raw_text\": \"The participant has a diagnosis of Parkinson's disease\"\n        },\n        \"right\": {\n          \"raw_text\": \"according to the diagnostic criteria of the UK Parkinson's Disease Society Brain Bank.\"\n        }\n      }\n    },\n    \"right\": {\n      \"AND\": {\n        \"left\": {\n          \"AND\": {\n            \"left\": {\n              \"raw_text\": \"The participant has received a levodopa combination drug\"\n            },\n            \"right\": {\n              \"raw_text\": \"for >= 1 month and has either of the following.\"\n            }\n          }\n        },\n        \"right\": {\n          \"OR\": {\n            \"left\": {\n              \"raw_text\": \"Wearing off phenomenon\"\n            },\n            \"right\": {\n              \"raw_text\": \"or Decreased response to levodopa combination drugs\"\n            }\n          }\n        }\n      }\n    },\n    \"right\": {\n      \"AND\": {\n        \"left\": {\n          \"raw_text\": \"The participant has received a levodopa combination drug\"\n        },\n        \"right\": {\n          \"NOT\": {\n            \"left\": {\n              \"raw_text\": \"without change in the dose regimen.\"\n            }\n          }\n        }\n      }\n    },\n    \"right\": {\n      \"AND\": {\n        \"left\": {\n          \"raw_text\": \"The participant is an outpatient of either sex\"\n        },\n        \"right\": {\n          \"AND\": {\n            \"left\": {\n              \"raw_text\": \"aged >= 30 and < 80 years.\"\n            }\n          }\n        }\n      }\n    }\n  }\n}"