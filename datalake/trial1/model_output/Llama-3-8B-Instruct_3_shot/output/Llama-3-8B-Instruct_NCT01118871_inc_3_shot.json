"{\n  \"AND\": {\n    \"left\": {\n      \"OR\": {\n        \"left\": {\n          \"raw_text\": \"HIV-1 infected males\"\n        },\n        \"right\": {\n          \"raw_text\": \"or females\"\n        }\n      }\n    },\n    \"right\": {\n      \"AND\": {\n        \"left\": {\n          \"raw_text\": \"over 18 years of age\"\n        },\n        \"right\": {\n          \"AND\": {\n            \"left\": {\n              \"raw_text\": \"signed informed consent\"\n            },\n            \"right\": {\n              \"AND\": {\n                \"left\": {\n                  \"raw_text\": \"currently receiving a stable antiretroviral regimen comprising of:\"\n                },\n                \"right\": {\n                  \"AND\": {\n                    \"left\": {\n                      \"OR\": {\n                        \"left\": {\n                          \"raw_text\": \"two or more licensed NRTIs\"\n                        },\n                        \"right\": {\n                          \"AND\": {\n                            \"left\": {\n                              \"raw_text\": \"one licensed NNRTI or boosted protease inhibitor\"\n                            }\n                          }\n                        }\n                      }\n                    },\n                    \"right\": {\n                      \"NOT\": {\n                        \"left\": {\n                          \"raw_text\": \"no previous protease inhibitor resistance documented on HIV-1 genotypic resistance testing\"\n                        }\n                      }\n                    }\n                  }\n                },\n                \"right\": {\n                  \"AND\": {\n                    \"left\": {\n                      \"OR\": {\n                        \"left\": {\n                          \"raw_text\": \"failure of current antiretroviral regimen due to:\"\n                        },\n                        \"right\": {\n                          \"OR\": {\n                            \"left\": {\n                              \"raw_text\": \"toxicity, intolerance or virological failure if receiving an NNRTI containing regimen at screening\"\n                            },\n                            \"right\": {\n                              \"OR\": {\n                                \"left\": {\n                                  \"raw_text\": \"toxicity or intolerance if receiving a boosted-protease inhibitor regimen at screening (with plasma HIV RNA < 400 copies/mL at screening)\"\n                                }\n                              }\n                            }\n                          }\n                        }\n                      }\n                    },\n                    \"right\": {\n                      \"AND\": {\n                        \"left\": {\n                          \"raw_text\": \"willing to modify antiretroviral therapy, in accordance with the randomisation assignment\"\n                        }\n                      }\n                    }\n                  }\n                }\n              }\n            },\n            \"right\": {\n              \"NOT\": {\n                \"left\": {\n                  \"raw_text\": \"no previous exposure to etravirine\"\n                }\n              }\n            }\n          }\n        }\n      }\n    }\n  }\n}"