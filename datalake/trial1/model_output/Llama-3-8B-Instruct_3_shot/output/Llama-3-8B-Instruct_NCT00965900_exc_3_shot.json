"{\n  \"AND\": {\n    \"left\": {\n      \"OR\": {\n        \"left\": {\n          \"raw_text\": \"Patients with systolic blood pressure <100 mmHg\"\n        },\n        \"right\": {\n          \"raw_text\": \"or basal heart rate <60/min\"\n        }\n      }\n    },\n    \"right\": {\n      \"AND\": {\n        \"left\": {\n          \"raw_text\": \"Portal vein thrombosis\"\n        },\n        \"right\": {\n          \"AND\": {\n            \"left\": {\n              \"OR\": {\n                \"left\": {\n                  \"raw_text\": \"Uncontrolled ascites\"\n                },\n                \"right\": {\n                  \"raw_text\": \"or hepatic encephalopathy\"\n                }\n              }\n            },\n            \"right\": {\n              \"AND\": {\n                \"left\": {\n                  \"raw_text\": \"Severe coagulation disorder: prothrombin time <40%\"\n                },\n                \"right\": {\n                  \"OR\": {\n                    \"left\": {\n                      \"raw_text\": \"(or INR >1.7)\"\n                    },\n                    \"right\": {\n                      \"raw_text\": \"or platelet count <30,000/mm3\"\n                    }\n                  }\n                }\n              }\n            }\n          }\n        },\n        \"right\": {\n          \"AND\": {\n            \"left\": {\n              \"OR\": {\n                \"left\": {\n                  \"raw_text\": \"Medium or large sized gastric or duodenal varices\"\n                }\n              }\n            },\n            \"right\": {\n              \"AND\": {\n                \"left\": {\n                  \"raw_text\": \"Coexisting malignancy\"\n                },\n                \"right\": {\n                  \"OR\": {\n                    \"left\": {\n                      \"raw_text\": \"Severe cardiovascular disorder\"\n                    },\n                    \"right\": {\n                      \"OR\": {\n  