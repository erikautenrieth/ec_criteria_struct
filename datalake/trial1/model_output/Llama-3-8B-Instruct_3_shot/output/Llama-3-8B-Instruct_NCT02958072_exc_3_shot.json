"{\n  \"AND\": {\n    \"left\": {\n      \"OR\": {\n        \"left\": {\n          \"raw_text\": \"Hemoglobin concentration under 6.5 mmol/l screening\"\n        },\n        \"right\": {\n          \"OR\": {\n            \"left\": {\n              \"raw_text\": \"HBA1c more than 108 mmol/l\"\n            },\n            \"right\": {\n              \"raw_text\": \"or non-compliant with blood-letting\"\n            }\n          }\n        }\n      }\n    },\n    \"right\": {\n      \"AND\": {\n        \"left\": {\n          \"OR\": {\n            \"left\": {\n              \"raw_text\": \"Clinically infected ulcer\"\n            },\n            \"right\": {\n              \"OR\": {\n                \"left\": {\n                  \"raw_text\": \"Patient planned for or has had a revascularization procedure in the affected leg within the last 8 weeks\"\n                },\n                \"right\": {\n                  \"OR\": {\n                    \"left\": {\n                      \"raw_text\": \"The ulcer have been treated with growth factors in the last 8 weeks\"\n                    },\n                    \"right\": {\n                      \"OR\": {\n                        \"left\": {\n                          \"raw_text\": \"History of deep venous insufficiency\"\n                        },\n                        \"right\": {\n                          \"OR\": {\n                            \"left\": {\n                              \"raw_text\": \", chronic venous leg ulcer\"\n                            },\n                            \"right\": {\n                              \"raw_text\": \"or stasis dermatitis\"\n                            }\n                          }\n                        }\n                      }\n                    }\n                  }\n                }\n              }\n            }\n          }\n        },\n        \"right\": {\n          \"AND\": {\n            \"left\": {\n              \"OR\": {\n                \"left\": {\n                  \"raw_text\": \"Breast-feeding women\"\n                },\n                \"right\": {\n                  \"OR\": {\n                    \"left\": {\n                      \"raw_text\": \"or fertile women not agreeing to use an effective method of contraception\"\n                    }\n                  }\n                }\n              }\n            },\n            \"right\": {\n              \"AND\": {\n                \"left\": {\n                  \"OR\": {\n                    \"left\": {\n                      \"raw_text\": \"Participation in another clinical ulcer-healing study within the last 4 weeks\"\n                    },\n                    \"right\": {\n                      \"raw_text\": \"or patient has previously been randomized in this study\"\n                    }\n                  }\n                },\n                \"right\": {\n                  \"raw_text\": \"or judgement by the investigator that the patient is not able to participate in the study\"\n                }\n              }\n            }\n          }\n        }\n      }\n    }\n  }\n}"