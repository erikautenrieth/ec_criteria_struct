"{\n  \"AND\": {\n    \"left\": {\n      \"OR\": {\n        \"left\": {\n          \"raw_text\": \"Current pregnancy or lactation\"\n        }\n      }\n    },\n    \"right\": {\n      \"AND\": {\n        \"left\": {\n          \"OR\": {\n            \"left\": {\n              \"raw_text\": \"Liver disease\"\n            },\n            \"right\": {\n              \"raw_text\": \"or elevated liver enzymes\"\n            }\n          }\n        },\n        \"right\": {\n          \"AND\": {\n            \"left\": {\n              \"raw_text\": \"Established diagnosis of diabetes mellitus\"\n            },\n            \"right\": {\n              \"AND\": {\n                \"left\": {\n                  \"raw_text\": \"Abnormal serum glucose levels\"\n                },\n                \"right\": {\n                  \"raw_text\": \"either at fasting or after the 2-hr oral glucose tolerance test meeting criteria for the diagnosis of diabetes mellitus according to the American Diabetes Association.\"\n                }\n              }\n            }\n          }\n        }\n      }\n    }\n  }\n}"