"{\n  \"AND\": {\n    \"left\": {\n      \"AND\": {\n        \"left\": {\n          \"raw_text\": \"The subject must be willingly and able to provide written informed consent\"\n        },\n        \"right\": {\n          \"AND\": {\n            \"left\": {\n              \"raw_text\": \"Age 19 years of age or older\"\n            },\n            \"right\": {\n              \"raw_text\": \"(The age of consent in Nebraska)\"\n            }\n          }\n        }\n      }\n    },\n    \"right\": {\n      \"AND\": {\n        \"left\": {\n          \"AND\": {\n            \"left\": {\n              \"raw_text\": \"HCV treatment-naïve, as defined as no prior exposure to any Interferon (IFN), RBV, or other FDA approved or experimental HCV-specific direct-acting antiviral agent\"\n            },\n            \"right\": {\n              \"AND\": {\n                \"left\": {\n                  \"raw_text\": \"HCV RNA level at most 6 months prior to the Baseline/Day 1 visit.\"\n                },\n                \"right\": {\n                  \"AND\": {\n                    \"left\": {\n                      \"raw_text\": \"HCV genotyping 1a, 1b, or mixed 1a/ab.\"\n                    },\n                    \"right\": {\n                      \"NOT\": {\n                        \"left\": {\n                          \"raw_text\": \"Any non-definitive results will exclude the subject from study participation.\"\n                        }\n                      }\n                    }\n                  }\n                }\n              }\n            }\n          }\n        },\n        \"right\": {\n          \"AND\": {\n            \"left\": {\n              \"OR\": {\n                \"left\": {\n                  \"raw_text\": \"Alcohol misuse as defined by the Alcohol Use Disorders Identification Test (AUDIT) score subjects must score > 8\"\n                },\n                \"right\": {\n                  \"raw_text\": \"(associated with harmful or hazardous drinking)\"\n                }\n              }\n            },\n            \"right\": {\n              \"AND\": {\n                \"left\": {\n                  \"OR\": {\n                    \"left\": {\n                      \"raw_text\": \"History of a liver biopsy showing cirrhosis\"\n                    },\n                    \"right\": {\n                      \"OR\": {\n                        \"left\": {\n                          \"raw_text\": \"Fibroscan showing cirrhosis or results > 12.5 kPa\"\n                        },\n                        \"right\": {\n                          \"AND\": {\n                            \"left\": {\n                              \"raw_text\": \"FIBRO Spect II index consistent with F3 or F4\"\n                            },\n                            \"right\": {\n                              \"AND\": {\n                                \"left\": {\n                                  \"raw_text\": \"AND an AST : platelet ration index (APRI) of > 2 during Screening\"\n                                }\n                              }\n                            }\n                          }\n                        }\n                      }\n                    }\n                  }\n                },\n                \"right\": {\n                  \"OR\": {\n                    \"left\": {\n                      \"raw_text\": \"Liver biopsy within 2 years of Screening showing absence of cirrhosis\"\n                    },\n                    \"right\": {\n                      \"OR\": {\n                        \"left\": {\n                          \"raw_text\": \"Fibroscan within 6 months of Baseline/Day 1 with a result of = 12.5 kPa\"\n                        },\n                        \"right\": {\n                          \"AND\": {\n                            \"left\": {\n                              \"raw_text\": \"FIBRO Spect II Index consistent with F0- F2\"\n                            },\n                            \"right\": {\n                              \"AND\": {\n                                \"left\": {\n                                  \"raw_text\": \"AND APRI of = 1 during Screening\"\n                                }\n                              }\n                            }\n                          }\n                        }\n                      }\n                    }\n                  }\n                }\n              }\n            }\n          }\n        }\n      }\n    }\n  }\n}"