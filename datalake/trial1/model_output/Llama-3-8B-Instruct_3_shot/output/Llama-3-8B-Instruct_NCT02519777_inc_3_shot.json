"{\n  \"OR\": {\n    \"left\": {\n      \"AND\": {\n        \"left\": {\n          \"raw_text\": \"a licensed rapid HIV test or HIV enzyme or chemiluminescence immunoassay (E/CIA) test kit at any time prior to study entry and confirmed by a licensed Western blot or a second antibody test by a method other than the initial rapid HIV and/or E/CIA, or by HIV-1 antigen or plasma HIV-1 RNA viral load.\"\n        },\n        \"right\": {\n          \"OR\": {\n            \"left\": {\n              \"raw_text\": \"Documentation of HIV diagnosis in the medical record by a healthcare provider.\"\n            }\n          }\n        }\n      }\n    },\n    \"right\": {\n      \"AND\": {\n        \"left\": {\n          \"OR\": {\n            \"left\": {\n              \"raw_text\": \"Tenofovir disoproxil fumarate (TDF) to tenofovir alafenamide fumarate (TAF)/TAF-containing fixed-dose combination regimens\"\n            },\n            \"right\": {\n              \"OR\": {\n                \"left\": {\n                  \"raw_text\": \"Ritonavir (RTV) to cobicistat (COBI)/COBI-containing fixed-dose combination regimens\"\n                },\n                \"right\": {\n                  \"OR\": {\n                    \"left\": {\n                      \"raw_text\": \"TDF to TAF/TAF-containing fixed-dose combination regimens\"\n                    },\n                    \"right\": {\n                      \"OR\": {\n                        \"left\": {\n                          \"raw_text\": \"RTV to COBI/COBI-containing fixed-dose combination regimens\"\n                        }\n                      }\n                    }\n                  }\n                }\n              }\n            }\n          }\n        },\n        \"right\": {\n          \"AND\": {\n            \"left\": {\n              \"raw_text\": \"HIV-1 plasma RNA less than 50 copies/mL obtained within 90 days prior to study entry by any FDA-approved assay at any United States laboratory that has a Clinical Laboratory Improvement Amendments (CLIA) certification or its equivalent, or at any network-approved non-US laboratory that operates in accordance with Good Clinical Laboratory Practices (GCLP) and participates in appropriate external quality assurance programs.\"\n            },\n            \"right\": {\n              \"AND\": {\n                \"left\": {\n                  \"raw_text\": \"No more than one HIV-1 plasma RNA greater than or equal to 50 and less than 200 copies/mL (only one 'blip') in the past 6 months with a subsequent HIV-1 plasma RNA less than 50 copies/mL.\"\n                },\n                \"right\": {\n                  \"AND\": {\n                    \"left\": {\n                      \"raw_text\": \"There should be no plasma HIV-1 RNA greater than 200 copies/mL within the 6 months prior to study entry.\"\n                    }\n                  }\n                }\n              }\n            }\n          }\n        }\n      }\n    }\n  }\n}\n{\n  \"AND\": {\n    \"left\": {\n      \"raw_text\": \"HAND diagnosis (ANI, MND, or HAD) within 60 days prior to study entry. HAND is defined as at least mild impairment on neurocognitive testing (more than one standard deviation below appropriate normative data in two domains of functioning) and no severely confounding factors.\"\n    },\n    \"right\": {\n      \"AND\": {\n        \"left\": {\n          \"raw_text\": \"Absolute neutrophil count (ANC) greater than or equal to 500/mm^3\"\n        },\n        \"right\": {\n          \"AND\": {\n            \"left\": {\n              \"raw_text\": \"Hemoglobin greater than or equal to 7.5 g/dL\"\n            },\n            \"right\": {\n              \"AND\": {\n                \"left\": {\n                  \"raw_text\": \"Platelet count greater than or equal to 40,000/mm^3\"\n                },\n                \"right\": {\n                  \"AND\": {\n                    \"left\": {\n                      \"raw_text\": \"Creatinine less than or equal to 2.0 x upper limit of normal (ULN)\"\n                    },\n                    \"right\": {\n                      \"AND\": {\n                        \"left\": {\n                          \"raw_text\": \"Aspartate transaminase (AST) less than or equal to 5 x ULN\"\n                        },\n                        \"right\": {\n                          \"AND\": {\n                            \"left\": {\n                              \"raw_text\": \"Alanine transaminase (ALT) less than 3 x ULN\"\n                            },\n                            \"right\": {\n                              \"AND\": {\n                                \"left\": {\n                                  \"raw_text\": \"Alkaline phosphatase less than or equal to 5 x ULN\"\n                                },\n                                \"right\": {\n                                  \"AND\": {\n                                    \"left\": {\n                                      \"raw_text\": \"Total bilirubin less than 1.5 x ULN.\"\n                                    },\n                                    \"right\": {\n                                      \"OR\": {\n                                        \"left\": {\n                                          \"raw_text\": \"If the potential participant is taking an indinavir (IDV)- or atazanavir (ATV)-containing regimen at the time of screening, total bilirubin less than or equal to 5 x ULN is acceptable.\"\n                                        }\n                                      }\n                                    }\n                                  }\n                                }\n                              }\n                            }\n                          }\n                        }\n                      }\n                    }\n                  }\n                }\n              }\n            }\n          }\n        }\n      }\n    }\n  }\n}\n{\n  \"AND\": {\n    \"left\": {\n      \"raw_text\": \"Females of reproductive potential (women who have not been post-menopausal for at least 24 consecutive months, ie, who have had menses within the preceding 24 months, or women who have not undergone surgical sterilization, hysterectomy or bilateral salpingectomy or bilateral oophorectomy or tubal ligation) must have a negative serum or urine pregnancy test by any US clinic or laboratory that has a CLIA certification or its equivalent, or is using a point of care (POC) / CLIA-waived test, or at any network-approved non-US laboratory or clinic that operates in accordance with GCLP and participates in appropriate external quality assurance programs within 48 hours prior to study entry\"\n    },\n    \"right\": {\n      \"AND\": {\n        \"left\": {\n          \"raw_text\": \"Females of reproductive potential must agree not to participate in the conception process (ie, active attempt to become pregnant, in vitro fertilization), and if participating in sexual activity that could lead to pregnancy, must use at least one reliable form of contraception.\"\n        },\n        \"right\": {\n          \"AND\": {\n            \"left\": {\n              \"raw_text\": \"Female participants must use contraceptives while receiving study treatment and for 6 weeks after stopping study treatment.\"\n            },\n            \"right\": {\n              \"AND\": {\n                \"left\": {\n                  \"raw_text\": \"More information on this criterion is available in the protocol.\"\n                }\n              }\n            }\n          }\n        }\n      }\n    }\n  }\n}\n{\n  \"AND\": {\n    \"left\": {\n      \"raw_text\": \"Men and women 18 years of age and older who are able to complete the neuropsychological tests\"\n    },\n    \"right\": {\n      \"AND\": {\n        \"left\": {\n          \"raw_text\": \"Ability and willingness of participant or a legally authorized representative (see protocol for more information) to provide informed consent\"\n        },\n        \"right\": {\n          \"AND\": {\n            \"left\": {\n              \"raw_text\": \"Ability and willingness to take oral study medications\"\n            }\n          }\n        }\n      }\n    }\n  }\n}"