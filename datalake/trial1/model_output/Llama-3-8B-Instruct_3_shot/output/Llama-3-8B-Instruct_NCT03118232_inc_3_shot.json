"{\n  \"AND\": {\n    \"left\": {\n      \"AND\": {\n        \"left\": {\n          \"raw_text\": \"Nursing homes\"\n        },\n        \"right\": {\n          \"AND\": {\n            \"left\": {\n              \"raw_text\": \"will be eligible to participate if they meet the following criteria:\"\n            },\n            \"right\": {\n              \"AND\": {\n                \"left\": {\n                  \"AND\": {\n                    \"left\": {\n                      \"raw_text\": \"Licensed nursing home\"\n                    },\n                    \"right\": {\n                      \"AND\": {\n                        \"left\": {\n                          \"raw_text\": \"in Orange County\"\n                        },\n                        \"right\": {\n                          \"OR\": {\n                            \"left\": {\n                              \"raw_text\": \"or Southern Los Angeles County\"\n                            }\n                          }\n                        }\n                      }\n                    }\n                  },\n                  \"right\": {\n                    \"AND\": {\n                      \"left\": {\n                        \"raw_text\": \"serving adults\"\n                        },\n                        \"right\": {\n                          \"AND\": {\n                            \"left\": {\n                              \"AND\": {\n                                \"left\": {\n                                  \"raw_text\": \"Minimal use of chlorhexidine bathing*\"\n                                },\n                                \"right\": {\n                                  \"AND\": {\n                                    \"left\": {\n                                      \"raw_text\": \"Minimal use of nasal decolonization*\"\n                                    },\n                                    \"right\": {\n                                      \"NOT\": {\n              