"{\n  \"OR\": {\n    \"left\": {\n      \"AND\": {\n        \"left\": {\n          \"raw_text\": \"Prior Therapy Exposure to chemotherapy or radiotherapy within 2 weeks prior to entering the study or those who have not recovered from adverse events due to agents administered more than 2 weeks earlier.\"\n        },\n        \"right\": {\n          \"AND\": {\n            \"left\": {\n              \"raw_text\": \"Systemic steroids that have not been stabilized (≥ 5 days) to the equivalent of ≤10 mg/day prednisone prior to the start of the study drugs.\"\n            },\n            \"right\": {\n              \"raw_text\": \"No other investigational agents are allowed.\"\n            }\n          }\n        }\n      }\n    },\n    \"right\": {\n      \"OR\": {\n        \"left\": {\n          \"raw_text\": \"History of allergic reactions to TGR-1202 or carfilzomib\"\n        },\n        \"right\": {\n          \"raw_text\": \"Uncontrolled inter-current illness\"\n        }\n      }\n    }\n  },\n  \"OR\": {\n    \"left\": {\n      \"AND\": {\n        \"left\": {\n          \"raw_text\": \"Pregnant women\"\n        },\n        \"right\": {\n          \"raw_text\": \"Nursing women\"\n        }\n      }\n    },\n    \"right\": {\n      \"OR\": {\n        \"left\": {\n          \"raw_text\": \"Current malignancy or history of a prior malignancy\"\n        },\n        \"right\": {\n          \"AND\": {\n            \"left\": {\n              \"raw_text\": \"Patient known to be Human Immunodeficiency Virus (HIV)-positive\"\n            },\n            \"right\": {\n              \"OR\": {\n                \"left\": {\n                  \"raw_text\": \"Active Hepatitis A\"\n                },\n                \"right\": {\n                  \"OR\": {\n                    \"left\": {\n                      \"raw_text\": \"Hepatitis B\"\n                    },\n                    \"right\": {\n                      \"raw_text\": \"or Hepatitis C infection\"\n                