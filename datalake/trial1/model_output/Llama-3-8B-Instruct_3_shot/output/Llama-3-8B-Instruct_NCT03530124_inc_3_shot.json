"{\n  \"AND\": {\n    \"left\": {\n      \"AND\": {\n        \"left\": {\n          \"raw_text\": \"=32 weeks gestational age at birth\"\n        },\n        \"right\": {\n          \"AND\": {\n            \"left\": {\n              \"raw_text\": \"=6 weeks postnatal age at randomization\"\n            },\n            \"right\": {\n              \"AND\": {\n                \"left\": {\n                  \"raw_text\": \"Remains hospitalized after birth (has never been discharged home)\"\n                },\n                \"right\": {\n                  \"AND\": {\n                    \"left\": {\n                      \"raw_text\": \"Treating clinician deems infant eligible to receive 2-month vaccines\"\n                    },\n                    \"right\": {\n                      \"AND\": {\n                        \"left\": {\n                          \"OR\": {\n                            \"left\": {\n                              \"raw_text\": \"English- or Spanish-speaking parent(s)\"\n                            },\n                            \"right\": {\n                              \"raw_text\": \"or legally authorized representative(s) (LAR(s))\"\n                            }\n                          }\n                        },\n                        \"right\": {\n                          \"AND\": {\n                            \"left\": {\n                              \"NOT\": {\n                                \"left\": {\n                                  \"raw_text\": \"planned for discharge within 60 hours of study entry\"\n                                }\n                              }\n                            },\n                            \"right\": {\n                              \"AND\": {\n                                \"left\": {\n                                  \"raw_text\": \"The parent/guardian must be willing and capable of providing permission for their child to participate through the written informed consent p