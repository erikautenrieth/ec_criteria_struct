"{\n  \"AND\": {\n    \"left\": {\n      \"OR\": {\n        \"left\": {\n          \"raw_text\": \"Males\"\n        },\n        \"right\": {\n          \"raw_text\": \"and females\"\n        }\n      },\n      \"right\": {\n        \"AND\": {\n          \"left\": {\n            \"raw_text\": \"21 years of age or older;\"\n          },\n          \"right\": {\n            \"OR\": {\n              \"left\": {\n                \"raw_text\": \"Undergoing elective primary, resurfacing arthroplasty, revision, or second stage re-implantation total hip replacement;\"\n              },\n              \"right\": {\n                \"raw_text\": \"Undergoing elective primary, revision, or second stage re-implantation total or uni compartmental knee replacement;\"\n              }\n            }\n          }\n        }\n      }\n    },\n    \"right\": {\n      \"AND\": {\n        \"left\": {\n          \"raw_text\": \"Patient has necessary mental capacity to participate and is able to comply with study protocol requirements;\"\n        },\n        \"right\": {\n          \"AND\": {\n            \"left\": {\n              \"raw_text\": \"Patient is willing and able to give informed consent;\"\n            },\n            \"right\": {\n              \"raw_text\": \"and Patient is willing to be randomized and participate.\"\n            }\n          }\n        }\n      }\n    }\n  }\n}"