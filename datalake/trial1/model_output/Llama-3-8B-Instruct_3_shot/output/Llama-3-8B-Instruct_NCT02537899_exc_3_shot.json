"{\n  \"AND\": {\n    \"left\": {\n      \"OR\": {\n        \"left\": {\n          \"raw_text\": \"Non survivable injury\"\n        },\n        \"right\": {\n          \"AND\": {\n            \"left\": {\n              \"raw_text\": \"Multiple significant trauma\"\n            },\n            \"right\": {\n              \"AND\": {\n                \"left\": {\n                  \"raw_text\": \"(i.e. significant intracranial and extracranial injuries including limb fractures)\"\n                },\n                \"right\": {\n                  \"raw_text\": \"that would limit observation of recovery from spinal cord injury\"\n                }\n              }\n            }\n          }\n        }\n      },\n      \"right\": {\n        \"OR\": {\n          \"left\": {\n            \"raw_text\": \"Other conditions that would limit clinical assessment of outcomes\"\n          },\n          \"right\": {\n            \"AND\": {\n              \"left\": {\n                \"OR\": {\n                  \"left\": {\n                    \"raw_text\": \"e.g. dementia\"\n                    },\n                    \"right\": {\n                      \"OR\": {\n                        \"left\": {\n                          \"raw_text\": \"demyelinating disease\"\n                        },\n                        \"right\": {\n                          \"OR\": {\n                            \"left\": {\n                              \"raw_text\": \"autoimmune disease\"\n                            },\n                            \"right\": {\n                              \"raw_text\": \"etc\"\n                            }\n                          }\n                        }\n                      }\n                    }\n                  }\n                }\n              }\n            }\n          }\n        }\n      }\n    },\n    \"right\": {\n      \"OR\": {\n        \"left\": {\n          \"raw_text\": \"Refusal of treatment\"\n        },\n        \"right\": {\