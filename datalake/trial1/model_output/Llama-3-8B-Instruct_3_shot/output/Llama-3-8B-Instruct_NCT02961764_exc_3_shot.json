"{\n  \"AND\": {\n    \"left\": {\n      \"OR\": {\n        \"left\": {\n          \"raw_text\": \"Known or suspected gram-negative infections\"\n        },\n        \"right\": {\n          \"OR\": {\n            \"left\": {\n              \"raw_text\": \"anaerobic infections\"\n            },\n            \"right\": {\n              \"raw_text\": \"or fungemia\"\n            }\n          }\n        }\n      }\n    },\n    \"right\": {\n      \"AND\": {\n        \"left\": {\n          \"OR\": {\n            \"left\": {\n              \"raw_text\": \"Known or suspected infections that are severe\"\n            },\n            \"right\": {\n              \"OR\": {\n                \"left\": {\n                  \"raw_text\": \"life threatening\"\n                },\n                \"right\": {\n                  \"raw_text\": \"or are not included in the ABSSSI Food and Drug Administration (FDA) guidance\"\n                }\n              }\n            }\n          }\n        },\n        \"right\": {\n          \"AND\": {\n            \"left\": {\n              \"raw_text\": \"Injection drug users with a fever\"\n            }\n          }\n        }\n      }\n    }\n  },\n  \"AND\": {\n    \"left\": {\n      \"AND\": {\n        \"left\": {\n          \"raw_text\": \"Severe neurological disorder leading to immobility\"\n        },\n        \"right\": {\n          \"raw_text\": \"or confined to a wheelchair\"\n        }\n      }\n    },\n    \"right\": {\n      \"AND\": {\n        \"left\": {\n          \"raw_text\": \"Bilateral Lower extremity involvement of the suspected infection.\"\n        }\n      }\n    }\n  }\n}"