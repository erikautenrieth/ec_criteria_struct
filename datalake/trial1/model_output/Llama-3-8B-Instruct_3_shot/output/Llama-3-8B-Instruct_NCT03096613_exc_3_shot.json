"{\n  \"AND\": {\n    \"left\": {\n      \"OR\": {\n        \"left\": {\n          \"raw_text\": \"Acute heart failure\"\n        },\n        \"right\": {\n          \"raw_text\": \"or acute exacerbation of chronic heart failure within the past 2 weeks.\"\n        }\n      }\n    },\n    \"right\": {\n      \"OR\": {\n        \"left\": {\n          \"raw_text\": \"Scheduled cardiac resynchronization therapy\"\n        },\n        \"right\": {\n          \"raw_text\": \"or heart transplantation.\"\n        }\n      }\n    }\n  }\n},\n{\n  \"AND\": {\n    \"left\": {\n      \"OR\": {\n        \"left\": {\n          \"raw_text\": \"History of malignant tumor\"\n        },\n        \"right\": {\n          \"raw_text\": \"or life expectancy under 12 months.\"\n        }\n      }\n    },\n    \"right\": {\n      \"AND\": {\n        \"left\": {\n          \"raw_text\": \"Already on medications that may affect thyroid function (L-T4, carbimazole, propylthiouracil, amiodarone, lithium).\"\n        }\n      }\n    }\n  }\n},\n{\n  \"AND\": {\n    \"left\": {\n      \"OR\": {\n        \"left\": {\n          \"raw_text\": \"Pregnancy and lactation period.\"\n        }\n      }\n    },\n    \"right\": {\n      \"AND\": {\n        \"left\": {\n          \"raw_text\": \"Participation in another clinical trial within the past 30 days.\"\n        }\n      }\n    }\n  }\n},\n{\n  \"AND\": {\n    \"left\": {\n      \"OR\": {\n        \"left\": {\n          \"raw_text\": \"Contraindication or intolerance to evidence-based therapy for CHF, such as beta-blocker, angiotensin-converting enzyme inhibitor or angiotensin receptor blocker.\"\n        }\n      }\n    },\n    \"right\": {\n      \"AND\": {\n        \"left\": {\n          \"raw_text\": \"Known hypersensitivity to the trial treatment(s) or diluents (when applicable), including placebo or other comparator drug(s).\"\n        }\n      }\n    }\n  }\n},\n{\n  \"AND\": {\n    \"left\": {\n      \"OR\": {\n        \"left\": {\n        