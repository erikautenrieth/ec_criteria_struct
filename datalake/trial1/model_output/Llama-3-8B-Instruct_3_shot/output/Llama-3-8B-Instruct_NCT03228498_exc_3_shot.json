"{\n  \"AND\": {\n    \"left\": {\n      \"AND\": {\n        \"left\": {\n          \"OR\": {\n            \"left\": {\n              \"raw_text\": \"Absence of objectionable cognitive impairment\"\n            },\n            \"right\": {\n              \"NOT\": {\n                \"left\": {\n                  \"raw_text\": \"or presence of dementia of severe degree defined by CDR score > 2.0.\"\n                }\n              }\n            }\n          }\n        },\n        \"right\": {\n          \"AND\": {\n            \"left\": {\n              \"NOT\": {\n                \"left\": {\n                  \"raw_text\": \"Unavailability of brain MRI\"\n                }\n              }\n            },\n            \"right\": {\n              \"OR\": {\n                \"left\": {\n                  \"raw_text\": \"(in case of absolute contraindications, the use of cranial CT is allowed).\"\n                }\n              }\n            }\n          }\n        }\n      }\n    },\n    \"right\": {\n      \"AND\": {\n        \"left\": {\n          \"OR\": {\n            \"left\": {\n              \"raw_text\": \"Expected poor compliance with the study protocol.\"\n            },\n            \"right\": {\n              \"OR\": {\n                \"left\": {\n                  \"raw_text\": \"Past diagnosis of major depression\"\n                },\n                \"right\": {\n                  \"OR\": {\n                    \"left\": {\n                      \"raw_text\": \"schizophrenia\"\n                    },\n                    \"right\": {\n                      \"OR\": {\n                        \"left\": {\n                          \"raw_text\": \"major anxiety syndrome\"\n                        },\n                        \"right\": {\n                          \"raw_text\": \"or manic- depressive illness.\"\n                        }\n                      }\n                    }\n                  }\n                }\n              }\n            }\n          }\n        },\n        \"right\": {\n          \"AND\": {\n            \"left\": {\n              \"OR\": {\n                \"left\": {\n                  \"raw_text\": \"Diagnosis of degenerative cognitive impairment\"\n                },\n                \"right\": {\n                  \"OR\": {\n                    \"left\": {\n                      \"raw_text\": \"based on clinical and/or neuroradiological findings\"\n                    },\n                    \"right\": {\n                      \"OR\": {\n                        \"left\": {\n                          \"raw_text\": \"(i.e., patients with prevailing memory impairment\"\n                        },\n                        \"right\": {\n                          \"OR\": {\n                            \"left\": {\n                              \"raw_text\": \", or with medial temporal atrophy on brain MRI in absence of evident vascular abnormalities; i.e., Alzheimer disease as defined using the National Institute of Neurological and Communicative Disorders and Stroke/Alzheimer's Disease and Related Disorders Association criteria, Parkinson disease, Huntington disease, frontotemporal dementia).\"\n                            }\n                          }\n                        }\n                      }\n                    }\n                  }\n                },\n                \"right\": {\n                  \"OR\": {\n                    \"left\": {\n                      \"raw_text\": \"Diagnosis of cognitive impairment from other causes\"\n                    },\n                    \"right\": {\n                      \"OR\": {\n                        \"left\": {\n                          \"raw_text\": \"(i.e., vitamine B12 and folic acid deficiency\"\n                        },\n                        \"right\": {\n                          \"OR\": {\n                            \"left\": {\n                              \"raw_text\": \", thyroid disorders, metabolic diseases, head trauma, tumor or infections of the central nervous system, normal pressure hydrocephalus).\"\n                            }\n                          }\n                        }\n                      }\n                    }\n                  }\n                }\n              }\n            }\n          }\n        }\n      }\n    }\n  }\n}"