"{\n  \"AND\": {\n    \"left\": {\n      \"AND\": {\n        \"left\": {\n          \"raw_text\": \"Subjects who, in the opinion of the investigator, can and will comply with the requirements of the protocol.\"\n        },\n        \"right\": {\n          \"AND\": {\n            \"left\": {\n              \"raw_text\": \"Written informed consent obtained from the subject prior to performing any study specific procedure.\"\n            },\n            \"right\": {\n              \"AND\": {\n                \"left\": {\n                  \"AND\": {\n                    \"left\": {\n                      \"raw_text\": \"A male or female between, and including, 18 and 50 years of age at the time of the first study visit.\"\n                    },\n                    \"right\": {\n                      \"AND\": {\n                        \"left\": {\n                          \"raw_text\": \"Healthy subjects as established by medical history and clinical examination before entering into the study.\"\n                        },\n                        \"right\": {\n                          \"NOT\": {\n                            \"left\": {\n                              \"OR\": {\n                                \"left\": {\n                                  \"raw_text\": \"Healthy subjects with no medical conditions that, in the opinion of the investigator, prevents the subject from participating in the study.\"\n                                }\n                              }\n                            }\n                          }\n                        }\n                      }\n                    }\n                  }\n                },\n                \"right\": {\n                  \"AND\": {\n                    \"left\": {\n                      \"raw_text\": \"Subjects must weigh at least 110 pounds (50 kg), but not to present obesity (BMI < 32kg/m2).\"\n                    },\n                    \"right\": {\n                      \"AND\": {\n                        \"left\": {\n                          \"OR\": {\n                            \"left\": {\n                              \"raw_text\": \"Female subjects of non-childbearing potential may be enrolled in the study.\"\n                            },\n                            \"right\": {\n                              \"raw_text\": \"Non-childbearing potential is defined as pre-menarche, current bilateral tubal ligation or occlusion, hysterectomy, bilateral ovariectomy or post-menopause.\"\n                            }\n                          }\n                        },\n                        \"right\": {\n                          \"AND\": {\n                            \"left\": {\n                              \"AND\": {\n                                \"left\": {\n                                  \"raw_text\": \"has practiced adequate contraception for 30 days prior to vaccination, and\"\n                                },\n                                \"right\": {\n                                  \"AND\": {\n                                    \"left\": {\n                                      \"raw_text\": \"has a negative pregnancy test on the day of vaccination and\"\n                                    },\n                                    \"right\": {\n                                      \"AND\": {\n                                        \"left\": {\n                                          \"raw_text\": \"has agreed to continue adequate contraception during the entire treatment period and for 1 month, after completion of the vaccination series.\"\n                                        }\n                                      }\n                                    }\n                                  }\n                                }\n                              }\n                            }\n                          }\n                        }\n                      }\n                    }\n                  }\n                }\n              }\n            }\n          }\n        }\n      }\n    }\n  }\n}"