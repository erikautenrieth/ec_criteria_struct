"{\n  \"AND\": {\n    \"left\": {\n      \"OR\": {\n        \"left\": {\n          \"raw_text\": \"Major depressive disorder with psychotic features\"\n        },\n        \"right\": {\n          \"OR\": {\n            \"left\": {\n              \"raw_text\": \"Traumatic Brain Injury (TBI) with a clear impact on activities of daily living\"\n            },\n            \"right\": {\n              \"OR\": {\n                \"left\": {\n                  \"raw_text\": \"Developmental delay, intellectual deficit, and/or severe educational disability resulting in some dependence for activities of daily living\"\n                },\n                \"right\": {\n                  \"AND\": {\n                    \"left\": {\n                      \"raw_text\": \"Ongoing substance use disorder with significant impact on activities of daily living. Difficult or impossible to determine whether cognitive or functional decline is due to substance use or HIV, or both\"\n                    },\n                    \"right\": {\n                      \"OR\": {\n                        \"left\": {\n                          \"raw_text\": \"Evidence of intoxication or withdrawal during the screening evaluation\"\n                        },\n                        \"right\": {\n                          \"OR\": {\n                            \"left\": {\n                              \"raw_text\": \"Central nervous system (CNS) infections or opportunistic conditions: brain abscess (bacterial, mycobacterial, fungal or Toxoplasma)\"\n                            },\n                            \"right\": {\n                              \"OR\": {\n                                \"left\": {\n                                  \"raw_text\": \"meningitis with persistent neurologic impairment, primary CNS lymphoma, progressive multifocal leukoencephalopathy (PML), or another structural brain lesion with neurological sequelae\"\n                                },\n                                \"right\": {\n                                  \"OR\": {\n                                    \"left\": {\n                                      \"raw_text\": \"Other CNS conditions: non-opportunistic primary or metastatic brain tumors, uncontrolled seizure disorder, progressive multiple sclerosis, stroke with neurological sequelae, or dementia due to causes other than HIV (eg, Alzheimer's disease)\"\n                                    },\n                                    \"right\": {\n                                      \"AND\": {\n                                        \"left\": {\n                                          \"raw_text\": \"Constitutional illness (eg, persistent unexplained fever, diarrhea, significant weight loss, disabling weakness) within 30 days of screening\"\n                                        },\n                                        \"right\": {\n                                          \"OR\": {\n                                            \"left\": {\n                                              \"raw_text\": \"Known untreated B12 deficiency or malnutrition (body mass index [BMI] less than 18) at screening\"\n                                            },\n                                            \"right\": {\n                                              \"OR\": {\n                                                \"left\": {\n                                                  \"raw_text\": \"Evidence of current hepatitis C virus infection (HCV) (ie, HCV antibody [Ab] positive within 90 days prior to study entry unless also shown to be plasma HCV RNA negative within the same time period)\"\n                                                },\n                                                \"right\": {\n                                                  \"AND\": {\n                                                    \"left\": {\n                                                      \"raw_text\": \"Unstable and advanced liver disease (as defined by the presence of at least one of the following: ascites, encephalopathy, coagulopathy, hypoalbuminemia, esophageal or gastric varices, or persistent jaundice)\"\n                                                    },\n                                                    \"right\": {\n                                                      \"OR\": {\n                                                        \"left\": {\n                                                          \"raw_text\": \"Prior or current use of any CCR5 antagonist (such as MVC and cenicriviroc [CVC]) and integrase inhibitor (such as RAL, DTG, and elvitegravir [EVG])\"\n                                                        },\n                                                        \"right\": {\n                                                          \"AND\": {\n                                                            \"left\": {\n                                                              \"raw_text\": \"Current use of any medication, including antiretrovirals, prohibited in the study (refer to the A5324 protocol-specific web page [PSWP] for the prohibited medications)\"\n                                                            },\n                                                            \"right\": {\n                                                              \"OR\": {\n                                                                \"left\": {\n                                                                  \"raw_text\": \"Breastfeeding\"\n                                                                },\n                                                                \"right\": {\n                                                                  \"OR\": {\n                                                                    \"left\": {\n                                                                      \"raw_text\": \"Presence of an AIDS-defining opportunistic infection within 6 months prior to entry. Note: Refer to the A5324 Manual of Operations (MOPS) for the list of AIDS-defining opportunistic infections.\"\n                                                                    },\n                                                                    \"right\": {\n                                                                      \"OR\": {\n                                                                        \"left\": {\n                                                                          \"raw_text\": \"Active syphilis or treatment for syphilis within 90 days prior to study entry. NOTE: Active syphilis is defined as four-fold increase in serum rapid plasma reagin (RPR) or venereal disease research laboratory (VDRL) tests in an individual with past syphilis, or newly reactive serum RPR or VDRL with a reactive confirmatory test (enzyme immunoassays [EIA] or chemiluminescent assay [CIA], T. pallidum particle agglutination [TP-PA], or fluorescent treponemal antibody absorbed [FTA-ABS]).\"\n                                                                        },\n                                                                        \"right\": {\n                                                                          \"OR\": {\n                                                                            \"left\": {\n                                                                              \"raw_text\": \"Known allergy/sensitivity or any hypersensitivity to components of study drugs or their formulation\"\n                                                                            }\n                                                                          }\n                                                                        }\n                                                                      }\n                                                                    }\n                                                                  }\n                                                                }\n                                                              }\n                                                            }\n                                                          }\n                                                        }\n                                                      }\n                                                    }\n                                                  }\n                                                }\n                                              }\n                                            }\n                                          }\n                                        }\n                                      }\n                                    }\n                                  }\n                                }\n                              }\n                            }\n                          }\n                        }\n                      }\n                    }\n                  }\n                }\n              }\n            }\n          }\n        }\n      }\n    }\n  }\n}"