"{\n  \"AND\": {\n    \"left\": {\n      \"NOT\": {\n        \"left\": {\n          \"OR\": {\n            \"left\": {\n              \"raw_text\": \"Children will be excluded if they have a history of developmental delay\"\n            },\n            \"right\": {\n              \"OR\": {\n                \"left\": {\n                  \"raw_text\": \"or inability to communicate the effects of an allergic reaction (non-verbal)\"\n                }\n              }\n            }\n          }\n        }\n      }\n    },\n    \"right\": {\n      \"AND\": {\n        \"left\": {\n          \"NOT\": {\n            \"left\": {\n              \"raw_text\": \"Any contraindication to allergy testing will also result in exclusion\"\n            }\n          }\n        },\n        \"right\": {\n          \"AND\": {\n            \"left\": {\n              \"OR\": {\n                \"left\": {\n                  \"raw_text\": \"(i.e. history of a severe allergic reaction to skin tests,\"\n                },\n                \"right\": {\n                  \"OR\": {\n                    \"left\": {\n                      \"raw_text\": \"anaphylaxis in the past six weeks\"\n                    },\n                    \"right\": {\n                      \"OR\": {\n                        \"left\": {\n                          \"raw_text\": \"pregnancy\"\n                        },\n                        \"right\": {\n                          \"OR\": {\n                            \"left\": {\n                              \"raw_text\": \"child took any antihistamine in the past three days [including diphenhydramine (Benadryl®), cetirizine (Zyrtec®), loratadine (Claritin®), fexofenadine (Allegra®), levocetirizine (Xyzal®), and desloratadine (Clarinex®)] or\"\n                            },\n                            \"right\": {\n                              \"OR\": {\n                                \"left\": {\n                                  \"raw_text\": \"child has a history of a condition that requires a beta blocker medicine for cardiac conditions, high blood pressure, migraine headaches, or eye drops for glaucoma (e.g. propranolol, metoprolol, atenolol and Timoptic®, or Betoptic® eye drops).\"\n                                }\n                              }\n                            }\n                          }\n                        }\n                      }\n                    }\n                  }\n                }\n              }\n            },\n            \"right\": {\n              \"AND\": {\n                \"left\": {\n                  \"raw_text\": \"Children who present to the PED with a rash, vomiting or current asthma symptoms including coughing, wheezing or breathing problems will also be excluded to ensure these do not mask reactions to an oral challenge.\"\n                },\n                \"right\": {\n                  \"AND\": {\n                    \"left\": {\n                      \"raw_text\": \"Patients being admitted to the hospital or those who are deemed too acutely ill for participation (triage level 1 or 2 or as determined by the ED patient care team) will be excluded from the study.\"\n                    },\n                    \"right\": {\n                      \"NOT\": {\n                        \"left\": {\n                          \"raw_text\": \"During this pilot study, we will exclude non-English speaking families. However, in subsequent studies we will include the non-English speaking population.\"\n                        }\n                      }\n                    }\n                  }\n                }\n              }\n            }\n          }\n        }\n      }\n    }\n  }\n}"