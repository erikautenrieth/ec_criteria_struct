"{\n  \"AND\": {\n    \"left\": {\n      \"OR\": {\n        \"left\": {\n          \"raw_text\": \"Female subjects who are pregnant\"\n        },\n        \"right\": {\n          \"OR\": {\n            \"left\": {\n              \"raw_text\": \"or breast-feeding\"\n            },\n            \"right\": {\n              \"raw_text\": \"or considering becoming pregnant during the study\"\n            }\n          }\n        }\n      }\n    },\n    \"right\": {\n      \"AND\": {\n        \"left\": {\n          \"raw_text\": \"Patients aged <18 years of age\"\n        },\n        \"right\": {\n          \"AND\": {\n            \"left\": {\n              \"raw_text\": \"Patients who cannot give informed consent,\"\n            },\n            \"right\": {\n              \"raw_text\": \"Pregnant patients or those who are breastfeeding will be deemed ineligible.\"\n            }\n          }\n        }\n      }\n    }\n  },\n  \"AND\": {\n    \"left\": {\n      \"OR\": {\n        \"left\": {\n          \"raw_text\": \"Prior treatment with any anti-TNF agent\"\n        },\n        \"right\": {\n          \"AND\": {\n            \"left\": {\n              \"raw_text\": \"Contra-indication to use of GLM (Hypersensitivity to the active substance or to any of the excipients;\"\n            },\n            \"right\": {\n              \"OR\": {\n                \"left\": {\n                  \"raw_text\": \"Active tuberculosis (TB), acute or chronic Hepatitis B infection or other severe infections such as sepsis and/or opportunistic infections including HIV infection;\"\n                },\n                \"right\": {\n                  \"raw_text\": \"Moderate or severe heart failure (NYHA class III/IV)\"\n                }\n              }\n            }\n          }\n        }\n      }\n    },\n    \"AND\": {\n      \"left\": {\n        \"OR\": {\n          \"left\": {\n            \"raw_text\": \"Have symptoms or signs suggestive of current active or latent TB upon medical history, physical examination and/or chest radiograph, or positive Mycobacterium tuberculosis antigen-specific interferon-gamma release assay (IGRA)\"\n          },\n          \"right\": {\n            \"raw_text\": \"Patients with a history of, or at imminent risk for, colectomy; who required gastrointestinal surgery within 2 months before screening;\"\n          }\n        }\n      },\n      \"right\": {\n        \"OR\": {\n          \"left\": {\n            \"raw_text\": \"History of colonic mucosal dysplasia or adenomatous colonic polyps that were not removed\"\n          },\n          \"right\": {\n            \"raw_text\": \"Screening stool study positive for enteric pathogens or Clostridium difficile toxin.\"\n          }\n        }\n      }\n    },\n    \"AND\": {\n      \"left\": {\n        \"OR\": {\n          \"left\": {\n            \"raw_text\": \"Oral corticosteroids at a dose >40 mg prednisone or its equivalent per day; receipt of cyclosporine, tacrolimus, sirolimus, or mycophenolate mofetil within 8 weeks before the first study agent injection; or use of an investigational agent within 5 half-lives of that agent before the first study agent injection.\"\n          }\n        },\n        \"right\": {\n          \"raw_text\": \"Patients in recent receipt of live vaccinations within 4 weeks prior to enrolment\"\n        }\n      }\n    }\n  }\n}"