"{\n  \"AND\": {\n    \"left\": {\n      \"OR\": {\n        \"left\": {\n          \"raw_text\": \"1. Decrease in size of the designated target ulcer(s) by ≥ 30% during the 7-day screening period\"\n        },\n        \"right\": {\n          \"OR\": {\n            \"left\": {\n              \"raw_text\": \"2. Cannot tolerate or comply with compression therapy.\"\n            },\n            \"right\": {\n              \"OR\": {\n                \"left\": {\n                  \"raw_text\": \"3. An ulcer which shows signs of severe clinical infection, defined as pus oozing from the ulcer site\"\n                },\n                \"right\": {\n                  \"OR\": {\n                    \"left\": {\n                      \"raw_text\": \"4. An ulcer positive for β-hemolytic streptococci upon culture\"\n                    },\n                    \"right\": {\n                      \"OR\": {\n                        \"left\": {\n                          \"raw_text\": \"5. The ulcer has > 50% slough, significant necrotic tissue, bone, tendon, or capsule exposure or avascular ulcer beds\"\n                        },\n                        \"right\": {\n                          \"OR\": {\n                            \"left\": {\n                              \"raw_text\": \"6. Is highly exuding (i.e. requires daily change of dressing)\"\n                            },\n                            \"right\": {\n                              \"OR\": {\n                                \"left\": {\n                                  \"raw_text\": \"7. Ankle brachial pressure index <0.65\"\n                                },\n                                \"right\": {\n                                  \"OR\": {\n                                    \"left\": {\n                                      \"raw_text\": \"8. Patients with active systemic infections\"\n                                    },\n                                    \"right\": {\n                                      \"OR\": {\n                                        \"left\": {\n                                          \"raw_text\": \"9. Patients with clinically significant medical conditions as determined by the investigator including renal, hepatic, hematologic, neurologic or immune disease. Examples include but are not limited to:\"\"\n                                        },\n                                        \"right\": {\n                                          \"OR\": {\n                                            \"left\": {\n                                              \"raw_text\": \"10. Renal insufficiency as an estimated GFR which is < 30 mL/min/1.7m2\"\n                                            },\n                                            \"right\": {\n                                              \"OR\": {\n                                                \"left\": {\n                                                  \"raw_text\": \"11. Abnormal blood biochemistry defined as 3 times that of the upper limit of the normal range.\"\n                                                },\n                                                \"right\": {\n                                                  \"OR\": {\n                                                    \"left\": {\n                                                      \"raw_text\": \"12. Hepatic insufficiency defined as total bilirubin > 2 mg/dL or serum albumin < 25 g/L\"\n                                                    },\n                                                    \"right\": {\n                                                      \"OR\": {\n                                                        \"left\": {\n                                                          \"raw_text\": \"13. HbA1c > 9%\"\n                                                        },\n                                                        \"right\": {\n                                                          \"OR\": {\n                                                            \"left\": {\n                                                              \"raw_text\": \"14. Hemoglobin < 10 g/dL\"\n                                                            },\n                                                            \"right\": {\n                                                              \"OR\": {\n                                                                \"left\": {\n                                                                  \"raw_text\": \"15. Hematocrit < 0.30\"\n                                                                },\n                                                                \"right\": {\n                                                                  \"OR\": {\n                                                                    \"left\": {\n                                                                      \"raw_text\": \"16. Platelet count < 100,000\"\n                                                                    },\n                                                                    \"right\": {\n                                                                      \"OR\": {\n                                                                        \"left\": {\n                                                                          \"raw_text\": \"17. Presence of an active systemic or local cancer or tumor of any kind (with the exception of non-melanoma skin cancer)\"\n                                                                        },\n                                                                        \"right\": {\n                                                                          \"OR\": {\n                                                                            \"left\": {\n                                                                              \"raw_text\": \"18. Patients with severe rheumatoid arthritis (with more than 20 persistently inflamed joints, or below lower normal limit blood albumin level, or evidence of bone and cartilage damage on x-ray, or inflammation in tissues other than joints) and other collagen vascular diseases.\"\n                                                                            },\n                                                                            \"right\": {\n                                                                              \"OR\": {\n                                                                                \"left\": {\n                                                                                  \"raw_text\": \"19. Patients with active connective tissue disease\"\n                                                                                },\n                                                                                \"right\": {\n                                                                                  \"OR\": {\n                                                                                    \"left\": {\n                                                                                      \"raw_text\": \"20. Treatment with systemic corticosteroids (>15 mg/day), or current immunosuppressive agents\"\n                                                                                    },\n                                                                                    \"right\": {\n                                                                                      \"OR\": {\n                                                                                        \"left\": {\n                                                                                          \"raw_text\": \"21. Previous or current radiation therapy or likelihood to receive this therapy during study participation\"\n                                                                                        },\n                                                                                        \"right\": {\n                                                                                          \"OR\": {\n                                                                                            \"left\": {\n                                                                                              \"raw_text\": \"22. Pregnant or nursing patients\"\n                                                                                            },\n                                                                                            \"right\": {\n                                                                                              \"OR\": {\n                                                                                                \"left\": {\n                                                                                                  \"raw_text\": \"23. Known prior inability or unavailability to complete required study visits during study participation\"\n                                                                                                },\n                                                                                                \"right\": {\n                                                                                                  \"OR\": {\n                                                                                                    \"left\": {\n                                                                                                      \"raw_text\": \"24. Significant peripheral edema as per investigator's discretion\"\n                                                                                                    },\n                                                                                                    \"right\": {\n                                                                                                      \"OR\": {\n                                                                                                        \"left\": {\n                                                                                                          \"raw_text\": \"25. A psychiatric condition (e.g., suicidal ideation) or chronic alcohol or drug abuse problem, determined from the patient's medical history, which, in the opinion of the investigator, may pose a threat to patient compliance\"\n                                                                                                        },\n                                                                                                        \"right\": {\n                                                                                                          \"OR\": {\n                                                                                                            \"left\": {\n                                                                                                              \"raw_text\": \"26. Use of a platelet-derived growth factor within 28 days before screening\"\n                                                                                                            },\n                                                                                                            \"right\": {\n                                                                                                              \"OR\": {\n                                                                                                                \"left\": {\n                                                                                                                  \"raw_text\": \"27. Use of any investigational drug or therapy within 28 days before screening\"\n                                                                                           