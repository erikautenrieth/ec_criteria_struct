"{\n  \"AND\": {\n    \"left\": {\n      \"NOT\": {\n        \"left\": {\n          \"OR\": {\n            \"left\": {\n              \"raw_text\": \"Use of any oral antidiabetic treatment except for metformin (i.e., sulphonylureas, DPP-IV inhibitors, thiazolidinediones, SGLT-2 inhibitors (Sodium dependent glucose transporter) or GLP-1 analogues (glucagone like peptide) within the last three months prior to Screening\"\n            },\n            \"right\": {\n              \"OR\": {\n                \"left\": {\n                  \"raw_text\": \"Repeated episodes of severe hypoglycaemia within the last six months prior to Screening\"\n                },\n                \"right\": {\n                  \"OR\": {\n                    \"left\": {\n                      \"raw_text\": \"History of diabetic ketoacidosis, precoma diabetica, or diabetic coma\"\n                    }\n                  }\n                }\n              }\n            }\n          }\n        }\n      }\n    },\n    \"right\": {\n      \"AND\": {\n        \"left\": {\n          \"NOT\": {\n            \"left\": {\n              \"OR\": {\n                \"left\": {\n                  \"raw_text\": \"Treatment with any other investigational drug within the last three months before Screening\"\n                },\n                \"right\": {\n                  \"OR\": {\n                    \"left\": {\n                      \"raw_text\": \"Acute infections within the last four weeks prior to Screening\"\n                    },\n                    \"right\": {\n                      \"OR\": {\n                        \"left\": {\n                          \"raw_text\": \"Recurrent urogenital infections\"\n                        }\n                      }\n                    }\n                  }\n                }\n              }\n            }\n          }\n        },\n        \"right\": {\n          \"AND\": {\n            \"left\": {\n              \"OR\": {\n                \"left\": {\n                  \"raw_text\": \"History of pancreatitis\"\n                },\n                \"right\": {\n                  \"OR\": {\n                    \"left\": {\n                      \"raw_text\": \"Anamnestic history of hypersensitivity to the study drugs or to drugs with similar chemical structures\"\n                    },\n                    \"right\": {\n                      \"OR\": {\n                        \"left\": {\n                          \"raw_text\": \"History of severe or multiple allergies\"\n                        }\n                      }\n                    }\n                  }\n                }\n              },\n              \"right\": {\n                \"AND\": {\n                  \"left\": {\n                    \"raw_text\": \"Concomitant participation in other clinical trials\"\n                  },\n                  \"right\": {\n                    \"OR\": {\n                      \"left\": {\n                        \"raw_text\": \"Type 1 diabetes\"\n                      },\n                      \"right\": {\n                        \"OR\": {\n                          \"left\": {\n                            \"raw_text\": \"Cardiovascular disease\"\n                          },\n                          \"right\": {\n                            \"OR\": {\n                              \"left\": {\n                                \"raw_text\": \"Clinically relevant ventricular tachycardia or ventricular fibrillation, 3rd degree AV block or Torsades de Pointes or treatment with antiarrhythmic drugs.\"\n                              },\n                              \"right\": {\n                                \"OR\": {\n                                  \"left\": {\n                                    \"raw_text\": \"Percutaneous coronary intervention within the past 6 months.\"\n                                  },\n                                  \"right\": {\n                                    \"OR\": {\n                                      \"left\": {\n                                        \"raw_text\": \"Any of the following within the past 6 months: myocardial infarction (MI), coronary artery bypass surgery; unstable angina; or stroke.\"\n                                      }\n                                    }\n                                  }\n                                }\n                              }\n                            }\n                          }\n                        }\n                      }\n                    }\n                  }\n                }\n              }\n            }\n          }\n        }\n      }\n    }\n  }\n}"