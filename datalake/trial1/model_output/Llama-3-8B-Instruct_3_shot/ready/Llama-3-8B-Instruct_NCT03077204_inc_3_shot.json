{
  "AND": {
    "left": {
      "AND": {
        "left": {
          "raw_text": "Age>18 years"
        },
        "right": {
          "AND": {
            "left": {
              "raw_text": "Scheduled 1 or 2-level ACDF spine surgery"
            },
            "right": {
              "AND": {
                "left": {
                  "raw_text": "The capacity to provide informed consent."
                },
                "right": {
                  "AND": {
                    "left": {
                      "OR": {
                        "left": {
                          "raw_text": "Degenerative Disc Disease"
                        },
                        "right": {
                          "raw_text": "(as defined by neck pain of discogenic origin with degeneration of the disc confirmed by patient history and radiographic studies)"
                        }
                      }
                    },
                    "right": {
                      "OR": {
                        "left": {
                          "raw_text": "Trauma"
                        },
                        "right": {
                          "OR": {
                            "left": {
                              "raw_text": "(including fractures)"
                            },
                            "right": {
                              "OR": {
                                "left": {
                                  "raw_text": "Tumors"
                                },
                                "right": {
                                  "OR": {
                                    "left": {
                                      "raw_text": "Deformities or curvatures"
                                    },
                                    "right": {
                                      "OR": {
                                        "left": {
                                          "raw_text": "(including kyphosis, lordosis, or scoliosis)"
                                        }
                                      }
                                    }
                                  }
                                }
                              }
                            }
                          }
                        }
                      }
                    }
                  }
                },
                "right": {
                  "AND": {
                    "left": {
                      "OR": {
                        "left": {
                          "raw_text": "Pseudoarthrosis"
                        },
                        "right": {
                          "OR": {
                            "left": {
                              "raw_text": "Failed previous fusion"
                            },
                            "right": {
                              "OR": {
                                "left": {
                                  "raw_text": "Decompression of the spinal cord"
                                },
                                "right": {
                                  "raw_text": "following total or partial cervical vertebrectomy"
                                }
                              }
                            }
                          }
                        }
                      },
                      "right": {
                        "OR": {
                          "left": {
                            "raw_text": "Spondylolisthesis"
                          },
                          "right": {
                            "OR": {
                              "left": {
                                "raw_text": "Spinal stenosis"
                              },
                              "right": {
                                "AND": {
                                  "left": {
                                    "OR": {
                                      "left": {
                                        "raw_text": "Patients with current or recent history of malignancy"
                                      },
                                      "right": {
                                        "OR": {
                                          "left": {
                                            "raw_text": "or infectious disease."
                                          }
                                        }
                                      }
                                    }
                                  },
                                  "right": {
                                    "OR": {
                                      "left": {
                                        "raw_text": "The inability to provide informed consent."
                                      }
                                    }
                                  }
                                }
                              }
                            }
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "right": {
      "AND": {
        "left": {
          "OR": {
            "left": {
              "raw_text": "Subject has marked local inflammation"
            },
            "right": {
              "OR": {
                "left": {
                  "raw_text": "Subject has any mental or neuromuscular disorder"
                },
                "right": {
                  "OR": {
                    "left": {
                      "raw_text": "which would create an unacceptable risk of fixation failure or complications in postoperative care."
                    }
                  }
                }
              }
            }
          },
          "right": {
            "OR": {
              "left": {
                "raw_text": "Subject has a bone stock compromised by disease, infection or prior implantation"
              },
              "right": {
                "OR": {
                  "left": {
                    "raw_text": "which cannot provide adequate support and/or fixation to the devices."
                  }
                }
              }
            }
          }
        },
        "right": {
          "OR": {
            "left": {
              "raw_text": "Subject has bone abnormalities preventing safe screw fixation."
            },
            "right": {
              "OR": {
                "left": {
                  "raw_text": "Subject has any open wounds."
                },
                "right": {
                  "OR": {
                    "left": {
                      "raw_text": "Subject has rapid joint disease, bone absorption, osteopenia, osteomalacia, and/or osteoporosis."
                    },
                    "right": {
                      "OR": {
                        "left": {
                          "raw_text": "Osteoporosis or osteopenia are relative contraindications, since this condition may limit the degree of obtainable correction and/or the amount of mechanical fixation."
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}