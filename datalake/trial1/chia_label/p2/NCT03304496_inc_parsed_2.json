                        },
                        "right": {
                          "NOT": {
                            "left": {
                              "OR": {
                                "left": {
                                  "raw_text": "ithout timely reperfusion therapy) with less than 4 weeks of evolution. Acute myocardial infarction"
                                },
                                "right": {
                                  "OR": {
                                    "left": {
                                      "raw_text": "with ST-segment elevation, successful thrombolytic therapy, which will undergo drug-invasive therapy. Acute myocardial infarction"
                                    },
                                    "right": {
                                      "NOT": {
                                        "left": {
                                          "OR": {
                                            "left": {
                                              "raw_text": "ithout ST segment elevation. Unstable angina."
                                            },
                                            "right": {
                                              "OR": {
