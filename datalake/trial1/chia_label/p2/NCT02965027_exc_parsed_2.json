                                                                                                                                  "OR": {
                                                                                                                                    "left": {
                                                                                                                                      "raw_text": "a), and avanafil (Ste"
                                                                                                                                    },
                                                                                                                                    "right": {
                                                                                                                                      "raw_text": "ndra) will not be permitted during the study drug dose Titration Period, because of increased risk of hypotension in combination with alpha-1 blockers, but will be allowed at half the usual starting dose following the study drug dose Titration Period, per VA prescribing guidelines."
                                                                                                                                    }
