                                                                                "right": {
                                                                                  "OR": {
                                                                                    "left": {
                                                                                      "raw_text": ", serious heart rhythm abnormalities"
                                                                                    },
                                                                                    "right": {
                                                                                      "OR": {
                                                                                        "left": {
                                                                                          "raw_text": ", or a family history of sudden death"
                                                                                        },
