                            "left": {
                              "OR": {
                                "left": {
                                  "raw_text": "with the exception of approved treatments for dementia"
                                },
                                "right": {
                                  "OR": {
                                    "left": {
                                      "raw_text": "(ChEIs and memantine), selective serotonin reuptake inhibitor antidepressants"
                                    },
                                    "right": {
                                      "AND": {
                                        "left": {
                                          "raw_text": ", and trazodone (if used as an aid to facilitate sleep and not as an antidepressant); other psychotropics"
                                        },
                                        "right": {
                                          "NOT": {
                                            "left": {
                                              "raw_text": "with the exclusion of antipsychotics), if stable for 3 months, may be allowed only with Steering Committee approval on a case by case basis. Note that antipsychotics are expressly prohibited."
