              "raw_text": "or expected to require mechanical ventilation for < 24 hours"
            }
          }
        },
        "right": {
          "AND": {
            "left": {
              "raw_text": "3. Condition that precludes placement of an esophageal balloon"
            },
            "right": {
              "OR": {
                "left": {
                  "raw_text": "esophageal or nasopharyngeal pathology preventing insertion of the esophageal balloon catheter (esophageal ulcerations, tumors, diverticulitis, bleeding varices"
                },
                "right": {
                  "OR": {
                    "left": {
                      "raw_text": "or in patients with sinusitis,"
                    },
                    "right": {
                      "OR": {
                        "left": {
                          "raw_text": "epistaxis"
                        },
                        "right": {
                          "raw_text": "or recent nasopharyngeal surgery), severe thrombocytopenia (platelet count < 30) or coagulopathy (INR > 3 or on oral anticoagulants)."
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "right": {
    "AND": {
      "left": {
        "raw_text": "4. Pre-enrollment ICP > 20 mm Hg"
      },
      "right": {
        "AND": {
          "left": {
            "raw_text": "5. Pre-enrollment CPP < 60 mm Hg"
          },
          "right": {
            "AND": {
              "left": {
                "raw_text": "6. Planned change in the external ventricular drain set point during the pre-intervention, intervention or post-intervention periods"
              },
              "right": {
                "AND": {
                  "left": {
                    "raw_text": "7. Incarceration"
                  },
                  "right": {
                    "raw_text": "8. Variation in ICP of > 2 cm H2O in the hour prior to intervention."
