             "Eq-Temporal-Period": [\n                    "Regular"\n                  ],\n                  "Drug": [\n                    "medications"\n                  ],\n                  "Modifier": [\n                    "non-topical"\n                  ],\n                  "Study": [\n                    "clinical research center"\n                  ],\n                  "Eq-Temporal-Unit": [\n                    "days"\n                  ]\n                }\n              }\n            },\n            "right": {\n              "raw_text": "- Smoking within 60 days prior to drug administration and through the follow-up visit",\n              "Procedure": [\n                "drug administration"\n              ],\n              "Observation": [\n                "Smoking"\n              ],\n              "Eq-Comparison": [\n                "within 60 days"\n              ],\n              "Eq-Operator": [\n                "-",\n                "within"\n              ],\n              "Eq-Value": [\n                "60"\n              ],\n              "Eq-Temporal-Unit": [\n                "days"\n              ],\n              "Observation-Name": [\n                "Smoking"\n              ],\n              "Procedure-Name": [\n                "drug administration"\n              ],\n              "Encounter": [\n                "follow-up visit"\n              ]\n            }\n          }\n        },\n        "right": {\n          "OR": {\n            "left": {\n              "raw_text": "- History of alcohol abuse",\n              "Eq-Comparison": [\n                "History"\n              ],\n              "Condition": [\n                "abuse"\n              ],\n              "Eq-Operator": [\n                "-"\n              ],\n              "Eq-Temporal-Period": [\n                "History"\n              ],\n              "Condition-Name": [\n                "abuse"\n              ],\n              "Drug": [\n                "alcohol"\n              ],\n              "Drug-Name": [\n                "alcohol"\n              ]\n            },\n            "right": {\n              "OR": {\n                "left": {\n                  "raw_text": "or drug addiction (including soft drugs like cannabis products)",\n                  "Condition": [\n                    "addiction"\n                  ],\n                  "Drug": [\n                    "drug",\n                    "soft drugs",\n                    "cannabis products"\n                  ],\n                  "Condition-Name": [\n                    "addiction"\n                  ],\n                  "Drug-Name": [\n                    "soft drugs",\n                    "cannabis products"\n                  ]\n                },\n                "right": {\n                  "raw_text": "including soft drugs like cannabis products)",\n                  "Drug": [\n                    "soft drugs",\n                    "cannabis products"\n                  ],\n                  "Drug-Name": [\n                    "soft drugs",\n                    "cannabis products"\n                  ]\n                }\n              }\n            }\n          }\n        }\n      }\n    },\n    "right": {\n      "raw_text": "Other in- and exclusion criteria may apply"\n    }\n  }\n}<|eot_id|>']
