atients with hemodynamic instability",\n                      "Condition": [\n                        "hemodynamic"\n                      ],\n                      "Condition-Name": [\n                        "hemodynamic"\n                      ],\n                      "Stability": [\n                        "instability"\n                      ]\n                    }\n                  }\n                },\n                "right": {\n                  "raw_text": "- Amputees",\n                  "Condition": [\n                    "Amputees"\n                  ],\n                  "Condition-Name": [\n                    "Amputees"\n                  ]\n                }\n              }\n            },\n            "right": {\n              "raw_text": "- Patients with cognitive impairment",\n              "Condition": [\n                "cognitive impairment"\n              ],\n              "Condition-Name": [\n                "cognitive impairment"\n              ]\n            }\n          }\n        },\n        "right": {\n          "raw_text": "- Patients with acute renal failure",\n          "Condition": [\n            "renal failure"\n          ],\n          "Condition-Name": [\n            "renal failure"\n          ],\n          "Acuteness": [\n            "acute"\n          ]\n        }\n      }\n    },\n    "right": {\n      "raw_text": "- Patients with graft loss",\n      "Condition": [\n        "graft loss"\n      ],\n      "Condition-Name": [\n        "graft loss"\n      ]\n    }\n  }\n}<|eot_id|>']
