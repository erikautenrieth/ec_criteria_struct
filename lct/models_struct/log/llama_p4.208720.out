ictions, return an empty JSON FILE {}\n- The entire text of the eligibility criteria must be included and separated by the logical operators, without omitting any words or information.\n- The output should only contain the JSON object, without any additional text or formatting.\n- Ensure that the JSON output strictly follows these rules and accurately represents the logical structure of the input eligibility criteria.\n\n### Input:\n-  Insufficient corneal thickness\n-  Ocular condition that may predispose the eye to complications\n-  History of chemical injury or delayed epithelial healing\n-  Condition that would interfere with or prolong epithelial healing\n-  Known sensitivity to treatment medications\n-  Pregnancy\n\n### Response:\n{\n  "AND": {\n    "left": {\n      "AND": {\n        "left": {\n          "AND": {\n            "left": {\n              "AND": {\n                "left": {\n                  "AND": {\n                    "left": {\n                      "raw_text": "- Insufficient corneal thickness",\n                      "Observation": [\n                        "corneal thickness"\n                      ],\n                      "Observation-Name": [\n                        "corneal thickness"\n                      ],\n                      "Polarity": [\n                        "Insufficient"\n                      ]\n                    },\n                    "right": {\n                      "raw_text": "- Ocular condition that may predispose the eye to complications",\n                      "Condition": [\n                        "Ocular condition"\n                      ],\n                      "Condition-Name": [\n                        "Ocular condition"\n                      ],\n                      "Assertion": [\n                        "may"\n                      ],\n                      "Condition": [\n                        "complications"\n                      ],\n                      "Condition-Name": [\n                        "complications"\n                      ],\n                      "Modifier": [\n                        "eye"\n                      ]\n                    }\n                  }\n                },\n                "right": {\n                  "OR": {\n                    "left": {\n                      "raw_text": "- History of chemical injury",\n                      "Eq-Comparison": [\n                        "History"\n                      ],\n                      "Eq-Temporal-Period": [\n                        "History"\n                      ],\n                      "Observation": [\n                        "chemical injury"\n                      ],\n                      "Observation-Name": [\n                        "chemical injury"\n                      ]\n                    },\n                    "right": {\n                      "raw_text": "or delayed epithelial healing",\n                      "Observation": [\n                        "epithelial healing"\n                      ],\n                      "Observation-Name": [\n                        "epithelial healing"\n                      ],\n                      "Modifier": [\n                        "delayed"\n                      ]\n                    }\n                  }\n                }\n              }\n            },\n            "right": {\n              "OR": {\n                "left": {\n                  "raw_text": "- Condition that would interfere with",\n                  "Condition": [\n                    "Condition"\n                  ],\n                  "Assertion": [\n                    "would"\n                  ],\n                  "Stability": [\n                    "interfere with"\n                  ]\n                },\n                "right": {\n                  "raw_text": "or prolong epithelial healing",\n                  "Observation": [\n                    "epithelial healing"\n                  ],\n                  "Observation-Name": [\n                    "epithelial healing"\n                  ],\n                  "Acuteness": [\n                    "prolong"\n                  ]\n                }\n              }\n            }\n          }\n        },\n        "right": {\n          "raw_text": "- Known sensitivity to treatment medications",\n          "Procedure": [\n            "treatment"\n          ],\n          "Drug": [\n            "medications"\n          ],\n          "Condition": [\n            "sensitivity"\n          ],\n          "Condition-Name": [\n            "sensitivity"\n          ]\n        }\n      }\n    },\n    "right": {\n      "raw_text": "- Pregnancy",\n      "Condition": [\n        "Pregnancy"\n      ],\n      "Condition-Name": [\n        "Pregnancy"\n      ]\n    }\n  }\n}<|eot_id|>']
