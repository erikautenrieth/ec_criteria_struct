ictions, return an empty JSON FILE {}\n- The entire text of the eligibility criteria must be included and separated by the logical operators, without omitting any words or information.\n- The output should only contain the JSON object, without any additional text or formatting.\n- Ensure that the JSON output strictly follows these rules and accurately represents the logical structure of the input eligibility criteria.\n\n### Input:\n-  Testosterone naive\n-  Transgender male\n-  14-19 years old\n\n### Response:\n{\n  "AND": {\n    "left": {\n      "AND": {\n        "left": {\n          "raw_text": "- Testosterone naive",\n          "Drug": [\n            "Testosterone"\n          ],\n          "Drug-Name": [\n            "Testosterone"\n          ],\n          "Negation": [\n            "naive"\n          ]\n        },\n        "right": {\n          "raw_text": "- Transgender male",\n          "Life-Stage-And-Gender": [\n            "male"\n          ],\n          "Condition": [\n            "Transgender"\n          ],\n          "Condition-Name": [\n            "Transgender"\n          ]\n        }\n      }\n    },\n    "right": {\n      "raw_text": "- 14-19 years old",\n      "Eq-Temporal-Unit": [\n        "years"\n      ],\n      "Age": [\n        "old"\n      ],\n      "Eq-Operator": [\n        "-"\n      ],\n      "Eq-Value": [\n        "14",\n        "19"\n      ],\n      "Eq-Comparison": [\n        "14-19 years"\n      ]\n    }\n  }\n}<|eot_id|>']
Response: {
  "AND": {
    "left": {
      "AND": {
        "left": {
          "raw_text": "- Testosterone naive",
          "Drug": [
            "Testosterone"
          ],
          "Drug-Name": [
            "Testosterone"
          ],
          "Negation": [
            "naive"
          ]
        },
        "right": {
          "raw_text": "- Transgender male",
          "Life-Stage-And-Gender": [
            "male"
          ],
          "Condition": [
            "Transgender"
          ],
          "Condition-Name": [
            "Transgender"
          ]
        }
      }
    },
    "right": {
      "raw_text": "- 14-19 years old",
      "Eq-Temporal-Unit": [
        "years"
      ],
      "Age": [
        "old"
      ],
      "Eq-Operator": [
        "-"
      ],
      "Eq-Value": [
        "14",
        "19"
      ],
      "Eq-Comparison": [
        "14-19 years"
      ]
    }
  }
}
