ictions, return an empty JSON FILE {}\n- The entire text of the eligibility criteria must be included and separated by the logical operators, without omitting any words or information.\n- The output should only contain the JSON object, without any additional text or formatting.\n- Ensure that the JSON output strictly follows these rules and accurately represents the logical structure of the input eligibility criteria.\n\n### Input:\n-  Factors that affect immune function or AKI assessment are the basis for\n-  Concurrent disease associated with immunosuppression including malignancy, chronic infection (e.g., HIV, Hepatitis C), organ transplant and immunosuppressant medications\n-  Documented acute infection with the past 1 month (e.g., pneumonia, urinary tract infection)\n-  Prednisone or other steroid use currently or within the past one month\n-  AKI at the time of surgery\n-  ESRD requiring renal replacement therapy\n-  Estimated GFR <45 mL/min (as judged by the Chronic Kidney Disease Epidemiology Collaboration (CKD-EPI) equation\n\n### Response:\n{\n  "AND": {\n    "left": {\n      "AND": {\n        "left": {\n          "AND": {\n            "left": {\n              "AND": {\n                "left": {\n                  "AND": {\n                    "left": {\n                      "AND": {\n                        "left": {\n                          "AND": {\n                            "left": {\n                              "raw_text": "- Factors that affect immune function",\n                              "Condition": [\n                                "immune function"\n                              ],\n                              "Condition-Name": [\n                                "immune function"\n                              ],\n                              "Stability": [\n                                "affect"\n                              ]\n                            },\n                            "right": {\n                              "OR": {\n                                "left": {\n                                  "raw_text": "or AKI assessment are the basis for",\n                                  "Condition": [\n                                    "AKI"\n                                  ],\n                                  "Condition-Name": [\n                                    "AKI"\n                                  ],\n                                  "Procedure": [\n                                    "assessment"\n                                  ],\n                                  "Procedure-Name": [\n                                    "assessment"\n                                  ]\n                                },\n                                "right": {\n                                  "raw_text": "Concurrent disease associated with immunosuppression including malignancy, chronic infection (e.g., HIV, Hepatitis C), organ transplant and immunosuppressant medications",\n                                  "Condition": [\n                                    "disease",\n                                    "immunosuppression",\n                                    "infection",\n                                    "malignancy",\n                                    "HIV",\n                                    "Hepatitis C"\n                                  ],\n                                  "Condition-Name": [\n                                    "immunosuppression",\n                                    "infection",\n                                    "malignancy",\n                                    "HIV",\n                                    "Hepatitis C"\n                                  ],\n                                  "Acuteness": [\n                                    "chronic"\n                                  ],\n                                  "Procedure": [\n                                    "organ transplant"\n                                  ],\n                                  "Procedure-Name": [\n                                    "organ transplant"\n                                  ],\n                                  "Drug": [\n                                    "immunosuppressant medications"\n                                  ],\n                                  "Drug-Name": [\n                                    "immunosuppressant medications"\n                                  ],\n                                  "Modifier": [\n                                    "Concurrent"\n                                  ]\n                                }\n                              }\n                            }\n                          }\n                        },\n                        "right": {\n                          "OR": {\n                            "left": {\n                              "raw_text": "- Documented acute infection with the past 1 month (e.g., pneumonia,",\n                              "Condition": [\n                                "infection",\n                                "pneumonia"\n                              ],\n                              "Condition-Name": [\n                                "infection",\n                                "pneumonia"\n                              ],\n                              "Eq-Comparison": [\n                                "past 1 month"\n                              ],\n                              "Eq-Temporal-Period": [\n                                "past"\n                              ],\n                              "Eq-Value": [\n                                "1"\n                              ],\n                              "Eq-Operator": [\n                                "-"\n                              ],\n                              "Eq-Temporal-Unit": [\n                                "month"\n                              ],\n                              "Acuteness": [\n                                "acute"\n                              ]\n                            },\n                            "right": {\n                              "OR": {\n                                "left": {\n                                  "raw_text": "urinary tract infection)",\n                                  "Condition": [\n                                    "infection"\n                                  ],\n                                  "Condition-Name": [\n                                    "infection"\n                                  ],\n                                  "Modifier": [\n                                    "urinary tract"\n                                  ]\n                                },\n                                "right": {\n                                  "raw_text": "or other steroid use currently or within the past one month",\n                                  "Eq-Comparison": [\n                                    "currently",\n                                    "past one month"\n                                  ],\n                                  "Eq-Temporal-Period": [\n                                    "currently",\n                                    "past"\n                                  ],\n                                  "Eq-Value": [\n                                    "one"\n                                  ],\n                                  "Eq-Operator": [\n                                    "-"\n                                  ],\n                                  "Eq-Temporal-Unit": [\n                                    "month"\n                                  ],\n                                  "Drug": [\n                                    "steroid"\n                                  ],\n                                  "Drug-Name": [\n                                    "steroid"\n                                  ],\n                                  "Other": [\n                                    "other"\n                                  ]\n                                }\n                              }\n                            }\n                          }\n                        }\n                      }\n                    },\n                    "right": {\n                      "raw_text": "- AKI at the time of surgery",\n                      "Condition": [\n                        "AKI"\n                      ],\n                      "Condition-Name": [\n                        "AKI"\n                      ],\n                      "Procedure": [\n                        "surgery"\n                      ],\n                      "Procedure-Name": [\n                        "surgery"\n                      ],\n                      "Eq-Operator": [\n                        "-"\n                      ]\n                    }\n                  }\n                },\n                "right": {\n                  "raw_text": "- ESRD requiring renal replacement therapy",\n                  "Condition": [\n                    "ESRD"\n                  ],\n                  "Condition-Name": [\n                    "ESRD"\n                  ],\n                  "Procedure": [\n                    "renal replacement therapy"\n                  ],\n                  "Procedure-Name": [\n                    "renal replacement therapy"\n                  ],\n                  "Eq-Operator": [\n                    "-"\n                  ],\n                  "Assertion": [\n                    "requiring"\n                  ]\n                }\n              }\n            },\n            "right": {\n              "raw_text": "- Estimated GFR <45 mL/min (as judged by the Chronic Kidney Disease Epidemiology Collaboration (CKD-EPI) equation",\n              "Observation": [\n                "Estimated GFR"\n              ],\n              "Observation-Name": [\n                "Estimated GFR"\n              ],\n              "Eq-Comparison": [\n                "<45 mL/min"\n              ],\n              "Eq-Operator": [\n                "<",\n                "-"\n              ],\n              "Eq-Value": [\n                "45"\n              ],\n              "Eq-Unit": [\n                "mL"\n              ],\n              "Eq-Temporal-Unit": [\n                "min"\n              ]\n            }\n          }\n        },\n        "right": {\n          "raw_text": "and serum creatinine >152μmol/L).",\n          "Observation": [\n            "serum creatinine"\n          ],\n          "Observation-Name": [\n            "serum creatinine"\n          ],\n          "Eq-Comparison": [\n            ">152μmol/L"\n          ],\n          "Eq-Operator": [\n            ">"\n          ],\n          "Eq-Value": [\n            "152"\n          ],\n          "Eq-Unit": [\n            "μmol",\n            "L"\n          ]\n        }\n      }\n    },\n    "right": {\n      "raw_text": "For the purpose of this study, the following definition of AKI will be used: AKI is defined as a sudden increase in serum creatinine of ≥0.3 mg/dL or a percentage increase of ≥50% from baseline that is known or suspected to have occurred within 48 hours.",\n      "Condition": [\n        "AKI"\n      ],\n      "Condition-Name": [\n        "AKI"\n      ],\n      "Observation": [\n        "serum creatinine"\n      ],\n      "Observation-Name": [\n        "serum creatinine"\n      ],\n      "Eq-Comparison": [\n        "≥0.3 mg/dL",\n        "≥50%",\n        "within 48 hours"\n      ],\n      "Eq-Operator": [\n        "≥",\n        "within"\n      ],\n      "Eq-Value": [\n        "0.3",\n        "50",\n        "48"\n      ],\n      "Eq-Unit": [\n        "mg",\n        "dL",\n        "%"\n      ],\n      "Eq-Temporal-Unit": [\n        "hours"\n      ],\n      "Modifier": [\n        "sudden increase"\n      ],\n      "Study": [\n        "study"\n      ],\n      "Assertion": [\n        "suspected"\n      ]\n    }\n  }\n}<|eot_id|>']
