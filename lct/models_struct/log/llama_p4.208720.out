inoma"\n                                                                                    ],\n                                                                                    "Condition-Name": [\n                                                                                    "thymoma",\n                                                                                    "carcinoma"\n                                                                                    ],\n                                                                                    "Procedure": [\n                                                                                    "untreated"\n                                                                                    ],\n                                                                                    "Eq-Comparison": [\n                                                                                    "History"\n                                                                                    ],\n                                                                                    "Eq-Temporal-Period": [\n                                                                                    "History"\n                                                                                    ],\n                                                                                    "Modifier": [\n                                                                                    "thymic"\n                                                                                    ]\n                                                                                    }\n                                                                                    },\n                                                                                    "right": {\n                                                                                    "OR": {\n          