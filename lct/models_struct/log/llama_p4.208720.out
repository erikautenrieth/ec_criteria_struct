ictions, return an empty JSON FILE {}\n- The entire text of the eligibility criteria must be included and separated by the logical operators, without omitting any words or information.\n- The output should only contain the JSON object, without any additional text or formatting.\n- Ensure that the JSON output strictly follows these rules and accurately represents the logical structure of the input eligibility criteria.\n\n### Input:\n1. 20-70 age\n2. Chronic ankle sprain more than 3months with chronic ankle pain or instability sensation\n3. Ultrasound diagnosed anterior talofibular ligament sprain\n\n### Response:\n{\n  "AND": {\n    "left": {\n      "AND": {\n        "left": {\n          "raw_text": "1. 20-70 age",\n          "Age": [\n            "age"\n          ],\n          "Eq-Comparison": [\n            "20-70"\n          ],\n          "Eq-Value": [\n            "20",\n            "70"\n          ],\n          "Eq-Operator": [\n            "to"\n          ]\n        },\n        "right": {\n          "OR": {\n            "left": {\n              "raw_text": "2. Chronic ankle sprain more than 3months with chronic ankle pain",\n              "Condition": [\n                "ankle sprain"\n              ],\n              "Condition-Name": [\n                "ankle sprain"\n              ],\n              "Eq-Comparison": [\n                "more than 3months"\n              ],\n              "Eq-Operator": [\n                "more than"\n              ],\n              "Eq-Value": [\n                "3"\n              ],\n              "Eq-Temporal-Unit": [\n                "months"\n              ],\n              "Modifier": [\n                "ankle"\n              ],\n              "Observation": [\n                "pain"\n              ],\n              "Observation-Name": [\n                "pain"\n              ],\n              "Acuteness": [\n                "Chronic"\n              ]\n            },\n            "right": {\n              "raw_text": "or instability sensation",\n              "Condition": [\n                "instability sensation"\n              ],\n              "Condition-Name": [\n                "instability sensation"\n              ]\n            }\n          }\n        }\n      }\n    },\n    "right": {\n      "raw_text": "3. Ultrasound diagnosed anterior talofibular ligament sprain",\n      "Condition": [\n        "sprain"\n      ],\n      "Condition-Name": [\n        "sprain"\n      ],\n      "Modifier": [\n        "anterior talofibular ligament"\n      ],\n      "Procedure": [\n        "Ultrasound"\n      ],\n      "Procedure-Name": [\n        "Ultrasound"\n      ]\n    }\n  }\n}<|eot_id|>']
