ictions, return an empty JSON FILE {}\n- The entire text of the eligibility criteria must be included and separated by the logical operators, without omitting any words or information.\n- The output should only contain the JSON object, without any additional text or formatting.\n- Ensure that the JSON output strictly follows these rules and accurately represents the logical structure of the input eligibility criteria.\n\n### Input:\n-  Patients\' age from 18 to 60 years old,\n-  physical status ASA I-II (by the American Society of Anesthesiologists),\n-  Elective unilateral open inguinal hernia repair,\n-  Under spinal anesthesia\n\n### Response:\n{\n  "AND": {\n    "left": {\n      "AND": {\n        "left": {\n          "AND": {\n            "left": {\n              "raw_text": "- Patients\' age from 18 to 60 years old,",\n              "Eq-Temporal-Unit": [\n                "years"\n              ],\n              "Age": [\n                "age"\n              ],\n              "Eq-Operator": [\n                "to"\n              ],\n              "Eq-Value": [\n                "18",\n                "60"\n              ],\n              "Eq-Comparison": [\n                "18 to 60 years"\n              ]\n            },\n            "right": {\n              "raw_text": "- physical status ASA I-II (by the American Society of Anesthesiologists),",\n              "Observation": [\n                "ASA"\n              ],\n              "Observation-Name": [\n                "ASA"\n              ],\n              "Eq-Comparison": [\n                "I-II"\n              ],\n              "Eq-Value": [\n                "I",\n                "II"\n              ]\n            }\n          }\n        },\n        "right": {\n          "raw_text": "- Elective unilateral open inguinal hernia repair,",\n          "Procedure": [\n            "inguinal hernia repair"\n          ],\n          "Procedure-Name": [\n            "inguinal hernia repair"\n          ],\n          "Modifier": [\n            "unilateral open"\n          ],\n          "Eq-Comparison": [\n            "Elective"\n          ],\n          "Eq-Temporal-Period": [\n            "Elective"\n          ]\n        }\n      }\n    },\n    "right": {\n      "raw_text": "- Under spinal anesthesia",\n      "Procedure": [\n        "spinal anesthesia"\n      ],\n      "Procedure-Name": [\n        "spinal anesthesia"\n      ],\n      "Eq-Comparison": [\n        "Under"\n      ],\n      "Eq-Temporal-Period": [\n        "Under"\n      ]\n    }\n  }\n}<|eot_id|>']
