ictions, return an empty JSON FILE {}\n- The entire text of the eligibility criteria must be included and separated by the logical operators, without omitting any words or information.\n- The output should only contain the JSON object, without any additional text or formatting.\n- Ensure that the JSON output strictly follows these rules and accurately represents the logical structure of the input eligibility criteria.\n\n### Input:\n-  Evidence of Crohn\'s disease, indeterminate colitis, or presence of bacterial or parasitic infection.\n-  Patients receiving biologic agents and experimental agents are excluded.\n\n### Response:\n{\n  "AND": {\n    "left": {\n      "OR": {\n        "left": {\n          "raw_text": "- Evidence of Crohn\'s disease,",\n          "Condition": [\n            "Crohn\'s disease"\n          ],\n          "Condition-Name": [\n            "Crohn\'s disease"\n          ]\n        },\n        "right": {\n          "OR": {\n            "left": {\n              "raw_text": "indeterminate colitis,",\n              "Condition": [\n                "indeterminate colitis"\n              ],\n              "Condition-Name": [\n                "indeterminate colitis"\n              ]\n            },\n            "right": {\n              "OR": {\n                "left": {\n                  "raw_text": "or presence of bacterial",\n                  "Modifier": [\n                    "bacterial"\n                  ]\n                },\n                "right": {\n                  "raw_text": "or parasitic infection.",\n                  "Condition": [\n                    "infection"\n                  ],\n                  "Condition-Name": [\n                    "infection"\n                  ],\n                  "Modifier": [\n                    "parasitic"\n                  ]\n                }\n              }\n            }\n          }\n        }\n      }\n    },\n    "right": {\n      "OR": {\n        "left": {\n          "raw_text": "- Patients receiving biologic agents",\n          "Eq-Comparison": [\n            "receiving"\n          ],\n          "Drug": [\n            "biologic agents"\n          ],\n          "Eq-Temporal-Period": [\n            "receiving"\n          ],\n          "Drug-Name": [\n            "biologic agents"\n          ]\n        },\n        "right": {\n          "raw_text": "and experimental agents are excluded.",\n          "Drug": [\n            "experimental agents"\n          ],\n          "Drug-Name": [\n            "experimental agents"\n          ]\n        }\n      }\n    }\n  }\n}<|eot_id|>']
