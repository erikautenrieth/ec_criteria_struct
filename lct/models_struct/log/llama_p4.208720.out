ictions, return an empty JSON FILE {}\n- The entire text of the eligibility criteria must be included and separated by the logical operators, without omitting any words or information.\n- The output should only contain the JSON object, without any additional text or formatting.\n- Ensure that the JSON output strictly follows these rules and accurately represents the logical structure of the input eligibility criteria.\n\n### Input:\n-  Age <30 years old\n-  Screening mammography with only calcifications abnormalities\n-  Male patients\n-  Pregnant or lactating patients\n-  Patients with any allergy to iodinated contrast\n-  Patients with eGFR < 45\n-  Patients that may be treated with radioactive iodine\n\n### Response:\n{\n  "AND": {\n    "left": {\n      "AND": {\n        "left": {\n          "AND": {\n            "left": {\n              "AND": {\n                "left": {\n                  "AND": {\n                    "left": {\n                      "AND": {\n                        "left": {\n                          "raw_text": "- Age <30 years old",\n                          "Age": [\n                            "Age"\n                          ],\n                          "Eq-Comparison": [\n                            "<30 years"\n                          ],\n                          "Eq-Operator": [\n                            "<"\n                          ],\n                          "Eq-Value": [\n                            "30"\n                          ],\n                          "Eq-Temporal-Unit": [\n                            "years"\n                          ]\n                        },\n                        "right": {\n                          "raw_text": "- Screening mammography with only calcifications abnormalities",\n                          "Procedure": [\n                            "mammography"\n                          ],\n                          "Procedure-Name": [\n                            "mammography"\n                          ],\n                          "Observation": [\n                            "calcifications"\n                          ],\n                          "Observation-Name": [\n                            "calcifications"\n                          ],\n                          "Polarity": [\n                            "abnormalities"\n                          ],\n                          "Modifier": [\n                            "only"\n                          ],\n                          "Study": [\n                            "Screening"\n                          ]\n                        }\n                      }\n                    },\n                    "right": {\n                      "raw_text": "- Male patients",\n                      "Life-Stage-And-Gender": [\n                        "Male"\n                      ]\n                    }\n                  }\n                },\n                "right": {\n                  "OR": {\n                    "left": {\n                      "raw_text": "- Pregnant",\n                      "Condition": [\n                        "Pregnant"\n                      ],\n                      "Condition-Name": [\n                        "Pregnant"\n                      ]\n                    },\n                    "right": {\n                      "raw_text": "or lactating patients",\n                      "Condition": [\n                        "lactating"\n                      ],\n                      "Condition-Name": [\n                        "lactating"\n                      ]\n                    }\n                  }\n                }\n              }\n            },\n            "right": {\n              "raw_text": "- Patients with any allergy to iodinated contrast",\n              "Allergy": [\n                "allergy"\n              ],\n              "Procedure": [\n                "iodinated contrast"\n              ],\n              "Procedure-Name": [\n                "iodinated contrast"\n              ]\n            }\n          }\n        },\n        "right": {\n          "raw_text": "- Patients with eGFR < 45",\n          "Observation": [\n            "eGFR"\n          ],\n          "Observation-Name": [\n            "eGFR"\n          ],\n          "Eq-Comparison": [\n            "< 45"\n          ],\n          "Eq-Operator": [\n            "<"\n          ],\n          "Eq-Value": [\n            "45"\n          ]\n        }\n      }\n    },\n    "right": {\n      "raw_text": "- Patients that may be treated with radioactive iodine",\n      "Procedure": [\n        "treated"\n      ],\n      "Procedure-Name": [\n        "treated"\n      ],\n      "Drug": [\n        "radioactive iodine"\n      ],\n      "Drug-Name": [\n        "radioactive iodine"\n      ],\n      "Assertion": [\n        "may be"\n      ]\n    }\n  }\n}<|eot_id|>']
