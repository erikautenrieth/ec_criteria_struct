lcifications"\n                              ],\n                              "Observation-Name": [\n                                "calcifications"\n                              ],\n                              "Assertion": [\n                                "possibility of"\n                              ]\n                            },\n                            "right": {\n                              "AND": {\n                                "left": {\n                                  "raw_text": "and will need a negative pregnancy test prior the study intervention.",\n                                  "Condition": [\n                                    "pregnancy"\n                                  ],\n                                  "Condition-Name": [\n                                    "pregnancy"\n                                  ],\n                                  "Observation": [\n                                    "pregnancy test"\n                                  ],\n                                  "Observation-Name": [\n                                    "pregnancy test"\n                                  ],\n                                  "Polarity": [\n                                    "negative"\n                                  ],\n                                  "Study": [\n                                    "study"\n                                  ],\n                                  "Procedure": [\n                                    "intervention"\n                                  ],\n                                  "Procedure-Name": [\n                                    "intervention"\n                                  ]\n                                },\n                                "right": {\n                                  "NOT": {\n                                    "left": {\n                                      "raw_text": "not",\n                                      "Negation": [\n        