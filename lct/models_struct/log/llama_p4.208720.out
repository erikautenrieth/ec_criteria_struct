           "right": {\n                                                                                  "OR": {\n                                                                                    "left": {\n                                                                                    "raw_text": "- Triglycerides > 150 mg/dL",\n                                                                                    "Eq-Operator": [\n                                                                                    ">"\n                                                                                    ],\n                                                                                    "Eq-Value": [\n                                                                                    "150"\n                                                                                    ],\n                                                                                    "Eq-Comparison": [\n                                                                                    "> 150 mg/dL"\n                                                                                    ],\n                                                                                    "Observation": [\n                                                                                    "Triglycerides"\n                                                                                    ],\n                                                                                    "Observation-Name": [\n                                                                                    "Triglycerides"\n                                                                                    ],\n                                                                                    "Eq-Unit": [\n                                                                                    "mg",\n                                       