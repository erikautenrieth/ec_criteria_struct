: [\n                                                    "platelets"\n                                                  ],\n                                                  "Eq-Comparison": [\n                                                    "<20,000"\n                                                  ],\n                                                  "Eq-Operator": [\n                                                    "<"\n                                                  ],\n                                                  "Eq-Value": [\n                                                    "20,000"\n                                                  ],\n                                                  "Severity": [\n                                                    "Severe"\n                                                  ]\n                                                },\n                                                "right": {\n                                                  "raw_text": "and INR >5",\n                                                  "Observation": [\n                                                    "INR"\n                                                  ],\n                                                  "Observation-Name": [\n                                                    "INR"\n                                                  ],\n                                                  "Eq-Comparison": [\n                                                    ">5"\n                                                  ],\n                                                  "Eq-Operator": [\n                                                    ">"\n                                                  ],\n                                                  "Eq-Value": [\n                                                    "5"\n                                                  ]\n                                                }\n      