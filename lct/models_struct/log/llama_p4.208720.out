ictions, return an empty JSON FILE {}\n- The entire text of the eligibility criteria must be included and separated by the logical operators, without omitting any words or information.\n- The output should only contain the JSON object, without any additional text or formatting.\n- Ensure that the JSON output strictly follows these rules and accurately represents the logical structure of the input eligibility criteria.\n\n### Input:\n-  Having any current of serious psychological disorder or substance abuse / dependence.\n-  Being currently enrolled in another standardized meditation program\n\n### Response:\n{\n  "AND": {\n    "left": {\n      "OR": {\n        "left": {\n          "raw_text": "- Having any current of serious psychological disorder",\n          "Condition": [\n            "psychological disorder"\n          ],\n          "Condition-Name": [\n            "psychological disorder"\n          ],\n          "Eq-Comparison": [\n            "current"\n          ],\n          "Eq-Temporal-Period": [\n            "current"\n          ],\n          "Severity": [\n            "serious"\n          ]\n        },\n        "right": {\n          "OR": {\n            "left": {\n              "raw_text": "or substance abuse",\n              "Condition": [\n                "substance abuse"\n              ],\n              "Condition-Name": [\n                "substance abuse"\n              ]\n            },\n            "right": {\n              "OR": {\n                "left": {\n                  "raw_text": "/ dependence.",\n                  "Condition": [\n                    "dependence"\n                  ],\n                  "Condition-Name": [\n                    "dependence"\n                  ]\n                },\n                "right": {\n                  "raw_text": "Being currently enrolled in another standardized meditation program",\n                  "Procedure": [\n                    "meditation program"\n                  ],\n                  "Procedure-Name": [\n                    "meditation program"\n                  ],\n                  "Eq-Comparison": [\n                    "current"\n                  ],\n                  "Eq-Temporal-Period": [\n                    "current"\n                  ],\n                  "Other": [\n                    "another"\n                  ],\n                  "Modifier": [\n                    "standardized"\n                  ]\n                }\n              }\n            }\n          }\n        }\n      }\n    },\n    "right": {\n      "raw_text": "Being currently enrolled in another standardized meditation program",\n      "Procedure": [\n        "meditation program"\n      ],\n      "Procedure-Name": [\n        "meditation program"\n      ],\n      "Eq-Comparison": [\n        "current"\n      ],\n      "Eq-Temporal-Period": [\n        "current"\n      ],\n      "Other": [\n        "another"\n      ],\n      "Modifier": [\n        "standardized"\n      ]\n    }\n  }\n}<|eot_id|>']
