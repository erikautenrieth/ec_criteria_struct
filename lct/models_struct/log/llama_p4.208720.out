                          "cardiac catheterization"\n                                                                                    ],\n                                                                                    "Eq-Comparison": [\n                                                                                    "Within 2 weeks"\n                                                                                    ],\n                                                                                    "Eq-Operator": [\n                                                                                    "Within"\n                                                                                    ],\n                                                                                    "Eq-Value": [\n                                                                                    "2"\n                                                                                    ],\n                                                                                    "Eq-Temporal-Unit": [\n                                                                                    "weeks"\n                                                                                    ]\n                                                                                    },\n                                                                                    "right": {\n                                                                                    "raw_text": "or arterial puncture at femoral puncture site.",\n                                                                                    "Procedure": [\n                                                                                    "arterial puncture"\n                                                                                    ],\n                                                                                    "Procedure