                   "Eq-Temporal-Period": [\n                        "Family history"\n                      ],\n                      "Eq-Value": [\n                        "one"\n                      ],\n                      "Family-Member": [\n                        "relative"\n                      ],\n                      "Life-Stage-And-Gender": [\n                        "female"\n                      ]\n                    }\n                  }\n                },\n                "right": {\n                  "raw_text": "- High-risk pregnancy according to national guidelines",\n                  "Condition": [\n                    "pregnancy"\n                  ],\n                  "Risk": [\n                    "risk"\n                  ],\n                  "Condition-Name": [\n                    "pregnancy"\n                  ],\n                  "Polarity": [\n                    "High"\n                  ]\n                }\n              }\n            },\n            "right": {\n              "AND": {\n                "left": {\n                  "raw_text": "- During the follow-up, pregnant women",\n                  "Condition": [\n                    "pregnancy"\n                  ],\n                  "Condition-Name": [\n                    "pregnancy"\n                  ],\n                  "Life-Stage-And-Gender": [\n                    "women"\n                  ],\n                  "Encounter": [\n                    "follow-up"\n                  ]\n                },\n                "right": {\n                  "NOT": {\n                    "left": {\n                      "OR": {\n                        "left": {\n                          "raw_text": "under any treatment that may affect the levels of metabolic markers will be",\n                          "Procedure": [\n                            "treatment"\n                          ],\n                          "Observation": [\n                            "metabolic markers"\n                          ],\n                          "Observation-Name": [\n                            "metabolic markers"\n                          ],\n                          "Stability": [\n                            "affect"\n                          ],\n                          "Assertion": [\n                            "may"\n                          ]\n                        },\n                        "right": {\n                          "NOT": {\n                            "left": {\n                              "raw_text": "excluded from the analysis",\n                              "Negation": [\n                                "excluded"\n                              ],\n                              "Procedure": [\n                                "analysis"\n                              ]\n                            }\n                          }\n                        }\n                      }\n                    }\n                  }\n                }\n              }\n            }\n          }\n        },\n        "right": {\n          "OR": {\n            "left": {\n              "raw_text": "- Pregnant women",\n              "Condition": [\n                "Pregnant"\n              ],\n              "Condition-Name": [\n                "Pregnant"\n              ],\n              "Life-Stage-And-Gender": [\n                "women"\n              ]\n            },\n            "right": {\n              "OR": {\n                "left": {\n                  "raw_text": "with pre-eclampsia",\n                  "Condition": [\n                    "pre-eclampsia"\n                  ],\n                  "Condition-Name": [\n                    "pre-eclampsia"\n                  ]\n                },\n                "right": {\n                  "raw_text": "or with preterm birth (less than 37 weeks of gestational age) will be also excluded",\n                  "Condition": [\n                    "preterm birth"\n       