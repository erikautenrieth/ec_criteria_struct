ictions, return an empty JSON FILE {}\n- The entire text of the eligibility criteria must be included and separated by the logical operators, without omitting any words or information.\n- The output should only contain the JSON object, without any additional text or formatting.\n- Ensure that the JSON output strictly follows these rules and accurately represents the logical structure of the input eligibility criteria.\n\n### Input:\n-  ASA I-III male and female patients aged between 18 to 80 years old, who will receive spinal anesthesia for surgeries lasting less than one hour.\n\n### Response:\n{\n  "raw_text": "- ASA I-III male and female patients aged between 18 to 80 years old, who will receive spinal anesthesia for surgeries lasting less than one hour.",\n  "Procedure": [\n    "spinal anesthesia",\n    "surgeries"\n  ],\n  "Procedure-Name": [\n    "spinal anesthesia",\n    "surgeries"\n  ],\n  "Observation": [\n    "ASA"\n  ],\n  "Observation-Name": [\n    "ASA"\n  ],\n  "Eq-Comparison": [\n    "I-III",\n    "18 to 80 years"\n  ],\n  "Eq-Value": [\n    "I",\n    "III",\n    "18",\n    "80"\n  ],\n  "Eq-Operator": [\n    "to"\n  ],\n  "Eq-Temporal-Unit": [\n    "years"\n  ],\n  "Age": [\n    "aged"\n  ],\n  "Life-Stage-And-Gender": [\n    "male",\n    "female"\n  ],\n  "Eq-Temporal-Period": [\n    "will receive"\n  ],\n  "Eq-Unit": [\n    "g"\n  ],\n  "Modifier": [\n    "less than one hour"\n  ]\n}<|eot_id|>']
