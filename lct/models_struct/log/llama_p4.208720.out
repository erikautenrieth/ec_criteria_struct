ery"\n              ],\n              "Eq-Comparison": [\n                "past year"\n              ],\n              "Eq-Temporal-Period": [\n                "past"\n              ],\n              "Eq-Value": [\n                "year"\n              ]\n            }\n          }\n        }\n      }\n    },\n    "right": {\n      "raw_text": "- nasal cocaine use in the past year",\n      "Eq-Comparison": [\n        "past year"\n      ],\n      "Eq-Temporal-Period": [\n        "past"\n      ],\n      "Eq-Value": [\n        "year"\n      ],\n      "Modifier": [\n        "nasal"\n      ],\n      "Drug": [\n        "cocaine"\n      ],\n      "Drug-Name": [\n        "cocaine"\n      ]\n    }\n  }\n}<|eot_id|>']
