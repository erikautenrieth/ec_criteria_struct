cy": [\n                                    "first"\n                                  ]\n                                }\n                              }\n                            }\n                          }\n                        }\n                      }\n                    }\n                  }\n                }\n              }\n            },\n            "right": {\n              "raw_text": "- First diagnostic kidney biopsy since 2010",\n              "Procedure": [\n                "biopsy"\n              ],\n              "Procedure-Name": [\n                "biopsy"\n              ],\n              "Modifier": [\n                "kidney"\n              ],\n              "Eq-Comparison": [\n                "First",\n                "since 2010"\n              ],\n              "Eq-Temporal-Recency": [\n                "First"\n              ],\n              "Eq-Operator": [\n                "since"\n              ],\n              "Eq-Value": [\n                "2010"\n              ]\n            }\n          }\n        },\n        "right": {\n          "raw_text": "- Willingness to comply with study requirements, including intention to fully participate in protocol-specified follow-up at a clinical study site",\n          "Procedure": [\n            "follow-up"\n          ],\n          "Procedure-Name": [\n            "follow-up"\n          ],\n          "Study": [\n            "study"\n          ],\n          "Assertion": [\n            "intention to"\n          ]\n        }\n      }\n    },\n    "right": {\n      "raw_text": "- Informed consent and, where age appropriate, informed assent (clinical data, human derived materials including genomic data)",\n      "Observation": [\n        "genomic data"\n      ],\n      "Observation-Name": [\n        "genomic data"\n      ]\n    }\n  }\n}<|eot_id|>']
