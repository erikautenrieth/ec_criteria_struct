       "Life-Stage-And-Gender": [\n                        "infant"\n                      ]\n                    }\n                  }\n                }\n              }\n            },\n            "right": {\n              "raw_text": "- administration of any infant vitamin or mineral supplements for the past 2 months",\n              "Eq-Temporal-Unit": [\n                "months"\n              ],\n              "Eq-Value": [\n                "2"\n              ],\n              "Drug": [\n                "vitamin or mineral supplements"\n              ],\n              "Drug-Name": [\n                "vitamin or mineral supplements"\n              ],\n              "Life-Stage-And-Gender": [\n                "infant"\n              ],\n              "Eq-Comparison": [\n                "past 2 months"\n              ],\n              "Eq-Temporal-Period": [\n                "past"\n              ],\n              "Procedure": [\n                "administration"\n              ]\n            }\n          }\n        },\n        "right": {\n          "raw_text": "- any history of infant antibiotic treatment.",\n          "Procedure": [\n            "treatment"\n          ],\n          "Eq-Comparison": [\n            "history"\n          ],\n          "Drug": [\n            "antibiotic"\n          ],\n          "Life-Stage-And-Gender": [\n            "infant"\n          ],\n          "Eq-Temporal-Period": [\n            "history"\n          ],\n          "Drug-Name": [\n            "antibiotic"\n          ]\n        }\n      }\n    },\n    "right": {\n      "raw_text": "and"\n    }\n  }\n}<|eot_id|>']
