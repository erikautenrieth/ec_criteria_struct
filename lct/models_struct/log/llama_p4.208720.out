      }\n                  }\n                },\n                "right": {\n                  "OR": {\n                    "left": {\n                      "raw_text": "- skin infection",\n                      "Condition": [\n                        "infection"\n                      ],\n                      "Condition-Name": [\n                        "infection"\n                      ],\n                      "Modifier": [\n                        "skin"\n                      ],\n                      "Eq-Operator": [\n                        "-"\n                      ]\n                    },\n                    "right": {\n                      "raw_text": "and diseases at site of injection.",\n                      "Condition": [\n                        "diseases"\n                      ],\n                      "Procedure": [\n                        "injection"\n                      ],\n                      "Procedure-Name": [\n                        "injection"\n                      ],\n                      "Modifier": [\n                        "site of"\n                      ]\n                    }\n                  }\n                }\n              }\n            },\n            "right": {\n              "raw_text": "- coagulation disorders,",\n              "Condition": [\n                "coagulation disorders"\n              ],\n              "Condition-Name": [\n                "coagulation disorders"\n              ],\n              "Eq-Operator": [\n                "-"\n              ]\n            }\n          }\n        },\n        "right": {\n          "raw_text": "- patients with body mass index (BMI) > 35 kg/m2,",\n          "Observation": [\n            "body mass index",\n            "BMI"\n          ],\n          "Observation-Name": [\n            "body mass index",\n            "BMI"\n          ],\n          "Eq-Comparison": [\n            "> 35 kg/m2"\n          ],\n          "Eq-Operator": [\n            ">",\n         