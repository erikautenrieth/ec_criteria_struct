ictions, return an empty JSON FILE {}\n- The entire text of the eligibility criteria must be included and separated by the logical operators, without omitting any words or information.\n- The output should only contain the JSON object, without any additional text or formatting.\n- Ensure that the JSON output strictly follows these rules and accurately represents the logical structure of the input eligibility criteria.\n\n### Input:\n-  Cutaneous Suppuration, without fistula (e.g., Verneuil disease, boil)\n\n### Response:\n{\n  "AND": {\n    "left": {\n      "raw_text": "- Cutaneous Suppuration,",\n      "Condition": [\n        "Cutaneous Suppuration"\n      ],\n      "Condition-Name": [\n        "Cutaneous Suppuration"\n      ]\n    },\n    "right": {\n      "NOT": {\n        "left": {\n          "OR": {\n            "left": {\n              "raw_text": "without fistula (e.g., Verneuil disease,",\n              "Condition": [\n                "fistula",\n                "Verneuil disease"\n              ],\n              "Condition-Name": [\n                "fistula",\n                "Verneuil disease"\n              ],\n              "Negation": [\n                "without"\n              ]\n            },\n            "right": {\n              "raw_text": "boil)",\n              "Condition": [\n                "boil"\n              ],\n              "Condition-Name": [\n                "boil"\n              ]\n            }\n          }\n        }\n      }\n    }\n  }\n}<|eot_id|>']
Response: {
  "AND": {
    "left": {
      "raw_text": "- Cutaneous Suppuration,",
      "Condition": [
        "Cutaneous Suppuration"
      ],
      "Condition-Name": [
        "Cutaneous Suppuration"
      ]
    },
    "right": {
      "NOT": {
        "left": {
          "OR": {
            "left": {
              "raw_text": "without fistula (e.g., Verneuil disease,",
              "Condition": [
                "fistula",
                "Verneuil disease"
              ],
              "Condition-Name": [
                "fistula",
                "Verneuil disease"
              ],
              "Negation": [
                "without"
              ]
            },
            "right": {
              "raw_text": "boil)",
              "Condition": [
                "boil"
              ],
              "Condition-Name": [
                "boil"
              ]
            }
          }
        }
      }
    }
  }
}
