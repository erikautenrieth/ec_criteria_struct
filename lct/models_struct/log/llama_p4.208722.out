rs"\n                                  ],\n                                  "Procedure": [\n                                    "Gastric Bypass Surgery",\n                                    "surgery"\n                                  ],\n                                  "Observation": [\n                                    "excess weight"\n                                  ],\n                                  "Eq-Operator": [\n                                    "-"\n                                  ],\n                                  "Eq-Temporal-Period": [\n                                    "Previous"\n                                  ],\n                                  "Procedure-Name": [\n                                    "Gastric Bypass Surgery",\n                                    "surgery"\n                                  ],\n                                  "Observation-Name": [\n                                    "excess weight"\n                                  ],\n                                  "Eq-Value": [\n                                    "50"\n                                  ],\n                                  "Eq-Unit": [\n                                    "%"\n                                  ],\n                                  "Eq-Temporal-Unit": [\n                                    "years"\n                                  ]\n                                }\n                              }\n                            },\n                            "right": {\n                              "raw_text": "- Significant Loss of Control over eating",\n                              "Condition": [\n                                "Loss of Control over eating"\n                              ],\n                              "Eq-Operator": [\n                                "-"\n                              ],\n                              "Condition-Name": [\n                                "Loss of Control over eating"\n                              ],\n                              "Severity": [\n                                "Significant"\n                              ]\n                            }\n                          }\n                        },\n                        "right": {\n                          "raw_text": "- Subject is able to attend all scheduled clinic appointments on their own or with a caregiver.",\n                          "Eq-Operator": [\n                            "-"\n                          ]\n                        }\n                      }\n                    },\n                    "right": {\n                      "raw_text": "- Premenopausal women must agree to use acceptable methods of birth control.",\n                      "Condition": [\n                        "Premenopausal"\n                      ],\n                      "Procedure": [\n                        "birth control"\n                      ],\n                      "Eq-Operator": [\n                        "-"\n                      ],\n                      "Condition-Name": [\n                        "Premenopausal"\n                      ],\n                      "Life-Stage-And-Gender": [\n                        "women"\n                      ],\n                      "Procedure-Name": [\n                        "birth control"\n                      ]\n                    }\n                  }\n                },\n                "right": {\n                  "raw_text": "- Participants provide voluntary, decisionally capable, and appropriately informed consent.",\n                  "Eq-Operator": [\n                    "-"\n                  ]\n                }\n              }\n            },\n            "right": {\n              "raw_text": "- Subject is able to comply w/ all testing and follow-up requirements defined by the study protocol.",\n              "Eq-Operator": [\n                "-"\n              ]\n            }\n          }\n  