  "AND": {
    "left": {
      "AND": {
        "left": {
          "OR": {
            "left": {
              "raw_text": "- Diagnosis of other musculoskeletal",
              "Modifier": [
                "musculoskeletal"
              ]
            },
            "right": {
              "raw_text": "or developmental illness that might be responsible for the spinal curvature.",
              "Condition": [
                "illness"
              ],
              "Condition-Name": [
                "illness"
              ],
              "Modifier": [
                "developmental"
              ],
              "Observation": [
                "spinal curvature"
              ],
              "Observation-Name": [
                "spinal curvature"
              ],
              "Assertion": [
                "might be"
              ]
            }
          }
        },
        "right": {
          "raw_text": "- Patients with symptom of a neurological disorder.",
          "Condition": [
            "neurological disorders"
          ],
          "Condition-Name": [
            "neurological disorders"
          ],
          "Coreference": [
            "symptom"
          ]
        }
      }
    },
    "right": {
      "raw_text": "- Patients with any other disorder of the musculoskeletal system affecting the lower limbs,",
      "Condition": [
        "disorder of the musculoskeletal system"
      ],
      "Condition-Name": [
        "disorder of the musculoskeletal system"
      ],
      "Modifier": [
        "musculoskeletal",
        "lower limbs"
      ],
      "Other": [
        "other"
      ]
    }
  }
}
