ntrolled systematic disease that could compromise implant surgery.",\n                  "Condition": [\n                    "disease"\n                  ],\n                  "Procedure": [\n                    "implant surgery"\n                  ],\n                  "Procedure-Name": [\n                    "implant surgery"\n                  ],\n                  "Stability": [\n                    "compromise"\n                  ],\n                  "Assertion": [\n                    "could"\n                  ],\n                  "Modifier": [\n                    "uncontrolled systematic"\n                  ]\n                }\n              }\n            },\n            "right": {\n              "raw_text": "(7) extreme bruxism.",\n              "Condition": [\n                "bruxism"\n              ],\n              "Condition-Name": [\n                "bruxism"\n              ],\n              "Severity": [\n                "extreme"\n              ]\n            }\n          }\n        },\n        "right": {\n          "raw_text": "(8) infectious disease.",\n          "Condition": [\n            "disease"\n          ],\n          "Condition-Name": [\n            "infectious disease"\n          ]\n        }\n      }\n    },\n    "right": {\n      "raw_text": "(9) temporomandibular joint dysfunction.",\n      "Condition": [\n        "dysfunction"\n      ],\n      "Condition-Name": [\n        "dysfunction"\n      ],\n      "Modifier": [\n        "temporomandibular joint"\n      ]\n    }\n  }\n}<|eot_id|>']
