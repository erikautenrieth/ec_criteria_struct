ndicular muscle mass index (AMMI) (<7 kg/m^2 in men; <5.7 kg/m^2 in women) using Bioelectrical impedance analysis (BIA, TANITA BC-418®, Tokyo, Japan)\n-  Subject has lower handgrip strength (<26 kg in men; <18 kg in women) using dynamometer (CAMRY®, Zhongshan, Guangdong) or slowly gait speed (<1 m/s)\n\n### Response:\n{\n  "AND": {\n    "left": {\n      "AND": {\n        "left": {\n          "raw_text": "- Older adults (≥ 65 years)",\n          "Eq-Operator": [\n            "≥"\n          ],\n          "Eq-Temporal-Unit": [\n            "years"\n          ],\n          "Age": [\n            "Older adults"\n          ],\n          "Eq-Value": [\n            "65"\n          ],\n          "Eq-Comparison": [\n            "≥ 65 years"\n          ]\n        },\n        "right": {\n          "raw_text": "- Subject has lower appendicular muscle mass index (AMMI) (<7 kg/m^2 in men; <5.7 kg/m^2 in women) using Bioelectrical impedance analysis (BIA, TANITA BC-418®, Tokyo, Japan)",\n          "Observation": [\n            "lower appendicular muscle mass index",\n            "AMMI"\n          ],\n          "Eq-Operator": [\n            "<"\n          ],\n          "Eq-Unit": [\n            "kg",\n            "m^2"\n          ],\n          "Observation-Name": [\n            "lower appendicular muscle mass index",\n            "AMMI"\n          ],\n          "Eq-Value": [\n            "7",\n            "5.7"\n          ],\n          "Eq-Comparison": [\n            "<7 kg/m^2 in men",\n            "<5.7 kg/m^2 in women"\n          ],\n          "Life-Stage-And-Gender": [\n            "men",\n            "women"\n          ],\n          "Procedure": [\n            "Bioelectrical impedance analysis",\n            "BIA"\n          ],\n          "Procedure-Name": [\n            "Bioelectrical impedance analysis",\n            "BIA"\n          ]\n        }\n      }\n    },\n    "right": {\n      "OR": {\n        "left": {\n          "raw_text": "- Subject has lower handgrip strength (<26 kg in men",\n          "Observation": [\n            "lower handgrip strength"\n          ],\n          "Eq-Operator": [\n            "<"\n          ],\n          "Eq-Unit": [\n            "kg"\n          ],\n          "Observation-Name": [\n            "lower handgrip strength"\n          ],\n          "Eq-Value": [\n            "26"\n          ],\n          "Eq-Comparison": [\n            "<26 kg in men"\n          ],\n          "Life-Stage-And-Gender": [\n            "men"\n          ]\n        },\n        "right": {\n          "raw_text": "or slowly gait speed (<1 m/s) using dynamometer (CAMRY®, Zhongshan, Guangdong)",\n          "Observation": [\n            "gait speed"\n          ],\n          "Eq-Operator": [\n            "<"\n          ],\n          "Eq-Unit": [\n            "m",\n            "s"\n          ],\n          "Observation-Name": [\n            "gait speed"\n          ],\n          "Eq-Value": [\n            "1"\n          ],\n          "Eq-Comparison": [\n            "<1 m/s"\n          ],\n          "Polarity": [\n            "slowly"\n          ],\n          "Procedure": [\n            "dynamometer"\n          ],\n          "Procedure-Name": [\n            "dynamometer"\n          ]\n        }\n      }\n    }\n  }\n}<|eot_id|>']
