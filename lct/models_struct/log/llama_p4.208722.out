r the parents before any study related procedures.\n-  Patients of both genders older than 6 months and younger than 80 years\n-  The patient has a diagnosis of Wilson dis-ease\n\n### Response:\n{\n  "AND": {\n    "left": {\n      "AND": {\n        "left": {\n          "raw_text": "- Informed consent will be obtained from the patient or the parents before any study related procedures.",\n          "Eq-Operator": [\n            "-"\n          ]\n        },\n        "right": {\n          "OR": {\n            "left": {\n              "raw_text": "- Patients of both genders older than 6 months",\n              "Eq-Temporal-Unit": [\n                "months"\n              ],\n              "Eq-Value": [\n                "6"\n              ],\n              "Eq-Operator": [\n                "-",\n                "older than"\n              ],\n              "Eq-Comparison": [\n                "older than 6 months"\n              ]\n            },\n            "right": {\n              "raw_text": "and younger than 80 years",\n              "Eq-Temporal-Unit": [\n                "years"\n              ],\n              "Eq-Value": [\n                "80"\n              ],\n              "Eq-Operator": [\n                "younger than"\n              ],\n              "Eq-Comparison": [\n                "younger than 80 years"\n              ]\n            }\n          }\n        }\n      }\n    },\n    "right": {\n      "raw_text": "- The patient has a diagnosis of Wilson disease",\n      "Condition": [\n        "Wilson disease"\n      ],\n      "Condition-Name": [\n        "Wilson disease"\n      ],\n      "Eq-Operator": [\n        "-"\n      ]\n    }\n  }\n}<|eot_id|>']
