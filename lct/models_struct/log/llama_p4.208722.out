-Comparison": [\n                    "active"\n                  ],\n                  "Condition": [\n                    "infection",\n                    "mycobacterium tuberculosis"\n                  ],\n                  "Eq-Temporal-Period": [\n                    "active"\n                  ],\n                  "Condition-Name": [\n                    "infection",\n                    "mycobacterium tuberculosis"\n                  ],\n                  "Modifier": [\n                    "pulmonary"\n                  ]\n                },\n                "right": {\n                  "raw_text": "or mycobacteria other than tuberculosis (MOTT)",\n                  "Condition": [\n                    "mycobacteria",\n                    "tuberculosis",\n                    "MOTT"\n                  ],\n                  "Exception": [\n                    "other than"\n                  ],\n                  "Condition-Name": [\n                    "mycobacteria",\n                    "tuberculosis",\n                    "MOTT"\n                  ]\n                }\n              }\n            }\n          }\n        },\n        "right": {\n          "OR": {\n            "left": {\n              "raw_text": "- subjects with others forms of pulmonary aspergillosis (allergic bronchopulmonary aspergillosis,",\n              "Condition": [\n                "aspergillosis",\n                "allergic bronchopulmonary aspergillosis"\n              ],\n              "Eq-Operator": [\n                "-"\n              ],\n              "Condition-Name": [\n                "aspergillosis",\n                "allergic bronchopulmonary aspergillosis"\n              ],\n              "Modifier": [\n                "pulmonary"\n              ]\n            },\n            "right": {\n              "OR": {\n                "left": {\n                  "raw_text": "chronic necrotizing aspergillosis",\n                  "Condition": [\n                    "aspergillosis"\n                  ],\n                  "Condition-Name": [\n                    "aspergillosis"\n                  ],\n                  "Acuteness": [\n                    "chronic"\n                  ],\n                  "Modifier": [\n                    "necrotizing"\n                  ]\n                },\n                "right": {\n                  "raw_text": "and angio-invasive aspergillosis)",\n                  "Condition": [\n                    "aspergillosis"\n                  ],\n                  "Condition-Name": [\n                    "aspergillosis"\n                  ],\n                  "Modifier": [\n                    "angio-invasive"\n                  ]\n                }\n              }\n            }\n          }\n        }\n      }\n    },\n    "right": {\n      "raw_text": "- pregnancy",\n      "Condition": [\n        "pregnancy"\n      ],\n      "Eq-Operator": [\n        "-"\n      ],\n      "Condition-Name": [\n        "pregnancy"\n      ]\n    }\n  }\n}<|eot_id|>']
