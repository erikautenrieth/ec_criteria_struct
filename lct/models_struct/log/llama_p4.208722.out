nal age"\n                                  ],\n                                  "Observation-Name": [\n                                    "gestational age"\n                                  ],\n                                  "Coreference": [\n                                    "reduction"\n                                  ]\n                                }\n                              }\n                            }\n                          }\n                        }\n                      }\n                    }\n                  }\n                },\n                "right": {\n                  "AND": {\n                    "left": {\n                      "raw_text": "- Gestational age at randomization between 16 weeks 0 days",\n                      "Eq-Temporal-Unit": [\n                        "weeks",\n                        "days"\n                      ],\n                      "Eq-Value": [\n                        "16",\n                        "0"\n                      ],\n                      "Eq-Operator": [\n                        "-"\n                      ],\n                      "Eq-Comparison": [\n                        "between 16 weeks 0 days"\n                      ],\n                      "Observation": [\n                        "Gestational age"\n                      ],\n                      "Observation-Name": [\n                        "Gestational age"\n                      ],\n                      "Study": [\n                        "randomization"\n                      ]\n                    },\n                    "right": {\n                      "raw_text": "and 23 weeks 6 days based on clinical information and evaluation of the earliest ultrasound as described in Gestational Age.",\n                      "Eq-Temporal-Unit": [\n                        "weeks",\n                        "days"\n                      ],\n                      "Eq-Value": [\n                        "23",\n               