g to the International Classification of Diseases (ICD-10)\n2. A Hamilton scale score (HDS-17) of ≥ 18 and/or a sub-scale (HDSS) score of ≥ 9 within 24-48 hours before the first treatment\n\n### Response:\n{\n  "AND": {\n    "left": {\n      "OR": {\n        "left": {\n          "raw_text": "1. Moderate-severe uni-",\n          "Eq-Operator": [\n            "-"\n          ],\n          "Eq-Comparison": [\n            "Moderate-severe"\n          ],\n          "Eq-Value": [\n            "Moderate",\n            "severe"\n          ]\n        },\n        "right": {\n          "raw_text": "and bipolar depression according to the International Classification of Diseases (ICD-10)",\n          "Condition": [\n            "depression"\n          ],\n          "Condition-Name": [\n            "depression"\n          ],\n          "Eq-Operator": [\n            "-"\n          ],\n          "Modifier": [\n            "bipolar"\n          ]\n        }\n      }\n    },\n    "right": {\n      "OR": {\n        "left": {\n          "raw_text": "2. A Hamilton scale score (HDS-17) of ≥ 18",\n          "Eq-Operator": [\n            "≥",\n            "-"\n          ],\n          "Eq-Value": [\n            "18",\n            "2"\n          ],\n          "Eq-Comparison": [\n            "≥ 18"\n          ],\n          "Observation": [\n            "Hamilton scale",\n            "HDS-17"\n          ],\n          "Observation-Name": [\n            "Hamilton scale",\n            "HDS-17"\n          ]\n        },\n        "right": {\n          "raw_text": "and/or a sub-scale (HDSS) score of ≥ 9 within 24-48 hours before the first treatment",\n          "Eq-Operator": [\n            "≥",\n            "within",\n            "-"\n          ],\n          "Eq-Value": [\n            "9",\n            "24",\n            "48",\n            "2"\n          ],\n          "Eq-Comparison": [\n            "≥ 9",\n            "within 24-48 hours"\n          ],\n          "Observation": [\n            "sub-scale",\n            "HDSS"\n          ],\n          "Observation-Name": [\n            "sub-scale",\n            "HDSS"\n          ],\n          "Procedure": [\n            "treatment"\n          ]\n        }\n      }\n    }\n  }\n}<|eot_id|>']
