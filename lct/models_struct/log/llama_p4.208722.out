            "Crhon s disease"
          ],
          "Eq-Comparison": [
            "in activity"
          ],
          "Eq-Temporal-Period": [
            "in activity"
          ]
        },
        "right": {
          "raw_text": "or in remission attending the the outpatient clinics and inpatient of gastroenterology units of Internal medicine department",
          "Encounter": [
            "outpatient clinics",
            "inpatient"
          ],
          "Condition": [
            "remission"
          ],
          "Condition-Name": [
            "remission"
          ],
          "Location": [
            "gastroenterology units",
            "Internal medicine department"
          ]
        }
      }
    }
  }
}
