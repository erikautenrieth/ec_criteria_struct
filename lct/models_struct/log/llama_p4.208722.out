            "removal of the ascending colon",
            "ligation of the ileocolic artery and vein",
            "removal of the terminal ileum",
            "removal of the proximal transverse colon",
            "removal of the right branch of the middle colic artery and vein"
          ],
          "Procedure-Name": [
