              ],
              "Procedure-Name": [
                "blood-letting"
              ],
              "Assertion": [
                "would"
              ]
            },
            "right": {
              "raw_text": "- Participants unwilling to consent"
            }
          }
        },
        "right": {
          "raw_text": "- Patients that have a conventional contraindication for cardiac magnetic resonance imaging (MRI).",
          "Procedure": [
            "cardiac magnetic resonance imaging",
            "MRI"
          ],
          "Procedure-Name": [
            "cardiac magnetic resonance imaging",
            "MRI"
          ],
          "Contraindication": [
            "contraindications"
          ]
        }
      }
    },
    "right": {
      "OR": {
        "left": {
          "raw_text": "- Patients that have had a blood transfusion within the last month",
          "Procedure": [
            "blood transfusions"
          ],
          "Procedure-Name": [
            "blood transfusions"
