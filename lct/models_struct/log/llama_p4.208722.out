 of entry into the study or during the study period\n-  Patients with history of substance abuse (Cut down, Annoyed, Guilty, Eye opener [CAGE] >= 2+), cognitively impaired (MD Anderson Symptom [MDAS] > 7)\n\n### Response:\n{\n  "AND": {\n    "left": {\n      "OR": {\n        "left": {\n          "raw_text": "- Surgery,",\n          "Procedure": [\n            "Surgery"\n          ],\n          "Procedure-Name": [\n            "Surgery"\n          ]\n        },\n        "right": {\n          "raw_text": "or pain relieving procedures within 2 weeks of entry into the study or during the study period",\n          "Procedure": [\n            "pain relieving procedures"\n          ],\n          "Eq-Operator": [\n            "within"\n          ],\n          "Eq-Temporal-Unit": [\n            "weeks"\n          ],\n          "Eq-Value": [\n            "2"\n          ],\n          "Procedure-Name": [\n            "pain relieving procedures"\n          ],\n          "Study": [\n            "study"\n          ]\n        }\n      }\n    },\n    "right": {\n      "OR": {\n        "left": {\n          "raw_text": "- Patients with history of substance abuse (Cut down, Annoyed, Guilty, Eye opener [CAGE] >= 2+),",\n          "Eq-Operator": [\n            ">=",\n            ">",\n            ">= 2+"\n          ],\n          "Eq-Value": [\n            "2"\n          ],\n          "Eq-Comparison": [\n            "history",\n            ">= 2+"\n          ],\n          "Condition": [\n            "substance abuse"\n          ],\n          "Observation": [\n            "Cut down, Annoyed, Guilty, Eye opener",\n            "CAGE"\n          ],\n          "Condition-Name": [\n            "substance abuse"\n          ],\n          "Observation-Name": [\n            "Cut down, Annoyed, Guilty, Eye opener",\n            "CAGE"\n          ]\n        },\n        "right": {\n          "raw_text": "cognitively impaired (MD Anderson Symptom [MDAS] > 7)",\n          "Condition": [\n            "cognitively impaired"\n          ],\n          "Observation": [\n            "MD Anderson Symptom",\n            "MDAS"\n          ],\n          "Eq-Operator": [\n            ">"\n          ],\n          "Eq-Value": [\n            "7"\n          ],\n          "Condition-Name": [\n            "cognitively impaired"\n          ],\n          "Observation-Name": [\n            "MD Anderson Symptom",\n            "MDAS"\n          ],\n          "Eq-Comparison": [\n            "> 7"\n          ]\n        }\n      }\n    }\n  }\n}<|eot_id|>']
