   "Condition-Name": [\n                                        "pulmonary embolism"\n                                      ]\n                                    },\n                                    "right": {\n                                      "raw_text": "or renal impairment; or were pregnant;",\n                                      "Condition": [\n                                        "renal impairment",\n                                        "pregnant"\n                                      ],\n                                      "Condition-Name": [\n                                        "renal impairment",\n                                        "pregnant"\n                                      ]\n                                    }\n                                  }\n                                }\n                              }\n                            }\n                          }\n                        }\n                      }\n                    }\n                  }\n                },\n                "right": {\n                  "OR": {\n                    "left": {\n                      "raw_text": "- Patients with any cardiovascular problems (such as myocardiac infarction history, atrial fibrillation,",\n                      "Condition": [\n                        "cardiovascular problems",\n                        "myocardiac infarction",\n                        "atrial fibrillation"\n                      ],\n                      "Eq-Comparison": [\n                        "history"\n                      ],\n                      "Condition-Name": [\n                        "cardiovascular problems",\n                        "myocardiac infarction",\n                        "atrial fibrillation"\n                      ],\n                      "Eq-Temporal-Period": [\n                        "history"\n                      ]\n                    },\n                    "right": {\n                      "raw_text": "angina);",\n                      "Condition": [\n                        "angina"\n                      ],\n                      "Condition-Name": [\n                        "angina"\n                      ]\n                    }\n                  }\n                }\n              }\n            },\n            "right": {\n              "OR": {\n                "left": {\n                  "raw_text": "- Patients with thromboembolic disorders,",\n                  "Condition": [\n                    "thromboembolic disorders"\n                  ],\n                  "Condition-Name": [\n                    "thromboembolic disorders"\n                  ]\n                },\n                "right": {\n                  "raw_text": "or those exhibiting a deteriorating general condition;",\n                  "Condition": [\n                    "general condition"\n                  ],\n                  "Condition-Name": [\n                    "general condition"\n                  ],\n                  "Stability": [\n                    "deteriorating"\n                  ]\n                }\n              }\n            }\n          }\n        },\n        "right": {\n          "OR": {\n            "left": {\n              "raw_text": "- Preoperative anemia (a hemoglobin value of <11 g/dL in females",\n              "Condition": [\n                "anemia"\n              ],\n              "Observation": [\n                "hemoglobin"\n              ],\n              "Eq-Comparison": [\n                "<11 g/dL"\n              ],\n              "Condition-Name": [\n                "anemia"\n              ],\n              "Observation-Name": [\n                "hemoglobin"\n              ],\n              "Eq-Operator": [\n                "<"\n              ],\n              "Eq-Value": [\n                "11"\n              ],\n              "Eq-Unit": [\n                "g",\n                "dL"\n              ],\n              "Life-Stage-And-Gender": [\n                "females"\n              ]\n            },\n            "right": {\n              "raw_text": "and <12 g/dL in males), refusal of blood products;",\n              "Eq-Comparison": [\n                "<12 g/dL"\n              ],\n              "Eq-Unit": [\n                "g",\n                "dL"\n              ],\n              "Eq-Operator": [\n                "<"\n              ],\n              "Eq-Value": [\n                "12"\n              ],\n              "Life-Stage-And-Gender": [\n                "males"\n              ]\n            }\n          }\n        }\n      }\n    },\n    "right": {\n      "OR": {\n        "left": {\n          "raw_text": "- Preoperative use of anticoagulant therapy within five days before surgery,",\n          "Procedure": [\n            "surgery"\n          ],\n          "Eq-Comparison": [\n            "within five days"\n          ],\n          "Drug": [\n            "anticoagulant therapy"\n          ],\n          "Eq-Operator": [\n            "within"\n          ],\n          "Eq-Value": [\n            "five"\n          ],\n          "Eq-Temporal-Unit": [\n            "days"\n          ],\n          "Procedure-Name": [\n            "surgery"\n          ],\n          "Drug-Name": [\n            "anticoagulant therapy"\n          ]\n        },\n        "right": {\n          "OR": {\n            "left": {\n              "raw_text": "fibrinolytic disorders requiring intraoperative antifibrinolytic treatment,",\n              "Condition": [\n                "fibrinolytic disorders"\n              ],\n              "Procedure": [\n                "antifibrinolytic treatment"\n              ],\n              "Condition-Name": [\n                "fibrinolytic disorders"\n              ],\n              "Procedure-Name": [\n                "antifibrinolytic treatment"\n              ],\n              "Assertion": [\n                "requiring"\n              ]\n            },\n            "right": {\n              "OR": {\n                "left": {\n                  "raw_text": "coagulopathy (as identified by a preoperative platelet count of <150,000/mm3, an international normalized ratio of >1.4,",\n                  "Condition": [\n                    "coagulopathy"\n                  ],\n                  "Observation": [\n                    "platelet count",\n                    "international normalized ratio"\n                  ],\n                  "Eq-Comparison": [\n                    "<150,000/mm3",\n                    ">1.4"\n                  ],\n                  "Condition-Name": [\n                    "coagulopathy"\n                  ],\n                  "Observation-Name": [\n                    "platelet count",\n                    "international normalized ratio"\n                  ],\n                  "Eq-Operator": [\n                    "<",\n                    ">"\n                  ],\n                  "Eq-Unit": [\n                    "mm3"\n                  ],\n                  "Eq-Value": [\n                    "150,000",\n                    "1.4"\n                  ]\n                },\n                "right": {\n                  "raw_text": "or a prolonged partial thromboplastin time [>1.4 times normal]).",\n                  "Observation": [\n                    "partial thromboplastin time"\n                  ],\n                  "Eq-Comparison": [\n                    ">1.4 times normal"\n                  ],\n                  "Observation-Name": [\n                    "partial thromboplastin time"\n                  ],\n                  "Eq-Operator": [\n                    ">"\n                  ],\n                  "Eq-Value": [\n                    "1.4"\n                  ],\n                  "Polarity": [\n                    "normal"\n                  ]\n                }\n              }\n            }\n          }\n        }\n      }\n    }\n  }\n}<|eot_id|>']
