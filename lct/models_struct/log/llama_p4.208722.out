eeks)\n-  mother ≥15 years of age\n-  infant still breastfeeding\n-  anticipated residence in the area for the study duration.\n\n### Response:\n{\n  "AND": {\n    "left": {\n      "AND": {\n        "left": {\n          "AND": {\n            "left": {\n              "AND": {\n                "left": {\n                  "raw_text": "- vaginal delivery",\n                  "Procedure": [\n                    "vaginal delivery"\n                  ],\n                  "Procedure-Name": [\n                    "vaginal delivery"\n                  ]\n                },\n                "right": {\n                  "raw_text": "- an infant age of 6 months (±3 weeks)",\n                  "Eq-Temporal-Unit": [\n                    "months",\n                    "weeks"\n                  ],\n                  "Eq-Value": [\n                    "6",\n                    "3"\n                  ],\n                  "Eq-Operator": [\n                    "±"\n                  ],\n                  "Eq-Comparison": [\n                    "6 months (±3 weeks)"\n                  ],\n                  "Life-Stage-And-Gender": [\n                    "infant"\n                  ],\n                  "Age": [\n                    "age"\n                  ]\n                }\n              }\n            },\n            "right": {\n              "raw_text": "- mother ≥15 years of age",\n              "Eq-Operator": [\n                "≥"\n              ],\n              "Eq-Temporal-Unit": [\n                "years"\n              ],\n              "Eq-Value": [\n                "15"\n              ],\n              "Eq-Comparison": [\n                "≥15 years"\n              ],\n              "Age": [\n                "age"\n              ],\n              "Family-Member": [\n                "mother"\n              ]\n            }\n          }\n        },\n        "right": {\n          "raw_text": "- infant still breastfeeding",\n          "Condition": [\n            "breastfeeding"\n          ],\n          "Condition-Name": [\n            "breastfeeding"\n          ],\n          "Life-Stage-And-Gender": [\n            "infant"\n          ]\n        }\n      }\n    },\n    "right": {\n      "raw_text": "- anticipated residence in the area for the study duration.",\n      "Eq-Operator": [\n        "to"\n      ]\n    }\n  }\n}<|eot_id|>']
