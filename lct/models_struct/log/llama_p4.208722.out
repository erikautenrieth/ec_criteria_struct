nancy or present)；\n-  Children is vaccinated with hepatitis B vaccine after birth;\n\n### Response:\n{\n  "AND": {\n    "left": {\n      "OR": {\n        "left": {\n          "raw_text": "- The father",\n          "Family-Member": [\n            "father"\n          ]\n        },\n        "right": {\n          "raw_text": "or (and) mother is HBV-infected (pre-pregnancy or present)；",\n          "Condition": [\n            "HBV-infected",\n            "pregnancy"\n          ],\n          "Condition-Name": [\n            "HBV-infected",\n            "pregnancy"\n          ],\n          "Family-Member": [\n            "mother"\n          ]\n        }\n      }\n    },\n    "right": {\n      "raw_text": "- Children is vaccinated with hepatitis B vaccine after birth;",\n      "Life-Stage-And-Gender": [\n        "Children"\n      ],\n      "Procedure": [\n        "vaccinated"\n      ],\n      "Procedure-Name": [\n        "vaccinated"\n      ],\n      "Birth": [\n        "birth"\n      ],\n      "Immunization": [\n        "hepatitis B vaccine"\n      ],\n      "Immunization-Name": [\n        "hepatitis B vaccine"\n      ]\n    }\n  }\n}<|eot_id|>']
