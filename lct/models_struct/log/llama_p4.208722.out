eceived professional periodontal treatment (other than supragingival cleaning) within the previous 12 months.\n-  Having received antibiotic medication within the previous 3 months.\n\n### Response:\n{\n  "AND": {\n    "left": {\n      "AND": {\n        "left": {\n          "AND": {\n            "left": {\n              "raw_text": "- Edentulous mouth.",\n              "Condition": [\n                "Edentulous mouth"\n              ],\n              "Condition-Name": [\n                "Edentulous mouth"\n              ]\n            },\n            "right": {\n              "raw_text": "- Pregnant females.",\n              "Condition": [\n                "Pregnant"\n              ],\n              "Condition-Name": [\n                "Pregnant"\n              ],\n              "Life-Stage-And-Gender": [\n                "females"\n              ]\n            }\n          }\n        },\n        "right": {\n          "raw_text": "- Having received professional periodontal treatment (other than supragingival cleaning) within the previous 12 months.",\n          "Eq-Operator": [\n            "within"\n          ],\n          "Eq-Temporal-Unit": [\n            "months"\n          ],\n          "Eq-Value": [\n            "12"\n          ],\n          "Eq-Comparison": [\n            "received",\n            "within the previous 12 months"\n          ],\n          "Procedure": [\n            "periodontal treatment",\n            "supragingival cleaning"\n          ],\n          "Procedure-Name": [\n            "periodontal treatment",\n            "supragingival cleaning"\n          ],\n          "Exception": [\n            "other than"\n          ],\n          "Eq-Temporal-Period": [\n            "received",\n            "previous"\n          ]\n        }\n      }\n    },\n    "right": {\n      "raw_text": "- Having received antibiotic medication within the previous 3 months.",\n      "Eq-Operator": [\n        "within"\n      ],\n      "Eq-Temporal-Unit": [\n        "months"\n      ],\n      "Eq-Value": [\n        "3"\n      ],\n      "Eq-Comparison": [\n        "received",\n        "within the previous 3 months"\n      ],\n      "Drug": [\n        "antibiotic medication"\n      ],\n      "Drug-Name": [\n        "antibiotic medication"\n      ],\n      "Eq-Temporal-Period": [\n        "received",\n        "previous"\n      ]\n    }\n  }\n}<|eot_id|>']
