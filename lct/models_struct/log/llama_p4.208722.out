articipants must have the capacity and ability to give informed consent.\n-  Participants have been given an assessment and received a diagnosis of OCD.\n-  Participants must speak English.\n-  Participants must be able to physically attend treatment.\n\n### Response:\n{\n  "AND": {\n    "left": {\n      "AND": {\n        "left": {\n          "AND": {\n            "left": {\n              "AND": {\n                "left": {\n                  "raw_text": "- Participants must be adults 18 years or older.",\n                  "Eq-Temporal-Unit": [\n                    "years"\n                  ],\n                  "Eq-Value": [\n                    "18"\n                  ],\n                  "Eq-Operator": [\n                    "or older"\n                  ],\n                  "Eq-Comparison": [\n                    "18 years or older"\n                  ],\n                  "Life-Stage-And-Gender": [\n                    "adults"\n                  ]\n                },\n                "right": {\n                  "raw_text": "- Participants must have the capacity and ability to give informed consent."\n                }\n              }\n            },\n            "right": {\n              "raw_text": "- Participants have been given an assessment and received a diagnosis of OCD.",\n              "Condition": [\n                "OCD"\n              ],\n              "Condition-Name": [\n                "OCD"\n              ],\n              "Procedure": [\n                "assessment"\n              ],\n              "Procedure-Name": [\n                "assessment"\n              ]\n            }\n          }\n        },\n        "right": {\n          "raw_text": "- Participants must speak English.",\n          "Language": [\n            "English"\n          ]\n        }\n      }\n    },\n    "right": {\n      "raw_text": "- Participants must be able to physically attend treatment.",\n      "Procedure": [\n        "treatment"\n      ],\n      "Encounter":