            ],\n              "Procedure-Name": [\n                "bowel resection"\n              ]\n            },\n            "right": {\n              "OR": {\n                "left": {\n                  "raw_text": "or any kind of intra-abdominal",\n                  "Modifier": [\n                    "intra-abdominal"\n                  ]\n                },\n                "right": {\n                  "raw_text": "or extra abdominal surgery within 3 months of baseline",\n                  "Eq-Operator": [\n                    "within"\n                  ],\n                  "Eq-Temporal-Unit": [\n                    "months"\n                  ],\n                  "Eq-Value": [\n                    "3"\n                  ],\n                  "Eq-Comparison": [\n                    "within 3 months"\n                  ],\n                  "Procedure": [\n                    "surgery"\n                  ],\n                  "Procedure-Name": [\n                    "surgery"\n                  ],\n                  "Modifier": [\n                    "extra abdominal"\n                  ]\n                }\n              }\n            }\n          }\n        }\n      }\n    },\n    "right": {\n      "raw_text": "- Have ever received any monoclonal antibodies binding IL-23",\n      "Eq-Comparison": [\n        "received"\n      ],\n      "Eq-Temporal-Period": [\n        "received"\n      ],\n      "Drug": [\n        "monoclonal antibodies binding IL-23"\n      ],\n      "Drug-Name": [\n        "monoclonal antibodies binding IL-23"\n      ]\n    }\n  }\n}<|eot_id|>']
