istory of alcohol abuse",\n          "Eq-Comparison": [\n            "History"\n          ],\n          "Eq-Temporal-Period": [\n            "History"\n          ],\n          "Condition": [\n            "alcohol abuse"\n          ],\n          "Condition-Name": [\n            "alcohol abuse"\n          ]\n        },\n        "right": {\n          "raw_text": "or drug addiction (including soft drugs like cannabis products)",\n          "Condition": [\n            "drug addiction"\n          ],\n          "Condition-Name": [\n            "drug addiction"\n          ],\n          "Drug": [\n            "soft drugs",\n            "cannabis products"\n          ]\n        }\n      }\n    }\n  }\n}<|eot_id|>']
