ies"\n                  ],\n                  "Modifier": [\n                    "physical"\n                  ]\n                }\n              }\n            }\n          }\n        }\n      }\n    },\n    "right": {\n      "OR": {\n        "left": {\n          "raw_text": "- Complication with other serious chronic diseases, such as liver",\n          "Condition": [\n            "diseases"\n          ],\n          "Condition-Name": [\n            "diseases"\n          ],\n          "Modifier": [\n            "liver"\n          ],\n          "Severity": [\n            "serious"\n          ],\n          "Acuteness": [\n            "chronic"\n          ]\n        },\n        "right": {\n          "OR": {\n            "left": {\n              "raw_text": "and kidney failure,",\n              "Condition": [\n                "failure"\n              ],\n              "Condition-Name": [\n                "failure"\n              ],\n              "Modifier": [\n                "kidney"\n              ]\n            },\n            "right": {\n              "OR": {\n                "left": {\n                  "raw_text": "connective tissue diseases,",\n                  "Condition": [\n                    "diseases"\n                  ],\n                  "Condition-Name": [\n                    "diseases"\n                  ],\n                  "Modifier": [\n                    "connective tissue"\n                  ]\n                },\n                "right": {\n                  "raw_text": "tumors.",\n                  "Condition": [\n                    "tumors"\n                  ],\n                  "Condition-Name": [\n                    "tumors"\n                  ]\n                }\n              }\n            }\n          }\n        }\n      }\n    }\n  }\n}<|eot_id|>']
