  HIV (as these patients already receive intensive social support and navigation-like services at this institution)\n\n### Response:\n{\n  "AND": {\n    "left": {\n      "raw_text": "- Intent to transfer care to an outside institution",\n      "Encounter": [\n        "transfer care"\n      ],\n      "Location": [\n        "outside institution"\n      ],\n      "Assertion": [\n        "Intent to"\n      ]\n    },\n    "right": {\n      "raw_text": "- HIV (as these patients already receive intensive social support and navigation-like services at this institution)",\n      "Condition": [\n        "HIV"\n      ],\n      "Condition-Name": [\n        "HIV"\n      ],\n      "Location": [\n        "institution"\n      ]\n    }\n  }\n}<|eot_id|>']
