y calcifications abnormalities\n-  Male patients\n-  Pregnant or lactating patients\n-  Patients with any allergy to iodinated contrast\n-  Patients with eGFR < 45\n-  Patients that may be treated with radioactive iodine\n\n### Response:\n{\n  "AND": {\n    "left": {\n      "AND": {\n        "left": {\n          "AND": {\n            "left": {\n              "AND": {\n                "left": {\n                  "AND": {\n                    "left": {\n                      "AND": {\n                        "left": {\n                          "raw_text": "- Age <30 years old",\n                          "Eq-Operator": [\n                            "<"\n                          ],\n                          "Eq-Temporal-Unit": [\n                            "years"\n                          ],\n                          "Age": [\n                            "Age"\n                          ],\n                          "Eq-Value": [\n                            "30"\n                          ],\n                          "Eq-Comparison": [\n                            "<30 years"\n                          ]\n                        },\n                        "right": {\n                          "raw_text": "- Screening mammography with only calcifications abnormalities",\n                          "Procedure": [\n                            "mammography"\n                          ],\n                          "Procedure-Name": [\n                            "mammography"\n                          ],\n                          "Condition": [\n                            "calcifications abnormalities"\n                          ],\n                          "Condition-Name": [\n                            "calcifications abnormalities"\n                          ],\n                          "Modifier": [\n                            "Screening"\n                          ]\n                        }\n                      }\n                    },\n         