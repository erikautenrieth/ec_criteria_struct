                      ],
                      "Life-Stage-And-Gender": [
                        "female"
                      ],
                      "Eq-Operator": [
                        "within"
                      ],
                      "Eq-Temporal-Unit": [
                        "days"
                      ],
                      "Eq-Value": [
                        "30"
                      ],
                      "Eq-Comparison": [
                        "scheduled",
                        "within the next 30 days"
                      ],
                      "Eq-Temporal-Period": [
                        "scheduled",
                        "next"
                      ],
                      "Location": [
                        "UNC"
                      ],
                      "Modifier": [
                        "invasive bladder"
                      ]
                    }
                  }
                },
                "right": {
                  "raw_text": "- English-speaking",
                  "Language": [
                    "English"
                  ]
                }
              }
            },
            "right": {
