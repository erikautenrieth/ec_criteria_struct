ting the online Physical Activity Readiness Questionnaire (PAR-Q);\n2. have a SCI resulting in incomplete or complete (C5 and below) paraplegia or tetraplegia;\n3. have broadband internet access;\n4. between the ages of 18 to 65 years;\n5. have the ability to converse and read English.\n\n### Response:\n{\n  "AND": {\n    "left": {\n      "AND": {\n        "left": {\n          "AND": {\n            "left": {\n              "AND": {\n                "left": {\n                  "raw_text": "1. demonstrate readiness to physical activity by completing the online Physical Activity Readiness Questionnaire (PAR-Q);",\n                  "Observation": [\n                    "physical activity",\n                    "Physical Activity Readiness Questionnaire",\n                    "PAR-Q"\n                  ],\n                  "Observation-Name": [\n                    "physical activity",\n                    "Physical Activity Readiness Questionnaire",\n                    "PAR-Q"\n                  ],\n                  "Eq-Value": [\n                    "1"\n                  ]\n                },\n                "right": {\n                  "OR": {\n                    "left": {\n                      "raw_text": "2. have a SCI resulting in incomplete",\n                      "Condition": [\n                        "SCI"\n                      ],\n                      "Condition-Name": [\n                        "SCI"\n                      ],\n                      "Eq-Value": [\n                        "2"\n                      ],\n                      "Modifier": [\n                        "incomplete"\n                      ]\n                    },\n                    "right": {\n                      "OR": {\n                        "left": {\n                          "raw_text": "or complete (C5 and below) paraplegia",\n                          "Condition": [\n                            "paraplegia"\n                          ],\n                          "Condition-Name": [\n                            "paraplegia"\n                          ],\n                          "Eq-Value": [\n                            "C5"\n                          ],\n                          "Eq-Operator": [\n                            "and below"\n                          ],\n                          "Eq-Comparison": [\n                            "C5 and below"\n                          ],\n                          "Modifier": [\n                            "complete"\n                          ]\n                        },\n                        "right": {\n                          "raw_text": "or tetraplegia;",\n                          "Condition": [\n                            "tetraplegia"\n                          ],\n                          "Condition-Name": [\n                            "tetraplegia"\n                          ]\n                        }\n                      }\n                    }\n                  }\n                }\n              }\n            },\n            "right": {\n              "raw_text": "3. have broadband internet access;"\n            }\n          }\n        },\n        "right": {\n          "raw_text": "4. between the ages of 18 to 65 years;",\n          "Eq-Temporal-Unit": [\n            "years"\n          ],\n          "Eq-Operator": [\n            "to"\n          ],\n          "Eq-Value": [\n            "18",\n            "65"\n          ],\n          "Eq-Comparison": [\n            "18 to 65 years"\n          ],\n          "Age": [\n            "ages"\n          ]\n        }\n      }\n    },\n    "right": {\n      "raw_text": "5. have the ability to converse and read English.",\n      "Eq-Value": [\n        "5"\n      ],\n      "Language": [\n        "English"\n      ]\n    }\n  }\n}<|eot_id|>']
