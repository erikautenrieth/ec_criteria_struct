ten Spanish\n\n### Response:\n{\n  "AND": {\n    "left": {\n      "raw_text": "- 18 years of age or more",\n      "Eq-Temporal-Unit": [\n        "years"\n      ],\n      "Eq-Value": [\n        "18"\n      ],\n      "Eq-Operator": [\n        "or more"\n      ],\n      "Eq-Temporal-Unit": [\n        "years"\n      ],\n      "Age": [\n        "age"\n      ],\n      "Eq-Comparison": [\n        "18 years of age or more"\n      ]\n    },\n    "right": {\n      "raw_text": "- Fluency in oral and written Spanish",\n      "Language": [\n        "Spanish"\n      ]\n    }\n  }\n}<|eot_id|>']
