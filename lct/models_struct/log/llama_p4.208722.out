e infections\n-  Patients with hemodynamic instability\n-  Amputees\n-  Patients with cognitive impairment\n-  Patients with acute renal failure\n-  Patients with graft loss\n\n### Response:\n{\n  "AND": {\n    "left": {\n      "AND": {\n        "left": {\n          "AND": {\n            "left": {\n              "AND": {\n                "left": {\n                  "AND": {\n                    "left": {\n                      "AND": {\n                        "left": {\n                          "raw_text": "- Allergies known to diuretics",\n                          "Allergy": [\n                            "Allergies"\n                          ],\n                          "Drug": [\n                            "diuretics"\n                          ],\n                          "Drug-Name": [\n                            "diuretics"\n                          ]\n                        },\n                        "right": {\n                          "raw_text": "- Patients with severe infections",\n                          "Condition": [\n                            "infections"\n                          ],\n                          "Condition-Name": [\n                            "infections"\n                          ],\n                          "Severity": [\n                            "severe"\n                          ]\n                        }\n                      }\n                    },\n                    "right": {\n                      "raw_text": "- Patients with hemodynamic instability",\n                      "Condition": [\n                        "hemodynamic"\n                      ],\n                      "Condition-Name": [\n                        "hemodynamic"\n                      ],\n                      "Stability": [\n                        "instability"\n                      ]\n                    }\n                  }\n                },\n                "right": {\n                  "raw_text": "- Amputees",\n  