\n-  on antihypertensive medications\n-  recurrent anal fissure after previous sphincterotomy\n-  prior history of anal surgery\n-  other benign anorectal diseases\n-  with inflammatory bowel diseases\n\n### Response:\n{\n  "AND": {\n    "left": {\n      "AND": {\n        "left": {\n          "AND": {\n            "left": {\n              "AND": {\n                "left": {\n                  "AND": {\n                    "left": {\n                      "AND": {\n                        "left": {\n                          "raw_text": "- Pregnant",\n                          "Condition": [\n                            "Pregnant"\n                          ],\n                          "Condition-Name": [\n                            "Pregnant"\n                          ]\n                        },\n                        "right": {\n                          "OR": {\n                            "left": {\n                              "raw_text": "- cardiovascular disease",\n                              "Condition": [\n                                "cardiovascular disease"\n                              ],\n                              "Condition-Name": [\n                                "cardiovascular disease"\n                              ]\n                            },\n                            "right": {\n                              "raw_text": "or heart failure",\n                              "Condition": [\n                                "heart failure"\n                              ],\n                              "Condition-Name": [\n                                "heart failure"\n                              ]\n                            }\n                          }\n                        }\n                      }\n                    },\n                    "right": {\n                      "raw_text": "- on antihypertensive medications",\n                      "Eq-Comparison": [\n                        "on"\n                 