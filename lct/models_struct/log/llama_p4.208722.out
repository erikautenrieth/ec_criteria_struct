 }\n                  }\n                }\n              }\n            },\n            "right": {\n              "OR": {\n                "left": {\n                  "raw_text": "3. Patients with hepatic",\n                  "Modifier": [\n                    "hepatic"\n                  ]\n                },\n                "right": {\n                  "raw_text": "or renal dysfunction.",\n                  "Condition": [\n                    "dysfunction"\n                  ],\n                  "Condition-Name": [\n                    "dysfunction"\n                  ],\n                  "Modifier": [\n                    "renal"\n                  ]\n                }\n              }\n            }\n          }\n        },\n        "right": {\n          "OR": {\n            "left": {\n              "raw_text": "4. Patients with MRI contraindications (i.e. pacemakers,",\n              "Procedure": [\n                "MRI"\n              ],\n              "Procedure-Name": [\n                "MRI"\n              ],\n              "Contraindication": [\n                "contraindications"\n              ],\n              "Condition": [\n                "pacemakers"\n              ],\n              "Condition-Name": [\n                "pacemakers"\n              ]\n            },\n            "right": {\n              "raw_text": "non-MR compatible devices).",\n              "Condition": [\n                "non-MR compatible devices"\n              ],\n              "Condition-Name": [\n                "non-MR compatible devices"\n              ]\n            }\n          }\n        }\n      }\n    },\n    "right": {\n      "raw_text": "5. Patients with a history of drug hypersensitivity to 18F-Fluciclovine.",\n      "Eq-Comparison": [\n        "history"\n      ],\n      "Eq-Temporal-Period": [\n        "history"\n      ],\n      "Drug": [\n        "18F-Fluciclovine"\n      ],\n      "Drug-Name": [\n        "18F-Fluciclovine"\n      ],\n      "Condition": [\n