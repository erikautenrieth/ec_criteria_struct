 the sampling site\n-  Patient with cancer at the sampling site\n\n### Response:\n{\n  "AND": {\n    "left": {\n      "raw_text": "- Patient who has previously undergone radiotherapy at the sampling site",\n      "Eq-Comparison": [\n        "previously undergone"\n      ],\n      "Procedure": [\n        "radiotherapy"\n      ],\n      "Eq-Temporal-Period": [\n        "previously undergone"\n      ],\n      "Procedure-Name": [\n        "radiotherapy"\n      ],\n      "Modifier": [\n        "sampling site"\n      ]\n    },\n    "right": {\n      "raw_text": "- Patient with cancer at the sampling site",\n      "Condition": [\n        "cancer"\n      ],\n      "Condition-Name": [\n        "cancer"\n      ],\n      "Modifier": [\n        "sampling site"\n      ]\n    }\n  }\n}<|eot_id|>']
