   "months"\n                      ]\n                    },\n                    "right": {\n                      "OR": {\n                        "left": {\n                          "raw_text": "lactating,",\n                          "Condition": [\n                            "lactating"\n                          ],\n                          "Condition-Name": [\n                            "lactating"\n                          ]\n                        },\n                        "right": {\n                          "raw_text": "or intention to become pregnant",\n                          "Condition": [\n                            "pregnant"\n                          ],\n                          "Condition-Name": [\n                            "pregnant"\n                          ],\n                          "Assertion": [\n                            "intention"\n                          ]\n                        }\n                      }\n                    }\n                  }\n                }\n              }\n            }\n          }\n        },\n        "right": {\n          "OR": {\n            "left": {\n              "raw_text": "- allergy to whey",\n              "Eq-Operator": [\n                "-"\n              ],\n              "Allergy": [\n                "allergy"\n              ],\n              "Allergy-Name": [\n                "whey"\n              ]\n            },\n            "right": {\n              "raw_text": "or soy",\n              "Allergy-Name": [\n                "soy"\n              ]\n            }\n          }\n        }\n      }\n    },\n    "right": {\n      "raw_text": "- changes in body weight more than 10 pounds in the past three months",\n      "Eq-Comparison": [\n        "more than 10 pounds",\n        "past three months"\n      ],\n      "Observation": [\n        "body weight"\n      ],\n      "Eq-Operator": [\n        "-",\n        "more than"\n      ],\n      "Eq-Value": [\n        "10",\n     