         "drive time"\n                                  ],\n                                  "Observation-Name": [\n                                    "drive time"\n                                  ],\n                                  "Location": [\n                                    "hospital"\n                                  ]\n                                }\n                              }\n                            }\n                          }\n                        }\n                      }\n                    }\n                  }\n                },\n                "right": {\n                  "raw_text": "3. the only antibiotic associated with patient is administered in the operating room as this likely represents pre-operative infection prophylaxis and not presumed infection;",\n                  "Procedure": [\n                    "operative infection prophylaxis",\n                    "antibiotic"\n                  ],\n                  "Procedure-Name": [\n                    "operative infection prophylaxis",\n                    "antibiotic"\n                  ],\n                  "Condition": [\n                    "infection"\n                  ],\n                  "Condition-Name": [\n                    "infection"\n                  ],\n                  "Assertion": [\n                    "not"\n                  ],\n                  "Location": [\n                    "operating room"\n                  ]\n                }\n              }\n            },\n            "right": {\n              "raw_text": "4. patients transferred from other acute care hospitals;",\n              "Encounter": [\n                "transferred"\n              ],\n              "Location": [\n                "hospitals"\n              ],\n              "Other": [\n                "other"\n              ]\n            }\n          }\n        },\n        "right": {\n          "AND": {\n            "left": {\n              "raw_text": "5. patients with a change in code status (i.e., do",\n              "Observation": [\n                "code status"\n              ],\n              "Observation-Name": [\n                "code status"\n              ],\n              "Stability": [\n                "change"\n              ],\n              "Assertion": [\n                "do"\n              ]\n            },\n            "right": {\n              "NOT": {\n                "left": {\n                  "OR": {\n                    "left": {\n                      "raw_text": "not resuscitate,",\n                      "Negation": [\n                        "not"\n                      ],\n                      "Procedure": [\n                        "resuscitate"\n                      ],\n                      "Procedure-Name": [\n                        "resuscitate"\n                      ],\n                      "Assertion": [\n                        "not"\n                      ]\n                    },\n                    "right": {\n                      "NOT": {\n                        "left": {\n                          "raw_text": "do not intubate) within 24 hours after admission due to the general assumption of increased risk of exposure to less aggressive treatment;",\n                          "Eq-Comparison": [\n                            "within 24 hours"\n                          ],\n                          "Eq-Value": [\n                            "2",\n                            "24"\n                          ],\n                          "Eq-Temporal-Unit": [\n                            "hours"\n                          ],\n                          "Eq-Operator": [\n                            "within"\n                          ],\n                          "Encounter": [\n                            "admission"\n                          ],\n                          "Procedure": [\n                            "intubate"\n                          ],\n                      