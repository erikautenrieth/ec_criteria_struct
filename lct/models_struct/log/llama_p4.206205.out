\n                                          "Modifier": [\n                                            "galactose"\n                                          ]\n                                        },\n                                        "right": {\n                                          "raw_text": "or glucose",\n                                          "Modifier": [\n                                            "glucose"\n                                          ]\n                                        }\n                                      }\n                                    }\n                                  }\n                                }\n                              }\n                            }\n                          }\n                        },\n                        "right": {\n                          "OR": {\n                            "left": {\n                              "raw_text": "- Current",\n                              "Eq-Comparison": [\n                                "Current"\n                              ],\n                              "Eq-Temporal-Period": [\n                                "Current"\n                              ]\n                            },\n                            "right": {\n                              "OR": {\n                                "left": {\n                                  "raw_text": "or past history of drug",\n                                  "Eq-Comparison": [\n                                    "past"\n                                  ],\n                                  "Drug": [\n                                    "drug"\n                                  ],\n                                  "Eq-Temporal-Period": [\n                                    "past"\n                                  ],\n                                  "Modifier": [\n                                    "history"\n                                  ]\n            