          "Age": [\n            "old"\n          ],\n          "Eq-Value": [\n            "18"\n          ],\n          "Eq-Temporal-Unit": [\n            "Years"\n          ],\n          "Eq-Operator": [\n            "Over"\n          ]\n        }\n      }\n    },\n    "right": {\n      "raw_text": "- Able to consent to being in the study.",\n      "Study": [\n        "study"\n      ],\n      "Assertion": [\n        "Able to"\n      ]\n    }\n  }\n}<|eot_id|>']
