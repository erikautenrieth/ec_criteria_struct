he logical operators, without omitting any words or information.\n- The output should only contain the JSON object, without any additional text or formatting.\n- Ensure that the JSON output strictly follows these rules and accurately represents the logical structure of the input eligibility criteria.\n\n### Input:\n-  diagnosis of schizophrenia OR schizoaffective-depressed OR healthy subjects\n-  ages 18-50 for all subjects\n-  double barrier contraception for all subjects\n-  not pregnant for all subjects\n\n### Response:\n{\n  "AND": {\n    "left": {\n      "AND": {\n        "left": {\n          "AND": {\n            "left": {\n              "OR": {\n                "left": {\n                  "raw_text": "- diagnosis of schizophrenia",\n                  "Condition": [\n                    "schizophrenia"\n                  ],\n                  "Condition-Name": [\n                    "schizophrenia"\n                  ]\n                },\n                "right": {\n                  "raw_text": "OR schizoaffective-depressed OR healthy subjects",\n                  "Condition": [\n                    "schizoaffective-depressed"\n                  ],\n                  "Condition-Name": [\n                    "schizoaffective-depressed"\n                  ],\n                  "Condition": [\n                    "healthy"\n                  ],\n                  "Condition-Name": [\n                    "healthy"\n                  ]\n                }\n              }\n            },\n            "right": {\n              "raw_text": "- ages 18-50 for all subjects",\n              "Eq-Temporal-Unit": [\n                "ages"\n              ],\n              "Eq-Value": [\n                "18",\n                "50"\n              ],\n              "Eq-Comparison": [\n                "18-50"\n              ],\n              "Eq-Operator": [\n                "-"\n              ],\n              "Age": [\n                "ages"\n              ]\n            }\n          }\n        },\n        "right": {\n          "raw_text": "- double barrier contraception for all subjects",\n          "Procedure": [\n            "double barrier contraception"\n          ],\n          "Procedure-Name": [\n            "double barrier contraception"\n          ],\n          "Eq-Operator": [\n            "-"\n          ]\n        }\n      }\n    },\n    "right": {\n      "AND": {\n        "left": {\n          "raw_text": "-"\n        },\n        "right": {\n          "NOT": {\n            "left": {\n              "raw_text": "not pregnant for all subjects",\n              "Condition": [\n                "pregnant"\n              ],\n              "Condition-Name": [\n                "pregnant"\n              ],\n              "Negation": [\n                "not"\n              ]\n            }\n          }\n        }\n      }\n    }\n  }\n}<|eot_id|>']
