  "AND": {
    "left": {
      "AND": {
        "left": {
          "raw_text": "1. OHCA: Every patient who suffered a cardiac arrest that occurred in any location other than a hospital, and was attended and/or treated by an EMS.",
          "Condition": [
            "cardiac arrest"
          ],
          "Condition-Name": [
