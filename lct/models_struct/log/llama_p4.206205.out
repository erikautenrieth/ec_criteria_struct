      "raw_text": "- Participants with selected acute",\n                      "Acuteness": [\n                        "acute"\n                      ]\n                    },\n                    "right": {\n                      "OR": {\n                        "left": {\n                          "raw_text": "or chronic infections",\n                          "Condition": [\n                            "infections"\n                          ],\n                          "Condition-Name": [\n                            "infections"\n                          ],\n                          "Acuteness": [\n                            "chronic"\n                          ]\n                        },\n                        "right": {\n                          "raw_text": "or infection history.",\n                          "Condition": [\n                            "infection"\n                          ],\n                          "Condition-Name": [\n                            "infection"\n                          ],\n                          "Eq-Comparison": [\n                            "history"\n                          ],\n                          "Eq-Temporal-Period": [\n                            "history"\n                          ]\n                        }\n                      }\n                    }\n                  }\n                }\n              }\n            },\n            "right": {\n              "OR": {\n                "left": {\n                  "raw_text": "- History of alcohol abuse",\n                  "Condition": [\n                    "alcohol abuse"\n                  ],\n                  "Condition-Name": [\n                    "alcohol abuse"\n                  ],\n                  "Eq-Comparison": [\n                    "History"\n                  ],\n                  "Eq-Temporal-Period": [\n                    "History"\n                  ]\n                },\n                "right": {\n                 