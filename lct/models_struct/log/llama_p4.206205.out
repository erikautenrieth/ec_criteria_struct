he logical operators, without omitting any words or information.\n- The output should only contain the JSON object, without any additional text or formatting.\n- Ensure that the JSON output strictly follows these rules and accurately represents the logical structure of the input eligibility criteria.\n\n### Input:\n1. Known allergies to iodides\n2. Known history of coagulopathy\n3. Women who are pregnant or breastfeeding, or for whom possibility of pregnancy was not ruled out\n\n### Response:\n{\n  "AND": {\n    "left": {\n      "AND": {\n        "left": {\n          "raw_text": "1. Known allergies to iodides",\n          "Eq-Value": [\n            "1"\n          ],\n          "Allergy": [\n            "allergies"\n          ],\n          "Allergy-Name": [\n            "iodides"\n          ]\n        },\n        "right": {\n          "raw_text": "2. Known history of coagulopathy",\n          "Condition": [\n            "coagulopathy"\n          ],\n          "Condition-Name": [\n            "coagulopathy"\n          ],\n          "Eq-Comparison": [\n            "history"\n          ],\n          "Eq-Temporal-Period": [\n            "history"\n          ]\n        }\n      }\n    },\n    "right": {\n      "OR": {\n        "left": {\n          "raw_text": "3. Women",\n          "Life-Stage-And-Gender": [\n            "Women"\n          ]\n        },\n        "right": {\n          "AND": {\n            "left": {\n              "raw_text": "who are pregnant",\n              "Condition": [\n                "pregnant"\n              ],\n              "Condition-Name": [\n                "pregnant"\n              ]\n            },\n            "right": {\n              "raw_text": "or breastfeeding, or for whom possibility of pregnancy was not ruled out",\n              "Condition": [\n                "pregnancy",\n                "breastfeeding"\n              ],\n              "Condition-Name": [\n                "pregnancy",\n                "breastfeeding"\n              ],\n              "Assertion": [\n                "possibility"\n              ]\n            }\n          }\n        }\n      }\n    }\n  }\n}<|eot_id|>']
Response: {
  "AND": {
    "left": {
      "AND": {
        "left": {
          "raw_text": "1. Known allergies to iodides",
          "Eq-Value": [
            "1"
          ],
          "Allergy": [
            "allergies"
          ],
          "Allergy-Name": [
            "iodides"
          ]
        },
        "right": {
          "raw_text": "2. Known history of coagulopathy",
          "Condition": [
            "coagulopathy"
          ],
          "Condition-Name": [
            "coagulopathy"
          ],
          "Eq-Comparison": [
            "history"
          ],
          "Eq-Temporal-Period": [
            "history"
          ]
        }
      }
    },
    "right": {
      "OR": {
        "left": {
          "raw_text": "3. Women",
          "Life-Stage-And-Gender": [
            "Women"
          ]
        },
        "right": {
          "AND": {
            "left": {
              "raw_text": "who are pregnant",
              "Condition": [
                "pregnant"
              ],
              "Condition-Name": [
                "pregnant"
              ]
            },
            "right": {
              "raw_text": "or breastfeeding, or for whom possibility of pregnancy was not ruled out",
              "Condition": [
                "pregnancy",
                "breastfeeding"
              ],
              "Condition-Name": [
                "pregnancy",
                "breastfeeding"
              ],
              "Assertion": [
                "possibility"
              ]
            }
          }
        }
      }
    }
  }
}
