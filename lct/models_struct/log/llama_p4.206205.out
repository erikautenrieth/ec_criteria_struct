he logical operators, without omitting any words or information.\n- The output should only contain the JSON object, without any additional text or formatting.\n- Ensure that the JSON output strictly follows these rules and accurately represents the logical structure of the input eligibility criteria.\n\n### Input:\n1. An active, progressive physical illness directly related to the onset and course of the sleep disturbance;\n2. evidence of sleep apnea, restless legs or periodic limb movements;\n3. significantly impairing pervasive developmental disorder;\n4. history of substance dependence in the past six months;\n5. suicide risk; bipolar disorder or schizophrenia or another current Axis I disorder if there is a significant risk of harm and/or decompensation if treatment of that comorbid condition is delayed as a function of participating in any stage of this study;\n6. Participants will not be excluded if medications are stable (> 4 weeks).\n\n### Response:\n{\n  "AND": {\n    "left": {\n      "AND": {\n        "left": {\n          "AND": {\n            "left": {\n              "AND": {\n                "left": {\n                  "AND": {\n                    "left": {\n                      "OR": {\n                        "left": {\n                          "raw_text": "1. An active, progressive physical illness directly related to the onset",\n                          "Condition": [\n                            "physical illness"\n                          ],\n                          "Condition-Name": [\n                            "physical illness"\n                          ],\n                          "Eq-Comparison": [\n                            "active"\n                          ],\n                          "Eq-Temporal-Period": [\n                            "active"\n                          ],\n                          "Modifier": [\n                            "progressive"\n                          ],\n                          "Observation": [\n                            "onset"\n                          ],\n                          "Observation-Name": [\n                            "onset"\n                          ],\n                          "Stability": [\n                            "related"\n                          ]\n                        },\n                        "right": {\n                          "raw_text": "and course of the sleep disturbance;",\n                          "Condition": [\n                            "sleep disturbance"\n                          ],\n                          "Condition-Name": [\n                            "sleep disturbance"\n                          ],\n                          "Observation": [\n                            "course"\n                          ],\n                          "Observation-Name": [\n                            "course"\n                          ]\n                        }\n                      }\n                    },\n                    "right": {\n                      "OR": {\n                        "left": {\n                          "raw_text": "2. evidence of sleep apnea,",\n                          "Condition": [\n                            "sleep apnea"\n                          ],\n                          "Condition-Name": [\n                            "sleep apnea"\n                          ]\n                        },\n                        "right": {\n                          "OR": {\n                            "left": {\n                              "raw_text": "restless legs",\n                              "Condition": [\n                                "restless legs"\n                              ],\n                              "Condition-Name": [\n                                "restless legs"\n                              ]\n                            },\n                            "right": {\n                              "raw_text": "or periodic limb movements;",\n                              "Condition": [\n                                "periodic limb movements"\n                              ],\n                              "Condition-Name": [\n                                "periodic limb movements"\n                              ]\n                            }\n                          }\n                        }\n                      }\n                    }\n                  }\n                },\n                "right": {\n                  "raw_text": "3. significantly impairing pervasive developmental disorder;",\n                  "Condition": [\n                    "pervasive developmental disorder"\n                  ],\n                  "Condition-Name": [\n                    "pervasive developmental disorder"\n                  ],\n                  "Severity": [\n                    "significantly"\n                  ]\n                }\n              }\n            },\n            "right": {\n              "raw_text": "4. history of substance dependence in the past six months;",\n              "Condition": [\n                "substance dependence"\n              ],\n              "Condition-Name": [\n                "substance dependence"\n              ],\n              "Eq-Comparison": [\n                "history",\n                "past six months"\n              ],\n              "Eq-Temporal-Period": [\n                "history"\n              ],\n              "Eq-Temporal-Unit": [\n                "months"\n              ],\n              "Eq-Value": [\n                "six"\n              ],\n              "Eq-Temporal-Range": [\n                "past"\n              ]\n            }\n          }\n        },\n        "right": {\n          "OR": {\n            "left": {\n              "raw_text": "5. suicide risk; bipolar disorder",\n              "Condition": [\n                "bipolar disorder"\n              ],\n              "Condition-Name": [\n                "bipolar disorder"\n              ],\n              "Risk": [\n                "risk"\n              ],\n              "Observation": [\n                "suicide"\n              ],\n              "Observation-Name": [\n                "suicide"\n              ]\n            },\n            "right": {\n              "OR": {\n                "left": {\n                  "raw_text": "or schizophrenia",\n                  "Condition": [\n                    "schizophrenia"\n                  ],\n                  "Condition-Name": [\n                    "schizophrenia"\n                  ]\n                },\n                "right": {\n                  "raw_text": "or another current Axis I disorder if there is a significant risk of harm and/or decompensation if treatment of that comorbid condition is delayed as a function of participating in any stage of this study;",\n                  "Condition": [\n                    "Axis I disorder",\n                    "comorbid condition"\n                  ],\n                  "Condition-Name": [\n                    "Axis I disorder"\n                  ],\n                  "Risk": [\n                    "risk"\n                  ],\n                  "Severity": [\n                    "significant"\n                  ],\n                  "Study": [\n                    "study"\n                  ],\n                  "Stability": [\n                    "decompensation"\n                  ],\n                  "Observation": [\n                    "harm"\n                  ],\n                  "Observation-Name": [\n                    "harm"\n                  ],\n                  "Assertion": [\n                    "if"\n                  ],\n                  "Other": [\n                    "another"\n                  ]\n                }\n              }\n            }\n          }\n        }\n      }\n    },\n    "right": {\n      "raw_text": "6. Participants will not be excluded if medications are stable (> 4 weeks).",\n      "Eq