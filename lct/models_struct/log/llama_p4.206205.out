he logical operators, without omitting any words or information.\n- The output should only contain the JSON object, without any additional text or formatting.\n- Ensure that the JSON output strictly follows these rules and accurately represents the logical structure of the input eligibility criteria.\n\n### Input:\n-  -Fetal pathology known prenatally like intrauterine severe growth retardation with Doppler abnormalities, fetal malformation or a known fetal genetic defect.\n-  Anomaly of placental adhesion.\n-  Caesarean in a context of medical or obstetric emergency.\n-  Caesarean section performed under general anesthesia following failure of locoregional anesthesia.\n-  Refusal of the woman to participate in the study.\n-  Impossibility or failure to study the neonatal acid-base balance on the umbilical cord.\n\n### Response:\n{\n  "AND": {\n    "left": {\n      "AND": {\n        "left": {\n          "AND": {\n            "left": {\n              "AND": {\n                "left": {\n                  "AND": {\n                    "left": {\n                      "OR": {\n                        "left": {\n                          "raw_text": "- -Fetal pathology known prenatally like intrauterine severe growth retardation",\n                          "Condition": [\n                            "Fetal pathology",\n                            "intrauterine severe growth retardation"\n                          ],\n                          "Condition-Name": [\n                            "Fetal pathology",\n                            "intrauterine severe growth retardation"\n                          ],\n                          "Procedure": [\n                            "prenatally"\n                          ],\n                          "Procedure-Name": [\n                            "prenatally"\n                          ]\n                        },\n                        "right": {\n                          "OR": {\n                            "left": {\n                              "raw_text": "with Doppler abnormalities,",\n                              "Procedure": [\n                                "Doppler"\n                              ],\n                              "Procedure-Name": [\n                                "Doppler"\n                              ],\n                              "Polarity": [\n                                "abnormalities"\n                              ]\n                            },\n                            "right": {\n                              "OR": {\n                                "left": {\n                                  "raw_text": "fetal malformation",\n                                  "Condition": [\n                                    "fetal malformation"\n                                  ],\n                                  "Condition-Name": [\n                                    "fetal malformation"\n                                  ]\n                                },\n                                "right": {\n                                  "raw_text": "or a known fetal genetic defect.",\n                                  "Condition": [\n                                    "fetal genetic defect"\n                                  ],\n                                  "Condition-Name": [\n                                    "fetal genetic defect"\n                                  ]\n                                }\n                              }\n                            }\n                          }\n                        }\n                      }\n                    },\n                    "right": {\n                      "raw_text": "- Anomaly of placental adhesion.",\n                      "Condition": [\n                        "Anomaly of placental adhesion"\n                      ],\n                      "Condition-Name": [\n                        "Anomaly of placental adhesion"\n                      ]\n                    }\n                  }\n                },\n                "right": {\n                  "OR": {\n                    "left": {\n                      "raw_text": "- Caesarean in a context of medical",\n                      "Procedure": [\n                        "Caesarean"\n                      ],\n                      "Procedure-Name": [\n                        "Caesarean"\n                      ],\n                      "Modifier": [\n                        "medical"\n                      ]\n                    },\n                    "right": {\n                      "raw_text": "or obstetric emergency.",\n                      "Encounter": [\n                        "emergency"\n                      ],\n                      "Modifier": [\n                        "obstetric"\n                      ]\n                    }\n                  }\n                }\n              }\n            },\n            "right": {\n              "raw_text": "- Caesarean section performed under general anesthesia following failure of locoregional anesthesia.",\n              "Procedure": [\n                "Caesarean section",\n                "general anesthesia",\n                "locoregional anesthesia"\n              ],\n              "Procedure-Name": [\n                "Caesarean section",\n                "general anesthesia",\n                "locoregional anesthesia"\n              ],\n              "Stability": [\n                "failure"\n              ]\n            }\n          }\n        },\n        "right": {\n          "raw_text": "- Refusal of the woman to participate in the study.",\n          "Study": [\n            "study"\n          ]\n        }\n      }\n    },\n    "right": {\n      "raw_text": "- Impossibility or failure to study the neonatal acid-base balance on the umbilical cord.",\n      "Observation": [\n        "neonatal acid-base balance"\n      ],\n      "Observation-Name": [\n        "neonatal acid-base balance"\n      ],\n      "Specimen": [\n        "umbilical cord"\n      ],\n      "Study": [\n        "study"\n      ],\n      "Stability": [\n        "failure"\n      ],\n      "Assertion": [\n        "Impossibility"\n      ]\n    }\n  }\n}<|eot_id|>']
