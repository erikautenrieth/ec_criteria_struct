            }
          }
        },
        "right": {
          "raw_text": "- associated neurological diseases",
          "Condition": [
            "neurological diseases"
          ],
          "Condition-Name": [
            "neurological diseases"
          ]
        }
      }
    },
    "right": {
      "raw_text": "- morbid obesity",
      "Condition": [
        "morbid obesity"
