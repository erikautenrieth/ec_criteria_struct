he logical operators, without omitting any words or information.\n- The output should only contain the JSON object, without any additional text or formatting.\n- Ensure that the JSON output strictly follows these rules and accurately represents the logical structure of the input eligibility criteria.\n\n### Input:\n-  Primipara (no previous pregnancies)\n-  18 to 25 years of age\n-  Gestation <15 weeks at first prenatal visit\n-  No intention to move outside the city of Santiago in the next to years\n\n### Response:\n{\n  "AND": {\n    "left": {\n      "AND": {\n        "left": {\n          "AND": {\n            "left": {\n              "raw_text": "- Primipara (no previous pregnancies)",\n              "Condition": [\n                "Primipara",\n                "pregnancies"\n              ],\n              "Condition-Name": [\n                "Primipara",\n                "pregnancies"\n              ],\n              "Eq-Comparison": [\n                "previous"\n              ],\n              "Eq-Temporal-Period": [\n                "previous"\n              ],\n              "Negation": [\n                "no"\n              ]\n            },\n            "right": {\n              "raw_text": "- 18 to 25 years of age",\n              "Eq-Temporal-Unit": [\n                "years"\n              ],\n              "Age": [\n                "age"\n              ],\n              "Eq-Value": [\n                "18",\n                "25"\n              ],\n              "Eq-Comparison": [\n                "18 to 25 years"\n              ],\n              "Eq-Operator": [\n                "to"\n              ]\n            }\n          }\n        },\n        "right": {\n          "raw_text": "- Gestation <15 weeks at first prenatal visit",\n          "Eq-Operator": [\n            "<"\n          ],\n          "Eq-Temporal-Unit": [\n            "weeks"\n          ],\n          "Eq-Value": [\n            "15"\n          ],\n          "Eq-Comparison": [\n            "<15 weeks"\n          ],\n          "Observation": [\n            "Gestation"\n          ],\n          "Observation-Name": [\n            "Gestation"\n          ],\n          "Encounter": [\n            "prenatal visit"\n          ],\n          "Eq-Temporal-Recency": [\n            "first"\n          ]\n        }\n      }\n    },\n    "right": {\n      "AND": {\n        "left": {\n          "raw_text": "-"\n        },\n        "right": {\n          "NOT": {\n            "left": {\n              "raw_text": "No intention to move outside the city of Santiago in the next to years",\n              "Eq-Temporal-Unit": [\n                "years"\n              ],\n              "Eq-Comparison": [\n                "next to years"\n              ],\n              "Eq-Temporal-Period": [\n                "next"\n              ],\n              "Observation": [\n                "move"\n              ],\n              "Observation-Name": [\n                "move"\n              ],\n              "Negation": [\n                "No"\n              ],\n              "Assertion": [\n                "intention"\n              ],\n              "Location": [\n                "city of Santiago"\n              ],\n              "Stability": [\n                "move"\n              ]\n            }\n          }\n        }\n      }\n    }\n  }\n}<|eot_id|>']
