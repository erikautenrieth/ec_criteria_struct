          ],
          "Location": [
            "hospital"
          ]
        }
      }
    },
    "right": {
      "raw_text": "3. the representative population-based survey: Every patient who suffered a cardiac arrest in the selected cities or suburbs.",
      "Condition": [
        "cardiac arrest"
      ],
      "Condition-Name": [
        "cardiac arrest"
      ]
    }
  }
}
