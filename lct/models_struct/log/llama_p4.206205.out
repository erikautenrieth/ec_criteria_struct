 "anticonvulsants"\n                                  ],\n                                  "Drug-Name": [\n                                    "anticonvulsants"\n                                  ]\n                                }\n                              }\n                            }\n                          }\n                        }\n                      }\n                    }\n                  }\n                }\n              }\n            },\n            "right": {\n              "OR": {\n                "left": {\n                  "raw_text": "2. Congenital lower limb musculoskeletal diseases,",\n                  "Condition": [\n                    "Congenital lower limb musculoskeletal diseases"\n                  ],\n                  "Condition-Name": [\n                    "Congenital lower limb musculoskeletal diseases"\n                  ],\n                  "Modifier": [\n                    "lower limb"\n                  ]\n                },\n                "right": {\n                  "OR": {\n                    "left": {\n                      "raw_text": "Lower limb",\n                      "Modifier": [\n                        "Lower limb"\n                      ]\n                    },\n                    "right": {\n                      "raw_text": "or spine surgery",\n                      "Procedure": [\n                        "surgery"\n                      ],\n                      "Procedure-Name": [\n                        "surgery"\n                      ],\n                      "Modifier": [\n                        "spine"\n                      ]\n                    }\n                  }\n                }\n              }\n            }\n          }\n        },\n        "right": {\n          "OR": {\n            "left": {\n              "raw_text": "3. Uncommunicated",\n              "Condition": [\n                "Uncommunicated"\n              ],\n              "Condition-Name": [\n         