eft": {\n              "raw_text": "2. Bone scan positive,",\n              "Procedure": [\n                "Bone scan"\n              ],\n              "Procedure-Name": [\n                "Bone scan"\n              ],\n              "Polarity": [\n                "positive"\n              ]\n            },\n            "right": {\n              "OR": {\n                "left": {\n                  "raw_text": "and proven by other imaging examinations, including computed tomography (CT),",\n                  "Procedure": [\n                    "computed tomography",\n                    "CT",\n                    "imaging examinations"\n                  ],\n                  "Procedure-Name": [\n                    "computed tomography",\n                    "CT",\n                    "imaging examinations"\n                  ],\n                  "Other": [\n                    "other"\n                  ]\n                },\n                "right": {\n                  "OR": {\n                    "left": {\n                      "raw_text": "magnetic resonance imaging (MRI)",\n                      "Procedure": [\n                        "magnetic resonance imaging",\n                        "MRI"\n                      ],\n                      "Procedure-Name": [\n                        "magnetic resonance imaging",\n                        "MRI"\n                      ]\n                    },\n                    "right": {\n                      "raw_text": "and X-ray.",\n                      "Procedure": [\n                        "X-ray"\n                      ],\n                      "Procedure-Name": [\n                        "X-ray"\n                      ]\n                    }\n                  }\n                }\n              }\n            }\n          }\n        }\n      }\n    },\n    "right": {\n      "OR": {\n        "left": {\n          "raw_text": "3. Bone scan positive,",\n          "Procedure": [\n            "Bone scan"\n      