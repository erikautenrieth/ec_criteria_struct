n                                    "current"\n                                  ],\n                                  "Procedure": [\n                                    "immunosuppressive therapies"\n                                  ],\n                                  "Procedure-Name": [\n                                    "immunosuppressive therapies"\n                                  ],\n                                  "Drug": [\n                                    "corticosteroids"\n                                  ],\n                                  "Drug-Name": [\n                                    "corticosteroids"\n                                  ]\n                                },\n                                "right": {\n                                  "OR": {\n                                    "left": {\n                                      "raw_text": "chemotherapy,",\n                                      "Procedure": [\n                                        "chemotherapy"\n                                      ],\n                                      "Procedure-Name": [\n                                        "chemotherapy"\n                                      ]\n                                    },\n                                    "right": {\n                                      "OR": {\n                                        "left": {\n                                          "raw_text": "biotherapy",\n                                          "Procedure": [\n                                            "biotherapy"\n                                          ],\n                                          "Procedure-Name": [\n                                            "biotherapy"\n                                          ]\n                                        },\n                                        "right": {\n                                          "OR": {\n                                           