                "breast cancer"
              ],
              "Condition-Name": [
                "bone metastases",
                "malignant tumor",
                "breast cancer"
              ],
              "Exception": [
                "other than"
              ],
              "Other": [
                "other"
              ]
            }
          }
        },
        "right": {
