                        }\n                                },\n                                "right": {\n                                  "raw_text": "- Heart valve disease",\n                                  "Condition": [\n                                    "Heart valve disease"\n                                  ],\n                                  "Condition-Name": [\n                                    "Heart valve disease"\n                                  ]\n                                }\n                              }\n                            },\n                            "right": {\n                              "raw_text": "- Verified cardiac arrhythmia other than extrasystoles",\n                              "Condition": [\n                                "cardiac arrhythmia",\n                                "extrasystoles"\n                              ],\n                              "Condition-Name": [\n                                "cardiac arrhythmia",\n                                "extrasystoles"\n                              ],\n                              "Exception": [\n                                "other than"\n                              ]\n                            }\n                          }\n                        },\n                        "right": {\n                          "raw_text": "- Verified anaemia with hemoglobin level below 9.0 gr/dl.",\n                          "Condition": [\n                            "anaemia"\n                          ],\n                          "Condition-Name": [\n                            "anaemia"\n                          ],\n                          "Observation": [\n                            "hemoglobin"\n                          ],\n                          "Observation-Name": [\n                            "hemoglobin"\n                          ],\n                          "Eq-Comparison": [\n                            "below 9.0 gr/dl"\n   