   }\n          }\n        },\n        "right": {\n          "OR": {\n            "left": {\n              "raw_text": "- have any other illness, condition,",\n              "Condition": [\n                "illness",\n                "condition"\n              ],\n              "Other": [\n                "other"\n              ]\n            },\n            "right": {\n              "OR": {\n                "left": {\n                  "raw_text": "or use of medications, which in the opinion of the PI and/or admitting physician would preclude safe",\n                  "Drug": [\n                    "medications"\n                  ],\n                  "Provider": [\n                    "admitting physician"\n                  ],\n                  "Stability": [\n                    "preclude"\n                  ],\n                  "Assertion": [\n                    "would"\n                  ]\n                },\n                "right": {\n                  "raw_text": "and/or successful completion of the study",\n                  "Study": [\n                    "study"\n                  ],\n                  "Assertion": [\n                    "successful"\n                  ]\n                }\n              }\n            }\n          }\n        }\n      }\n    },\n    "right": {\n      "raw_text": "-."\n    }\n  }\n}<|eot_id|>']
