 [\n                                    "not"\n                                  ],\n                                  "Assertion": [\n                                    "not"\n                                  ]\n                                }\n                              }\n                            }\n                          }\n                        }\n                      }\n                    }\n                  }\n                }\n              }\n            }\n          }\n        },\n        "right": {\n          "AND": {\n            "left": {\n              "raw_text": "- Use of tetrahydrocannabinol (THC)",\n              "Drug": [\n                "tetrahydrocannabinol",\n                "THC"\n              ],\n              "Drug-Name": [\n                "tetrahydrocannabinol",\n                "THC"\n              ]\n            },\n            "right": {\n              "NOT": {\n                "left": {\n                  "raw_text": "or non-approved cannabidiol (CBD) is prohibited during the double-blind phase",\n                  "Drug": [\n                    "cannabidiol",\n                    "CBD"\n                  ],\n                  "Drug-Name": [\n                    "cannabidiol",\n                    "CBD"\n                  ],\n                  "Study": [\n                    "double-blind"\n                  ],\n                  "Negation": [\n                    "prohibited"\n                  ],\n                  "Assertion": [\n                    "prohibited"\n                  ]\n                }\n              }\n            }\n          }\n        }\n      }\n    },\n    "right": {\n      "raw_text": "- Exposure to any other investigational drug within 30 days or fewer than 5 half-lives prior to screening",\n      "Study": [\n        "screening"\n      ],\n      "Drug": [\n        "drug"\n      ],\n      "Eq-Comparison": [\n        "within 30 days",\n        "fewer than 5 half-lives"\n      ],\n      "Oth