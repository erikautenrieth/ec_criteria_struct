he logical operators, without omitting any words or information.\n- The output should only contain the JSON object, without any additional text or formatting.\n- Ensure that the JSON output strictly follows these rules and accurately represents the logical structure of the input eligibility criteria.\n\n### Input:\n-  Patients with an unilateral THA or TKA, which they received for the treatment of osteoarthritis (Patient groups 1+2)\n-  Patients diagnosed with unilateral OA of the knee or hip planned for a treatment with THA or TKA (Patient groups 3+4)\n-  Age ≥ 30 years (Healthy control group)\n\n### Response:\n{\n  "AND": {\n    "left": {\n      "AND": {\n        "left": {\n          "AND": {\n            "left": {\n              "raw_text": "- Patients with an unilateral THA",\n              "Procedure": [\n                "THA"\n              ],\n              "Procedure-Name": [\n                "THA"\n              ],\n              "Modifier": [\n                "unilateral"\n              ]\n            },\n            "right": {\n              "raw_text": "or TKA, which they received for the treatment of osteoarthritis (Patient groups 1+2)",\n              "Procedure": [\n                "TKA"\n              ],\n              "Procedure-Name": [\n                "TKA"\n              ],\n              "Condition": [\n                "osteoarthritis"\n              ],\n              "Condition-Name": [\n                "osteoarthritis"\n              ],\n              "Eq-Comparison": [\n                "received"\n              ],\n              "Eq-Temporal-Period": [\n                "received"\n              ]\n            }\n          }\n        },\n        "right": {\n          "AND": {\n            "left": {\n              "raw_text": "- Patients diagnosed with unilateral OA of the knee",\n              "Condition": [\n                "OA"\n              ],\n              "Condition-Name": [\n                "OA"\n              ],\n              "Modifier": [\n                "unilateral",\n                "knee"\n              ]\n            },\n            "right": {\n              "OR": {\n                "left": {\n                  "raw_text": "or hip planned for a treatment with THA",\n                  "Procedure": [\n                    "THA"\n                  ],\n                  "Procedure-Name": [\n                    "THA"\n                  ],\n                  "Modifier": [\n                    "hip"\n                  ],\n                  "Eq-Comparison": [\n                    "planned"\n                  ],\n                  "Eq-Temporal-Period": [\n                    "planned"\n                  ],\n                  "Assertion": [\n                    "planned"\n                  ]\n                },\n                "right": {\n                  "raw_text": "or TKA (Patient groups 3+4)",\n                  "Procedure": [\n                    "TKA"\n                  ],\n                  "Procedure-Name": [\n                    "TKA"\n                  ]\n                }\n              }\n            }\n          }\n        }\n      }\n    },\n    "right": {\n      "raw_text": "- Age ≥ 30 years (Healthy control group)",\n      "Eq-Operator": [\n        "≥"\n      ],\n      "Eq-Temporal-Unit": [\n        "years"\n      ],\n      "Age": [\n        "Age"\n      ],\n      "Eq-Value": [\n        "30"\n      ],\n      "Eq-Comparison": [\n        "≥ 30 years"\n      ]\n    }\n  }\n}<|eot_id|>']
