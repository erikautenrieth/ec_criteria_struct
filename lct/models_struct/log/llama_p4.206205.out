      "Observation": [
        "San Felipe tribal members"
      ],
      "Observation-Name": [
        "San Felipe tribal members"
      ]
    },
    "right": {
      "raw_text": "- Endorse suicidal ideation or behaviors on a universal screen by their primary care provider.",
      "Condition": [
        "suicidal ideation",
        "suicidal"
      ],
