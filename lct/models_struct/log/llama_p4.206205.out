he logical operators, without omitting any words or information.\n- The output should only contain the JSON object, without any additional text or formatting.\n- Ensure that the JSON output strictly follows these rules and accurately represents the logical structure of the input eligibility criteria.\n\n### Input:\n-  American Indian youth aged 13-24 years old who are San Felipe tribal members living in the Pueblo\n-  Endorse suicidal ideation or behaviors on a universal screen by their primary care provider.\n\n### Response:\n{\n  "AND": {\n    "left": {\n      "raw_text": "- American Indian youth aged 13-24 years old who are San Felipe tribal members living in the Pueblo",\n      "Life-Stage-And-Gender": [\n        "youth"\n      ],\n      "Age": [\n        "aged"\n      ],\n      "Eq-Comparison": [\n        "13-24 years"\n      ],\n      "Eq-Value": [\n        "13",\n        "24"\n      ],\n      "Eq-Operator": [\n        "-"\n      ],\n      "Eq-Temporal-Unit": [\n        "years"\n      ],\n      "Ethnicity": [\n        "American Indian"\n      ],\n      "Location": [\n        "Pueblo"\n      ],\n      "Observation": [\n        "San Felipe tribal members"\n      ],\n      "Observation-Name": [\n        "San Felipe tribal members"\n      ]\n    },\n    "right": {\n      "raw_text": "- Endorse suicidal ideation or behaviors on a universal screen by their primary care provider.",\n      "Condition": [\n        "suicidal ideation",\n        "suicidal"\n      ],\n      "Condition-Name": [\n        "suicidal ideation",\n        "suicidal"\n      ],\n      "Eq-Operator": [\n        "-"\n      ],\n      "Observation": [\n        "universal screen"\n      ],\n      "Observation-Name": [\n        "universal screen"\n      ],\n      "Provider": [\n        "primary care provider"\n      ]\n    }\n  }\n}<|eot_id|>']
Response: {
  "AND": {
    "left": {
      "raw_text": "- American Indian youth aged 13-24 years old who are San Felipe tribal members living in the Pueblo",
      "Life-Stage-And-Gender": [
        "youth"
      ],
      "Age": [
        "aged"
      ],
      "Eq-Comparison": [
        "13-24 years"
      ],
      "Eq-Value": [
