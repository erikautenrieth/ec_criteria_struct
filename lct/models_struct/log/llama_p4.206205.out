 "raw_text": "eggs",\n                          "Allergy-Name": [\n                            "eggs"\n                          ]\n                        },\n                        "right": {\n                          "raw_text": "or peanuts",\n                          "Allergy-Name": [\n                            "peanuts"\n                          ]\n                        }\n                      }\n                    }\n                  }\n                }\n              }\n            },\n            "right": {\n              "raw_text": "- Pregnancy",\n              "Condition": [\n                "Pregnancy"\n              ],\n              "Condition-Name": [\n                "Pregnancy"\n              ]\n            }\n          }\n        },\n        "right": {\n          "raw_text": "- Poor health state"\n        }\n      }\n    },\n    "right": {\n      "raw_text": "- Illicit substance use",\n      "Condition": [\n        "Illicit substance use"\n      ],\n      "Condition-Name": [\n        "Illicit substance use"\n      ]\n    }\n  }\n}<|eot_id|>']
