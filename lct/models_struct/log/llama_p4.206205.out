    },\n                                                                                "right": {\n                                                                                  "OR": {\n                                                                                    "left": {\n580                              "raw_text": "exocrine pancreatic insufficiency",\n580                              "Condition": [\n                                "exocrine pancreatic insufficiency"\n                              ],\n580                              "Condition-Name": [\n                                "exocrine pancreatic insufficiency"\n                              ]\n                            },\n                            "right": {\n                              "raw_text": "or small bowel malabsorption",\n                              "Condition": [\n                                "small bowel malabsorption"\n                              ],\n                              "Condition-Name": [\n                                "small bowel malabsorption"\n                              ]\n                            }\n                          }\n                        },\n                        "right": {\n                          "raw_text": "3. Patients with active bowel malignancy",\n                          "Condition": [\n                            "bowel malignancy"\n                          ],\n                          "Condition-Name": [\n                            "bowel malignancy"\n                          ],\n                          "Eq-Comparison": [\n                            "active"\n                          ],\n                          "Eq-Temporal-Period": [\n                            "active"\n                          ]\n                        }\n                      }\n                    },\n                    "right": {\n                      "OR": {\n                        "left": {\n                          "raw_text": "4. Patients with diabetes mellitus",\n                          "Condition": [\n                            "diabetes mellitus"\n                          ],\n                          "Condition-Name": [\n                            "diabetes mellitus"\n                          ]\n                        },\n                        "right": {\n                          "OR": {\n                            "left": {\n                              "raw_text": "or known/",\n                              "Modifier": [\n                                "known"\n                              ]\n                            },\n                            "right": {\n                              "OR": {\n                                "left": {\n                                  "raw_text": "suspected motility disorders of the gut",\n                                  "Condition": [\n                                    "motility disorders"\n                                  ],\n                                  "Condition-Name": [\n                                    "motility disorders"\n                                  ],\n                                  "Modifier": [\n                                    "gut"\n                                  ],\n                                  "Assertion": [\n                                    "suspected"\n                                  ]\n                                },\n                                "right": {\n                                  "raw_text": "5. Patients with decompensated liver disease",\n                                  "Condition": [\n                                    "liver disease"\n                                  ],\n                                  "Condition-Name": [\n                                    "liver disease"\n                                  ],\n                                  "Modifier": [\n                                    "decompensated"\n                         