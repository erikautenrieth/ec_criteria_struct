ck (<24 hours) with norepinephrine\nof more than 10 ug/min and lactate >4 mmol/L.\n\n### Response:\n{\n  "AND": {\n    "left": {\n      "raw_text": "- Critically ill cirrhotics",\n      "Condition": [\n        "cirrhotics"\n      ],\n      "Condition-Name": [\n        "cirrhotics"\n      ],\n      "Severity": [\n        "Critically"\n      ],\n      "Condition-Type": [\n        "ill"\n      ]\n    },\n    "right": {\n      "AND": {\n        "left": {\n          "raw_text": "with early onset septic shock (<24 hours)",\n          "Condition": [\n            "septic shock"\n          ],\n          "Condition-Name": [\n            "septic shock"\n          ],\n          "Eq-Operator": [\n            "<"\n          ],\n          "Eq-Temporal-Unit": [\n            "hours"\n          ],\n          "Eq-Value": [\n            "24"\n          ],\n          "Eq-Comparison": [\n            "<24 hours"\n          ],\n          "Modifier": [\n            "early onset"\n          ]\n        },\n        "right": {\n          "AND": {\n            "left": {\n              "raw_text": "with norepinephrine",\n              "Drug": [\n                "norepinephrine"\n              ],\n              "Drug-Name": [\n                "norepinephrine"\n              ]\n            },\n            "right": {\n              "raw_text": "of more than 10 ug/min and lactate >4 mmol/L.",\n              "Eq-Operator": [\n                "more than",\n                ">"\n              ],\n              "Eq-Unit": [\n                "ug",\n                "mmol",\n                "L"\n              ],\n              "Eq-Value": [\n                "10",\n                "4"\n              ],\n              "Eq-Comparison": [\n                "more than 10 ug/min",\n                ">4 mmol/L"\n              ],\n              "Eq-Temporal-Unit": [\n                "min"\n              ],\n              "Observation": [\n                "lactate"\n              ],\n              "Observation-Name": [\n                "lactate"\n              ]\n            }\n          }\n        }\n      }\n    }\n  }\n}<|eot_id|>']
