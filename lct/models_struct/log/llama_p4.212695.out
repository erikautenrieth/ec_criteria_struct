           "months"\n                      ],\n                      "Modifier": [\n                        "shoulder"\n                      ]\n                    }\n                  }\n                },\n                "right": {\n                  "OR": {\n                    "left": {\n                      "raw_text": "- History of recent lung,",\n                      "Eq-Comparison": [\n                        "History",\n                        "recent"\n                      ],\n                      "Eq-Temporal-Period": [\n                        "History",\n                        "recent"\n                      ],\n                      "Modifier": [\n                        "lung"\n                      ]\n                    },\n                    "right": {\n                      "OR": {\n                        "left": {\n                          "raw_text": "breast",\n                          "Modifier": [\n                            "breast"\n                          ]\n                        },\n                        "right": {\n                          "raw_text": "or bypass surgery",\n                          "Procedure": [\n                            "surgery"\n                          ],\n                          "Procedure-Name": [\n                            "surgery"\n                          ],\n                          "Modifier": [\n                            "bypass"\n                          ]\n                        }\n                      }\n                    }\n                  }\n                }\n              }\n            },\n            "right": {\n              "OR": {\n                "left": {\n                  "raw_text": "- History of cervical radiculopathy/",\n                  "Condition": [\n                    "cervical radiculopathy"\n                  ],\n                  "Condition-Name": [\n                    "cervical radiculopathy"\n                  ],\n                  "Eq-Comp