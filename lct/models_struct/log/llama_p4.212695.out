                    "Procedure": [\n                        "antibiotic treatment"\n                      ],\n                      "Procedure-Name": [\n                        "antibiotic treatment"\n                      ]\n                    }\n                  }\n                }\n              }\n            }\n          }\n        },\n        "right": {\n          "OR": {\n            "left": {\n              "raw_text": "- administration of any infant vitamin",\n              "Life-Stage-And-Gender": [\n                "infant"\n              ],\n              "Eq-Operator": [\n                "-"\n              ],\n              "Drug": [\n                "vitamin"\n              ],\n              "Drug-Name": [\n                "vitamin"\n              ]\n            },\n            "right": {\n              "raw_text": "or mineral supplements for the past 2 months",\n              "Drug": [\n                "mineral supplements"\n              ],\n              "Eq-Comparison": [\n                "past 2 months"\n              ],\n              "Eq-Temporal-Period": [\n                "past"\n              ],\n              "Eq-Value": [\n                "2"\n              ],\n              "Eq-Temporal-Unit": [\n                "months"\n              ],\n              "Drug-Name": [\n                "mineral supplements"\n              ]\n            }\n          }\n        }\n      }\n    },\n    "right": {\n      "raw_text": "- any history of infant antibiotic treatment.",\n      "Life-Stage-And-Gender": [\n        "infant"\n      ],\n      "Eq-Comparison": [\n        "history"\n      ],\n      "Eq-Operator": [\n        "-"\n      ],\n      "Eq-Temporal-Period": [\n        "history"\n      ],\n      "Procedure": [\n        "antibiotic treatment"\n      ],\n      "Procedure-Name": [\n        "antibiotic treatment"\n      ]\n    }\n  }\n}<|eot_id|>']
