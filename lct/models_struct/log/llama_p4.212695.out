ht": {\n              "OR": {\n                "left": {\n                  "raw_text": "or",\n                  "Eq-Operator": [\n                    "or"\n                  ]\n                },\n                "right": {\n                  "OR": {\n                    "left": {\n                      "raw_text": "Extramedullary blast proliferation",\n                      "Condition": [\n                        "Extramedullary blast proliferation"\n                      ],\n                      "Condition-Name": [\n                        "Extramedullary blast proliferation"\n                      ]\n                    },\n                    "right": {\n                      "OR": {\n                        "left": {\n                          "raw_text": "or Large foci",\n                          "Condition": [\n                            "Large foci"\n                          ],\n                          "Condition-Name": [\n                            "Large foci"\n                          ]\n                        },\n                        "right": {\n                          "raw_text": "or clusters of blasts in bone marrow biopsy",\n                          "Condition": [\n                            "clusters of blasts"\n                          ],\n                          "Condition-Name": [\n                            "clusters of blasts"\n                          ],\n                          "Procedure": [\n                            "bone marrow biopsy"\n                          ],\n                          "Procedure-Name": [\n                            "bone marrow biopsy"\n                          ]\n                        }\n                      }\n                    }\n                  }\n                }\n              }\n            }\n          }\n        }\n      }\n    }\n  }\n}<|eot_id|>']
