                                         "Modifier": [\n                                                "cardiac"\n                                              ]\n                                            },\n                                            "right": {\n                                              "raw_text": "and cerebrovascular event,",\n                                              "Condition": [\n                                                "event"\n                                              ],\n                                              "Condition-Name": [\n                                                "event"\n                                              ],\n                                              "Modifier": [\n                                                "cerebrovascular"\n                                              ]\n                                            }\n                                          }\n                                        }\n                                      }\n                                    }\n                                  }\n                                }\n                              }\n                            }\n                          }\n                        }\n                      }\n                    },\n                    "right": {\n                      "OR": {\n                        "left": {\n                          "raw_text": "- Endocrine disorder,",\n                          "Condition": [\n                            "Endocrine disorder"\n                          ],\n                          "Condition-Name": [\n                            "Endocrine disorder"\n                          ]\n                        },\n                        "right": {\n                          "OR": {\n                            "left": {\n                              "raw_text": "fluid-electrolyte imbalance",\n                              "Condition": [\