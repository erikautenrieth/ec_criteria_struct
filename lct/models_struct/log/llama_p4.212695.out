 [\n                            "under curatorship"\n                          ]\n                        }\n                      }\n                    }\n                  }\n                }\n              }\n            },\n            "right": {\n              "AND": {\n                "left": {\n                  "raw_text": "- Patient refusing to sign the consent form.",\n                  "Eq-Operator": [\n                    "to"\n                  ]\n                },\n                "right": {\n                  "NOT": {\n                    "left": {\n                      "raw_text": "Patient for which it is impossible to provide information about the study.",\n                      "Negation": [\n                        "impossible"\n                      ],\n                      "Study": [\n                        "study"\n                      ]\n                    }\n                  }\n                }\n              }\n            }\n          }\n        },\n        "right": {\n          "OR": {\n            "left": {\n              "raw_text": "- Pregnant patient, parturient,",\n              "Condition": [\n                "Pregnant",\n                "parturient"\n              ],\n              "Condition-Name": [\n                "Pregnant",\n                "parturient"\n              ]\n            },\n            "right": {\n              "raw_text": "or breastfeeding.",\n              "Condition": [\n                "breastfeeding"\n              ],\n              "Condition-Name": [\n                "breastfeeding"\n              ]\n            }\n          }\n        }\n      }\n    },\n    "right": {\n      "raw_text": "- Patient for which it is impossible to provide information about the study.",\n      "Negation": [\n        "impossible"\n      ],\n      "Study": [\n        "study"\n      ]\n    }\n  }\n}<|eot_id|>']
