                  "malignant transformation"\n                                      ],\n                                      "Negation": [\n                                        "non"\n                                      ]\n                                    }\n                                  }\n                                }\n                              }\n                            }\n                          }\n                        },\n                        "right": {\n                          "raw_text": "4. Medical reasons precluding MRI (eg, pacemaker)",\n                          "Procedure": [\n                            "MRI"\n                          ],\n                          "Procedure-Name": [\n                            "MRI"\n                          ],\n                          "Condition": [\n                            "pacemaker"\n                          ],\n                          "Condition-Name": [\n                            "pacemaker"\n                          ]\n                        }\n                      }\n                    },\n                    "right": {\n                      "AND": {\n                        "left": {\n                          "raw_text": "5. Inability to give consent because of",\n                          "Eq-Value": [\n                            "5"\n                          ]\n                        },\n                        "right": {\n                          "NOT": {\n                            "left": {\n                              "OR": {\n                                "left": {\n                                  "raw_text": "or language barrier",\n                                  "Condition": [\n                                    "language barrier"\n                                  ],\n                                  "Condition-Name": [\n                                    "language barrier"\n                                  ]\n                                },\n                                "right": {\n                                  "raw_text": "or other reasons",\n                                  "Other": [\n                                    "other"\n                                  ]\n                                }\n                              }\n                            }\n                          }\n                        }\n                      }\n                    }\n                  }\n                },\n                "right": {\n                  "raw_text": "6. Psychiatric history",\n                  "Condition": [\n                    "Psychiatric"\n                  ],\n                  "Condition-Name": [\n                    "Psychiatric"\n                  ],\n                  "Eq-Comparison": [\n                    "history"\n                  ],\n                  "Eq-Temporal-Period": [\n                    "history"\n                  ]\n                }\n              }\n            },\n            "right": {\n              "raw_text": "7. Previous brain tumour surgery",\n              "Procedure": [\n                "surgery"\n              ],\n              "Procedure-Name": [\n                "surgery"\n              ],\n              "Condition": [\n                "tumour"\n              ],\n              "Condition-Name": [\n                "tumour"\n              ],\n              "Modifier": [\n                "brain"\n              ],\n              "Eq-Comparison": [\n                "Previous"\n              ],\n              "Eq-Temporal-Period": [\n                "Previous"\n              ]\n            }\n          }\n        },\n        "right": {\n          "raw_text": "8. Previous low-grade glioma.",\n          "Condition": [\n            "glioma"\n          ],\n          "Condition-Name": [\n            "glioma"\n          ],\n          "Eq-Comparison": [\n            "Previous"\n          ],\n          "Eq-Temporal-Period": [\n            "Previous"\n          ],\n          "Modifier": [\n            "low-grade"\n          ]\n        }\n      }\n    },\n    "right": {\n      "OR": {\n        "left": {\n          "raw_text": "9. Second primary malignancy within the past 5 years",\n          "Condition": [\n            "malignancy"\n          ],\n          "Condition-Name": [\n            "malignancy"\n          ],\n          "Eq-Comparison": [\n            "within the past 5 years",\n            "Second"\n          ],\n          "Eq-Operator": [\n            "within"\n          ],\n          "Eq-Temporal-Period": [\n            "past"\n          ],\n          "Eq-Value": [\n            "5",\n            "Second"\n          ],\n          "Eq-Temporal-Unit": [\n            "years"\n          ]\n        },\n        "right": {\n          "OR": {\n            "left": {\n              "raw_text": "with the exception of adequately treated in situ carcinoma of any organ",\n              "Condition": [\n                "carcinoma"\n              ],\n              "Condition-Name": [\n                "carcinoma"\n              ],\n              "Procedure": [\n                "treated"\n              ],\n              "Procedure-Name": [\n                "treated"\n              ],\n              "Exception": [\n                "exception"\n              ],\n              "Modifier": [\n                "in situ",\n                "organ"\n              ]\n            },\n            "right": {\n              "raw_text": "or basal cell carcinoma of the skin.",\n              "Condition": [\n                "carcinoma"\n              ],\n              "Condition-Name": [\n                "carcinoma"\n              ],\n              "Modifier": [\n                "basal cell",\n                "skin"\n              ]\n            }\n          }\n        }\n      }\n    }\n  }\n}<|eot_id|>']
