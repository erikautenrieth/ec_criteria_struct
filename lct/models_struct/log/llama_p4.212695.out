                 ]\n                        },\n                        "right": {\n                          "AND": {\n                            "left": {\n                              "raw_text": "or delay in closure due to contamination needed)",\n                              "Condition": [\n                                "contamination"\n                              ],\n                              "Condition-Name": [\n                                "contamination"\n                              ],\n                              "Procedure": [\n                                "closure"\n                              ],\n                              "Procedure-Name": [\n                                "closure"\n                              ],\n                              "Modifier": [\n                                "delay"\n                              ]\n                            },\n                            "right": {\n                              "NOT": {\n                                "left": {\n                                  "raw_text": "due to contamination needed)",\n                                  "Condition": [\n                                    "contamination"\n                                  ],\n                                  "Condition-Name": [\n                                    "contamination"\n                                  ],\n                                  "Negation": [\n                                    "no"\n                                  ]\n                                }\n                              }\n                            }\n                          }\n                        }\n                      }\n                    }\n                  }\n                }\n              }\n            }\n          }\n        },\n        "right": {\n          "AND": {\n            "left": {\n              "raw_text": "4. Palpable pedal pulses (",\n              "Condition": [\n              