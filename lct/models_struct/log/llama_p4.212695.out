                  ],
                  "Procedure": [
                    "protocol"
                  ],
                  "Procedure-Name": [
                    "protocol"
                  ]
                },
                "right": {
                  "AND": {
                    "left": {
                      "raw_text": "and the patient's wish to",
                      "Assertion": [
                        "wish to"
                      ]
                    },
                    "right": {
