                          "Condition-Name": [\n                                        "Breastfeeding"\n                                      ]\n                                    },\n                                    "right": {\n                                      "OR": {\n                                        "left": {\n                                          "raw_text": "pregnant",\n                                          "Condition": [\n                                            "pregnant"\n                                          ],\n                                          "Condition-Name": [\n                                            "pregnant"\n                                          ]\n                                        },\n                                        "right": {\n                                          "raw_text": "or patients who plan a pregnancy while participating in the study",\n                                          "Condition": [\n                                            "pregnancy"\n                                          ],\n                                          "Condition-Name": [\n                                            "pregnancy"\n                                          ],\n                                          "Assertion": [\n                                            "plan"\n                                          ],\n                                          "Study": [\n                                            "study"\n                                          ]\n                                        }\n                                      }\n                                    }\n                                  }\n                                }\n                              }\n                            }\n                          }\n                        }\n                      }\n                    },\n                    "right": {\n                      "AND"