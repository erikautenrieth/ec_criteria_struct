ent.\n2. Not speaking English before age 5 years.\n3. Learning disability.\n4. MRI contraindications\n\n### Response:\n{\n  "AND": {\n    "left": {\n      "AND": {\n        "left": {\n          "AND": {\n            "left": {\n              "raw_text": "1. Lack of mental capacity to consent to study involvement.",\n              "Condition": [\n                "Lack of mental capacity"\n              ],\n              "Condition-Name": [\n                "Lack of mental capacity"\n              ]\n            },\n            "right": {\n              "AND": {\n                "left": {\n                  "raw_text": "2."\n                },\n                "right": {\n                  "NOT": {\n                    "left": {\n                      "raw_text": "Not speaking English before age 5 years.",\n                      "Language": [\n                        "English"\n                      ],\n                      "Eq-Temporal-Unit": [\n                        "years"\n                      ],\n                      "Age": [\n                        "age"\n                      ],\n                      "Eq-Value": [\n                        "5"\n                      ],\n                      "Negation": [\n                        "Not"\n                      ],\n                      "Eq-Comparison": [\n                        "before age 5 years"\n                      ],\n                      "Eq-Temporal-Period": [\n                        "before"\n                      ]\n                    }\n                  }\n                }\n              }\n            }\n          }\n        },\n        "right": {\n          "raw_text": "3. Learning disability.",\n          "Condition": [\n            "Learning disability"\n          ],\n          "Condition-Name": [\n            "Learning disability"\n          ]\n        }\n      }\n    },\n    "right": {\n      "raw_text": "4. MRI contraindications",\n      "Procedure": [\n        "MRI"\n      ],\n     