ndicular muscle mass index (AMMI) (<7 kg/m^2 in men; <5.7 kg/m^2 in women) using Bioelectrical impedance analysis (BIA, TANITA BC-418®, Tokyo, Japan)\n-  Subject has lower handgrip strength (<26 kg in men; <18 kg in women) using dynamometer (CAMRY®, Zhongshan, Guangdong) or slowly gait speed (<1 m/s)\n\n### Response:\n{\n  "AND": {\n    "left": {\n      "AND": {\n        "left": {\n          "raw_text": "- Older adults (≥ 65 years)",\n          "Life-Stage-And-Gender": [\n            "Older adults"\n          ],\n          "Eq-Operator": [\n            "≥"\n          ],\n          "Eq-Temporal-Unit": [\n            "years"\n          ],\n          "Age": [\n            "years"\n          ],\n          "Eq-Value": [\n            "65"\n          ],\n          "Eq-Comparison": [\n            "≥ 65 years"\n          ]\n        },\n        "right": {\n          "OR": {\n            "left": {\n              "raw_text": "- Subject has lower appendicular muscle mass index (AMMI) (<7 kg/m^2 in men;",\n              "Eq-Operator": [\n                "<"\n              ],\n              "Eq-Unit": [\n                "kg",\n                "m^2"\n              ],\n              "Eq-Value": [\n                "7"\n              ],\n              "Eq-Comparison": [\n                "<7 kg/m^2"\n              ],\n              "Observation": [\n                "appendicular muscle mass index",\n                "AMMI"\n              ],\n              "Observation-Name": [\n                "appendicular muscle mass index",\n                "AMMI"\n              ],\n              "Life-Stage-And-Gender": [\n                "men"\n              ]\n            },\n            "right": {\n              "raw_text": "<5.7 kg/m^2 in women) using Bioelectrical impedance analysis (BIA, TANITA BC-418®, Tokyo, Japan)",\n              "Eq-Operator": [\n                "<"\n              ],\n              "Eq-Unit": [\n                "kg",\n                "m^2"\n              ],\n              "Eq-Value": [\n                "5.7"\n              ],\n              "Eq-Comparison": [\n                "<5.7 kg/m^2"\n              ],\n              "Procedure": [\n                "Bioelectrical impedance analysis",\n                "BIA"\n              ],\n              "Procedure-Name": [\n                "Bioelectrical impedance analysis",\n                "BIA"\n              ],\n              "Life-Stage-And-Gender": [\n                "women"\n              ]\n            }\n          }\n        }\n      }\n    },\n    "right": {\n      "OR": {\n        "left": {\n          "raw_text": "- Subject has lower handgrip strength (<26 kg in men;",\n          "Eq-Operator": [\n            "<"\n          ],\n          "Eq-Unit": [\n            "kg"\n          ],\n          "Eq-Value": [\n            "26"\n          ],\n          "Eq-Comparison": [\n            "<26 kg"\n          ],\n          "Observation": [\n            "handgrip strength"\n          ],\n          "Observation-Name": [\n            "handgrip strength"\n          ],\n          "Life-Stage-And-Gender": [\n            "men"\n          ]\n        },\n        "right": {\n          "raw_text": "<1 m/s) using dynamometer (CAMRY®, Zhongshan, Guangdong) or slowly gait speed (<1 m/s)",\n          "Eq-Operator": [\n            "<"\n          ],\n          "Eq-Unit": [\n            "m",\n            "s"\n          ],\n          "Eq-Value": [\n            "1"\n          ],\n          "Eq-Comparison": [\n            "<1 m/s"\n          ],\n          "Procedure": [\n            "dynamometer"\n          ],\n          "Procedure-Name": [\n            "dynamometer"\n          ],\n          "Observation": [\n            "gait speed"\n          ],\n          "Observation-Name": [\n            "gait speed"\n          ],\n          "Modifier": [\n            "slowly"\n          ]\n        }\n      }\n    }\n  }\n}<|eot_id|>']
