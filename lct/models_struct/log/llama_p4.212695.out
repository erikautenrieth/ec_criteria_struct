nary artery disease,",\n                                                  "Condition": [\n                                                    "coronary artery disease"\n                                                  ],\n                                                  "Condition-Name": [\n                                                    "coronary artery disease"\n                                                  ]\n                                                },\n                                                "right": {\n                                                  "raw_text": "COPD)",\n                                                  "Condition": [\n                                                    "COPD"\n                                                  ],\n                                                  "Condition-Name": [\n                                                    "COPD"\n                                                  ]\n                                                }\n                                              }\n                                            }\n                                          }\n                                        }\n                                      }\n                                    }\n                                  }\n                                },\n                                "right": {\n                                  "AND": {\n                                    "left": {\n                                      "raw_text": "- Severe coagulopathy platelets <20,000",\n                                      "Condition": [\n                                        "coagulopathy"\n                                      ],\n                                      "Condition-Name": [\n                                        "coagulopathy"\n                                      ],\n                                      "Severity": [\n                                        "Severe"\n                                      ],\n                                      "Observation": [\n                                        "platelets"\n                                      ],\n                                      "Observation-Name": [\n                                        "platelets"\n                                      ],\n                                      "Eq-Operator": [\n                                        "<"\n                                      ],\n                                      "Eq-Value": [\n                                        "20,000"\n                                      ],\n                                      "Eq-Comparison": [\n                                        "<20,000"\n                                      ]\n                                    },\n                                    "right": {\n                                      "raw_text": "and INR >5",\n                                      "Observation": [\n                                        "INR"\n                                      ],\n                                      "Observation-Name": [\n                                        "INR"\n                                      ],\n                                      "Eq-Operator": [\n                                        ">"\n                                      ],\n                                      "Eq-Value": [\n                                        "5"\n                                      ],\n                                      "Eq-Comparison": [\n                                        ">5"\n                                      ]\n                                    }\n                                  }\n                                }\n                              }\n                            },\n                            "right": {\n                              "OR": {\n                                "left": {\n                                  "raw_text": "- Active Bleed (Mucosal",\n                                  "Condition": [\n                                    "Bleed"\n                                  ],\n                                  "Condition-Name": [\n                                    "Bleed"\n                                  ],\n                                  "Eq-Comparison": [\n                                    "Active"\n                                  ],\n                                  "Eq-Temporal-Period": [\n                                    "Active"\n                                  ],\n                                  "Modifier": [\n                                    "Mucosal"\n                                  ]\n                                },\n                                "right": {\n                                  "raw_text": "or variceal)",\n                                  "Modifier": [\n                                    "variceal"\n                                  ]\n                                }\n                              }\n                            }\n                          }\n                        },\n                        "right": {\n                          "raw_text": "- Pregnancy",\n                          "Condition": [\n                            "Pregnancy"\n                          ],\n                          "Condition-Name": [\n                            "Pregnancy"\n                          ]\n                        }\n                      }\n                    },\n                    "right": {\n                      "raw_text": "- Chronic kidney disease",\n                      "Condition": [\n                        "kidney disease"\n                      ],\n                      "Condition-Name": [\n                        "kidney disease"\n                      ],\n                      "Acuteness": [\n                        "Chronic"\n                      ]\n                    }\n                  }\n                },\n                "right": {\n                  "AND": {\n                    "left": {\n                      "raw_text": "- Extremely moribund patients",\n                      "Condition": [\n                        "moribund"\n                      ],\n                      "Condition-Name": [\n                        "moribund"\n                      ],\n                      "Severity": [\n                        "Extremely"\n                      ]\n                    },\n                    "right": {\n                      "raw_text": "with an expected life expectancy of less than 24 hours",\n                      "Eq-Operator": [\n                        "less than"\n                      ],\n                      "Eq-Temporal-Unit": [\n                        "hours"\n                      ],\n                      "Eq-Value": [\n                        "24"\n                      ],\n                      "Eq-Comparison": [\n                        "less than 24 hours"\n                      ],\n                      "Observation": [\n                        "life expectancy"\n                      ],\n                      "Observation-Name": [\n                        "life expectancy"\n                      ],\n                      "Assertion": [\n                        "expected"\n                      ]\n                    }\n                  }\n                }\n              }\n            },\n            "right": {\n              "AND": {\n                "left": {\n                  "raw_text": "- Failure to give informed consent from family members.",\n                  "Eq-Operator": [\n                    "to"\n                  ]\n                },\n                "right": {\n                  "NOT": {\n                    "left": {\n                      "raw_text": "from family members.",\n                      "Family-Member": [\n                        "family members"\n                      ],\n          