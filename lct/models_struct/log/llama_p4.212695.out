her topical or systemic treatment for LS\n-  < 3 months since start of vaginal estrogen treatment\n-  Malignant disease as the cause of the vulval symptoms\n-  BMI > 35 kg/m²\n-  Acute infection (fungal, bacterial, viral) of the vulva, vagina or bladder\n-  Presence of contraindications for the laser treatment or topical steroid treatment\n\n### Response:\n{\n  "AND": {\n    "left": {\n      "AND": {\n        "left": {\n          "AND": {\n            "left": {\n              "AND": {\n                "left": {\n                  "AND": {\n                    "left": {\n                      "OR": {\n                        "left": {\n                          "raw_text": "- Concomitant steroid,",\n                          "Drug": [\n                            "steroid"\n                          ],\n                          "Drug-Name": [\n                            "steroid"\n                          ],\n                          "Modifier": [\n                            "Concomitant"\n                          ]\n                        },\n                        "right": {\n                          "OR": {\n                            "left": {\n                              "raw_text": "calcineurin inhibitor",\n                              "Drug": [\n                                "calcineurin inhibitor"\n                              ],\n                              "Drug-Name": [\n                                "calcineurin inhibitor"\n                              ]\n                            },\n                            "right": {\n                              "OR": {\n                                "left": {\n                                  "raw_text": "or any other topical",\n                                  "Modifier": [\n                                    "topical"\n                                  ],\n                                  "Other": [\n                                    "other"\n                                  ]\n                                },\n                                "right": {\n                                  "OR": {\n                                    "left": {\n                                      "raw_text": "or systemic treatment for LS",\n                                      "Procedure": [\n                                        "treatment"\n                                      ],\n                                      "Condition": [\n                                        "LS"\n                                      ],\n                                      "Condition-Name": [\n                                        "LS"\n                                      ],\n                                      "Modifier": [\n                                        "systemic"\n                                      ]\n                                    },\n                                    "right": {\n                                      "raw_text": "or any other topical or systemic treatment",\n                                      "Procedure": [\n                                        "treatment"\n                                      ],\n                                      "Other": [\n                                        "other"\n                                      ],\n                                      "Modifier": [\n                                        "topical",\n                                        "systemic"\n                                      ]\n                                    }\n                                  }\n                                }\n                              }\n                            }\n                          }\n                        }\n                      }\n                    },\n                    "right": {\n                      "raw_text": "- < 3 months since start of vaginal estrogen treatment",\n                      "Procedure": [\n                        "treatment"\n                      ],\n                      "Eq-Operator": [\n                        "<"\n                      ],\n                      "Eq-Temporal-Unit": [\n                        "months"\n                      ],\n                      "Eq-Value": [\n                        "3"\n                      ],\n                      "Eq-Comparison": [\n                        "< 3 months"\n                      ],\n                      "Drug": [\n                        "vaginal estrogen"\n                      ],\n                      "Drug-Name": [\n                        "vaginal estrogen"\n                      ]\n                    }\n                  }\n                },\n                "right": {\n                  "raw_text": "- Malignant disease as the cause of the vulval symptoms",\n                  "Condition": [\n                    "Malignant disease"\n                  ],\n                  "Condition-Name": [\n                    "Malignant disease"\n                  ],\n                  "Assertion": [\n                    "symptoms"\n                  ],\n                  "Condition-Type": [\n                    "symptoms"\n                  ],\n                  "Modifier": [\n                    "vulval"\n                  ]\n                }\n              }\n            },\n            "right": {\n              "raw_text": "- BMI > 35 kg/m²",\n              "Observation": [\n                "BMI"\n              ],\n              "Observation-Name": [\n                "BMI"\n              ],\n              "Eq-Operator": [\n                ">"\n              ],\n              "Eq-Unit": [\n                "kg",\n                "m²"\n              ],\n              "Eq-Value": [\n                "35"\n              ],\n              "Eq-Comparison": [\n                "> 35 kg/m²"\n              ]\n            }\n          }\n        },\n        "right": {\n          "OR": {\n            "left": {\n              "raw_text": "- Acute infection (fungal,",\n              "Condition": [\n                "infection"\n              ],\n              "Condition-Name": [\n                "infection"\n              ],\n              "Acuteness": [\n                "Acute"\n              ],\n              "Modifier": [\n                "fungal"\n              ]\n            },\n            "right": {\n              "OR": {\n                "left": {\n                  "raw_text": "bacterial,",\n                  "Modifier": [\n                    "bacterial"\n                  ]\n                },\n                "right": {\n                  "OR": {\n                    "left": {\n                      "raw_text": "viral) of the vulva,",\n                      "Modifier": [\n                        "viral",\n                        "vulva"\n                      ]\n                    },\n                    "right": {\n                      "OR": {\n                        "left": {\n                          "raw_text": "vagina",\n                          "Modifier": [\n                            "vagina"\n                          ]\n                        },\n                        "right": {\n                          "raw_text": "or bladder",\n                          "Modifier": [\n                            "bladder"\n                          ]\n                        }\n                      }\n                    }\n                  }\n                }\n              }\n            }\n          }\n        }\n      }\n    },\n    "right": {\n      "OR": {\n        "left": {\n          "raw_text": "- Presence of contraindications for the laser treatment",\n          "Procedure": [\n            "treatment"\n          ],\n          "Contraindication": [\n            "contraindications"\n          ],\n          "Procedure-Name": [\n            "laser treatment"\n          ]\n        },\n        "right": {\n          "raw_text": "or topical steroid treatment",\n          "Procedure": [\n        