": {\n                                          "NOT": {\n                                            "left": {\n                                              "raw_text": "no evidence of recurrence for ≥ 5 years before screening.",\n                                              "Eq-Operator": [\n                                                "≥"\n                                              ],\n                                              "Eq-Temporal-Unit": [\n                                                "years"\n                                              ],\n                                              "Eq-Value": [\n                                                "5"\n                                              ],\n                                              "Eq-Comparison": [\n                                                "≥ 5 years"\n                                              ],\n                                              "Condition": [\n                                                "recurrence"\n                                              ],\n                                              "Condition-Name": [\n                                                "recurrence"\n                                              ],\n                                              "Negation": [\n                                                "no"\n                                              ],\n                                              "Study": [\n                                                "screening"\n                                              ]\n                                            }\n                                          }\n                                        }\n                                      }\n                                    }\n                                  }\n                                }\n                              }\n                            }\n                          }\n                        }\n                      }\n                    }\n                  }\n                }\n              }\n            },\n            "right": {\n              "raw_text": "2. History of thymectomy within the 12 months prior to screening.",\n              "Eq-Operator": [\n                "within"\n              ],\n              "Eq-Temporal-Unit": [\n                "months"\n              ],\n              "Eq-Value": [\n                "12"\n              ],\n              "Eq-Comparison": [\n                "History",\n                "within the 12 months"\n              ],\n              "Eq-Temporal-Period": [\n                "History"\n              ],\n              "Procedure": [\n                "thymectomy"\n              ],\n              "Procedure-Name": [\n                "thymectomy"\n              ],\n              "Study": [\n                "screening"\n              ]\n            }\n          }\n        },\n        "right": {\n          "raw_text": "3. History of N meningitidis infection.",\n          "Condition": [\n            "N meningitidis infection"\n          ],\n          "Condition-Name": [\n            "N meningitidis infection"\n          ],\n          "Eq-Comparison": [\n            "History"\n          ],\n          "Eq-Temporal-Period": [\n            "History"\n          ]\n        }\n      }\n    },\n    "right": {\n      "OR": {\n        "left": {\n          "raw_text": "4. Use of the following within the time period specified below:",\n          "Eq-Operator": [\n            "within"\n          ]\n        },\n        "right": {\n          "OR": {\n            "left": {\n              "raw_text": "- IV immunoglobulin within 4 weeks of randomization",\n              "Eq-Operator": [\n                "within"\n              ],\n              "Eq-Temporal-Unit": [\n                "weeks"\n              ],\n              "Eq-Value": [\n                "4"\n              ],\n              "Eq-Comparison": [\n                "within 4 weeks"\n              ],\n              "Drug": [\n                "IV immunoglobulin"\n              ],\n              "Drug-Name": [\n                "IV immunoglobulin"\n              ],\n              "Study": [\n                "randomization"\n              ]\n            },\n            "right": {\n              "OR": {\n                "left": {\n                  "raw_text": "- Use of plasma exchange",\n                  "Procedure": [\n                    "plasma exchange"\n                  ],\n                  "Procedure-Name": [\n                    "plasma exchange"\n                  ]\n                },\n                "right": {\n                  "raw_text": "within 4 weeks of randomization",\n                  "Eq-Operator": [\n                    "within"\n                  ],\n                  "Eq-Temporal-Unit": [\n                    "weeks"\n                  ],\n                  "Eq-Value": [\n                    "4"\n                  ],\n                  "Eq-Comparison": [\n                    "within 4 weeks"\n                  ],\n                  "Study": [\n                    "randomization"\n                  ]\n                }\n              }\n            }\n          }\n        }\n      }\n    }\n  }\n}<|eot_id|>']
