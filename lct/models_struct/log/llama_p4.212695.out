    "Eq-Comparison": [\n                                "One or more"\n                              ],\n                              "Eq-Value": [\n                                "One"\n                              ],\n                              "Eq-Operator": [\n                                "or more"\n                              ],\n                              "Observation": [\n                                "laboratory findings",\n                                "platelet"\n                              ],\n                              "Observation-Name": [\n                                "laboratory findings",\n                                "platelet"\n                              ],\n                              "Study": [\n                                "study"\n                              ]\n                            },\n                            "right": {\n                              "OR": {\n                                "left": {\n                                  "raw_text": "hemoglobin,",\n                                  "Observation": [\n                                    "hemoglobin"\n                                  ],\n                                  "Observation-Name": [\n                                    "hemoglobin"\n                                  ]\n                                },\n                                "right": {\n                                  "raw_text": "aspartate aminotransferase,etc.)",\n                                  "Observation": [\n                                    "aspartate aminotransferase"\n                                  ],\n                                  "Observation-Name": [\n                                    "aspartate aminotransferase"\n                                  ]\n                                }\n                              }\n                            }\n                          }\n                        }\n                      }\n        