ure": [\n                            "neurostimulator"\n                          ],\n                          "Procedure-Name": [\n                            "neurostimulator"\n                          ]\n                        }\n                      }\n                    }\n                  }\n                }\n              }\n            },\n            "right": {\n              "AND": {\n                "left": {\n                  "raw_text": "- Subject is likely to require repeat MR imaging after implant of the RNS Neurostimulator",\n                  "Procedure": [\n                    "MR imaging",\n                    "implant",\n                    "RNS Neurostimulator"\n                  ],\n                  "Procedure-Name": [\n                    "MR imaging",\n                    "implant",\n                    "RNS Neurostimulator"\n                  ],\n                  "Assertion": [\n                    "likely to"\n                  ],\n                  "Coreference": [\n                    "repeat"\n                  ]\n                },\n                "right": {\n                  "raw_text": "and Leads.",\n                  "Procedure": [\n                    "Leads"\n                  ],\n                  "Procedure-Name": [\n                    "Leads"\n                  ]\n                }\n              }\n            }\n          }\n        },\n        "right": {\n          "AND": {\n            "left": {\n              "raw_text": "- Subject is"\n            },\n            "right": {\n              "NOT": {\n                "left": {\n                  "raw_text": "unable to fit into CT scanner (500lb upper weight limit for CT scanner).",\n                  "Procedure": [\n                    "CT scanner"\n                  ],\n                  "Procedure-Name": [\n                    "CT scanner"\n                  ],\n                  "Negation": [\n                    "unable"\n                  ],\n               