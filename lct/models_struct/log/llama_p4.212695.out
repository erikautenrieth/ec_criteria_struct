\n-  on antihypertensive medications\n-  recurrent anal fissure after previous sphincterotomy\n-  prior history of anal surgery\n-  other benign anorectal diseases\n-  with inflammatory bowel diseases\n\n### Response:\n{\n  "AND": {\n    "left": {\n      "AND": {\n        "left": {\n          "AND": {\n            "left": {\n              "AND": {\n                "left": {\n                  "AND": {\n                    "left": {\n                      "AND": {\n                        "left": {\n                          "raw_text": "- Pregnant",\n                          "Condition": [\n                            "Pregnant"\n                          ],\n                          "Condition-Name": [\n                            "Pregnant"\n                          ]\n                        },\n                        "right": {\n                          "OR": {\n                            "left": {\n                              "raw_text": "- cardiovascular disease",\n                              "Condition": [\n                                "cardiovascular disease"\n                              ],\n                              "Condition-Name": [\n                                "cardiovascular disease"\n                              ]\n                            },\n                            "right": {\n                              "raw_text": "or heart failure",\n                              "Condition": [\n                                "heart failure"\n                              ],\n                              "Condition-Name": [\n                                "heart failure"\n                              ]\n                            }\n                          }\n                        }\n                      }\n                    },\n                    "right": {\n                      "raw_text": "- on antihypertensive medications",\n                      "Eq-Comparison": [\n                        "on"\n                      ],\n                      "Eq-Temporal-Period": [\n                        "on"\n                      ],\n                      "Drug": [\n                        "antihypertensive medications"\n                      ],\n                      "Drug-Name": [\n                        "antihypertensive medications"\n                      ]\n                    }\n                  }\n                },\n                "right": {\n                  "raw_text": "- recurrent anal fissure after previous sphincterotomy",\n                  "Condition": [\n                    "anal fissure"\n                  ],\n                  "Condition-Name": [\n                    "anal fissure"\n                  ],\n                  "Procedure": [\n                    "sphincterotomy"\n                  ],\n                  "Procedure-Name": [\n                    "sphincterotomy"\n                  ],\n                  "Modifier": [\n                    "recurrent"\n                  ]\n                }\n              }\n            },\n            "right": {\n              "raw_text": "- prior history of anal surgery",\n              "Eq-Comparison": [\n                "prior history"\n              ],\n              "Eq-Temporal-Period": [\n                "prior history"\n              ],\n              "Procedure": [\n                "anal surgery"\n              ],\n              "Procedure-Name": [\n                "anal surgery"\n              ]\n            }\n          }\n        },\n        "right": {\n          "raw_text": "- other benign anorectal diseases",\n          "Condition": [\n            "anorectal diseases"\n          ],\n          "Condition-Name": [\n            "anorectal diseases"\n          ],\n          "Other": [\n            "other"\n          ],\n          "Modifier": [\n            "benign"\n          ]\n        }\n      }\n    },\n    "right": {\n      "raw_text": "- with inflammatory bowel diseases",\n      "Condition": [\n        "infla