",\n                                  "Condition": [\n                                    "Cirrhosis of the Liver"\n                                  ],\n                                  "Condition-Name": [\n                                    "Cirrhosis of the Liver"\n                                  ]\n                                },\n                                "right": {\n                                  "raw_text": "Liver Metabolism Disorders. Renal: Any form of renal impairment. EXPAREL® is cleared by the kidneys, thus any form of renal impairment could lead to an adverse reaction.",\n                                  "Condition": [\n                                    "renal impairment",\n                                    "Liver Metabolism Disorders"\n                                  ],\n                                  "Condition-Name": [\n                                    "renal impairment",\n                                    "Liver Metabolism Disorders"\n                                  ],\n                                  "Modifier": [\n                                    "Renal"\n                                  ],\n                                  "Drug": [\n                                    "EXPAREL"\n                                  ],\n                                  "Drug-Name": [\n                                    "EXPAREL"\n                                  ],\n                                  "Stability": [\n                                    "impairment"\n                                  ]\n                                }\n                              }\n                            }\n                          }\n                        }\n                      }\n                    }\n                  }\n                },\n                "right": {\n                  "OR": {\n                    "left": {\n                      "raw_text": "- Medical condition(s)",\n                      "Condition": [\n                        "Medical condition"\n                      ]\n                    },\n                    "right": {\n                      "OR": {\n                        "left": {\n                          "raw_text": "or concurrent surgery that may have required analgesic treatment in the postoperative period for pain that was",\n                          "Procedure": [\n                            "surgery",\n                            "analgesic treatment"\n                          ],\n                          "Procedure-Name": [\n                            "surgery",\n                            "analgesic treatment"\n                          ],\n                          "Assertion": [\n                            "may have required",\n                            "may"\n                          ],\n                          "Condition": [\n                            "pain"\n                          ],\n                          "Condition-Name": [\n                            "pain"\n                          ],\n                          "Modifier": [\n                            "concurrent"\n                          ]\n                        },\n                        "right": {\n                          "AND": {\n                            "left": {\n                              "raw_text": "not strictly related to the study surgery.",\n                              "Procedure": [\n                                "surgery"\n                              ],\n                              "Procedure-Name": [\n                                "surgery"\n                              ],\n                              "Negation": [\n                                "not"\n                              ],\n                              "Study": [\n                                "study"\n                              ]\n                            },\n                            "right": {\n                              "NOT": {\n           