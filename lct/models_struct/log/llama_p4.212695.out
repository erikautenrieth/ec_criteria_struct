Musculoskeletal and neurological diseases that could affect exercise performance or preclude exercise\n-  Patients of COPD final stage or other serious disease final stage\n-  Significant cognitive or psychiatric impairment that would lead to an inability to follow simple commands in a group setting\n\n### Response:\n{\n  "AND": {\n    "left": {\n      "AND": {\n        "left": {\n          "AND": {\n            "left": {\n              "AND": {\n                "left": {\n                  "raw_text": "- Age < 18 years old",\n                  "Eq-Operator": [\n                    "<"\n                  ],\n                  "Eq-Temporal-Unit": [\n                    "years"\n                  ],\n                  "Age": [\n                    "Age"\n                  ],\n                  "Eq-Value": [\n                    "18"\n                  ],\n                  "Eq-Comparison": [\n                    "< 18 years"\n                  ]\n                },\n                "right": {\n                  "raw_text": "- Unstable cardiac disease",\n                  "Condition": [\n                    "cardiac disease"\n                  ],\n                  "Condition-Name": [\n                    "cardiac disease"\n                  ],\n                  "Stability": [\n                    "Unstable"\n                  ]\n                }\n              }\n            },\n            "right": {\n              "OR": {\n                "left": {\n                  "raw_text": "- Musculoskeletal",\n                  "Modifier": [\n                    "Musculoskeletal"\n                  ]\n                },\n                "right": {\n                  "OR": {\n                    "left": {\n                      "raw_text": "and neurological diseases that could affect exercise performance",\n                      "Condition": [\n                        "diseases"\n                      ],\n                      "Condition-Name": [\n                        "diseases"\n                      ],\n                      "Modifier": [\n                        "neurological"\n                      ],\n                      "Observation": [\n                        "exercise performance"\n                      ],\n                      "Observation-Name": [\n                        "exercise performance"\n                      ],\n                      "Stability": [\n                        "affect"\n                      ],\n                      "Assertion": [\n                        "could"\n                      ]\n                    },\n                    "right": {\n                      "AND": {\n                        "left": {\n                          "raw_text": "or"\n                        },\n                        "right": {\n                          "NOT": {\n                            "left": {\n                              "raw_text": "preclude exercise",\n                              "Observation": [\n                                "exercise"\n                              ],\n                              "Observation-Name": [\n                                "exercise"\n                              ],\n                              "Negation": [\n                                "preclude"\n                              ]\n                            }\n                          }\n                        }\n                      }\n                    }\n                  }\n                }\n              }\n            }\n          }\n        },\n        "right": {\n          "OR": {\n            "left": {\n              "raw_text": "- Patients of COPD final stage",\n              "Condition": [\n                "COPD"\n              ],\n              "Condition-Name": [\n                "COPD"\n              ],\n              "Modifier": [\n                "final stage"\n              ]\n            },\n            "right": {\n              "raw_text": "or other serious disease final stage",\n              "Condition": [\n                "disease"\n              ],\n              "Condition-Name": [\n                "disease"\n              ],\n              "Other": [\n                "other"\n              ],\n              "Severity": [\n                "serious"\n              ],\n              "Modifier": [\n                "final stage"\n              ]\n            }\n          }\n        }\n      }\n    },\n    "right": {\n      "OR": {\n        "left": {\n          "raw_text": "- Significant cognitive",\n          "Modifier": [\n            "cognitive"\n          ],\n          "Severity": [\n            "Significant"\n          ]\n        },\n        "right": {\n          "OR": {\n            "left": {\n              "raw_text": "or psychiatric impairment that would lead to an inability to follow simple commands in a group setting",\n              "Condition": [\n                "impairment"\n              ],\n              "Condition-Name": [\n                "impairment"\n              ],\n              "Modifier": [\n                "psychiatric"\n              ],\n              "Assertion": [\n                "would"\n              ],\n              "Observation": [\n                "inability to follow simple commands"\n              ],\n              "Observation-Name": [\n                "inability to follow simple commands"\n              ],\n              "Location": [\n                "group setting"\n              ]\n            },\n            "right": {\n              "raw_text": "or other serious disease",\n              "Condition": [\n                "disease"\n              ],\n              "Condition-Name": [\n                "disease"\n              ],\n              "Other": [\n                "other"\n              ],\n              "Severity": [\n                "serious"\n              ]\n            }\n          }\n        }\n      }\n    }\n  }\n}<|eot_id|>']
