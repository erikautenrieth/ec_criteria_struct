rder"\n                              ],\n                              "Eq-Comparison": [\n                                "current"\n                              ],\n                              "Eq-Temporal-Period": [\n                                "current"\n                              ]\n                            }\n                          }\n                        }\n                      }\n                    },\n                    "right": {\n                      "raw_text": "Subjects taking hormonal contraception (including but not limited to oral contraceptive pills) for a duration of less than 6 months",\n                      "Eq-Operator": [\n                        "less than"\n                      ],\n                      "Eq-Temporal-Unit": [\n                        "months"\n                      ],\n                      "Eq-Value": [\n                        "6"\n                      ],\n                      "Eq-Comparison": [\n                        "less than 6 months",\n                        "taking"\n                      ],\n                      "Eq-Temporal-Period": [\n                        "taking"\n                      ],\n                      "Procedure": [\n                        "hormonal contraception",\n                        "oral contraceptive pills"\n                      ],\n                      "Procedure-Name": [\n                        "hormonal contraception",\n                        "oral contraceptive pills"\n                      ]\n                    }\n                  }\n                },\n                "right": {\n                  "raw_text": "Subjects that have ever been diagnosed with any type of sexual dysfunction prior to starting spironolactone",\n                  "Condition": [\n                    "sexual dysfunction"\n                  ],\n                  "Condition-Name": [\n                    "sexual dysfunction"\n                  ],\n                  "Eq-Comparison":