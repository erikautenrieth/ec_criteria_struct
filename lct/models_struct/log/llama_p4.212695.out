ndin analogue"\n                      ]\n                    }\n                  }\n                },\n                "right": {\n                  "raw_text": "- Presence of an epiretinal membrane on the preoperative OCT.",\n                  "Condition": [\n                    "epiretinal membrane"\n                  ],\n                  "Condition-Name": [\n                    "epiretinal membrane"\n                  ],\n                  "Procedure": [\n                    "OCT"\n                  ],\n                  "Procedure-Name": [\n                    "OCT"\n                  ]\n                }\n              }\n            },\n            "right": {\n              "raw_text": "- Retained lens fragment post-operatively.",\n              "Condition": [\n                "Retained lens fragment"\n              ],\n              "Condition-Name": [\n                "Retained lens fragment"\n              ],\n              "Procedure": [\n                "operatively"\n              ],\n              "Procedure-Name": [\n                "operatively"\n              ]\n            }\n          }\n        },\n        "right": {\n          "AND": {\n            "left": {\n              "raw_text": "-"\n            },\n            "right": {\n              "NOT": {\n                "left": {\n                  "raw_text": "Inability to return for follow appointments",\n                  "Condition": [\n                    "Inability to return"\n                  ],\n                  "Condition-Name": [\n                    "Inability to return"\n                  ],\n                  "Encounter": [\n                    "appointments"\n                  ],\n                  "Negation": [\n                    "Inability"\n                  ]\n                }\n              }\n            }\n          }\n        }\n      }\n    },\n    "right": {\n      "OR": {\n        "left": {\n          "raw_text": "- Female patients who are pregnant,",\n          "Li