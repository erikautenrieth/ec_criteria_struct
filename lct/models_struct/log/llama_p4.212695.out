              "raw_text": "or substance abuse/",
              "Condition": [
                "substance abuse"
              ],
              "Condition-Name": [
                "substance abuse"
              ]
            },
            "right": {
              "raw_text": "dependence.",
              "Condition": [
                "dependence"
              ],
