rs of age\n-  Gestation <15 weeks at first prenatal visit\n-  No intention to move outside the city of Santiago in the next to years\n\n### Response:\n{\n  "AND": {\n    "left": {\n      "AND": {\n        "left": {\n          "AND": {\n            "left": {\n              "AND": {\n                "left": {\n                  "raw_text": "- Primipara (",\n                  "Condition": [\n                    "Primipara"\n                  ],\n                  "Condition-Name": [\n                    "Primipara"\n                  ]\n                },\n                "right": {\n                  "AND": {\n                    "left": {\n                      "raw_text": "no previous pregnancies",\n                      "Condition": [\n                        "pregnancies"\n                      ],\n                      "Condition-Name": [\n                        "pregnancies"\n                      ],\n                      "Negation": [\n                        "no"\n                      ],\n                      "Eq-Comparison": [\n                        "previous"\n                      ],\n                      "Eq-Temporal-Period": [\n                        "previous"\n                      ]\n                    },\n                    "right": {\n                      "raw_text": ")","\n                    }\n                  }\n                }\n              }\n            },\n            "right": {\n              "raw_text": "- 18 to 25 years of age",\n              "Eq-Temporal-Unit": [\n                "years"\n              ],\n              "Age": [\n                "age"\n              ],\n              "Eq-Value": [\n                "18",\n                "25"\n              ],\n              "Eq-Comparison": [\n                "18 to 25 years"\n              ],\n              "Eq-Operator": [\n                "to"\n              ]\n            }\n          }\n        },\n        "right": {\n          "raw_text": "- Gestation <15 weeks at first prenatal visit",\n          "Condition": [\n            "Gestation"\n          ],\n          "Condition-Name": [\n            "Gestation"\n          ],\n          "Eq-Operator": [\n            "<"\n          ],\n          "Eq-Temporal-Unit": [\n            "weeks"\n          ],\n          "Eq-Value": [\n            "15"\n          ],\n          "Eq-Comparison": [\n            "<15 weeks"\n          ],\n          "Encounter": [\n            "prenatal visit"\n          ]\n        }\n      }\n    },\n    "right": {\n      "AND": {\n        "left": {\n          "raw_text": "-"\n        },\n        "right": {\n          "NOT": {\n            "left": {\n              "raw_text": "No intention to move outside the city of Santiago in the next to years",\n              "Negation": [\n                "No"\n              ],\n              "Assertion": [\n                "intention to"\n              ],\n              "Location": [\n                "city of Santiago"\n              ],\n              "Eq-Comparison": [\n                "next to years"\n              ],\n              "Eq-Temporal-Unit": [\n                "years"\n              ],\n              "Eq-Temporal-Period": [\n                "next"\n              ]\n            }\n          }\n        }\n      }\n    }\n  }\n}<|eot_id|>']
