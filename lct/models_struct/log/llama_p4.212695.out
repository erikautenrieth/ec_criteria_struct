                               "severe"\n                                                  ]\n                                                },\n                                                "right": {\n                                                  "raw_text": "or a structural heart disease that is hemodynamically affected",\n                                                  "Condition": [\n                                                    "structural heart disease"\n                                                  ],\n                                                  "Condition-Name": [\n                                                    "structural heart disease"\n                                                  ],\n                                                  "Stability": [\n                                                    "affected"\n                                                  ],\n                                                  "Modifier": [\n                                                    "hemodynamically"\n                                                  ]\n                                                }\n                                              }\n                                            }\n                                          }\n                                        },\n                                        "right": {\n                                          "OR": {\n                                            "left": {\n                                              "raw_text": "- 3. Patients with severe renal impairment",\n                                              "Condition": [\n                                                "renal impairment"\n                                              ],\n                                              "Condition-Name": [\n                                                "renal impairment"\n                                              ],\n                       