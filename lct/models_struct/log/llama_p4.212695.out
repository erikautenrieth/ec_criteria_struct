          "raw_text": "- The removal criteria were patient",
          "Eq-Operator": [
            "-"
          ]
        },
        "right": {
          "NOT": {
            "left": {
              "OR": {
                "left": {
                  "raw_text": "non-compliance with the protocol, failure in contacting the patient",
                  "Negation": [
