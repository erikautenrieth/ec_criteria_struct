itions: Chron\'s disease, bleeding disorders, gastrointestinal or colonic malignancy, Kidney disease, including kidney "stones" or hypercalcemia, Coagulopathy/hereditary hemorrhagic disorders/ or receiving therapeutic doses of Coumadin or heparin.\n-  Ingested certain medications (Calcium, Vitamin D, fiber supplements and Non-steroidal anti-inflammatory drugs - NSAIDs) within 30 days of study start.\n\n### Response:\n{\n  "AND": {\n    "left": {\n      "OR": {\n        "left": {\n          "raw_text": "- No history or diagnosis of any of the following conditions: Chron\'s disease,",\n          "Condition": [\n            "conditions",\n            "Chron\'s disease"\n          ],\n          "Condition-Name": [\n            "Chron\'s disease"\n          ],\n          "Eq-Comparison": [\n            "history"\n          ],\n          "Eq-Temporal-Period": [\n            "history"\n          ],\n          "Negation": [\n            "No"\n          ]\n        },\n        "right": {\n          "OR": {\n            "left": {\n              "raw_text": "bleeding disorders, gastrointestinal",\n              "Condition": [\n                "bleeding disorders"\n              ],\n              "Condition-Name": [\n                "bleeding disorders"\n              ],\n              "Modifier": [\n                "gastrointestinal"\n              ]\n            },\n            "right": {\n              "OR": {\n                "left": {\n                  "raw_text": "or colonic malignancy, Kidney disease, including kidney \\"stones\\"",\n                  "Condition": [\n                    "malignancy",\n                    "Kidney disease",\n                    "disease"\n                  ],\n                  "Condition-Name": [\n                    "malignancy",\n                    "Kidney disease"\n                  ],\n                  "Modifier": [\n                    "colonic",\n                    "kidney \\"stones\\""\n                  ]\n                },\n                "right": {\n                  "OR": {\n                    "left": {\n                      "raw_text": "or hypercalcemia, Coagulopathy/",\n                      "Condition": [\n                        "hypercalcemia",\n                        "Coagulopathy"\n                      ],\n                      "Condition-Name": [\n                        "hypercalcemia",\n                        "Coagulopathy"\n                      ]\n                    },\n                    "right": {\n                      "OR": {\n                        "left": {\n                          "raw_text": "hereditary hemorrhagic disorders/",\n                          "Condition": [\n                            "hereditary hemorrhagic disorders"\n                          ],\n                          "Condition-Name": [\n                            "hereditary hemorrhagic disorders"\n                          ]\n                        },\n                        "right": {\n                          "OR": {\n                            "left": {\n                              "raw_text": "or receiving therapeutic doses of Coumadin",\n                              "Eq-Comparison": [\n                                "receiving"\n                              ],\n                              "Eq-Temporal-Period": [\n                                "receiving"\n                              ],\n                              "Drug": [\n                                "Coumadin"\n                              ],\n                              "Drug-Name": [\n                                "Coumadin"\n                              ]\n                            },\n                            "right": {\n                              "raw_text": "or heparin.",\n                              "Drug": [\n                                "heparin"\n                              ],\n                              "Drug-Name": [\n                                "heparin"\n                              ]\n                            }\n                          }\n                        }\n                      }\n                    }\n                  }\n                }\n              }\n            }\n          }\n        }\n      }\n    },\n    "right": {\n      "OR": {\n        "left": {\n          "raw_text": "- Ingested certain medications (Calcium,",\n          "Drug": [\n            "medications",\n            "Calcium"\n          ],\n          "Drug-Name": [\n            "Calcium"\n          ]\n        },\n        "right": {\n          "OR": {\n            "left": {\n              "raw_text": "Vitamin D,",\n              "Drug": [\n                "Vitamin D"\n              ],\n              "Drug-Name": [\n                "Vitamin D"\n              ]\n            },\n            "right": {\n              "OR": {\n                "left": {\n                  "raw_text": "fiber supplements",\n                  "Drug": [\n                    "fiber supplements"\n                  ],\n                  "Drug-Name": [\n                    "fiber supplements"\n                  ]\n                },\n                "right": {\n                  "raw_text": "and Non-steroidal anti-inflammatory drugs - NSAIDs) within 30 days of study start.",\n                  "Drug": [\n                    "Non-steroidal anti-inflammatory drugs",\n                    "NSAIDs"\n                  ],\n                  "Drug-Name": [\n                    "Non-steroidal anti-inflammatory drugs",\n                    "NSAIDs"\n                  ],\n                  "Eq-Comparison": [\n                    "within 30 days"\n                  ],\n                  "Eq-Operator": [\n                    "within"\n                  ],\n                  "Eq-Value": [\n                    "30"\n                  ],\n                  "Eq-Temporal-Unit": [\n                    "days"\n                  ],\n                  "Study": [\n                    "study"\n                  ]\n                }\n              }\n            }\n          }\n        }\n      }\n    }\n  }\n}<|eot_id|>']
