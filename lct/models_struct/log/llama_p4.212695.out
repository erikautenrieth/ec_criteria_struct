            },
            "right": {
              "raw_text": "- Patients with signs of condyle injuries",
              "Condition": [
                "condyle injuries"
              ],
              "Condition-Name": [
                "condyle injuries"
              ],
              "Assertion": [
                "signs of"
              ]
            }
          }
        },
        "right": {
          "OR": {
            "left": {
              "raw_text": "- Patients of Pierre Robin",
              "Condition": [
                "Pierre Robin"
              ],
              "Condition-Name": [
                "Pierre Robin"
              ]
            },
            "right": {
              "raw_text": "or any form of cleft",
              "Condition": [
