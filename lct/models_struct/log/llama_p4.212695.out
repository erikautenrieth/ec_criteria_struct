               "Modifier": [\n                                                "cognitive"\n                                              ]\n                                            },\n                                            "right": {\n                                              "OR": {\n                                                "left": {\n                                                  "raw_text": "and behavioural impairment (claustrophobia), sensory disabilities,",\n                                                  "Condition": [\n                                                    "behavioural impairment",\n                                                    "claustrophobia",\n                                                    "sensory disabilities"\n                                                  ],\n                                                  "Condition-Name": [\n                                                    "behavioural impairment",\n                                                    "claustrophobia",\n                                                    "sensory disabilities"\n                                                  ]\n                                                },\n                                                "right": {\n                                                  "raw_text": "hearing problem",\n                                                  "Condition": [\n                                                    "hearing problem"\n                                                  ],\n                                                  "Condition-Name": [\n                                                    "hearing problem"\n                                                  ]\n                                                }\n                                              }\n                                            }\n                                          }\n                                        }