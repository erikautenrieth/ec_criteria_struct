area > or = 5% of the total body surface area\n-  mainly 2nd degree burn\n\n### Response:\n{\n  "AND": {\n    "left": {\n      "AND": {\n        "left": {\n          "raw_text": "- Burn patient treated as outpatient",\n          "Condition": [\n            "Burn"\n          ],\n          "Condition-Name": [\n            "Burn"\n          ],\n          "Encounter": [\n            "outpatient"\n          ],\n          "Procedure": [\n            "treated"\n          ]\n        },\n        "right": {\n          "raw_text": "- Burn surface area > or = 5% of the total body surface area",\n          "Condition": [\n            "Burn"\n          ],\n          "Condition-Name": [\n            "Burn"\n          ],\n          "Eq-Operator": [\n            ">"\n          ],\n          "Eq-Value": [\n            "5"\n          ],\n          "Eq-Comparison": [\n            "> or = 5%"\n          ],\n          "Observation": [\n            "Burn surface area",\n            "total body surface area"\n          ],\n          "Observation-Name": [\n            "Burn surface area",\n            "total body surface area"\n          ],\n          "Eq-Unit": [\n            "%"\n          ]\n        }\n      }\n    },\n    "right": {\n      "raw_text": "- mainly 2nd degree burn",\n      "Condition": [\n        "burn"\n      ],\n      "Condition-Name": [\n        "burn"\n      ],\n      "Eq-Value": [\n        "2"\n      ],\n      "Eq-Comparison": [\n        "2nd degree"\n      ],\n      "Eq-Unit": [\n        "nd degree"\n      ]\n    }\n  }\n}<|eot_id|>']
