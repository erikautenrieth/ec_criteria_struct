 and heart myocardial samples from the explanted hearts of LMNA+ patients who are scheduled to undergo clinically indicated heart transplantation at the Papworth Hospital NHS Trust.\n-  DCMWT cases: patients with heart muscle failure but with wild-type lamin gene. Heart myocardial samples from the explanted hearts of DCMWT patients who are scheduled to undergo clinically indicated heart transplantation at the Papworth Hospital NHS Trust.\n-  HV (controls): matched to cases.\n\n### Response:\n{\n  "AND": {\n    "left": {\n      "AND": {\n        "left": {\n          "AND": {\n            "left": {\n              "raw_text": "- LMNA+ cases with pathogenic LMNA mutations for LMNA+",\n              "Condition": [\n                "LMNA+",\n                "LMNA"\n              ],\n              "Condition-Name": [\n                "LMNA+",\n                "LMNA"\n              ],\n              "Modifier": [\n                "pathogenic"\n              ]\n            },\n            "right": {\n              "AND": {\n                "left": {\n                  "raw_text": "and heart myocardial samples from the explanted hearts of LMNA+ patients who are scheduled to undergo clinically indicated heart transplantation at the Papworth Hospital NHS Trust.",\n                  "Condition": [\n                    "LMNA+",\n                    "LMNA"\n                  ],\n                  "Condition-Name": [\n                    "LMNA+",\n                    "LMNA"\n                  ],\n                  "Observation": [\n                    "heart myocardial samples"\n                  ],\n                  "Observation-Name": [\n                    "heart myocardial samples"\n                  ],\n                  "Procedure": [\n                    "heart transplantation"\n                  ],\n                  "Procedure-Name": [\n                    "heart transplantation"\n                  ],\n                  "Location": [\n                    "Papworth Hospital NHS Trust"\n                  ],\n                  "Eq-Comparison": [\n                    "scheduled to undergo"\n                  ],\n                  "Eq-Temporal-Period": [\n                    "scheduled to undergo"\n                  ]\n                },\n                "right": {\n                  "raw_text": "at the Papworth Hospital NHS Trust.",\n                  "Location": [\n                    "Papworth Hospital NHS Trust"\n                  ]\n                }\n              }\n            }\n          }\n        },\n        "right": {\n          "AND": {\n            "left": {\n              "raw_text": "- DCMWT cases: patients",\n              "Condition": [\n                "DCMWT"\n              ],\n              "Condition-Name": [\n                "DCMWT"\n              ]\n            },\n            "right": {\n              "AND": {\n                "left": {\n                  "raw_text": "with heart muscle failure but",\n                  "Condition": [\n                    "heart muscle failure"\n                  ],\n                  "Condition-Name": [\n                    "heart muscle failure"\n                  ]\n                },\n                "right": {\n                  "AND": {\n                    "left": {\n                      "raw_text": "with wild-type lamin gene. Heart myocardial samples from the explanted hearts of DCMWT patients who are scheduled to undergo clinically indicated heart transplantation",\n                      "Condition": [\n                        "DCMWT"\n                      ],\n                      "Condition-Name": [\n                        "DCMWT"\n                      ],\n                      "Observation": [\n                        "Heart myocardial samples"\n                      ],\n                      "Observation-Name": [\n                        "Heart myocardial samples"\n                      ],\n                      "Procedure": [\n                        "heart transplantation"\n                      ],\n                      "Procedure-Name": [\n                        "heart transplantation"\n                      ],\n                      "Eq-Comparison": [\n                        "scheduled to undergo"\n                      ],\n                      "Eq-Temporal-Period": [\n                        "scheduled to undergo"\n                      ],\n                      "Modifier": [\n                        "wild-type lamin gene"\n                      ]\n                    },\n                    "right": {\n                      "raw_text": "at the Papworth Hospital NHS Trust.",\n                      "Location": [\n                        "Papworth Hospital NHS Trust"\n                      ]\n                    }\n                  }\n                }\n              }\n            }\n          }\n        }\n      }\n    },\n    "right": {\n      "raw_text": "- HV (controls): matched to cases.",\n      "Condition": [\n        "HV"\n      ],\n      "Condition-Name": [\n        "HV"\n      ]\n    }\n  }\n}<|eot_id|>']
