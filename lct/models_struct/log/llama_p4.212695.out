            "surgery"\n                                  ],\n                                  "Procedure-Name": [\n                                    "surgery"\n                                  ],\n                                  "Condition": [\n                                    "Complications",\n                                    "posterior capsular rupture"\n                                  ],\n                                  "Condition-Name": [\n                                    "Complications",\n                                    "posterior capsular rupture"\n                                  ]\n                                },\n                                "right": {\n                                  "OR": {\n                                    "left": {\n                                      "raw_text": "vitreous loss,",\n                                      "Condition": [\n                                        "vitreous loss"\n                                      ],\n                                      "Condition-Name": [\n                                        "vitreous loss"\n                                      ]\n                                    },\n                                    "right": {\n                                      "OR": {\n                                        "left": {\n                                          "raw_text": "zonular dialysis,",\n                                          "Procedure": [\n                                            "zonular dialysis"\n                                          ],\n                                          "Procedure-Name": [\n                                            "zonular dialysis"\n                                          ]\n                                        },\n                                        "right": {\n                                          "raw_text": "or iris trauma.",\n                                          "Condition": [\n