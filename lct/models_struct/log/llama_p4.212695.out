                    "OR": {\n                                        "left": {\n                                          "raw_text": "malignance,",\n                                          "Condition": [\n                                            "malignance"\n                                          ],\n                                          "Condition-Name": [\n                                            "malignance"\n                                          ]\n                                        },\n                                        "right": {\n                                          "OR": {\n                                            "left": {\n                                              "raw_text": "chronic malnutrition,",\n                                              "Condition": [\n                                                "malnutrition"\n                                              ],\n                                              "Condition-Name": [\n                                                "malnutrition"\n                                              ],\n                                              "Acuteness": [\n                                                "chronic"\n                                              ]\n                                            },\n                                            "right": {\n                                              "raw_text": "anaemia",\n                                              "Condition": [\n                                                "anaemia"\n                                              ],\n                                              "Condition-Name": [\n                                                "anaemia"\n                                              ]\n                                            }\n                                          }\n                                        }\n                                      }\n             