a usage"\n          ],\n          "Assertion": [\n            "Willing to"\n          ]\n        },\n        "right": {\n          "OR": {\n            "left": {\n              "raw_text": "or habitual/",\n              "Modifier": [\n                "habitual"\n              ]\n            },\n            "right": {\n              "OR": {\n                "left": {\n                  "raw_text": "chronic usage);",\n                  "Condition": [\n                    "usage"\n                  ],\n                  "Condition-Name": [\n                    "usage"\n                  ],\n                  "Modifier": [\n                    "chronic"\n                  ]\n                },\n                "right": {\n                  "OR": {\n                    "left": {\n                      "raw_text": "no, recreational,",\n                      "Negation": [\n                        "no"\n                      ],\n                      "Modifier": [\n                        "recreational"\n                      ]\n                    },\n                    "right": {\n                      "OR": {\n                        "left": {\n                          "raw_text": "former",\n                          "Eq-Comparison": [\n                            "former"\n                          ],\n                          "Eq-Temporal-Period": [\n                            "former"\n                          ]\n                        },\n                        "right": {\n                          "AND": {\n                            "left": {\n                              "raw_text": "or"\n                            },\n                            "right": {\n                              "NOT": {\n                                "left": {\n                                  "raw_text": "never usage)",\n                                  "Condition": [\n                                    "usage"\n                                  ],\n                                  "Condition-Name": [\n                                    "usage"\n                                  ],\n                                  "Negation": [\n                                    "never"\n                                  ]\n                                }\n                              }\n                            }\n                          }\n                        }\n                      }\n                    }\n                  }\n                }\n              }\n            }\n          }\n        }\n      }\n    }\n  }\n}<|eot_id|>']
