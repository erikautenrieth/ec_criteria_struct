        "left": {
          "raw_text": "septic arthritis,",
          "Condition": [
            "arthritis"
          ],
          "Condition-Name": [
            "arthritis"
          ],
          "Modifier": [
            "septic"
          ]
        },
        "right": {
          "OR": {
            "left": {
              "raw_text": "Lyme disease,",
              "Condition": [
                "Lyme disease"
              ],
              "Condition-Name": [
                "Lyme disease"
              ]
            },
            "right": {
              "OR": {
                "left": {
                  "raw_text": "microcrystalline arthritis",
                  "Condition": [
                    "arthritis"
                  ],
                  "Condition-Name": [
                    "arthritis"
                  ],
                  "Modifier": [
                    "microcrystalline"
                  ]
                },
                "right": {
                  "raw_text": "or rheumatoid arthritis",
                  "Condition": [
