         ],\n                                      "Negation": [\n                                        "not"\n                                      ]\n                                    }\n                                  }\n                                }\n                              }\n                            }\n                          }\n                        }\n                      }\n                    }\n                  }\n                }\n              }\n            }\n          }\n        },\n        "right": {\n          "AND": {\n            "left": {\n              "raw_text": "-",\n              "Eq-Operator": [\n                "-"\n              ]\n            },\n            "right": {\n              "OR": {\n                "left": {\n                  "raw_text": "Compliance with visual examinations",\n                  "Procedure": [\n                    "visual examinations"\n                  ],\n                  "Procedure-Name": [\n                    "visual examinations"\n                  ]\n                },\n                "right": {\n                  "raw_text": "and physiotherapy evaluations",\n                  "Procedure": [\n                    "physiotherapy evaluations"\n                  ],\n                  "Procedure-Name": [\n                    "physiotherapy evaluations"\n                  ]\n                }\n              }\n            }\n          }\n        }\n      }\n    },\n    "right": {\n      "raw_text": "- To be children and parents who agree to participate in the study",\n      "Eq-Operator": [\n        "-"\n      ],\n      "Family-Member": [\n        "children",\n        "child"\n      ]\n    }\n  }\n}<|eot_id|>']
