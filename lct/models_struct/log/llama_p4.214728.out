tion in last 1 month",\n\t                  "Eq-Operator": [\n\t                    "to"\n\t                  ],\n\t                  "Eq-Value": [\n\t                    "1"\n\t                  ],\n\t                  "Eq-Comparison": [\n\t                    "History",\n\t                    "last 1 month"\n\t                  ],\n\t                  "Eq-Temporal-Period": [\n\t                    "History",\n\t                    "last"\n\t                  ],\n\t                  "Eq-Temporal-Unit": [\n\t                    "month"\n\t                  ],\n\t                  "Drug-Name": [\n\t                    "intraarticular injection"\n\t                  ],\n\t                  "Drug": [\n\t                    "intraarticular injection"\n                  ]\n                }\n              }\n            }\n          }\n        }\n      }\n    },\n    "right": {\n      "OR": {\n        "left": {\n            "raw_text": "- Patients with neurological disease that will affect muscle strength,",\n            "Modifier": [\n              "neurological"\n            ],\n            "Eq-Operator": [\n              "to"\n            ],\n            "Eq-Comparison": [\n              "will"\n            ],\n            "Eq-Temporal-Period": [\n              "will"\n            ],\n            "Condition": [\n              "disease"\n            ],\n            "Condition-Name": [\n              "disease"\n            ],\n            "Observation": [\n              "muscle strength"\n            ],\n            "Observation-Name": [\n              "muscle strength"\n            ],\n            "Stability": [\n              "affect"\n            ],\n            "Assertion": [\n              "will"\n            ]\n          }\n        },\n        "right": {\n          "OR": {\n            "left": {\n              "raw_text": "balance",\n              "Observation": [\n                "balance"\n              ],\n              "Observation-Name": [\n                "b