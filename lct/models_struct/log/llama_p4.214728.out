        "left": {
          "raw_text": "- Not enough kidney tissue to confirm a diagnosis (adequate tissue: more than 2 cores of kidney tissues (10 x 1.2 mm) including over 10-15 glomerulus each)",
          "Eq-Comparison": [
            "> 2",
            "over 10-15"
          ],
          "Eq-Operator": [
            "more than",
            "over"
          ],
          "Eq-Value": [
            "10",
