xt": "or drug addiction (including soft drugs like cannabis products)",\n                      "Eq-Operator": [\n                        "within"\n                      ],\n                      "Condition": [\n                        "drug addiction",\n                        "addiction"\n                      ],\n                      "Drug": [\n                        "drug",\n                        "drugs",\n                        "cannabis products"\n                      ],\n                      "Eq-Value": [\n                        "c"\n                      ],\n                      "Condition-Name": [\n                        "drug addiction",\n                        "addiction"\n                      ],\n                      "Drug-Name": [\n                        "cannabis products",\n                        "drug"\n                      ],\n                      "Eq-Comparison": [\n                        "within"\n                      ],\n                      "Modifier": [\n                        "soft drugs"\n                      ],\n                      "Eq-Unit": [\n                        "mL"\n                      ],\n                      "Eq-Unit": [\n                        "mL"\n                      ]\n                    },\n                    "right": {\n                      "raw_text": "including soft drugs like cannabis products)",\n                      "Modifier": [\n                        "soft drugs"\n                      ],\n                      "Drug": [\n                        "cannabis products"\n                      ],\n                      "Drug-Name": [\n                        "cannabis products"\n                      ],\n                      "Eq-Unit": [\n                        "mL"\n                      ],\n                      "Eq-Unit": [\n                        "mL"\n                      ]\n                    }\n                  }\n                }\n              }\n            }\n          }\