              "Eq-Comparison": [
                "older than 80 years"
              ],
              "Eq-Value": [
                "80"
              ],
              "Eq-Unit": [
                "years"
              ]
            }
          }
        }
      }
    },
    "right": {
      "AND": {
        "left": {
