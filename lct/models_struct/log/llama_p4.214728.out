cal examination (Compared with intact side, there is more than 25% limitation in at least two directions of shoulder range of motion)\n-  Subjects have complaints for at least 1 month\n-  No pregnancy / breastfeeding\n\n### Response:\n{\n  "AND": {\n    "left": {\n\t      "AND": {\n\t        "left": {\n\t          "raw_text": "- Subjects with adhesive capsulitis diagnosis by physical examination (Compared with intact side, there is more than 25% limitation in at least two directions of shoulder range of motion)",\n\t          "Eq-Comparison": [\n\t            "at least two directions",\n\t            "more than 25%"\n\t          ],\n\t          "Eq-Operator": [\n\t            "at least",\n\t            "more than"\n\t          ],\n\t          "Eq-Value": [\n\t            "two",\n\t            "25"\n\t          ],\n\t          "Eq-Unit": [\n\t            "%"\n\t          ],\n\t          "Modifier": [\n\t            "adhesive",\n\t            "shoulder"\n\t          ],\n\t          "Condition": [\n\t            "adhesive capsulitis"\n\t          ],\n\t          "Condition-Name": [\n\t            "adhesive capsulitis"\n\t          ],\n\t          "Eq-Temporal-Unit": [\n\t            "month"\n\t          ]\n\t        },\n\t        "right": {\n\t          "raw_text": "- Subjects have complaints for at least 1 month",\n\t          "Eq-Value": [\n\t            "1"\n\t          ],\n\t          "Eq-Comparison": [\n\t            "at least 1 month"\n\t          ],\n\t          "Eq-Operator": [\n\t            "at least"\n\t          ],\n\t          "Eq-Temporal-Unit": [\n\t            "month"\n\t          ]\n\t        }\n\t      }\n\t    }\n\t  }\n\t},\n\t"right": {\n\t  "OR": {\n\t    "left": {\n\t      "raw_text": "- No pregnancy/",\n\t      "Condition": [\n\t        "pregnancy"\n\t      ],\n\t      "Condition-Name": [\n\t        "pregnancy"\n\t      ],\n\t      "Negation": [\n\t        "No"\n\t      ]\n\t    },\n\t    "right": {\n\t      "raw_text": "breastfeeding",\n\t      "Condition": [\n\t        "breastfeeding"\n\t      ],\n\t      "Condition-Name": [\n\t        "breastfeeding"\n\t      ]\n\t    }\n\t  }\n\t}\n\t  }\n\t}\n\t  }\n\t}\n\t  }\n\t}\n  }\n}<|eot_id|>']
