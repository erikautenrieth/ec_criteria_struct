                ],\n                                  "Eq-Operator": [\n                                    "-"\n                                  ],\n                                  "Eq-Comparison": [\n                                    "one or more"\n                                  ],\n                                  "Eq-Value": [\n                                    "one"\n                                  ],\n                                  "Risk": [\n                                    "risk factors"\n                                  ],\n                                  "Eq-Unit": [\n                                    "vascular"\n                                  ],\n                                  "Eq-Unit": [\n                                    "primary"\n                                  ],\n                                  "Eq-Comparison": [\n                                    "more"\n                                  ],\n                                  "Eq-Operator": [\n                                    "or more"\n                                  ]\n                                },\n                                "right": {\n                                  "OR": {\n                                    "left": {\n                                      "raw_text": "DLP, current smoker,",\n                                      "Eq-Comparison": [\n                                        "current"\n                                      ],\n                                      "Eq-Temporal-Period": [\n                                        "current"\n                                      ],\n                                      "Condition": [\n                                        "DLP",\n                                        "smoker"\n                                      ],\n                                      "Condition-Name": [\n                                        "DLP",\n                                        "smoker"\