ology for ascites\n-  Not willing for consent\n\n### Response:\n{\n  "AND": {\n    "left": {\n\t      "AND": {\n\t        "left": {\n\t          "AND": {\n\t            "left": {\n\t              "raw_text": "- Age < 12",\n\t              "Eq-Comparison": [\n\t                "< 12"\n\t              ],\n\t              "Age": [\n\t                "Age"\n\t              ],\n\t              "Eq-Operator": [\n\t                "<"\n\t              ],\n\t              "Eq-Value": [\n\t                "12"\n\t              ]\n\t            },\n\t            "right": {\n\t              "raw_text": "- Unclear diagnosis",\n\t              "Modifier": [\n\t                "Unclear"\n\t              ]\n\t            }\n\t          }\n\t        },\n\t        "right": {\n\t          "raw_text": "- More than one etiology for ascites",\n\t          "Eq-Comparison": [\n\t            "More than one"\n\t          ],\n\t          "Eq-Operator": [\n\t            "More than"\n\t          ],\n\t          "Eq-Value": [\n\t            "one"\n\t          ],\n\t          "Condition": [\n\t            "ascites"\n\t          ],\n\t          "Condition-Name": [\n\t            "ascites"\n\t          ]\n\t        }\n\t      }\n\t    },\n\t    "right": {\n\t      "raw_text": "- Not willing for consent",\n\t      "Eq-Value": [\n\t        "one"\n\t      ]\n\t    }\n\t  }\n\t}\n\t  }\n\t}\n\t  }\n\t}\n\t  }\n\t}\n\t  }\n\t}\n\t  }\n\t}\n\t  }\n\t}\n\t  }\n\t}\n\t  }\n\t}\n\t  }\n\t}\n\t  }\n\t}\n\t  }\n\t}\n  }\n}<|eot_id|>']
