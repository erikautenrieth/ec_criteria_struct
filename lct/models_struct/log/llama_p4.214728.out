sorders including central nervous system (CNS) involvement -",\n                                  "Condition": [\n                                    "Somatic disorders",\n                                    "disorders"\n                                  ],\n                                  "Modifier": [\n                                    "central nervous system",\n                                    "CNS"\n                                  ],\n                                  "Condition-Name": [\n                                    "Somatic disorders",\n                                    "disorders"\n                                  ]\n                                },\n                                "right": {\n                                  "raw_text": "involvement",\n                                  "Modifier": [\n                                    "involvement"\n                                  ]\n                                }\n                              }\n                            }\n                          }\n                        },\n                        "right": {\n                          "OR": {\n                            "left": {\n                              "raw_text": "- Known",\n                              "Eq-Operator": [\n                                "-"\n                              ]\n                            },\n                            "right": {\n                              "OR": {\n                                "left": {\n                                  "raw_text": "or suspected non-compliance, drug",\n                                  "Eq-Operator": [\n                                    "-"\n                                  ],\n                                  "Assertion": [\n                                    "suspected"\n                                  ],\n                                  "Modifier": [\n                                    "non-compliance",\n                      