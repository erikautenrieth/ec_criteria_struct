                          ],
                          "Condition-Name": [
                            "Claustrophobia"
                          ]
                        }
                      }
                    },
                    "right": {
                      "raw_text": "- Heavy hearing",
                      "Modifier": [
                        "Heavy hearing"
                      ]
                    }
                  }
                },
                "right": {
                  "raw_text": "- Visual impairment",
                  "Condition": [
                    "Visual impairment"
                  ],
                  "Condition-Name": [
                    "Visual impairment"
                  ]
                }
              }
            },
            "right": {
              "raw_text": "- Face burn",
              "Observation": [
                "burn"
              ],
              "Observation-Name": [
                "burn"
