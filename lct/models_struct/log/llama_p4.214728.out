w_text": "- Patient already participating in a category 1 research study (Jardé law).",\n                      "Eq-Value": [\n                        "1"\n                      ],\n                      "Study": [\n                        "study"\n                      ],\n                      "Eq-Comparison": [\n                        "already"\n                      ],\n                      "Eq-Temporal-Period": [\n                        "already"\n                      ]\n                    }\n                  }\n                },\n                "right": {\n                  "raw_text": "- Patient in an exclusion period determined by another study.",\n                  "Study": [\n                    "study"\n                  ],\n                  "Other": [\n                    "another"\n                  ],\n                  "Eq-Unit": [\n                    "mmol"\n                  ]\n                }\n              }\n            },\n            "right": {\n              "OR": {\n                "left": {\n                  "raw_text": "- Patient under the protection of justice,",\n                  "Eq-Value": [\n                    "1"\n                  ]\n                },\n                "right": {\n                  "OR": {\n                    "left": {\n                      "raw_text": "under guardianship",\n                      "Observation-Name": [\n                        "under guardianship"\n                      ]\n                    },\n                    "right": {\n                      "raw_text": "or under curatorship.",\n                      "Observation-Name": [\n                        "under curatorship"\n                      ]\n                    }\n                  }\n                }\n              }\n            }\n          }\n        },\n        "right": {\n          "raw_text": "- Patient refusing to sign the consent form.",\n          "Eq-Unit": [\n            "mmol"\n          ]\n        }\n      }\n   