              "Eq-Comparison": [\n                                            "< 3 months"\n                                          ],\n                                          "Drug-Name": [\n                                            "vaginal estrogen"\n                                          ],\n                                          "Eq-Value": [\n                                            "3"\n                                          ],\n                                          "Eq-Temporal-Unit": [\n                                            "months"\n                                          ],\n                                          "Procedure": [\n                                            "treatment"\n                                          ],\n                                          "Eq-Temporal-Recency": [\n                                            "start"\n                                          ]\n                                        }\n                                      }\n                                    }\n                                  }\n                                }\n                              }\n                            }\n                          }\n                        },\n                        "right": {\n                          "raw_text": "- Malignant disease as the cause of the vulval symptoms",\n                          "Eq-Operator": [\n                            "-"\n                          ],\n                          "Modifier": [\n                            "vulval"\n                          ],\n                          "Eq-Comparison": [\n                            "start"\n                          ],\n                          "Eq-Temporal-Recency": [\n                            "start"\n                          ],\n                          "Modifier": [\n                            "symptoms"\n                          ],\n                          "Condition": [\