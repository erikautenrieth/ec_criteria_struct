       },\n                    "right": {\n                      "raw_text": "- intake antifungal azoles for >3 weeks in the preceding six months",\n                      "Eq-Operator": [\n                        ">",\n                        "-"\n                      ],\n                      "Eq-Temporal-Unit": [\n                        "months",\n                        "weeks"\n                      ],\n                      "Eq-Value": [\n                        "3",\n                        "six"\n                      ],\n                      "Eq-Comparison": [\n                        ">3 weeks"\n                      ],\n                      "Eq-Temporal-Period": [\n                        "preceding"\n                      ],\n                      "Drug": [\n                        "antifungal azoles"\n                      ],\n                      "Drug-Name": [\n                        "antifungal azoles"\n                      ],\n                      "Eq-Temporal-Period-Recency": [\n                        "preceding"\n                      ]\n                    }\n                  }\n                },\n                "right": {\n                  "OR": {\n                    "left": {\n                      "raw_text": "- subjects with active pulmonary infection due to mycobacterium tuberculosis",\n                      "Eq-Operator": [\n                        "-"\n                      ],\n                      "Eq-Comparison": [\n                        "active"\n                      ],\n                      "Eq-Temporal-Period": [\n                        "active"\n                      ],\n                      "Modifier": [\n                        "pulmonary"\n                      ],\n                      "Condition": [\n                        "infection",\n                        "mycobacterium tuberculosis"\n                      ],\n                      "Condition-Name": [\n                        "infection",\n                        "mycobacterium tuberculosis"\n                      ]\n                    },\n                    "right": {\n                      "raw_text": "or mycobacteria other than tuberculosis (MOTT)",\n                      "Modifier": [\n                        "MOTT",\n                        "mycobacteria other than tuberculosis"\n                      ],\n                      "Condition": [\n                        "tuberculosis"\n                      ],\n                      "Condition-Name": [\n                        "tuberculosis"\n                      ]\n                    }\n                  }\n                }\n              }\n            },\n            "right": {\n              "OR": {\n                "left": {\n                  "raw_text": "- subjects with others forms of pulmonary aspergillosis (allergic bronchopulmonary aspergillosis, chronic necrotizing aspergillosis",\n                  "Eq-Operator": [\n                    "-"\n                  ],\n                  "Modifier": [\n                    "pulmonary",\n                    "allergic bronchopulmonary",\n                    "chronic necrotizing"\n                  ],\n                  "Condition": [\n                    "aspergillosis"\n                  ],\n                  "Condition-Name": [\n                    "aspergillosis"\n                  ],\n                  "Eq-Comparison": [\n                    "others"\n                  ],\n                  "Eq-Temporal-Recency": [\n                    "others"\n                  ]\n                },\n                "right": {\n                  "raw_text": "and angio-invasive aspergillosis)",\n                  "Condition": [\n                    "aspergillosis"\n                  ],\n                  "Condition-Name": [\n                    "aspergillosis"\n                  ],\n                  "Modifier": [\n                    "angio-invasive"\n                  ]\n                }\n              }\n            }\n          }\n        },\n        "right": {\n          "raw_text": "- pregnancy",\n          "Condition": [\n            "pregnancy"\n          ],\n          "Eq-Operator": [\n            "-"\n          ],\n          "Condition-Name": [\n            "pregnancy"\n          ]\n        }\n      }\n    },\n    "right": {\n      "raw_text": "- failure to provide informed consent",\n      "Eq-Operator": [\n        "-"\n      ]\n    }\n  }\n}<|eot_id|>']
