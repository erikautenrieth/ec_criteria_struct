o American College of Radiology\n-  Being radiographically K-L grade 2-3\n-  Presence of symptoms for at least 3 months\n-  Patients who have been planned a conventional physiotherapy programme because of knee osteoarthritis\n-  Presence of functional capacity for outpatient physical therapy\n\n### Response:\n{\n  "AND": {\n    "left": {\n      "AND": {\n        "left": {\n          "AND": {\n            "left": {\n              "AND": {\n                "left": {\n                  "raw_text": "- Diagnosis of primary knee osteoarthritis according to American College of Radiology",\n                  "Condition": [\n                    "osteoarthritis"\n                  ],\n                  "Modifier": [\n                    "primary knee",\n                    "knee"\n                  ],\n                  "Condition-Name": [\n                    "osteoarthritis"\n                  ]\n                },\n                "right": {\n                  "raw_text": "- Being radiographically K-L grade 2-3",\n                  "Eq-Comparison": [\n                    "2-3"\n                  ],\n                  "Eq-Value": [\n                    "2",\n                    "3"\n                  ],\n                  "Eq-Operator": [\n                    "-"\n                  ]\n                }\n              }\n            },\n            "right": {\n              "raw_text": "- Presence of symptoms for at least 3 months",\n              "Assertion": [\n                "symptoms for"\n              ],\n              "Eq-Comparison": [\n                "at least 3 months"\n              ],\n              "Eq-Operator": [\n                "at least"\n              ],\n              "Eq-Temporal-Unit": [\n                "months"\n              ],\n              "Eq-Value": [\n                "3"\n              ]\n            }\n          }\n        },\n        "right": {\n          "raw_text": "- Patients who have been planned a conventional physiotherapy programme because of knee osteoarthritis",\n          "Condition": [\n            "osteoarthritis"\n          ],\n          "Modifier": [\n            "knee"\n          ],\n          "Eq-Operator": [\n            "-"\n          ],\n          "Eq-Comparison": [\n            "planned"\n          ],\n          "Eq-Temporal-Period": [\n            "planned"\n          ],\n          "Procedure": [\n            "physiotherapy programme"\n          ],\n          "Procedure-Name": [\n            "physiotherapy programme"\n          ],\n          "Eq-Temporal-Unit": [\n            "mo"\n          ],\n          "Condition-Name": [\n            "osteoarthritis"\n          ]\n        }\n      }\n    },\n    "right": {\n      "raw_text": "- Presence of functional capacity for outpatient physical therapy",\n      "Eq-Operator": [\n        "-"\n      ],\n      "Eq-Comparison": [\n        "Presence"\n      ],\n      "Eq-Temporal-Period": [\n        "Presence"\n      ],\n      "Procedure": [\n        "outpatient physical therapy"\n      ],\n      "Procedure-Name": [\n        "outpatient physical therapy"\n      ]\n    }\n  }\n}<|eot_id|>']
