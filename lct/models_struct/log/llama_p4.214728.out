          "Vulnerable populations"\n                              ],\n                              "Observation-Name": [\n                                "Vulnerable populations"\n                              ],\n                              "Eq-Comparison": [\n                                "on"\n                              ],\n                              "Eq-Temporal-Period": [\n                                "on"\n                              ],\n                              "Modifier": [\n                                "prisoners"\n                              ]\n                            },\n                            "right": {\n                              "AND": {\n                                "left": {\n                                  "raw_text": "or adults",\n                                  "Life-Stage-And-Gender": [\n                                    "adults"\n                                  ]\n                                },\n                                "right": {\n                                  "AND": {\n                                    "left": {\n                                      "raw_text": "unable to give consent",\n                                      "Eq-Value": [\n                                        "one"\n                                      ],\n                                      "Eq-Comparison": [\n                                        "on"\n                                      ],\n                                      "Eq-Temporal-Period": [\n                                        "on"\n                                      ]\n                                    },\n                                    "right": {\n                                      "raw_text": "Patients will be excluded from the study intra-operatively if:",\n                                      "Procedure": [\n                                        "operatively"\n                                      ],\n                                      "Procedure-Name": [\n                                        "operatively"\n                                      ],\n                                      "Eq-Value": [\n                                        "one"\n                                      ],\n                                      "Eq-Comparison": [\n                                        "on"\n                                      ],\n                                      "Eq-Temporal-Period": [\n                                        "on"\n                                      ],\n                                      "Eq-Operator": [\n                                        "to"\n                                      ]\n                                    }\n                                  }\n                                }\n                              }\n                            }\n                          }\n                        }\n                      }\n                    },\n                    "right": {\n                      "raw_text": "- If the scheduled surgery is planned at Butterworth hospital (as to standardize the nursing care received postoperatively)",\n                      "Eq-Operator": [\n                        "-"\n                      ],\n                      "Eq-Comparison": [\n                        "on"\n                      ],\n                      "Eq-Temporal-Period": [\n                        "on"\n                      ],\n                      "Eq-Value": [\n                        "one"\n                      ],\n                      "Procedure": [\n                        "surgery"\n                      ],\n                      "Procedure-Name": [\n                        "surgery"\n                      ],\n                      "Eq-Unit": [\n                        "g"\n                      ],\n                      "Location": [\n                        "Butterworth hospital"\n                      ],\n                      "Eq-Temporal-Unit": [\n                        "y"\n                      ],\n                      "Assertion": [\n                        "planned"\n                      ],\n                      "Procedure-Description": [\n                        "operatively"\n                      ]\n                    }\n                  }\n                },\n                "right": {\n                  "raw_text": "- Emergent cases",\n                  "Eq-Operator": [\n                    "-"\n                  ],\n                  "Eq-Comparison": [\n                    "on"\n                  ],\n                  "Eq-Temporal-Period": [\n                    "on"\n                  ],\n                  "Modifier": [\n                    "Emergent"\n                  ],\n                  "Eq-Value": [\n                    "one"\n                  ],\n                  "Eq-Temporal-Unit": [\n                    "y"\n                  ],\n                  "Eq-Unit": [\n                    "g"\n                  ]\n                }\n              }\n            },\n            "right": {\n              "raw_text": "Patients will be excluded from the study intra-operatively if:",\n              "Procedure": [\n                "operatively"\n              ],\n              "Procedure-Name": [\n                "operatively"\n              ],\n              "Eq-Operator": [\n                "to"\n              ],\n              "Eq-Value": [\n                "one"\n              ],\n              "Eq-Comparison": [\n                "on"\n              ],\n              "Eq-Temporal-Period": [\n                "on"\n              ],\n              "Eq-Unit": [\n                "g"\n              ],\n              "Eq-Temporal-Unit": [\n                "y"\n              ],\n              "Eq-Description": [\n                "on"\n              ],\n              "Eq-Unit-Name": [\n                "g"\n              ],\n              "Procedure-Description