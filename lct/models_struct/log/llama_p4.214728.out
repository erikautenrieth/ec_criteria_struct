\n-  Patients affiliated to social security or benefiting of a similar insurance scheme\n-  Patients having signed a consent to participate to the study\n\n### Response:\n{\n  "AND": {\n    "left": {\n      "AND": {\n        "left": {\n          "raw_text": "- Eligible patients for deep brain stimulation surgery",\n          "Eq-Operator": [\n            "-"\n          ],\n          "Procedure": [\n            "deep brain stimulation surgery"\n          ],\n          "Procedure-Name": [\n            "deep brain stimulation surgery"\n          ],\n          "Assertion": [\n            "Eligible"\n          ]\n        },\n        "right": {\n          "OR": {\n            "left": {\n              "raw_text": "- Patients affiliated to social security",\n              "Eq-Operator": [\n                "-"\n              ]\n            },\n            "right": {\n              "raw_text": "or benefiting of a similar insurance scheme",\n              "Assertion": [\n                "benefiting"\n              ],\n              "Insurance": [\n                "insurance scheme"\n              ]\n            }\n          }\n        }\n      }\n    },\n    "right": {\n      "raw_text": "- Patients having signed a consent to participate to the study",\n      "Eq-Operator": [\n        "-"\n      ],\n      "Study": [\n        "study"\n      ]\n    }\n  }\n}<|eot_id|>']
