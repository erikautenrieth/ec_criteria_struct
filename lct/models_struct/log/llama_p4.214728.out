t": "-",\n                      "Eq-Operator": [\n                        "-"\n                      ]\n                    },\n                    "right": {\n                      "NOT": {\n                        "left": {\n                          "raw_text": "No periodontal disease.",\n                          "Negation": [\n                            "No"\n                          ],\n                          "Condition": [\n                            "disease",\n                            "periodontal disease"\n                          ],\n                          "Condition-Name": [\n                            "disease",\n                            "periodontal disease"\n                          ]\n                        }\n                      }\n                    }\n                  }\n                }\n              }\n            },\n            "right": {\n              "raw_text": "- Patients with systemic disease.",\n              "Modifier": [\n                "systemic"\n              ],\n              "Condition": [\n                "disease"\n              ],\n              "Eq-Operator": [\n                "-"\n              ],\n              "Condition-Name": [\n                "disease"\n              ]\n            }\n          }\n        },\n        "right": {\n          "OR": {\n            "left": {\n              "raw_text": "- Patients with medical conditions such as kidney disease,",\n              "Modifier": [\n                "medical conditions"\n              ],\n              "Eq-Operator": [\n                "-"\n              ],\n              "Condition": [\n                "kidney disease",\n                "disease"\n              ],\n              "Condition-Name": [\n                "kidney disease",\n                "disease"\n              ]\n            },\n            "right": {\n              "OR": {\n                "left": {\n                  "raw_text": "heart disease, respiratory disease, diabetes