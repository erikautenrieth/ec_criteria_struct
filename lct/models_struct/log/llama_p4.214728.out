lanted hearts"\n              ],\n              "Specimen": [\n                "samples"\n              ],\n              "Eq-Unit": [\n                "heart"\n              ],\n              "Condition-Name": [\n                "wild-type lamin gene"\n              ],\n              "Procedure-Name": [\n                "heart transplantation"\n              ]\n            }\n          }\n        }\n      }\n    },\n    "right": {\n      "raw_text": "- HV (controls): matched to cases.",\n      "Condition": [\n        "HV"\n      ],\n      "Eq-Unit": [\n        "heart"\n      ],\n      "Condition-Name": [\n        "HV"\n      ]\n    }\n  }\n}<|eot_id|>']
