aw_text": "- Subjective benefit from the device",\n                                  "Procedure": [\n                                    "device"\n                                  ],\n                                  "Procedure-Name": [\n                                    "device"\n                                  ],\n                                  "Assertion": [\n                                    "benefit"\n                                  ],\n                                  "Eq-Operator": [\n                                    "-"\n                                  ]\n                                }\n                              }\n                            },\n                            "right": {\n                              "raw_text": "- Subjects aged 13 years or older",\n                              "Eq-Temporal-Unit": [\n                                "years"\n                              ],\n                              "Age": [\n                                "aged"\n                              ],\n                              "Eq-Operator": [\n                                "or older",\n                                "-"\n                              ],\n                              "Eq-Value": [\n                                "13"\n                              ],\n                              "Eq-Comparison": [\n                                "13 years or older"\n                              ]\n                            }\n                          }\n                        },\n                        "right": {\n                          "raw_text": "- Capable of the German language",\n                          "Eq-Operator": [\n                            "-"\n                          ],\n                          "Language": [\n                            "German"\n                          ]\n                        }\n                      }\n                    },\n                    "right": {\n                      "raw_text": "- Willingness and ability to perform all tests required for the study",\n                      "Assertion": [\n                        "Willingness and ability"\n                      ],\n                      "Eq-Operator": [\n                        "-"\n                      ],\n                      "Study": [\n                        "study"\n                      ]\n                    }\n                  }\n                },\n                "right": {\n                  "raw_text": "- Signed, and dated informed consent before the start of any study specific procedure",\n                  "Eq-Operator": [\n                    "-"\n                  ],\n                  "Eq-Value": [\n                    "1"\n                  ],\n                  "Eq-Comparison": [\n                    "1"\n                  ],\n                  "Study": [\n                    "study"\n                  ],\n                  "Procedure": [\n                    "procedure"\n                  ]\n                }\n              }\n            },\n            "right": {\n              "raw_text": "Subjects with active bilateral ear disease",\n              "Modifier": [\n                "bilateral ear",\n                "bilateral"\n              ],\n              "Eq-Operator": [\n                "-"\n              ],\n              "Eq-Value": [\n                "1"\n              ],\n              "Eq-Comparison": [\n                "active"\n              ],\n              "Eq-Temporal-Period": [\n                "active"\n              ],\n              "Condition": [\n                "disease"\n              ]\n            }\n          }\n        },\n        "right": {\n          "OR": {\n            "left": {\n              "raw_text": "- Subjects with a history of neurological,",\n              "Modifier": [\n                "neurological"\n              ],\n              "Eq-Operator": [\n                "-"\n              ],\n              "Eq-Comparison": [\n                "history"\n              ],\n              "Eq-Temporal-Period": [\n                "history"\n              ]\n            },\n            "right": {\n              "OR": {\n                "left": {\n                  "raw_text": "cardiovascular,",\n                  "Modifier": [\n                    "cardiovascular"\n                  ]\n                },\n                "right": {\n                  "OR": {\n                    "left": {\n                      "raw_text": "respiratory (including chronic infections and tumors),",\n                      "Modifier": [\n                        "respiratory"\n                      ],\n                      "Acuteness": [\n                        "chronic"\n                      ],\n                      "Condition": [\n                        "infections",\n                        "tumors"\n                      ],\n                      "Eq-Value": [\n                        "1"\n                      ],\n                      "Condition-Name": [\n                        "infections",\n                        "tumors"\n                      ]\n                    },\n                    "right": {\n                      "OR": {\n                        "left": {\n                          "raw_text": "endocrine (including thyroid disorders, diabetes mellitus),",\n                          "Condition": [\n                            "diabetes mellitus",\n                            "thyroid disorders"\n                          ],\n                          "Modifier": [\n                            "endocrine"\n                          ],\n                          "Condition-Name": [\n                            "diabetes mellitus",\n                            "thyroid disorders"\n                          ],\n                          "Eq-Value": [\n                            "1"\n                          ],\n                          "Eq-Operator": [\n                  