 score ≥ 4\n\n### Response:\n{\n  "AND": {\n    "left": {\n      "raw_text": "- Diagnosis of vulvar lichen sclerosus",\n      "Modifier": [\n        "vulvar"\n      ],\n      "Condition": [\n        "lichen sclerosus"\n      ],\n      "Condition-Name": [\n        "lichen sclerosus"\n      ]\n    },\n    "right": {\n      "raw_text": "- Clinical LS score ≥ 4",\n      "Eq-Comparison": [\n        "≥ 4"\n      ],\n      "Eq-Operator": [\n        "≥"\n      ],\n      "Eq-Value": [\n        "4"\n      ],\n      "Observation": [\n        "LS score"\n      ],\n      "Observation-Name": [\n        "LS score"\n      ]\n    }\n  }\n}<|eot_id|>']
