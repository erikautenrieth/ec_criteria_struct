ent.\n2. Not speaking English before age 5 years.\n3. Learning disability.\n4. MRI contraindications\n\n### Response:\n{\n  "AND": {\n    "left": {\n\t      "AND": {\n\t        "left": {\n\t          "AND": {\n\t            "left": {\n\t              "raw_text": "1. Lack of mental capacity to consent to study involvement.",\n\t              "Eq-Value": [\n\t                "1"\n\t              ],\n\t              "Eq-Comparison": [\n\t                "1"\n\t              ],\n\t              "Study": [\n\t                "study"\n\t              ]\n\t            },\n\t            "right": {\n\t              "AND": {\n\t                "left": {\n\t                  "raw_text": "2. Not speaking English",\n\t                  "Eq-Value": [\n\t                    "2"\n\t                  ],\n\t                  "Language": [\n\t                    "English"\n\t                  ]\n\t                },\n\t                "right": {\n\t                  "raw_text": "before age 5 years.",\n\t                  "Eq-Operator": [\n\t                    "before"\n                  ],\n\t                  "Eq-Value": [\n\t                    "5"\n                  ],\n\t                  "Eq-Temporal-Unit": [\n\t                    "years"\n                  ],\n\t                  "Eq-Comparison": [\n\t                    "5 years"\n                  ],\n\t                  "Eq-Temporal-Period": [\n\t                    "years"\n                  ],\n\t                  "Age": [\n\t                    "age"\n                  ]\n\t                }\n\t              }\n\t                }\n\t              }\n\t            }\n\t          }\n\t        },\n\t        "right": {\n\t          "raw_text": "3. Learning disability.",\n\t          "Condition": [\n\t            "Learning disability"\n\t          ],\n\t          "Condition-Name": [\n\t            "Learning disability"\n          ]\n        }\n      }\n    },\n    "right": {\n      "OR": {\n        "left": {\n          "raw_text": "4. MRI",\n          "Procedure": [\n            "MRI"\n          ],\n          "Procedure-Name": [\n            "MRI"\n          ]\n        },\n        "right": {\n          "raw_text": "contraindications",\n          "Eq-Value": [\n            "1"\n          ],\n          "Eq-Comparison": [\n            "1"\n          ],\n          "Contraindication": [\n            "contraindications"\n          ]\n        }\n      }\n    }\n  }\n}<|eot_id|>']
