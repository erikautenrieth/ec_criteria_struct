reviously received"\n                              ],\n                              "Acuteness": [\n                                "chron"\n                              ],\n                              "Eq-Temporal-Period": [\n                                "received",\n                                "Previously received"\n                              ]\n                            }\n                          }\n                        },\n                        "right": {\n                          "raw_text": "- Previous any organ transplant",\n                          "Eq-Operator": [\n                            "-"\n                          ],\n                          "Eq-Comparison": [\n                            "Previous"\n                          ],\n                          "Procedure": [\n                            "organ transplant"\n                          ],\n                          "Eq-Temporal-Period": [\n                            "Previous"\n                          ],\n                          "Procedure-Name": [\n                            "organ transplant"\n                          ]\n                        }\n                      }\n                    },\n                    "right": {\n                      "AND": {\n                        "left": {\n                          "raw_text": "- Patients who diagnosed heart failure with NYHA class 3 or 4",\n                          "Condition": [\n                            "heart failure"\n                          ],\n                          "Eq-Value": [\n                            "3",\n                            "4"\n                          ],\n                          "Condition-Name": [\n                            "heart failure"\n                          ],\n                          "Eq-Operator": [\n                            "-"\n                          ],\n                          "Eq-Comparison": [\n                            "3 or 4"\n                          ],\n                          "Eq-Unit": [\n                            "class"\n                          ],\n                          "Observation": [\n                            "NYHA"\n                          ],\n                          "Observation-Name": [\n                            "NYHA"\n                          ]\n                        },\n                        "right": {\n                          "raw_text": "with NYHA class 3 or 4",\n                          "Eq-Value": [\n                            "3",\n                            "4"\n                          ],\n                          "Eq-Unit": [\n                            "class"\n                          ],\n                          "Observation": [\n                            "NYHA"\n                          ],\n                          "Eq-Comparison": [\n                            "3 or 4"\n                          ],\n                          "Observation-Name": [\n                            "NYHA"\n                          ]\n                        }\n                      }\n                    }\n                  }\n                },\n                "right": {\n                  "raw_text": "- Known liver cirrhosis (Child-pugh class 2 or 3)",\n                  "Condition": [\n                    "liver cirrhosis"\n                  ],\n                  "Condition-Name": [\n                    "liver cirrhosis"\n                  ],\n                  "Eq-Value": [\n                    "3",\n                    "2"\n                  ],\n                  "Eq-Operator": [\n                    "-"\n                  ],\n                  "Eq-Comparison": [\n                    "3",\n                    "2 or 3"\n                  ],\n                  "Eq-Unit": [\n                    "class"\n                  ]\n                }\n              }\n            },\n            "right": {\n              "raw_text": "- Pregnant women",\n              "Condition": [\n                "Pregnant"\n              ],\n              "Condition-Name": [\n                "Pregnant"\n              ],\n              "Eq-Operator": [\n                "-"\n              ],\n              "Life-Stage-And-Gender": [\n                "women"\n              ]\n            }\n          }\n        },\n        "right": {\n          "OR": {\n            "left": {\n              "raw_text": "- Single kidney due to trauma",\n              "Modifier": [\n                "trauma"\n              ],\n              "Eq-Operator": [\n                "-"\n              ],\n              "Eq-Value": [\n                "Single"\n              ],\n              "Modifier": [\n                "Single kidney"\n              ]\n            },\n            "right": {\n              "raw_text": "or donation",\n              "Modifier": [\n                "donation"\n              ]\n            }\n          }\n        }\n      }\n    },\n    "right": {\n      "raw_text": "- Patients who received immunosuppressive agent within the past 1 year",\n      "Eq-Operator": [\n        "within"\n      ],\n      "Eq-Comparison": [\n        "received",\n        "within the past 1 year"\n      ],\n      "Drug": [\n        "immunosuppressive agent"\n      ],\n      "Drug-Name": [\n        "immunosuppressive agent"\n      ],\n      "Eq-Temporal-Period": [\n        "received"\n      ],\n      "Eq-Value": [\n        "1"\n      ],\n      "Eq-Temporal-Unit": [\n        "year"\n      ],\n      "Eq-Temporal-Period": [\n        "past"\n      ]\n    }\n  }\n}<|eot_id|>']
