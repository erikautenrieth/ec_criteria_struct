                                             "Inability"\n                                                                            ]\n                                                                        }\n                                                                        "right": {\n                                                                          "AND": {\n                                                                            "left": {\n                                                                              "raw_text": "and upright for the Optical Coherence Tomography (OCT).",\n                                                                              "Procedure": [\n                                                                                "Optical Coherence Tomography",\n                                                                                "OCT"\n                                                                              ],\n                                                                              "Procedure-Name": [\n                                                                                "Optical Coherence Tomography",\n                                                                                "OCT"\n                                                                              ],\n                                                                              "Eq-Operator": [\n                                                                                "-"\n                                                                              ],\n                                                                              "Modifier": [\n                                                                                "upright"\n                                                                              ]\n                                                                            },\n                  