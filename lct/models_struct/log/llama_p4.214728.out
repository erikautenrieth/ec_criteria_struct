ions"\n              ],\n              "Polarity": [\n                "positive"\n              ],\n              "Eq-Unit": [\n                "exon"\n              ],\n              "Eq-Unit-Name": [\n                "exon"\n              ],\n              "Eq-Temporal-Period": [\n                "on"\n              ],\n              "Eq-Temporal-Unit": [\n                "month"\n              ],\n              "Exception": [\n                "exception"\n              ]\n            }\n          }\n        },\n        "right": {\n          "raw_text": "- EGFR mutations in tumor tissue samples are detected by ARMS PCR and sequencing technology.",\n          "Condition": [\n            "EGFR mutations"\n          ],\n          "Condition-Name": [\n            "EGFR mutations"\n          ],\n          "Eq-Operator": [\n            "-"\n          ],\n          "Eq-Value": [\n            "2"\n          ],\n          "Eq-Comparison": [\n            "on"\n          ],\n          "Eq-Temporal-Period": [\n            "on"\n          ],\n          "Specimen": [\n            "tumor tissue samples"\n          ],\n          "Observation": [\n            "ARMS PCR",\n            "sequencing technology"\n          ],\n          "Observation-Name": [\n            "ARMS PCR",\n            "sequencing technology"\n          ]\n        }\n      }\n    },\n    "right": {\n      "OR": {\n        "left": {\n          "raw_text": "- Blood samples are collected from patients who have accepted genetic testing",\n          "Eq-Operator": [\n            "-"\n          ],\n          "Eq-Comparison": [\n            "on"\n          ],\n          "Eq-Temporal-Period": [\n            "on"\n          ],\n          "Specimen": [\n            "Blood samples"\n          ],\n          "Observation": [\n            "genetic testing"\n          ],\n          "Observation-Name": [\n            "genetic testing"\n          ],\n          "Assertion": [\n            "accepted"\n          ]\n        },\n 