nates:\n-  Aged between 1h of life and 28 days of life\n-  Born beyond 33 Week of Amenorrhea + 1day and 2kg of birth weight\n-  Hospitalized in the medical-surgical centre of Pediatrics of the hospital of Strasbourg\n-  For whom a blood sample was prescribed as part of their routine care\n\n### Response:\n{\n  "AND": {\n    "left": {\n      "AND": {\n        "left": {\n          "AND": {\n            "left": {\n              "AND": {\n                "left": {\n                  "AND": {\n                    "left": {\n                      "raw_text": "Adult Healthy Volunteers :",\n                      "Life-Stage-And-Gender": [\n                        "Adult"\n                      ],\n                      "Condition": [\n                        "Healthy"\n                      ],\n                      "Condition-Name": [\n                        "Healthy"\n                      ],\n                      "Assertion": [\n                        "Healthy"\n                      ]\n                    },\n                    "right": {\n                      "raw_text": "- Over 18 years of age",\n                      "Eq-Comparison": [\n                        "- Over 18 years"\n                      ],\n                      "Age": [\n                        "age"\n                      ],\n                      "Eq-Operator": [\n                        "-",\n                        "- Over",\n                        "Over"\n                      ],\n                      "Eq-Value": [\n                        "18"\n                      ],\n                      "Eq-Temporal-Unit": [\n                        "years"\n                      ]\n                    }\n                  }\n                },\n                "right": {\n                  "AND": {\n                    "left": {\n                      "raw_text": "- Aged between 1h of life",\n                      "Eq-Value": [\n                        "1"\n                      ],\n                      "Eq-Operator": [\n                        "-",\n                        "between"\n                      ],\n                      "Eq-Comparison": [\n                        "between 1h of life"\n                      ],\n                      "Age": [\n                        "Aged"\n                      ]\n                    },\n                    "right": {\n                      "AND": {\n                        "left": {\n                          "raw_text": "and 28 days of life",\n                          "Eq-Value": [\n                            "28"\n                          ],\n                          "Eq-Temporal-Unit": [\n                            "days"\n                          ],\n                          "Eq-Comparison": [\n                            "28 days"\n                          ]\n                        },\n                        "right": {\n                          "AND": {\n                            "left": {\n                              "raw_text": "- Born beyond 33 Week of Amenorrhea + 1day",\n                              "Eq-Operator": [\n                                "-"\n                              ],\n                              "Eq-Value": [\n                                "33",\n                                "1"\n                              ],\n                              "Eq-Comparison": [\n                                "beyond 33 Week"\n                              ],\n                              "Birth": [\n                                "Born"\n                              ],\n                              "Eq-Temporal-Unit": [\n                                "Week",\n                                "day"\n                              ]\n                            },\n                            "right": {\n                              "raw_text": "and 2kg of birth weight",\n                              "Eq-Unit": [\n                                "kg"\n                      