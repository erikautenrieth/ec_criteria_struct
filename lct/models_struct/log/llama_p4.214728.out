                 "-"\n                  ],\n                  "Condition-Name": [\n                    "renal failure"\n                  ],\n                  "Acuteness": [\n                    "acute"\n                  ]\n                }\n              }\n            },\n            "right": {\n              "raw_text": "- Patients with graft loss",\n              "Eq-Operator": [\n                "-"\n              ],\n              "Condition": [\n                "graft loss"\n              ],\n              "Condition-Name": [\n                "graft loss"\n              ]\n            }\n          }\n        },\n        "right": {\n          "OR": {\n            "left": {\n              "raw_text": "- Patients with history of alcohol abuse/",\n              "Eq-Comparison": [\n                "history"\n              ],\n              "Eq-Temporal-Period": [\n                "history"\n              ],\n              "Drug": [\n                "alcohol"\n              ],\n              "Eq-Operator": [\n                "-"\n              ],\n              "Drug-Name": [\n                "alcohol"\n              ],\n              "Modifier": [\n                "abuse"\n              ]\n            },\n            "right": {\n              "raw_text": "drug addiction,",\n              "Condition": [\n                "drug addiction"\n              ],\n              "Modifier": [\n                "drug"\n              ],\n              "Condition-Name": [\n                "drug addiction"\n              ]\n            }\n          }\n        }\n      }\n    },\n    "right": {\n      "raw_text": "- Patients with mental diseases;",\n      "Condition": [\n        "mental diseases"\n      ],\n      "Eq-Operator": [\n        "-"\n      ],\n      "Condition-Name": [\n        "mental diseases"\n      ]\n    }\n  }\n}<|eot_id|>']
