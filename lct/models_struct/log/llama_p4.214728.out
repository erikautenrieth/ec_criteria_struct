],\n      "Eq-Comparison": [\n        "≤ 4 weeks",\n        "≤ 2 weeks"\n      ],\n      "Eq-Value": [\n        "4",\n        "2"\n      ],\n      "Procedure": [\n        "surgery"\n      ],\n      "Procedure-Name": [\n        "surgery"\n      ],\n      "Modifier": [\n        "major",\n        "minor"\n      ]\n    }\n  }\n}<|eot_id|>']
