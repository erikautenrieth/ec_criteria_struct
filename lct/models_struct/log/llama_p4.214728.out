ast 5 on the 10-point numerical rating scale (NRS)\n\n### Response:\n{\n  "AND": {\n    "left": {\n      "raw_text": "- Burn patients",\n      "Modifier": [\n        "Burn"\n      ]\n    },\n    "right": {\n      "raw_text": "- severe neuropatic pain rated at least 5 on the 10-point numerical rating scale (NRS)",\n      "Observation": [\n        "pain"\n      ],\n      "Eq-Comparison": [\n        "at least 5"\n      ],\n      "Eq-Operator": [\n        "at least"\n      ],\n      "Eq-Value": [\n        "5"\n      ],\n      "Modifier": [\n        "neuropatic"\n      ],\n      "Severity": [\n        "severe"\n      ],\n      "Observation-Name": [\n        "pain"\n      ],\n      "Eq-Unit": [\n        "point"\n      ]\n    }\n  }\n}<|eot_id|>']
