               },\n                                    "right": {\n                                      "raw_text": "or multiple sclerosis)",\n                                      "Condition": [\n                                        "multiple sclerosis"\n                                      ],\n                                      "Condition-Name": [\n                                        "multiple sclerosis"\n                                      ]\n                                    }\n                                  }\n                                }\n                              }\n                            }\n                          }\n                        },\n                        "right": {\n                          "OR": {\n                            "left": {\n                              "raw_text": "- Patients with incompatibilities or known limitations that make participation",\n                              "Condition": [\n                                "limitations",\n                                "incompatibilities"\n                              ],\n                              "Eq-Operator": [\n                                "-"\n                              ],\n                              "Modifier": [\n                                "known"\n                              ],\n                              "Condition-Name": [\n                                "limitations",\n                                "incompatibilities"\n                              ],\n                              "Assertion": [\n                                "plan"\n                              ]\n                            },\n                            "right": {\n                              "AND": {\n                                "left": {\n                                  "raw_text": "impossible",\n                                  "Modifier": [\n                                    "impossible"\n                             