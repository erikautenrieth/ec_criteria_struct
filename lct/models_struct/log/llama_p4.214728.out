                     ],\n                          "Polarity": [\n                            "positive"\n                          ],\n                          "Condition-Name": [\n                            "complications during delivery",\n                            "Group B Streptococcus"\n                          ],\n                          "Eq-Operator": [\n                            "prior to"\n                          ]\n                        },\n                        "right": {\n                          "OR": {\n                            "left": {\n                              "raw_text": "Group A Streptococcus,",\n                              "Condition": [\n                                "Group A Streptococcus"\n                              ],\n                              "Condition-Name": [\n                                "Group A Streptococcus"\n                              ]\n                            },\n                            "right": {\n                              "AND": {\n                                "left": {\n                                  "raw_text": "bacterial vaginosis, vaginal pH > 4 at the time of birth. Mothers with fecal samples positive for Salmonella,",\n                                  "Eq-Comparison": [\n                                    "> 4"\n                                  ],\n                                  "Observation-Name": [\n                                    "vaginal pH",\n                                    "fecal samples"\n                                  ],\n                                  "Eq-Operator": [\n                                    ">"\n                                  ],\n                                  "Condition": [\n                                    "bacterial vaginosis"\n                                  ],\n                                  "Eq-Value": [\n                                    "4"\n                                  ],\n                   