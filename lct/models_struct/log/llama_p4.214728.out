cation I-II\n-  Scheduled for laparoscopic sleeve gastrectomy under general anesthesia\n\n### Response:\n{\n  "AND": {\n    "left": {\n      "raw_text": "- American Society of Anesthesiologists (ASA) classification I-II",\n      "Eq-Operator": [\n        "-"\n      ],\n      "Observation": [\n        "American Society of Anesthesiologists",\n        "ASA"\n      ],\n      "Eq-Comparison": [\n        "classification I-II"\n      ],\n      "Eq-Value": [\n        "I",\n        "II"\n      ],\n      "Eq-Unit": [\n        "classification"\n      ],\n      "Observation-Name": [\n        "American Society of Anesthesiologists",\n        "ASA"\n      ]\n    },\n    "right": {\n      "raw_text": "- Scheduled for laparoscopic sleeve gastrectomy under general anesthesia",\n      "Eq-Operator": [\n        "-"\n      ],\n      "Eq-Comparison": [\n        "Scheduled"\n      ],\n      "Procedure": [\n        "laparoscopic sleeve gastrectomy"\n      ],\n      "Procedure-Name": [\n        "laparoscopic sleeve gastrectomy"\n      ],\n      "Eq-Temporal-Period": [\n        "Scheduled"\n      ],\n      "Anesthesia": [\n        "anesthesia"\n      ],\n      "Modifier": [\n        "general"\n      ]\n    }\n  }\n}<|eot_id|>']
