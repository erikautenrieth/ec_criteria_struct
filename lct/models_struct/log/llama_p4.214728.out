          "meat"\n                                                  ],\n                                                  "Assertion": [\n                                                    "unable"\n                                                  ],\n                                                  "Eq-Value": [\n                                                    "one"\n                                                  ],\n                                                  "Eq-Comparison": [\n                                                    "one"\n                                                  ],\n                                                  "Eq-Temporal-Unit": [\n                                                    "regular consumption"\n                                                  ]\n                                                },\n                                                "right": {\n                                                  "AND": {\n                                                    "left": {\n                                                      "raw_text": "excluded since the foods for the study contain meat",\n                                                      "Modifier": [\n                                                        "meat",\n                                                        "eat meat"\n                                                      ],\n                                                      "Eq-Value": [\n                                                        "one"\n                                                      ],\n                                                      "Eq-Comparison": [\n                                                        "one"\n                                                      ],\n                                                      "Eq-Temporal-Unit": [\n                                                        "regular consumption"\n                          