                     ]\n                                        }\n                                      }\n                                    }\n                                  }\n                                }\n                              }\n                            }\n                          }\n                        }\n                      }\n                    }\n                  }\n                }\n              }\n            }\n          }\n        },\n        "right": {\n          "raw_text": "- Legal incapacity",\n          "Condition": [\n            "Legal incapacity"\n          ],\n          "Condition-Name": [\n            "Legal incapacity"\n          ]\n        }\n      }\n    },\n    "right": {\n      "OR": {\n        "left": {\n          "raw_text": "- Low",\n          "Eq-Operator": [\n            "-"\n          ],\n          "Modifier": [\n            "Low"\n          ]\n        },\n        "right": {\n          "AND": {\n            "left": {\n              "raw_text": "or"\n            },\n            "right": {\n              "NOT": {\n                "left": {\n                  "raw_text": "no cooperation anticipated",\n                  "Assertion": [\n                    "anticipated"\n                  ],\n                  "Modifier": [\n                    "no cooperation"\n                  ]\n                }\n              }\n            }\n          }\n        }\n      }\n    }\n  }\n}<|eot_id|>']
