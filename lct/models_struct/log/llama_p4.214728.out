            "and"\n                      ],\n                      "Eq-Value": [\n                        "18",\n                        "80"\n                      ],\n                      "Eq-Temporal-Unit": [\n                        "years"\n                      ],\n                      "Language": [\n                        "English"\n                      ],\n                      "Eq-Unit": [\n                        "and"\n                      ],\n                      "Modifier": [\n                        "Caregiver Dyads",\n                        "Type-II"\n                      ],\n                      "Condition": [\n                        "diabetes"\n                      ],\n                      "Condition-Name": [\n                        "diabetes"\n                      ]\n                    }\n                  }\n                }\n              }\n            },\n            "right": {\n              "raw_text": "- have Type-II diabetes.",\n              "Modifier": [\n                "Type-II"\n              ],\n              "Condition": [\n                "diabetes"\n              ],\n              "Condition-Name": [\n                "diabetes"\n              ]\n            }\n          }\n        },\n        "right": {\n          "raw_text": "- Type-II diabetes.",\n          "Modifier": [\n            "Type-II"\n          ],\n          "Condition": [\n            "diabetes"\n          ],\n          "Condition-Name": [\n            "diabetes"\n          ]\n        }\n      }\n    },\n    "right": {\n      "raw_text": "- Type-II diabetes.",\n      "Modifier": [\n        "Type-II"\n      ],\n      "Condition": [\n        "diabetes"\n      ],\n      "Condition-Name": [\n        "diabetes"\n      ]\n    }\n  }\n}<|eot_id|>']
