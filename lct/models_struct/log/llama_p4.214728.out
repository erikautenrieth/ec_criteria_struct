: {\n    "left": {\n      "raw_text": "-"\n    },\n    "right": {\n      "NOT": {\n        "left": {\n          "raw_text": "No evidence of dementia",\n          "Condition": [\n            "dementia"\n          ],\n          "Negation": [\n            "No"\n          ],\n          "Condition-Name": [\n            "dementia"\n          ]\n        }\n      }\n    }\n  }\n}<|eot_id|>']
