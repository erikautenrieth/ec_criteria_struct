                "Visual"\n              ]\n            },\n            "right": {\n              "OR": {\n                "left": {\n                  "raw_text": "auditory",\n                  "Modifier": [\n                    "auditory"\n                  ]\n                },\n                "right": {\n                  "raw_text": "and physical disabilities;",\n                  "Condition": [\n                    "disabilities"\n                  ],\n                  "Condition-Name": [\n                    "disabilities"\n                  ],\n                  "Modifier": [\n                    "physical"\n                  ]\n                }\n              }\n            }\n          }\n        }\n      }\n    },\n    "right": {\n      "OR": {\n        "left": {\n          "raw_text": "- Complication with other serious chronic diseases, such as liver",\n          "Acuteness": [\n            "chron"\n          ],\n          "Modifier": [\n            "liver"\n          ],\n          "Severity": [\n            "serious"\n          ],\n          "Other": [\n            "other"\n          ],\n          "Condition": [\n            "diseases"\n          ],\n          "Condition-Name": [\n            "diseases"\n          ],\n          "Stability": [\n            "Complication"\n          ]\n        },\n        "right": {\n          "OR": {\n            "left": {\n              "raw_text": "and kidney failure, connective tissue diseases, tumors.",\n              "Modifier": [\n                "kidney"\n              ],\n              "Condition": [\n                "connective tissue diseases",\n                "tumors"\n              ],\n              "Condition-Name": [\n                "connective tissue diseases",\n                "tumors"\n              ],\n              "Coreference": [\n                "failure"\n              ]\n            },\n            "right": {\n              "OR": {\n                "left": {\n                  "raw_text": "Complication with other serious chronic diseases, such as liver",\n                  "Acuteness": [\n                    "chron"\n                  ],\n                  "Modifier": [\n                    "liver"\n                  ],\n                  "Severity": [\n                    "serious"\n                  ],\n                  "Other": [\n                    "other"\n                  ],\n                  "Condition": [\n                    "diseases"\n                  ],\n                  "Condition-Name": [\n                    "diseases"\n                  ],\n                  "Stability": [\n                    "Complication"\n                  ]\n                },\n                "right": {\n                  "OR": {\n                    "left": {\n                      "raw_text": "kidney",\n                      "Modifier": [\n                        "kidney"\n                      ]\n                    },\n                    "right": {\n                      "OR": {\n                        "left": {\n                          "raw_text": "connective tissue diseases,",\n                          "Modifier": [\n                            "connective tissue"\n                          ],\n                          "Condition": [\n                            "diseases"\n                          ],\n                          "Condition-Name": [\n                            "diseases"\n                          ]\n                        },\n                        "right": {\n                          "raw_text": "tumors.",\n                          "Condition": [\n                            "tumors"\n                          ],\n                          "Condition-Name": [\n                            "tumors"\n                          ]\n                        }\n                      }\n                    }\n                  }\n                }\n              }\n            }\n          }\n        }\n      }\n    }\n  }\n}<|eot_id|>