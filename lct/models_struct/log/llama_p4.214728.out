rug": [\n                    "diuretics"\n                  ],\n                  "Drug-Name": [\n                    "diuretics"\n                  ]\n                },\n                "right": {\n                  "OR": {\n                    "left": {\n                      "raw_text": "cortisone",\n                      "Drug": [\n                        "cortisone"\n                      ],\n                      "Drug-Name": [\n                        "cortisone"\n                      ]\n                    },\n                    "right": {\n                      "raw_text": "or anti-seizure medication",\n                      "Drug": [\n                        "medication"\n                      ],\n                      "Drug-Name": [\n                        "medication"\n                      ],\n                      "Modifier": [\n                        "anti-seizure"\n                      ]\n                    }\n                  }\n                }\n              }\n            }\n          }\n        }\n      }\n    },\n    "right": {\n      "AND": {\n        "left": {\n          "raw_text": "- Taking regularly any nutritional supplements",\n          "Eq-Comparison": [\n            "Taking"\n          ],\n          "Drug": [\n            "nutritional supplements"\n          ],\n          "Eq-Temporal-Period": [\n            "Taking"\n          ],\n          "Drug-Name": [\n            "nutritional supplements"\n          ]\n        },\n        "right": {\n          "AND": {\n            "left": {\n              "raw_text": "and"\n            },\n            "right": {\n              "NOT": {\n                "left": {\n                  "AND": {\n                    "left": {\n                      "raw_text": "unwilling to stop for the study",\n                      "Eq-Operator": [\n                        "to"\n                      ],\n                      "Assertion": [\n                        "unwilling to"\n                      ],\n                      "Eq-Temporal-Unit": [\n                        "h"\n                      ],\n                      "Study": [\n                        "study"\n                      ]\n                    },\n                    "right": {\n                      "AND": {\n                        "left": {\n                          "raw_text": "- any subject who, in the judgment of the Investigator,",\n                          "Eq-Operator": [\n                            "-"\n                          ],\n                          "Assertion": [\n                            "will"\n                          ],\n                          "Study": [\n                            "Investigator"\n                          ]\n                        },\n                        "right": {\n                          "AND": {\n                            "left": {\n                              "raw_text": "will be unable to comply with the study protocol,",\n                              "Eq-Operator": [\n                                "-"\n                              ],\n                              "Assertion": [\n                                "will be unable to"\n                              ],\n                              "Study": [\n                                "study protocol",\n                                "study"\n                              ],\n                              "Eq-Temporal-Unit": [\n                                "h"\n                              ]\n                            },\n                            "right": {\n                              "raw_text": "or subjects who refuse to participate in the study.",\n                              "Eq-Temporal-Unit": [\n                                "h"\n                              ],\n                              "Study": [\n                                "study"\n                              ],\n                              "Eq-Operator": [\n                       