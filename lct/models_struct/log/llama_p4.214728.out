        "left": {
          "raw_text": "Crhon s disease however in activity",
          "Condition": [
            "Crhon s disease",
            "disease"
          ],
          "Eq-Comparison": [
            "in activity"
          ],
          "Eq-Temporal-Period": [
            "in activity"
          ],
          "Condition-Name": [
            "Crhon s disease"
          ]
        },
        "right": {
          "AND": {
            "left": {
              "raw_text": "or"
            },
            "right": {
              "raw_text": "in remission attending the the outpatient clinics and inpatient of gastroenterology units of Internal medicine department",
              "Eq-Comparison": [
                "in remission",
                "attending"
              ],
              "Eq-Temporal-Period": [
                "in remission",
                "attending"
              ],
              "Location": [
                "outpatient clinics",
                "inpatient"
              ],
              "Encounter": [
                "outpatient",
