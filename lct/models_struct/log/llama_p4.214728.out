emic problem. Refusal of participation Mentally ill or mentally retarded children\n\n### Response:\n{\n  "OR": {\n    "left": {\n      "raw_text": "- Children having allergy to local anaesthesia",\n      "Procedure": [\n        "local anaesthesia"\n      ],\n      "Procedure-Name": [\n        "local anaesthesia"\n      ],\n      "Allergy": [\n        "allergy"\n      ],\n      "Life-Stage-And-Gender": [\n        "Children"\n      ]\n    },\n    "right": {\n      "OR": {\n        "left": {\n          "raw_text": "or systemic problem. Refusal of participation Mentally ill",\n          "Condition": [\n            "Mentally ill",\n            "problem"\n          ],\n          "Condition-Name": [\n            "Mentally ill",\n            "problem"\n          ],\n          "Modifier": [\n            "systemic"\n          ]\n        },\n        "right": {\n          "raw_text": "or mentally retarded children",\n          "Life-Stage-And-Gender": [\n            "children"\n          ],\n          "Condition": [\n            "mentally retarded"\n          ],\n          "Condition-Name": [\n            "mentally retarded"\n          ]\n        }\n      }\n    }\n  }\n}<|eot_id|>']
