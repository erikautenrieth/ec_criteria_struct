          },\n                                    "right": {\n                                      "OR": {\n                                        "left": {\n                                          "raw_text": "lactation,",\n                                          "Condition": [\n                                            "lactation"\n                                          ],\n                                          "Condition-Name": [\n                                            "lactation"\n                                          ]\n                                        },\n                                        "right": {\n                                          "raw_text": "changes in birth control (within 6-mo)",\n                                          "Drug": [\n                                            "birth control"\n                                          ],\n                                          "Drug-Name": [\n                                              "birth control"\n                                            ],\n                                          "Stability": [\n                                              "changes"\n                                            ],\n                                          "Eq-Operator": [\n                                              "within"\n                                            ],\n                                          "Eq-Temporal-Unit": [\n                                              "mo"\n                                            ],\n                                          "Eq-Comparison": [\n                                              "within 6-mo"\n                                            ],\n                                          "Eq-Value": [\n                                              "6"\n                                            ]\n                                          }\n                                        }\n                                      }\n                                    }\n                                  }\n                                }\n                              }\n                            },\n                            "right": {\n                              "raw_text": "- Any gastrointestinal disorders",\n                              "Condition": [\n                                "gastrointestinal disorders"\n                              ],\n                              "Condition-Name": [\n                                "gastrointestinal disorders"\n                              ],\n                              "Eq-Operator": [\n                                "-"\n                              ]\n                            }\n                          }\n                        },\n                        "right": {\n                          "raw_text": "- Chronic diarrhea",\n                          "Acuteness": [\n                            "Chronic"\n                          ],\n                          "Condition": [\n                            "diarrhea"\n                          ],\n                          "Condition-Name": [\n                            "diarrhea"\n                          ],\n                          "Eq-Operator": [\n                            "-"\n                          ]\n                        }\n                      }\n                    },\n                    "right": {\n                      "raw_text": "- Smoker",\n                      "Eq-Operator": [\n                        "-"\n                      ],\n                      "Eq-Comparison": [\n                        "User"\n                      ],\n                      "Eq-Temporal-Period": [\n                        "User"\n                      ],\n                      "Modifier": [\n                        "Smoker"\n                      ]\n                    }\n                  }\n                },\n                "right": {\n                  "raw_text": "- Excess alcohol (>2 drinks/d)",\n                  "Eq-Operator": [\n                    ">"\n                  ],\n                  "Eq-Value": [\n                    "2"\n                  ],\n                  "Eq-Comparison": [\n                    ">2 drinks/d"\n                  ],\n                  "Drug": [\n                    "alcohol"\n                  ],\n                  "Drug-Name": [\n                    "alcohol"\n                  ],\n                  "Eq-Unit": [\n                    "drinks"\n                  ],\n                  "Eq-Operator": [\n                    "-"\n                  ],\n                  "Polarity": [\n                    "Excess"\n                  ],\n                  "Eq-Temporal-Unit": [\n                    "d"\n                  ]\n                }\n              }\n            },\n            "right": {\n              "raw_text": "- Excess aerobic exercise (>5 h/wk)",\n              "Eq-Operator": [\n                ">"\n              ],\n              "Eq-Value": [\n                "5"\n              ],\n              "Eq-Comparison": [\n                ">5 h/wk"\n              ],\n              "Eq-Temporal-Unit": [\n                "h",\n                "wk"\n              ],\n              "Eq-Unit": [\n                "h",\n                "wk"\n              ],\n              "Eq-Operator": [\n                "-"\n              ],\n              "Polarity": [\n                "Excess"\n              ],\n              "Eq-Unit": [\n                "h",\n                "wk"\n              ],\n              "Eq-Temporal-Unit": [\n                "h",\n                "wk"\n              ],\n              "Observation": [\n                "aerobic exercise"\n              ],\n              "Observation-Name": [\n                "aerobic exercise"\n              ]\n            }\n          }\n        },\n        "right": {\n          "OR": {\n            "left": {\n         