                                "Moderate"\n                                          ]\n                                        }\n                                      }\n                                    },\n                                    "right": {\n                                      "raw_text": "6. Persistent and uncontrolled hypertension (BP persistently >160/100 mmHg)",\n                                      "Condition": [\n                                        "hypertension"\n                                      ],\n                                      "Condition-Name": [\n                                        "hypertension"\n                                      ],\n                                      "Eq-Operator": [\n                                        ">"\n                                      ],\n                                      "Eq-Value": [\n                                        "6",\n                                        "160",\n                                        "100"\n                                      ],\n                                      "Eq-Comparison": [\n                                        ">160/100 mmHg"\n                                      ],\n                                      "Eq-Unit": [\n                                        "mmHg"\n                                      ],\n                                      "Observation": [\n                                        "BP"\n                                      ],\n                                      "Observation-Name": [\n                                        "BP"\n                                      ],\n                                      "Modifier": [\n                                        "Persistent and uncontrolled"\n                                      ]\n                                    }\n                                  }\n                                },\n                                "right": {\n                                  "raw_text": "7. Bleeding diathesis",\n                                  "Condition": [\n                                    "Bleeding diathesis"\n                                  ],\n                                  "Condition-Name": [\n                                    "Bleeding diathesis"\n                                  ]\n                                }\n                              }\n                            },\n                            "right": {\n                              "OR": {\n                                "left": {\n                                  "raw_text": "8. Active thrombophlebitis/",\n                                  "Condition": [\n                                    "thrombophlebitis"\n                                  ],\n                                  "Condition-Name": [\n                                    "thrombophlebitis"\n                                  ],\n                                  "Eq-Operator": [\n                                    "-"\n                                  ],\n                                  "Eq-Comparison": [\n                                    "Active"\n                                  ],\n                                  "Eq-Temporal-Period": [\n                                    "Active"\n                                  ]\n                                },\n                                "right": {\n                                  "raw_text": "venous disease of lower limbs",\n                                  "Condition": [\n                                    "venous disease",\n                                    "disease"\n                                  ],\n                                  "Condition-Name": [\n                                    "venous disease",\n                                    "disease"\n                                  ],\n                                  "Modifier": [\n                                    "lower limbs"\n                                  ]\n                                }\n                              }\n                            }\n                          }\n                        },\n                        "right": {\n                          "raw_text": "9. Severe lower extremity vaso-occlusive disease",\n                          "Condition": [\n                            "vaso-occlusive disease",\n                            "disease"\n                          ],\n                          "Condition-Name": [\n                            "vaso-occlusive disease",\n                            "disease"\n                          ],\n                          "Modifier": [\n                            "lower extremity"\n                          ],\n                          "Severity": [\n                            "Severe"\n                          ]\n                        }\n                      }\n                    },\n                    "right": {\n                      "raw_text": "10. Presence of a documented aortic aneurysm/ dissection requiring surgical repair",\n                      "Condition": [\n                        "aortic aneurysm",\n                        "dissection",\n                        "aneurysm"\n                      ],\n                      "Condition-Name": [\n                        "aortic aneurysm",\n                        "dissection",\n                        "aneurysm"\n                      ],\n                      "Procedure": [\n                        "surgical repair"\n                      ],\n                      "Procedure-Name": [\n                        "surgical repair"\n                      ],\n                      "Assertion": [\n                        "requiring"\n                      ]\n                    }\n                  }\n                },\n                "right": {\n                  "raw_text": "11. Pregnancy",\n                  "Condition": [\n               