                                             ]\n                                            }\n                                          }\n                                        }\n                                      }\n                                    }\n                                  }\n                                },\n                                "right": {\n                                  "raw_text": "2. malignancy or life-threatening illness with life expectancy of <5 years;",\n                                  "Eq-Operator": [\n                                    "<"\n                                  ],\n                                  "Eq-Temporal-Unit": [\n                                    "years",\n                                    "year"\n                                  ],\n                                  "Eq-Value": [\n                                    "5",\n                                    "2"\n                                  ],\n                                  "Condition": [\n                                    "malignancy",\n                                    "life-threatening illness"\n                                  ],\n                                  "Condition-Name": [\n                                    "malignancy",\n                                    "life-threatening illness"\n                                  ],\n                                  "Risk": [\n                                    "life-threatening"\n                                  ],\n                                  "Eq-Comparison": [\n                                    "<5 years"\n                                  ],\n                                  "Observation": [\n                                    "life expectancy"\n                                  ],\n                                  "Observation-Name": [\n                                    "life expectancy"\n                                  ],\n                                  "Assertion": [\n                                    "with"\n                                  ]\n                                }\n                              }\n                            },\n                            "right": {\n                              "OR": {\n                                "left": {\n                                  "raw_text": "3. end-stage disease",\n                                  "Condition": [\n                                    "end-stage disease"\n                                  ],\n                                  "Condition-Name": [\n                                    "end-stage disease"\n                                  ]\n                                },\n                                "right": {\n                                  "raw_text": "or serious illness that prohibits participation (e.g. end-stage renal disease or class IV congestive heart failure);",\n                                  "Condition": [\n                                    "congestive heart failure",\n                                    "end-stage renal disease"\n                                  ],\n                                  "Condition-Name": [\n                                    "congestive heart failure",\n                                    "end-stage renal disease"\n                                  ],\n                                  "Severity": [\n                                    "serious"\n                                  ],\n                                  "Assertion": [\n                                    "prohibits"\n                                  ],\n                                  "Modifier": [\n                                    "class IV"\n                                  ]\n                                }\n                              }\n                            }\n                          }\n                        },\n                        "right": {\n                        