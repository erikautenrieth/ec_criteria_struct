 handicap\n-  History of relevant drug and/or food allergies\n-  Regular/routine treatment with non-topical medications within 30 days prior to entry into the clinical research center\n-  Smoking within 60 days prior to drug administration and through the follow-up visit\n-  History of alcohol abuse or drug addiction (including soft drugs like cannabis products)\n\n### Response:\n{\n  "AND": {\n    "left": {\n      "AND": {\n        "left": {\n          "AND": {\n            "left": {\n              "AND": {\n                "left": {\n                  "AND": {\n                    "left": {\n                      "raw_text": "- Evidence of clinically relevant pathology",\n                      "Condition": [\n                        "pathology"\n                      ],\n                      "Condition-Name": [\n                        "pathology"\n                      ]\n                    },\n                    "right": {\n                      "raw_text": "- Mental handicap",\n                      "Condition": [\n                        "Mental handicap"\n                      ],\n                      "Condition-Name": [\n                        "Mental handicap"\n                      ]\n                    }\n                  }\n                },\n                "right": {\n                  "OR": {\n                    "left": {\n                      "raw_text": "- History of relevant drug",\n                      "Eq-Comparison": [\n                        "History"\n                      ],\n                      "Drug": [\n                        "drug"\n                      ],\n                      "Eq-Temporal-Period": [\n                        "History"\n                      ]\n                    },\n                    "right": {\n                      "raw_text": "and/or food allergies",\n                      "Condition": [\n                        "food allergies"\n                      ],\n                      "Condition-Name": [\n                        "food allergies"\n                      ],\n                      "Allergy": [\n                        "food allergies"\n                      ]\n                    }\n                  }\n                }\n              }\n            },\n            "right": {\n              "raw_text": "- Regular/routine treatment with non-topical medications within 30 days prior to entry into the clinical research center",\n              "Eq-Temporal-Unit": [\n                "days"\n              ],\n              "Procedure": [\n                "treatment"\n              ],\n              "Drug": [\n                "medications"\n              ],\n              "Eq-Value": [\n                "3",\n                "30"\n              ],\n              "Eq-Comparison": [\n                "within 30 days"\n              ],\n              "Study": [\n                "clinical research center"\n              ],\n              "Eq-Operator": [\n                "within"\n              ],\n              "Drug-Name": [\n                "non-topical medications"\n              ],\n              "Procedure-Name": [\n                "treatment"\n              ],\n              "Modifier": [\n                "topical"\n              ],\n              "Drug-Modifier": [\n                "topical"\n              ]\n            }\n          }\n        },\n        "right": {\n          "OR": {\n            "left": {\n              "raw_text": "- Smoking",\n              "Observation": [\n                "Smoking"\n              ],\n              "Observation-Name": [\n                "Smoking"\n              ]\n            },\n            "right": {\n              "raw_text": "within 60 days prior to drug administration and through the follow-up visit",\n              "Drug": [\n                "drug"\n              ],\n              "Eq-Comparison": [\n                "within 60 days"\n              ],\n              "Eq-Temporal-Unit": [\n                "days"\n              ],\n              "Eq-Value": [\n                "60"\n              ],\n              "Study": [\n                "administration"\n              ],\n              "Eq-Operator": [\n                "within"\n              ],\n              "Eq-Temporal-Period": [\n                "follow-up"\n              ]\n            }\n          }\n        }\n      }\n    },\n    "right": {\n      "OR": {\n        "left": {\n          "raw_text": "- History of alcohol abuse",\n          "Condition": [\n            "alcohol abuse"\n          ],\n          "Condition-Name": [\n            "alcohol abuse"\n          ],\n          "Eq-Comparison": [\n            "History"\n          ],\n          "Eq-Temporal-Period": [\n            "History"\n          ]\n        },\n        "right": {\n          "raw_text": "or drug addiction (including soft drugs like cannabis products)",\n          "Condition": [\n            "drug addiction"\n          ],\n          "Condition-Name": [\n            "drug addiction"\n          ],\n          "Drug": [\n            "soft drugs",\n            "cannabis products"\n          ],\n          "Drug-Name": [\n            "soft drugs",\n            "cannabis products"\n          ]\n        }\n      }\n    }\n  }\n}<|eot_id|>']
