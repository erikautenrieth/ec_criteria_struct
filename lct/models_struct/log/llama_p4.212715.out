osteoarthritis performed by Dr. Rick Wright.\n-  Primary diagnosis of knee osteoarthritis\n-\n\n### Response:\n{\n  "AND": {\n    "left": {\n      "AND": {\n        "left": {\n          "AND": {\n            "left": {\n              "raw_text": "- Age over 18",\n              "Age": [\n                "Age"\n              ],\n              "Eq-Comparison": [\n                "over 18"\n              ],\n              "Eq-Operator": [\n                "over"\n              ],\n              "Eq-Value": [\n                "18"\n              ],\n              "Eq-Temporal-Unit": [\n                "h"\n              ]\n            },\n            "right": {\n              "raw_text": "- Total knee arthroplasty for primary osteoarthritis performed by Dr. Rick Wright.",\n              "Condition": [\n                "osteoarthritis",\n                "knee arthroplasty"\n              ],\n              "Condition-Name": [\n                "osteoarthritis",\n                "knee arthroplasty"\n              ],\n              "Modifier": [\n                "primary",\n                "Total knee",\n                "primary osteoarthritis"\n              ],\n              "Procedure": [\n                "knee arthroplasty"\n              ],\n              "Procedure-Name": [\n                "knee arthroplasty"\n              ]\n            }\n          }\n        },\n        "right": {\n          "raw_text": "- Primary diagnosis of knee osteoarthritis",\n          "Condition": [\n            "osteoarthritis"\n          ],\n          "Condition-Name": [\n            "osteoarthritis"\n          ],\n          "Modifier": [\n            "knee",\n            "primary",\n            "Primary"\n          ],\n          "Eq-Temporal-Unit": [\n            "h"\n          ]\n        }\n      }\n    },\n    "right": {\n      "raw_text": "-"\n    }\n  }\n}<|eot_id|>']
