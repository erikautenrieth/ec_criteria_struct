                           "Condition": [\n                                                                        "lesions"\n                                                                      ],\n                                                                      "Condition-Name": [\n                                                                        "lesions"\n                                                                      ],\n                                                                      "Modifier": [\n                                                                        "Multifocal",\n                                                                        "contrast enhancing"\n                                                                      ]\n                                                                    }\n                                                                  }\n                                                                },\n                                                                "right": {\n                                                                  "raw_text": "3. Substantial non-contrast enhancing tumor areas suggesting low grade gliomas with malignant transformation",\n                                                                  "Condition": [\n                                                                    "tumor",\n                                                                    "gliomas"\n                                                                  ],\n                                                                  "Condition-Name": [\n                                                                    "tumor",\n                                                                    "gliomas"\n                                                                  ],\n                                                                  "Modifier": [\n                                  