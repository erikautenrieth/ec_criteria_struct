                  "Condition": [
                    "Pregnant"
                  ],
                  "Condition-Name": [
                    "Pregnant"
                  ],
                  "Life-Stage-And-Gender": [
                    "women"
                  ],
                  "Eq-Operator": [
                    "-"
                  ]
                },
                "right": {
                  "raw_text": "or nursing mothers",
                  "Condition": [
