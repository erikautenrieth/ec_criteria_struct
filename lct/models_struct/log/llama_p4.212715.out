-Name": [\n                "Cognitive impairment"\n              ]\n            }\n          }\n        },\n        "right": {\n          "OR": {\n            "left": {\n              "raw_text": "4. Other neurological",\n              "Other": [\n                "Other"\n              ],\n              "Condition": [\n                "neurological"\n              ],\n              "Condition-Name": [\n                "neurological"\n              ],\n              "Eq-Unit": [\n                "mm"\n              ]\n            },\n            "right": {\n              "raw_text": "or muscular disorders",\n              "Condition": [\n                "disorders"\n              ],\n              "Condition-Name": [\n                "disorders"\n              ],\n              "Modifier": [\n                "muscular"\n              ],\n              "Eq-Unit": [\n                "mm"\n              ]\n            }\n          }\n        }\n      }\n    },\n    "right": {\n      "raw_text": "5. Sever pain could not tolerate examination",\n      "Observation": [\n        "examination"\n      ],\n      "Observation-Name": [\n        "examination"\n      ],\n      "Assertion": [\n        "could"\n      ],\n      "Severity": [\n        "Sever"\n      ],\n      "Condition": [\n        "pain"\n      ],\n      "Condition-Name": [\n        "pain"\n      ]\n    }\n  }\n}<|eot_id|>']
