n          "Study": [\n            "study"\n          ],\n          "Condition": [\n            "Unable to refrain"\n          ],\n          "Condition-Name": [\n            "Unable to refrain"\n          ]\n        },\n        "right": {\n          "raw_text": ""\n        }\n      }\n    }\n  }\n}<|eot_id|>']
