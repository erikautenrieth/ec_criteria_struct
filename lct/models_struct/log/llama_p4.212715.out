      ],
      "Eq-Unit": [
        "cores",
        "mm"
      ],
      "Eq-Operator": [
        "over",
        "more than"
      ],
      "Coreference": [
        "tissue"
      ],
      "Modifier": [
        "kidney tissues",
        "glomerulus"
      ]
    }
  }
}
