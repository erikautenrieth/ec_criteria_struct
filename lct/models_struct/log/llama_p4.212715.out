                                 "Condition": [\n                                                "Angina"\n                                              ],\n                                              "Condition-Name": [\n                                                "Angina"\n                                              ],\n                                              "Eq-Temporal-Unit": [\n                                                "months"\n                                              ],\n                                              "Eq-Value": [\n                                                "6"\n                                              ],\n                                              "Eq-Comparison": [\n                                                "6 months"\n                                              ]\n                                            }\n                                          }\n                                        },\n                                        "right": {\n                                          "raw_text": "- Myocardial infarction within 6 months",\n                                          "Condition": [\n                                            "Myocardial infarction"\n                                          ],\n                                          "Condition-Name": [\n                                            "Myocardial infarction"\n                                          ],\n                                          "Eq-Temporal-Unit": [\n                                            "months"\n                                          ],\n                                          "Eq-Operator": [\n                                            "within"\n                                          ],\n                                          "Eq-Value": [\n                                            "6"\n                                          ],\n                                          "Eq-Comparison": [\n                                            "within 6 months"\n                                          ]\n                                        }\n                                      }\n                                    },\n                                    "right": {\n                                      "raw_text": "- Peripheral artery disease within 6 months",\n                                      "Condition": [\n                                        "Peripheral artery disease"\n                                      ],\n                                      "Condition-Name": [\n                                        "Peripheral artery disease"\n                                      ],\n                                      "Eq-Temporal-Unit": [\n                                        "months"\n                                      ],\n                                      "Eq-Operator": [\n                                        "within"\n                                      ],\n                                      "Eq-Value": [\n                                        "6"\n                                      ],\n                                      "Eq-Comparison": [\n                                        "within 6 months"\n                                      ]\n                                    }\n                                  }\n                                },\n                                "right": {\n                                  "OR": {\n                                    "left": {\n                                      "raw_text": "- Significant arrhythmia (i.e. ventricular tachycardia",\n                                      "Condition": [\n                                        "arrhythmia",\n                                        "ventricular tachycardia"\n                                      ],\n                                      "Condition-Name": [\n                                