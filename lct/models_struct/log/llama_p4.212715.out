ascular events",\n                                                        "ECG changes"\n                                                      ],\n                                                      "Stability": [\n                                                        "unstable"\n                                                      ]\n                                                    },\n                                                    "right": {\n                                                      "OR": {\n                                                        "left": {\n                                                          "raw_text": "unstable angina,",\n                                                          "Condition": [\n                                                            "angina"\n                                                          ],\n                                                          "Eq-Operator": [\n                                                            "to"\n                                                          ],\n                                                          "Condition-Name": [\n                                                            "angina"\n                                                          ],\n                                                          "Stability": [\n                                                            "unstable"\n                                                          ]\n                                                        },\n                                                        "right": {\n                                                          "OR": {\n                                                            "left": {\n                                                              "raw_text": "uncontrolled arrhythmia,",\n                                                              "Condition": [\n                                          