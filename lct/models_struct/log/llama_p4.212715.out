cted"\n                              ]\n                            },\n                            "right": {\n                              "OR": {\n                                "left": {\n                                  "raw_text": "or who did",\n                                  "Eq-Operator": [\n                                    "to"\n                                  ]\n                                },\n                                "right": {\n                                  "AND": {\n                                    "left": {\n                                      "raw_text": "not come to control, cardiac",\n                                      "Procedure": [\n                                        "control"\n                                      ],\n                                      "Procedure-Name": [\n                                        "control"\n                                      ],\n                                      "Modifier": [\n                                        "cardiac"\n                                      ],\n                                      "Negation": [\n                                        "not"\n                                      ]\n                                    },\n                                    "right": {\n                                      "raw_text": "and cerebrovascular event,",\n                                      "Condition": [\n                                        "cerebrovascular"\n                                      ],\n                                      "Condition-Name": [\n                                        "cerebrovascular"\n                                      ],\n                                      "Modifier": [\n                                        "event"\n                                      ]\n                                    }\n                                  }\n                                }\n                              }\n                            }\n                          }\n                        }\n                      }\n                    },\n                    "right": {\n                      "OR": {\n                        "left": {\n                          "raw_text": "- Endocrine disorder,",\n                          "Condition": [\n                            "Endocrine disorder"\n                          ],\n                          "Condition-Name": [\n                            "Endocrine disorder"\n                          ]\n                        },\n                        "right": {\n                          "OR": {\n                            "left": {\n                              "raw_text": "fluid-electrolyte imbalance",\n                              "Condition": [\n                                "fluid-electrolyte imbalance"\n                              ],\n                              "Condition-Name": [\n                                "fluid-electrolyte imbalance"\n                              ]\n                            },\n                            "right": {\n                              "raw_text": "and infection",\n                              "Condition": [\n                                "infection"\n                              ],\n                              "Condition-Name": [\n                                "infection"\n                              ]\n                            }\n                          }\n                        }\n                      }\n                    }\n                  }\n                },\n                "right": {\n                  "OR": {\n                    "left": {\n                      "raw_text": "- Patients with malignancy",\n                      "Condition": [\n                        "malignancy"\n                      ],\n                      "Condition-Name": [\n                        "malignancy"\n                      ]\n                    },\n                    "right": {\n                      "OR": {\n                        "left": {\n                          "raw_text": "and malignancy, chemotherapy",\n                          "Condition": [\n                            "malignancy"\n                          ],\n                          "Procedure": [\n                            "chemotherapy"\n                          ],\n                          "Condition-Name": [\n                            "malignancy"\n                          ],\n                          "Procedure-Name": [\n                            "chemotherapy"\n                          ]\n                        },\n                        "right": {\n                          "raw_text": "and radiotherapy,",\n                          "Procedure": [\n                            "radiotherapy"\n                          ],\n                          "Procedure-Name": [\n                            "radiotherapy"\n                          ]\n                        }\n                      }\n                    }\n                  }\n                }\n              }\n            },\n            "right": {\n              "OR": {\n                "left": {\n                  "raw_text": "- Patients with delirium",\n                  "Condition": [\n                    "delirium"\n                  ],\n                  "Condition-Name": [\n                    "delirium"\n                  ]\n                },\n                "right": {\n                  "raw_text": "or depression",\n                  "Condition": [\n                    "depression"\n                  ],\n                  "Condition-Name": [\n                    "depression"\n                  ]\n                }\n              }\n            }\n          }\n        },\n        "right": {\n          "AND": {\n            "left": {\n              "raw_text": "- Those",\n              "Eq-Operator": [\n                "to"\n              ]\n            },\n            "right": {\n              "AND": {\n                "left": {\n                  "raw_text": "with protective sensation loss (those with Semmes-Weinstein Monofilament Thickness 4.56",\n                  "Condition": [\n                    "protective sensation loss",\n                    "protective sensation"\n                  ],\n                  "Observation": [\n                    "Semmes-Weinstein Monofilament Thickness"\n                  ],\n                  "Condition-Name": [\n                    "protective sensation loss",\n                    "protective sensation"\n                  ],\n                  "Eq-Value": [\n                    "4.56"\n                  ],\n                  "Observation-Name": [\n                    "Semmes-Weinstein Monofilament Thickness"\n                  ],\n                  "Eq-Comparison": [\n                    "4.56"\n                  ]\n                },\n                "right": {\n                  "raw_text": "and above)",\n                  "Eq-Operator": [\n                    "to",\n                    "and above"\n                  ],\n                  "Eq-Comparison": [\n                    "and above"\n                  ]\n                }\n              }\n            }\n          }\n        }\n      }\n    },\n    "right": {\n      "OR": {\n        "left": {\n          "raw_text": "- patients with lower",\n          "Modifier": [\n            "lower"\n          ],\n          "Eq-Operator": [\n            "to"\n          ]\n        },\n        "right": {\n          "raw_text": "or upper extremity amputations at any level",\n          "Condition": [\n            "upper extremity amputations"\n          ],\n          "Condition-Name": [\n            "upper extremity amputations"\n          ],\n          "Eq-Operator": [\n            "to"\n          ]\n        }\n      }\n    }\n  }\n}<|eot_id|>']
