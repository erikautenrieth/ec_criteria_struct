on-making capacity;",\n                      "Condition": [\n                        "limited decision-making capacity"\n                      ],\n                      "Condition-Name": [\n                        "limited decision-making capacity"\n                      ]\n                    }\n                  }\n                }\n              }\n            },\n            "right": {\n              "OR": {\n                "left": {\n                  "raw_text": "7. alcohol",\n                  "Eq-Value": [\n                    "7"\n                  ],\n                  "Modifier": [\n                    "alcohol"\n                  ]\n                },\n                "right": {\n                  "raw_text": "or substance abuse;",\n                  "Condition": [\n                    "substance abuse"\n                  ],\n                  "Condition-Name": [\n                    "substance abuse"\n                  ],\n                  "Modifier": [\n                    "alcohol"\n                  ]\n                }\n              }\n            }\n          }\n        },\n        "right": {\n          "OR": {\n            "left": {\n              "raw_text": "8. homelessness",\n              "Condition": [\n                "homelessness"\n              ],\n              "Condition-Name": [\n                "homelessness"\n              ]\n            },\n            "right": {\n              "raw_text": "or no fixed address.",\n              "Condition": [\n                "no fixed address"\n              ],\n              "Condition-Name": [\n                "no fixed address"\n              ]\n            }\n          }\n        }\n      }\n    }\n  }\n}<|eot_id|>']
