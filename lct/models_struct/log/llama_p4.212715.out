ndition": [\n                                                        "lactation"\n                                                      ],\n                                                      "Condition-Name": [\n                                                        "lactation"\n                                                      ]\n                                                    },\n                                                    "right": {\n                                                      "AND": {\n                                                        "left": {\n                                                          "raw_text": "changes in birth control (within 6-mo)",\n                                                          "Procedure": [\n                                                            "birth control"\n                                                          ],\n                                                          "Procedure-Name": [\n                                                            "birth control"\n                                                          ],\n                                                          "Eq-Unit": [\n                                                            "kg"\n                                                          ],\n                                                          "Eq-Comparison": [\n                                                            "within 6-mo"\n                                                          ],\n                                                          "Stability": [\n                                                            "changes"\n                                                          ],\n                                                          "Eq-Value": [\n                                                            "6"\n                                                          ],\n                                          