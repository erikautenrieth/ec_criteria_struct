riteria for nicotine dependence\n-  Negative result on urine test for drug use during screening\n\n### Response:\n{\n  "AND": {\n    "left": {\n      "AND": {\n        "left": {\n          "raw_text": "- Treatment-seeking cigarette smoker",\n          "Condition": [\n            "smoker"\n          ],\n          "Condition-Name": [\n            "smoker"\n          ],\n          "Assertion": [\n            "seeking"\n          ],\n          "Procedure": [\n            "Treatment"\n          ]\n        },\n        "right": {\n          "raw_text": "- Meet DSM-IV criteria for nicotine dependence",\n          "Condition": [\n            "nicotine dependence"\n          ],\n          "Condition-Name": [\n            "nicotine dependence"\n          ]\n        }\n      }\n    },\n    "right": {\n      "raw_text": "- Negative result on urine test for drug use during screening",\n      "Eq-Operator": [\n        "-"\n      ],\n      "Observation": [\n        "urine test",\n        "drug use"\n      ],\n      "Observation-Name": [\n        "urine test",\n        "drug use"\n      ],\n      "Polarity": [\n        "Negative"\n      ],\n      "Study": [\n        "screening"\n      ]\n    }\n  }\n}<|eot_id|>']
