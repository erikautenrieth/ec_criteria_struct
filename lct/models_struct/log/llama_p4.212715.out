n-Name": [\n                                        "Diabetic"\n                                      ]\n                                    }\n                                  }\n                                },\n                                "right": {\n                                  "raw_text": "- Have renal failure",\n                                  "Condition": [\n                                    "renal failure"\n                                  ],\n                                  "Condition-Name": [\n                                    "renal failure"\n                                  ]\n                                }\n                              }\n                            },\n                            "right": {\n                              "raw_text": "- Have liver failure",\n                              "Condition": [\n                                "liver failure"\n                              ],\n                              "Condition-Name": [\n                                "liver failure"\n                              ]\n                            }\n                          }\n                        },\n                        "right": {\n                          "OR": {\n                            "left": {\n                              "raw_text": "- Have cardiovascular events (myocardial infarction",\n                              "Condition": [\n                                "cardiovascular events",\n                                "myocardial infarction"\n                              ],\n                              "Condition-Name": [\n                                "cardiovascular events",\n                                "myocardial infarction"\n                              ],\n                              "Eq-Operator": [\n                                ">"\n                              ]\n                            },\n                            "right": {\n                              "r