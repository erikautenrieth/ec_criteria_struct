a",\n                        "dysarthria"\n                      ]\n                    },\n                    "right": {\n                      "OR": {\n                        "left": {\n                          "raw_text": "and pregnant",\n                          "Condition": [\n                            "pregnant"\n                          ],\n                          "Condition-Name": [\n                            "pregnant"\n                          ]\n                        },\n                        "right": {\n                          "raw_text": "or lactating women,",\n                          "Condition": [\n                            "lactating"\n                          ],\n                          "Condition-Name": [\n                            "lactating"\n                          ]\n                        }\n                      }\n                    }\n                  }\n                }\n              }\n            }\n          }\n        },\n        "right": {\n          "OR": {\n            "left": {\n              "raw_text": "- a previous history of neurological illness including AD",\n              "Condition": [\n                "neurological illness",\n                "AD"\n              ],\n              "Condition-Name": [\n                "neurological illness",\n                "AD"\n              ],\n              "Eq-Comparison": [\n                "previous history",\n                "previous"\n              ],\n              "Eq-Temporal-Period": [\n                "previous history",\n                "previous"\n              ]\n            },\n            "right": {\n              "raw_text": "and PD，",\n              "Condition": [\n                "PD"\n              ],\n              "Condition-Name": [\n                "PD"\n              ]\n            }\n          }\n        }\n      }\n    },\n    "right": {\n      "raw_text": "- Inflammatory bowel disease，",\n      "Condition": [\n        "Inflamm