pture, vitreous loss, zonular dialysis, or iris trauma.",\n                                              "Condition": [\n                                                "posterior capsular rupture",\n                                                "vitreous loss",\n                                                "zonular dialysis",\n                                                "iris trauma"\n                                              ],\n                                              "Condition-Name": [\n                                                "posterior capsular rupture",\n                                                "vitreous loss",\n                                                "zonular dialysis",\n                                                "iris trauma"\n                                              ],\n                                              "Procedure": [\n                                                "surgery"\n                                              ],\n                                              "Procedure-Name": [\n                                                "surgery"\n                                              ],\n                                              "Modifier": [\n                                                "Complications"\n                                              ]\n                                            }\n                                          }\n                                        }\n                                      }\n                                    }\n                                  }\n                                },\n                                "right": {\n                                  "raw_text": "- Macular thickness above 300 microns at baseline",\n                                  "Eq-Operator": [\n                                    "above"\n                                  ],\n                                  "Eq-Unit": [\n                                    "microns"\n                                  ],\n                                  "Eq-Value": [\n                                    "300"\n                                  ],\n                                  "Eq-Comparison": [\n                                    "above 300 microns",\n                                    "baseline"\n                                  ],\n                                  "Observation": [\n                                    "Macular thickness"\n                                  ],\n                                  "Observation-Name": [\n                                    "Macular thickness"\n                                  ],\n                                  "Eq-Temporal-Recency": [\n                                    "baseline"\n                                  ]\n                                }\n                              }\n                            },\n                            "right": {\n                              "raw_text": "- Currently taking a prostaglandin analogue",\n                              "Eq-Comparison": [\n                                "Currently"\n                              ],\n                              "Drug": [\n                                "prostaglandin analogue"\n                              ],\n                              "Drug-Name": [\n                                "prostaglandin analogue"\n                              ],\n                              "Eq-Operator": [\n                                "to"\n                              ],\n                              "Eq-Temporal-Period": [\n                                "Currently"\n                              ]\n                            }\n                          }\n                        },\n                        "right": {\n                          "raw_text": "- Presence of an epiretinal membrane on the preoperative OCT.",\n                          "Procedure": [\n           