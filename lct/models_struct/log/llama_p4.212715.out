tion treatment history.\n\n### Response:\n{\n  "raw_text": "- Cases received inferior vena filter and anti-coagulation treatment history.",\n  "Procedure": [\n    "vena filter",\n    "anti-coagulation treatment"\n  ],\n  "Procedure-Name": [\n    "vena filter",\n    "anti-coagulation treatment"\n  ],\n  "Eq-Comparison": [\n    "received"\n  ],\n  "Eq-Temporal-Period": [\n    "received"\n  ]\n}<|eot_id|>']
