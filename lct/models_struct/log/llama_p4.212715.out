e": [\n                        "Maximum anchorage",\n                        "mini-implant"\n                      ]\n                    }\n                  }\n                },\n                "right": {\n                  "raw_text": "- No systemic disease.",\n                  "Negation": [\n                    "No"\n                  ],\n                  "Condition": [\n                    "disease"\n                  ],\n                  "Condition-Name": [\n                    "disease"\n                  ],\n                  "Modifier": [\n                    "systemic"\n                  ]\n                }\n              }\n            },\n            "right": {\n              "raw_text": "- Good oral hygiene.",\n              "Condition": [\n                "Good oral hygiene"\n              ],\n              "Condition-Name": [\n                "Good oral hygiene"\n              ]\n            }\n          }\n        },\n        "right": {\n          "AND": {\n            "left": {\n              "raw_text": "-"\n            },\n            "right": {\n              "NOT": {\n                "left": {\n                  "raw_text": "No periodontal disease.",\n                  "Negation": [\n                    "No"\n                  ],\n                  "Condition": [\n                    "periodontal disease"\n                  ],\n                  "Condition-Name": [\n                    "periodontal disease"\n                  ]\n                }\n              }\n            }\n          }\n        }\n      }\n    },\n    "right": {\n      "raw_text": "- Molar relationship either Class I, < ½ unit Class II or Class III.",\n      "Eq-Operator": [\n        "<",\n        "unit"\n      ],\n      "Eq-Value": [\n        "I",\n        "II",\n        "III",\n        "½"\n      ],\n      "Eq-Comparison": [\n        "< ½ unit"\n      ],\n      "Eq-Unit": [\n        "unit"\n      ],\n      "Condition": [\n        "Molar relationship"\n      ],\n    