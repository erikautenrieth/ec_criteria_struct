                        ],\n                                      "Eq-Temporal-Period": [\n                                        "already engaged"\n                                      ]\n                                    }\n                                  }\n                                },\n                                "right": {\n                                  "OR": {\n                                    "left": {\n                                      "raw_text": "- Subject with a perceptual disorder (AMD,",\n                                      "Condition": [\n                                        "perceptual disorder",\n                                        "AMD"\n                                      ],\n                                      "Condition-Name": [\n                                        "perceptual disorder",\n                                        "AMD"\n                                      ]\n                                    },\n                                    "right": {\n                                      "raw_text": "deafness...)",\n                                      "Condition": [\n                                        "deafness"\n                                      ],\n                                      "Condition-Name": [\n                                        "deafness"\n                                      ]\n                                    }\n                                  }\n                                }\n                              }\n                            },\n                            "right": {\n                              "raw_text": "- Subject with a motor disability",\n                              "Condition": [\n                                "motor disability"\n                              ],\n                              "Condition-Name": [\n                                "motor disability"\n                              ]\n                            }