     "OR": {\n                        "left": {\n                          "raw_text": "- Allergies to local anesthetics,",\n                          "Allergy": [\n                            "Allergies"\n                          ],\n                          "Drug": [\n                            "local anesthetics"\n                          ],\n                          "Drug-Name": [\n                            "local anesthetics"\n                          ]\n                        },\n                        "right": {\n                          "OR": {\n                            "left": {\n                              "raw_text": "analgesics",\n                              "Drug": [\n                                "analgesics"\n                              ],\n                              "Drug-Name": [\n                                "analgesics"\n                              ]\n                            },\n                            "right": {\n                              "raw_text": "or any medication used in the study.",\n                              "Drug": [\n                                "medication"\n                              ],\n                              "Study": [\n                                "study"\n                              ],\n                              "Eq-Comparison": [\n                                "used"\n                              ],\n                              "Eq-Temporal-Period": [\n                                "used"\n                              ]\n                            }\n                          }\n                        }\n                      }\n                    }\n                  }\n                },\n                "right": {\n                  "raw_text": "- Patients with chronic regular opioid usage",\n                  "Drug": [\n                    "opioid"\n                  ],\n                  "Drug-Name": [\n                    "opioid"\n              