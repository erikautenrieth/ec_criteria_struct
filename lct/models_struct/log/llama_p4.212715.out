on": [\n                                            "ALSFRS-R"\n                                          ],\n                                          "Observation-Name": [\n                                            "ALSFRS-R"\n                                          ]\n                                        }\n                                      }\n                                    }\n                                  }\n                                },\n                                "right": {\n                                  "raw_text": "4. continuous internet access at home,",\n                                  "Eq-Value": [\n                                    "4"\n                                  ],\n                                  "Eq-Operator": [\n                                    "score"\n                                  ],\n                                  "Eq-Comparison": [\n                                    "score of 2"\n                                  ],\n                                  "Observation": [\n                                    "score"\n                                  ],\n                                  "Eq-Unit": [\n                                    "g"\n                                  ],\n                                  "Eq-Temporal-Unit": [\n                                    "min"\n                                  ],\n                                  "Observation-Name": [\n                                    "score"\n                                  ]\n                                }\n                              }\n                            },\n                            "right": {\n                              "AND": {\n                                "left": {\n                                  "raw_text": "5."\n                                },\n                                "right": {\n                                  "NOT": {\n                                    "left": {\n                                      "OR": {\n                                        "left": {\n                                          "raw_text": "willingness",\n                                          "Assertion": [\n                                            "willingness"\n                                          ]\n                                        },\n                                        "right": {\n                                          "AND": {\n                                            "left": {\n                                              "raw_text": "and medical ability to comply with scheduled visits",\n                                              "Eq-Operator": [\n                                                "score"\n                                              ],\n                                              "Encounter": [\n                                                "visits"\n                                              ],\n                                              "Assertion": [\n                                                "ability to"\n                                              ],\n                                              "Eq-Temporal-Unit": [\n                                                "min"\n                                              ],\n                                              "Eq-Unit": [\n                                                "g"\n                                              ]\n                                            },\n                                            "right": {\n                                              "NOT": {\n                                                "left": {\n                                                  "raw_text": "and study procedures,",\n                                                  "Procedure": [\n                                                    "procedures"\n                                                  ],\n              