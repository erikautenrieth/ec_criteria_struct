                                "Bleed"\n                                                  ],\n                                                  "Condition-Name": [\n                                                    "Bleed"\n                                                  ],\n                                                  "Eq-Comparison": [\n                                                    "Active"\n                                                  ],\n                                                  "Eq-Temporal-Period": [\n                                                    "Active"\n                                                  ],\n                                                  "Modifier": [\n                                                    "Mucosal"\n                                                  ]\n                                                },\n                                                "right": {\n                                                  "raw_text": "or variceal)",\n                                                  "Condition": [\n                                                    "variceal"\n                                                  ],\n                                                  "Condition-Name": [\n                                                    "variceal"\n                                                  ],\n                                                  "Modifier": [\n                                                    "variceal"\n                                                  ]\n                                                }\n                                              }\n                                            }\n                                          }\n                                        },\n                                        "right": {\n                                          "raw_text": "- Pregnancy",\n                                          "Condition": [\