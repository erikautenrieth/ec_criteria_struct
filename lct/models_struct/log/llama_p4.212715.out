-Name": [\n                                        "altered cognitive status"\n                                      ]\n                                    },\n                                    "right": {\n                                      "OR": {\n                                        "left": {\n                                          "raw_text": "- history of head injury,",\n                                          "Observation": [\n                                            "head injury"\n                                          ],\n                                          "Observation-Name": [\n                                            "head injury"\n                                          ],\n                                          "Eq-Operator": [\n                                            "-"\n                                          ],\n                                          "Eq-Comparison": [\n                                            "history"\n                                          ],\n                                          "Eq-Temporal-Period": [\n                                            "history"\n                                          ]\n                                        },\n                                        "right": {\n                                          "OR": {\n                                            "left": {\n                                              "raw_text": "metal in the skull,",\n                                              "Observation": [\n                                                "metal in the skull"\n                                              ],\n                                              "Observation-Name": [\n                                                "metal in the skull"\n                                              ]\n                                            },\n                                            "right": {\n                              