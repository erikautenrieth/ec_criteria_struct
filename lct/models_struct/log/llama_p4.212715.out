       }\n                                                  }\n                                                },\n                                                "right": {\n                                                  "raw_text": "6. Psychiatric history",\n                                                  "Condition": [\n                                                    "Psychiatric"\n                                                  ],\n                                                  "Condition-Name": [\n                                                    "Psychiatric"\n                                                  ],\n                                                  "Eq-Comparison": [\n                                                    "history"\n                                                  ],\n                                                  "Eq-Temporal-Period": [\n                                                    "history"\n                                                  ]\n                                                }\n                                              }\n                                            },\n                                            "right": {\n                                              "raw_text": "7. Previous brain tumour surgery",\n                                              "Condition": [\n                                                "tumour"\n                                              ],\n                                              "Condition-Name": [\n                                                "tumour"\n                                              ],\n                                              "Procedure": [\n                                                "surgery"\n                                              ],\n                                              "Procedure-Name": [\n                                                "surgery"\n                                      