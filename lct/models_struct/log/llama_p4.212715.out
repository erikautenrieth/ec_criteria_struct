              ],
              "Eq-Comparison": [
                "≥ 18 years"
              ],
              "Eq-Operator": [
                "-",
                "≥"
              ],
              "Eq-Value": [
                "18"
              ],
              "Eq-Temporal-Unit": [
                "years"
              ]
            }
          }
        },
        "right": {
          "raw_text": "- Ability to understand the study information and information on usage of personal data",
          "Study": [
            "study"
          ],
          "Eq-Operator": [
            "-"
          ],
          "Assertion": [
            "Ability to"
          ]
