ils.\n- all entities: \'Contraindication\', \'Eq-Value\', \'Severity\', \'Drug\', \'Observation-Name\', \'Age\', \'Location\', \'Organism-Name\', \'Encounter\', \'Drug-Name\', \'Ethnicity\', \'Modifier\', \'Condition\', \'Eq-Unit\', \'Eq-Temporal-Unit\', \'Family-Member\', \'Organism\', \'Other\', \'Immunization-Name\', \'Polarity\', \'Condition-Type\', \'Immunization\', \'Eq-Operator\', \'Eq-Temporal-Recency\', \'Procedure-Name\', \'Indication\', \'Exception\', \'Study\', \'Language\', \'Coreference\', \'Provider\', \'Acuteness\', \'Life-Stage-And-Gender\', \'Procedure\', \'Risk\', \'Death\', \'Assertion\', \'Allergy-Name\', \'Specimen\', \'Negation\', \'Code\', \'Stability\', \'Birth\', \'Criteria-Count\', \'Eq-Comparison\', \'Condition-Name\', \'Insurance\', \'Observation\', \'Allergy\', \'Eq-Temporal-Period\'\n- the lists for the entity\'s should only be appended if one or more entities have been found. Otherwise, omit the arrays completely.\n\n5. The JSON object should be containing the following rules:\n- Ensure that the same logical operator ("AND", "OR", "NOT") does not appear on the same level of the tree structure to maintain the integrity of the logical relationships.\n- Generates JSON files from the textual criteria and organizing them into the described logical structure.\n- Setting the brackets {}, [] and commas, correctly in the JSON is extremely important.\n- Any double quotes within the raw textual criteria are escaped with a backslash (\\").\n- If there are no restrictions, return an empty JSON FILE {}\n- The entire text of the eligibility criteria must be included and separated by the logical operators, without omitting any words or information.\n- The output should only contain the JSON object, without any additional text or formatting.\n- Ensure that the JSON output strictly follows these rules and accurately represents the logical structure of the input eligibility criteria.\n\n### Input:\n1. History of presence of hepatobiliary, renal, cardiovascular, endocrine, respiratory, gastrointestinal, hematological, neurologic, psychiatric or musculoskeletal disorders affecting absorption, distribution, metabolism and excretion of the drug\n2. Genetic problems such as galactose intolerance, Lapp lactose deficiency or glucose-galactose malabsorption\n3. Those who are deemed unfit by the investigators to participate in the clinical trial for other reasons including the results of laboratory tests\n\n### Response:\n{\n  "AND": {\n    "left": {\n      "AND": {\n        "left": {\n          "OR": {\n            "left": {\n              "raw_text": "1. History of presence of hepatobiliary,",\n              "Eq-Value": [\n                "1"\n              ],\n              "Condition": [\n                "hepatobiliary"\n              ],\n              "Condition-Name": [\n                "hepatobiliary"\n              ],\n              "Eq-Comparison": [\n                "History"\n              ],\n              "Eq-Temporal-Period": [\n                "History"\n              ]\n            },\n            "right": {\n              "OR": {\n                "left": {\n                  "raw_text": "renal,",\n                  "Condition": [\n                    "renal"\n                  ],\n                  "Condition-Name": [\n                    "renal"\n                  ]\n                },\n                "right": {\n                  "OR": {\n                    "left": {\n                      "raw_text": "cardiovascular,",\n                      "Condition": [\n                        "cardiovascular"\n                      ],\n                      "Condition-Name": [\n                        "cardiovascular"\n                      ]\n                    },\n                    "right": {\n                      "OR": {\n                        "left": {\n                          "raw_text": "endocrine,",\n                          "Condition": [\n                            "endocrine"\n                          ],\n                          "Condition-Name": [\n                            "endocrine"\n                          ]\n                        },\n                        "right": {\n                          "OR": {\n                            "left": {\n                              "raw_text": "respiratory,",\n                              "Condition": [\n                                "respiratory"\n                              ],\n                              "Condition-Name": [\n                                "respiratory"\n                              ]\n                            },\n                            "right": {\n                              "OR": {\n                                "left": {\n                                  "raw_text": "gastrointestinal,",\n                                  "Condition": [\n                                    "gastrointestinal"\n                                  ],\n                                  "Condition-Name": [\n                                    "gastrointestinal"\n                                  ]\n                                },\n                                "right": {\n                                  "OR": {\n                                    "left": {\n                                      "raw_text": "hematological,",\n                                      "Condition": [\n                                        "hematological"\n                                      ],\n                                      "Condition-Name": [\n                                        "hematological"\n                                      ]\n                                    },\n                                    "right": {\n                                      "OR": {\n                                        "left": {\n                                          "raw_text": "neurologic,",\n                                          "Condition": [\n                                            "neurologic"\n                                          ],\n                                          "Condition-Name": [\n                                            "neurologic"\n                                          ]\n                                        },\n                                        "right": {\n                                          "OR": {\n                                            "left": {\n                                              "raw_text": "psychiatric",\n                                              "Condition": [\n                                                "psychiatric"\n                                              ],\n                                              "Condition-Name": [\n                                                "psychiatric"\n                                              ]\n                                            },\n                                            "right": {\n                                              "OR": {\n                                                "left": {\n                                                  "raw_text": "or musculoskeletal disorders affecting absorption,",\n                                                  "Condition": [\n                                                    "disorders",\n                                                    "musculoskeletal disorders"\n                                                  ],\n                                                  "Condition-Name": [\n                                                    "disorders",\n                                                    "musculoskeletal disorders"\n                                                  ],\n                                                  "Stability": [\n                                                    "affecting"\n                                                  ],\n                                                  "Modifier": [\n                                                    "absorption"\n                                                  ]\n                                                },\n                                                "right": {\n                                                  "OR": {\n                                                    "left": {\n                                                      "raw_text": "distribution,",\n                                                      "Modifier": [\n                                                        "distribution"\n                                                      ]\n                                                    },\n                                                    "right": {\n                                                      "OR": {\n                                                        "left": {\n                                                          "raw_text": "metabolism",\n                                                          "Modifier": [\n                                                            "metabolism"\n                                                          ]\n                                                        },\n                                                        "right": {\n                                                          "raw_text": "and excretion of the drug",\n                                                          "Modifier": [\n                                                            "excretion"\n                                                          ],\n                                                          "Drug": [\n                                                            "drug"\n                                                          ]\n                                                        }\n                                                      }\n                                                    }\n                                                  }\n                                                }\n                                              }\n                                            }\n                                          }\n                                        }\n                                      }\n                                    }\n                                  }\n                                }\n                              }\n                            }\n                          }\n                        }\n                      }\n                    }\n                  }\n                }\n              }\n            }\n          }\n        },\n        "right": {\n          "OR": {\n            "left": {\n              "raw_text": "2. Genetic problems such as galactose intolerance,",\n              "Condition": [\n                "Genetic problems",\n                "galactose intolerance"\n              ],\n              "Condition-Name": [\n                "Genetic problems",\n                "galactose intolerance"\n              ]\n            },\n            "right": {\n              "OR": {\n                "left": {\n                  "raw_text": "Lapp lactose deficiency",\n                  "Condition": [\n                    "Lapp lactose deficiency"\n                  ],\n                  "Condition-Name": [\n                    "Lapp lactose deficiency"\n                  ]\n                },\n                "right": {\n                  "raw_text": "or glucose-galactose malabsorption",\n                  "Condition": [\n                    "glucose-galactose malabsorption"\n                  ],\n                  "Condition-Name": [\n                    "glucose-galactose malabsorption"\n                  ],\n                  "Modifier": [\n                    "absorption"\n                  ]\n                }\n              }\n            }\n          }\n        }\n      }\n    },\n    "right": {\n      "raw_text": "3. Those who are deemed unfit by the investigators to participate in the clinical trial for other reasons including the results of laboratory tests",\n      "Procedure": [\n        "laboratory tests"\n      ],\n      "Procedure-Name": [\n        "laboratory tests"\n      ],\n      "Study": [\n        "clinical trial"\n      ]\n    }\n  }\n}<|eot_id|>']
