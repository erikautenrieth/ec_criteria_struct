ine\n-  Confirmed diagnosis of moderate to severe CD as assessed by SF, AP score, and SES-CD\n-  Demonstrated intolerance, loss of response or inadequate response to conventional or to biologic therapy for CD\n-  If female, subject must meet the contraception recommendations\n\n### Response:\n{\n  "AND": {\n    "left": {\n      "AND": {\n        "left": {\n          "AND": {\n            "left": {\n              "raw_text": "- Diagnosis of CD for at least 3 months prior to baseline",\n              "Condition": [\n                "CD",\n                "Condition"\n              ],\n              "Condition-Name": [\n                "CD"\n              ],\n              "Eq-Temporal-Unit": [\n                "months"\n              ],\n              "Eq-Value": [\n                "3"\n              ],\n              "Eq-Comparison": [\n                "at least 3 months"\n              ],\n              "Eq-Operator": [\n                "at least"\n              ],\n              "Coreference": [\n                "CD"\n              ],\n              "Eq-Temporal-Period": [\n                "prior"\n              ]\n            },\n            "right": {\n              "AND": {\n                "left": {\n                  "raw_text": "- Confirmed diagnosis of moderate to severe CD as assessed by SF, AP score,",\n                  "Condition": [\n                    "CD",\n                    "Condition"\n                  ],\n                  "Observation": [\n                    "AP score",\n                    "SF"\n                  ],\n                  "Condition-Name": [\n                    "CD"\n                  ],\n                  "Eq-Comparison": [\n                    "moderate to severe"\n                  ],\n                  "Eq-Operator": [\n                    "to"\n                  ],\n                  "Severity": [\n                    "moderate",\n                    "severe"\n                  ],\n                  "Observation-Name": [\n                    "AP score",\n                    "SF"\n                  ],\n                  "Coreference": [\n                    "CD"\n                  ]\n                },\n                "right": {\n                  "raw_text": "and SES-CD",\n                  "Observation": [\n                    "SES-CD"\n                  ],\n                  "Observation-Name": [\n                    "SES-CD"\n                  ]\n                }\n              }\n            }\n          }\n        },\n        "right": {\n          "OR": {\n            "left": {\n              "raw_text": "- Demonstrated intolerance,",\n              "Condition": [\n                "intolerance"\n              ],\n              "Condition-Name": [\n                "intolerance"\n              ]\n            },\n            "right": {\n              "OR": {\n                "left": {\n                  "raw_text": "loss of response",\n                  "Condition": [\n                    "loss of response"\n                  ],\n                  "Condition-Name": [\n                    "loss of response"\n                  ]\n                },\n                "right": {\n                  "AND": {\n                    "left": {\n                      "raw_text": "or inadequate response to conventional",\n                      "Condition": [\n                        "inadequate response",\n                        "conventional"\n                      ],\n                      "Condition-Name": [\n                        "inadequate response",\n                        "conventional"\n                      ]\n                    },\n                    "right": {\n                      "raw_text": "or to biologic therapy for CD",\n                      "Procedure": [\n                        "biologic therapy"\n                      ],\n                      "Procedure-Name": [\n                        "biologic therapy"\n                      ],\n                      "Conditio