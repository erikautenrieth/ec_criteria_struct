                            ]\n                                    },\n                                    "right": {\n                                      "raw_text": "or findings",\n                                      "Condition": [\n                                        "findings"\n                                      ],\n                                      "Eq-Unit": [\n                                        "g"\n                                      ]\n                                    }\n                                  }\n                                }\n                              }\n                            }\n                          }\n                        }\n                      }\n                    }\n                  }\n                }\n              }\n            }\n          }\n        },\n        "right": {\n          "raw_text": "4. Those who are judged to be eligible for clinical trials based on laboratory and ECG results during screening tests",\n          "Procedure": [\n            "laboratory",\n            "ECG"\n          ],\n          "Procedure-Name": [\n            "laboratory",\n            "ECG"\n          ],\n          "Study": [\n            "clinical trials"\n          ],\n          "Eq-Unit": [\n            "g"\n          ]\n        }\n      }\n    },\n    "right": {\n      "AND": {\n        "left": {\n          "raw_text": "5. Those who voluntarily decide to participate",\n          "Eq-Unit": [\n            "g"\n          ]\n        },\n        "right": {\n          "raw_text": "and agree to comply with the cautions after hearing and fully understanding the detailed description of this clinical trial",\n          "Study": [\n            "clinical trial"\n          ],\n          "Eq-Unit": [\n            "g"\n          ]\n        }\n      }\n    }\n  }\n}<|eot_id|>']
