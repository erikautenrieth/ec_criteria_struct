ure-Assertion": [\n                                "evaluation"\n                              ]\n                            },\n                            "right": {\n                              "raw_text": "and the small and large intestine).",\n                              "Modifier": [\n                                "small and large intestine"\n                              ]\n                            }\n                          }\n                        }\n                      }\n                    },\n                    "right": {\n                      "AND": {\n                        "left": {\n                          "raw_text": "- Patients",\n                          "Eq-Comparison": [\n                            "on"\n                          ],\n                          "Eq-Temporal-Period": [\n                            "on"\n                          ]\n                        },\n                        "right": {\n                          "NOT": {\n                            "left": {\n                              "OR": {\n                                "left": {\n                                  "raw_text": "with incomplete colonoscopies (those where endoscopists did",\n                                  "Procedure": [\n                                    "colonoscopies",\n                                    "colonoscopy"\n                                  ],\n                                  "Procedure-Name": [\n                                    "colonoscopies",\n                                    "colonoscopy"\n                                  ],\n                                  "Eq-Comparison": [\n                                    "incomplete"\n                                  ],\n                                  "Eq-Temporal-Period": [\n                                    "on"\n                                  ],\n                                  "Modifier": [\n                                    "incomple