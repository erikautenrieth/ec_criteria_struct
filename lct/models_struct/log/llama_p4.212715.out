ge range 26-34. be between weeks\n-  To be diagnosed with retinopathy of prematurity\n-  Neurological, hereditary and not having metabolic disease\n-  Compliance with visual examinations and physiotherapy evaluations\n-  To be children and parents who agree to participate in the study\n\n### Response:\n{\n  "AND": {\n    "left": {\n      "AND": {\n        "left": {\n          "AND": {\n            "left": {\n              "AND": {\n                "left": {\n                  "AND": {\n                    "left": {\n                      "AND": {\n                        "left": {\n                          "raw_text": "- Age range between 2-6 years of age",\n                          "Eq-Temporal-Unit": [\n                            "years"\n                          ],\n                          "Age": [\n                            "Age"\n                          ],\n                          "Eq-Value": [\n                            "2",\n                            "6"\n                          ],\n                          "Eq-Comparison": [\n                            "2-6 years"\n                          ],\n                          "Eq-Operator": [\n                            "-"\n                          ]\n                        },\n                        "right": {\n                          "raw_text": "- Gestational age range 26-34. be between weeks",\n                          "Condition": [\n                            "Gestational age"\n                          ],\n                          "Eq-Temporal-Unit": [\n                            "weeks"\n                          ],\n                          "Condition-Name": [\n                            "Gestational age"\n                          ],\n                          "Eq-Value": [\n                            "2",\n                            "6",\n                            "26",\n                            "34"\n                          ],\n                          "Eq-Comparison": [\n                            "26-34"\n                          ],\n                          "Eq-Operator": [\n                            "-"\n                          ]\n                        }\n                      }\n                    },\n                    "right": {\n                      "raw_text": "- To be diagnosed with retinopathy of prematurity",\n                      "Condition": [\n                        "retinopathy of prematurity"\n                      ],\n                      "Condition-Name": [\n                        "retinopathy of prematurity"\n                      ],\n                      "Eq-Operator": [\n                        "-"\n                      ]\n                    }\n                  }\n                },\n                "right": {\n                  "AND": {\n                    "left": {\n                      "raw_text": "-",\n                      "Eq-Operator": [\n                        "-"\n                      ]\n                    },\n                    "right": {\n                      "NOT": {\n                        "left": {\n                          "raw_text": "Neurological, hereditary and not having metabolic disease",\n                          "Condition": [\n                            "Neurological",\n                            "metabolic disease"\n                          ],\n                          "Condition-Name": [\n                            "Neurological",\n                            "metabolic disease"\n                          ],\n                          "Eq-Operator": [\n                            "-"\n                          ],\n                          "Negation": [\n                            "not having",\n                            "not"\n                          ],\n                          "Modifier": [\n                            "hereditary"\n                          ]\n                        }\n                      }\n                  