ayers\n-  Belong to the Celeste club\n-  Not having any injury to the hamstring musculature at the time of the study\n\n### Response:\n{\n  "AND": {\n    "left": {\n      "AND": {\n        "left": {\n          "AND": {\n            "left": {\n              "raw_text": "- Age between 18 to 25 years",\n              "Age": [\n                "Age"\n              ],\n              "Eq-Operator": [\n                "to",\n                "between"\n              ],\n              "Eq-Temporal-Unit": [\n                "years"\n              ],\n              "Eq-Value": [\n                "18",\n                "25",\n                "1"\n              ],\n              "Eq-Comparison": [\n                "between 18 to 25 years"\n              ]\n            },\n            "right": {\n              "raw_text": "- Amateur basketball players",\n              "Observation": [\n                "basketball players"\n              ],\n              "Eq-Operator": [\n                "to"\n              ],\n              "Observation-Name": [\n                "basketball players"\n              ],\n              "Modifier": [\n                "Amateur"\n              ]\n            }\n          }\n        },\n        "right": {\n          "raw_text": "- Belong to the Celeste club",\n          "Location": [\n            "Celeste club"\n          ],\n          "Eq-Operator": [\n            "to"\n          ]\n        }\n      }\n    },\n    "right": {\n      "AND": {\n        "left": {\n          "raw_text": "-"\n        },\n        "right": {\n          "NOT": {\n            "left": {\n              "raw_text": "Not having any injury to the hamstring musculature at the time of the study",\n              "Condition": [\n                "injury to the hamstring musculature"\n              ],\n              "Condition-Name": [\n                "injury to the hamstring musculature"\n              ],\n              "Negation": [\n                "Not"\n              ],\n            