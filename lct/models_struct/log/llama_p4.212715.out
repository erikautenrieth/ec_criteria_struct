             "OR": {\n                                "left": {\n                                  "raw_text": "5. Sustained severe spinal cord injury (lower extremity paresis/",\n                                  "Condition": [\n                                    "spinal cord injury",\n                                    "lower extremity paresis"\n                                  ],\n                                  "Condition-Name": [\n                                    "spinal cord injury",\n                                    "lower extremity paresis"\n                                  ],\n                                  "Eq-Comparison": [\n                                    "Sustained"\n                                  ],\n                                  "Eq-Temporal-Period": [\n                                    "Sustained"\n                                  ],\n                                  "Severity": [\n                                    "severe"\n                                  ],\n                                  "Modifier": [\n                                    "lower extremity",\n                                    "Sustained"\n                                  ]\n                                },\n                                "right": {\n                                  "raw_text": "paralysis)",\n                                  "Condition": [\n                                    "paralysis"\n                                  ],\n                                  "Condition-Name": [\n                                    "paralysis"\n                                  ]\n                                }\n                              }\n                            }\n                          }\n                        },\n                        "right": {\n                          "OR": {\n                            "left": {\n                              "raw_text": "6. Sustained severe burns (>10% total body surface area 