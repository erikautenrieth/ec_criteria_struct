e within the last six months\n-  patients allergic to Percocet or acetaminophen\n-  patients taking tricyclic antidepressants (interaction with bupivacaine)\n-  vulnerable populations (prisoners or pregnant women)\n\n### Response:\n{\n  "AND": {\n    "left": {\n      "AND": {\n        "left": {\n          "AND": {\n            "left": {\n              "AND": {\n                "left": {\n                  "raw_text": "- allergy to bupivacaine",\n                  "Allergy": [\n                    "allergy"\n                  ],\n                  "Drug": [\n                    "bupivacaine"\n                  ],\n                  "Drug-Name": [\n                    "bupivacaine"\n                  ]\n                },\n                "right": {\n                  "raw_text": "- pre-operative opioid usage within the last six months",\n                  "Eq-Temporal-Unit": [\n                    "months",\n                    "month"\n                  ],\n                  "Eq-Value": [\n                    "six"\n                  ],\n                  "Eq-Comparison": [\n                    "last six months"\n                  ],\n                  "Eq-Temporal-Period": [\n                    "last"\n                  ],\n                  "Drug": [\n                    "opioid"\n                  ],\n                  "Drug-Name": [\n                    "opioid"\n                  ],\n                  "Procedure": [\n                    "operative"\n                  ],\n                  "Procedure-Name": [\n                    "operative"\n                  ]\n                }\n              }\n            },\n            "right": {\n              "OR": {\n                "left": {\n                  "raw_text": "- patients allergic to Percocet",\n                  "Allergy": [\n                    "allergic",\n                    "allergy"\n                  ],\n                  "Drug": [\n                    "Percocet"\n                  ],\n                  "Drug-Name": [\n                    "Percocet"\n                  ]\n                },\n                "right": {\n                  "raw_text": "or acetaminophen",\n                  "Drug": [\n                    "acetaminophen"\n                  ],\n                  "Drug-Name": [\n                    "acetaminophen"\n                  ]\n                }\n              }\n            }\n          }\n        },\n        "right": {\n          "raw_text": "- patients taking tricyclic antidepressants (interaction with bupivacaine)",\n          "Eq-Comparison": [\n            "taking"\n          ],\n          "Eq-Temporal-Period": [\n            "taking"\n          ],\n          "Drug": [\n            "tricyclic antidepressants",\n            "bupivacaine"\n          ],\n          "Drug-Name": [\n            "tricyclic antidepressants",\n            "bupivacaine"\n          ],\n          "Stability": [\n            "interaction"\n          ]\n        }\n      }\n    },\n    "right": {\n      "OR": {\n        "left": {\n          "raw_text": "- vulnerable populations (prisoners",\n          "Observation": [\n            "vulnerable populations"\n          ],\n          "Observation-Name": [\n            "vulnerable populations"\n          ],\n          "Condition": [\n            "prisoners"\n          ],\n          "Condition-Name": [\n            "prisoners"\n          ]\n        },\n        "right": {\n          "raw_text": "or pregnant women)",\n          "Condition": [\n            "pregnant"\n          ],\n          "Condition-Name": [\n            "pregnant"\n          ],\n          "Life-Stage-And-Gender": [\n            "women"\n          ]\n        }\n      }\n    }\n  }\n}<|eot_id|>']
