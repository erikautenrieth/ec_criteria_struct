        },
        "right": {
          "OR": {
            "left": {
              "raw_text": "2. Chronic ankle sprain more than 3months with chronic ankle pain",
              "Eq-Comparison": [
                "more than 3months",
                "on"
              ],
              "Condition": [
                "ankle sprain",
                "ankle pain"
              ],
              "Eq-Operator": [
                "more than"
              ],
              "Eq-Value": [
                "3"
              ],
              "Eq-Temporal-Unit": [
                "months"
              ],
              "Condition-Name": [
                "ankle sprain",
                "ankle pain"
              ],
              "Acuteness": [
                "Chronic"
              ],
              "Eq-Temporal-Period": [
                "on"
              ],
              "Modifier": [
                "ankle"
              ]
            },
            "right": {
              "raw_text": "or instability sensation",
              "Condition": [
                "instability sensation"
              ],
              "Condition-Name": [
                "instability sensation"
              ]
            }
          }
        }
      }
    },
    "right": {
      "raw_text": "3. Ultrasound diagnosed anterior talofibular ligament sprain",
      "Condition": [
        "anterior talofibular ligament sprain"
      ],
      "Procedure": [
        "Ultrasound"
      ],
      "Condition-Name": [
        "anterior talofibular ligament sprain"
      ],
      "Procedure-Name": [
        "Ultrasound"
      ]
    }
  }
}
