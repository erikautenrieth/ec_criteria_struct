ictions, return an empty JSON FILE {}\n- The entire text of the eligibility criteria must be included and separated by the logical operators, without omitting any words or information.\n- The output should only contain the JSON object, without any additional text or formatting.\n- Ensure that the JSON output strictly follows these rules and accurately represents the logical structure of the input eligibility criteria.\n\n### Input:\n-  < 18 years\n-  mental or physical incapacity to answer the questionnaires\n-  nasal fracture or surgery in the past year\n-  nasal cocaine use in the past year\n\n### Response:\n{\n  "AND": {\n    "left": {\n      "AND": {\n        "left": {\n          "AND": {\n            "left": {\n              "raw_text": "- < 18 years",\n              "Eq-Operator": [\n                "<"\n              ],\n              "Eq-Temporal-Unit": [\n                "years"\n              ],\n              "Eq-Value": [\n                "18"\n              ],\n              "Eq-Comparison": [\n                "< 18 years"\n              ],\n              "Age": [\n                "years"\n              ]\n            },\n            "right": {\n              "OR": {\n                "left": {\n                  "raw_text": "- mental",\n                  "Modifier": [\n                    "mental"\n                  ]\n                },\n                "right": {\n                  "raw_text": "or physical incapacity to answer the questionnaires",\n                  "Condition": [\n                    "incapacity"\n                  ],\n                  "Condition-Name": [\n                    "incapacity"\n                  ],\n                  "Modifier": [\n                    "physical"\n                  ]\n                }\n              }\n            }\n          }\n        },\n        "right": {\n          "OR": {\n            "left": {\n              "raw_text": "- nasal fracture",\n              "Modifier": [\n                "nasal"\n              ],\n              "Observation": [\n                "fracture"\n              ],\n              "Observation-Name": [\n                "fracture"\n              ]\n            },\n            "right": {\n              "raw_text": "or surgery in the past year",\n              "Procedure": [\n                "surgery"\n              ],\n              "Procedure-Name": [\n                "surgery"\n              ],\n              "Eq-Comparison": [\n                "past year"\n              ],\n              "Eq-Temporal-Period": [\n                "past"\n              ],\n              "Eq-Temporal-Unit": [\n                "year"\n              ]\n            }\n          }\n        }\n      }\n    },\n    "right": {\n      "raw_text": "- nasal cocaine use in the past year",\n      "Eq-Comparison": [\n        "past year"\n      ],\n      "Eq-Temporal-Period": [\n        "past"\n      ],\n      "Eq-Temporal-Unit": [\n        "year"\n      ],\n      "Modifier": [\n        "nasal"\n      ],\n      "Observation": [\n        "cocaine use"\n      ],\n      "Observation-Name": [\n        "cocaine use"\n      ]\n    }\n  }\n}<|eot_id|>']
