zation or are expected to be NPO within the next 48 hours",\n                                                  "Eq-Comparison": [\n                                                    "on",\n                                                    "within the next 48 hours"\n                                                  ],\n                                                  "Eq-Temporal-Period": [\n                                                    "on",\n                                                    "within the next"\n                                                  ],\n                                                  "Eq-Value": [\n                                                    "48"\n                                                  ],\n                                                  "Eq-Temporal-Unit": [\n                                                    "hours"\n                                                  ],\n                                                  "Observation": [\n                                                    "NPO",\n                                                    "nil per os"\n                                                  ],\n                                                  "Observation-Name": [\n                                                    "NPO",\n                                                    "nil per os"\n                                                  ],\n                                                  "Study": [\n                                                    "randomization"\n                                                  ],\n                                                  "Assertion": [\n                                                    "expected"\n                                                  ]\n                                                },\n                                                "right": {\n                                                  "OR": {\n            