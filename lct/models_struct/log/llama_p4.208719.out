or an ALS-spectrum gene mutation.",\n                              "Condition": [\n                                "ALS",\n                                "ALS-spectrum"\n                              ],\n                              "Condition-Name": [\n                                "ALS",\n                                "ALS-spectrum"\n                              ],\n                              "Eq-Comparison": [\n                                "first degree"\n                              ],\n                              "Eq-Operator": [\n                                "to"\n                              ],\n                              "Eq-Temporal-Unit": [\n                                "y"\n                              ],\n                              "Family-Member": [\n                                "relative"\n                              ],\n                              "Modifier": [\n                                "first degree"\n                              ],\n                              "Negation": [\n                                "No"\n                              ],\n                              "Procedure": [\n                                "genetic testing"\n                              ],\n                              "Procedure-Name": [\n                                "genetic testing"\n                              ],\n                              "Polarity": [\n                                "positive"\n                              ],\n                              "Condition": [\n                                "ALS-spectrum"\n                              ],\n                              "Condition-Name": [\n                                "ALS-spectrum"\n                              ],\n                              "Observation": [\n                                "ALS-spectrum gene mutation"\n                              ],\n                              "Observation-Name": [\n                          