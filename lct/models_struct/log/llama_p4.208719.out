                               ],\n                                      "Drug": [\n                                        "drug"\n                                      ],\n                                      "Observation": [\n                                        "absorption",\n                                        "distribution",\n                                        "metabolism",\n                                        "excretion"\n                                      ],\n                                      "Observation-Name": [\n                                        "absorption",\n                                        "distribution",\n                                        "metabolism",\n                                        "excretion"\n                                      ],\n                                      "Stability": [\n                                        "affecting"\n                                      ]\n                                    }\n                                  }\n                                }\n                              }\n                            }\n                          }\n                        }\n                      }\n                    }\n                  }\n                }\n              }\n            }\n          }\n        },\n        "right": {\n          "OR": {\n            "left": {\n              "raw_text": "2. Genetic problems such as galactose intolerance,",\n              "Condition": [\n                "Genetic problems",\n                "galactose intolerance"\n              ],\n              "Condition-Name": [\n                "Genetic problems",\n                "galactose intolerance"\n              ]\n            },\n            "right": {\n              "OR": {\n                "left": {\n                  "raw_text": "Lapp lactose deficiency",\n                  "Condition": [\n                    "Lapp lactose deficiency"\n                  ],\n           