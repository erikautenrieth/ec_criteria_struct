ictions, return an empty JSON FILE {}\n- The entire text of the eligibility criteria must be included and separated by the logical operators, without omitting any words or information.\n- The output should only contain the JSON object, without any additional text or formatting.\n- Ensure that the JSON output strictly follows these rules and accurately represents the logical structure of the input eligibility criteria.\n\n### Input:\n-  Aged 18 years and above at the start of the treatment.\n-  Molar relationship either Class I, < ½ unit Class II or Class III.\n-  Extraction of all four first premolar teeth as part of orthodontic treatment.\n-  Maximum anchorage required using mini-implant.\n-  No systemic disease.\n-  Good oral hygiene.\n-  No periodontal disease.\n\n### Response:\n{\n  "AND": {\n    "left": {\n      "AND": {\n        "left": {\n          "AND": {\n            "left": {\n              "AND": {\n                "left": {\n                  "AND": {\n                    "left": {\n                      "AND": {\n                        "left": {\n                          "AND": {\n                            "left": {\n                              "AND": {\n                                "left": {\n                                  "AND": {\n                                    "left": {\n                                      "AND": {\n                                        "left": {\n                                          "AND": {\n                                            "left": {\n                                              "raw_text": "- Aged 18 years and above at the start of the treatment.",\n                                              "Age": [\n                                                "Aged"\n                                              ],\n                                              "Eq-Comparison": [\n                                                "18 years and above"\n                                              ],\n                                              "Procedure": [\n                                                "treatment"\n                                              ],\n                                              "Eq-Value": [\n                                                "18"\n                                              ],\n                                              "Eq-Temporal-Unit": [\n                                                "years"\n                                              ],\n                                              "Eq-Operator": [\n                                                "and above"\n                                              ]\n                                            },\n                                            "right": {\n                                              "OR": {\n                                                "left": {\n                                                  "raw_text": "- Molar relationship either Class I, < ½ unit Class II",\n                                                  "Modifier": [\n                                                    "Molar relationship"\n                                                  ],\n                                                  "Eq-Comparison": [\n                                                    "Class I, < ½ unit Class II"\n                                                  ],\n                                                  "Eq-Value": [\n                                                    "I",\n                                                    "½",\n                                                    "Class II"\n                                                  ],\n                                                  "Eq-Operator": [\n                                                    "<"\n                                                  ],\n                                                  "Eq-Unit": [\n                                                    "Class"\n                                                  ]\n                                                },\n                                                "right": {\n                                                  "raw_text": "or Class III.",\n                                                  "Eq-Value": [\n                                                    "I",\n                                                    "Class III"\n                                                  ],\n                                                  "Eq-Unit": [\n                                                    "Class"\n                                                  ]\n                                                }\n                                              }\n                                            },\n                                            "right": {\n                                              "raw_text": "- Extraction of all four first premolar teeth as part of orthodontic treatment.",\n                                              "Procedure": [\n                                                "orthodontic treatment",\n                                                "treatment"\n                                              ],\n                                              "Procedure-Name": [\n                                                "orthodontic treatment"\n                                              ],\n                                              "Eq-Value": [\n                                                "four"\n                                              ],\n                                              "Modifier": [\n                                                "first premolar teeth"\n                                              ],\n                                              "Eq-Comparison": [\n                                                "all four"\n                                              ],\n                                              "Eq-Operator": [\n                                                "all"\n                                              ],\n                                              "Observation": [\n                                                "Extraction"\n                                              ],\n                                              "Observation-Name": [\n                                                "Extraction"\n                                              ]\n                                            }\n                                          }\n                                        },\n                                        "right": {\n                                          "raw_text": "- Maximum anchorage required using mini-implant.",\n                                          "Procedure": [\n                                            "mini-implant"\n                                          ],\n                                          "Procedure-Name": [\n                                            "mini-implant"\n                                          ],\n                                          "Modifier": [\n                                            "Maximum anchorage"\n                                          ]\n                                        }\n                                  }\n                                },\n                                "right": {\n                                  "AND": {\n                                    "left": {\n                                      "raw_text": "-"\n                                    },\n                                    "right": {\n                                      "NOT": {\n                                        "left": {\n                                          "raw_text": "No systemic disease.",\n                                          "Modifier": [\n                                            "systemic"\n                                          ],\n                                          "Condition": [\n                                            "disease"\n                                          ],\n                                          "Negation": [\n                                            "No"\n                                          ]\n                                        }\n                                      }\n                                    }\n                                  }\n                                }\n                              }\n                            },\n                            "right": {\n                              "raw_text": "- Good oral hygiene.",\n                              "Observation": [\n                                "oral hygiene"\n                              ],\n                              "Observation-Name": [\n                                "oral hygiene"\n                              ],\n                              "Polarity": [\n                                "Good"\n                              ]\n                            }\n                          }\n                        },\n                        "right": {\n                          "AND": {\n                            "left": {\n                              "raw_text": "-"\n                            },\n                            "right": {\n                              "NOT": {\n                                "left": {\n                                  "raw_text": "No periodontal disease.",\n                                  "Condition": [\n                                    "periodontal disease"\n                                  ],\n                                  "Condition-Name": [\n                                    "periodontal disease"\n                                  ],\n                                  "Negation": [\n                                    "No"\n                                  ]\n                                }\n                              }\n                            }\n                          }\n                        }\n                      }\n                    },\n                    "right": {\n                      "raw_text": "-",\n                      "Eq-Operator": [\n                        "-"\n                      ]\n                    }\n          }\n        },\n        "right": {\n          "raw_text": "The entire text of the eligibility criteria must be included and separated by the logical operators, without omitting any words or information.",\n          "Eq-Operator": [\n            "-"\n          ]\n        }\n      }\n    },\n    "right": {\n      "raw_text": "- Ensure that the JSON output strictly follows these rules and accurately represents the logical structure of the input eligibility criteria.",\n      "Eq-Operator": [\n        "-"\n      ]\n    }\n  }\n}<|eot_id|>']
