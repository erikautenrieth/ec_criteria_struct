          "raw_text": "- Patients who have orthodontic treatment",
          "Procedure": [
            "orthodontic treatment"
          ],
          "Procedure-Name": [
            "orthodontic treatment"
          ]
        }
      }
    },
    "right": {
      "raw_text": "- Patients who are not cooperative for the dental procedure",
      "Procedure": [
        "dental procedure"
      ],
      "Procedure-Name": [
        "dental procedure"
      ],
      "Assertion": [
        "not"
      ]
    }
  }
