          "Condition-Name": [
            "Transgender"
          ],
          "Life-Stage-And-Gender": [
            "male"
          ],
          "Eq-Operator": [
            "-"
          ]
        }
      }
    },
    "right": {
      "raw_text": "- 14-19 years old",
      "Eq-Comparison": [
        "14-19 years"
      ],
      "Age": [
        "old"
      ],
      "Eq-Value": [
        "14",
        "19"
      ],
      "Eq-Operator": [
        "-"
      ],
      "Eq-Temporal-Unit": [
        "years"
      ]
    }
  }
}
