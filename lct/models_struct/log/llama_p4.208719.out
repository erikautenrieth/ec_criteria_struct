        ],\n                      "Observation-Name": [\n                        "BP"\n                      ],\n                      "Eq-Value": [\n                        "130",\n                        "85"\n                      ],\n                      "Eq-Unit": [\n                        "mmHg"\n                      ]\n                    }\n          }\n        },\n        "right": {\n          "raw_text": "- Serum Endotoxin >25 EU/ml",\n          "Observation": [\n            "Serum Endotoxin"\n          ],\n          "Eq-Comparison": [\n            ">25 EU/ml"\n          ],\n          "Eq-Temporal-Unit": [\n            "d",\n            "l"\n          ],\n          "Eq-Operator": [\n            "-",\n            ">"\n          ],\n          "Observation-Name": [\n            "Serum Endotoxin"\n          ],\n          "Eq-Value": [\n            "25"\n          ],\n          "Eq-Unit": [\n            "EU",\n            "ml"\n          ]\n        }\n      }\n    },\n    "right": {\n      "raw_text": "Other protocol defined inclusion/exclusion criteria could apply"\n    }\n  }\n}<|eot_id|>']
