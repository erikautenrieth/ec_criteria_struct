ictions, return an empty JSON FILE {}\n- The entire text of the eligibility criteria must be included and separated by the logical operators, without omitting any words or information.\n- The output should only contain the JSON object, without any additional text or formatting.\n- Ensure that the JSON output strictly follows these rules and accurately represents the logical structure of the input eligibility criteria.\n\n### Input:\n-  Significant vertical skeletal discrepancies.\n-  Systemic diseases requiring long-term antibiotic use, phenytoin, cyclosporin, anti-inflammatory drugs, bisphosphonates, systemic corticosteroids or calcium channel blockers.\n-  Poor oral hygiene.\n-  Active periodontal disease.\n\n### Response:\n{\n  "AND": {\n    "left": {\n      "AND": {\n        "left": {\n          "AND": {\n            "left": {\n              "raw_text": "- Significant vertical skeletal discrepancies.",\n              "Modifier": [\n                "vertical skeletal"\n              ],\n              "Observation": [\n                "discrepancies"\n              ],\n              "Severity": [\n                "Significant"\n              ],\n              "Observation-Name": [\n                "discrepancies"\n              ]\n            },\n            "right": {\n              "OR": {\n                "left": {\n                  "raw_text": "- Systemic diseases requiring long-term antibiotic use,",\n                  "Condition": [\n                    "diseases"\n                  ],\n                  "Modifier": [\n                    "Systemic"\n                  ],\n                  "Drug": [\n                    "antibiotic"\n                  ],\n                  "Assertion": [\n                    "requiring"\n                  ],\n                  "Acuteness": [\n                    "long-term"\n                  ],\n                  "Drug-Name": [\n                    "antibiotic"\n                  ]\n                },\n                "right": {\n                  "OR": {\n                    "left": {\n                      "raw_text": "phenytoin,",\n                      "Drug": [\n                        "phenytoin"\n                      ],\n                      "Drug-Name": [\n                        "phenytoin"\n                      ]\n                    },\n                    "right": {\n                      "OR": {\n                        "left": {\n                          "raw_text": "cyclosporin,",\n                          "Drug": [\n                            "cyclosporin"\n                          ],\n                          "Drug-Name": [\n                            "cyclosporin"\n                          ]\n                        },\n                        "right": {\n                          "OR": {\n                            "left": {\n                              "raw_text": "anti-inflammatory drugs,",\n                              "Drug": [\n                                "anti-inflammatory drugs"\n                              ],\n                              "Drug-Name": [\n                                "anti-inflammatory drugs"\n                              ]\n                            },\n                            "right": {\n                              "OR": {\n                                "left": {\n                                  "raw_text": "bisphosphonates,",\n                                  "Drug": [\n                                    "bisphosphonates"\n                                  ],\n                                  "Drug-Name": [\n                                    "bisphosphonates"\n                                  ]\n                                },\n                                "right": {\n                                  "OR": {\n                                    "left": {\n                                      "raw_text": "systemic corticosteroids",\n                                      "Modifier": [\n                                        "systemic"\n                                      ],\n                                      "Drug": [\n                                        "corticosteroids"\n                                      ],\n                                      "Drug-Name": [\n                                        "corticosteroids"\n                                      ]\n                                    },\n                                    "right": {\n                                      "raw_text": "or calcium channel blockers.",\n                                      "Drug": [\n                                        "calcium channel blockers"\n                                      ],\n                                      "Drug-Name": [\n                                        "calcium channel blockers"\n                                      ]\n                                    }\n                                  }\n                                }\n                              }\n                            }\n                          }\n                        }\n                      }\n                    }\n                  }\n                }\n              }\n            }\n          }\n        },\n        "right": {\n          "raw_text": "- Poor oral hygiene.",\n          "Condition": [\n            "Poor oral hygiene"\n          ],\n          "Condition-Name": [\n            "Poor oral hygiene"\n          ]\n        }\n      }\n    },\n    "right": {\n      "raw_text": "- Active periodontal disease.",\n      "Condition": [\n        "periodontal disease"\n      ],\n      "Condition-Name": [\n        "periodontal disease"\n      ],\n      "Eq-Comparison": [\n        "Active"\n      ],\n      "Eq-Temporal-Period": [\n        "Active"\n      ]\n    }\n  }\n}<|eot_id|>']
