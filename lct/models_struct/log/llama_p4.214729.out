nates:\n-  Aged between 1h of life and 28 days of life\n-  Born beyond 33 Week of Amenorrhea + 1day and 2kg of birth weight\n-  Hospitalized in the medical-surgical centre of Pediatrics of the hospital of Strasbourg\n-  For whom a blood sample was prescribed as part of their routine care\n\n### Response:\n{\n  "AND": {\n    "left": {\n      "AND": {\n        "left": {\n          "AND": {\n            "left": {\n              "AND": {\n                "left": {\n                  "AND": {\n                    "left": {\n                      "AND": {\n                        "left": {\n                          "raw_text": "Adult Healthy Volunteers :",\n                          "Eq-Temporal-Unit": [\n                            "h"\n                          ],\n                          "Condition": [\n                            "Adult Healthy Volunteers"\n                          ],\n                          "Condition-Name": [\n                            "Adult Healthy Volunteers"\n                          ]\n                        },\n                        "right": {\n                          "raw_text": "- Over 18 years of age",\n                          "Eq-Temporal-Unit": [\n                            "years"\n                          ],\n                          "Eq-Value": [\n                            "18"\n                          ],\n                          "Eq-Comparison": [\n                            "Over 18 years"\n                          ],\n                          "Eq-Operator": [\n                            "Over"\n                          ],\n                          "Age": [\n                            "age"\n                          ]\n                        }\n                      }\n                    },\n                    "right": {\n                      "raw_text": "Neonates:",\n                      "Condition": [\n                        "Neonates"\n                      ],\n                      "Condition-Name": [\n                        "Neonates"\n                      ]\n                    }\n                  }\n                },\n                "right": {\n                  "raw_text": "- Aged between 1h of life and 28 days of life",\n                  "Eq-Operator": [\n                    "between"\n                  ],\n                  "Eq-Temporal-Unit": [\n                    "days",\n                    "h"\n                  ],\n                  "Eq-Value": [\n                    "1",\n                    "28"\n                  ],\n                  "Eq-Comparison": [\n                    "between 1h of life and 28 days of life"\n                  ],\n                  "Age": [\n                    "Aged"\n                  ]\n                }\n              }\n            },\n            "right": {\n              "raw_text": "- Born beyond 33 Week of Amenorrhea + 1day and 2kg of birth weight",\n              "Eq-Value": [\n                "33",\n                "3",\n                "1",\n                "2"\n              ],\n              "Eq-Comparison": [\n                "Born",\n                "2kg"\n              ],\n              "Eq-Temporal-Unit": [\n                "day"\n              ],\n              "Eq-Operator": [\n                "beyond"\n              ],\n              "Observation": [\n                "birth weight"\n              ],\n              "Observation-Name": [\n                "birth weight"\n              ],\n              "Eq-Unit": [\n                "Week"\n              ]\n            }\n          }\n        },\n        "right": {\n          "raw_text": "- Hospitalized in the medical-surgical centre of Pediatrics of the hospital of Strasbourg",\n          "Encounter": [\n            "Hospitalized"\n          ],\n          "Location": [\n            "medical-surgical centre of Pediatrics",\n            "hospital of Strasbourg"\n          ]\n        }\n      }\n    },\n    "right": {\n      "raw_text": "- For