n": [\n                    "Index"\n                  ],\n                  "Eq-Temporal-Recency": [\n                    "Index"\n                  ]\n                }\n              }\n            },\n            "right": {\n              "raw_text": "3. High initial morphine equivalent use ≥ 90 mg in the first 24 hours from admission",\n              "Eq-Operator": [\n                "≥",\n                "in the"\n              ],\n              "Eq-Temporal-Unit": [\n                "hours"\n              ],\n              "Eq-Value": [\n                "90",\n                "24",\n                "3"\n              ],\n              "Encounter": [\n                "admission"\n              ],\n              "Drug": [\n                "morphine"\n              ],\n              "Drug-Name": [\n                "morphine"\n              ],\n              "Eq-Comparison": [\n                "≥ 90 mg",\n                "in the first 24 hours"\n              ],\n              "Eq-Temporal-Recency": [\n                "first"\n              ],\n              "Eq-Unit": [\n                "mg"\n              ],\n              "Polarity": [\n                "High"\n              ]\n            }\n          }\n        },\n        "right": {\n          "raw_text": "4. Baseline pain assessed at screening of ≥ 5 on the pain numeric rating score (NRS)",\n          "Eq-Operator": [\n            "≥",\n            "in the"\n          ],\n          "Eq-Value": [\n            "5"\n          ],\n          "Eq-Comparison": [\n            "≥ 5"\n          ],\n          "Observation": [\n            "pain",\n            "pain numeric rating score",\n            "NRS"\n          ],\n          "Observation-Name": [\n            "pain",\n            "pain numeric rating score",\n            "NRS"\n          ],\n          "Eq-Unit": [\n            "mg"\n          ],\n          "Study": [\n            "screening"\n          ],\n          "Eq-Temporal-Unit": [\n            "min"\n     