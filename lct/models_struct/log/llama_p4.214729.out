: [\n                "Single kidney"\n              ],\n              "Observation-Name": [\n                "trauma"\n              ]\n            },\n            "right": {\n              "raw_text": "or donation",\n              "Observation": [\n                "donation"\n              ],\n              "Observation-Name": [\n                "donation"\n              ]\n            }\n          }\n        }\n      }\n    },\n    "right": {\n      "raw_text": "- Patients who received immunosuppressive agent within the past 1 year",\n      "Eq-Comparison": [\n        "within the past 1 year",\n        "received"\n      ],\n      "Eq-Operator": [\n        "within"\n      ],\n      "Drug": [\n        "immunosuppressive agent"\n      ],\n      "Eq-Value": [\n        "3",\n        "1"\n      ],\n      "Eq-Temporal-Period": [\n        "received",\n        "past"\n      ],\n      "Drug-Name": [\n        "immunosuppressive agent"\n      ],\n      "Eq-Unit": [\n        "year"\n      ]\n    }\n  }\n}<|eot_id|>']
