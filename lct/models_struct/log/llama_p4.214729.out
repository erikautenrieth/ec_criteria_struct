ayers\n-  Belong to the Celeste club\n-  Not having any injury to the hamstring musculature at the time of the study\n\n### Response:\n{\n  "AND": {\n    "left": {\n      "AND": {\n        "left": {\n          "AND": {\n            "left": {\n              "raw_text": "- Age between 18 to 25 years",\n              "Eq-Temporal-Unit": [\n                "years"\n              ],\n              "Age": [\n                "Age"\n              ],\n              "Eq-Operator": [\n                "to"\n              ],\n              "Eq-Value": [\n                "18",\n                "25"\n              ],\n              "Eq-Comparison": [\n                "between 18 to 25 years"\n              ]\n            },\n            "right": {\n              "raw_text": "- Amateur basketball players",\n              "Observation": [\n                "Amateur basketball players"\n              ],\n              "Observation-Name": [\n                "Amateur basketball players"\n              ]\n            }\n          }\n        },\n        "right": {\n          "raw_text": "- Belong to the Celeste club"\n        }\n      }\n    },\n    "right": {\n      "AND": {\n        "left": {\n          "raw_text": "-"\n        },\n        "right": {\n          "NOT": {\n            "left": {\n              "raw_text": "Not having any injury to the hamstring musculature at the time of the study",\n              "Negation": [\n                "Not"\n              ],\n              "Observation": [\n                "injury"\n              ],\n              "Observation-Name": [\n                "injury"\n              ],\n              "Modifier": [\n                "hamstring musculature"\n              ],\n              "Eq-Comparison": [\n                "at the time"\n              ],\n              "Eq-Temporal-Period": [\n                "at the time"\n              ],\n              "Study": [\n                "study"\n              ]\n            }\n          }\n        }\n      }