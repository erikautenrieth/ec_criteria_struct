omen aged between 18- and 65-years b) medical diagnosis of Non-Specific Chronic Neck Pain with more than 6 months of evolution of neck pain.\n\n### Response:\n{\n  "OR": {\n    "left": {\n      "raw_text": "- The inclusion criteria were as follows: a) men",\n      "Life-Stage-And-Gender": [\n        "men"\n      ]\n    },\n    "right": {\n      "AND": {\n        "left": {\n          "raw_text": "and women aged between 18- and 65-years b) medical diagnosis of",\n          "Eq-Temporal-Unit": [\n            "years"\n          ],\n          "Life-Stage-And-Gender": [\n            "women"\n          ],\n          "Eq-Operator": [\n            "-"\n          ],\n          "Eq-Value": [\n            "18",\n            "65"\n          ],\n          "Eq-Comparison": [\n            "between 18- and 65-years"\n          ],\n          "Age": [\n            "aged"\n          ]\n        },\n        "right": {\n          "NOT": {\n            "left": {\n              "AND": {\n                "left": {\n                  "raw_text": "Non-Specific Chronic Neck Pain with more than 6 months of evolution of neck pain.",\n                  "Eq-Temporal-Unit": [\n                    "months"\n                  ],\n                  "Eq-Value": [\n                    "6"\n                  ],\n                  "Condition": [\n                    "Neck Pain"\n                  ],\n                  "Condition-Name": [\n                    "Neck Pain"\n                  ],\n                  "Modifier": [\n                    "Non-Specific",\n                    "Chronic"\n                  ],\n                  "Observation": [\n                    "pain"\n                  ],\n                  "Observation-Name": [\n                    "pain"\n                  ],\n                  "Eq-Comparison": [\n                    "more than 6 months"\n                  ],\n                  "Eq-Operator": [\n                    "-",\n                    "more than"\n                  ],\n                  "Negation": [\n                    "Non"\n                  ]\n                },\n                "right": {\n                  "raw_text": "neck pain.",\n                  "Observation": [\n                    "pain"\n                  ],\n                  "Observation-Name": [\n                    "pain"\n                  ],\n                  "Modifier": [\n                    "neck"\n                  ]\n                }\n              }\n            }\n          }\n        }\n      }\n    }\n  }\n}<|eot_id|>']
