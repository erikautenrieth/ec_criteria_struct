ars old\n\n### Response:\n{\n  "AND": {\n    "left": {\n      "AND": {\n        "left": {\n          "raw_text": "- Testosterone naive",\n          "Condition": [\n            "Testosterone naive"\n          ],\n          "Condition-Name": [\n            "Testosterone naive"\n          ]\n        },\n        "right": {\n          "raw_text": "- Transgender male",\n          "Condition": [\n            "Transgender"\n          ],\n          "Condition-Name": [\n            "Transgender"\n          ],\n          "Life-Stage-And-Gender": [\n            "male"\n          ]\n        }\n      }\n    },\n    "right": {\n      "raw_text": "- 14-19 years old",\n      "Eq-Temporal-Unit": [\n        "years"\n      ],\n      "Eq-Operator": [\n        "-"\n      ],\n      "Eq-Value": [\n        "14",\n        "19"\n      ],\n      "Eq-Comparison": [\n        "14-19 years"\n      ],\n      "Age": [\n        "old"\n      ]\n    }\n  }\n}<|eot_id|>']
