an nicotine dependence\n-  Medical conditions that might affect brain function\n-  Current use of medications that could alter brain function\n-  Pregnancy\n-  Current illicit drug use other than occasional use of marijuana\n\n### Response:\n{\n  "AND": {\n    "left": {\n      "AND": {\n        "left": {\n          "AND": {\n            "left": {\n              "AND": {\n                "left": {\n                  "raw_text": "- History of any Axis I psychiatric diagnosis other than nicotine dependence",\n                  "Condition": [\n                    "psychiatric diagnosis",\n                    "nicotine dependence"\n                  ],\n                  "Condition-Name": [\n                    "psychiatric diagnosis",\n                    "nicotine dependence"\n                  ],\n                  "Eq-Comparison": [\n                    "History"\n                  ],\n                  "Eq-Temporal-Period": [\n                    "History"\n                  ],\n                  "Exception": [\n                    "other than"\n                  ]\n                },\n                "right": {\n                  "raw_text": "- Medical conditions that might affect brain function",\n                  "Condition": [\n                    "Medical conditions"\n                  ],\n                  "Observation": [\n                    "brain function"\n                  ],\n                  "Observation-Name": [\n                    "brain function"\n                  ],\n                  "Stability": [\n                    "affect"\n                  ],\n                  "Assertion": [\n                    "might"\n                  ]\n                }\n              }\n            },\n            "right": {\n              "raw_text": "- Current use of medications that could alter brain function",\n              "Eq-Comparison": [\n                "Current"\n              ],\n              "Eq-Temporal-Period": [\n                "Current"\n              ],\n              "Drug": [\n                "medications"\n              ],\n              "Observation": [\n                "brain function"\n              ],\n              "Observation-Name": [\n                "brain function"\n              ],\n              "Stability": [\n                "alter"\n              ],\n              "Assertion": [\n                "could"\n              ]\n            }\n          }\n        },\n        "right": {\n          "raw_text": "- Pregnancy",\n          "Condition": [\n            "Pregnancy"\n          ],\n          "Condition-Name": [\n            "Pregnancy"\n          ]\n        }\n      }\n    },\n    "right": {\n      "AND": {\n        "left": {\n          "raw_text": "- Current illicit drug use other than occasional use of marijuana",\n          "Eq-Comparison": [\n            "Current"\n          ],\n          "Eq-Temporal-Period": [\n            "Current"\n          ],\n          "Drug": [\n            "illicit drug",\n            "marijuana"\n          ],\n          "Drug-Name": [\n            "illicit drug",\n            "marijuana"\n          ],\n          "Exception": [\n            "other than"\n          ]\n        },\n        "right": {\n          "raw_text": "5. Occasional use is defined as using marijuana no more than 2 times per month.",\n          "Eq-Value": [\n            "2"\n          ],\n          "Drug": [\n            "marijuana"\n          ],\n          "Drug-Name": [\n            "marijuana"\n          ],\n          "Eq-Comparison": [\n            "no more than 2 times per month"\n          ],\n          "Eq-Operator": [\n            "no more than"\n          ],\n          "Eq-Unit": [\n            "times"\n          ],\n          "Eq-Temporal-Unit": [\n            "month"\n          ]\n        }\n      }\n    }\n  }\n}<|eot_id|>']
