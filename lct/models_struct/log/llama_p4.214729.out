               "raw_text": "- subjects with active pulmonary infection due to mycobacterium tuberculosis",\n                  "Eq-Value": [\n                    "3"\n                  ],\n                  "Condition": [\n                    "infection"\n                  ],\n                  "Condition-Name": [\n                    "infection"\n                  ],\n                  "Modifier": [\n                    "pulmonary"\n                  ],\n                  "Eq-Comparison": [\n                    "active"\n                  ],\n                  "Eq-Temporal-Period": [\n                    "active"\n                  ],\n                  "Organism": [\n                    "mycobacterium tuberculosis"\n                  ],\n                  "Organism-Name": [\n                    "mycobacterium tuberculosis"\n                  ]\n                },\n                "right": {\n                  "raw_text": "or mycobacteria other than tuberculosis (MOTT)",\n                  "Condition": [\n                    "tuberculosis"\n                  ],\n                  "Condition-Name": [\n                    "tuberculosis"\n                  ],\n                  "Organism": [\n                    "mycobacteria",\n                    "MOTT"\n                  ],\n                  "Organism-Name": [\n                    "mycobacteria",\n                    "MOTT"\n                  ],\n                  "Exception": [\n                    "other than"\n                  ]\n                }\n              }\n            }\n          }\n        },\n        "right": {\n          "OR": {\n            "left": {\n              "raw_text": "- subjects with others forms of pulmonary aspergillosis (allergic bronchopulmonary aspergillosis, chronic necrotizing aspergillosis",\n              "Condition": [\n                "aspergillosis",\n                "allergic bronchopulmonary aspergillosis"\n              ],\n              "Condition-Name": [\n                "aspergillosis",\n                "allergic bronchopulmonary aspergillosis"\n              ],\n              "Modifier": [\n                "pulmonary",\n                "necrotizing"\n              ],\n              "Eq-Value": [\n                "3"\n              ],\n              "Eq-Comparison": [\n                "on"\n              ],\n              "Eq-Temporal-Period": [\n                "on"\n              ]\n            },\n            "right": {\n              "raw_text": "and angio-invasive aspergillosis)",\n              "Condition": [\n                "aspergillosis"\n              ],\n              "Condition-Name": [\n                "aspergillosis"\n              ],\n              "Modifier": [\n                "invasive",\n                "angio"\n              ]\n            }\n          }\n        }\n      }\n    },\n    "right": {\n      "raw_text": "- pregnancy",\n      "Condition": [\n        "pregnancy"\n      ],\n      "Condition-Name": [\n        "pregnancy"\n      ]\n    }\n  }\n}<|eot_id|>']
