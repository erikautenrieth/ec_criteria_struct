            },\n                    "right": {\n                      "raw_text": "vagina or bladder",\n                      "Condition": [\n                        "vagina"\n                      ],\n                      "Condition-Name": [\n                        "vagina"\n                      ],\n                      "Modifier": [\n                        "bladder"\n                      ]\n                    }\n                  }\n                }\n              }\n            }\n          }\n        }\n      }\n    },\n    "right": {\n      "OR": {\n        "left": {\n          "raw_text": "- Presence of contraindications for the laser treatment",\n          "Contraindication": [\n            "contraindications"\n          ],\n          "Procedure": [\n            "laser treatment"\n          ],\n          "Procedure-Name": [\n            "laser treatment"\n          ]\n        },\n        "right": {\n          "raw_text": "or topical steroid treatment",\n          "Procedure": [\n            "treatment"\n          ],\n          "Drug": [\n            "topical steroid"\n          ],\n          "Drug-Name": [\n            "topical steroid"\n          ],\n          "Modifier": [\n            "topical"\n          ]\n        }\n      }\n    }\n  }\n}<|eot_id|>']
