edure": [\n                "operative"\n              ],\n              "Life-Stage-And-Gender": [\n                "females"\n              ],\n              "Observation-Name": [\n                "anemia",\n                "hemoglobin"\n              ],\n              "Eq-Unit": [\n                "g",\n                "dL"\n              ]\n            },\n            "right": {\n              "raw_text": "and <12 g/dL in males), refusal of blood products;",\n              "Eq-Operator": [\n                "<"\n              ],\n              "Eq-Value": [\n                "12"\n              ],\n              "Eq-Comparison": [\n                "<12 g/dL"\n              ],\n              "Observation": [\n                "blood products"\n              ],\n              "Eq-Unit": [\n                "g",\n                "dL"\n              ]\n            }\n          }\n        }\n      }\n    },\n    "right": {\n      "OR": {\n        "left": {\n          "raw_text": "- Preoperative use of anticoagulant therapy within five days before surgery,",\n          "Procedure": [\n            "operative",\n            "anticoagulant therapy",\n            "surgery"\n          ],\n          "Eq-Operator": [\n            "within"\n          ],\n          "Eq-Temporal-Unit": [\n            "days"\n          ],\n          "Eq-Value": [\n            "five"\n          ],\n          "Eq-Comparison": [\n            "within five days"\n          ],\n          "Procedure-Name": [\n            "anticoagulant therapy",\n            "surgery"\n          ]\n        },\n        "right": {\n          "OR": {\n            "left": {\n              "raw_text": "fibrinolytic disorders requiring intraoperative antifibrinolytic treatment, coagulopathy (as identified by a preoperative platelet count of <150,000/mm3,",\n              "Eq-Operator": [\n                "<"\n              ],\n              "Eq-Value": [\n                "15,000"\n              ],\n              "Eq-Comparison": 