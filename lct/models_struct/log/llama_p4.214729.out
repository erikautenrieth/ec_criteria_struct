     "-"\n                      ],\n                      "Eq-Temporal-Period": [\n                        "Currently taking"\n                      ],\n                      "Drug-Name": [\n                        "prostaglandin analogue"\n                      ]\n                    }\n                  }\n                },\n                "right": {\n                  "raw_text": "- Presence of an epiretinal membrane on the preoperative OCT.",\n                  "Condition": [\n                    "epiretinal membrane"\n                  ],\n                  "Procedure": [\n                    "OCT",\n                    "operative"\n                  ],\n                  "Eq-Operator": [\n                    "-"\n                  ],\n                  "Condition-Name": [\n                    "epiretinal membrane"\n                  ],\n                  "Procedure-Name": [\n                    "OCT"\n                  ]\n                }\n              }\n            },\n            "right": {\n              "raw_text": "- Retained lens fragment post-operatively.",\n              "Condition": [\n                "Retained lens fragment"\n              ],\n              "Eq-Operator": [\n                "-"\n              ],\n              "Procedure": [\n                "operatively"\n              ],\n              "Condition-Name": [\n                "Retained lens fragment"\n              ],\n              "Procedure-Name": [\n                "operatively"\n              ]\n            }\n          }\n        },\n        "right": {\n          "AND": {\n            "left": {\n              "raw_text": "-",\n              "Eq-Operator": [\n                "-"\n              ]\n            },\n            "right": {\n              "NOT": {\n                "left": {\n                  "raw_text": "Inability to return for follow appointments",\n                  "Assertion": [\n                    "Inability"\n                  ],\n                  "Encount