                              "left": {\n                                  "raw_text": "2. malignancy",\n                                  "Condition": [\n                                    "malignancy"\n                                  ],\n                                  "Condition-Name": [\n                                    "malignancy"\n                                  ]\n                                },\n                                "right": {\n                                  "AND": {\n                                    "left": {\n                                      "raw_text": "or life-threatening illness",\n                                      "Death": [\n                                        "life-threatening"\n                                      ],\n                                      "Condition": [\n                                        "illness"\n                                      ],\n                                      "Condition-Name": [\n                                        "illness"\n                                      ],\n                                      "Risk": [\n                                        "life-threatening"\n                                      ]\n                                    },\n                                    "right": {\n                                      "raw_text": "with life expectancy of <5 years;",\n                                      "Observation": [\n                                        "life expectancy"\n                                      ],\n                                      "Eq-Comparison": [\n                                        "<5 years"\n                                      ],\n                                      "Observation-Name": [\n                                        "life expectancy"\n                                      ],\n                                      "Eq-Operator": [\n                                        "<"\n             