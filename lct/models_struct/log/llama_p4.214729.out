 with chronic ankle pain or instability sensation\n3. Ultrasound diagnosed anterior talofibular ligament sprain\n\n### Response:\n{\n  "AND": {\n    "left": {\n      "AND": {\n        "left": {\n          "raw_text": "1. 20-70 age",\n          "Age": [\n            "age"\n          ],\n          "Eq-Comparison": [\n            "20-70"\n          ],\n          "Eq-Value": [\n            "20",\n            "70"\n          ],\n          "Eq-Operator": [\n            "-"\n          ]\n        },\n        "right": {\n          "OR": {\n            "left": {\n              "raw_text": "2. Chronic ankle sprain more than 3months with chronic ankle pain",\n              "Eq-Comparison": [\n                "more than 3months"\n              ],\n              "Observation": [\n                "ankle pain",\n                "ankle sprain"\n              ],\n              "Acuteness": [\n                "Chronic"\n              ],\n              "Eq-Operator": [\n                "more than",\n                "-"\n              ],\n              "Eq-Value": [\n                "3"\n              ],\n              "Eq-Temporal-Unit": [\n                "months"\n              ],\n              "Observation-Name": [\n                "ankle pain",\n                "ankle sprain"\n              ]\n            },\n            "right": {\n              "raw_text": "or instability sensation",\n              "Condition": [\n                "instability"\n              ],\n              "Condition-Name": [\n                "instability"\n              ]\n            }\n          }\n        }\n      }\n    },\n    "right": {\n      "raw_text": "3. Ultrasound diagnosed anterior talofibular ligament sprain",\n      "Procedure": [\n        "Ultrasound"\n      ],\n      "Observation": [\n        "anterior talofibular ligament sprain"\n      ],\n      "Procedure-Name": [\n        "Ultrasound"\n      ],\n      "Observation-Name": [\n        "anterior talofibular ligament sprain"\n      ]\n    }\n  }\n}<|eot_id|>']
