              "Condition": [
                "HBV-infected",
                "pregnancy"
              ],
              "Condition-Name": [
                "HBV-infected"
              ],
              "Modifier": [
                "pre"
              ]
            },
            "right": {
              "raw_text": "or present)；",
              "Modifier": [
                "present"
              ]
            }
          }
        }
      }
    },
    "right": {
      "raw_text": "- Children is vaccinated with hepatitis B vaccine after birth;",
      "Life-Stage-And-Gender": [
        "Children"
      ],
      "Eq-Value": [
        "one"
      ],
      "Observation": [
        "vaccinated"
      ],
      "Immunization": [
        "hepatitis B vaccine"
      ],
      "Birth": [
        "birth"
      ],
      "Observation-Name": [
        "vaccinated"
      ],
      "Immunization-Name": [
