right": {\n                                                      "raw_text": "or ongoing infection",\n                                                      "Condition": [\n                                                        "infection"\n                                                      ],\n                                                      "Condition-Name": [\n                                                        "infection"\n                                                      ],\n                                                      "Eq-Comparison": [\n                                                        "ongoing"\n                                                      ],\n                                                      "Eq-Temporal-Period": [\n                                                        "ongoing"\n                                                      ]\n                                                    }\n                                                  }\n                                                }\n                                              }\n                                            },\n                                            "right": {\n                                              "OR": {\n                                                "left": {\n                                                  "raw_text": "- Clinically significant cardiovascular,",\n                                                  "Modifier": [\n                                                    "cardiovascular"\n                                                  ],\n                                                  "Severity": [\n                                                    "significant"\n                                                  ]\n                                                },\n                                                "right": {\n                                                  "OR": {\n                                                    "left": {\n                                                      "raw_text": "lung,",\n                                                      "Modifier": [\n                                                        "lung"\n                                                      ]\n                                                    },\n                                                    "right": {\n                                                      "OR": {\n                                                        "left": {\n                                                          "raw_text": "renal,",\n                                                          "Modifier": [\n                                                            "renal"\n                                                          ]\n                                                        },\n                                                        "right": {\n                                                          "raw_text": "hepatic or endocrine disease,",\n                                                          "Condition": [\n                                                            "disease"\n                                                          ],\n                                                          "Modifier": [\n                                                            "hepatic",\n                                                            "endocrine"\n                                                          ]\n                                                        }\n                                                      }\n                                                    }\n                                                  }\n                                                }\n                                              }\n                                            }\n                                          }\n                      