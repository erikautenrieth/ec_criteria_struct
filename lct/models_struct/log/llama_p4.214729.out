                                  }\n                                }\n                              }\n                            }\n                          }\n                        },\n                        "right": {\n                          "raw_text": "- Patient with hepatic impairment,",\n                          "Condition": [\n                            "hepatic impairment"\n                          ],\n                          "Condition-Name": [\n                            "hepatic impairment"\n                          ],\n                          "Eq-Operator": [\n                            "-"\n                          ]\n                        }\n                      }\n                    },\n                    "right": {\n                      "raw_text": "- Patient with dry mouth,",\n                      "Condition": [\n                        "dry mouth"\n                      ],\n                      "Condition-Name": [\n                        "dry mouth"\n                      ],\n                      "Eq-Operator": [\n                        "-"\n                      ]\n                    }\n                  }\n                },\n                "right": {\n                  "OR": {\n                    "left": {\n                      "raw_text": "- Patient relevant a suboptimal hearing incompatible with musicotherapy",\n                      "Condition": [\n                        "suboptimal hearing"\n                      ],\n                      "Procedure": [\n                        "musicotherapy"\n                      ],\n                      "Condition-Name": [\n                        "suboptimal hearing"\n                      ],\n                      "Procedure-Name": [\n                        "musicotherapy"\n                      ],\n                      "Eq-Operator": [\n                        "-"\n                      ]\n                    },\n                    "right": {\n                