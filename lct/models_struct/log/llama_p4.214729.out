of stroke and without CO detection.\nIn case of unusable data, patient will be excluded from study.\n\n### Response:\n{\n  "AND": {\n    "left": {\n      "AND": {\n        "left": {\n          "raw_text": "- Pregnant woman;",\n          "Condition": [\n            "Pregnant"\n          ],\n          "Condition-Name": [\n            "Pregnant"\n          ],\n          "Life-Stage-And-Gender": [\n            "woman"\n          ]\n        },\n        "right": {\n          "AND": {\n            "left": {\n              "raw_text": "- Patient present clinical signes of stroke",\n              "Condition": [\n                "stroke"\n              ],\n              "Condition-Name": [\n                "stroke"\n              ],\n              "Eq-Operator": [\n                "to"\n              ]\n            },\n            "right": {\n              "AND": {\n                "left": {\n                  "raw_text": "and"\n                },\n                "right": {\n                  "NOT": {\n                    "left": {\n                      "raw_text": "without CO detection.",\n                      "Observation": [\n                        "CO detection"\n                      ],\n                      "Observation-Name": [\n                        "CO detection"\n                      ],\n                      "Negation": [\n                        "without"\n                      ]\n                    }\n                  }\n                }\n              }\n            }\n          }\n        }\n      }\n    },\n    "right": {\n      "raw_text": "In case of unusable data, patient will be excluded from study.",\n      "Eq-Operator": [\n        "to"\n      ]\n    }\n  }\n}<|eot_id|>']
