ery\n-  Pregnant women or nursing mothers\n-  Persons deprived of liberty by judicial or administrative decision\n-  Persons unable to express their consent or legally protected\n-  Persons in period of disqualification for another interventional research\n\n### Response:\n{\n  "AND": {\n    "left": {\n      "AND": {\n        "left": {\n          "AND": {\n            "left": {\n              "AND": {\n                "left": {\n                  "raw_text": "- Patient not eligible for deep brain stimulation surgery",\n                  "Procedure": [\n                    "deep brain stimulation surgery"\n                  ],\n                  "Procedure-Name": [\n                    "deep brain stimulation surgery"\n                  ],\n                  "Assertion": [\n                    "eligible for"\n                  ],\n                  "Negation": [\n                    "not"\n                  ]\n                },\n                "right": {\n                  "OR": {\n                    "left": {\n                      "raw_text": "- Pregnant women",\n                      "Condition": [\n                        "Pregnant"\n                      ],\n                      "Condition-Name": [\n                        "Pregnant"\n                      ],\n                      "Life-Stage-And-Gender": [\n                        "women"\n                      ]\n                    },\n                    "right": {\n                      "raw_text": "or nursing mothers",\n                      "Condition": [\n                        "nursing"\n                      ],\n                      "Condition-Name": [\n                        "nursing"\n                      ],\n                      "Life-Stage-And-Gender": [\n                        "mothers"\n                      ]\n                    }\n                  }\n                }\n              }\n            },\n            "right": {\n              "raw_text": "- Persons deprived of liberty by judicial or administrative decision",\n              "Observation": [\n                "deprived of liberty"\n              ],\n              "Observation-Name": [\n                "deprived of liberty"\n              ]\n            }\n          }\n        },\n        "right": {\n          "raw_text": "- Persons unable to express their consent or legally protected",\n          "Observation": [\n            "legally protected"\n          ],\n          "Observation-Name": [\n            "legally protected"\n          ]\n        }\n      }\n    },\n    "right": {\n      "raw_text": "- Persons in period of disqualification for another interventional research",\n      "Other": [\n        "another"\n      ],\n      "Procedure": [\n        "interventional"\n      ],\n      "Procedure-Name": [\n        "interventional"\n      ]\n    }\n  }\n}<|eot_id|>']
