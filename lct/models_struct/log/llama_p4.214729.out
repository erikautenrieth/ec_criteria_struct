          "Condition-Name": [
            "arthritis"
          ]
        },
        "right": {
          "OR": {
            "left": {
              "raw_text": "Lyme disease,",
              "Condition": [
                "Lyme disease"
              ],
              "Condition-Name": [
                "Lyme disease"
              ]
            },
            "right": {
              "OR": {
                "left": {
                  "raw_text": "microcrystalline arthritis",
                  "Condition": [
