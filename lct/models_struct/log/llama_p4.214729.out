              ],
              "Life-Stage-And-Gender": [
                "females"
              ]
            }
          }
        },
        "right": {
          "raw_text": "- Having received professional periodontal treatment (other than supragingival cleaning) within the previous 12 months.",
          "Procedure": [
            "periodontal treatment",
            "supragingival cleaning"
          ],
          "Procedure-Name": [
            "periodontal treatment",
            "supragingival cleaning"
          ],
          "Eq-Operator": [
            "within"
          ],
          "Eq-Temporal-Unit": [
            "months"
          ],
          "Eq-Comparison": [
            "within the previous 12 months",
            "received"
          ],
          "Eq-Temporal-Period": [
            "received"
          ]
        }
      }
    },
    "right": {
