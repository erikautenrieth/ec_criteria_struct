e infections\n-  Patients with hemodynamic instability\n-  Amputees\n-  Patients with cognitive impairment\n-  Patients with acute renal failure\n-  Patients with graft loss\n\n### Response:\n{\n  "AND": {\n    "left": {\n      "AND": {\n        "left": {\n          "AND": {\n            "left": {\n              "AND": {\n                "left": {\n                  "AND": {\n                    "left": {\n                      "AND": {\n                        "left": {\n                          "raw_text": "- Allergies known to diuretics",\n                          "Allergy": [\n                            "Allergies"\n                          ],\n                          "Drug": [\n                            "diuretics"\n                          ],\n                          "Drug-Name": [\n                            "diuretics"\n                          ],\n                          "Eq-Operator": [\n                            "-"\n                          ]\n                        },\n                        "right": {\n                          "raw_text": "- Patients with severe infections",\n                          "Condition": [\n                            "infections"\n                          ],\n                          "Severity": [\n                            "severe"\n                          ],\n                          "Condition-Name": [\n                            "infections"\n                          ],\n                          "Eq-Operator": [\n                            "-"\n                          ]\n                        }\n                      }\n                    },\n                    "right": {\n                      "raw_text": "- Patients with hemodynamic instability",\n                      "Condition": [\n                        "hemodynamic"\n                      ],\n                      "Condition-Name": [\n                        "hemodynamic"\n                      ],\n                      "Stability": [\n                        "instability"\n                      ],\n                      "Eq-Operator": [\n                        "-"\n                      ]\n                    }\n                  }\n                },\n                "right": {\n                  "raw_text": "- Amputees",\n                  "Condition": [\n                    "Amputees"\n                  ],\n                  "Eq-Operator": [\n                    "-"\n                  ],\n                  "Condition-Name": [\n                    "Amputees"\n                  ]\n                }\n              }\n            },\n            "right": {\n              "raw_text": "- Patients with cognitive impairment",\n              "Condition": [\n                "cognitive impairment"\n              ],\n              "Eq-Operator": [\n                "-"\n              ],\n              "Condition-Name": [\n                "cognitive impairment"\n              ]\n            }\n          }\n        },\n        "right": {\n          "raw_text": "- Patients with acute renal failure",\n          "Condition": [\n            "renal failure"\n          ],\n          "Acuteness": [\n            "acute"\n          ],\n          "Eq-Operator": [\n            "-"\n          ],\n          "Condition-Name": [\n            "renal failure"\n          ]\n        }\n      }\n    },\n    "right": {\n      "raw_text": "- Patients with graft loss",\n      "Condition": [\n        "graft"\n      ],\n      "Observation": [\n        "loss"\n      ],\n      "Eq-Operator": [\n        "-"\n      ],\n      "Condition-Name": [\n        "graft"\n      ],\n      "Observation-Name": [\n        "loss"\n      ]\n    }\n  }\n}<|eot_id|>']
