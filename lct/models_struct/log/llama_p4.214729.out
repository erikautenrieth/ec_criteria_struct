evice\n-  Age ≥ 18 years\n-  Ability to understand the study information and information on usage of personal data\n-  Signed and dated informed consent\n\n### Response:\n{\n  "AND": {\n    "left": {\n      "AND": {\n        "left": {\n          "AND": {\n            "left": {\n              "raw_text": "- Prescription of a Narval CC mandibular advancement device",\n              "Drug": [\n                "Narval CC mandibular advancement device"\n              ],\n              "Drug-Name": [\n                "Narval CC mandibular advancement device"\n              ]\n            },\n            "right": {\n              "raw_text": "- Age ≥ 18 years",\n              "Age": [\n                "Age"\n              ],\n              "Eq-Comparison": [\n                "≥ 18 years"\n              ],\n              "Eq-Operator": [\n                "≥"\n              ],\n              "Eq-Value": [\n                "18"\n              ],\n              "Eq-Temporal-Unit": [\n                "years"\n              ]\n            }\n          }\n        },\n        "right": {\n          "raw_text": "- Ability to understand the study information and information on usage of personal data"\n        }\n      }\n    },\n    "right": {\n      "raw_text": "- Signed and dated informed consent"\n    }\n  }\n}<|eot_id|>']
