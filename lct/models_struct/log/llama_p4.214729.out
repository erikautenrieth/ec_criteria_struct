t from reaching normal developmental milestones will participation, including congenital malformations or prematurity requiring prolonged/ ongoing infant hospitalization.\n\n### Response:\n{\n  "AND": {\n    "left": {\n      "raw_text": "- Any condition that might",\n      "Condition": [\n        "condition"\n      ],\n      "Assertion": [\n        "might"\n      ]\n    },\n    "right": {\n      "NOT": {\n        "left": {\n          "OR": {\n            "left": {\n              "raw_text": "prevent the father\'s infant from reaching normal developmental milestones will participation, including congenital malformations",\n              "Family-Member": [\n                "infant"\n              ],\n              "Negation": [\n                "prevent"\n              ],\n              "Observation": [\n                "developmental milestones"\n              ],\n              "Observation-Name": [\n                "developmental milestones"\n              ],\n              "Condition": [\n                "congenital malformations"\n              ],\n              "Condition-Name": [\n                "congenital malformations"\n              ]\n            },\n            "right": {\n              "raw_text": "or prematurity requiring prolonged/ ongoing infant hospitalization.",\n              "Condition": [\n                "prematurity"\n              ],\n              "Condition-Name": [\n                "prematurity"\n              ],\n              "Encounter": [\n                "hospitalization"\n              ],\n              "Eq-Comparison": [\n                "ongoing"\n              ],\n              "Eq-Temporal-Period": [\n                "ongoing"\n              ]\n            }\n          }\n        }\n      }\n    }\n  }\n}<|eot_id|>']
