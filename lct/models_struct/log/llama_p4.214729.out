"\n                                  ],\n                                  "Eq-Operator": [\n                                    "-"\n                                  ],\n                                  "Condition-Name": [\n                                    "posterior capsular rupture"\n                                  ]\n                                },\n                                "right": {\n                                  "OR": {\n                                    "left": {\n                                      "raw_text": "vitreous loss,",\n                                      "Condition": [\n                                        "vitreous loss"\n                                      ],\n                                      "Condition-Name": [\n                                        "vitreous loss"\n                                      ]\n                                    },\n                                    "right": {\n                                      "OR": {\n                                        "left": {\n                                          "raw_text": "zonular dialysis,",\n                                          "Condition": [\n                                            "zonular dialysis"\n                                          ],\n                                          "Condition-Name": [\n                                            "zonular dialysis"\n                                          ]\n                                        },\n                                        "right": {\n                                          "raw_text": "or iris trauma.",\n                                          "Observation": [\n                                            "trauma"\n                                          ],\n                                          "Observation-Name": [\n                                            "trauma"\n                                          ],\n                        