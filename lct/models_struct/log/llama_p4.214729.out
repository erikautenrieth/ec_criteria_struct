tion.\n-  Patients who have vertebra surgery or have plan of surgery.\n-  Patients who are inappropriate to join this trial judged by the radiologists or specialists.\n-  AIDS, Active Hepatitis, Tuberculosis, Syphilis\n-  Patients who regularly take anticoagulants, antiplatelet drugs\n\n### Response:\n{\n  "AND": {\n    "left": {\n      "AND": {\n        "left": {\n          "AND": {\n            "left": {\n              "AND": {\n                "left": {\n                  "OR": {\n                    "left": {\n                      "raw_text": "- Patients who are in pregnancy",\n                      "Condition": [\n                        "pregnancy"\n                      ],\n                      "Condition-Name": [\n                        "pregnancy"\n                      ],\n                      "Eq-Comparison": [\n                        "in"\n                      ],\n                      "Eq-Temporal-Period": [\n                        "in"\n                      ]\n                    },\n                    "right": {\n                      "raw_text": "or have plan to conception.",\n                      "Condition": [\n                        "conception"\n                      ],\n                      "Condition-Name": [\n                        "conception"\n                      ],\n                      "Eq-Comparison": [\n                        "plan"\n                      ],\n                      "Eq-Temporal-Period": [\n                        "plan"\n                      ],\n                      "Assertion": [\n                        "plan to"\n                      ]\n                    }\n                  }\n                },\n                "right": {\n                  "OR": {\n                    "left": {\n                      "raw_text": "- Patients who have vertebra surgery",\n                      "Procedure": [\n                        "vertebra surgery"\n                      ],\n                      "Procedure-Name": [\n                        "vertebra surgery"\n                      ]\n                    },\n                    "right": {\n                      "raw_text": "or have plan of surgery.",\n                      "Procedure": [\n                        "surgery"\n                      ],\n                      "Procedure-Name": [\n                        "surgery"\n                      ],\n                      "Eq-Comparison": [\n                        "plan"\n                      ],\n                      "Eq-Temporal-Period": [\n                        "plan"\n                      ],\n                      "Assertion": [\n                        "plan of"\n                      ]\n                    }\n                  }\n                }\n              }\n            },\n            "right": {\n              "AND": {\n                "left": {\n                  "raw_text": "- Patients who are"\n                },\n                "right": {\n                  "NOT": {\n                    "left": {\n                      "OR": {\n                        "left": {\n                          "raw_text": "inappropriate to join this trial judged by the radiologists",\n                          "Provider": [\n                            "radiologists"\n                          ],\n                          "Eq-Comparison": [\n                            "in"\n                          ],\n                          "Eq-Temporal-Period": [\n                            "in"\n                          ],\n                          "Negation": [\n                            "inappropriate"\n                          ]\n                        },\n                        "right": {\n                          "raw_text": "or specialists.",\n                          "Provider": [\n                            "specialists"\n                          ]\n                        }\n                      }\n                    }\n                  }\n               