                               }\n                                    }\n                                  }\n                                }\n                              }\n                            }\n                          }\n                        },\n                        "right": {\n                          "OR": {\n                            "left": {\n                              "raw_text": "- Amblyopia,",\n                              "Condition": [\n                                "Amblyopia"\n                              ],\n                              "Condition-Name": [\n                                "Amblyopia"\n                              ]\n                            },\n                            "right": {\n                              "raw_text": "strabismus",\n                              "Condition": [\n                                "strabismus"\n                              ],\n                              "Condition-Name": [\n                                "strabismus"\n                              ]\n                            }\n                          }\n                        }\n                      }\n                    },\n                    "right": {\n                      "raw_text": "- Extremely shallow anterior chamber",\n                      "Condition": [\n                        "shallow anterior chamber"\n                      ],\n                      "Condition-Name": [\n                        "shallow anterior chamber"\n                      ],\n                      "Severity": [\n                        "Extremely"\n                      ]\n                    }\n                  }\n                },\n                "right": {\n                  "OR": {\n                    "left": {\n                      "raw_text": "- Capsule",\n                      "Condition": [\n                        "Capsule"\n                      ],\n                      "Condition-Name": [\n                        "Capsule"\n                      ]\n                    },\n                    "right": {\n                      "OR": {\n                        "left": {\n                          "raw_text": "or zonular abnormalities that may affect postoperative centration",\n                          "Procedure": [\n                            "operative"\n                          ],\n                          "Condition": [\n                            "abnormalities",\n                            "centration"\n                          ],\n                          "Observation": [\n                            "affect"\n                          ],\n                          "Assertion": [\n                            "may"\n                          ],\n                          "Condition-Name": [\n                            "abnormalities",\n                            "centration"\n                          ],\n                          "Modifier": [\n                            "zonular"\n                          ],\n                          "Stability": [\n                            "affect"\n                          ]\n                        },\n                        "right": {\n                          "OR": {\n                            "left": {\n                              "raw_text": "or tilt of the lens (e.g. pseudoexfoliation syndrome, uveitis,",\n                              "Condition": [\n                                "lens",\n                                "pseudoexfoliation syndrome",\n                                "uveitis"\n                              ],\n                              "Observation": [\n                                "tilt"\n                              ],\n                              "Condition-Name": [\n                                "lens",\n                                "pseudoexfoliation syndrome",\n                                "uveitis"\n                              ],\n             