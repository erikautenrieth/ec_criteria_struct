articipate and sign the informed consent\n-  Patients whose molar teeth are diagnosed as molar incisor hypomineralization by EAPD\n-  Teeth that are fully erupted\n-  Patients who have at least two permanent first molars that need fissure sealant\n-  Teeth that have white-yellow-brown discoloration that indicate high-caries risk\n\n### Response:\n{\n  "AND": {\n    "left": {\n      "AND": {\n        "left": {\n          "AND": {\n            "left": {\n              "AND": {\n                "left": {\n                  "raw_text": "- Patients and parents of the patients who accept to participate and sign the informed consent"\n                },\n                "right": {\n                  "raw_text": "- Patients whose molar teeth are diagnosed as molar incisor hypomineralization by EAPD",\n                  "Condition": [\n                    "molar incisor hypomineralization"\n                  ],\n                  "Condition-Name": [\n                    "molar incisor hypomineralization"\n                  ],\n                  "Eq-Operator": [\n                    "-"\n                  ]\n                }\n              }\n            },\n            "right": {\n              "raw_text": "- Teeth that are fully erupted",\n              "Condition": [\n                "fully erupted"\n              ],\n              "Eq-Operator": [\n                "-"\n              ],\n              "Condition-Name": [\n                "fully erupted"\n              ]\n            }\n          }\n        },\n        "right": {\n          "AND": {\n            "left": {\n              "raw_text": "- Patients who have at least two permanent first molars that need fissure sealant",\n              "Eq-Comparison": [\n                "at least two"\n              ],\n              "Eq-Operator": [\n                "-",\n                "at least"\n              ],\n              "Procedure": [\n                "fissure sealant"\n              ],\n              "Eq-Value": [\n                "two"\n              ],\n              "Condition": [\n                "permanent first molars"\n              ],\n              "Procedure-Name": [\n                "fissure sealant"\n              ],\n              "Condition-Name": [\n                "permanent first molars"\n              ]\n            },\n            "right": {\n              "AND": {\n                "left": {\n                  "raw_text": "- Teeth that have white-yellow-brown discoloration that indicate",\n                  "Eq-Operator": [\n                    "-"\n                  ],\n                  "Observation": [\n                    "white-yellow-brown discoloration"\n                  ],\n                  "Observation-Name": [\n                    "white-yellow-brown discoloration"\n                  ],\n                  "Assertion": [\n                    "indicate"\n                  ]\n                },\n                "right": {\n                  "raw_text": "high-caries risk",\n                  "Condition": [\n                    "caries"\n                  ],\n                  "Risk": [\n                    "risk"\n                  ],\n                  "Condition-Name": [\n                    "caries"\n                  ],\n                  "Polarity": [\n                    "high"\n                  ]\n                }\n              }\n            }\n          }\n        }\n      }\n    },\n    "right": {\n      "raw_text": "- Teeth that have white-yellow-brown discoloration that indicate high-caries risk",\n      "Condition": [\n        "caries"\n      ],\n      "Risk": [\n        "risk"\n      ],\n      "Observation": [\n        "white-yellow-brown discoloration"\n      ],\n      "Assertion": [\n        "indicate"\n      ],\n      "Eq-Operator": [\n        "-"\n      ],\n      "Condition-Name": [\n        "caries"\n      ],\n      "Observation-Name": [\n        "white-yellow-brown discoloration"\n      ],\n      "Polarity": [\n        "high"\