      "Modifier": [\n                                        "possible"\n                                      ]\n                                    }\n                                  }\n                                }\n                              }\n                            },\n                            "right": {\n                              "raw_text": "3. a score of 2 or greater on the speech question of the ALSFRS-R (i.e. speech is intelligible with occasional repetition),",\n                              "Condition": [\n                                "speech"\n                              ],\n                              "Eq-Comparison": [\n                                "2 or greater"\n                              ],\n                              "Eq-Value": [\n                                "2"\n                              ],\n                              "Eq-Operator": [\n                                "or greater"\n                              ],\n                              "Observation": [\n                                "ALSFRS-R",\n                                "speech question"\n                              ],\n                              "Observation-Name": [\n                                "ALSFRS-R",\n                                "speech question"\n                              ],\n                              "Condition-Name": [\n                                "speech"\n                              ]\n                            }\n                          }\n                        },\n                        "right": {\n                          "raw_text": "4. continuous internet access at home,"\n                        }\n                      }\n                    },\n                    "right": {\n                      "raw_text": "5. willingness and medical ability to comply with scheduled visits and study procedures,"\n                    }\n                  }\n                },\n                "right": {\n                  "raw_text": "6. ability to understand the purpose and risks of the study and provide signed and dated informed consent and authorization to use protected health information (PHI) in accordance with national and local subject privacy regulations,"\n                }\n              }\n            },\n            "right": {\n              "raw_text": "7. geographic accessibility to study site,"\n            }\n          }\n        },\n        "right": {\n          "AND": {\n            "left": {\n              "raw_text": "8. for the 25 participants in Group 1,",\n              "Eq-Value": [\n                "2"\n              ]\n            },\n            "right": {\n              "AND": {\n                "left": {\n                  "raw_text": "NO noted symptoms of frontotemporal cognitive dysfunction, and",\n                  "Condition": [\n                    "frontotemporal cognitive dysfunction",\n                    "cognitive"\n                  ],\n                  "Condition-Name": [\n                    "frontotemporal cognitive dysfunction"\n                  ],\n                  "Assertion": [\n                    "symptoms"\n                  ],\n                  "Negation": [\n                    "NO"\n                  ]\n                },\n                "right": {\n                  "NOT": {\n                    "left": {\n                      "raw_text": "noted either by themselves",\n                      "Negation": [\n                        "not"\n                      ]\n                    }\n                  }\n                }\n              }\n            }\n          }\n        }\n      }\n    },\n    "right": {\n      "raw_text": "9. for the 25 participants in Group 2, MUST have cognitive symptoms as noted either by themselves or a caregiver.",\n      "Condition": [\n        "cognitive"\n      ],\n      "Assertion": [\n        "symptoms"\n      ],\n      "Eq-Value": [\n        "2"\n      ],\n      "Condition-Name": [\n        "cognitive"\n      ],\n      "Family-Member": [\n        "caregiver"\n      ]\n    }\n  }\n}<|eot_id|>']
