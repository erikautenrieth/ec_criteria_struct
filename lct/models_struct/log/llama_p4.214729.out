],\n                                                                  "Condition-Name": [\n                                                                    "neuropathy"\n                                                                  ],\n                                                                  "Polarity": [\n                                                                    "abnormal"\n                                                                  ],\n                                                                  "Procedure-Name": [\n                                                                    "neurological examination"\n                                                                  ]\n                                                                }\n                                                              }\n                                                            },\n                                                            "right": {\n                                                              "raw_text": "- Patient presenting a pathology that could cause neuropathy (e.g. diabetes, renal failure, etc.).",\n                                                              "Condition": [\n                                                                "pathology",\n                                                                "neuropathy",\n                                                                "diabetes",\n                                                                "renal failure"\n                                                              ],\n                                                              "Assertion": [\n                                                                "could"\n                                                              ],\n                                                              "Condition-Name": [\n                                                                "pathology",\n                                                                "neuropathy",\n                                                                "diabetes",\n                                                                "renal failure"\n                                                              ]\n                                                        },\n                                                        "right": {\n                                                          "raw_text": "- Patient already participating in a category 1 research study (Jardé law).",\n                                                          "Study": [\n                                                            "study"\n                                                          ]\n                                                        }\n                                                      }\n                                                    },\n                                                    "right": {\n                                                      "raw_text": "- Patient in an exclusion period determined by another study.",\n                                                      "Study": [\n                                                        "study"\n                                                      ],\n                                                      "Negation": [\n                                                        "exclusion"\n                                                      ]\n                                                    }\n                                                  }\n                                                },\n                                                "right": {\n                                                  "OR": {\n                                                    "left": {\n                                                      "raw_text": "- Patient under the protection of justice,",\n                                                      "Observation": [\n                                                        "under the protection of justice"\n                                                      ],\n                                                      "Observation-Name": [\n                                                        "under the protection of justice"\n                                                      ]\n                                                    },\n                                                    "right": {\n                                                      "OR": {\n                                                        "left": {\n                                                          "raw_text": "under guardianship",\n                                                          "Observation": [\n                                                            "under guardianship"\n                                                          ],\n                                                          "Observation-Name": [\n                                                            "under guardianship"\n                                                          ]\n                                                        },\n                                                        "right": {\n                                                          "raw_text": "or under curatorship.",\n                                                          "Observation": [\n                                                            "under curatorship"\n                                                          ],\n                                                          "Observation-Name": [\n                                                            "under curatorship"\n                                                          ]\n                                                        }\n                                                      }\n                                                    }\n                                                  }\n                                                }\n                                              }\n                                            },\n                                            "right": {\n                                              "raw_text": "- Patient refusing to sign the consent form."\n                                            }\n                                          }\n                                        },\n                                        "right": {\n                                          "raw_text": "- Patient for which it is impossible to provide information about the study.",\n                                          "Study": [\n                                            "study"\n                                          ]\n                                        }\n                                      }\n                                    },\n                                    "right": {\n                                      "OR": {\n                                        "left": {\n                                          "raw_text": "- Pregnant patient, parturient,",\n                                          "Condition": [\n                                            "Pregnant",\n                                            "parturient"\n                                          ],\n                                          "Condition-Name": [\n                                            "Pregnant",\n                                            "parturient"\n                                          ]\n                                        },\n                                        "right": {\n                                          "raw_text": "or breastfeeding.",\n                                          "Condition": [\n                                            "breastfeeding"\n    