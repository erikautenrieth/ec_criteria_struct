ondition": [\n                            "neurological disease",\n                            "Parkinson",\n                            "MS"\n                          ],\n                          "Condition-Name": [\n                            "neurological disease",\n                            "Parkinson",\n                            "MS"\n                          ]\n                        }\n                      }\n                    }\n                  }\n                },\n                "right": {\n                  "raw_text": "- Mini Mental Test Score, 18 to 24 points from being scored",\n                  "Observation": [\n                    "Mini Mental Test Score"\n                  ],\n                  "Eq-Comparison": [\n                    "18 to 24 points"\n                  ],\n                  "Observation-Name": [\n                    "Mini Mental Test Score"\n                  ],\n                  "Eq-Value": [\n                    "18",\n                    "24"\n                  ],\n                  "Eq-Operator": [\n                    "to"\n                  ],\n                  "Eq-Unit": [\n                    "points"\n                  ]\n                }\n              }\n            },\n            "right": {\n              "raw_text": "- being 65-80 aged.",\n              "Eq-Comparison": [\n                "65-80 aged"\n              ],\n              "Eq-Value": [\n                "65",\n                "80"\n              ],\n              "Eq-Operator": [\n                "-"\n              ],\n              "Age": [\n                "aged"\n              ]\n            }\n          }\n        },\n        "right": {\n          "raw_text": "being 65-80 aged.",\n          "Eq-Comparison": [\n            "65-80 aged"\n          ],\n          "Eq-Value": [\n            "65",\n            "80"\n          ],\n          "Eq-Operator": [\n            "-"\n          ],\n          "Age": [\n            "aged"\n          ]\