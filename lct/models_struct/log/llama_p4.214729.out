      "Procedure-Name": [\n                        "MRI"\n                      ]\n                    }\n                  }\n                }\n              }\n            },\n            "right": {\n              "raw_text": "4. The tumor is suitable for resection (according to neurosurgeon)",\n              "Condition": [\n                "tumor"\n              ],\n              "Condition-Name": [\n                "tumor"\n              ],\n              "Procedure": [\n                "resection"\n              ],\n              "Procedure-Name": [\n                "resection"\n              ]\n            }\n          }\n        },\n        "right": {\n          "raw_text": "5. Karnofsky performance scale 80 or more",\n          "Observation": [\n            "Karnofsky performance scale"\n          ],\n          "Observation-Name": [\n            "Karnofsky performance scale"\n          ],\n          "Eq-Value": [\n            "80"\n          ],\n          "Eq-Comparison": [\n            "80 or more"\n          ],\n          "Eq-Operator": [\n            "or more"\n          ]\n        }\n      }\n    },\n    "right": {\n      "raw_text": "6. Written Informed consent"\n    }\n  }\n}<|eot_id|>']
