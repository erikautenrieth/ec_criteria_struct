"-"\n                              ]\n                            }\n                          }\n                        },\n                        "right": {\n                          "raw_text": "- Diagnosis of any malignencies,",\n                          "Condition": [\n                            "malignencies"\n                          ],\n                          "Condition-Name": [\n                            "malignencies"\n                          ],\n                          "Eq-Operator": [\n                            "-"\n                          ]\n                        }\n                      }\n                    },\n                    "right": {\n                      "raw_text": "- Chronic kidney failure,",\n                      "Condition": [\n                        "kidney failure"\n                      ],\n                      "Condition-Name": [\n                        "kidney failure"\n                      ],\n                      "Eq-Operator": [\n                        "-"\n                      ],\n                      "Acuteness": [\n                        "Chronic"\n                      ]\n                    }\n                  }\n                },\n                "right": {\n                  "raw_text": "- Presence of metabolic syndrome,",\n                  "Condition": [\n                    "metabolic syndrome"\n                  ],\n                  "Condition-Name": [\n                    "metabolic syndrome"\n                  ],\n                  "Eq-Operator": [\n                    "-"\n                  ]\n                }\n              }\n            },\n            "right": {\n              "OR": {\n                "left": {\n                  "raw_text": "- Presence of psychiatric diseases",\n                  "Condition": [\n                    "psychiatric diseases"\n                  ],\n                  "Condition-Name": [\n                    "psychiatric diseases"\n                  ],\n                  "Eq-Operator": [\n                    "-"\n                  ]\n                },\n                "right": {\n                  "raw_text": "and/or medical treatment,",\n                  "Procedure": [\n                    "medical treatment"\n                  ]\n                }\n              }\n            }\n          }\n        },\n        "right": {\n          "raw_text": "- Smoking",\n          "Observation": [\n            "Smoking"\n          ],\n          "Observation-Name": [\n            "Smoking"\n          ],\n          "Eq-Operator": [\n            "-"\n          ]\n        }\n      }\n    },\n    "right": {\n      "OR": {\n        "left": {\n          "raw_text": "- History of pelvic surgery,",\n          "Eq-Comparison": [\n            "History"\n          ],\n          "Procedure": [\n            "pelvic surgery"\n          ],\n          "Eq-Operator": [\n            "-"\n          ],\n          "Eq-Temporal-Period": [\n            "History"\n          ],\n          "Procedure-Name": [\n            "pelvic surgery"\n          ]\n        },\n        "right": {\n          "OR": {\n            "left": {\n              "raw_text": "cardiac surgery",\n              "Procedure": [\n                "cardiac surgery"\n              ],\n              "Procedure-Name": [\n                "cardiac surgery"\n              ]\n            },\n            "right": {\n              "raw_text": "and pelvic radiotherapy",\n              "Procedure": [\n                "pelvic radiotherapy"\n              ],\n              "Procedure-Name": [\n                "pelvic radiotherapy"\n              ]\n            }\n          }\n        }\n      }\n    }\n  }\n}<|eot_id|>']
