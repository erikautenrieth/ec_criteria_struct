              ],
              "Eq-Comparison": [
                "< 70%",
                "< 50%"
              ],
              "Severity": [
                "Severe"
              ]
            },
            "right": {
              "raw_text": "- Informed consent"
            }
          }
        },
        "right": {
          "raw_text": "- Affiliation to a social security scheme"
        }
      }
    },
    "right": {
