       }\n                  }\n                },\n                "right": {\n                  "OR": {\n                    "left": {\n                      "raw_text": "- Participants with selected acute",\n                      "Acuteness": [\n                        "acute"\n                      ]\n                    },\n                    "right": {\n                      "raw_text": "or chronic infections or infection history.",\n                      "Condition": [\n                        "Infection"\n                      ],\n                      "Condition-Name": [\n                        "Infection"\n                      ],\n                      "Eq-Comparison": [\n                        "history"\n                      ],\n                      "Eq-Temporal-Period": [\n                        "history"\n                      ],\n                      "Acuteness": [\n                        "chronic"\n                      ]\n                    }\n                  }\n                }\n              }\n            },\n            "right": {\n              "AND": {\n                "left": {\n                  "raw_text": "- Participants have a known present",\n                  "Eq-Comparison": [\n                    "present"\n                  ],\n                  "Eq-Temporal-Period": [\n                    "present"\n                  ]\n                },\n                "right": {\n                  "OR": {\n                    "left": {\n                      "raw_text": "or a history of malignancy other than a successfully treated",\n                      "Condition": [\n                        "malignancy"\n                      ],\n                      "Condition-Name": [\n                        "malignancy"\n                      ],\n                      "Eq-Comparison": [\n                        "history"\n                      ],\n                      "Eq-Temporal-Period": [\n                        "history"\n                      ],\n                      "Procedure": [\n                        "treated"\n                      ],\n                      "Exception": [\n                        "other than"\n                      ]\n                    },\n                    "right": {\n                      "raw_text": "or excised non metastatic basal cell or squamous cell cancer of the skin.",\n                      "Condition": [\n                        "cancer"\n                      ],\n                      "Condition-Name": [\n                        "cancer"\n                      ],\n                      "Modifier": [\n                        "metastatic",\n                        "basal cell",\n                        "squamous cell",\n                        "skin"\n                      ],\n                      "Procedure": [\n                        "excised"\n                      ],\n                      "Exception": [\n                        "non"\n                      ]\n                    }\n                  }\n                }\n              }\n            }\n          }\n        },\n        "right": {\n          "OR": {\n            "left": {\n              "raw_text": "- History of alcohol abuse",\n              "Condition": [\n                "alcohol abuse"\n              ],\n              "Condition-Name": [\n                "alcohol abuse"\n              ],\n              "Eq-Comparison": [\n                "History"\n              ],\n              "Eq-Temporal-Period": [\n                "History"\n              ]\n            },\n            "right": {\n              "OR": {\n                "left": {\n                  "raw_text": "or binge drinking",\n                  "Condition": [\n                    "binge drinking"\n                  ],\n                  "Condition-Name": [\n                    "binge drinking"\n                  ]\n                },\n                "right": {\n                  "OR": {\n                    "left": {\n                      "raw_text": "and/or any other illicit drug use",\n                      "Drug": [\n                        "illicit drug"\n                      ],\n                      "Drug-Name": [\n                        "illicit drug"\n                      ]\n                    },\n                    "right": {\n                      "raw_text": "or dependence within 6 months prior to dosing or positive urine cotinine test.",\n                      "Condition": [\n                        "dependence"\n                      ],\n                      "Condition-Name": [\n                        "dependence"\n                      ],\n                      "Eq-Operator": [\n                        "within"\n                      ],\n                      "Eq-Temporal-Unit": [\n                        "months"\n                      ],\n                      "Eq-Value": [\n                        "6"\n                      ],\n                      "Eq-Comparison": [\n                        "within 6 months"\n                      ],\n                      "Observation": [\n                        "urine cotinine test"\n                      ],\n                      "Observation-Name": [\n                        "urine cotinine test"\n                      ],\n                      "Polarity": [\n                        "positive"\n                      ],\n                      "Study": [\n                        "dosing"\n                      ]\n                    }\n                  }\n                }\n              }\n            }\n          }\n        }\n      }\n    },\n    "right": {\n      "raw_text": "- Use of tobacco/nicotine containing products within 3 months prior to dosing or positive urine cotinine test.",\n      "Eq-Operator": [\n        "within"\n      ],\n      "Eq-Temporal-Unit": [\n        "months"\n      ],\n      "Eq-Value": [\n        "3"\n      ],\n      "Eq-Comparison": [\n        "within 3 months"\n      ],\n      "Observation": [\n        "urine cotinine test"\n      ],\n      "Observation-Name": [\n        "urine cotinine test"\n      ],\n      "Polarity": [\n        "positive"\n      ],\n      "Condition": [\n        "tobacco"\n      ],\n      "Condition-Name": [\n        "tobacco"\n      ],\n      "Drug": [\n        "nicotine"\n      ],\n      "Drug-Name": [\n        "nicotine"\n      ],\n      "Study": [\n        "dosing"\n      ]\n    }\n  }\n}<|eot_id|>']
