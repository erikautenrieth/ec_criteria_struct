he previous 12 month\n-  vegetarian or vegan\n-  presence of chronic disease\n-  pregnant, postpartum up to six months, lactating, or intention to become pregnant\n-  allergy to whey or soy\n-  changes in body weight more than 10 pounds in the past three months\n\n### Response:\n{\n  "AND": {\n    "left": {\n      "AND": {\n        "left": {\n          "AND": {\n            "left": {\n              "AND": {\n                "left": {\n                  "AND": {\n                    "left": {\n                      "raw_text": "- participated in structured weight training during the previous 12 month",\n                      "Eq-Temporal-Unit": [\n                        "month"\n                      ],\n                      "Eq-Value": [\n                        "12"\n                      ],\n                      "Observation": [\n                        "structured weight training"\n                      ],\n                      "Observation-Name": [\n                        "structured weight training"\n                      ],\n                      "Eq-Comparison": [\n                        "previous 12 month"\n                      ],\n                      "Eq-Temporal-Period": [\n                        "previous"\n                      ]\n                    },\n                    "right": {\n                      "OR": {\n                        "left": {\n                          "raw_text": "- vegetarian",\n                          "Condition": [\n                            "vegetarian"\n                          ],\n                          "Condition-Name": [\n                            "vegetarian"\n                          ]\n                        },\n                        "right": {\n                          "raw_text": "or vegan",\n                          "Condition": [\n                            "vegan"\n                          ],\n                          "Condition-Name": [\n                            "vegan"\n                          ]\n                        }\n                      }\n                    }\n                  }\n                },\n                "right": {\n                  "raw_text": "- presence of chronic disease",\n                  "Condition": [\n                    "chronic disease"\n                  ],\n                  "Condition-Name": [\n                    "chronic disease"\n                  ]\n                }\n              }\n            },\n            "right": {\n              "OR": {\n                "left": {\n                  "raw_text": "- pregnant,",\n                  "Condition": [\n                    "pregnant"\n                  ],\n                  "Condition-Name": [\n                    "pregnant"\n                  ]\n                },\n                "right": {\n                  "OR": {\n                    "left": {\n                      "raw_text": "postpartum up to six months,",\n                      "Condition": [\n                        "postpartum"\n                      ],\n                      "Eq-Comparison": [\n                        "up to six months"\n                      ],\n                      "Condition-Name": [\n                        "postpartum"\n                      ],\n                      "Eq-Operator": [\n                        "up to"\n                      ],\n                      "Eq-Value": [\n                        "six"\n                      ],\n                      "Eq-Temporal-Unit": [\n                        "months"\n                      ]\n                    },\n                    "right": {\n                      "OR": {\n                        "left": {\n                          "raw_text": "lactating,",\n                          "Condition": [\n                            "lactating"\n                          ],\n                          "Condition-Name": [\n                            "lactating"\n                          ]\n                        },\n                        "right": {\n                          "raw_text": "or intention to become pregnant",\n                          "Condition": [\n                            "pregnant"\n                          ],\n                          "Assertion": [\n                            "intention to"\n                          ],\n                          "Condition-Name": [\n                            "pregnant"\n                          ]\n                        }\n                      }\n                    }\n                  }\n                }\n              }\n            }\n          }\n        },\n        "right": {\n          "OR": {\n            "left": {\n              "raw_text": "- allergy to whey",\n              "Allergy": [\n                "allergy"\n              ],\n              "Modifier": [\n                "whey"\n              ]\n            },\n            "right": {\n              "raw_text": "or soy",\n              "Modifier": [\n                "soy"\n              ]\n            }\n          }\n        }\n      }\n    },\n    "right": {\n      "raw_text": "- changes in body weight more than 10 pounds in the past three months",\n      "Eq-Operator": [\n        "more than"\n      ],\n      "Eq-Value": [\n        "10",\n        "three"\n      ],\n      "Eq-Comparison": [\n        "more than 10 pounds",\n        "past three months"\n      ],\n      "Observation": [\n        "body weight"\n      ],\n      "Observation-Name": [\n        "body weight"\n      ],\n      "Eq-Temporal-Unit": [\n        "months"\n      ],\n      "Stability": [\n        "changes"\n      ],\n      "Eq-Unit": [\n        "pounds"\n      ],\n      "Eq-Temporal-Period": [\n        "past"\n      ]\n    }\n  }\n}<|eot_id|>']
