ng rehabilitating programme at Hvidovre and Bispebjerg Hospital\n-  over 18 years\n\n### Response:\n{\n  "AND": {\n    "left": {\n      "AND": {\n        "left": {\n          "raw_text": "- Diagnosed with COPD",\n          "Condition": [\n            "COPD"\n          ],\n          "Condition-Name": [\n            "COPD"\n          ]\n        },\n        "right": {\n          "AND": {\n            "left": {\n              "raw_text": "- Participating in ongoing lung rehabilitating programme at Hvidovre",\n              "Eq-Comparison": [\n                "ongoing"\n              ],\n              "Procedure": [\n                "lung rehabilitating programme"\n              ],\n              "Eq-Temporal-Period": [\n                "ongoing"\n              ],\n              "Procedure-Name": [\n                "lung rehabilitating programme"\n              ],\n              "Location": [\n                "Hvidovre"\n              ]\n            },\n            "right": {\n              "raw_text": "and Bispebjerg Hospital",\n              "Location": [\n                "Bispebjerg Hospital"\n              ]\n            }\n          }\n        }\n      }\n    },\n    "right": {\n      "raw_text": "- over 18 years",\n      "Eq-Comparison": [\n        "over 18 years"\n      ],\n      "Eq-Operator": [\n        "over"\n      ],\n      "Eq-Value": [\n        "18"\n      ],\n      "Eq-Temporal-Unit": [\n        "years"\n      ],\n      "Age": [\n        "years"\n      ]\n    }\n  }\n}<|eot_id|>']
