             "right": {\n                      "NOT": {\n                        "left": {\n                          "raw_text": "non- approved investigational medicinal product within 24 weeks prior to initiation of NovoMix® 30 treatment. Clinical trials do not include non-interventional studies",\n                          "Eq-Operator": [\n                            "within"\n                          ],\n                          "Eq-Temporal-Unit": [\n                            "weeks"\n                          ],\n                          "Eq-Value": [\n                            "24"\n                          ],\n                          "Eq-Comparison": [\n                            "within 24 weeks"\n                          ],\n                          "Drug": [\n                            "NovoMix® 30",\n                            "medicinal product"\n                          ],\n                          "Drug-Name": [\n                            "NovoMix® 30",\n                            "medicinal product"\n                          ],\n                          "Procedure": [\n                            "treatment"\n                          ],\n                          "Negation": [\n                            "non"\n                          ],\n                          "Study": [\n                            "Clinical trials",\n                            "clinical trial",\n                            "studies",\n                            "trial"\n                          ],\n                          "Modifier": [\n                            "approved",\n                            "investigational"\n                          ],\n                          "Eq-Temporal-Recency": [\n                            "initiation"\n                          ]\n                        }\n                      }\n                    }\n                  }\n                }\n              }\n            }\n          }\n        },\n        "right": {\n          "OR": {\n            "left": {\n              "raw_text": "- Hypersensitivity to NovoMix® 30",\n              "Condition": [\n                "Hypersensitivity"\n              ],\n              "Condition-Name": [\n                "Hypersensitivity"\n              ],\n              "Drug": [\n                "NovoMix® 30"\n              ],\n              "Drug-Name": [\n                "NovoMix® 30"\n              ]\n            },\n            "right": {\n              "raw_text": "or to any of the excipients",\n              "Drug": [\n                "excipients"\n              ],\n              "Drug-Name": [\n                "excipients"\n              ]\n            }\n          }\n        }\n      }\n    },\n    "right": {\n      "OR": {\n        "left": {\n          "raw_text": "- Pregnancy",\n          "Condition": [\n            "Pregnancy"\n          ],\n          "Condition-Name": [\n            "Pregnancy"\n          ]\n        },\n        "right": {\n          "raw_text": "or intention of becoming pregnant",\n          "Condition": [\n            "pregnant"\n          ],\n          "Condition-Name": [\n            "pregnant"\n          ],\n          "Assertion": [\n            "intention"\n          ]\n        }\n      }\n    }\n  }\n}<|eot_id|>']
