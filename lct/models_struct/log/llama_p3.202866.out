8 years old at the time of hospitalization\n3. With sepsis as defined by the Sepsis-3 (2016) consensus as a known or suspected infection with a SOFA score of ≥2 points above baseline\n4. Received broad-spectrum antibiotics within the last 24 hours or ordered and pending administration\n5. Able to complete enrollment within 4 hours of ICU admission for administration of the intervention within 6 hours of ICU admission\n\n### Response:\n{\n  "AND": {\n    "left": {\n      "AND": {\n        "left": {\n          "AND": {\n            "left": {\n              "AND": {\n                "left": {\n                  "raw_text": "1. Hospitalized in an eligible medical ICU",\n                  "Encounter": [\n                    "Hospitalized"\n                  ],\n                  "Location": [\n                    "ICU"\n                  ],\n                  "Eq-Value": [\n                    "1"\n                  ]\n                },\n                "right": {\n                  "raw_text": "2. Age ≥ 18 years old at the time of hospitalization",\n                  "Age": [\n                    "Age"\n                  ],\n                  "Eq-Comparison": [\n                    "≥ 18 years"\n                  ],\n                  "Eq-Operator": [\n                    "≥"\n                  ],\n                  "Eq-Value": [\n                    "18"\n                  ],\n                  "Eq-Temporal-Unit": [\n                    "years"\n                  ],\n                  "Encounter": [\n                    "hospitalization"\n                  ]\n                }\n              }\n            },\n            "right": {\n              "AND": {\n                "left": {\n                  "raw_text": "3. With sepsis as defined by the Sepsis-3 (2016) consensus",\n                  "Condition": [\n                    "sepsis"\n                  ],\n                  "Condition-Name": [\n                    "sepsis"\n                  ]\n                },\n                "right": {\n                  "OR": {\n                    "left": {\n                      "raw_text": "with a known",\n                      "Modifier": [\n                        "known"\n                      ]\n                    },\n                    "right": {\n                      "AND": {\n                        "left": {\n                          "raw_text": "or suspected infection",\n                          "Assertion": [\n                            "suspected"\n                          ],\n                          "Condition": [\n                            "infection"\n                          ],\n                          "Condition-Name": [\n                            "infection"\n                          ]\n                        },\n                        "right": {\n                          "raw_text": "with a SOFA score of ≥2 points above baseline",\n                          "Eq-Comparison": [\n                            "≥2 points"\n                          ],\n                          "Observation": [\n                            "SOFA"\n                          ],\n                          "Eq-Operator": [\n                            "≥",\n                            "above"\n                          ],\n                          "Eq-Value": [\n                            "2"\n                          ],\n                          "Eq-Unit": [\n                            "points"\n                          ],\n                          "Observation-Name": [\n                            "SOFA"\n                          ],\n                          "Modifier": [\n                            "baseline"\n                          ]\n                        }\n                      }\n                    }\n                  }\n                }\n              }\n            }\n          }\n        },\n        "right": {\n          "raw_text": "4. Received broad-spectrum antibiotics within the last 24 hours or ordered and pending administration",\n          "Eq-Comparison": [\n            "within the last 24 hours",\n            "Received"\n          ],\n          "Drug": [\n            "antibiotics"\n          ],\n          "Eq-Operator": [\n            "within"\n          ],\n          "Eq-Temporal-Period": [\n            "Received",\n            "last"\n          ],\n          "Eq-Value": [\n            "24"\n          ],\n          "Eq-Temporal-Unit": [\n            "hours"\n          ],\n          "Drug-Name": [\n            "antibiotics"\n          ],\n          "Modifier": [\n            "broad-spectrum",\n            "ordered and pending administration"\n          ]\n        }\n      }\n    },\n    "right": {\n      "raw_text": "5. Able to complete enrollment within 4 hours of ICU admission for administration of the intervention within 6 hours of ICU admission",\n      "Eq-Comparison": [\n        "within 4 hours",\n        "within 6 hours",\n        "admission"\n      ],\n      "Eq-Operator": [\n        "within"\n      ],\n      "Eq-Value": [\n        "4",\n        "6"\n      ],\n      "Eq-Temporal-Unit": [\n        "hours"\n      ],\n      "Study": [\n        "enrollment"\n      ],\n      "Location": [\n        "ICU"\n      ],\n      "Encounter": [\n        "admission"\n      ],\n      "Procedure": [\n        "intervention"\n      ],\n      "Assertion": [\n        "Able to"\n      ],\n      "Procedure-Name": [\n        "intervention"\n      ]\n    }\n  }\n}<|eot_id|>']
