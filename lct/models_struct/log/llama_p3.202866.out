 Response:\n{\n  "AND": {\n    "left": {\n      "raw_text": "- Prior colorectal cancer",\n      "Eq-Comparison": [\n        "Prior"\n      ],\n      "Condition": [\n        "cancer"\n      ],\n      "Modifier": [\n        "colorectal"\n      ],\n      "Eq-Temporal-Period": [\n        "Prior"\n      ],\n      "Condition-Name": [\n        "cancer"\n      ]\n    },\n    "right": {\n      "raw_text": "- Dialysis patient",\n      "Procedure": [\n        "Dialysis"\n      ],\n      "Procedure-Name": [\n        "Dialysis"\n      ]\n    }\n  }\n}<|eot_id|>']
