1.73m\n-  Without replacement therapy (dialysis or hemodialysis)\n-  Volume overload\n-  At least 100 ml per day of residual diuresis\n-  Use of a loop diuretic for at least one month\n\n### Response:\n{\n  "AND": {\n    "left": {\n      "AND": {\n        "left": {\n          "AND": {\n            "left": {\n              "AND": {\n                "left": {\n                  "raw_text": "- glomerular filtration rate less than 30 ml / min / 1.73m",\n                  "Eq-Operator": [\n                    "less than"\n                  ],\n                  "Eq-Value": [\n                    "30"\n                  ],\n                  "Eq-Comparison": [\n                    "less than 30 ml / min / 1.73m"\n                  ],\n                  "Observation": [\n                    "glomerular filtration rate"\n                  ],\n                  "Observation-Name": [\n                    "glomerular filtration rate"\n                  ],\n                  "Eq-Unit": [\n                    "ml",\n                    "1.73m"\n                  ],\n                  "Eq-Temporal-Unit": [\n                    "min"\n                  ]\n                },\n                "right": {\n                  "AND": {\n                    "left": {\n                      "raw_text": "-"\n                    },\n                    "right": {\n                      "NOT": {\n                        "left": {\n                          "OR": {\n                            "left": {\n                              "raw_text": "Without replacement therapy (dialysis",\n                              "Procedure": [\n                                "replacement therapy",\n                                "dialysis"\n                              ],\n                              "Procedure-Name": [\n                                "replacement therapy",\n                                "dialysis"\n                              ],\n                              "Negation": [\n    