        "Drug-Name": [\n                        "cannabidiol",\n                        "CBD"\n                      ],\n                      "Negation": [\n                        "non"\n                      ]\n                    }\n                  }\n                }\n              }\n            }\n          }\n        }\n      }\n    },\n    "right": {\n      "raw_text": "- Exposure to any other investigational drug within 30 days or fewer than 5 half-lives prior to screening",\n      "Eq-Operator": [\n        "within",\n        "fewer than"\n      ],\n      "Eq-Temporal-Unit": [\n        "days",\n        "half-lives"\n      ],\n      "Eq-Value": [\n        "30",\n        "5"\n      ],\n      "Eq-Comparison": [\n        "within 30 days",\n        "fewer than 5 half-lives"\n      ],\n      "Study": [\n        "screening",\n        "investigational"\n      ],\n      "Drug": [\n        "drug"\n      ],\n      "Other": [\n        "other"\n      ]\n    }\n  }\n}<|eot_id|>']
