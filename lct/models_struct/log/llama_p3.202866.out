art disease"\n                                                      ],\n                                                      "Condition-Name": [\n                                                        "structural heart disease"\n                                                      ],\n                                                      "Modifier": [\n                                                        "hemodynamically affected"\n                                                      ]\n                                                    }\n                                                  }\n                                                }\n                                              }\n                                            },\n                                            "right": {\n                                              "OR": {\n                                                "left": {\n                                                  "raw_text": "- 3. Patients with severe renal impairment",\n                                                  "Condition": [\n                                                    "renal impairment"\n                                                  ],\n                                                  "Condition-Name": [\n                                                    "renal impairment"\n                                                  ],\n                                                  "Severity": [\n                                                    "severe"\n                                                  ]\n                                                },\n                                                "right": {\n                                                  "raw_text": "or CT imaging difficulty using contrast media",\n                                                  "Procedure": [\n                                                    "CT imaging",\n                                        