                                 "raw_text": "lung,",\n                                                          "Modifier": [\n                                                            "lung"\n                                                          ]\n                                                        },\n                                                        "right": {\n                                                          "OR": {\n                                                            "left": {\n                                                              "raw_text": "liver,",\n                                                              "Modifier": [\n                                                                "liver"\n                                                              ]\n                                                            },\n                                                            "right": {\n                                                              "raw_text": "pancreas, or small bowel) in the past 6 months or likely within the next 6 months",\n                                                              "Eq-Temporal-Unit": [\n                                                                "months"\n                                                              ],\n                                                              "Modifier": [\n                                                                "pancreas",\n                                                                "small bowel"\n                                                              ],\n                                                              "Eq-Comparison": [\n                                                                "past 6 months",\n                                                                "within the next 6 months"\n                                                              ],\n                                                              "Eq-Value": [\n                                                                "6"\n                                                              ],\n                                                              "Eq-Temporal-Period": [\n                                                                "past",\n                                                                "within"\n                                                              ],\n                                                              "Assertion": [\n                                                                "likely"\n                                                              ]\n                                                            }\n                                                          }\n                                                        }\n                                                      }\n                                                    }\n                                                  }\n                                                }\n                                              }\n                                            }\n                                          }\n                                        }\n                                      }\n                                    }\n                                  }\n                                },\n                                "right": {\n                                  "raw_text": "- Previous episode of sepsis during that hospital admission",\n                                  "Condition": [\n                                    "sepsis"\n                                  ],\n                                  "Encounter": [\n                                    "hospital admission"\n                                  ],\n                                  "Eq-Comparison": [\n                                    "Previous"\n                                  