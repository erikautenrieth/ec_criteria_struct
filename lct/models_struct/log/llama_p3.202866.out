teria of CAPS and have pathogenic mutation(s) in NLRP3 gene.\n1. Raised inflammatory markers (CRP/SAA) (mandatory criteria)\n2. ≥2 of 6 CAPS typical signs/symptoms:\n1. Urticaria-like rash;\n2. Cold/stress triggered episodes;\n3. Sensorineural hearing loss;\n4. Musculoskeletal symptoms (arthralgia/arthritis/myalgia);\n5. Chronic aseptic meningitis;\n6. Skeletal abnormalities (epiphyseal overgrowth/frontal bossing).\n\n### Response:\n{\n  "AND": {\n    "left": {\n      "AND": {\n        "left": {\n          "AND": {\n            "left": {\n              "AND": {\n                "left": {\n                  "AND": {\n                    "left": {\n                      "AND": {\n                        "left": {\n                          "AND": {\n                            "left": {\n                              "AND": {\n                                "left": {\n                                  "AND": {\n                                    "left": {\n                                      "raw_text": "- All patients must meet the following diagnostic criteria of CAPS",\n                                      "Condition": [\n                                        "CAPS"\n                                      ],\n                                      "Criteria-Count": [\n                                        "the following"\n                                      ],\n                                      "Condition-Name": [\n                                        "CAPS"\n                                      ]\n                                    },\n                                    "right": {\n                                      "raw_text": "and have pathogenic mutation(s) in NLRP3 gene.",\n                                      "Condition": [\n                                        "pathogenic mutation"\n                                      ],\n                                      "Condition-Name": [\n                                        "pathogenic mutation"\n                                      ],\n                                      "Modifier": [\n                                        "NLRP3 gene"\n                                      ]\n                                    }\n                                  }\n                                },\n                                "right": {\n                                  "OR": {\n                                    "left": {\n                                      "raw_text": "1. Raised inflammatory markers (CRP/",\n                                      "Observation": [\n                                        "CRP",\n                                        "inflammatory markers"\n                                      ],\n                                      "Observation-Name": [\n                                        "CRP",\n                                        "inflammatory markers"\n                                      ],\n                                      "Polarity": [\n                                        "Raised"\n                                      ]\n                                    },\n                                    "right": {\n                                      "raw_text": "SAA) (mandatory criteria)",\n                                      "Observation": [\n                                        "SAA"\n                                      ],\n                                      "Observation-Name": [\n                                        "SAA"\n                                      ]\n                                    }\n                                  }\n                                }\n                              }\n                            },\n                            "right": {\n                              "raw_text": "2. ≥2 of 6 CAPS typical signs/symptoms:",\n                              "Condition": [\n                                "CAPS"\n                              ],\n                              "Eq-Comparison": [\n                                "≥2 of 6"\n                              ],\n                              "Condition-Name": [\n                                "CAPS"\n                              ],\n                              "Eq-Operator": [\n                                "≥2"\n                              ],\n                              "Eq-Value": [\n                                "6"\n                              ],\n                              "Modifier": [\n                                "signs",\n                                "symptoms"\n                              ]\n                            }\n                          }\n                        },\n                        "right": {\n                          "raw_text": "1. Urticaria-like rash;",\n                          "Condition": [\n                            "Urticaria-like rash"\n                          ],\n                          "Condition-Name": [\n                            "Urticaria-like rash"\n                          ]\n                        }\n                      }\n                    },\n                    "right": {\n                      "OR": {\n                        "left": {\n                          "raw_text": "2. Cold/",\n                          "Modifier": [\n                            "Cold"\n                          ]\n                        },\n                        "right": {\n                          "raw_text": "stress triggered episodes;",\n                          "Modifier": [\n                            "stress"\n                          ]\n                        }\n                      }\n                    }\n                  }\n                },\n                "right": {\n                  "raw_text": "3. Sensorineural hearing loss;",\n                  "Condition": [\n                    "Sensorineural hearing loss"\n                  ],\n                  "Condition-Name": [\n                    "Sensorineural hearing loss"\n                  ]\n                }\n              }\n            },\n            "right": {\n              "OR": {\n                "left": {\n                  "raw_text": "4. Musculoskeletal symptoms (arthralgia/",\n                  "Modifier": [\n                    "Musculoskeletal",\n                    "symptoms"\n                  ],\n                  "Condition": [\n                    "arthralgia"\n                  ],\n                  "Condition-Name": [\n                    "arthralgia"\n                  ]\n                },\n                "right": {\n                  "OR": {\n                    "left": {\n                      "raw_text": "arthritis/",\n                      "Condition": [\n                        "arthritis"\n                      ],\n                      "Condition-Name": [\n                        "arthritis"\n                      ]\n                    },\n                    "right": {\n                      "raw_text": "myalgia);",\n                      "Condition": [\n                        "myalgia"\n                      ],\n                      "Condition-Name": [\n                        "myalgia"\n                      ]\n                    }\n                  }\n                }\n              }\n            }\n          }\n        },\n        "right": {\n          "raw_text": "5. Chronic aseptic meningitis;",\n          "Acuteness": [\n            "Chronic"\n          ],\n          "Condition": [\n            "aseptic meningitis"\n          ],\n          "Condition-Name": [\n            "aseptic meningitis"\n          ]\n        }\n      }\n    },\n    "right": {\n      "raw_text": "6. Skeletal abnormalities (epiphyseal overgrowth/frontal bossing).",\n      "Condition": [\n        "Skeletal abnormalities",\n        "epiphyseal overgrowth",\n        "frontal bossing"\n      ],\n      "Condition-Name": [\n        "Skeletal abnormalities",\n     