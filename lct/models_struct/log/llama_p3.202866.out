traindication to vaginal delivery (uterus bi or multi-cicatricial, corporal uterine scar, intra-mural myomectomy, dystocic presentation)\n-  Fetal macrosomia with a weight greater than 4Kg\n-  Placenta previa\n\n### Response:\n{\n  "AND": {\n    "left": {\n      "AND": {\n        "left": {\n          "AND": {\n            "left": {\n              "raw_text": "- singleton pregnancy",\n              "Condition": [\n                "pregnancy"\n              ],\n              "Condition-Name": [\n                "pregnancy"\n              ],\n              "Modifier": [\n                "singleton"\n              ]\n            },\n            "right": {\n              "AND": {\n                "left": {\n                  "raw_text": "- Cicatricial uterus",\n                  "Condition": [\n                    "Cicatricial uterus"\n                  ],\n                  "Condition-Name": [\n                    "Cicatricial uterus"\n                  ]\n                },\n                "right": {\n                  "raw_text": "with contraindication to vaginal delivery (uterus bi or multi-cicatricial, corporal uterine scar, intra-mural myomectomy, dystocic presentation)",\n                  "Procedure": [\n                    "vaginal delivery",\n                    "uterus bi",\n                    "intra-mural myomectomy"\n                  ],\n                  "Procedure-Name": [\n                    "vaginal delivery",\n                    "uterus bi",\n                    "intra-mural myomectomy"\n                  ],\n                  "Contraindication": [\n                    "contraindication"\n                  ],\n                  "Condition": [\n                    "cicatricial",\n                    "corporal uterine scar",\n                    "dystocic presentation"\n                  ],\n                  "Condition-Name": [\n                    "cicatricial",\n                    "corporal uterine scar",\n                    "dystocic presentation"\n                  ],\n                  "Modifier": [\n                    "multi-"\n                  ]\n                }\n              }\n            }\n          }\n        },\n        "right": {\n          "raw_text": "- Fetal macrosomia with a weight greater than 4Kg",\n          "Condition": [\n            "Fetal macrosomia"\n          ],\n          "Condition-Name": [\n            "Fetal macrosomia"\n          ],\n          "Eq-Operator": [\n            "greater than"\n          ],\n          "Eq-Value": [\n            "4"\n          ],\n          "Eq-Comparison": [\n            "greater than 4Kg"\n          ],\n          "Observation": [\n            "weight"\n          ],\n          "Observation-Name": [\n            "weight"\n          ],\n          "Eq-Unit": [\n            "Kg"\n          ]\n        }\n      }\n    },\n    "right": {\n      "raw_text": "- Placenta previa",\n      "Condition": [\n        "Placenta previa"\n      ],\n      "Condition-Name": [\n        "Placenta previa"\n      ]\n    }\n  }\n}<|eot_id|>']
