        "12 months"
      ],
      "Study": [
        "study"
      ],
      "Eq-Temporal-Period": [
        "prior"
      ]
    },
    "right": {
      "raw_text": "- Diagnosis of lung cancer indicated in problem list in the EHR.",
      "Condition": [
        "lung cancer"
      ],
      "Condition-Name": [
        "lung cancer"
      ]
    }
  }
}
