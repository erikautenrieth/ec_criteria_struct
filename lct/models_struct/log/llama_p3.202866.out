ion": [\n                                                                        "lithiasic cholecystitis"\n                                                                      ],\n                                                                      "Condition-Name": [\n                                                                        "lithiasic cholecystitis"\n                                                                      ]\n                                                                    }\n                                                                  }\n                                                                }\n                                                              }\n                                                            }\n                                                          }\n                                                        },\n                                                        "right": {\n                                                          "OR": {\n                                                            "left": {\n                                                              "raw_text": "- Hepatobiliary surgery",\n                                                              "Procedure": [\n                                                                "Hepatobiliary surgery"\n                                                              ],\n                                                              "Procedure-Name": [\n                                                                "Hepatobiliary surgery"\n                                                              ]\n                                                            },\n                                                            "right": {\n                                                              "raw_text": "or previous superior digestive tract.",\n                                                              "Eq-Com