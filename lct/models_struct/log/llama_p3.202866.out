tory disease besides asthma\n-  Receiving OMM from a licensed physician, chiropractic treatment, or massage therapy for 30 days prior to and during the study\n\n### Response:\n{\n  "AND": {\n    "left": {\n      "AND": {\n        "left": {\n          "raw_text": "- Current smoker",\n          "Observation": [\n            "smoker"\n          ],\n          "Observation-Name": [\n            "smoker"\n          ],\n          "Eq-Comparison": [\n            "Current"\n          ],\n          "Eq-Temporal-Period": [\n            "Current"\n          ]\n        },\n        "right": {\n          "raw_text": "- Diagnosed with any other respiratory disease besides asthma",\n          "Condition": [\n            "respiratory disease",\n            "asthma"\n          ],\n          "Condition-Name": [\n            "respiratory disease",\n            "asthma"\n          ],\n          "Exception": [\n            "besides"\n          ],\n          "Other": [\n            "other"\n          ]\n        }\n      }\n    },\n    "right": {\n      "OR": {\n        "left": {\n          "raw_text": "- Receiving OMM from a licensed physician, chiropractic treatment,",\n          "Procedure": [\n            "chiropractic treatment",\n            "OMM"\n          ],\n          "Procedure-Name": [\n            "chiropractic treatment",\n            "OMM"\n          ],\n          "Provider": [\n            "licensed physician"\n          ],\n          "Eq-Comparison": [\n            "Receiving"\n          ],\n          "Eq-Temporal-Period": [\n            "Receiving"\n          ]\n        },\n        "right": {\n          "raw_text": "or massage therapy for 30 days prior to and during the study",\n          "Procedure": [\n            "massage therapy"\n          ],\n          "Procedure-Name": [\n            "massage therapy"\n          ],\n          "Eq-Comparison": [\n            "30 days"\n          ],\n          "Eq-Value": [\n            "30"\n          ],\n          "Eq-Temporal-Unit"