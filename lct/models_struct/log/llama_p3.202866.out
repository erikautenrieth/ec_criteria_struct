       ],\n                          "Drug-Name": [\n                            "β2-receptor activator",\n                            "M-receptor blockers"\n                          ],\n                          "Procedure": [\n                            "Inhalation"\n                          ],\n                          "Procedure-Name": [\n                            "Inhalation"\n                          ]\n                        },\n                        "right": {\n                          "raw_text": "and/or glucocorticoids within one month before surgery;",\n                          "Procedure": [\n                            "surgery"\n                          ],\n                          "Procedure-Name": [\n                            "surgery"\n                          ],\n                          "Eq-Operator": [\n                            "within"\n                          ],\n                          "Eq-Temporal-Unit": [\n                            "month"\n                          ],\n                          "Drug": [\n                            "glucocorticoids"\n                          ],\n                          "Drug-Name": [\n                            "glucocorticoids"\n                          ],\n                          "Eq-Comparison": [\n                            "within one month",\n                            "one month"\n                          ],\n                          "Eq-Value": [\n                            "one"\n                          ]\n                        }\n                      }\n                    }\n                  }\n                },\n                "right": {\n                  "OR": {\n                    "left": {\n                      "raw_text": "5. Severe renal dysfunction (requirement of renal replacement therapy)",\n                      "Condition": [\n                        "renal dysfunction"\n                      ],\n                      "Condition-Name":