    "left": {
      "AND": {
        "left": {
          "AND": {
            "left": {
              "raw_text": "- 18 to 95 years of age",
              "Eq-Comparison": [
                "18 to 95 years"
              ],
              "Age": [
                "age"
              ],
              "Eq-Value": [
                "18",
                "95"
              ],
              "Eq-Operator": [
                "to"
              ],
              "Eq-Temporal-Unit": [
                "years"
              ]
            },
            "right": {
              "raw_text": "- Participation in WAVES Project for at least 3 months",
              "Eq-Comparison": [
                "at least 3 months"
              ],
              "Eq-Operator": [
                "at least"
              ],
              "Eq-Value": [
                "3"
              ],
              "Eq-Temporal-Unit": [
                "months"
              ],
              "Procedure": [
                "WAVES Project"
              ],
              "Procedure-Name": [
                "WAVES Project"
              ]
            }
          }
        },
        "right": {
          "raw_text": "- Completion of 3 open water dives",
          "Eq-Value": [
            "3"
          ],
          "Observation": [
