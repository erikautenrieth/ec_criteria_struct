                     "Condition": [\n                        "pregnancy"\n                      ],\n                      "Condition-Name": [\n                        "pregnancy"\n                      ]\n                    }\n                  }\n                },\n                "right": {\n                  "raw_text": "- in case of police custody"\n                }\n              }\n            },\n            "right": {\n              "raw_text": "- participation in a paralleled interventional RCT in a time frame of 30 days",\n              "Eq-Temporal-Unit": [\n                "days"\n              ],\n              "Eq-Value": [\n                "30"\n              ],\n              "Study": [\n                "RCT"\n              ],\n              "Eq-Comparison": [\n                "30 days"\n              ]\n            }\n          }\n        },\n        "right": {\n          "raw_text": "- chronic opioid therapy >3 months before scheduled surgery",\n          "Procedure": [\n            "surgery",\n            "opioid therapy"\n          ],\n          "Procedure-Name": [\n            "surgery",\n            "opioid therapy"\n          ],\n          "Eq-Operator": [\n            ">"\n          ],\n          "Eq-Temporal-Unit": [\n            "months"\n          ],\n          "Eq-Value": [\n            "3"\n          ],\n          "Eq-Comparison": [\n            ">3 months",\n            "scheduled"\n          ],\n          "Eq-Temporal-Period": [\n            "scheduled"\n          ],\n          "Acuteness": [\n            "chronic"\n          ]\n        }\n      }\n    },\n    "right": {\n      "OR": {\n        "left": {\n          "raw_text": "- allergy against medication required for surgery",\n          "Procedure": [\n            "surgery"\n          ],\n          "Procedure-Name": [\n            "surgery"\n          ],\n          "Drug": [\n            "medication"\n          ],\n          "Allergy": [\n            "allergy"\n          ]\n     