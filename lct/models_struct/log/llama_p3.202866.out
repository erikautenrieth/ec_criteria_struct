\n              ],\n              "Eq-Value": [\n                "8"\n              ],\n              "Eq-Unit": [\n                "score"\n              ],\n              "Observation-Name": [\n                "Overall Anxiety Severity and Impairment Scale",\n                "OASIS"\n              ],\n              "Anxiety": [\n                "Anxiety"\n              ]\n            }\n          }\n        },\n        "right": {\n          "raw_text": "4. Between 18-55 years of age",\n          "Eq-Temporal-Unit": [\n            "years"\n          ],\n          "Age": [\n            "age"\n          ],\n          "Eq-Value": [\n            "18",\n            "55"\n          ],\n          "Eq-Comparison": [\n            "Between 18-55 years"\n          ],\n          "Eq-Operator": [\n            "Between"\n          ]\n        }\n      }\n    },\n    "right": {\n      "AND": {\n        "left": {\n          "raw_text": "5. Subject must be \\"treatment-seeking\\"",\n          "Observation": [\n            "treatment-seeking"\n          ],\n          "Observation-Name": [\n            "treatment-seeking"\n          ]\n        },\n        "right": {\n          "raw_text": "and willing to enroll in the 10-week group-based Exposure Therapy",\n          "Procedure": [\n            "Exposure Therapy"\n          ],\n          "Eq-Comparison": [\n            "10-week"\n          ],\n          "Procedure-Name": [\n            "Exposure Therapy"\n          ],\n          "Eq-Value": [\n            "10"\n          ],\n          "Eq-Temporal-Unit": [\n            "week"\n          ],\n          "Assertion": [\n            "willing to"\n          ]\n        }\n      }\n    }\n  }\n}<|eot_id|>']
