              "Condition": [\n                "karyotype"\n              ],\n              "Condition-Name": [\n                "karyotype"\n              ],\n              "Polarity": [\n                "abnormal"\n              ]\n            }\n          }\n        },\n        "right": {\n          "raw_text": "- endometriosis stage III/IV;",\n          "Condition": [\n            "endometriosis"\n          ],\n          "Condition-Name": [\n            "endometriosis"\n          ],\n          "Eq-Comparison": [\n            "stage III/IV"\n          ],\n          "Eq-Unit": [\n            "stage"\n          ],\n          "Eq-Value": [\n            "III",\n            "IV"\n          ]\n        }\n      }\n    },\n    "right": {\n      "raw_text": "- history of recurrent miscarriage;",\n      "Condition": [\n        "miscarriage"\n      ],\n      "Condition-Name": [\n        "miscarriage"\n      ],\n      "Eq-Comparison": [\n        "history"\n      ],\n      "Eq-Temporal-Period": [\n        "history"\n      ],\n      "Modifier": [\n        "recurrent"\n      ]\n    }\n  }\n},\n"right": {\n  "OR": {\n    "left": {\n      "raw_text": "- severe OHSS in a previous stimulation cycle",\n      "Condition": [\n        "OHSS",\n        "stimulation"\n      ],\n      "Condition-Name": [\n        "OHSS",\n        "stimulation"\n      ],\n      "Eq-Comparison": [\n        "previous"\n      ],\n      "Eq-Temporal-Period": [\n        "previous"\n      ],\n      "Severity": [\n        "severe"\n      ]\n    },\n    "right": {\n      "raw_text": "or any contraindication for the use of gonadotrophins.",\n      "Contraindication": [\n        "contraindication"\n      ],\n      "Drug": [\n        "gonadotrophins"\n      ],\n      "Drug-Name": [\n        "gonadotrophins"\n      ]\n    }\n  }\n}\n}<|eot_id|>']
