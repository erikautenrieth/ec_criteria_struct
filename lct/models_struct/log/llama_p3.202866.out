imary metabolic disorder",\n                          "Condition": [\n                            "metabolic disorder"\n                          ],\n                          "Condition-Name": [\n                            "metabolic disorder"\n                          ],\n                          "Eq-Operator": [\n                            "-"\n                          ],\n                          "Modifier": [\n                            "Primary"\n                          ]\n                        }\n                      }\n                    },\n                    "right": {\n                      "raw_text": "- Sickle cell disease",\n                      "Condition": [\n                        "Sickle cell disease"\n                      ],\n                      "Condition-Name": [\n                        "Sickle cell disease"\n                      ],\n                      "Eq-Operator": [\n                        "-"\n                      ]\n                    }\n                  }\n                },\n                "right": {\n                  "OR": {\n                    "left": {\n                      "raw_text": "- Autosomal Dominant Polycystic Kidney Disease",\n                      "Condition": [\n                        "Polycystic Kidney Disease"\n                      ],\n                      "Condition-Name": [\n                        "Polycystic Kidney Disease"\n                      ],\n                      "Eq-Operator": [\n                        "-"\n                      ],\n                      "Modifier": [\n                        "Autosomal Dominant"\n                      ]\n                    },\n                    "right": {\n                      "raw_text": "- Cystinosis",\n                      "Condition": [\n                        "Cystinosis"\n                      ],\n                      "Condition-Name": [\n                        "Cystinosis"\n                      ],\n                      "Eq