reastfeeding woman",\n                                          "Condition": [\n                                            "parturient",\n                                            "breastfeeding"\n                                          ],\n                                          "Condition-Name": [\n                                            "parturient",\n                                            "breastfeeding"\n                                          ],\n                                          "Life-Stage-And-Gender": [\n                                            "woman"\n                                          ]\n                                        }\n                                      }\n                                    }\n                                  }\n                                },\n                                "right": {\n                                  "raw_text": "- adult unwilling or unable to consent",\n                                  "Life-Stage-And-Gender": [\n                                    "adult"\n                                  ]\n                                }\n                              }\n                            },\n                            "right": {\n                              "raw_text": "- patient who has already participated in the study",\n                              "Study": [\n                                "study"\n                              ]\n                            }\n                          }\n                        },\n                        "right": {\n                          "OR": {\n                            "left": {\n                              "raw_text": "- person with a physical",\n                              "Modifier": [\n                                "physical"\n                              ]\n                            },\n                            "right": {\n                              "raw_text": "or mental disability that does not allow participation.",\n                              "Condition": [\n                                "disability"\n                              ],\n                              "Condition-Name": [\n                                "disability"\n                              ],\n                              "Modifier": [\n                                "mental"\n                              ]\n                            }\n                          }\n                        }\n                      }\n                    },\n                    "right": {\n                      "raw_text": "- a person who has participated in any study of an experimental medical product within the previous 3 months",\n                      "Eq-Operator": [\n                        "within"\n                      ],\n                      "Eq-Temporal-Unit": [\n                        "months"\n                      ],\n                      "Eq-Value": [\n                        "3"\n                      ],\n                      "Study": [\n                        "study"\n                      ],\n                      "Eq-Comparison": [\n                        "within the previous 3 months"\n                      ],\n                      "Eq-Temporal-Period": [\n                        "previous"\n                      ],\n                      "Procedure": [\n                        "medical product"\n                      ],\n                      "Procedure-Name": [\n                        "medical product"\n                      ],\n                      "Modifier": [\n                        "experimental"\n                      ]\n                    }\n                  }\n                },\n                "right": {\n                  "raw_text": "- person who experiences any of the following during the ophthalmological examination:",\n                  "Procedure": [\n                    "ophthalmological examination"\n                  ],\n        