esponse:\n{\n  "AND": {\n    "left": {\n      "raw_text": "- Travellers diarrhoea",\n      "Condition": [\n        "Travellers diarrhoea"\n      ],\n      "Condition-Name": [\n        "Travellers diarrhoea"\n      ]\n    },\n    "right": {\n      "raw_text": "- foreign traveller",\n      "Observation": [\n        "foreign traveller"\n      ],\n      "Observation-Name": [\n        "foreign traveller"\n      ]\n    }\n  }\n}<|eot_id|>']
