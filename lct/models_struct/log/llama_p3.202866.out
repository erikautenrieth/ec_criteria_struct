     "Eq-Value": [\n                        "four"\n                      ]\n                    }\n                  }\n                },\n                "right": {\n                  "raw_text": "- Maximum anchorage required using mini-implant.",\n                  "Procedure": [\n                    "mini-implant",\n                    "Maximum anchorage"\n                  ],\n                  "Procedure-Name": [\n                    "mini-implant",\n                    "Maximum anchorage"\n                  ]\n                }\n              }\n            },\n            "right": {\n              "AND": {\n                "left": {\n                  "raw_text": "-"\n                },\n                "right": {\n                  "NOT": {\n                    "left": {\n                      "raw_text": "No systemic disease.",\n                      "Negation": [\n                        "No"\n                      ],\n                      "Condition": [\n                        "disease"\n                      ],\n                      "Modifier": [\n                        "systemic"\n                      ]\n                    }\n                  }\n                }\n              }\n            }\n          }\n        },\n        "right": {\n          "raw_text": "- Good oral hygiene.",\n          "Condition": [\n            "oral hygiene"\n          ],\n          "Condition-Name": [\n            "oral hygiene"\n          ],\n          "Polarity": [\n            "Good"\n          ]\n        }\n      }\n    },\n    "right": {\n      "AND": {\n        "left": {\n          "raw_text": "-"\n        },\n        "right": {\n          "NOT": {\n            "left": {\n              "raw_text": "No periodontal disease.",\n              "Negation": [\n                "No"\n              ],\n              "Condition": [\n                "periodontal disease",\n                "disease"\n              ],\n              "Condition-Name": [\n                "p