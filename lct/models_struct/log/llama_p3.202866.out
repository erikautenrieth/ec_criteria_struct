\n                          "Eq-Operator": [\n                            "to"\n                          ]\n                        },\n                        "right": {\n                          "raw_text": "and X-ray.",\n                          "Procedure": [\n                            "X-ray"\n                          ],\n                          "Procedure-Name": [\n                            "X-ray"\n                          ],\n                          "Eq-Operator": [\n                            "to"\n                          ]\n                        }\n                      }\n                    }\n                  }\n                }\n              }\n            }\n          }\n        },\n        "right": {\n          "AND": {\n            "left": {\n              "raw_text": "3. Bone scan positive,",\n              "Procedure": [\n                "Bone scan"\n              ],\n              "Procedure-Name": [\n                "Bone scan"\n              ],\n              "Polarity": [\n                "positive"\n              ],\n              "Eq-Operator": [\n                "to"\n              ]\n            },\n            "right": {\n              "OR": {\n                "left": {\n                  "raw_text": "with clinical symptoms, including bone pain,",\n                  "Modifier": [\n                    "bone"\n                  ],\n                  "Assertion": [\n                    "symptoms"\n                  ],\n                  "Condition": [\n                    "pain"\n                  ],\n                  "Condition-Name": [\n                    "pain"\n                  ],\n                  "Eq-Operator": [\n                    "to"\n                  ]\n                },\n                "right": {\n                  "OR": {\n                    "left": {\n                      "raw_text": "pathologic fracture,",\n                      "Condition": [\n                        "pathologic fracture"\n     