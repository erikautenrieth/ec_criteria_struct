which hinders the participation in the trial\n\n### Response:\n{\n  "AND": {\n    "left": {\n      "raw_text": "- Earlier parathyroidectomized",\n      "Procedure": [\n        "parathyroidectomized"\n      ],\n      "Procedure-Name": [\n        "parathyroidectomized"\n      ],\n      "Eq-Comparison": [\n        "Earlier"\n      ],\n      "Eq-Temporal-Period": [\n        "Earlier"\n      ]\n    },\n    "right": {\n      "raw_text": "- Other conditions, which hinders the participation in the trial",\n      "Condition": [\n        "conditions"\n      ],\n      "Other": [\n        "Other"\n      ],\n      "Study": [\n        "trial"\n      ],\n      "Stability": [\n        "hinders"\n      ]\n    }\n  }\n}<|eot_id|>']
