"ankle sprain"\n      ],\n      "Condition-Name": [\n        "ankle sprain"\n      ],\n      "Procedure": [\n        "Ultrasound"\n      ],\n      "Procedure-Name": [\n        "Ultrasound"\n      ]\n    }\n  }\n}<|eot_id|>']
