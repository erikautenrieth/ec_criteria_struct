            ],\n                                  "Eq-Temporal-Period": [\n                                    "history"\n                                  ],\n                                  "Procedure": [\n                                    "operative"\n                                  ]\n                                },\n                                "right": {\n                                  "raw_text": "or glaucoma;",\n                                  "Condition": [\n                                    "glaucoma"\n                                  ],\n                                  "Condition-Name": [\n                                    "glaucoma"\n                                  ]\n                                }\n                              }\n                            }\n                          }\n                        },\n                        "right": {\n                          "OR": {\n                            "left": {\n                              "raw_text": "3. History of myocardial infarction, severe heart dysfunction (New York Heart Association functional classification ≥ 3)",\n                              "Condition": [\n                                "myocardial infarction",\n                                "heart dysfunction"\n                              ],\n                              "Condition-Name": [\n                                "myocardial infarction",\n                                "heart dysfunction"\n                              ],\n                              "Eq-Operator": [\n                                "≥"\n                              ],\n                              "Eq-Value": [\n                                "3"\n                              ],\n                              "Eq-Comparison": [\n                                "≥ 3",\n                                "History"\n                              ],\n                              "Severity": [\n                  