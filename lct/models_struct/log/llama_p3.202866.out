V risk factors [overweight or obesity, i. e. body mass index (BMI) ≥25 kg/m2, and/or central obesity - waist circumference ≥88 cm, high blood pressure (systolic blood pressure ≥140 mm Hg and/or diastolic blood pressure ≥90 mm Hg), high blood cholesterol (≥5.2 mmol/L) and active smoking]\n-  participants on antihypertensive therapy were also included in the study\n\n### Response:\n{\n  "AND": {\n    "left": {\n      "AND": {\n        "left": {\n          "AND": {\n            "left": {\n              "raw_text": "- female sex",\n              "Life-Stage-And-Gender": [\n                "female"\n              ]\n            },\n            "right": {\n              "raw_text": "- age 45 to 60 years",\n              "Age": [\n                "age"\n              ],\n              "Eq-Comparison": [\n                "45 to 60 years"\n              ],\n              "Eq-Value": [\n                "45",\n                "60"\n              ],\n              "Eq-Operator": [\n                "to"\n              ],\n              "Eq-Temporal-Unit": [\n                "years"\n              ]\n            }\n          }\n        },\n        "right": {\n          "OR": {\n            "left": {\n              "raw_text": "- one or more CV risk factors [overweight",\n              "Condition": [\n                "overweight"\n              ],\n              "Condition-Name": [\n                "overweight"\n              ],\n              "Eq-Comparison": [\n                "one or more"\n              ],\n              "Eq-Value": [\n                "one"\n              ],\n              "Eq-Operator": [\n                "or more"\n              ],\n              "Risk": [\n                "risk"\n              ],\n              "Condition" : [\n                "CV"\n              ],\n              "Condition-Name" : [\n                "CV"\n              ]\n            },\n            "right": {\n              "OR": {\n                "left": {\n                  "raw_text": "or obesity, i. e. body mass index (BMI) ≥25 kg/m2,",\n                  "Condition": [\n                    "obesity"\n                  ],\n                  "Condition-Name": [\n                    "obesity"\n                  ],\n                  "Observation": [\n                    "body mass index",\n                    "BMI"\n                  ],\n                  "Observation-Name": [\n                    "body mass index",\n                    "BMI"\n                  ],\n                  "Eq-Comparison": [\n                    "≥25 kg/m2"\n                  ],\n                  "Eq-Operator": [\n                    "≥"\n                  ],\n                  "Eq-Value": [\n                    "25"\n                  ],\n                  "Eq-Unit": [\n                    "kg",\n                    "m2"\n                  ]\n                },\n                "right": {\n                  "OR": {\n                    "left": {\n                      "raw_text": "and/or central obesity - waist circumference ≥88 cm, high blood pressure (systolic blood pressure ≥140 mm Hg",\n                      "Condition": [\n                        "central obesity"\n                      ],\n                      "Condition-Name": [\n                        "central obesity"\n                      ],\n                      "Observation": [\n                        "waist circumference",\n                        "blood pressure",\n                        "systolic blood pressure"\n                      ],\n                      "Observation-Name": [\n                        "waist circumference",\n                        "blood pressure",\n                        "systolic blood pressure"\n                      ],\n                      "Eq-Comparison": [\n                        "≥88 cm",\n                        "≥140 mm Hg"\n                      ],\n                      "Eq-Operator": [\n                        "≥"\n                      ],\n                      "Eq-Unit": [\n                        "cm",\n                        "mm Hg"\n                      ],\n                      "Eq-Value": [\n                        "88",\n                        "140"\n                      ],\n                      "Polarity": [\n                        "high"\n                      ]\n                    },\n                    "right": {\n                      "OR": {\n                        "left": {\n                          "raw_text": "and/or diastolic blood pressure ≥90 mm Hg), high blood cholesterol (≥5.2 mmol/L) and active smoking]",\n                          "Observation": [\n                            "diastolic blood pressure",\n                            "blood pressure",\n                            "blood cholesterol"\n                          ],\n                          "Observation-Name": [\n                            "diastolic blood pressure",\n                            "blood pressure",\n                            "blood cholesterol"\n                          ],\n                          "Eq-Comparison": [\n                            "≥90 mm Hg)",\n                            "≥5.2 mmol/L",\n                            "active"\n                          ],\n                          "Eq-Operator": [\n                            "≥"\n                          ],\n                          "Eq-Unit": [\n                            "mm Hg",\n                            "mmol",\n                            "L"\n                          ],\n                          "Eq-Value": [\n                            "90",\n                            "5.2"\n                          ],\n                          "Eq-Temporal-Period": [\n                            "active"\n                          ],\n                          "Polarity": [\n                            "high"\n                          ],\n                          "Condition": [\n                            "smoking"\n              