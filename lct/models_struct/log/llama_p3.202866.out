                  ],
                  "Age": [
                    "age"
                  ]
                },
                "right": {
                  "OR": {
                    "left": {
                      "raw_text": "- Black",
                      "Ethnicity": [
                        "Black"
                      ]
                    },
                    "right": {
                      "raw_text": "or Hispanic, living in the U.S. including the U.S. territories",
                      "Ethnicity": [
                        "Hispanic"
                      ],
                      "Location": [
                        "U.S.",
                        "U.S. territories"
                      ]
                    }
                  }
                }
              }
            },
            "right": {
              "OR": {
                "left": {
                  "raw_text": "- a dementia caregiver",
                  "Condition": [
                    "dementia"
                  ],
                  "Condition-Name": [
                    "dementia"
                  ],
                  "Observation": [
