y",\n                                              "Condition": [\n                                                "atrial fibrillation"\n                                              ],\n                                              "Condition-Name": [\n                                                "atrial fibrillation"\n                                              ],\n                                              "Other": [\n                                                "other"\n                                              ],\n                                              "Procedure": [\n                                                "cardiac surgery"\n                                              ],\n                                              "Procedure-Name": [\n                                                "cardiac surgery"\n                                              ],\n                                              "Assertion": [\n                                                "for"\n                                              ]\n                                            }\n                                          }\n                                        }\n                                      }\n                                    },\n                                    "right": {\n                                      "raw_text": "- 5. Patients with active internal bleeding",\n                                      "Eq-Comparison": [\n                                        "active"\n                                      ],\n                                      "Eq-Temporal-Period": [\n                                        "active"\n                                      ],\n                                      "Condition": [\n                                        "internal bleeding"\n                                      ],\n                                      "Condition-Name": [\n                                        "intern