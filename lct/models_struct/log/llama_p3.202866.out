i.e.",\n              "Condition": [\n                "asthma",\n                "hypertension"\n              ],\n              "Condition-Name": [\n                "asthma",\n                "hypertension"\n              ],\n              "Modifier": [\n                "uncontrolled",\n                "exercise"\n              ],\n              "Procedure": [\n                "treadmill"\n              ],\n              "Procedure-Name": [\n                "treadmill"\n              ],\n              "Assertion": [\n                "inability"\n              ]\n            },\n            "right": {\n              "NOT": {\n                "left": {\n                  "OR": {\n                    "left": {\n                      "raw_text": "no neuromuscular",\n                      "Negation": [\n                        "no"\n                      ],\n                      "Modifier": [\n                        "neuromuscular"\n                      ]\n                    },\n                    "right": {\n                      "OR": {\n                        "left": {\n                          "raw_text": "or lower extremity conditions",\n                          "Modifier": [\n                            "lower extremity"\n                          ],\n                          "Condition": [\n                            "conditions"\n                          ]\n                        },\n                        "right": {\n                          "OR": {\n                            "left": {\n                              "raw_text": "or any other medical contraindication that could",\n                              "Contraindication": [\n                                "contraindication"\n                              ],\n                              "Other": [\n                                "other"\n                              ],\n                              "Assertion": [\n                                "could"\n                              ]\n                            },\n                            "right": {\n                              "NOT": {\n                                "left": {\n                                  "OR": {\n                                    "left": {\n                                      "raw_text": "prevent them from floor walking as upset affecting movement of the pelvic arch",\n                                      "Negation": [\n                                        "prevent"\n                                      ],\n                                      "Condition": [\n                                        "upset",\n                                        "movement"\n                                      ],\n                                      "Condition-Name": [\n                                        "upset",\n                                        "movement"\n                                      ],\n                                      "Modifier": [\n                                        "floor walking",\n                                        "pelvic arch"\n                                      ],\n                                      "Stability": [\n                                        "affecting"\n                                      ]\n                                    },\n                                    "right": {\n                                      "OR": {\n                                        "left": {\n                                          "raw_text": "or pace, story of previous hip",\n                                          "Eq-Comparison": [\n                                            "previous"\n                                          ],\n                                          "Eq-Temporal-Period": [\n                                            "previous"\n                                          ],\n                                          "Modifier": [\n                                            "hip"\