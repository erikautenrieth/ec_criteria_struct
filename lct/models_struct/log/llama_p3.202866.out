: [\n                        "impairing"\n                      ]\n                    }\n                  }\n                },\n                "right": {\n                  "raw_text": "4. history of substance dependence in the past six months;",\n                  "Condition": [\n                    "substance dependence"\n                  ],\n                  "Condition-Name": [\n                    "substance dependence"\n                  ],\n                  "Eq-Comparison": [\n                    "history",\n                    "past six months"\n                  ],\n                  "Eq-Temporal-Period": [\n                    "history",\n                    "past"\n                  ],\n                  "Eq-Value": [\n                    "six"\n                  ],\n                  "Eq-Temporal-Unit": [\n                    "months"\n                  ]\n                }\n              }\n            },\n            "right": {\n              "raw_text": "5. suicide risk; bipolar disorder or schizophrenia or another current Axis I disorder if there is a significant risk of harm and/or decompensation if treatment of that comorbid condition is delayed as a function of participating in any stage of this study;",\n              "Condition": [\n                "bipolar disorder",\n                "schizophrenia",\n                "Axis I disorder"\n              ],\n              "Condition-Name": [\n                "bipolar disorder",\n                "schizophrenia",\n                "Axis I disorder"\n              ],\n              "Risk": [\n                "risk"\n              ],\n              "Eq-Comparison": [\n                "current"\n              ],\n              "Eq-Temporal-Period": [\n                "current"\n              ],\n              "Observation": [\n                "suicide",\n                "harm"\n              ],\n              "Observation-Name": [\n                "suicide",\n                "harm"\n              ],