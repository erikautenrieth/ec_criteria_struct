n                                                    "left": {\n                                                      "AND": {\n                                                        "left": {\n                                                          "OR": {\n                                                            "left": {\n                                                              "raw_text": "- Clinical diagnosis of chronic lateral epicondylalgia on both sides, cervicothoracic spinal pathology,",\n                                                              "Condition": [\n                                                                "cervicothoracic spinal pathology",\n                                                                "lateral epicondylalgia"\n                                                              ],\n                                                              "Condition-Name": [\n                                                                "cervicothoracic spinal pathology",\n                                                                "lateral epicondylalgia"\n                                                              ],\n                                                              "Acuteness": [\n                                                                "chronic"\n                                                              ]\n                                                            },\n                                                            "right": {\n                                                              "OR": {\n                                                                "left": {\n                                                                  "raw_text": "other upper limb musculoskeletal disorders",\n                                                                  "Condition": [\n                                                                    "upper limb musculoskeletal disorders"\n                                                                  ],\n                                                                  "Condition-Name": [\n                                                                    "upper limb musculoskeletal disorders"\n                                                                  ],\n                                                                  "Other": [\n                                                                    "other"\n                                                                  ]\n                                                                },\n                                                                "right": {\n                                                                  "raw_text": "or neurological disorders",\n                                                                  "Condition": [\n                                                                    "neurological disorders"\n                                                                  ],\n                                                                  "Condition-Name": [\n                                                                    "neurological disorders"\n                                                                  ]\n                                                                }\n                                                              }\n                                                            }\n                                                          }\n                                                        },\n                                                        "right": {\n                                                          "raw_text": "- Pregnancy",\n                                                          "Condition": [\n                                                            "Pregnancy"\n                                                          ],\n         