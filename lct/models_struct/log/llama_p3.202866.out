                ]\n                                },\n                                "right": {\n                                  "raw_text": "and prosthetic devices.",\n                                  "Procedure": [\n                                    "prosthetic devices"\n                                  ],\n                                  "Procedure-Name": [\n                                    "prosthetic devices"\n                                  ]\n                                }\n                              }\n                            }\n                          }\n                        }\n                      }\n                    }\n                  }\n                }\n              }\n            },\n            "right": {\n              "AND": {\n                "left": {\n                  "raw_text": "4. Unwillingness",\n                  "Condition": [\n                    "Unwillingness"\n                  ],\n                  "Condition-Name": [\n                    "Unwillingness"\n                  ]\n                },\n                "right": {\n                  "AND": {\n                    "left": {\n                      "raw_text": "or"\n                    },\n                    "right": {\n                      "NOT": {\n                        "left": {\n                          "raw_text": "inability of the candidate to comply with all investigational requirements.",\n                          "Negation": [\n                            "inability"\n                          ],\n                          "Study": [\n                            "investigational"\n                          ],\n                          "Assertion": [\n                            "inability"\n                          ]\n                        }\n                      }\n                    }\n                  }\n                }\n              }\n            }\n          }\n        },\n        "right": {\n          "raw_text"