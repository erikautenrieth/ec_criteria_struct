Treatment with continuous positive airway pressure (CPAP) in the past three months.\n-  Severe neurological, cardiopulmonary, psychiatric, or untreated thyroid disorder.\n-  Chronic pain condition that was being treated with opioids.\n-  Patients with a hematocrit lower than 35%.\n\n### Response:\n{\n  "AND": {\n    "left": {\n      "AND": {\n        "left": {\n          "AND": {\n            "left": {\n              "AND": {\n                "left": {\n                  "raw_text": "- Chronic obstructive pulmonary disorder (COPD).",\n                  "Condition": [\n                    "COPD",\n                    "Chronic obstructive pulmonary disorder"\n                  ],\n                  "Condition-Name": [\n                    "COPD",\n                    "COPD",\n                    "Chronic obstructive pulmonary disorder"\n                  ],\n                  "Acuteness": [\n                    "Chronic"\n                  ]\n                },\n                "right": {\n                  "raw_text": "- Treatment with continuous positive airway pressure (CPAP) in the past three months.",\n                  "Procedure": [\n                    "continuous positive airway pressure",\n                    "CPAP",\n                    "Treatment"\n                  ],\n                  "Procedure-Name": [\n                    "continuous positive airway pressure",\n                    "CPAP"\n                  ],\n                  "Eq-Temporal-Unit": [\n                    "months"\n                  ],\n                  "Eq-Comparison": [\n                    "past three months"\n                  ],\n                  "Eq-Temporal-Period": [\n                    "past"\n                  ],\n                  "Eq-Value": [\n                    "three"\n                  ]\n                }\n              }\n            },\n            "right": {\n              "OR": {\n                "left": {\n                  "raw_text": "- Severe neurological,",\n                  "Modifier": [\n                    "neurological"\n                  ],\n                  "Severity": [\n                    "Severe"\n                  ]\n                },\n                "right": {\n                  "OR": {\n                    "left": {\n                      "raw_text": "cardiopulmonary,",\n                      "Modifier": [\n                        "cardiopulmonary"\n                      ]\n                    },\n                    "right": {\n                      "OR": {\n                        "left": {\n                          "raw_text": "psychiatric,",\n                          "Modifier": [\n                            "psychiatric"\n                          ]\n                        },\n                        "right": {\n                          "AND": {\n                            "left": {\n                              "raw_text": "or"\n                            },\n                            "right": {\n                              "NOT": {\n                                "left": {\n                                  "raw_text": "untreated thyroid disorder.",\n                                  "Condition": [\n                                    "thyroid disorder"\n                                  ],\n                                  "Condition-Name": [\n                                    "thyroid disorder"\n                                  ],\n                                  "Procedure": [\n                                    "untreated"\n                                  ],\n                                  "Negation": [\n                                    "untreated"\n                                  ]\n                                }\n                              }\n                            }\n                          }\n                        }\n                      }\n                    }\n                  }\n                }\n              }\n            }\n          }\n        },\n        "right": {\n          "AND": {\n            "left": {\n              "raw_text": "- Chronic pain condition that was being treated with opioids.",\n              "Acuteness": [\n                "Chronic"\n              ],\n              "Observation": [\n                "pain"\n              ],\n              "Observation-Name": [\n                "pain"\n              ],\n              "Drug": [\n                "opioids"\n              ],\n              "Drug-Name": [\n                "opioids"\n              ],\n              "Eq-Comparison": [\n                "being"\n              ],\n              "Eq-Temporal-Period": [\n                "being"\n              ],\n              "Procedure": [\n                "treated"\n              ]\n            }\n          }\n        }\n      }\n    },\n    "right": {\n      "AND": {\n        "left": {\n          "raw_text": "- Patients with a hematocrit",\n          "Observation": [\n            "hematocrit"\n          ],\n          "Observation-Name": [\n            "hematocrit"\n          ]\n        },\n        "right": {\n          "raw_text": "lower than 35%.",\n          "Eq-Comparison": [\n            "lower than 35%"\n          ],\n          "Eq-Operator": [\n            "lower than"\n          ],\n          "Eq-Value": [\n            "35"\n          ],\n          "Eq-Unit": [\n            "%"\n          ]\n        }\n      }\n    }\n  }\n}<|eot_id|>']
