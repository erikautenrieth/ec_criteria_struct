n-  Age less than 72 hours\n-  PDA diameter > 1.5 mm\n-  Signed informed consent obtained from both parents\n\n### Response:\n{\n  "AND": {\n    "left": {\n      "AND": {\n        "left": {\n          "AND": {\n            "left": {\n              "AND": {\n                "left": {\n                  "raw_text": "- Gestational age < 32 weeks",\n                  "Observation": [\n                    "Gestational age"\n                  ],\n                  "Eq-Comparison": [\n                    "< 32 weeks"\n                  ],\n                  "Observation-Name": [\n                    "Gestational age"\n                  ],\n                  "Eq-Operator": [\n                    "<"\n                  ],\n                  "Eq-Value": [\n                    "32",\n                    "3"\n                  ],\n                  "Eq-Temporal-Unit": [\n                    "weeks"\n                  ]\n                },\n                "right": {\n                  "raw_text": "- Birthweight <1500 g",\n                  "Eq-Operator": [\n                    "<"\n                  ],\n                  "Birth": [\n                    "Birth"\n                  ],\n                  "Eq-Comparison": [\n                    "<1500 g"\n                  ],\n                  "Observation": [\n                    "Birthweight"\n                  ],\n                  "Eq-Value": [\n                    "1500",\n                    "1"\n                  ],\n                  "Eq-Unit": [\n                    "g"\n                  ],\n                  "Observation-Name": [\n                    "Birthweight"\n                  ]\n                }\n              }\n            },\n            "right": {\n              "raw_text": "- Age less than 72 hours",\n              "Eq-Operator": [\n                "less than"\n              ],\n              "Eq-Value": [\n                "72"\n              ],\n              "Eq-Comparison": [\n                "less than 72 hours"\n              ],\n              "Age": [\n                "Age"\n              ],\n              "Eq-Temporal-Unit": [\n                "hours"\n              ]\n            }\n          }\n        },\n        "right": {\n          "raw_text": "- PDA diameter > 1.5 mm",\n          "Eq-Operator": [\n            ">"\n          ],\n          "Eq-Value": [\n            "1.5"\n          ],\n          "Eq-Comparison": [\n            "> 1.5 mm"\n          ],\n          "Observation": [\n            "PDA diameter"\n          ],\n          "Eq-Unit": [\n            "mm"\n          ],\n          "Observation-Name": [\n            "PDA diameter"\n          ]\n        }\n      }\n    },\n    "right": {\n      "raw_text": "- Signed informed consent obtained from both parents"\n    }\n  }\n}<|eot_id|>']
