        "years"
      ],
      "Procedure-Name": [
        "mammography"
      ]
    },
    "right": {
      "OR": {
        "left": {
          "raw_text": "or other standard exams (ultrasound,",
          "Other": [
            "other"
          ],
          "Procedure": [
            "standard exams",
            "ultrasound"
          ],
          "Procedure-Name": [
            "standard exams",
            "ultrasound"
          ]
        },
        "right": {
          "raw_text": "MRI, etc). Could participate this trial within 2 weeks after mammography. Have the ability of consent inform.",
          "Procedure": [
            "mammography",
            "MRI"
          ],
          "Eq-Comparison": [
            "within 2 weeks"
