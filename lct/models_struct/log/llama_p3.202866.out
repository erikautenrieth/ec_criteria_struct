                    ],\n                              "Eq-Unit": [\n                                "test"\n                              ]\n                            },\n                            "right": {\n                              "raw_text": "and less then 60 y/o;",\n                              "Eq-Comparison": [\n                                "less then 60"\n                              ],\n                              "Eq-Operator": [\n                                "less then"\n                              ],\n                              "Eq-Value": [\n                                "60"\n                              ],\n                              "Eq-Unit": [\n                                "y"\n                              ]\n                            }\n                          }\n                        }\n                      }\n                    }\n                  }\n                },\n                "right": {\n                  "AND": {\n                    "left": {\n                      "raw_text": "-"\n                    },\n                    "right": {\n                      "NOT": {\n                        "left": {\n                          "AND": {\n                            "left": {\n                              "raw_text": "No suspicion for a head injury",\n                              "Observation": [\n                                "injury"\n                              ],\n                              "Modifier": [\n                                "head"\n                              ],\n                              "Negation": [\n                                "No"\n                              ],\n                              "Assertion": [\n                                "suspicion for"\n                              ],\n                              "Observation-Name": [\n                                "injury"\n                              ]\n                            },\n   