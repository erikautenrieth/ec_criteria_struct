n                                                    "recent",\n                                                    "History"\n                                                  ],\n                                                  "Eq-Temporal-Period": [\n                                                    "recent",\n                                                    "History"\n                                                  ],\n                                                  "Modifier": [\n                                                    "lower limb"\n                                                  ],\n                                                  "Condition": [\n                                                    "injuries",\n                                                    "reefer transmission"\n                                                  ],\n                                                  "Condition-Name": [\n                                                    "injuries",\n                                                    "reefer transmission"\n                                                  ]\n                                                },\n                                                "right": {\n                                                  "OR": {\n                                                    "left": {\n                                                      "raw_text": "or acute joint lighting. History of recent joint injection (steroid,",\n                                                      "Eq-Comparison": [\n                                                        "recent",\n                                                        "History"\n                                                      ],\n                                                      "Eq-Temporal-Period": [\n                                                        "recent",\n                                                        "History"\n   