vision of stay less than 3 days\n\n### Response:\n{\n  "AND": {\n    "left": {\n      "AND": {\n        "left": {\n          "raw_text": "-"\n        },\n        "right": {\n          "NOT": {\n            "left": {\n              "raw_text": "not intubated patients",\n              "Negation": [\n                "not"\n              ],\n              "Procedure": [\n                "intubated"\n              ],\n              "Procedure-Name": [\n                "intubated"\n              ]\n            }\n          }\n        }\n      }\n    },\n    "right": {\n      "raw_text": "- patients with an ICU prevision of stay less than 3 days",\n      "Eq-Operator": [\n        "less than"\n      ],\n      "Eq-Temporal-Unit": [\n        "days"\n      ],\n      "Eq-Value": [\n        "3"\n      ],\n      "Eq-Comparison": [\n        "less than 3 days"\n      ],\n      "Location": [\n        "ICU"\n      ],\n      "Encounter": [\n        "stay"\n      ]\n    }\n  }\n}<|eot_id|>']
