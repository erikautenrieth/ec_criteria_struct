        }\n                            },\n                            "right": {\n                              "raw_text": "- The home environment is conducive to the community-based rehabilitation.",\n                              "Eq-Operator": [\n                                "-"\n                              ],\n                              "Procedure": [\n                                "rehabilitation"\n                              ],\n                              "Procedure-Name": [\n                                "rehabilitation"\n                              ],\n                              "Modifier": [\n                                "community-based"\n                              ]\n                            }\n                          }\n                        },\n                        "right": {\n                          "raw_text": "- Achievable rehabilitation goals can be identified.",\n                          "Eq-Operator": [\n                            "-"\n                          ],\n                          "Procedure": [\n                            "rehabilitation"\n                          ],\n                          "Procedure-Name": [\n                            "rehabilitation"\n                          ],\n                          "Observation": [\n                            "rehabilitation goals"\n                          ],\n                          "Observation-Name": [\n                            "rehabilitation goals"\n                          ],\n                          "Assertion": [\n                            "can be"\n                          ]\n                        }\n                      }\n                    },\n                    "right": {\n                      "raw_text": "- Document acknowledgement that the patient is sufficiently well enough from a medical perspective to be managed in the community.",\n                      "Eq-Operator": [\n                        "-"\n                      ],\n                      "Condition": [\n                        "well enough"\n                      ],\n                      "Condition-Name": [\n                        "well enough"\n                      ],\n                      "Modifier": [\n                        "medical",\n                        "community"\n                      ],\n                      "Assertion": [\n                        "managed"\n                      ]\n                    }\n                  }\n                },\n                "right": {\n                  "AND": {\n                    "left": {\n                      "raw_text": "- The patient\'s language",\n                      "Eq-Operator": [\n                        "-"\n                      ],\n                      "Language": [\n                        "language"\n                      ]\n                    },\n                    "right": {\n                      "AND": {\n                        "left": {\n                          "raw_text": "and/or cognitive skills are at a level for them to manage on their own for periods as is necessary.",\n                          "Condition": [\n                            "cognitive skills"\n                          ],\n                          "Condition-Name": [\n                            "cognitive skills"\n                          ],\n                          "Assertion": [\n                            "manage"\n                          ],\n                          "Modifier": [\n                            "on their own for periods"\n                          ]\n                        },\n                        "right": {\n                          "raw_text": "In addition to ESSD criteria participants must;",\n                          "Procedure": [\n                            "ESSD"\n                          ],\n                          "Procedure-Name": [\n                            "ESSD"\n                          ]\n                        }\n                      }\n                    }\n                  }\n                }\n              }\n            },\n            "right": {\n              "raw_text": "- Have a good grasp of the English language",\n              "Language": [\n                "English language"\n              ],\n              "Eq-Operator": [\n                "-"\n              ]\n            }\n          }\n        },\n        "right": {\n          "raw_text": "- Have been discharged from the ESSD pathway",\n          "Procedure": [\n            "ESSD"\n          ],\n          "Procedure-Name": [\n            "ESSD"\n          ],\n          "Eq-Operator": [\n            "-"\n          ],\n          "Encounter": [\n            "discharged"\n          ]\n        }\n      }\n    },\n    "right": {\n      "raw_text": "- Have been discharged from the ESSD pathway",\n      "Procedure": [\n        "ESSD"\n      ],\n      "Procedure-Name": [\n        "ESSD"\n      ],\n      "Eq-Operator": [\n        "-"\n      ],\n      "Encounter": [\n        "discharged"\n      ]\n    }\n  }\n}<|eot_id|>']
