     "Condition": [\n                "Concomitant diseases"\n              ],\n              "Assertion": [\n                "preclude patient participation"\n              ],\n              "Condition-Name": [\n                "Concomitant diseases"\n              ]\n            }\n          }\n        }\n      }\n    },\n    "right": {\n      "raw_text": "- Doctor\'s opinion"\n    }\n  }\n}<|eot_id|>']
