mptoms"\n                                              ],\n                                              "Condition": [\n                                                "chest pain"\n                                              ],\n                                              "Condition-Name": [\n                                                "chest pain"\n                                              ]\n                                            },\n                                            "right": {\n                                              "OR": {\n                                                "left": {\n                                                  "raw_text": "palpitations,",\n                                                  "Condition": [\n                                                    "palpitations"\n                                                  ],\n                                                  "Condition-Name": [\n                                                    "palpitations"\n                                                  ]\n                                                },\n                                                "right": {\n                                                  "OR": {\n                                                    "left": {\n                                                      "raw_text": "syncope",\n                                                      "Condition": [\n                                                        "syncope"\n                                                      ],\n                                                      "Condition-Name": [\n                                                        "syncope"\n                                                      ]\n                                                    },\n                                                    "right": {\n                                                      "raw_text": "or dizziness)",\n 