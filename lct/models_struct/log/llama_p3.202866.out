             "Drug-Name": [\n                            "dopamine"\n                          ]\n                        },\n                        "right": {\n                          "OR": {\n                            "left": {\n                              "raw_text": "dopamine agonists,",\n                              "Drug": [\n                                "dopamine agonists"\n                              ],\n                              "Drug-Name": [\n                                "dopamine agonists"\n                              ]\n                            },\n                            "right": {\n                              "OR": {\n                                "left": {\n                                  "raw_text": "haloperidol,",\n                                  "Drug": [\n                                    "haloperidol"\n                                  ],\n                                  "Drug-Name": [\n                                    "haloperidol"\n                                  ]\n                                },\n                                "right": {\n                                  "OR": {\n                                    "left": {\n                                      "raw_text": "lithium,",\n                                      "Drug": [\n                                        "lithium"\n                                      ],\n                                      "Drug-Name": [\n                                        "lithium"\n                                      ]\n                                    },\n                                    "right": {\n                                      "OR": {\n                                        "left": {\n                                          "raw_text": "acetylcholinesterase inhibitors,",\n                                          "Drug": [\n                                            "acetylcholinesterase inhibitors"\n                    