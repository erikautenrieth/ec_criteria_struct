 "Butterworth hospital"\n                      ],\n                      "Procedure": [\n                        "surgery"\n                      ],\n                      "Procedure-Name": [\n                        "surgery"\n                      ],\n                      "Assertion": [\n                        "If"\n                      ]\n                    }\n                  }\n                },\n                "right": {\n                  "raw_text": "- Emergent cases"\n                }\n              }\n            },\n            "right": {\n              "raw_text": "Patients will be excluded from the study intra-operatively if:",\n              "Assertion": [\n                "if"\n              ]\n            }\n          }\n        },\n        "right": {\n          "raw_text": "- The procedure is converted to an open resection",\n          "Procedure": [\n            "procedure",\n            "open resection"\n          ],\n          "Procedure-Name": [\n            "procedure",\n            "open resection"\n          ],\n          "Modifier": [\n            "converted"\n          ]\n        }\n      }\n    },\n    "right": {\n      "raw_text": "- If a loop ileostomy is performed in addition to the right colectomy",\n      "Procedure": [\n        "right colectomy",\n        "loop ileostomy"\n      ],\n      "Procedure-Name": [\n        "right colectomy",\n        "loop ileostomy"\n      ],\n      "Assertion": [\n        "If"\n      ]\n    }\n  }\n}<|eot_id|>']
