    "final"\n              ]\n            },\n            "right": {\n              "raw_text": "or other serious disease final stage",\n              "Condition": [\n                "disease"\n              ],\n              "Eq-Comparison": [\n                "final stage"\n              ],\n              "Eq-Unit": [\n                "stage"\n              ],\n              "Eq-Temporal-Period": [\n                "final"\n              ],\n              "Severity": [\n                "serious"\n              ],\n              "Other": [\n                "other"\n              ]\n            }\n          }\n        }\n      }\n    },\n    "right": {\n      "OR": {\n        "left": {\n          "raw_text": "- Significant cognitive",\n          "Modifier": [\n            "cognitive"\n          ],\n          "Severity": [\n            "Significant"\n          ]\n        },\n        "right": {\n          "AND": {\n            "left": {\n              "raw_text": "or psychiatric impairment that would lead to an",\n              "Condition": [\n                "impairment"\n              ],\n              "Condition-Name": [\n                "impairment"\n              ],\n              "Modifier": [\n                "psychiatric"\n              ],\n              "Assertion": [\n                "would"\n              ]\n            },\n            "right": {\n              "NOT": {\n                "left": {\n                  "raw_text": "inability to follow simple commands in a group setting",\n                  "Negation": [\n                    "inability"\n                  ],\n                  "Assertion": [\n                    "inability"\n                  ]\n                }\n              }\n            }\n          }\n        }\n      }\n    }\n  }\n}<|eot_id|>']
