escribed to take two or more medications per day, and manage their own medications.\n\n### Response:\n{\n  "AND": {\n    "left": {\n      "AND": {\n        "left": {\n          "raw_text": "- 18 years of age or older",\n          "Eq-Temporal-Unit": [\n            "years"\n          ],\n          "Age": [\n            "age"\n          ],\n          "Eq-Value": [\n            "18"\n          ],\n          "Eq-Comparison": [\n            "18 years of age or older"\n          ],\n          "Eq-Operator": [\n            "or older"\n          ]\n        },\n        "right": {\n          "raw_text": "- speak English",\n          "Language": [\n            "English"\n          ]\n        }\n      }\n    },\n    "right": {\n      "raw_text": "- be prescribed to take two or more medications per day, and manage their own medications.",\n      "Eq-Comparison": [\n        "two or more medications per day"\n      ],\n      "Eq-Value": [\n        "two"\n      ],\n      "Eq-Operator": [\n        "or more"\n      ],\n      "Drug": [\n        "medications"\n      ],\n      "Eq-Temporal-Unit": [\n        "day"\n      ]\n    }\n  }\n}<|eot_id|>']
