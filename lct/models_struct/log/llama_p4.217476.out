ion-Name": [\n                            "mechanical obstruction"\n                          ]\n                        },\n                        "right": {\n                          "raw_text": "and extensive small bowel mucosal disease).",\n                          "Condition": [\n                            "disease"\n                          ],\n                          "Modifier": [\n                            "extensive small bowel"\n                          ],\n                          "Condition-Name": [\n                            "disease"\n                          ]\n                        }\n                      }\n                    }\n                  }\n                }\n              }\n            }\n          }\n        }\n      }\n    }\n  }\n}<|eot_id|>']
