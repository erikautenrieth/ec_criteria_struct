y taking spironolactone for a diagnosis of acne vulgaris\nOR\nFemale subjects between 18 and 65 years of age currently taking oral antibiotics for a diagnosis of acne vulgaris\nAND Subjects able to complete an online survey in English\n\n### Response:\n{\n  "AND": {\n    "left": {\n      "AND": {\n        "left": {\n          "AND": {\n            "left": {\n              "raw_text": "Female subjects between 18 and 65 years of age currently taking spironolactone for a diagnosis of acne vulgaris",\n              "Eq-Temporal-Unit": [\n                "years"\n              ],\n              "Age": [\n                "age"\n              ],\n              "Eq-Value": [\n                "18",\n                "65"\n              ],\n              "Life-Stage-And-Gender": [\n                "Female"\n              ],\n              "Eq-Comparison": [\n                "between 18 and 65 years",\n                "currently taking"\n              ],\n              "Eq-Operator": [\n                "between"\n              ],\n              "Drug": [\n                "spironolactone"\n              ],\n              "Drug-Name": [\n                "spironolactone"\n              ],\n              "Condition": [\n                "acne vulgaris"\n              ],\n              "Condition-Name": [\n                "acne vulgaris"\n              ],\n              "Eq-Temporal-Period": [\n                "currently taking"\n              ]\n            },\n            "right": {\n              "OR": {\n                "left": {\n                  "raw_text": "OR"\n                },\n                "right": {\n                  "AND": {\n                    "left": {\n                      "raw_text": "Female subjects between 18 and 65 years of age currently taking oral antibiotics for a diagnosis of acne vulgaris",\n                      "Eq-Temporal-Unit": [\n                        "years"\n                      ],\n                      "Age": [\n                        "a