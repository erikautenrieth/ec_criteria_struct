ntrol determined at a screening visit:\n-  Triglycerides > 150 mg/dL OR HDL <50 in females, <40 mg/dL in males\n-  Systolic blood pressure ≥130 mmHg OR diastolic blood pressure ≥80 mmHg (or on hypertension medication)\n-  HbA1c ≥5.7% or higher\n-  No diagnosis or treatment for cancer in the past year\n-  No diagnosis of mild cognitive impairment or dementia in the past year\n-  Ability to perform daily exercise, including aerobic activity and resistance exercise\n-  Non-smoker in the past year\n\n### Response:\n{\n  "AND": {\n    "left": {\n      "AND": {\n        "left": {\n          "AND": {\n            "left": {\n              "AND": {\n                "left": {\n                  "AND": {\n                    "left": {\n                      "AND": {\n                        "left": {\n                          "AND": {\n                            "left": {\n                              "OR": {\n                                "left": {\n                                  "raw_text": "- Dysfunctional lipids,",\n                                  "Condition": [\n                                    "Dysfunctional lipids"\n                                  ],\n                                  "Condition-Name": [\n                                    "Dysfunctional lipids"\n                                  ],\n                                  "Eq-Comparison": [\n                                    "on"\n                                  ],\n                                  "Eq-Temporal-Period": [\n                                    "on"\n                                  ]\n                                },\n                                "right": {\n                                  "AND": {\n                                    "left": {\n                                      "raw_text": "blood pressure",\n                                      "Observation": [\n                                        "blood pressure"\n                                      ],\n                                      "Observation-Name": [\n                                        "blood pressure"\n                                      ]\n                                    },\n                                    "right": {\n                                      "raw_text": "and glycemic control determined at a screening visit:",\n                                      "Condition": [\n                                        "glycemic control"\n                                      ],\n                                      "Condition-Name": [\n                                        "glycemic control"\n                                      ],\n                                      "Study": [\n                                        "screening"\n                                      ],\n                                      "Eq-Comparison": [\n                                        "on"\n                                      ],\n                                      "Eq-Temporal-Period": [\n                                        "on"\n                                      ]\n                                    }\n                                  }\n                                }\n                              }\n                            },\n                            "right": {\n                              "OR": {\n                                "left": {\n                                  "raw_text": "- Triglycerides > 150 mg/dL",\n                                  "Eq-Operator": [\n                                    ">"\n                                  ],\n                                  "Eq-Value": [\n                                    "150",\n                                    "50"\n                                  ],\n                                  "Eq-Comparison": [\n                                    "> 150 mg/dL"\n                                  ],\n                                  "Observation": [\n                                    "Triglycerides"\n                                  ],\n                                  "Observation-Name": [\n                                    "Triglycerides"\n                                  ],\n                                  "Eq-Unit": [\n                                    "mg",\n                                    "dL"\n                                  ]\n                                },\n                                "right": {\n                                  "raw_text": "OR HDL <50 in females, <40 mg/dL in males",\n                                  "Life-Stage-And-Gender": [\n                                    "females",\n                                    "males"\n                                  ],\n                                  "Eq-Operator": [\n                                    "<"\n                                  ],\n                                  "Eq-Value": [\n                                    "50",\n                                    "40"\n                                  ],\n                                  "Eq-Comparison": [\n                                    "<50",\n                                    "<40 mg/dL"\n                                  ],\n                                  "Eq-Unit": [\n                                    "mg",\n                                    "dL"\n                                  ],\n                                  "Observation": [\n                                    "HDL"\n                                  ],\n                                  "Observation-Name": [\n                                    "HDL"\n                                  ]\n                                }\n                              }\n                            }\n                          }\n                        },\n                        "right": {\n                          "OR": {\n                            "left": {\n                              "raw_text"