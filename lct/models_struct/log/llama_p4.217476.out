": {\n                      "OR": {\n                        "left": {\n                          "raw_text": "hepatic",\n                          "Modifier": [\n                            "hepatic"\n                          ]\n                        },\n                        "right": {\n                          "OR": {\n                            "left": {\n                              "raw_text": "or pancreatic diseases,",\n                              "Condition": [\n                                "diseases"\n                              ],\n                              "Condition-Name": [\n                                "diseases"\n                              ],\n                              "Modifier": [\n                                "pancreatic"\n                              ]\n                            },\n                            "right": {\n                              "OR": {\n                                "left": {\n                                  "raw_text": "disorders,",\n                                  "Condition": [\n                                    "disorders"\n                                  ],\n                                  "Condition-Name": [\n                                    "disorders"\n                                  ]\n                                },\n                                "right": {\n                                  "OR": {\n                                    "left": {\n                                      "raw_text": "ulcer,",\n                                      "Condition": [\n                                        "ulcer"\n                                      ],\n                                      "Condition-Name": [\n                                        "ulcer"\n                                      ]\n                                    },\n                                    "right": {\n                                      "OR": {\n                                        "left": {\n                                          "raw_text": "hyperthyroidism,",\n                                          "Condition": [\n                                            "hyperthyroidism"\n                                          ],\n                                          "Condition-Name": [\n                                            "hyperthyroidism"\n                                          ]\n                                        },\n                                        "right": {\n                                          "OR": {\n                                            "left": {\n                                              "raw_text": "malignance, chronic malnutrition,",\n                                              "Condition": [\n                                                "malignance",\n                                                "malnutrition"\n                                              ],\n                                              "Condition-Name": [\n                                                "malignance",\n                                                "malnutrition"\n                                              ],\n                                              "Acuteness": [\n                                                "chronic"\n                                              ]\n                                            },\n                                            "right": {\n                                              "raw_text": "anaemia",\n                                              "Condition": [\n                                                "anaemia"\n                                              ],\n                                              "Condition-Name": [\n                                                "anaemia"\n                                              ]\n                                            }\n                                          }\n                                        }\n                                      }\n                                    }\n                                  }\n                                }\n                              }\n                            }\n                          }\n                        }\n                      }\n                    }\n                  }\n                }\n              }\n            }\n          }\n        },\n        "right": {\n          "OR": {\n            "left": {\n              "raw_text": "- History or on therapy with medication known to interfere with bone metabolism such as steroids,",\n              "Eq-Comparison": [\n                "History",\n                "on"\n              ],\n              "Procedure": [\n                "therapy"\n              ],\n              "Drug": [\n                "medication",\n                "steroids"\n              ],\n              "Assertion": [\n                "known to"\n              ],\n              "Eq-Temporal-Period": [\n                "History",\n                "on"\n              ],\n              "Drug-Name": [\n                "steroids"\n              ],\n              "Condition": [\n                "bone metabolism"\n              ],\n              "Condition-Name": [\n                "bone metabolism"\n              ],\n              "Stability": [\n                "interfere"\n              ]\n            },\n            "right": {\n              "OR": {\n                "left": {\n                  "raw_text": "hormones,",\n                  "Drug": [\n                    "hormones"\n                  ],\n                  "Drug-Name": [\n                    "hormones"\n                  ]\n                },\n                "right": {\n                  "OR": {\n                    "left": {\n                      "raw_text": "diuretics,",\n                      "Drug": [\n                        "diuretics"\n                      ],\n                      "Drug-Name": [\n                        "diuretics"\n                      ]\n                    },\n                    "right": {\n                      "raw_text": "cortisone or anti-seizure medication",\n                      "Drug": [\n                        "cortisone",\n                        "medication"\n                      ],\n                      "Drug-Name": [\n                        "cortisone"\n                      ],\n                      "Condition": [\n                        "seizure"\n                      ],\n                      "Condition-Name": [\n                        "seizure"\n                      ],\n                      "Modifier": [\n                        "anti"\n                      ]\n                    }\n                  }\n                }\n              }\n            }\n          }\n        }\n      }\n    },\n    "right": {\n      "AND": {\n        "left": {\n          "raw_text": "- Taking regularly any nutritional supplements",\n          "Drug": [\n            "nutritional supplements"\n          ],\n          "Drug-Name": [\n            "nutritional supplements"\n          ],\n          "Eq-Comparison": [\n            "Taking"\n          ],\n          "Eq-Temporal-Period": [\n            "Taking"\n          ]\n        },\n        "right": {\n          "AND": {\n            "left": {\n              "raw_text": "and"\n            },\n            "right": {\n              "NOT": {\n                "left": {\n                  "AND": {\n                    "left": {\n                      "raw_text": "unwilling to stop for the study",\n                      "Assertion": [\n                        "unwilling"\n                      ],\n                      "Study": [\n                        "study"\n                      ],\n                      "Negation": [\n                        "stop"\n                      ]\n                    },\n                    "right": {\n                      "raw_te