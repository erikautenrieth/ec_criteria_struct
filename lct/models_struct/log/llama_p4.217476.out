y calcifications abnormalities\n-  Male patients\n-  Pregnant or lactating patients\n-  Patients with any allergy to iodinated contrast\n-  Patients with eGFR < 45\n-  Patients that may be treated with radioactive iodine\n\n### Response:\n{\n  "AND": {\n    "left": {\n      "AND": {\n        "left": {\n          "AND": {\n            "left": {\n              "AND": {\n                "left": {\n                  "AND": {\n                    "left": {\n                      "AND": {\n                        "left": {\n                          "raw_text": "- Age <30 years old",\n                          "Eq-Operator": [\n                            "<"\n                          ],\n                          "Eq-Temporal-Unit": [\n                            "years"\n                          ],\n                          "Age": [\n                            "Age"\n                          ],\n                          "Eq-Value": [\n                            "30"\n                          ],\n                          "Eq-Comparison": [\n                            "<30 years"\n                          ]\n                        },\n                        "right": {\n                          "raw_text": "- Screening mammography with only calcifications abnormalities",\n                          "Procedure": [\n                            "Screening mammography"\n                          ],\n                          "Procedure-Name": [\n                            "Screening mammography"\n                          ],\n                          "Observation": [\n                            "calcifications"\n                          ],\n                          "Observation-Name": [\n                            "calcifications"\n                          ],\n                          "Modifier": [\n                            "with"\n                          ],\n                          "Condition": [\n                            "calcifications abnormalities"\n                          ],\n                          "Condition-Name": [\n                            "calcifications abnormalities"\n                          ]\n                        }\n                      }\n                    },\n                    "right": {\n                      "raw_text": "- Male patients",\n                      "Life-Stage-And-Gender": [\n                        "Male"\n                      ]\n                    }\n                  }\n                },\n                "right": {\n                  "OR": {\n                    "left": {\n                      "raw_text": "- Pregnant",\n                      "Condition": [\n                        "Pregnant"\n                      ],\n                      "Condition-Name": [\n                        "Pregnant"\n                      ]\n                    },\n                    "right": {\n                      "raw_text": "or lactating patients",\n                      "Condition": [\n                        "lactating"\n                      ],\n                      "Condition-Name": [\n                        "lactating"\n                      ]\n                    }\n                  }\n                }\n              }\n            },\n            "right": {\n              "raw_text": "- Patients with any allergy to iodinated contrast",\n              "Modifier": [\n                "with"\n              ],\n              "Allergy-Name": [\n                "iodinated contrast"\n              ],\n              "Allergy": [\n                "allergy"\n              ]\n            }\n          }\n        },\n        "right": {\n          "raw_text": "- Patients with eGFR < 45",\n          "Eq-Operator": [\n            "<"\n          ],\n          "Eq-Value": [\n            "45"\n          ],\n          "Eq-Comparison": [\n            "< 45"\n          ],\n          "Modifier": [\n            "with"\n          ],\n          "Observation": [\n            "eGFR"\n