emic problem. Refusal of participation Mentally ill or mentally retarded children\n\n### Response:\n{\n  "AND": {\n    "left": {\n      "raw_text": "- Children",\n      "Life-Stage-And-Gender": [\n        "Children"\n      ]\n    },\n    "right": {\n      "OR": {\n        "left": {\n          "raw_text": "having allergy to local anaesthesia",\n          "Procedure": [\n            "local anaesthesia"\n          ],\n          "Procedure-Name": [\n            "local anaesthesia"\n          ],\n          "Eq-Operator": [\n            "to"\n          ],\n          "Allergy": [\n            "allergy"\n          ]\n        },\n        "right": {\n          "OR": {\n            "left": {\n              "raw_text": "or systemic problem. Refusal of participation Mentally ill",\n              "Condition": [\n                "problem",\n                "Mentally ill"\n              ],\n              "Condition-Name": [\n                "problem",\n                "Mentally ill"\n              ],\n              "Modifier": [\n                "systemic"\n              ]\n            },\n            "right": {\n              "raw_text": "or mentally retarded children",\n              "Life-Stage-And-Gender": [\n                "children"\n              ],\n              "Condition": [\n                "mentally retarded"\n              ],\n              "Condition-Name": [\n                "mentally retarded"\n              ]\n            }\n          }\n        }\n      }\n    }\n  }\n}<|eot_id|>']
