n                  ],\n                  "Observation": [\n                    "Heart myocardial samples"\n                  ],\n                  "Condition-Name": [\n                    "DCMWT",\n                    "lamin gene"\n                  ],\n                  "Specimen": [\n                    "Heart myocardial samples"\n                  ],\n                  "Modifier": [\n                    "explanted hearts"\n                  ],\n                  "Polarity": [\n                    "wild-type"\n                  ]\n                },\n                "right": {\n                  "raw_text": "who are scheduled to undergo clinically indicated heart transplantation at the Papworth Hospital NHS Trust.",\n                  "Eq-Comparison": [\n                    "scheduled to undergo",\n                    "scheduled"\n                  ],\n                  "Procedure": [\n                    "heart transplantation"\n                  ],\n                  "Eq-Temporal-Period": [\n                    "scheduled to undergo",\n                    "scheduled"\n                  ],\n                  "Procedure-Name": [\n                    "heart transplantation"\n                  ],\n                  "Location": [\n                    "Papworth Hospital"\n                  ],\n                  "Indication": [\n                    "indicated"\n                  ]\n                }\n              }\n            }\n          }\n        }\n      }\n    },\n    "right": {\n      "raw_text": "- HV (controls): matched to cases.",\n      "Condition": [\n        "HV"\n      ],\n      "Condition-Name": [\n        "HV"\n      ]\n    }\n  }\n}<|eot_id|>']
