                ]\n                                                    }\n                                                  }\n                                                },\n                                                "right": {\n                                                  "raw_text": "- It is impossible to give the subject informed information",\n                                                  "Eq-Comparison": [\n                                                    "on"\n                                                  ],\n                                                  "Eq-Temporal-Period": [\n                                                    "on"\n                                                  ]\n                                                }\n                                              }\n                                            },\n                                            "right": {\n                                              "OR": {\n                                                "left": {\n                                                  "raw_text": "- The patient is under safeguard of justice",\n                                                  "Eq-Operator": [\n                                                    "under"\n                                                  ],\n                                                  "Observation-Name": [\n                                                    "under safeguard of justice"\n                                                  ],\n                                                  "Observation": [\n                                                    "under safeguard of justice"\n                                                  ]\n                                                },\n                                                "right": {\n                                                  "raw_text": "or state guardianship",\n                                            