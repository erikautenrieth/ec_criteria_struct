                   "Procedure": [\n                                            "chemotherapy"\n                                          ],\n                                          "Procedure-Name": [\n                                            "chemotherapy"\n                                          ]\n                                        }\n                                      }\n                                    }\n                                  }\n                                }\n                              }\n                            },\n                            "right": {\n                              "OR": {\n                                "left": {\n                                  "raw_text": "2. malignancy",\n                                  "Condition": [\n                                    "malignancy"\n                                  ],\n                                  "Condition-Name": [\n                                    "malignancy"\n                                  ]\n                                },\n                                "right": {\n                                  "AND": {\n                                    "left": {\n                                      "raw_text": "or life-threatening illness",\n                                      "Risk": [\n                                        "life-threatening"\n                                      ],\n                                      "Condition": [\n                                        "illness"\n                                      ],\n                                      "Condition-Name": [\n                                        "illness"\n                                      ],\n                                      "Death": [\n                                        "life-threatening"\n                                      ]\n                                    },\n                                    "right": {\n                                      "raw_text": "with life expectancy of <5 years;",\n                                      "Eq-Operator": [\n                                        "<"\n                                      ],\n                                      "Eq-Temporal-Unit": [\n                                        "years"\n                                      ],\n                                      "Eq-Value": [\n                                        "5"\n                                      ],\n                                      "Eq-Comparison": [\n                                        "<5 years"\n                                      ],\n                                      "Observation": [\n                                        "life expectancy"\n                                      ],\n                                      "Observation-Name": [\n                                        "life expectancy"\n                                      ]\n                                    }\n                                  }\n                                }\n                              }\n                            }\n                          }\n                        },\n                        "right": {\n                          "OR": {\n                            "left": {\n                              "raw_text": "3. end-stage disease",\n                              "Condition": [\n                                "disease"\n                              ],\n                              "Modifier": [\n                                "end-stage"\n                              ]\n                            },\n                            "right": {\n                              "raw_text": "or serious illness that prohibits participation (e.g. end-stage renal disease or class IV congestive heart failure);",\n                              "Condition": [\n                                "disease",\n                                "illness",\n      