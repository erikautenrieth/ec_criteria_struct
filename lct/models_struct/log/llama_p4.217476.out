          ]
        }
      }
    },
    "right": {
      "AND": {
        "left": {
          "raw_text": "- Participation of at least one official match in the last year",
          "Eq-Comparison": [
            "at least one",
            "last year"
          ],
          "Eq-Operator": [
            "at least"
          ],
          "Eq-Value": [
            "one"
          ],
          "Eq-Temporal-Period": [
            "last"
          ],
          "Eq-Temporal-Unit": [
            "year"
          ],
          "Observation": [
            "official match"
          ],
          "Observation-Name": [
            "official match"
