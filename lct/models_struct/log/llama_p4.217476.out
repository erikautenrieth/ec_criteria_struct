  "AND": {
    "left": {
      "AND": {
        "left": {
          "AND": {
            "left": {
              "raw_text": "- Patients who have had previous orthopedic treatment",
              "Procedure": [
                "orthopedic treatment"
              ],
              "Procedure-Name": [
