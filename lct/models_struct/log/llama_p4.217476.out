w_text": "7. Pregnancy",\n          "Condition": [\n            "Pregnancy"\n          ],\n          "Condition-Name": [\n            "Pregnancy"\n          ]\n        }\n      }\n    },\n    "right": {\n      "raw_text": "8. Inability to operate the smart-watch",\n      "Negation": [\n        "Inability"\n      ],\n      "Assertion": [\n        "Inability"\n      ]\n    }\n  }\n}<|eot_id|>']
