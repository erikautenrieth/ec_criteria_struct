          ],\n                  "Drug": [\n                    "antifungal azoles"\n                  ],\n                  "Drug-Name": [\n                    "antifungal azoles"\n                  ]\n                }\n              }\n            },\n            "right": {\n              "OR": {\n                "left": {\n                  "raw_text": "- subjects with active pulmonary infection due to mycobacterium tuberculosis",\n                  "Condition": [\n                    "pulmonary infection"\n                  ],\n                  "Condition-Name": [\n                    "pulmonary infection"\n                  ],\n                  "Eq-Comparison": [\n                    "active"\n                  ],\n                  "Eq-Temporal-Period": [\n                    "active"\n                  ],\n                  "Organism": [\n                    "mycobacterium tuberculosis"\n                  ],\n                  "Organism-Name": [\n                    "mycobacterium tuberculosis"\n                  ]\n                },\n                "right": {\n                  "raw_text": "or mycobacteria other than tuberculosis (MOTT)",\n                  "Condition": [\n                    "tuberculosis",\n                    "MOTT"\n                  ],\n                  "Condition-Name": [\n                    "tuberculosis",\n                    "MOTT"\n                  ],\n                  "Organism": [\n                    "mycobacteria"\n                  ],\n                  "Organism-Name": [\n                    "mycobacteria"\n                  ],\n                  "Exception": [\n                    "other than"\n                  ]\n                }\n              }\n            }\n          }\n        },\n        "right": {\n          "OR": {\n            "left": {\n              "raw_text": "- subjects with others forms of pulmonary aspergillosis (allergic bronchopulmonary aspergillosis, chronic necrotizing aspergillosis",\n              "Condition": [\n                "pulmonary aspergillosis",\n                "allergic bronchopulmonary aspergillosis",\n                "necrotizing aspergillosis"\n              ],\n              "Condition-Name": [\n                "pulmonary aspergillosis",\n                "allergic bronchopulmonary aspergillosis",\n                "necrotizing aspergillosis"\n              ],\n              "Acuteness": [\n                "chronic"\n              ],\n              "Other": [\n                "others"\n              ]\n            },\n            "right": {\n              "raw_text": "and angio-invasive aspergillosis)",\n              "Condition": [\n                "aspergillosis"\n              ],\n              "Condition-Name": [\n                "aspergillosis"\n              ],\n              "Modifier": [\n                "angio-invasive"\n              ]\n            }\n          }\n        }\n      }\n    },\n    "right": {\n      "raw_text": "- pregnancy",\n      "Condition": [\n        "pregnancy"\n      ],\n      "Condition-Name": [\n        "pregnancy"\n      ]\n    }\n  }\n}<|eot_id|>']
