[\n                    "donation"\n                  ],\n                  "Observation-Name": [\n                    "donation"\n                  ]\n                }\n              }\n            }\n          }\n        },\n        "right": {\n          "raw_text": "- Patients who received immunosuppressive agent within the past 1 year",\n          "Eq-Operator": [\n            "within",\n            "-"\n          ],\n          "Eq-Value": [\n            "1"\n          ],\n          "Drug": [\n            "immunosuppressive agent"\n          ],\n          "Drug-Name": [\n            "immunosuppressive agent"\n          ],\n          "Eq-Comparison": [\n            "within the past 1 year",\n            "received"\n          ],\n          "Eq-Temporal-Unit": [\n            "year"\n          ],\n          "Eq-Temporal-Period": [\n            "received",\n            "past"\n          ]\n        }\n      }\n    },\n    "right": {\n      "raw_text": "- Patients who diagnosed with glomerulonephritis through kidney biopsy",\n      "Condition": [\n        "glomerulonephritis"\n      ],\n      "Condition-Name": [\n        "glomerulonephritis"\n      ],\n      "Procedure": [\n        "kidney biopsy"\n      ],\n      "Procedure-Name": [\n        "kidney biopsy"\n      ],\n      "Eq-Operator": [\n        "-"\n      ]\n    }\n  }\n}<|eot_id|>']
