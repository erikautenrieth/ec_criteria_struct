     "left": {\n                                              "raw_text": "- Food allergies",\n                                              "Eq-Operator": [\n                                                "-"\n                                              ],\n                                              "Life-Stage-And-Gender": [\n                                                "F"\n                                              ],\n                                              "Allergy": [\n                                                "allergies"\n                                              ],\n                                              "Allergy-Name": [\n                                                "Food"\n                                              ],\n                                              "Eq-Temporal-Unit": [\n                                                "d"\n                                              ]\n                                            },\n                                            "right": {\n                                              "raw_text": "or lactose intolerance",\n                                              "Condition": [\n                                                "lactose intolerance"\n                                              ],\n                                              "Condition-Name": [\n                                                "lactose intolerance"\n                                              ]\n                                            }\n                                          }\n                                        }\n                                      }\n                                    },\n                                    "right": {\n                                      "OR": {\n                                        "left": {\n                                          "raw_text": "- User of dietary supplements",\n                                       