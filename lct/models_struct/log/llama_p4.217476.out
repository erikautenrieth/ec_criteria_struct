      ]
    },
    "right": {
      "OR": {
        "left": {
          "raw_text": "cardiac disease,",
          "Condition": [
            "cardiac disease"
          ],
          "Condition-Name": [
            "cardiac disease"
          ]
        },
        "right": {
          "OR": {
            "left": {
              "raw_text": "pregnancy",
              "Condition": [
