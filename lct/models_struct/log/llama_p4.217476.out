se requiring treatment",\n                              "Condition": [\n                                "disease"\n                              ],\n                              "Modifier": [\n                                "chronic"\n                              ],\n                              "Assertion": [\n                                "requiring"\n                              ],\n                              "Procedure": [\n                                "treatment"\n                              ]\n                            },\n                            "right": {\n                              "OR": {\n                                "left": {\n                                  "raw_text": "and who have"\n                                },\n                                "right": {\n                                  "NOT": {\n                                    "left": {\n                                      "OR": {\n                                        "left": {\n                                          "raw_text": "no pathological symptoms",\n                                          "Negation": [\n                                            "no"\n                                          ],\n                                          "Assertion": [\n                                            "symptoms"\n                                          ],\n                                          "Modifier": [\n                                            "pathological"\n                                          ]\n                                        },\n                                        "right": {\n                                          "raw_text": "or findings",\n                                          "Assertion": [\n                                            "findings"\n                                          ]\n                                        }\n                                      }\n                                    }\n                                  }\n                                }\n                              }\n                            }\n                          }\n                        }\n                      }\n                    }\n                  }\n                }\n              }\n            }\n          }\n        },\n        "right": {\n          "OR": {\n            "left": {\n              "raw_text": "4. Those who are judged to be eligible for clinical trials based on laboratory",\n              "Study": [\n                "clinical trials",\n                "trials"\n              ],\n              "Assertion": [\n                "eligible for"\n              ],\n              "Observation": [\n                "laboratory"\n              ],\n              "Observation-Name": [\n                "laboratory"\n              ]\n            },\n            "right": {\n              "raw_text": "and ECG results during screening tests",\n              "Procedure": [\n                "ECG"\n              ],\n              "Procedure-Name": [\n                "ECG"\n              ],\n              "Study": [\n                "screening"\n              ],\n              "Observation": [\n                "results"\n              ]\n            }\n          }\n        }\n      }\n    },\n    "right": {\n      "raw_text": "5. Those who voluntarily decide to participate and agree to comply with the cautions after hearing and fully understanding the detailed description of this clinical trial",\n      "Study": [\n        "clinical trial",\n        "trial"\n      ]\n    }\n  }\n}<|eot_id|>']
