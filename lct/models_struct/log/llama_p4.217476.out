n                },\n                "right": {\n                  "raw_text": "- Malignant disease as the cause of the vulval symptoms",\n                  "Condition": [\n                    "Malignant disease",\n                    "vulval"\n                  ],\n                  "Condition-Name": [\n                    "Malignant disease",\n                    "vulval"\n                  ],\n                  "Assertion": [\n                    "symptoms"\n                  ],\n                  "Modifier": [\n                    "vulva"\n                  ]\n                }\n              }\n            },\n            "right": {\n              "raw_text": "- BMI > 35 kg/m²",\n              "Observation": [\n                "BMI"\n              ],\n              "Observation-Name": [\n                "BMI"\n              ],\n              "Eq-Operator": [\n                ">"\n              ],\n              "Eq-Unit": [\n                "kg",\n                "m²"\n              ],\n              "Eq-Value": [\n                "35"\n              ],\n              "Eq-Comparison": [\n                "> 35 kg/m²"\n              ]\n            }\n          }\n        },\n        "right": {\n          "OR": {\n            "left": {\n              "raw_text": "- Acute infection (fungal,",\n              "Condition": [\n                "infection"\n              ],\n              "Condition-Name": [\n                "infection"\n              ],\n              "Acuteness": [\n                "Acute"\n              ],\n              "Modifier": [\n                "fungal"\n              ]\n            },\n            "right": {\n              "OR": {\n                "left": {\n                  "raw_text": "bacterial,",\n                  "Modifier": [\n                    "bacterial"\n                  ]\n                },\n                "right": {\n                  "raw_text": "viral) of the vulva, vagina or bladder",\n                  "Modifier": [\n                    "vulva",\n                    "vagina",\n                    "bladder"\n                  ]\n                }\n              }\n            }\n          }\n        }\n      }\n    },\n    "right": {\n      "OR": {\n        "left": {\n          "raw_text": "- Presence of contraindications for the laser treatment",\n          "Procedure": [\n            "laser treatment",\n            "treatment"\n          ],\n          "Procedure-Name": [\n            "laser treatment"\n          ],\n          "Contraindication": [\n            "contraindications"\n          ]\n        },\n        "right": {\n          "raw_text": "or topical steroid treatment",\n          "Procedure": [\n            "treatment",\n            "steroid treatment"\n          ],\n          "Procedure-Name": [\n            "steroid treatment"\n          ],\n          "Modifier": [\n            "topical"\n          ]\n        }\n      }\n    }\n  }\n}<|eot_id|>']
