                          "right": {\n                                      "OR": {\n                                        "left": {\n                                          "raw_text": "hereditary hemorrhagic disorders/",\n                                          "Modifier": [\n                                            "hereditary"\n                                          ],\n                                          "Condition": [\n                                            "hemorrhagic disorders"\n                                          ],\n                                          "Condition-Name": [\n                                            "hemorrhagic disorders"\n                                          ]\n                                        },\n                                        "right": {\n                                          "OR": {\n                                            "left": {\n                                              "raw_text": "or receiving therapeutic doses of Coumadin",\n                                              "Eq-Comparison": [\n                                                "receiving"\n                                              ],\n                                              "Drug": [\n                                                "Coumadin"\n                                              ],\n                                              "Eq-Temporal-Period": [\n                                                "receiving"\n                                              ],\n                                              "Drug-Name": [\n                                                "Coumadin"\n                                              ]\n                                            },\n                                            "right": {\n                                              "raw_text": "or heparin.",\n                                              "Drug": [\n                      