             ]\n                                },\n                                "right": {\n                                  "OR": {\n                                    "left": {\n                                      "raw_text": "bacterial vaginosis,",\n                                      "Condition": [\n                                        "bacterial vaginosis"\n                                      ],\n                                      "Condition-Name": [\n                                        "bacterial vaginosis"\n                                      ]\n                                    },\n                                    "right": {\n                                      "OR": {\n                                        "left": {\n                                          "raw_text": "vaginal pH > 4 at the time of birth. Mothers with fecal samples positive for Salmonella,",\n                                          "Family-Member": [\n                                            "Mothers"\n                                          ],\n                                          "Eq-Operator": [\n                                            ">"\n                                          ],\n                                          "Eq-Value": [\n                                            "4"\n                                          ],\n                                          "Eq-Comparison": [\n                                            "> 4"\n                                          ],\n                                          "Observation": [\n                                            "vaginal pH"\n                                          ],\n                                          "Observation-Name": [\n                                            "vaginal pH"\n                                          ],\n                                          "Birth": [\n                                            "birth"\n               