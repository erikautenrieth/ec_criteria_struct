          "Condition": [
            "Pregnant"
          ],
          "Condition-Name": [
            "Pregnant"
          ],
          "Life-Stage-And-Gender": [
            "women"
          ]
        }
      }
    },
    "right": {
      "raw_text": "- People with disabilities.",
      "Condition": [
        "disabilities"
      ],
      "Condition-Name": [
        "disabilities"
      ]
    }
  }
}
