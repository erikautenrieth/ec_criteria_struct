                           "abnormally shaped pupils"\n                          ]\n                        },\n                        "right": {\n                          "AND": {\n                            "left": {\n                              "raw_text": "or pupils that do",\n                              "Condition": [\n                                "pupils"\n                              ],\n                              "Condition-Name": [\n                                "pupils"\n                              ]\n                            },\n                            "right": {\n                              "NOT": {\n                                "left": {\n                                  "raw_text": "not dilate under mesopic/ scotopic conditions)",\n                                  "Condition": [\n                                    "mesopic",\n                                    "scotopic conditions"\n                                  ],\n                                  "Condition-Name": [\n                                    "mesopic",\n                                    "scotopic conditions"\n                                  ],\n                                  "Observation": [\n                                    "dilate"\n                                  ],\n                                  "Observation-Name": [\n                                    "dilate"\n                                  ],\n                                  "Negation": [\n                                    "not"\n                                  ]\n                                }\n                              }\n                            }\n                          }\n                        }\n                      }\n                    }\n                  }\n                }\n              }\n            }\n          }\n        },\n        "right": {\n          "raw_text": "- Instability to place the intraocular lens safely at the location planned",\n          "Procedure": [\n            "intraocular lens"\n          ],\n          "Procedure-Name": [\n            "intraocular lens"\n          ],\n          "Assertion": [\n            "planned"\n          ],\n          "Stability": [\n            "Instability"\n          ]\n        }\n      }\n    },\n    "right": {\n      "raw_text": "- Pregnancy (pregnancy test will be taken pre-operatively in women of reproductive age)",\n      "Condition": [\n        "Pregnancy"\n      ],\n      "Condition-Name": [\n        "Pregnancy"\n      ],\n      "Procedure": [\n        "operative"\n      ],\n      "Observation": [\n        "pregnancy test"\n      ],\n      "Observation-Name": [\n        "pregnancy test"\n      ],\n      "Life-Stage-And-Gender": [\n        "women"\n      ]\n    }\n  }\n}<|eot_id|>']
