            "left": {
              "raw_text": "Unable to answer the questions due to a cognitive impairment",
              "Condition": [
                "cognitive impairment"
              ],
              "Condition-Name": [
                "cognitive impairment"
              ],
              "Procedure": [
                "questions"
              ],
              "Procedure-Name": [
