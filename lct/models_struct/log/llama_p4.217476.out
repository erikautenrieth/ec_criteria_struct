urgery\n\n### Response:\n{\n  "OR": {\n    "left": {\n      "raw_text": "- Documented keratoconus",\n      "Condition": [\n        "keratoconus"\n      ],\n      "Condition-Name": [\n        "keratoconus"\n      ]\n    },\n    "right": {\n      "raw_text": "or ectasia after refractive surgery",\n      "Condition": [\n        "ectasia"\n      ],\n      "Procedure": [\n        "refractive surgery"\n      ],\n      "Condition-Name": [\n        "ectasia"\n      ],\n      "Procedure-Name": [\n        "refractive surgery"\n      ]\n    }\n  }\n}<|eot_id|>']
