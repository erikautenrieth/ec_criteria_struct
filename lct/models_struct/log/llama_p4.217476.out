d written informed consent to participation in this study",\n          "Study": [\n            "study"\n          ]\n        }\n      }\n    },\n    "right": {\n      "raw_text": "- Consent to contraception",\n      "Procedure": [\n        "contraception"\n      ],\n      "Procedure-Name": [\n        "contraception"\n      ],\n      "Assertion": [\n        "Consent to"\n      ]\n    }\n  }\n}<|eot_id|>']
