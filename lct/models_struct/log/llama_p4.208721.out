nancy while participating in the study",\n                                              "Condition": [\n                                                "pregnancy"\n                                              ],\n                                              "Condition-Name": [\n                                                "pregnancy"\n                                              ],\n                                              "Study": [\n                                                "study"\n                                              ],\n                                              "Assertion": [\n                                                "plan"\n                                              ]\n                                            }\n                                          }\n                                        }\n                                      }\n                                    }\n                                  }\n                                },\n                                "right": {\n                                  "OR": {\n                                    "left": {\n                                      "raw_text": "- Systemic neurological disorders",\n                                      "Condition": [\n                                        "neurological disorders"\n                                      ],\n                                      "Condition-Name": [\n                                        "neurological disorders"\n                                      ],\n                                      "Modifier": [\n                                        "Systemic"\n                                      ]\n                                    },\n                                    "right": {\n                                      "raw_text": "with mobility limitations (e.g. advanced Parkinson\'s disease or multiple sclerosis)",\n                                      "Condition": [\n         