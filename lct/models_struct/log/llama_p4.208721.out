                "Condition-Name": [\n                                        "cancer"\n                                      ],\n                                      "Modifier": [\n                                        "hereditary"\n                                      ]\n                                    }\n                                  }\n                                }\n                              }\n                            }\n                          }\n                        }\n                      }\n                    },\n                    "right": {\n                      "OR": {\n                        "left": {\n                          "raw_text": "- indication for modified radical hysterectomy",\n                          "Procedure": [\n                            "hysterectomy",\n                            "radical hysterectomy",\n                            "modified radical hysterectomy"\n                          ],\n                          "Procedure-Name": [\n                            "hysterectomy",\n                            "radical hysterectomy",\n                            "modified radical hysterectomy"\n                          ],\n                          "Indication": [\n                            "indication"\n                          ]\n                        },\n                        "right": {\n                          "OR": {\n                            "left": {\n                              "raw_text": "and/or pelvic-",\n                              "Modifier": [\n                                "pelvic"\n                              ]\n                            },\n                            "right": {\n                              "OR": {\n                                "left": {\n                                  "raw_text": "para-aortic (sentinel-node) lymphadenectomy for endometrial cancer",\n                                  "Condition": [\n                                    "cancer"\n                                  ],\n                                  "Condition-Name": [\n                                    "cancer"\n                                  ],\n                                  "Procedure": [\n                                    "lymphadenectomy",\n                                    "sentinel-node"\n                                  ],\n                                  "Procedure-Name": [\n                                    "lymphadenectomy",\n                                    "sentinel-node"\n                                  ],\n                                  "Modifier": [\n                                    "para-aortic",\n                                    "endometrial"\n                                  ]\n                                },\n                                "right": {\n                                  "raw_text": "or prophylactic surgery due to hereditary cancer",\n                                  "Procedure": [\n                                    "prophylactic surgery"\n                                  ],\n                                  "Procedure-Name": [\n                                    "prophylactic surgery"\n                                  ],\n                                  "Condition": [\n                                    "cancer"\n                                  ],\n                                  "Condition-Name": [\n                                    "cancer"\n                                  ],\n                                  "Modifier": [\n                                    "hereditary"\n                                  ]\n                                }\n                              }\n                            }\n                          }\n                        }\n                      }\n                    }\n                  }\n                },\n                "right": {\n                  "raw_text": "- size of uterus and vagina allows for retrieval by the vaginal route in cancer patients",\n                  "Condition": [\n                    "cancer"\n                  ],\n                  "Condition-Name": [\n                    "cancer"\n                  ],\n                  "Observation": [\n                    "size of uterus and vagina"\n                  ],\n                  "Observation-Name": [\n                    "size of uterus and vagina"\n                  ],\n                  "Procedure": [\n                    "retrieval by the vaginal route"\n                  ],\n                  "Procedure-Name": [\n                    "retrieval by the vaginal route"\n                  ],\n                  "Assertion": [\n                    "allows for"\n                  ]\n                }\n              }\n            },\n            "right": {\n              "raw_text": "- written informed consent"\n            }\n          }\n        },\n        "right": {\n          "raw_text": "- age ≥18 years",\n          "Age": [\n            "age"\n          ],\n          "Eq-Comparison": [\n            "≥18 years"\n          ],\n          "Eq-Operator": [\n            "≥"\n          ],\n          "Eq-Value": [\n            "18"\n          ],\n          "Eq-Temporal-Unit": [\n            "years"\n          ]\n        }\n      }\n    },\n    "right": {\n      "raw_text": "- BMI ≤40 kg/m2",\n      "Observation": [\n        "BMI"\n      ],\n      "Observation-Name": [\n        "BMI"\n      ],\n      "Eq-Comparison": [\n        "≤40 kg/m2"\n      ],\n      "Eq-Operator": [\n        "≤"\n      ],\n      "Eq-Value": [\n        "40"\n      ],\n      "Eq-Unit": [\n        "kg",\n        "m2"\n      ]\n    }\n  }\n}<|eot_id|>']
