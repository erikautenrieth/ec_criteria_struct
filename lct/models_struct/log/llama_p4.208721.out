             "left": {\n                      "raw_text": "or illness that would increase risk",\n                      "Condition": [\n                        "illness"\n                      ],\n                      "Risk": [\n                        "risk"\n                      ],\n                      "Polarity": [\n                        "increase"\n                      ],\n                      "Assertion": [\n                        "would"\n                      ]\n                    },\n                    "right": {\n                      "OR": {\n                        "left": {\n                          "raw_text": "or confound study results [e.g. diabetes mellitus (with retinopathy),                          immunocompromised,                          glaucoma,                          epiretinal membrane,                          cornea guttata,                          etc….]",\n                          "Condition": [\n                            "diabetes mellitus",\n                            "retinopathy",\n                            "immunocompromised",\n                            "glaucoma",\n                            "epiretinal membrane",\n                            "cornea guttata"\n                          ],\n                          "Condition-Name": [\n                            "diabetes mellitus",\n                            "retinopathy",\n                            "immunocompromised",\n                            "glaucoma",\n                            "epiretinal membrane",\n                            "cornea guttata"\n                          ],\n                          "Study": [\n                            "study"\n                          ],\n                          "Stability": [\n                            "confound"\n                          ]\n                        },\n                        "right": {\n                          "raw_text": "etc….]",\n                          "Other": [\n                            "etc…."\n                          ]\n                        }\n                      }\n                    }\n                  }\n                }\n              }\n            }\n          }\n        },\n        "right": {\n          "OR": {\n            "left": {\n              "raw_text": "- Amblyopia,              strabismus",\n              "Condition": [\n                "Amblyopia",\n                "strabismus"\n              ],\n              "Condition-Name": [\n                "Amblyopia",\n                "strabismus"\n              ]\n            },\n            "right": {\n              "raw_text": "Extremely shallow anterior chamber",\n              "Modifier": [\n                "Extremely shallow anterior chamber"\n              ]\n            }\n          }\n        }\n      }\n    },\n    "right": {\n      "OR": {\n        "left": {\n          "raw_text": "- Capsule",\n          "Modifier": [\n            "Capsule"\n          ]\n        },\n        "right": {\n          "OR": {\n            "left": {\n              "raw_text": "or zonular abnormalities that may affect postoperative centration",\n              "Condition": [\n                "abnormalities"\n              ],\n              "Condition-Name": [\n                "abnormalities"\n              ],\n              "Modifier": [\n                "zonular",\n                "postoperative centration"\n              ],\n              "Procedure": [\n                "operative"\n              ],\n              "Assertion": [\n                "may"\n              ]\n            },\n            "right": {\n              "OR": {\n                "left": {\n                  "raw_text": "or tilt of the lens (e.g. pseudoexfoliation syndrome,                  uveitis,                  Marfan\'s syndrome)",\n                  "Condition": [\n                    "pseudoexfoliation syndrome",\n                    "uveitis",\n                    "Marfan\'s syndrome"\n                  ],\n                  "Condition-Name": [\n                    "pseudoexfoliation syndrome",\n                    "uveitis",\n                    "Marfan\'s syndrome"\n                  ],\n                  "Modifier": [\n                    "tilt of the lens"\n                  ]\n                },\n                "right": {\n                  "raw_text": "etc….]",\n                  "Other": [\n                    "etc…."\n                  ]\n                }\n              }\n            }\n          }\n        }\n      }\n    }\n  }\n}<|eot_id|>']
