                           "Procedure": [\n                                "kidney biopsy"\n                              ],\n                              "Procedure-Name": [\n                                "kidney biopsy"\n                              ],\n                              "Modifier": [\n                                "kidney"\n                              ]\n                            }\n                          }\n                        },\n                        "right": {\n                          "raw_text": "- Patients who received chronic dialysis",\n                          "Procedure": [\n                            "dialysis"\n                          ],\n                          "Procedure-Name": [\n                            "dialysis"\n                          ],\n                          "Eq-Comparison": [\n                            "received"\n                          ],\n                          "Eq-Temporal-Period": [\n                            "received"\n                          ],\n                          "Acuteness": [\n                            "chronic"\n                          ]\n                        }\n                      }\n                    },\n                    "right": {\n                      "raw_text": "- Patients who received kidney transplant",\n                      "Procedure": [\n                        "kidney transplant"\n                      ],\n                      "Procedure-Name": [\n                        "kidney transplant"\n                      ],\n                      "Eq-Comparison": [\n                        "received"\n                      ],\n                      "Eq-Temporal-Period": [\n                        "received"\n                      ],\n                      "Modifier": [\n                        "kidney"\n                      ]\n                    }\n                  }\n                },\n                "right": {\n                  "raw_te