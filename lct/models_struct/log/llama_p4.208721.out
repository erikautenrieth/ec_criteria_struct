      },\n                                    "right": {\n                                      "raw_text": "- Presence of heamatological diseases,\n",\n                                      "Condition": [\n                                        "heamatological diseases"\n                                      ],\n                                      "Condition-Name": [\n                                        "heamatological diseases"\n                                      ]\n                                    }\n                                  }\n                                },\n                                "right": {\n                                  "raw_text": "- Urinary tract infection,\n",\n                                  "Condition": [\n                                    "Urinary tract infection"\n                                  ],\n                                  "Condition-Name": [\n                                    "Urinary tract infection"\n                                  ]\n                                }\n                              }\n                            },\n                            "right": {\n                              "raw_text": "- Diagnosis of any malignencies,\n",\n                              "Condition": [\n                                "malignencies"\n                              ],\n                              "Condition-Name": [\n                                "malignencies"\n                              ]\n                            }\n                          }\n                        },\n                        "right": {\n                          "raw_text": "- Chronic kidney failure,\n                          "Condition": [\n                            "kidney failure"\n                          ],\n                          "Condition-Name": [\n                            "kidney failure"\n                          ],\n                          "Acuteness": [\n                            "Chronic"\n                          ]\n                        }\n                      }\n                    },\n                    "right": {\n                      "raw_text": "- Presence of metabolic syndrome,\n                      "Condition": [\n                        "metabolic syndrome"\n                      ],\n                      "Condition-Name": [\n                        "metabolic syndrome"\n                      ]\n                    }\n                  }\n                },\n                "right": {\n                  "OR": {\n                    "left": {\n                      "raw_text": "- Presence of psychiatric diseases",\n                      "Condition": [\n                        "psychiatric diseases"\n                      ],\n                      "Condition-Name": [\n                        "psychiatric diseases"\n                      ]\n                    },\n                    "right": {\n                      "raw_text": "and/or medical treatment,",\n                      "Procedure": [\n                        "medical treatment"\n                      ]\n                    }\n                  }\n                }\n              }\n            },\n            "right": {\n              "raw_text": "- Smoking,\n              "Observation": [\n                "Smoking"\n              ],\n              "Observation-Name": [\n                "Smoking"\n              ]\n            }\n          }\n        },\n        "right": {\n          "OR": {\n            "left": {\n              "raw_text": "- History of pelvic surgery,",\n              "Eq-Comparison": [\n                "History"\n              ],\n              "Eq-Temporal-Period": [\n                "History"\n              ],\n              "Procedure": [\n                "pelvic surgery"\n              ],\n              "Procedure-Name": [\n                "pelvic surgery"\n              ]\n            },\n            "right": {\n              "OR": {\n 