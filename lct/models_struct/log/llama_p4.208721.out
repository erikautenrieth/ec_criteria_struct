rison": [\n            "between 15-20 mm"\n          ],\n          "Eq-Operator": [\n            "between"\n          ],\n          "Eq-Value": [\n            "15",\n            "20"\n          ],\n          "Eq-Unit": [\n            "mm"\n          ]\n        }\n      }\n    },\n    "right": {\n      "raw_text": "5. Patients included in the study were post traumatic patients, hemifacial microsomia, Treacher Collins and post ankylotic mandibular deformity.",\n      "Condition": [\n        "hemifacial microsomia",\n        "ankylotic mandibular deformity",\n        "Treacher Collins"\n      ],\n      "Condition-Name": [\n        "hemifacial microsomia",\n        "ankylotic mandibular deformity",\n        "Treacher Collins"\n      ],\n      "Observation": [\n        "traumatic"\n      ],\n      "Observation-Name": [\n        "traumatic"\n      ],\n      "Study": [\n        "study"\n      ]\n    }\n  }\n}<|eot_id|>']
