llapse"\n      ],\n      "Procedure": [\n        "septorhinoplasty",\n        "consultation"\n      ],\n      "Procedure-Name": [\n        "septorhinoplasty",\n        "consultation"\n      ],\n      "Modifier": [\n        "external"\n      ],\n      "Eq-Comparison": [\n        "at least 1 year"\n      ],\n      "Eq-Operator": [\n        "at least"\n      ],\n      "Eq-Value": [\n        "1"\n      ],\n      "Eq-Temporal-Unit": [\n        "year"\n      ],\n      "Assertion": [\n        "symptoms",\n        "eligible for"\n      ],\n      "Study": [\n        "study"\n      ]\n    }\n  }\n}<|eot_id|>']
