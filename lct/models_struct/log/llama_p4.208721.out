ght": {\n                                          "raw_text": "- Patients undergoing diagnostic colonoscopy (e.g. as an evaluation for active gastrointestinal bleed, referring collectively to the stomach and the small and large intestine).",\n                                          "Procedure": [\n                                            "colonoscopy",\n                                            "evaluation"\n                                          ],\n                                          "Procedure-Name": [\n                                            "colonoscopy",\n                                            "evaluation"\n                                          ],\n                                          "Eq-Comparison": [\n                                            "undergoing"\n                                          ],\n                                          "Eq-Temporal-Period": [\n                                            "undergoing"\n                                          ],\n                                          "Condition": [\n                                            "gastrointestinal bleed"\n                                          ],\n                                          "Condition-Name": [\n                                            "gastrointestinal bleed"\n                                          ],\n                                          "Modifier": [\n                                            "active",\n                                            "stomach",\n                                            "small and large intestine"\n                                          ]\n                                        }\n                                      }\n                                    },\n                                    "right": {\n                                      "raw_text": "- Patients with incomplete colonoscopies (those where endoscopists did not successfully intubate the cecum due to technical difficulties or poor bowel preparation)",\n                                      "Procedure": [\n                                        "colonoscopy",\n                                        "bowel preparation",\n                                        "intubate the cecum"\n                                      ],\n                                      "Procedure-Name": [\n                                        "colonoscopy",\n                                        "bowel preparation",\n                                        "intubate the cecum"\n                                      ],\n                                      "Modifier": [\n                                        "incomplete",\n                                        "technical difficulties"\n                                      ]\n                                    }\n                                  }\n                                },\n                                "right": {\n                                  "OR": {\n                                    "left": {\n                                      "raw_text": "- Patients with standard contraindications to colonoscopy in general (e.g. documented acute diverticulitis, fulminant colitis",\n                                      "Procedure": [\n                                        "colonoscopy"\n                                      ],\n                                      "Procedure-Name": [\n                                        "colonoscopy"\n                                      ],\n                                      "Condition": [\n                                        "acute diverticulitis",\n                                        "fulminant colitis"\n                                      ],\n                                      "Condition-Name": [\n                                        "acute diverticulitis",\n                                        "fulminant colitis"\n                             