ictions, return an empty JSON FILE {}\n- The entire text of the eligibility criteria must be included and separated by the logical operators, without omitting any words or information.\n- The output should only contain the JSON object, without any additional text or formatting.\n- Ensure that the JSON output strictly follows these rules and accurately represents the logical structure of the input eligibility criteria.\n\n### Input:\n-  Serum Glucose 100-126 mg/dl\n-  Waist C >89/102 cm; F/M\n-  Serum HDL-C: <50/40 mg/dl; F/M\n-  Serum TG: >150 mg/dl\n-  BP >130/85 mmHg\n-  Serum Endotoxin >25 EU/ml\n\n### Response:\n{\n  "AND": {\n    "left": {\n      "AND": {\n        "left": {\n          "AND": {\n            "left": {\n              "AND": {\n                "left": {\n                  "AND": {\n                    "left": {\n                      "raw_text": "- Serum Glucose 100-126 mg/dl",\n                      "Observation": [\n                        "Serum Glucose"\n                      ],\n                      "Eq-Comparison": [\n                        "100-126 mg/dl"\n                      ],\n                      "Observation-Name": [\n                        "Serum Glucose"\n                      ],\n                      "Eq-Value": [\n                        "100",\n                        "126"\n                      ],\n                      "Eq-Operator": [\n                        "-"\n                      ],\n                      "Eq-Unit": [\n                        "mg",\n                        "dl"\n                      ]\n                    },\n                    "right": {\n                      "OR": {\n                        "left": {\n                          "raw_text": "- Waist C >89/102 cm; F/",\n                          "Eq-Comparison": [\n                            ">89/102 cm"\n                          ],\n                          "Observation": [\n                            "Waist C"\n                          ],\n                          "Eq-Operator": [\n                            "-",\n                            ">"\n                          ],\n                          "Observation-Name": [\n                            "Waist C"\n                          ],\n                          "Eq-Value": [\n                            "89",\n                            "102"\n                          ],\n                          "Eq-Unit": [\n                            "cm"\n                          ],\n                          "Modifier": [\n                            "F"\n                          ]\n                        },\n                        "right": {\n                          "raw_text": "M",\n                          "Modifier": [\n                            "M"\n                          ]\n                        }\n                      }\n                    }\n                  }\n                },\n                "right": {\n                  "raw_text": "- Serum HDL-C: <50/40 mg/dl; F/M",\n                  "Observation": [\n                    "Serum HDL-C"\n                  ],\n                  "Eq-Comparison": [\n                    "<50/40 mg/dl"\n                  ],\n                  "Eq-Operator": [\n                    "-",\n                    "<"\n                  ],\n                  "Observation-Name": [\n                    "Serum HDL-C"\n                  ],\n                  "Eq-Value": [\n                    "50",\n                    "40"\n                  ],\n                  "Eq-Unit": [\n                    "mg",\n                    "dl"\n                  ],\n                  "Modifier": [\n                    "F",\n                    "M"\n                  ]\n                }\n              }\n            },\n            "right": {\n              "raw_text": "- Serum TG: >150 mg/dl",\n              "Observation": [\n                "Serum TG"\n              ],\n              "Eq-Comparison": [\n                ">150 mg/dl"\n              ],\n              "Eq-Operator": [\n                "-",\n                ">"\n              ],\n              "Observation-Name": [\n                "Serum TG"\n              ],\n              "Eq-Value": [\n                "150"\n              ],\n              "Eq-Unit": [\n                "mg",\n                "dl"\n              ]\n            }\n          }\n        },\n        "right": {\n          "raw_text": "- BP >130/85 mmHg",\n          "Observation": [\n            "BP"\n          ],\n          "Eq-Comparison": [\n            ">130/85 mmHg"\n          ],\n          "Eq-Operator": [\n            "-",\n            ">"\n          ],\n          "Observation-Name": [\n            "BP"\n          ],\n          "Eq-Value": [\n            "130",\n            "85"\n          ],\n          "Eq-Unit": [\n            "mmHg"\n          ]\n        }\n      }\n    },\n    "right": {\n      "raw_text": "- Serum Endotoxin >25 EU/ml",\n      "Observation": [\n        "Serum Endotoxin"\n      ],\n      "Eq-Comparison": [\n        ">25 EU/ml"\n      ],\n      "Eq-Operator": [\n        "-",\n        ">"\n      ],\n      "Observation-Name": [\n        "Serum Endotoxin"\n      ],\n      "Eq-Value": [\n        "25"\n      ],\n      "Eq-Unit": [\n        "EU",\n        "ml"\n      ]\n    }\n  }\n}<|eot_id|>']
