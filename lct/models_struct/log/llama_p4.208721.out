ictions, return an empty JSON FILE {}\n- The entire text of the eligibility criteria must be included and separated by the logical operators, without omitting any words or information.\n- The output should only contain the JSON object, without any additional text or formatting.\n- Ensure that the JSON output strictly follows these rules and accurately represents the logical structure of the input eligibility criteria.\n\n### Input:\n-  Patients with a diagnosis of atrial fibrillation (AF), atrial flutter and/or ventricular tachycardia (VT)\n-  Patients with an ILR already in-situ or an established indication for ILR\n-  Patients with a palliative diagnosis i.e. life expectancy less than 3 years\n-  Patients who lack capacity\n\n### Response:\n{\n  "AND": {\n    "left": {\n      "AND": {\n        "left": {\n          "AND": {\n            "left": {\n              "AND": {\n                "left": {\n                  "raw_text": "- Patients with a diagnosis of atrial fibrillation (AF), atrial flutter and/or ventricular tachycardia (VT)",\n                  "Condition": [\n                    "atrial fibrillation",\n                    "atrial flutter",\n                    "ventricular tachycardia",\n                    "AF",\n                    "VT"\n                  ],\n                  "Condition-Name": [\n                    "atrial fibrillation",\n                    "atrial flutter",\n                    "ventricular tachycardia",\n                    "AF",\n                    "VT"\n                  ]\n                },\n                "right": {\n                  "OR": {\n                    "left": {\n                      "raw_text": "- Patients with an ILR already in-situ",\n                      "Procedure": [\n                        "ILR"\n                      ],\n                      "Procedure-Name": [\n                        "ILR"\n                      ],\n                      "Modifier": [\n                        "in-situ"\n                      ]\n                    },\n                    "right": {\n                      "raw_text": "or an established indication for ILR",\n                      "Procedure": [\n                        "ILR"\n                      ],\n                      "Procedure-Name": [\n                        "ILR"\n                      ],\n                      "Indication": [\n                        "indication"\n                      ]\n                    }\n                  }\n                }\n              }\n            },\n            "right": {\n              "raw_text": "- Patients with a palliative diagnosis i.e. life expectancy less than 3 years",\n              "Condition": [\n                "palliative diagnosis"\n              ],\n              "Condition-Name": [\n                "palliative diagnosis"\n              ],\n              "Observation": [\n                "life expectancy"\n              ],\n              "Observation-Name": [\n                "life expectancy"\n              ],\n              "Eq-Comparison": [\n                "less than 3 years"\n              ],\n              "Eq-Operator": [\n                "less than"\n              ],\n              "Eq-Value": [\n                "3"\n              ],\n              "Eq-Temporal-Unit": [\n                "years"\n              ]\n            }\n          }\n        },\n        "right": {\n          "raw_text": "- Patients who lack capacity",\n          "Condition": [\n            "lack capacity"\n          ],\n          "Condition-Name": [\n            "lack capacity"\n          ]\n        }\n      }\n    },\n    "right": {\n      "raw_text": "- Patients who lack capacity",\n      "Condition": [\n        "lack capacity"\n      ],\n      "Condition-Name": [\n        "lack capacity"\n      ]\n    }\n  }\n}<|eot_id|>']
