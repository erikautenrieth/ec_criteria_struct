                        }\n                        }\n                      }\n                    },\n                    "right": {\n                      "raw_text": "6. Life expectancy less than 12 months",\n                      "Observation": [\n                        "Life expectancy"\n                      ],\n                      "Eq-Comparison": [\n                        "less than 12 months"\n                      ],\n                      "Observation-Name": [\n                        "Life expectancy"\n                      ],\n                      "Eq-Operator": [\n                        "less than"\n                      ],\n                      "Eq-Value": [\n                        "12"\n                      ],\n                      "Eq-Temporal-Unit": [\n                        "months"\n                      ]\n                    }\n                  }\n                },\n                "right": {\n                  "raw_text": "7. Pregnancy",\n                  "Condition": [\n                    "Pregnancy"\n                  ],\n                  "Condition-Name": [\n                    "Pregnancy"\n                  ]\n                }\n              }\n            },\n            "right": {\n              "raw_text": "8. Inability to operate the smart-watch",\n              "Condition": [\n                "Inability to operate the smart-watch"\n              ],\n              "Condition-Name": [\n                "Inability to operate the smart-watch"\n              ]\n            }\n          }\n        },\n        "right": {\n          "raw_text": "9. Contraindications to exercise training",\n          "Procedure": [\n            "exercise training"\n          ],\n          "Contraindication": [\n            "Contraindications"\n          ],\n          "Procedure-Name": [\n            "exercise training"\n          ]\n        }\n      }\n    },\n    "right": {\n      "raw_text": "10. Contraindications to moderate aerobic exercisi