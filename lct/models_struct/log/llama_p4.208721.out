ictions, return an empty JSON FILE {}\n- The entire text of the eligibility criteria must be included and separated by the logical operators, without omitting any words or information.\n- The output should only contain the JSON object, without any additional text or formatting.\n- Ensure that the JSON output strictly follows these rules and accurately represents the logical structure of the input eligibility criteria.\n\n### Input:\n1. History of presence of hepatobiliary, renal, cardiovascular, endocrine, respiratory, gastrointestinal, hematological, neurologic, psychiatric or musculoskeletal disorders affecting absorption, distribution, metabolism and excretion of the drug\n2. Genetic problems such as galactose intolerance, Lapp lactose deficiency or glucose-galactose malabsorption\n3. Those who are deemed unfit by the investigators to participate in the clinical trial for other reasons including the results of laboratory tests\n\n### Response:\n{\n  "AND": {\n    "left": {\n      "AND": {\n        "left": {\n          "OR": {\n            "left": {\n              "raw_text": "1. History of presence of hepatobiliary,",\n              "Eq-Comparison": [\n                "History"\n              ],\n              "Modifier": [\n                "hepatobiliary"\n              ],\n              "Eq-Temporal-Period": [\n                "History"\n              ]\n            },\n            "right": {\n              "OR": {\n                "left": {\n                  "raw_text": "renal,",\n                  "Modifier": [\n                    "renal"\n                  ]\n                },\n                "right": {\n                  "OR": {\n                    "left": {\n                      "raw_text": "cardiovascular,",\n                      "Modifier": [\n                        "cardiovascular"\n                      ]\n                    },\n                    "right": {\n                      "OR": {\n                        "left": {\n                          "raw_text": "endocrine,",\n                          "Modifier": [\n                            "endocrine"\n                          ]\n                        },\n                        "right": {\n                          "OR": {\n                            "left": {\n                              "raw_text": "respiratory,",\n                              "Modifier": [\n                                "respiratory"\n                              ]\n                            },\n                            "right": {\n                              "OR": {\n                                "left": {\n                                  "raw_text": "gastrointestinal,",\n                                  "Modifier": [\n                                    "gastrointestinal"\n                                  ]\n                                },\n                                "right": {\n                                  "OR": {\n                                    "left": {\n                                      "raw_text": "hematological,",\n                                      "Modifier": [\n                                        "hematological"\n                                      ]\n                                    },\n                                    "right": {\n                                      "OR": {\n                                        "left": {\n                                          "raw_text": "neurologic,",\n                                          "Modifier": [\n                                            "neurologic"\n                                          ]\n                                        },\n                                        "right": {\n                                          "OR": {\n                                            "left": {\n                                              "raw_text": "psychiatric",\n                                              "Modifier": [\n                                                "psychiatric"\n                                              ]\n                                            },\n                                            "right": {\n                                              "raw_text": "or musculoskeletal disorders affecting absorption, distribution, metabolism and excretion of the drug",\n                                              "Condition": [\n                                                "disorders"\n                                              ],\n                                              "Modifier": [\n                                                "musculoskeletal",\n                                                "absorption",\n                                                "distribution",\n                                                "metabolism",\n                                                "excretion"\n                                              ],\n                                              "Drug": [\n                                                "drug"\n                                              ],\n                                              "Condition-Name": [\n                                                "disorders"\n                                              ]\n                                            }\n                                          }\n                                        }\n                                      }\n                                    }\n                                  }\n                                }\n                              }\n                            }\n                          }\n                        }\n                      }\n                    }\n                  }\n                }\n              }\n            }\n          }\n        },\n        "right": {\n          "OR": {\n            "left": {\n              "raw_text": "2. Genetic problems such as galactose intolerance,",\n              "Condition": [\n                "Genetic problems",\n                "galactose intolerance"\n              ],\n              "Condition-Name": [\n                "Genetic problems",\n                "galactose intolerance"\n              ]\n            },\n            "right": {\n              "OR": {\n                "left": {\n                  "raw_text": "Lapp lactose deficiency",\n                  "Condition": [\n                    "Lapp lactose deficiency"\n                  ],\n                  "Condition-Name": [\n                    "Lapp lactose deficiency"\n                  ]\n                },\n                "right": {\n                  "raw_text": "or glucose-galactose malabsorption",\n                  "Condition": [\n                    "glucose-galactose malabsorption"\n                  ],\n                  "Condition-Name": [\n                    "glucose-galactose malabsorption"\n                  ]\n                }\n              }\n            }\n          }\n        }\n      }\n    },\n    "right": {\n      "OR": {\n        "left": {\n          "raw_text": "3. Those who are deemed unfit by the investigators to participate in the clinical trial for other reasons including the results of laboratory tests",\n          "Study": [\n            "clinical trial"\n          ],\n          "Observation": [\n            "laboratory tests"\n          ],\n          "Observation-Name": [\n            "laboratory tests"\n          ],\n          "Other": [\n            "other"\n          ],\n          "Assertion": [\n            "deemed unfit"\n          ],\n          "Procedure": [\n            "laboratory tests"\n          ],\n          "Procedure-Name": [\n            "laboratory tests"\n          ]\n        },\n        "right": {\n          "raw_text": "and excretion of the drug",\n          "Drug": [\n            "drug"\n          ],\n          "Modifier": [\n            "excretion"\n          ]\n        }\n      }\n    }\n  }\n}<|eot_id|>']
