  "Eq-Comparison": [
    "taking",
    "more than 1 year"
  ],
  "Eq-Temporal-Period": [
    "taking"
  ],
  "Drug": [
    "antihypertensive drugs"
  ],
  "Drug-Name": [
    "antihypertensive drugs"
  ],
  "Eq-Operator": [
    "more than"
