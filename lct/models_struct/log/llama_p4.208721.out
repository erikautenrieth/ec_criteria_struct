study"\n                                                  ],\n                                                  "Other": [\n                                                    "additional"\n                                                  ]\n                                                },\n                                                "right": {\n                                                  "OR": {\n                                                    "left": {\n                                                      "raw_text": "- Inability to complete follow-up visits",\n                                                      "Encounter": [\n                                                        "follow-up visits"\n                                                      ],\n                                                      "Assertion": [\n                                                        "Inability"\n                                                      ]\n                                                    },\n                                                    "right": {\n                                                      "raw_text": "or required questionnaires.",\n                                                      "Procedure": [\n                                                        "questionnaires"\n                                                      ],\n                                                      "Procedure-Name": [\n                                                        "questionnaires"\n                                                      ],\n                                                      "Assertion": [\n                                                        "required"\n                                                      ]\n                                                    }\n                                                  }\n                                                }\n                               