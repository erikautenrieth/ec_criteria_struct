ictions, return an empty JSON FILE {}\n- The entire text of the eligibility criteria must be included and separated by the logical operators, without omitting any words or information.\n- The output should only contain the JSON object, without any additional text or formatting.\n- Ensure that the JSON output strictly follows these rules and accurately represents the logical structure of the input eligibility criteria.\n\n### Input:\n-  failure to provide informed consent\n-  patients on immunosuppressive drugs, intake of prednisolone (or equivalent) >10 mg for at least 3 weeks or a diagnosis of human immunodeficiency virus syndrome\n-  intake antifungal azoles for >3 weeks in the preceding six months\n-  subjects with active pulmonary infection due to mycobacterium tuberculosis or mycobacteria other than tuberculosis (MOTT)\n-  subjects with others forms of pulmonary aspergillosis (allergic bronchopulmonary aspergillosis, chronic necrotizing aspergillosis and angio-invasive aspergillosis)\n-  pregnancy\n\n### Response:\n{\n  "AND": {\n    "left": {\n      "AND": {\n        "left": {\n          "AND": {\n            "left": {\n              "AND": {\n                "left": {\n                  "AND": {\n                    "left": {\n                      "AND": {\n                        "left": {\n                          "raw_text": "- failure to provide informed consent"\n                        }\n                      }\n                    },\n                    "right": {\n                      "OR": {\n                        "left": {\n                          "raw_text": "- patients on immunosuppressive drugs, intake of prednisolone (or equivalent) >10 mg for at least 3 weeks",\n                          "Eq-Operator": [\n                            ">",\n                            "at least"\n                          ],\n                          "Eq-Temporal-Unit": [\n                            "weeks"\n                          ],\n                          "Eq-Value": [\n                            "10",\n                            "3"\n                          ],\n                          "Eq-Comparison": [\n                            ">10 mg",\n                            "at least 3 weeks"\n                          ],\n                          "Drug": [\n                            "immunosuppressive drugs",\n                            "prednisolone"\n                          ],\n                          "Drug-Name": [\n                            "immunosuppressive drugs",\n                            "prednisolone"\n                          ],\n                          "Eq-Unit": [\n                            "mg"\n                          ]\n                        },\n                        "right": {\n                          "raw_text": "or a diagnosis of human immunodeficiency virus syndrome",\n                          "Condition": [\n                            "human immunodeficiency virus syndrome"\n                          ],\n                          "Condition-Name": [\n                            "human immunodeficiency virus syndrome"\n                          ]\n                        }\n                      }\n                    }\n                  }\n                },\n                "right": {\n                  "raw_text": "- intake antifungal azoles for >3 weeks in the preceding six months",\n                  "Eq-Operator": [\n                    ">"\n                  ],\n                  "Eq-Temporal-Unit": [\n                    "weeks",\n                    "months"\n                  ],\n                  "Eq-Value": [\n                    "3",\n                    "six"\n                  ],\n                  "Eq-Comparison": [\n                    ">3 weeks",\n                    "preceding six months"\n                  ],\n                  "Drug": [\n                    "antifungal azoles"\n                  ],\n                  "Drug-Name": [\n                    "antifungal azoles"\n                  ],\n                  "Eq-Temporal-Period": [\n                    "preceding"\n                  ]\n                }\n              }\n            },\n            "right": {\n              "OR": {\n                "left": {\n                  "raw_text": "- subjects with active pulmonary infection due to mycobacterium tuberculosis",\n                  "Condition": [\n                    "pulmonary infection",\n                    "mycobacterium tuberculosis"\n                  ],\n                  "Condition-Name": [\n                    "pulmonary infection",\n                    "mycobacterium tuberculosis"\n                  ],\n                  "Eq-Comparison": [\n                    "active"\n                  ],\n                  "Eq-Temporal-Period": [\n                    "active"\n                  ]\n                },\n                "right": {\n                  "raw_text": "or mycobacteria other than tuberculosis (MOTT)",\n                  "Condition": [\n                    "mycobacteria other than tuberculosis",\n                    "MOTT"\n                  ],\n                  "Condition-Name": [\n                    "mycobacteria other than tuberculosis",\n                    "MOTT"\n                  ]\n                }\n              }\n            }\n          }\n        },\n        "right": {\n          "OR": {\n            "left": {\n              "raw_text": "- subjects with others forms of pulmonary aspergillosis (allergic bronchopulmonary aspergillosis, chronic necrotizing aspergillosis",\n              "Condition": [\n                "pulmonary aspergillosis",\n                "allergic bronchopulmonary aspergillosis",\n                "necrotizing aspergillosis"\n              ],\n              "Condition-Name": [\n                "pulmonary aspergillosis",\n                "allergic bronchopulmonary aspergillosis",\n                "necrotizing aspergillosis"\n              ],\n              "Acuteness": [\n                "chronic"\n              ],\n              "Other": [\n                "others"\n              ]\n            },\n            "right": {\n              "raw_text": "and angio-invasive aspergillosis)",\n              "Condition": [\n                "angio-invasive aspergillosis"\n              ],\n              "Condition-Name": [\n                "angio-invasive aspergillosis"\n              ]\n            }\n          }\n        }\n      }\n    },\n    "right": {\n      "raw_text": "- pregnancy",\n      "Condition": [\n        "pregnancy"\n      ],\n      "Condition-Name": [\n        "pregnancy"\n      ]\n    }\n  }\n}<|eot_id|>']
