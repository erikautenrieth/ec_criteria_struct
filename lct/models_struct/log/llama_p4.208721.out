ictions, return an empty JSON FILE {}\n- The entire text of the eligibility criteria must be included and separated by the logical operators, without omitting any words or information.\n- The output should only contain the JSON object, without any additional text or formatting.\n- Ensure that the JSON output strictly follows these rules and accurately represents the logical structure of the input eligibility criteria.\n\n### Input:\n-  Subject has an implanted medical device that delivers electrical energy to the brain.\n-  Subject has an implantable cardiac pacemaker, defibrillator, or neurostimulator.\n-  Subject is likely to require repeat MR imaging after implant of the RNS Neurostimulator and Leads.\n-  Subject is unable to fit into CT scanner (500lb upper weight limit for CT scanner).\n-  Inability to provide informed consent to treatment.\n\n### Response:\n{\n  "AND": {\n    "left": {\n      "AND": {\n        "left": {\n          "AND": {\n            "left": {\n              "AND": {\n                "left": {\n                  "raw_text": "- Subject has an implanted medical device that delivers electrical energy to the brain.",\n                  "Procedure": [\n                    "implanted medical device"\n                  ],\n                  "Procedure-Name": [\n                    "implanted medical device"\n                  ],\n                  "Modifier": [\n                    "delivers electrical energy to the brain"\n                  ]\n                },\n                "right": {\n                  "OR": {\n                    "left": {\n                      "raw_text": "- Subject has an implantable cardiac pacemaker,",\n                      "Procedure": [\n                        "implantable cardiac pacemaker"\n                      ],\n                      "Procedure-Name": [\n                        "implantable cardiac pacemaker"\n                      ]\n                    },\n                    "right": {\n                      "OR": {\n                        "left": {\n                          "raw_text": "defibrillator,",\n                          "Procedure": [\n                            "defibrillator"\n                          ],\n                          "Procedure-Name": [\n                            "defibrillator"\n                          ]\n                        },\n                        "right": {\n                          "raw_text": "or neurostimulator.",\n                          "Procedure": [\n                            "neurostimulator"\n                          ],\n                          "Procedure-Name": [\n                            "neurostimulator"\n                          ]\n                        }\n                      }\n                    }\n                  }\n                }\n              }\n            },\n            "right": {\n              "raw_text": "- Subject is likely to require repeat MR imaging after implant of the RNS Neurostimulator and Leads.",\n              "Procedure": [\n                "RNS Neurostimulator",\n                "Leads",\n                "MR imaging",\n                "implant"\n              ],\n              "Procedure-Name": [\n                "RNS Neurostimulator",\n                "Leads",\n                "MR imaging",\n                "implant"\n              ],\n              "Assertion": [\n                "likely to require"\n              ],\n              "Modifier": [\n                "repeat"\n              ]\n            }\n          }\n        },\n        "right": {\n          "raw_text": "- Subject is unable to fit into CT scanner (500lb upper weight limit for CT scanner).",\n          "Procedure": [\n            "CT scanner"\n          ],\n          "Procedure-Name": [\n            "CT scanner"\n          ],\n          "Observation": [\n            "weight"\n          ],\n          "Observation-Name": [\n            "weight"\n          ],\n          "Eq-Unit": [\n            "lb"\n          ],\n          "Eq-Value": [\n            "500"\n          ],\n          "Eq-Comparison": [\n            "500lb"\n          ],\n          "Assertion": [\n            "unable to"\n          ],\n          "Modifier": [\n            "fit into"\n          ],\n          "Eq-Operator": [\n            "upper"\n          ]\n        }\n      }\n    },\n    "right": {\n      "raw_text": "- Inability to provide informed consent to treatment.",\n      "Procedure": [\n        "treatment"\n      ],\n      "Assertion": [\n        "Inability to provide informed consent"\n      ]\n    }\n  }\n}<|eot_id|>']
