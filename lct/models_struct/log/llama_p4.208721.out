our doppler ultrasound test (plaster cast, inaccessible vein segment after abdominal",\n                                                                  "Condition": [\n                                                                    "condition",\n                                                                    "plaster cast",\n                                                                    "inaccessible vein segment"\n                                                                  ],\n                                                                  "Condition-Name": [\n                                                                    "plaster cast",\n                                                                    "inaccessible vein segment"\n                                                                  ],\n                                                                  "Procedure": [\n                                                                    "colour doppler ultrasound test"\n                                                                  ],\n                                                                  "Procedure-Name": [\n                                                                    "colour doppler ultrasound test"\n                                                                  ],\n                                                                  "Modifier": [\n                                                                    "abdominal"\n                                                                  ],\n                                                                  "Assertion": [\n                                                                    "may"\n                                                                  ],\n                                                                  "Procedure-Indication": [\n                                                                    "prevent"\n             