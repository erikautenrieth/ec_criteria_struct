              "except for"\n                      ],\n                      "Other": [\n                        "other"\n                      ],\n                      "Modifier": [\n                        "prostate-specific membrane antigen"\n                      ],\n                      "Assertion": [\n                        "permitted"\n                      ]\n                    }\n                  }\n                },\n                "right": {\n                  "OR": {\n                    "left": {\n                      "raw_text": "- Solid organ",\n                      "Modifier": [\n                        "Solid organ"\n                      ]\n                    },\n                    "right": {\n                      "raw_text": "or bone marrow transplantation",\n                      "Procedure": [\n                        "transplantation"\n                      ],\n                      "Procedure-Name": [\n                        "transplantation"\n                      ],\n                      "Modifier": [\n                        "bone marrow"\n                      ]\n                    }\n                  }\n                }\n              }\n            },\n            "right": {\n              "OR": {\n                "left": {\n                  "raw_text": "- Seizure",\n                  "Condition": [\n                    "Seizure"\n                  ],\n                  "Condition-Name": [\n                    "Seizure"\n                  ]\n                },\n                "right": {\n                  "raw_text": "or known condition that may predispose to seizure or intracranial masses",\n                  "Condition": [\n                    "condition",\n                    "seizure",\n                    "intracranial masses"\n                  ],\n                  "Condition-Name": [\n                    "condition",\n                    "seizure",\n                    "intracranial masses"\n                  ],\n                  "Assertion": [\n                    "may",\n                    "predispose"\n                  ],\n                  "Modifier": [\n                    "intracranial"\n                  ],\n                  "Stability": [\n                    "predispose"\n                  ]\n                }\n              }\n            }\n          }\n        },\n        "right": {\n          "raw_text": "- Other active malignancy requiring systemic treatment <=12 months prior to enrollment",\n          "Procedure": [\n            "treatment",\n            "systemic treatment"\n          ],\n          "Procedure-Name": [\n            "treatment",\n            "systemic treatment"\n          ],\n          "Eq-Operator": [\n            "less than or equal",\n            "active"\n          ],\n          "Eq-Temporal-Unit": [\n            "months"\n          ],\n          "Eq-Value": [\n            "1",\n            "12"\n          ],\n          "Eq-Comparison": [\n            "active",\n            "<=12 months"\n          ],\n          "Condition": [\n            "malignancy"\n          ],\n          "Condition-Name": [\n            "malignancy"\n          ],\n          "Other": [\n            "Other"\n          ],\n          "Assertion": [\n            "requiring"\n          ],\n          "Study": [\n            "enrollment"\n          ],\n          "Modifier": [\n            "systemic"\n          ]\n        }\n      }\n    },\n    "right": {\n      "raw_text": "- Solid organ or bone marrow transplantation",\n      "Procedure": [\n        "transplantation"\n      ],\n      "Procedure-Name": [\n        "transplantation"\n      ],\n      "Modifier": [\n        "Solid organ",\n        "bone marrow"\n      ]\n    }\n  }\n}<|eot_id|>']
