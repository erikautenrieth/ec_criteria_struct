mination \nB. Bone metastases secondary to other malignant tumor other than breast cancer \nC. Secondary primary tumor\n\n### Response:\n{\n  "AND": {\n    "left": {\n      "AND": {\n        "left": {\n          "AND": {\n            "left": {\n              "raw_text": "A."\n            },\n            "right": {\n              "NOT": {\n                "left": {\n                  "raw_text": "No bone metastases confirmed by pathological examination",\n                  "Condition": [\n                    "bone metastases"\n                  ],\n                  "Condition-Name": [\n                    "bone metastases"\n                  ],\n                  "Procedure": [\n                    "pathological examination"\n                  ],\n                  "Procedure-Name": [\n                    "pathological examination"\n                  ],\n                  "Modifier": [\n                    "bone"\n                  ],\n                  "Negation": [\n                    "No"\n                  ]\n                }\n              }\n            }\n          }\n        },\n        "right": {\n          "AND": {\n            "left": {\n              "raw_text": "B. Bone metastases secondary to other malignant tumor other than breast cancer",\n              "Condition": [\n                "bone metastases",\n                "malignant tumor",\n                "breast cancer"\n              ],\n              "Condition-Name": [\n                "bone metastases",\n                "malignant tumor",\n                "breast cancer"\n              ],\n              "Modifier": [\n                "bone"\n              ],\n              "Other": [\n                "other"\n              ],\n              "Exception": [\n                "other than"\n              ]\n            },\n            "right": {\n              "raw_text": "C. Secondary primary tumor",\n              "Condition": [\n                "primary tumor"\n              ],\n              "C