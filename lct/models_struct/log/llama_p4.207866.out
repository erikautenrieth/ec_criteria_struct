                     ],\n                                                      "Condition-Name": [\n                                                        "Central sleep apnea",\n                                                        "CSA",\n                                                        "central apneas"\n                                                      ],\n                                                      "Eq-Value": [\n                                                        "5"\n                                                      ],\n                                                      "Eq-Comparison": [\n                                                        "5 or more",\n                                                        "per hour"\n                                                      ],\n                                                      "Eq-Operator": [\n                                                        "or more"\n                                                      ],\n                                                      "Eq-Temporal-Unit": [\n                                                        "hour"\n                                                      ],\n                                                      "Observation": [\n                                                        "apnea"\n                                                      ],\n                                                      "Observation-Name": [\n                                                        "apnea"\n                                                      ],\n                                                      "Modifier": [\n                                                        "sleep"\n                                                      ]\n                                                    }\n                                                  }\n                                                },\n                                                "right": {\n                                                  "raw_text": "- Psychoactive medications that influence sleep",\n                                                  "Drug": [\n                                                    "Psychoactive medications"\n                                                  ],\n                                                  "Drug-Name": [\n                                                    "Psychoactive medications"\n                                                  ],\n                                                  "Modifier": [\n                                                    "sleep"\n                                                  ],\n                                                  "Stability": [\n                                                    "influence"\n                                                  ]\n                                                }\n                                              }\n                                            },\n                                            "right": {\n                                              "raw_text": "- Chronic opioid use",\n                                              "Drug": [\n                                                "opioid"\n                                              ],\n                                              "Drug-Name": [\n                                                "opioid"\n                                              ],\n                                              "Acuteness": [\n                                                "Chronic"\n                                              ],\n                                              "Eq-Comparison": [\n                                                "use"\n                                              ],\n                                              "Eq-Temporal-Period": [\n                                                "use"\n 