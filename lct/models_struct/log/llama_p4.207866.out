              ]\n                                    }\n                                  }\n                                },\n                                "right": {\n                                  "raw_text": "- Fibromyalgia with significant facial pain",\n                                  "Condition": [\n                                    "Fibromyalgia",\n                                    "facial pain"\n                                  ],\n                                  "Condition-Name": [\n                                    "Fibromyalgia",\n                                    "facial pain"\n                                  ],\n                                  "Modifier": [\n                                    "pain"\n                                  ],\n                                  "Severity": [\n                                    "significant"\n                                  ]\n                                }\n                              }\n                            },\n                            "right": {\n                              "raw_text": "- Inability to protrude the mandible beyond 5 mm",\n                              "Eq-Value": [\n                                "5"\n                              ],\n                              "Eq-Unit": [\n                                "mm"\n                              ],\n                              "Observation": [\n                                "Inability to protrude the mandible"\n                              ],\n                              "Observation-Name": [\n                                "Inability to protrude the mandible"\n                              ],\n                              "Eq-Comparison": [\n                                "beyond 5 mm"\n                              ],\n                              "Eq-Operator": [\n                                "beyond"\n                              ]\n                            }\n               