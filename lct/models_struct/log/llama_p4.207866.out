ficant cardiac, respiratory, renal, hepatic, gastrointestinal, opthalmologic, hematologic,or psychiatric disease or disorder, or any uncontrolled medical illness.\n\n### Response:\n{\n  "OR": {\n    "left": {\n      "raw_text": "- Participant has a history of epilepsy, any significant cardiac,",\n      "Condition": [\n        "epilepsy"\n      ],\n      "Condition-Name": [\n        "epilepsy"\n      ],\n      "Eq-Comparison": [\n        "history"\n      ],\n      "Eq-Temporal-Period": [\n        "history"\n      ],\n      "Modifier": [\n        "cardiac"\n      ],\n      "Severity": [\n        "significant"\n      ]\n    },\n    "right": {\n      "OR": {\n        "left": {\n          "raw_text": "respiratory,",\n          "Modifier": [\n            "respiratory"\n          ]\n        },\n        "right": {\n          "OR": {\n            "left": {\n              "raw_text": "renal,",\n              "Modifier": [\n                "renal"\n              ]\n            },\n            "right": {\n              "OR": {\n                "left": {\n                  "raw_text": "hepatic,",\n                  "Modifier": [\n                    "hepatic"\n                  ]\n                },\n                "right": {\n                  "OR": {\n                    "left": {\n                      "raw_text": "gastrointestinal,",\n                      "Modifier": [\n                        "gastrointestinal"\n                      ]\n                    },\n                    "right": {\n                      "OR": {\n                        "left": {\n                          "raw_text": "opthalmologic,",\n                          "Modifier": [\n                            "opthalmologic"\n                          ]\n                        },\n                        "right": {\n                          "OR": {\n                            "left": {\n                              "raw_text": "hematologic,",\n                              "Modifier": [\n         