hosis of CHILD-PUGH-TURCOTTE B7 o >.\n\n### Response:\n{\n  "AND": {\n    "left": {\n      "raw_text": "- GFR < 50 ml/min, pregnancy, breast-feeding, cirrhosis of CHILD-PUGH-TURCOTTE B7 o >.",\n      "Condition": [\n        "GFR",\n        "pregnancy",\n        "breast-feeding",\n        "cirrhosis"\n      ],\n      "Condition-Name": [\n        "GFR",\n        "pregnancy",\n        "breast-feeding",\n        "cirrhosis"\n      ],\n      "Eq-Operator": [\n        "<",\n        ">"\n      ],\n      "Eq-Value": [\n        "50"\n      ],\n      "Eq-Comparison": [\n        "< 50 ml/min"\n      ],\n      "Eq-Unit": [\n        "ml"\n      ],\n      "Eq-Temporal-Unit": [\n        "min"\n      ],\n      "Observation": [\n        "CHILD-PUGH-TURCOTTE"\n      ],\n      "Observation-Name": [\n        "CHILD-PUGH-TURCOTTE"\n      ],\n      "Modifier": [\n        "B7"\n      ]\n    },\n    "right": {\n      "raw_text": ""\n    }\n  }\n}<|eot_id|>']
