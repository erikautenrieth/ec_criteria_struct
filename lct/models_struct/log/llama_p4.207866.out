rug-Name": [\n                        "selective serotonin reuptake inhibitors"\n                      ],\n                      "Stability": [\n                        "affect"\n                      ],\n                      "Assertion": [\n                        "known to"\n                      ],\n                      "Observation": [\n                        "PAS-induced plasticity"\n                      ],\n                      "Observation-Name": [\n                        "PAS-induced plasticity"\n                      ],\n                      "Modifier": [\n                        "PAS"\n                      ],\n                      "Substance": [\n                        "substances"\n                      ]\n                    },\n                    "right": {\n                      "OR": {\n                        "left": {\n                          "raw_text": "dopamine,",\n                          "Drug": [\n                            "dopamine"\n                          ],\n                          "Drug-Name": [\n                            "dopamine"\n                          ]\n                        },\n                        "right": {\n                          "OR": {\n                            "left": {\n                              "raw_text": "dopamine agonists,",\n                              "Drug": [\n                                "dopamine agonists"\n                              ],\n                              "Drug-Name": [\n                                "dopamine agonists"\n                              ]\n                            },\n                            "right": {\n                              "OR": {\n                                "left": {\n                                  "raw_text": "haloperidol,",\n                                  "Drug": [\n                                    "haloperidol"\n                                  ],\n                                  "Drug-Name": [\n       