t the maternity ward of the hospital Femme-Mère-Enfant\n-  from 1st of january 2011 to 31 december 2017.\n\n### Response:\n{\n  "AND": {\n    "left": {\n      "raw_text": "- All birth more than 24 + 0 weeks of amenorrhea at the maternity ward of the hospital Femme-Mère-Enfant",\n      "Condition": [\n        "birth",\n        "amenorrhea"\n      ],\n      "Condition-Name": [\n        "birth",\n        "amenorrhea"\n      ],\n      "Eq-Temporal-Unit": [\n        "weeks"\n      ],\n      "Eq-Value": [\n        "24",\n        "0"\n      ],\n      "Eq-Comparison": [\n        "more than 24 + 0 weeks"\n      ],\n      "Eq-Operator": [\n        "more than"\n      ],\n      "Eq-Temporal-Period": [\n        "on"\n      ],\n      "Location": [\n        "hospital Femme-Mère-Enfant",\n        "hospital"\n      ],\n      "Observation": [\n        "maternity ward"\n      ],\n      "Observation-Name": [\n        "maternity ward"\n      ]\n    },\n    "right": {\n      "raw_text": "- from 1st of january 2011 to 31 december 2017.",\n      "Eq-Value": [\n        "1st of january 2011",\n        "31 december 2017"\n      ]\n    }\n  }\n}<|eot_id|>']
