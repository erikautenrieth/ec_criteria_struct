                    "life"\n                  ],\n                  "Observation-Name": [\n                    "life"\n                  ],\n                  "Modifier": [\n                    "of life"\n                  ]\n                }\n              }\n            },\n            "right": {\n              "raw_text": "- Born beyond 33 Week of Amenorrhea + 1day and 2kg of birth weight",\n              "Eq-Value": [\n                "33",\n                "1",\n                "2"\n              ],\n              "Eq-Comparison": [\n                "beyond 33 Week of Amenorrhea + 1day",\n                "2kg"\n              ],\n              "Eq-Operator": [\n                "beyond"\n              ],\n              "Eq-Temporal-Unit": [\n                "Week",\n                "day"\n              ],\n              "Observation": [\n                "Amenorrhea",\n                "birth weight"\n              ],\n              "Observation-Name": [\n                "Amenorrhea",\n                "birth weight"\n              ],\n              "Eq-Unit": [\n                "kg"\n              ],\n              "Modifier": [\n                "birth"\n              ]\n            }\n          }\n        },\n        "right": {\n          "raw_text": "- Hospitalized in the medical-surgical centre of Pediatrics of the hospital of Strasbourg",\n          "Eq-Value": [\n            "1"\n          ],\n          "Encounter": [\n            "Hospitalized"\n          ],\n          "Location": [\n            "medical-surgical centre of Pediatrics of the hospital of Strasbourg"\n          ]\n        }\n      }\n    },\n    "right": {\n      "raw_text": "- For whom a blood sample was prescribed as part of their routine care",\n      "Eq-Value": [\n        "1"\n      ],\n      "Observation": [\n        "blood sample"\n      ],\n      "Observation-Name": [\n        "blood sample"\n      ],\n      "Assertion": [\n        "prescribed"\n      ],\n      "Procedure": [\n        "