  "AND": {
    "left": {
      "AND": {
        "left": {
          "OR": {
            "left": {
              "raw_text": "- Patients with cardiovascular disease (congestive heart failure,",
              "Condition": [
                "congestive heart failure",
                "cardiovascular disease"
              ],
              "Condition-Name": [
                "congestive heart failure",
                "cardiovascular disease"
              ]
            },
            "right": {
              "OR": {
                "left": {
                  "raw_text": "coronary artery disease,",
                  "Condition": [
                    "coronary artery disease"
                  ],
                  "Condition-Name": [
                    "coronary artery disease"
                  ]
                },
                "right": {
                  "raw_text": "hypertension.",
                  "Condition": [
                    "hypertension"
                  ],
                  "Condition-Name": [
                    "hypertension"
                  ]
                }
              }
            }
          }
        },
        "right": {
          "OR": {
            "left": {
              "raw_text": "- History of renal",
              "Modifier": [
                "renal"
              ]
            },
            "right": {
              "raw_text": "or hepatic insufficiency",
              "Modifier": [
                "hepatic"
              ],
              "Condition": [
                "insufficiency"
              ],
              "Condition-Name": [
                "insufficiency"
              ]
            }
          }
        }
      }
    },
    "right": {
      "raw_text": "- Endocrinal Diseases",
      "Condition": [
        "Endocrinal Diseases"
      ],
      "Condition-Name": [
        "Endocrinal Diseases"
      ]
    }
  }
}
