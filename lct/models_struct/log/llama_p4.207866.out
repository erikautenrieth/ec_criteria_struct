                          ],\n                                  "Organism-Name": [\n                                    "M. abscessus subspecies abscessus"\n                                  ]\n                                },\n                                "right": {\n                                  "OR": {\n                                    "left": {\n                                      "raw_text": "or M. abscessus subspecies massiliense,",\n                                      "Organism": [\n                                        "M. abscessus subspecies massiliense"\n                                      ],\n                                      "Organism-Name": [\n                                        "M. abscessus subspecies massiliense"\n                                      ]\n                                    },\n                                    "right": {\n                                      "raw_text": "or M. kansasii.",\n                                      "Organism": [\n                                        "M. kansasii"\n                                      ],\n                                      "Organism-Name": [\n                                        "M. kansasii"\n                                      ]\n                                    }\n                                  }\n                                }\n                              }\n                            }\n                          }\n                        }\n                      }\n                    },\n                    "right": {\n                      "raw_text": "3. Patients who starts new treatment (those who have previous history of treatment are eligible)",\n                      "Procedure": [\n                        "treatment"\n                      ],\n                      "Eq-Comparison": [\n                        "previous history",\n                        "history"\n                      ],\n                      "Eq-Temporal-Period": [\n                        "previous history",\n                        "history"\n                      ],\n                      "Procedure-Name": [\n                        "treatment"\n                      ],\n                      "Assertion": [\n                        "eligible"\n                      ],\n                      "Eq-Temporal-Unit": [\n                        "h"\n                      ]\n                    }\n                  }\n                },\n                "right": {\n                  "raw_text": "Exclusion Criteria"\n                }\n              }\n            },\n            "right": {\n              "raw_text": "1. Patients who have been treated for more than 4 weeks.",\n              "Procedure": [\n                "treated"\n              ],\n              "Eq-Comparison": [\n                "more than 4 weeks"\n              ],\n              "Eq-Operator": [\n                "more than"\n              ],\n              "Eq-Value": [\n                "4"\n              ],\n              "Eq-Temporal-Unit": [\n                "weeks"\n              ],\n              "Procedure-Name": [\n                "treated"\n              ]\n            }\n          }\n        },\n        "right": {\n          "AND": {\n            "left": {\n              "raw_text": "2. The causative agent of NTM pulmonary disease is",\n              "Condition": [\n                "NTM pulmonary disease"\n              ],\n              "Condition-Name": [\n                "NTM pulmonary disease"\n              ]\n            },\n            "right": {\n              "NOT": {\n                "left": {\n                  "OR": {\n                    "left": {\n                      "raw_text": "none of M. avium complex,",\n                      "Organism": [\n                        "M. avium complex"\n                      ],\n                      "Organism-Name": [\n                        "M. avium complex"\n                      ],\n                      "Negation": [\n                        "none"\n                      ]\n                    },\n                    "right": {\n                      "OR": {\n                        "left": {\n                          "raw_text": "M. abscessus subspecies abscessus,",\n                          "Organism": [\n                            "M. abscessus subspecies abscessus"\n                          ],\n                          "Organism-Name": [\n                            "M. abscessus subspecies abscessus"\n                          ]\n                        },\n                        "right": {\n                          "OR": {\n                            "left": {\n                              "raw_text": "M. abscessus subspecies massiliense,",\n                              "Organism": [\n                                "M. abscessus subspecies massiliense"\n                              ],\n                              "Organism-Name": [\n                                "M. abscessus subspecies massiliense"\n                              ]\n                            },\n                            "right": {\n                              "raw_text": "or M. kansasii.",\n                              "Organism": [\n                                "M. kansasii"\n                              ],\n                              "Organism-Name": [\n                                "M. kansasii"\n                              ]\n                            }\n                          }\n                        }\n                      }\n                    }\n                  }\n                }\n              }\n            }\n          }\n        }\n      }\n    },\n    "right": {\n      "raw_text": "3. Patients who starts new treatment (those who have previous history of treatment are eligible)",\n      "Procedure": [\n        "treatment"\n      ],\n      "Eq-Comparison": [\n        "previous history",\n        "history"\n     