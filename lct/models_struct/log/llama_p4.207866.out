IV criteria\n-  No definite history of neurological diseases and psychological problems\n-  Volunteer to participate the study, cooperate to be followed up\n\n### Response:\n{\n  "AND": {\n    "left": {\n      "AND": {\n        "left": {\n          "raw_text": "- Diagnosis as heroin dependence according to DSM-IV criteria",\n          "Condition": [\n            "heroin dependence"\n          ],\n          "Condition-Name": [\n            "heroin dependence"\n          ],\n          "Eq-Operator": [\n            "-"\n          ],\n          "Modifier": [\n            "heroin"\n          ],\n          "Condition-Type": [\n            "dependence"\n          ],\n          "Eq-Comparison": [\n            "on"\n          ],\n          "Eq-Temporal-Period": [\n            "on"\n          ],\n          "Procedure": [\n            "DSM-IV"\n          ],\n          "Procedure-Name": [\n            "DSM-IV"\n          ]\n        },\n        "right": {\n          "AND": {\n            "left": {\n              "raw_text": "- No definite history of neurological diseases",\n              "Condition": [\n                "neurological diseases"\n              ],\n              "Condition-Name": [\n                "neurological diseases"\n              ],\n              "Eq-Operator": [\n                "-"\n              ],\n              "Eq-Comparison": [\n                "history",\n                "on"\n              ],\n              "Eq-Temporal-Period": [\n                "history",\n                "on"\n              ]\n            },\n            "right": {\n              "raw_text": "and psychological problems",\n              "Condition": [\n                "psychological problems"\n              ],\n              "Condition-Name": [\n                "psychological problems"\n              ]\n            }\n          }\n        }\n      }\n    },\n    "right": {\n      "raw_text": "- Volunteer to participate the study, cooperate to be followed up",\n      "Eq-Operator": [\n        "-"\n      ],\n      "Assertion": [\n        "to be"\n      ],\n      "Study": [\n        "study"\n      ]\n    }\n  }\n}<|eot_id|>']
