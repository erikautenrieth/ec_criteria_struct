ery use\n-  Patients with Pacemaker or implantable cardioverter-defibrillator (ICD)\n-  Patients with an implanted neurostimulator device\n\n### Response:\n{\n  "AND": {\n    "left": {\n      "AND": {\n        "left": {\n          "raw_text": "- Patients with a contraindication for electrocautery use",\n          "Procedure": [\n            "electrocautery"\n          ],\n          "Procedure-Name": [\n            "electrocautery"\n          ],\n          "Contraindication": [\n            "contraindication"\n          ]\n        },\n        "right": {\n          "OR": {\n            "left": {\n              "raw_text": "- Patients with Pacemaker",\n              "Procedure": [\n                "Pacemaker"\n              ],\n              "Procedure-Name": [\n                "Pacemaker"\n              ]\n            },\n            "right": {\n              "raw_text": "or implantable cardioverter-defibrillator (ICD)",\n              "Procedure": [\n                "implantable cardioverter-defibrillator",\n                "ICD"\n              ],\n              "Procedure-Name": [\n                "implantable cardioverter-defibrillator",\n                "ICD"\n              ]\n            }\n          }\n        }\n      }\n    },\n    "right": {\n      "raw_text": "- Patients with an implanted neurostimulator device",\n      "Procedure": [\n        "implanted neurostimulator device"\n      ],\n      "Procedure-Name": [\n        "implanted neurostimulator device"\n      ]\n    }\n  }\n}<|eot_id|>']
