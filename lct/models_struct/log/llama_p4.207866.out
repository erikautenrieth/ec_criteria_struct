older either naive or previously treated including HBsAg positive and HIV positive.\n\n### Response:\n{\n  "OR": {\n    "left": {\n      "raw_text": "- all consecutive patients from SERD of 18 yrs or older either naive",\n      "Condition": [\n        "SERD"\n      ],\n      "Condition-Name": [\n        "SERD"\n      ],\n      "Eq-Temporal-Unit": [\n        "yrs"\n      ],\n      "Eq-Value": [\n        "18"\n      ],\n      "Eq-Comparison": [\n        "18 yrs or older"\n      ],\n      "Eq-Operator": [\n        "or older"\n      ],\n      "Age": [\n        "older"\n      ],\n      "Modifier": [\n        "naive"\n      ]\n    },\n    "right": {\n      "OR": {\n        "left": {\n          "raw_text": "or previously treated including HBsAg positive",\n          "Procedure": [\n            "treated"\n          ],\n          "Condition": [\n            "HBsAg"\n          ],\n          "Condition-Name": [\n            "HBsAg"\n          ],\n          "Polarity": [\n            "positive"\n          ],\n          "Eq-Comparison": [\n            "previously"\n          ],\n          "Eq-Temporal-Period": [\n            "previously"\n          ]\n        },\n        "right": {\n          "raw_text": "and HIV positive.",\n          "Condition": [\n            "HIV"\n          ],\n          "Condition-Name": [\n            "HIV"\n          ],\n          "Polarity": [\n            "positive"\n          ]\n        }\n      }\n    }\n  }\n}<|eot_id|>']
