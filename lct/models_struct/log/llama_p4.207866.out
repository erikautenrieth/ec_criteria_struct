tion": [\n                                            "Pregnant"\n                                          ],\n                                          "Condition-Name": [\n                                            "Pregnant"\n                                          ],\n                                          "Life-Stage-And-Gender": [\n                                            "women"\n                                          ]\n                                        },\n                                        "right": {\n                                          "raw_text": "or breast feeding women",\n                                          "Condition": [\n                                            "breast feeding"\n                                          ],\n                                          "Condition-Name": [\n                                            "breast feeding"\n                                          ],\n                                          "Life-Stage-And-Gender": [\n                                            "women"\n                                          ]\n                                        }\n                                      }\n                                    }\n                                  }\n                                },\n                                "right": {\n                                  "raw_text": "- Adult protected person"\n                                }\n                              }\n                            },\n                            "right": {\n                              "raw_text": "- Person deprived of liberty"\n                            }\n                          }\n                        },\n                        "right": {\n                          "raw_text": "- Person admitted without consent"\n                        }\n                      }\n                    },\n                    "right": {\n                      "OR": {\n      