quire spinal anesthesia for orthopedic surgery,\n-  with ASA physical status classification system I, II, III\n\n### Response:\n{\n  "AND": {\n    "left": {\n      "AND": {\n        "left": {\n          "raw_text": "- Patients under 40",\n          "Eq-Value": [\n            "40"\n          ],\n          "Eq-Comparison": [\n            "under 40"\n          ],\n          "Eq-Operator": [\n            "under"\n          ]\n        },\n        "right": {\n          "raw_text": "or over 60 years of age who require spinal anesthesia for orthopedic surgery,",\n          "Procedure": [\n            "spinal anesthesia",\n            "orthopedic surgery"\n          ],\n          "Procedure-Name": [\n            "spinal anesthesia",\n            "orthopedic surgery"\n          ],\n          "Eq-Temporal-Unit": [\n            "years"\n          ],\n          "Age": [\n            "age"\n          ],\n          "Eq-Value": [\n            "60"\n          ],\n          "Eq-Comparison": [\n            "over 60 years"\n          ],\n          "Eq-Operator": [\n            "over"\n          ],\n          "Assertion": [\n            "require"\n          ]\n        }\n      }\n    },\n    "right": {\n      "raw_text": "- with ASA physical status classification system I, II, III",\n      "Observation": [\n        "ASA"\n      ],\n      "Observation-Name": [\n        "ASA"\n      ],\n      "Eq-Comparison": [\n        "I, II, III"\n      ],\n      "Eq-Value": [\n        "I",\n        "II",\n        "III"\n      ]\n    }\n  }\n}<|eot_id|>']
