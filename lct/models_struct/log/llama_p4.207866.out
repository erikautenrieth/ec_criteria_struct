                 "pain assessment"\n                                  ],\n                                  "Observation-Name": [\n                                    "pain assessment"\n                                  ],\n                                  "Stability": [\n                                    "confound"\n                                  ]\n                                }\n                              }\n                            }\n                          }\n                        },\n                        "right": {\n                          "OR": {\n                            "left": {\n                              "raw_text": "- Pregnant,",\n                              "Condition": [\n                                "Pregnant"\n                              ],\n                              "Condition-Name": [\n                                "Pregnant"\n                              ]\n                            },\n                            "right": {\n                              "OR": {\n                                "left": {\n                                  "raw_text": "breastfeeding,",\n                                  "Condition": [\n                                    "breastfeeding"\n                                  ],\n                                  "Condition-Name": [\n                                    "breastfeeding"\n                                  ],\n                                  "Modifier": [\n                                    "breast"\n                                  ]\n                                },\n                                "right": {\n                                  "raw_text": "or planning to become pregnant in the next 6 months",\n                                  "Condition": [\n                                    "pregnant"\n                                  ],\n                                  "Condition-Name": [\n                                    "pregnant"\n      