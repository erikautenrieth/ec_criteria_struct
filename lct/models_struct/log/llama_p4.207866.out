              ],
              "Eq-Value": [
                "18",
                "50"
              ],
              "Eq-Comparison": [
                "18-50"
              ]
            }
          }
        },
        "right": {
          "raw_text": "- double barrier contraception for all subjects",
          "Procedure": [
            "double barrier contraception"
          ],
          "Procedure-Name": [
