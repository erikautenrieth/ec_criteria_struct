    "Eq-Comparison": [\n                                "past"\n                              ],\n                              "Eq-Temporal-Period": [\n                                "past"\n                              ]\n                            },\n                            "right": {\n                              "raw_text": "or current Axis 1 DSM-IV psychiatric disorder",\n                              "Condition": [\n                                "Axis 1 DSM-IV psychiatric disorder"\n                              ],\n                              "Condition-Name": [\n                                "Axis 1 DSM-IV psychiatric disorder"\n                              ],\n                              "Eq-Comparison": [\n                                "current"\n                              ],\n                              "Eq-Temporal-Period": [\n                                "current"\n                              ]\n                            }\n                          }\n                        }\n                      }\n                    },\n                    "right": {\n                      "raw_text": "- Significant medical condition",\n                      "Condition": [\n                        "medical condition"\n                      ],\n                      "Severity": [\n                        "Significant"\n                      ]\n                    }\n                  }\n                },\n                "right": {\n                  "OR": {\n                    "left": {\n                      "raw_text": "- Current",\n                      "Eq-Comparison": [\n                        "Current"\n                      ],\n                      "Eq-Temporal-Period": [\n                        "Current"\n                      ]\n                    },\n                    "right": {\n                      "OR": {\n                        "left": {\n                          "raw_text": "or past gastro-intestinal disorder",\n                          "Condition": [\n                            "gastro-intestinal disorder"\n                          ],\n                          "Condition-Name": [\n                            "gastro-intestinal disorder"\n                          ],\n                          "Eq-Comparison": [\n                            "past"\n                          ],\n                          "Eq-Temporal-Period": [\n                            "past"\n                          ]\n                        },\n                        "right": {\n                          "raw_text": "or irritable bowel syndrome",\n                          "Condition": [\n                            "irritable bowel syndrome"\n                          ],\n                          "Condition-Name": [\n                            "irritable bowel syndrome"\n                          ]\n                        }\n                      }\n                    }\n                  }\n                }\n              }\n            },\n            "right": {\n              "OR": {\n                "left": {\n                  "raw_text": "- Current pregnancy",\n                  "Condition": [\n                    "pregnancy"\n                  ],\n                  "Condition-Name": [\n                    "pregnancy"\n                  ],\n                  "Eq-Comparison": [\n                    "Current"\n                  ],\n                  "Eq-Temporal-Period": [\n                    "Current"\n                  ]\n                },\n                "right": {\n                  "raw_text": "or breastfeeding",\n                  "Condition": [\n                    "breastfeeding"\n                  ],\n                  "Condition-Name": [\n                    "breastfeeding"\n                  ]\n                }\n              }\n            }\n          }\n        },\n        "right": {\n          "OR": {\n            "left": {\n              "raw_text": "- Known lactate deficiency",\n              "Condition": [\n                "lactate deficiency"\n              ],\n              "Condition-Name": [\n                "lactate deficiency"\n              ]\n            },\n            "right": {\n              "OR": {\n                "left": {\n                  "raw_text": "or any other problem absorbing lactose,",\n                  "Condition": [\n                    "problem absorbing lactose"\n                  ],\n                  "Condition-Name": [\n                    "problem absorbing lactose"\n                  ],\n                  "Other": [\n                    "other"\n                  ]\n                },\n                "right": {\n                  "raw_text": "galactose",\n                  "Condition": [\n                    "galactose"\n                  ],\n                  "Condition-Name": [\n                    "galactose"\n                  ]\n                }\n              }\n            }\n          }\n        }\n      }\n    },\n    "right": {\n      "OR": {\n        "left": {\n          "raw_text": "- Current",\n          "Eq-Comparison": [\n            "Current"\n          ],\n          "Eq-Temporal-Period": [\n            "Current"\n          ]\n        },\n        "right": {\n          "OR": {\n            "left": {\n              "raw_text": "or past history of drug",\n              "Eq-Comparison": [\n                "past"\n              ],\n              "Eq-Temporal-Period": [\n                "past"\n              ],\n              "Modifier": [\n                "drug"\n              ],\n              "Eq-Operator": [\n                "to"\n              ]\n            },\n            "right": {\n              "raw_text": "or alcohol dependency",\n              "Condition": [\n                "dependency"\n              ],\n              "Condition-Name": [\n                "dependency"\n              ],\n              "Modifier": [\n                "alcohol"\n              ]