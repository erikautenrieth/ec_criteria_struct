       ],\n          "Eq-Comparison": [\n            "One previous",\n            "One"\n          ],\n          "Eq-Temporal-Period": [\n            "previous"\n          ],\n          "Eq-Value": [\n            "One"\n          ],\n          "Condition": [\n            "disease"\n          ],\n          "Exception": [\n            "allowed"\n          ]\n        }\n      }\n    },\n    "right": {\n      "raw_text": "5. Eastern Cooperative Oncology Group [ECOG] 0-1",\n      "Observation": [\n        "Eastern Cooperative Oncology Group",\n        "ECOG"\n      ],\n      "Observation-Name": [\n        "Eastern Cooperative Oncology Group",\n        "ECOG"\n      ],\n      "Eq-Comparison": [\n        "0 - 1"\n      ],\n      "Eq-Value": [\n        "0",\n        "1"\n      ],\n      "Eq-Operator": [\n        "-"\n      ]\n    }\n  }\n}<|eot_id|>']
