                                   "Assertion": [\n                                                            "toxic"\n                                                          ],\n                                                          "Condition": [\n                                                            "toxic substances"\n                                                          ],\n                                                          "Condition-Name": [\n                                                            "toxic substances"\n                                                          ]\n                                                        }\n                                                      }\n                                                    }\n                                                  }\n                                                },\n                                                "right": {\n                                                  "raw_text": "- exposition to radiation or heat",\n                                                  "Modifier": [\n                                                    "radiation",\n                                                    "heat"\n                                                  ],\n                                                  "Condition": [\n                                                    "exposition"\n                                                  ],\n                                                  "Condition-Name": [\n                                                    "exposition"\n                                                  ]\n                                                }\n                                              }\n                                            },\n                                            "right": {\n                                              "raw_text": "- orchitis secondary to mumps",\n                             