 bleeding"\n              ],\n              "Condition-Name": [\n                "internal bleeding"\n              ],\n              "Eq-Comparison": [\n                "active"\n              ],\n              "Eq-Temporal-Period": [\n                "active"\n              ]\n            }\n          }\n        },\n        "right": {\n          "OR": {\n            "left": {\n              "raw_text": "- 6. Patients with contraindications for anticoagulation therapy(for prevention of cerebral infarction)",\n              "Procedure": [\n                "anticoagulation therapy"\n              ],\n              "Procedure-Name": [\n                "anticoagulation therapy"\n              ],\n              "Condition": [\n                "cerebral infarction"\n              ],\n              "Condition-Name": [\n                "cerebral infarction"\n              ],\n              "Contraindication": [\n                "contraindications"\n              ],\n              "Indication": [\n                "for"\n              ],\n              "Procedure": [\n                "anticoagulation therapy"\n              ],\n              "Procedure-Name": [\n                "anticoagulation therapy"\n              ],\n              "Condition": [\n                "cerebral infarction"\n              ],\n              "Condition-Name": [\n                "cerebral infarction"\n              ],\n              "Assertion": [\n                "for"\n              ],\n              "Negation": [\n                "contraindications"\n              ],\n              "Procedure": [\n                "anticoagulation therapy"\n              ],\n              "Procedure-Name": [\n                "anticoagulation therapy"\n              ],\n              "Condition": [\n                "cerebral infarction"\n              ],\n              "Condition-Name": [\n                "cerebral infarction"\n              ],\n              "Assertion": [\n                "for"\n              