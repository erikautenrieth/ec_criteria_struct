-  GMFCS levels I-III (GMFCS = Gross Motor Function Classification Score, expressing the overall functional level of impairment)\n-  Sufficient cooperation to comprehend and complete the test procedure\n\n### Response:\n{\n  "AND": {\n    "left": {\n      "AND": {\n        "left": {\n          "AND": {\n            "left": {\n              "raw_text": "- Confirmed diagnosis of SCP",\n              "Condition": [\n                "SCP"\n              ],\n              "Condition-Name": [\n                "SCP"\n              ]\n            },\n            "right": {\n              "raw_text": "- Aged 5-12 years",\n              "Age": [\n                "Aged"\n              ],\n              "Eq-Temporal-Unit": [\n                "years"\n              ],\n              "Eq-Value": [\n                "5",\n                "12"\n              ],\n              "Eq-Comparison": [\n                "5-12 years"\n              ],\n              "Eq-Operator": [\n                "-"\n              ]\n            }\n          }\n        },\n        "right": {\n          "raw_text": "- GMFCS levels I-III (GMFCS = Gross Motor Function Classification Score, expressing the overall functional level of impairment)",\n          "Condition": [\n            "Gross Motor Function Classification Score",\n            "GMFCS",\n            "impairment"\n          ],\n          "Condition-Name": [\n            "Gross Motor Function Classification Score",\n            "GMFCS",\n            "impairment"\n          ],\n          "Eq-Comparison": [\n            "I-III"\n          ],\n          "Eq-Value": [\n            "I",\n            "III"\n          ],\n          "Eq-Operator": [\n            "-"\n          ],\n          "Observation": [\n            "Gross Motor Function Classification Score",\n            "GMFCS"\n          ],\n          "Observation-Name": [\n            "Gross Motor Function Classification Score",\n            "GMFCS"\n          ],\n          "Modifier": [\n            "overall functional"\n          ]\n        }\n      }\n    },\n    "right": {\n      "raw_text": "- Sufficient cooperation to comprehend and complete the test procedure",\n      "Procedure": [\n        "test procedure"\n      ],\n      "Procedure-Name": [\n        "test procedure"\n      ],\n      "Eq-Operator": [\n        "-"\n      ],\n      "Assertion": [\n        "Sufficient cooperation"\n      ]\n    }\n  }\n}<|eot_id|>']
