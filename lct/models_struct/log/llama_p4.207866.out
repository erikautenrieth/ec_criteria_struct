          ],
          "Eq-Value": [
            "18"
          ],
          "Eq-Comparison": [
            "≥ 18"
          ]
        },
        "right": {
          "raw_text": "- Patient undergoing non-emergent cardiac surgery",
          "Procedure": [
            "cardiac surgery"
          ],
          "Procedure-Name": [
            "cardiac surgery"
          ],
          "Eq-Comparison": [
            "undergoing"
          ],
          "Eq-Temporal-Period": [
            "undergoing"
          ],
          "Modifier": [
            "non-emergent"
          ]
        }
      }
    },
    "right": {
      "raw_text": "- Anticipated requirement for mediastinal chest tube drainage",
      "Procedure": [
        "mediastinal chest tube drainage"
      ],
      "Procedure-Name": [
        "mediastinal chest tube drainage"
      ],
      "Assertion": [
        "Anticipated requirement"
      ]
