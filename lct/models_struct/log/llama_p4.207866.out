e or any condition limiting seriously the life expectancy less than 12 months.\n\n### Response:\n{\n  "OR": {\n    "left": {\n      "raw_text": "- Mental illness limiting the capacity of self-care",\n      "Condition": [\n        "Mental illness"\n      ],\n      "Condition-Name": [\n        "Mental illness"\n      ],\n      "Modifier": [\n        "limiting the capacity of self-care"\n      ],\n      "Stability": [\n        "limiting"\n      ]\n    },\n    "right": {\n      "raw_text": "or any condition limiting seriously the life expectancy less than 12 months.",\n      "Condition": [\n        "condition"\n      ],\n      "Observation": [\n        "life expectancy"\n      ],\n      "Observation-Name": [\n        "life expectancy"\n      ],\n      "Eq-Operator": [\n        "less than"\n      ],\n      "Eq-Temporal-Unit": [\n        "months"\n      ],\n      "Eq-Value": [\n        "12"\n      ],\n      "Eq-Comparison": [\n        "less than 12 months"\n      ],\n      "Modifier": [\n        "limiting"\n      ],\n      "Stability": [\n        "limiting"\n      ],\n      "Severity": [\n        "seriously"\n      ]\n    }\n  }\n}<|eot_id|>']
