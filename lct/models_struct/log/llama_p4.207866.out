t admission\n-  Pregnant women\n-  Prisoners\n-  Infants currently in the neonatal intensive care unit (NICU) with a diagnosis of prematurity\n-  Neonates of uncertain viability or non-viable neonates\n-  Patients receiving palliative/hospice care\n-  Patient admitted for long-term acute care (LTAC)\n\n### Response:\n{\n  "AND": {\n    "left": {\n      "AND": {\n        "left": {\n          "AND": {\n            "left": {\n              "AND": {\n                "left": {\n                  "AND": {\n                    "left": {\n                      "AND": {\n                        "left": {\n                          "raw_text": "- Received nutrition care previously during current admission",\n                          "Procedure": [\n                            "nutrition care"\n                          ],\n                          "Procedure-Name": [\n                            "nutrition care"\n                          ],\n                          "Eq-Comparison": [\n                            "current",\n                            "previously"\n                          ],\n                          "Eq-Temporal-Period": [\n                            "current",\n                            "previously"\n                          ],\n                          "Encounter": [\n                            "admission"\n                          ]\n                        },\n                        "right": {\n                          "raw_text": "- Pregnant women",\n                          "Condition": [\n                            "Pregnant"\n                          ],\n                          "Condition-Name": [\n                            "Pregnant"\n                          ],\n                          "Life-Stage-And-Gender": [\n                            "women"\n                          ]\n                        }\n                      }\n                    },\n                    "right": {\n                      "raw_text": "- Prisoners",\n                      "Observation": [\n                        "Prisoners"\n                      ],\n                      "Observation-Name": [\n                        "Prisoners"\n                      ]\n                    }\n                  }\n                },\n                "right": {\n                  "raw_text": "- Infants currently in the neonatal intensive care unit (NICU) with a diagnosis of prematurity",\n                  "Condition": [\n                    "prematurity"\n                  ],\n                  "Condition-Name": [\n                    "prematurity"\n                  ],\n                  "Eq-Comparison": [\n                    "current"\n                  ],\n                  "Eq-Temporal-Period": [\n                    "current"\n                  ],\n                  "Life-Stage-And-Gender": [\n                    "Infants"\n                  ],\n                  "Location": [\n                    "neonatal intensive care unit",\n                    "NICU"\n                  ]\n                }\n              }\n            },\n            "right": {\n              "OR": {\n                "left": {\n                  "raw_text": "- Neonates of uncertain viability",\n                  "Condition": [\n                    "uncertain viability"\n                  ],\n                  "Condition-Name": [\n                    "uncertain viability"\n                  ],\n                  "Life-Stage-And-Gender": [\n                    "Neonates"\n                  ]\n                },\n                "right": {\n                  "raw_text": "or non-viable neonates",\n                  "Condition": [\n                    "non-viable"\n                  ],\n                  "Condition-Name": [\n                    "non-viable"\n                  ],\n                  "Life-Stage-And-Gender": [\n                    "neonates"\n                  ]\n                }\n              }\n            }\n          }\n        },\n        "right": {\n          "raw_text": "- Patients receiving palliative/hospice care",\n          "Procedure": [\n            "palliative/hospice care"\n          ],\n          "Procedure-Name": [\n            "palliative/hospice care"\n          ],\n          "Eq-Comparison": [\n            "receiving"\n          ],\n          "Eq-Temporal-Period": [\n            "receiving"\n          ]\n        }\n      }\n    },\n    "right": {\n      "raw_text": "- Patient admitted for long-term acute care (LTAC)",\n      "Procedure": [\n        "long-term acute care",\n        "LTAC"\n      ],\n      "Procedure-Name": [\n        "long-term acute care",\n        "LTAC"\n      ],\n      "Encounter": [\n        "admitted"\n      ]\n    }\n  }\n}<|eot_id|>']
