-Name": [\n                                "diverticulitis disease"\n                              ],\n                              "Eq-Comparison": [\n                                "previous history",\n                                "history"\n                              ],\n                              "Eq-Temporal-Period": [\n                                "previous history",\n                                "history"\n                              ],\n                              "Acuteness": [\n                                "acute"\n                              ]\n                            },\n                            "right": {\n                              "raw_text": "or with prior incomplete colonoscopy due to diverticular disease",\n                              "Condition": [\n                                "diverticular disease"\n                              ],\n                              "Condition-Name": [\n                                "diverticular disease"\n                              ],\n                              "Procedure": [\n                                "colonoscopy"\n                              ],\n                              "Procedure-Name": [\n                                "colonoscopy"\n                              ],\n                              "Modifier": [\n                                "incomplete"\n                              ]\n                            }\n                          }\n                        }\n                      }\n                    },\n                    "right": {\n                      "OR": {\n                        "left": {\n                          "raw_text": "3. Patients with known bowel obstruction/",\n                          "Condition": [\n                            "bowel obstruction"\n                          ],\n                          "Condition-Name": [\n                            "bowel obstruction"\n                          ],\n    