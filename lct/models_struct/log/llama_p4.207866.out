 death receptor-1 (PD-1) antibody, anti-programmed death ligand-1 (PD-L1) antibody, anti-programmed death ligand-2 (PD-L2) antibody or anti-cytotoxic T lymphocyte-associated antigen-4 (CTLA-4) antibodies, including those who have participated in a JS001 clinical study;\n2. Patients who previously received any TACE, radiofrequency ablation and other liver cancer treatments;\n3. Patients with a history of gastroesophageal varices or active cardia ulcers associated with a high risk of bleeding;\n4. Patients who have upper gastrointestinal hemorrhage within 1 year;\n5. Patients known to have fibrous layer HCC, sarcomatoid HCC or mixed cholangiocarcinoma and HCC; Other protocol defined inclusion/exclusion criteria could apply\n\n### Response:\n{\n  "AND": {\n    "left": {\n      "AND": {\n        "left": {\n          "AND": {\n            "left": {\n              "AND": {\n                "left": {\n                  "AND": {\n                    "left": {\n                      "OR": {\n                        "left": {\n                          "raw_text": "1. Patients who previously received anti-programmed death receptor-1 (PD-1) antibody,",\n                          "Procedure": [\n                            "anti-programmed death receptor-1",\n                            "PD-1"\n                          ],\n                          "Procedure-Name": [\n                            "anti-programmed death receptor-1",\n                            "PD-1"\n                          ],\n                          "Eq-Comparison": [\n                            "received",\n                            "previously received"\n                          ],\n                          "Eq-Temporal-Period": [\n                            "received",\n                            "previously received"\n                          ],\n                          "Modifier": [\n                            "antibody"\n                          ]\n                        },\n                        "right": {\n                          "OR": {\n                            "left": {\n                              "raw_text": "anti-programmed death ligand-1 (PD-L1) antibody,",\n                              "Procedure": [\n                                "anti-programmed death ligand-1",\n                                "PD-L1"\n                              ],\n                              "Procedure-Name": [\n                                "anti-programmed death ligand-1",\n                                "PD-L1"\n                              ],\n                              "Modifier": [\n                                "antibody"\n                              ]\n                            },\n                            "right": {\n                              "OR": {\n                                "left": {\n                                  "raw_text": "anti-programmed death ligand-2 (PD-L2) antibody",\n                                  "Procedure": [\n                                    "anti-programmed death ligand-2",\n                                    "PD-L2"\n                                  ],\n                                  "Procedure-Name": [\n                                    "anti-programmed death ligand-2",\n                                    "PD-L2"\n                                  ],\n                                  "Modifier": [\n                                    "antibody"\n                                  ]\n                                },\n                                "right": {\n                                  "raw_text": "or anti-cytotoxic T lymphocyte-associated antigen-4 (CTLA-4) antibodies, including those who have participated in a JS001 clinical study;",\n                                  "Procedure": [\n                                    "anti-cytotoxic T lymphocyte-associated antigen-4",\n                                    "CTLA-4"\n                                  ],\n                                  "Procedure-Name": [\n                                    "anti-cytotoxic T lymphocyte-associated antigen-4",\n                                    "CTLA-4"\n                                  ],\n                                  "Modifier": [\n                                    "antibody",\n                                    "antibodies"\n                                  ],\n                                  "Study": [\n                                    "study"\n                                  ]\n                                }\n                              }\n                            }\n                          }\n                        }\n                      }\n                    },\n                    "right": {\n                      "OR": {\n                        "left": {\n                          "raw_text": "2. Patients who previously received any TACE,",\n                          "Procedure": [\n                            "TACE"\n                          ],\n                          "Procedure-Name": [\n                            "TACE"\n                          ],\n                          "Eq-Comparison": [\n                            "received",\n                            "previously received"\n                          ],\n                          "Eq-Temporal-Period": [\n                            "received",\n                            "previously received"\n                          ]\n                        },\n                        "right": {\n                          "raw_text": "radiofrequency ablation and other liver cancer treatments;",\n                          "Procedure": [\n                            "treatments",\n                            "liver cancer treatments",\n                            "radiofrequency ablation"\n                          ],\n                          "Procedure-Name": [\n                            "treatments",\n                            "liver cancer treatments",\n                            "radiofrequency ablation"\n                          ],\n                          "Other": [\n                            "other"\n                          ],\n                          "Condition": [\n                            "cancer"\n                          ],\n                          "Condition-Name": [\n                            "cancer"\n                          ],\n                          "Modifier": [\n                            "liver"\n                          ]\n                        }\n                      }\n                    }\n                  }\n                },\n                "right": {\n                  "OR": {\n                    "left": {\n                      "raw_text": "3. Patients with a history of gastroesophageal varices",\n                      "Condition": [\n                        "gastroesophageal varices"\n                      ],\n                      "Condition-Name": [\n                        "gastroesophageal varices"\n                      ],\n                      "Eq-Comparison": [\n                        "history"\n                      ],\n                      "Eq-Temporal-Period": [\n                        "history"\n                      ]\n                    },\n                    "right": {\n                      "raw_text": "or active cardia ulcers associated with a high risk of bleeding;",\n                      "Condition": [\n                        "cardia ulcers",\n                        "bleeding"\n                      ],\n                      "Condition-Name": [\n                        "cardia ulcers",\n                        "bleeding"\n                      ],\n                      "Risk": [\n                        "risk"\n                      ],\n                      "Polarity": [\n                        "high"\n                      ],\n                      "Eq-Comparison": [\n                        "active"\n                      ],\n                      "Eq-Temporal-Period": [\n                        "active"\n                      ]\n                    }\n                  }\n                }\n              }\n            },\n            "right": {\n              "raw_text": "4. Patients who have upper gastrointestinal hemorrhage within 1 year;",\n              "Condition": [\n                "upper gastrointestinal hemorrhage"\n              ],\n              "Condition-Name": [\n                "upper gastrointestinal hemorrhage"\n              ],\n              "Eq-Operator": [\n                "within"\n              ],\n              "Eq-Temporal-Unit": [\n                "year"\n              ],\n              "Eq-Value": [\n                "1"\n              ],\n              "Eq-Comparison": [\n                "within 1 year"\n              ]\n            }\n          }\n        },\n        "right": {\n          "OR": {\n            "left": {\n              "raw_text": "5. Patients known to have fibrous layer HCC,",\n              "Condition": [\n                "HCC"\n              ],\n              "Condition-Name": [\n                "HCC"\n              ],\n              "Modifier": [\n                "fibrous layer"\n              ]\n            },\n            "right": {\n              "OR": {\n                "left": {\n                  "raw_text": "sarcomatoid HCC",\n                  "Condition": [\n                    "HCC"\n                  ],\n                  "Condition-Name": [\n                    "HCC"\n                  ],\n                  "Modifier": [\n                    "sarcomatoid"\n                  ]\n                },\n                "right": {\n                  "raw_text": "or mixed cholangiocarcinoma and HCC; Other protocol defined inclusion/exclusion criteria could apply",\n                  "Condition": [\n                    "HCC",\n                    "cholangiocarcinoma"\n                  ],\n                  "Condition-