  "AND": {
    "left": {
      "AND": {
        "left": {
          "raw_text": "- < 38 years"
        },
        "right": {
          "OR": {
            "left": {
              "raw_text": "- PCOS patients with polycystic ovarian morphology: at least 25 follicles (2-9 mm) throughout the whole ovary",
              "Condition": [
                "PCOS"
              ]
            },
            "right": {
              "raw_text": "and/or increased ovarian volume (>10ml) (it is sufficient that 1 ovary fits these criteria)",
              "Observation": [
                "ovarian volume"
              ]
            }
          }
        }
      }
    },
    "right": {
      "raw_text": "- No major uterine or ovarian abnormalities",
      "Condition": [
        "abnormalities"
      ]
    }
  }
}
