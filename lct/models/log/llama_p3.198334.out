o provide informed consent"\n            }\n          }\n        },\n        "right": {\n          "OR": {\n            "left": {\n              "raw_text": "- History of opioid,",\n              "Condition": [\n                "History of opioid"\n              ]\n            },\n            "right": {\n              "OR": {\n                "left": {\n                  "raw_text": "other illicit substance,",\n                  "Condition": [\n                    "illicit substance"\n                  ]\n                },\n                "right": {\n                  "raw_text": "or alcohol use disorder either before or during pregnancy",\n                  "Condition": [\n                    "alcohol use disorder"\n                  ]\n                }\n              }\n            }\n          }\n        }\n      }\n    },\n    "right": {\n      "OR": {\n        "left": {\n          "raw_text": "- Severe renal",\n          "Condition": [\n            "renal"\n          ]\n        },\n        "right": {\n          "raw_text": "or hepatic impairment",\n          "Condition": [\n            "hepatic impairment"\n          ]\n        }\n      }\n    }\n  }\n}<|eot_id|>']
