  "AND": {
    "left": {
      "raw_text": "1. Presence of moderate to severe pain from other causes that may confound assessment or self-evaluation of NP."
    },
    "right": {
      "raw_text": "2. Subjects with both DPN and PHN",
      "Condition": [
        "DPN",
        "PHN"
      ]
    }
  }
}
