e included and separated by the logical operators, without omitting any words or information.\n- The output should only contain the JSON object, without any additional text or formatting.\n- Ensure that the JSON output strictly follows these rules and accurately represents the logical structure of the input eligibility criteria.\n\n### Input:\n-  intake of any tricyclic antidepressant within the last 14 days\n-  atrial fibrillation\n-  prior diagnosed autonomic neuropathy\n-  malignant cerebral infarct or indication for treatment at intensive care unit\n-  aphasia or cognitive deficit with resulted inability to participate in Heart rate variability-biofeedback training\n-  respiratory insufficiency\n-  blindness, deafness or other physical limitations with resulted inability to participate in heart rate variability-biofeedback training\n\n### Response:\n{\n  "AND": {\n    "left": {\n      "AND": {\n        "left": {\n          "AND": {\n            "left": {\n              "AND": {\n                "left": {\n                  "AND": {\n                    "left": {\n                      "AND": {\n                        "left": {\n                          "raw_text": "- intake of any tricyclic antidepressant within the last 14 days",\n                          "Drug": [\n                            "tricyclic antidepressant"\n                          ]\n                        },\n                        "right": {\n                          "raw_text": "- atrial fibrillation",\n                          "Condition": [\n                            "atrial fibrillation"\n                          ]\n                        }\n                      }\n                    },\n                    "right": {\n                      "raw_text": "- prior diagnosed autonomic neuropathy",\n                      "Condition": [\n                        "autonomic neuropathy"\n                      ]\n                    }\n                  }\n                },\n                "right": {\n                  "OR": {\n                    "left": {\n                      "raw_text": "- malignant cerebral infarct",\n                      "Condition": [\n                        "malignant cerebral infarct"\n                      ]\n                    },\n                    "right": {\n                      "raw_text": "or indication for treatment at intensive care unit"\n                    }\n                  }\n                }\n              }\n            },\n            "right": {\n              "OR": {\n                "left": {\n                  "raw_text": "- aphasia",\n                  "Condition": [\n                    "aphasia"\n                  ]\n                },\n                "right": {\n                  "OR": {\n                    "left": {\n                      "raw_text": "or cognitive deficit",\n                      "Condition": [\n                        "cognitive deficit"\n                      ]\n                    },\n                    "right": {\n                      "raw_text": "with resulted inability to participate in Heart rate variability-biofeedback training"\n                    }\n                  }\n                }\n              }\n            }\n          }\n        },\n        "right": {\n          "raw_text": "- respiratory insufficiency",\n          "Condition": [\n            "respiratory insufficiency"\n          ]\n        }\n      }\n    },\n    "right": {\n      "OR": {\n        "left": {\n          "raw_text": "- blindness,",\n          "Condition": [\n            "blindness"\n          ]\n        },\n        "right": {\n          "OR": {\n            "left": {\n              "raw_text": "deafness",\n              "Condition": [\n                "deafness"\n              ]\n            },\n            "right": {\n              "raw_text": "or other physical limitations with resulted inability to participate in heart rate variability-biofeedback training"\n            }\n          }\n        }\n      }\n    }\n  }\n}<|eot_id|>']
