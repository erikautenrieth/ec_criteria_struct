    "left": {
      "raw_text": "- Undertake regular exercise at least 3 times a week with accumulation of 150 min per week"
    },
    "right": {
      "raw_text": "- Age between 20 and 30 years old",
      "Observation": [
        "Age"
      ]
    }
  }
}
