2;",\n                  "Observation": [\n                    "Glasgow Coma Scale"\n                  ]\n                }\n              }\n            },\n            "right": {\n              "raw_text": "9. Imminent death;",\n              "Condition": [\n                "death"\n              ]\n            }\n          }\n        },\n        "right": {\n          "raw_text": "10. Contraindications to noninvasive ventilation;",\n          "Observation": [\n            "noninvasive ventilation"\n          ]\n        }\n      }\n    },\n    "right": {\n      "OR": {\n        "left": {\n          "raw_text": "11. Tracheostomy.",\n          "Condition": [\n            "Tracheostomy"\n          ]\n        },\n        "right": {\n          "raw_text": ""\n        }\n      }\n    }\n  }\n}<|eot_id|>']
