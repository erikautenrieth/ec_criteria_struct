r"\n            ]\n          },\n          "right": {\n            "OR": {\n              "left": {\n                "raw_text": "respiratory,",\n                "Condition": [\n                  "respiratory"\n                ]\n              },\n              "right": {\n                "OR": {\n                  "left": {\n                    "raw_text": "hepatic,",\n                    "Condition": [\n                      "hepatic"\n                    ]\n                  },\n                  "right": {\n                    "OR": {\n                      "left": {\n                        "raw_text": "renal,",\n                        "Condition": [\n                          "renal"\n                        ]\n                      },\n                      "right": {\n                        "OR": {\n                          "left": {\n                            "raw_text": "gastrointestinal,",\n                            "Condition": [\n                              "gastrointestinal"\n                            ]\n                          },\n                          "right": {\n                            "OR": {\n                              "left": {\n                                "raw_text": "endocrine,",\n                                "Condition": [\n                                  "endocrine"\n                                ]\n                              },\n                              "right": {\n                                "OR": {\n                                  "left": {\n                                    "raw_text": "hematological",\n                                    "Condition": [\n                                      "hematological"\n                                    ]\n                                  },\n                                  "right": {\n                                    "raw_text": "or neurological disorders.",\n                                    "Condition": [\n                               