              "Condition": [
                "bulimia nervosa"
              ]
            }
          }
        }
      }
    },
    "right": {
      "AND": {
        "left": {
          "raw_text": "- Aged 13-50 years",
          "Observation": [
            "Aged"
          ]
        },
        "right": {
          "raw_text": "- English-speaking"
        }
      }
    }
  }
}
