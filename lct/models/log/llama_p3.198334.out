                                "pregnancy",
                                "breastfeeding"
                              ]
                            }
                          }
                        },
                        "right": {
                          "raw_text": "- Known lactate deficiency or any other problem absorbing lactose, galactose or glucose",
                          "Condition": [
                            "lactate deficiency"
                          ]
                        }
                      }
                    },
                    "right": {
                      "raw_text": "- Current or past history of drug or alcohol dependency",
                      "Condition": [
                        "drug or alcohol dependency"
                      ]
                    }
                  }
                },
                "right": {
                  "raw_text": "- Participation in a psychological or medical study involving the use of medication within the last 3 months",
                  "Drug": [
                    "medication"
                  ]
                }
              }
            },
            "right": {
              "raw_text": "- Previous participation in a study using the same, or similar, emotional processing tasks"
            }
          }
        },
        "right": {
          "raw_text": "- Smoker > 5 cigarettes per day",
          "Observation": [
            "cigarettes"
          ]
        }
      }
    },
    "right": {
      "raw_text": "- Typically drinks > 6 caffeinated drinks per day",
      "Observation": [
        "caffeinated drinks"
      ]
    }
  }
}
