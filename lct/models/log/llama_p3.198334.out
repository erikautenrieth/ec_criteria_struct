            },
            "right": {
              "OR": {
                "left": {
                  "raw_text": "- Cicatricial uterus with contraindication to vaginal delivery (uterus bi",
                  "Condition": [
                    "Cicatricial uterus"
                  ]
                },
                "right": {
                  "OR": {
                    "left": {
                      "raw_text": "or multi-cicatricial, corporal uterine scar, intra-mural myomectomy, dystocic presentation)",
                      "Condition": [
                        "dystocic presentation"
                      ]
                    },
                    "right": {
                      "raw_text": "",
                      "Condition": [
                        "presentation"
                      ]
                    }
                  }
                }
              }
            }
          }
        },
        "right": {
          "raw_text": "- Fetal macrosomia with a weight greater than 4Kg",
          "Condition": [
            "Fetal macrosomia"
          ]
        }
      }
    },
    "right": {
      "raw_text": "- Placenta previa",
      "Condition": [
        "Placenta previa"
      ]
    }
  }
}
