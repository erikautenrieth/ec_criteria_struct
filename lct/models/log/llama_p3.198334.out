e included and separated by the logical operators, without omitting any words or information.\n- The output should only contain the JSON object, without any additional text or formatting.\n- Ensure that the JSON output strictly follows these rules and accurately represents the logical structure of the input eligibility criteria.\n\n### Input:\n-  participated in structured weight training during the previous 12 month\n-  vegetarian or vegan\n-  presence of chronic disease\n-  pregnant, postpartum up to six months, lactating, or intention to become pregnant\n-  allergy to whey or soy\n-  changes in body weight more than 10 pounds in the past three months\n\n### Response:\n{\n  "AND": {\n    "left": {\n      "AND": {\n        "left": {\n          "AND": {\n            "left": {\n              "AND": {\n                "left": {\n                  "AND": {\n                    "left": {\n                      "raw_text": "- participated in structured weight training during the previous 12 month"\n                    },\n                    "right": {\n                      "OR": {\n                        "left": {\n                          "raw_text": "- vegetarian"\n                        },\n                        "right": {\n                          "raw_text": "or vegan"\n                        }\n                      }\n                    }\n                  }\n                },\n                "right": {\n                  "raw_text": "- presence of chronic disease",\n                  "Condition": [\n                    "disease"\n                  ]\n                }\n              }\n            },\n            "right": {\n              "OR": {\n                "left": {\n                  "raw_text": "- pregnant,"\n                },\n                "right": {\n                  "OR": {\n                    "left": {\n                      "raw_text": "postpartum up to six months,"\n                    },\n                    "right": {\n                      "OR": {\n                        "left": {\n                          "raw_text": "lactating,"\n                        },\n                        "right": {\n                          "raw_text": "or intention to become pregnant"\n                        }\n                      }\n                    }\n                  }\n                }\n              }\n            }\n          }\n        },\n        "right": {\n          "raw_text": "- allergy to whey or soy",\n          "Drug": [\n            "whey",\n            "soy"\n          ]\n        }\n      }\n    },\n    "right": {\n      "raw_text": "- changes in body weight more than 10 pounds in the past three months",\n      "Observation": [\n        "body weight"\n      ]\n    }\n  }\n}<|eot_id|>']
