ft": {\n                                                                                                                                                              "AND": {\n                                                                                                                                                                "left": {\n                                                                                                                                                                  "AND": {\n                                                                                                                                                                    "left": {\n                                                                                                                                                                      "AND": {\n                                                                                                                                                                        "left": {\n                                                                                                                                                                          "AND": {\n                                                                                                                                                                            "left": {\n                                                                                                                                                                              "AND": {\n                                                                                                                                                                                "AND": {\n                                                                                                                                                                                  "left": {\n                                                                                                                                                                                    "raw_text": "- Singleton gestation.",\n                                                                                                                                                                                    "Condition": [\n                                                                                                                                                                                      "gestation"\n                                                                                                                                                                                    ]\n                                                                                                                                                                                  },\n                                                                                                                                                                                  "right": {\n                                                                                                                                                                                    "raw_text": "- Twin gestation reduced to singleton either spontaneously or therapeutically, is not eligible unless the reduction occurred before 13 weeks 6 days project gestational age.",\n                                                                                                                                                                                    "Condition": [\n                                                                                                                                                                                      "gestation"\n                                                                                                                                                                                    ]\n                                                                                                                                                                                  }\n                                                                                                                                                                                },\n                                                                                                                                                                              "right": {\n                                                                                                                                                                                "raw_text": "- Higher order multifetal gestations reduced to singletons are not eligible.",\n                                                                                                                                                                                "Condition": [\n                                                                                                                                                                                  "gestations"\n                                                                                                                                                                                ]\n                                                                                                                                                                              }\n                                                                                                                                                                            },\n                                                                                                                                                                          "right": {\n       