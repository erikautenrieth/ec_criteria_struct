                        "low back pain"\n                                      ]\n                                    }\n                                  }\n                                }\n                              }\n                            }\n                          }\n                        }\n                      }\n                    },\n                    "right": {\n                      "raw_text": "- Current regular use of analgesic medication or other medication which may affect the trial",\n                      "Drug": [\n                        "analgesic medication",\n                        "medication"\n                      ]\n                    }\n                  }\n                },\n                "right": {\n                  "raw_text": "- Lack of ability to cooperate",\n                  "Condition": [\n                    "Lack of ability"\n                  ]\n                }\n              }\n            },\n            "right": {\n              "raw_text": "- Pregnancy",\n              "Condition": [\n                "Pregnancy"\n              ]\n            }\n          }\n        },\n        "right": {\n          "raw_text": "- Low back pain associated with menstruation",\n          "Condition": [\n            "Low back pain"\n          ],\n          "Observation": [\n            "menstruation"\n          ]\n        }\n      }\n    },\n    "right": {\n      "raw_text": "- Currently seeking active treatment for low back pain",\n      "Condition": [\n        "low back pain"\n      ]\n    }\n  }\n}<|eot_id|>']
