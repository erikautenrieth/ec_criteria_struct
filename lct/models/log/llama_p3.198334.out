          ]
        },
        "right": {
          "raw_text": "- Prior to participating in the study, adalimumab treatment was determined according to clinical judgement of the physician.",
          "Drug": [
            "adalimumab"
          ]
        }
      }
    },
    "right": {
      "raw_text": "- Participants (or legal representative) who voluntarily agreed to participate in this study and signed informed consent."
    }
  }
}
