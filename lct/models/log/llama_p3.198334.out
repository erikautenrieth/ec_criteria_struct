n"\n                      ]\n                    },\n                    "right": {\n                      "OR": {\n                        "left": {\n                          "raw_text": "or any other cochlear anomaly that might prevent complete insertion of the electrode array.",\n                          "Condition": [\n                            "cochlear anomaly"\n                          ]\n                        },\n                        "right": {\n                          "raw_text": "array."\n                        }\n                      }\n                    }\n                  }\n                }\n              }\n            },\n            "right": {\n              "AND": {\n                "left": {\n                  "raw_text": "3. Unrealistic expectations on the part of the candidate"\n                },\n                "right": {\n                  "OR": {\n                    "left": {\n                      "raw_text": "and/or candidate\'s family, regarding the possible benefits, risks, and limitations that are inherent to the surgical procedure(s) and prosthetic devices."\n                    },\n                    "right": {\n                      "raw_text": "devices."\n                    }\n                  }\n                }\n              }\n            }\n          }\n        },\n        "right": {\n          "OR": {\n            "left": {\n              "raw_text": "4. Unwillingness"\n            },\n            "right": {\n              "OR": {\n                "left": {\n                  "raw_text": "or inability of the candidate to comply with all investigational requirements."\n                },\n                "right": {\n                  "raw_text": "requirements."\n                }\n              }\n            }\n          }\n        }\n      }\n    },\n    "right": {\n      "OR": {\n        "left": {\n          "raw_text": "5. Active middle ear infection.",\n          "Condition": [\n            "infection"\n          ]\n        },\n        "right": {\n          "raw_text": "6. Tinnitus primary motivation for implantation.",\n          "Condition": [\n            "Tinnitus"\n          ]\n        }\n      }\n    }\n  }\n}<|eot_id|>']
