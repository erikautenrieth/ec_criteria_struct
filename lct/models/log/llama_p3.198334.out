on": [\n                                                                                                                                                                          "cervical length"\n                                                                                                                                                                        ]\n                                                                                                                                                                      }\n                                                                                                                                                                    },\n                                                                                                                                                                  "right": {\n                                                                                                                                                                    "raw_text": "-"\n                                                                                                                                                                  }\n                                                                                                                                                                },\n                                                                                                                                                                "right": {\n                                                                                                                                                                  "raw_text": "-"\n                                                                                                                                                                }\n                                                                                                 