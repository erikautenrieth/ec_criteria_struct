                  ]\n                    },\n                    "right": {\n                      "raw_text": "size of uterus and vagina allows for retrieval by the vaginal route in cancer patients",\n                      "Condition": [\n                        "cancer"\n                      ]\n                    }\n                  }\n                }\n              }\n            }\n          }\n        },\n        "right": {\n          "raw_text": "- written informed consent"\n        }\n      }\n    },\n    "right": {\n      "raw_text": ""\n    }\n  }\n}<|eot_id|>']
