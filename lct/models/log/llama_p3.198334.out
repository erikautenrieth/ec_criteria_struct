e included and separated by the logical operators, without omitting any words or information.\n- The output should only contain the JSON object, without any additional text or formatting.\n- Ensure that the JSON output strictly follows these rules and accurately represents the logical structure of the input eligibility criteria.\n\n### Input:\n-  Contraindication to Allopurinol\n-  Elevated baseline liver function tests\n-  Receiving acute or chronic dialysis\n-  Primary metabolic disorder\n-  Sickle cell disease\n-  Autosomal Dominant Polycystic Kidney Disease\n-  Cystinosis\n-  Bartter or Gitelman Disease\n-  Pregnant or nursing\n\n### Response:\n{\n  "AND": {\n    "left": {\n      "AND": {\n        "left": {\n          "AND": {\n            "left": {\n              "AND": {\n                "left": {\n                  "AND": {\n                    "left": {\n                      "AND": {\n                        "left": {\n                          "AND": {\n                            "left": {\n                              "AND": {\n                                "left": {\n                                  "raw_text": "- Contraindication to Allopurinol",\n                                  "Drug": [\n                                    "Allopurinol"\n                                  ]\n                                },\n                                "right": {\n                                  "raw_text": "- Elevated baseline liver function tests",\n                                  "Observation": [\n                                    "liver function tests"\n                                  ]\n                                }\n                              }\n                            },\n                            "right": {\n                              "raw_text": "- Receiving acute or chronic dialysis",\n                              "Condition": [\n                                "dialysis"\n                              ]\n                            }\n                          }\n                        },\n                        "right": {\n                          "raw_text": "- Primary metabolic disorder",\n                          "Condition": [\n                            "metabolic disorder"\n                          ]\n                        }\n                      }\n                    },\n                    "right": {\n                      "raw_text": "- Sickle cell disease",\n                      "Condition": [\n                        "Sickle cell disease"\n                      ]\n                    }\n                  }\n                },\n                "right": {\n                  "raw_text": "- Autosomal Dominant Polycystic Kidney Disease",\n                  "Condition": [\n                    "Autosomal Dominant Polycystic Kidney Disease"\n                  ]\n                }\n              }\n            },\n            "right": {\n              "raw_text": "- Cystinosis",\n              "Condition": [\n                "Cystinosis"\n              ]\n            }\n          }\n        },\n        "right": {\n          "raw_text": "- Bartter or Gitelman Disease",\n          "Condition": [\n            "Bartter Disease",\n            "Gitelman Disease"\n          ]\n        }\n      }\n    },\n    "right": {\n      "OR": {\n        "left": {\n          "raw_text": "- Pregnant"\n        },\n        "right": {\n          "raw_text": "or nursing"\n        }\n      }\n    }\n  }\n}<|eot_id|>']
