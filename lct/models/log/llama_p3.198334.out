e included and separated by the logical operators, without omitting any words or information.\n- The output should only contain the JSON object, without any additional text or formatting.\n- Ensure that the JSON output strictly follows these rules and accurately represents the logical structure of the input eligibility criteria.\n\n### Input:\n-  Ulcerative colitis with confirmed diagnosis by histology and endoscopy AND in stable remission for 3 months or more without therapy or with a maintenance therapy (except steroids and antibiotics for 3 months)\n-  A negative pregnancy test\n\n### Response:\n{\n  "AND": {\n    "left": {\n      "AND": {\n        "left": {\n          "AND": {\n            "left": {\n              "raw_text": "- Ulcerative colitis with confirmed diagnosis by histology",\n              "Condition": [\n                "Ulcerative colitis"\n              ]\n            },\n            "right": {\n              "raw_text": "and endoscopy AND in stable remission for 3 months or more without therapy or with a maintenance therapy (except steroids and antibiotics for 3 months)"\n            }\n          }\n        },\n        "right": {\n          "OR": {\n            "left": {\n              "raw_text": "-"\n            },\n            "right": {\n              "NOT": {\n                "left": {\n                  "OR": {\n                    "left": {\n                      "raw_text": "with a maintenance therapy (except steroids",\n                      "Drug": [\n                        "steroids"\n                      ]\n                    },\n                    "right": {\n                      "raw_text": "and antibiotics for 3 months)"\n                    }\n                  }\n                }\n              }\n            }\n          }\n        }\n      }\n    },\n    "right": {\n      "raw_text": "- A negative pregnancy test"\n    }\n  }\n}<|eot_id|>']
