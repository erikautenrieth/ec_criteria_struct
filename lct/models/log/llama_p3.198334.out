                },
                "right": {
                  "raw_text": "- Patients diagnosed with unilateral OA of the knee or hip planned for a treatment with THA",
                  "Condition": [
                    "OA"
                  ]
                }
              }
            }
          }
        },
        "right": {
          "OR": {
            "left": {
              "raw_text": "or TKA (Patient groups 3+4)"
            },
            "right": {
              "raw_text": "- Age \u2265 30 years (Healthy control group)"
            }
          }
        }
      }
    },
    "right": {
      "raw_text": ""
    }
  }
}
