                        "left": {
                          "raw_text": "- vegetarian"
                        },
                        "right": {
                          "raw_text": "or vegan"
                        }
                      }
                    }
                  }
                },
                "right": {
                  "raw_text": "- presence of chronic disease",
                  "Condition": [
                    "disease"
                  ]
                }
              }
            },
            "right": {
              "OR": {
                "left": {
                  "raw_text": "- pregnant,"
                },
                "right": {
                  "OR": {
                    "left": {
                      "raw_text": "postpartum up to six months,"
                    },
                    "right": {
                      "OR": {
                        "left": {
                          "raw_text": "lactating,"
                        },
                        "right": {
                          "raw_text": "or intention to become pregnant"
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "right": {
          "raw_text": "- allergy to whey or soy",
          "Drug": [
            "whey",
            "soy"
          ]
        }
      }
    },
    "right": {
      "raw_text": "- changes in body weight more than 10 pounds in the past three months",
      "Observation": [
        "body weight"
      ]
    }
  }
}
