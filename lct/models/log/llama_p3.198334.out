                    "left": {
                      "raw_text": "2. Congenital lower limb musculoskeletal diseases,",
                      "Condition": [
                        "musculoskeletal diseases"
                      ]
                    },
                    "right": {
                      "raw_text": "Lower limb or spine surgery",
                      "Observation": [
                        "surgery"
                      ]
                    }
                  }
                }
              }
            },
            "right": {
              "OR": {
                "left": {
                  "raw_text": "3. Uncommunicated"
                },
                "right": {
                  "raw_text": "or cognitive impaired",
                  "Condition": [
                    "cognitive impaired"
                  ]
                }
              }
            }
          }
