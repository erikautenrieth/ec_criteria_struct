                        "diabetes",
                        "condition"
                      ]
                    },
                    "right": {
                      "OR": {
                        "left": {
                          "raw_text": "cardiovascular disease,",
                          "Condition": [
                            "cardiovascular disease"
                          ]
                        },
                        "right": {
                          "OR": {
                            "left": {
                              "raw_text": "immunologic disorders,",
                              "Condition": [
                                "immunologic disorders"
                              ]
                            },
                            "right": {
                              "raw_text": "hepatitis, e.g.)",
                              "Condition": [
                                "hepatitis"
                              ]
                            }
                          }
                        }
                      }
                    }
                  }
                },
                "right": {
                  "OR": {
                    "left": {
                      "raw_text": "- pregnancy,",
                      "Condition": [
                        "pregnancy"
                      ]
                    },
                    "right": {
                      "OR": {
                        "left": {
                          "raw_text": "lactation",
                          "Condition": [
                            "lactation"
                          ]
                        },
                        "right": {
                          "raw_text": "or menopause term,",
                          "Condition": [
                            "menopause"
                          ]
                        }
                      }
                    }
                  }
                }
              }
            },
            "right": {
              "OR": {
                "left": {
                  "raw_text": "- antibiotic treatment",
                  "Drug": [
