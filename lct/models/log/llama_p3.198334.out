"Condition": [\n                                "Congenital immune deficiency"\n                              ]\n                            }\n                          }\n                        },\n                        "right": {\n                          "raw_text": "- bacteremia related to a peripheral or central catheter",\n                          "Condition": [\n                            "bacteremia"\n                          ]\n                        }\n                      }\n                    },\n                    "right": {\n                      "raw_text": "- Urinary obstruction not lifted within the first 24 hours of management",\n                      "Condition": [\n                        "Urinary obstruction"\n                      ]\n                    }\n                  }\n                },\n                "right": {\n                  "raw_text": "- Intra-abdominal infection collected undrained in the first 24 hours of management",\n                  "Condition": [\n                    "Intra-abdominal infection"\n                  ]\n                }\n              }\n            },\n            "right": {\n              "raw_text": "- primary infectious focus represented by mechanically ventilated pneumonia",\n              "Condition": [\n                "pneumonia"\n              ]\n            }\n          }\n        },\n        "right": {\n          "OR": {\n            "left": {\n              "raw_text": "- Pregnant"\n            },\n            "right": {\n              "raw_text": "or lactating woman"\n            }\n          }\n        }\n      }\n    },\n    "right": {\n      "raw_text": ""\n    }\n  }\n}<|eot_id|>']
