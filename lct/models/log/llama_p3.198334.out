e included and separated by the logical operators, without omitting any words or information.\n- The output should only contain the JSON object, without any additional text or formatting.\n- Ensure that the JSON output strictly follows these rules and accurately represents the logical structure of the input eligibility criteria.\n\n### Input:\n-  Pre-menarche or post-menopause\n-  Contraindications to cabergoline (e.g., cardiac valve disorder; pulmonary, pericardial, retroperitoneal fibrotic disorder; hypersensitivity to ergot derivatives; uncontrolled hypertension)\n-  Significant mental or chronic systemic illness that might confound pain assessment or the ability to complete the study\n-  Pregnant, breastfeeding, or planning to become pregnant in the next 6 months\n-  Impaired liver function (ALT > 2x normal) or liver disease\n-  Breast cancer, current or previous\n-  Thromboembolic disease, current or previous\n-  Use of other drugs that affect dopamine (e.g., phenothiazines, metoclopramide, butyrophenones)\n\n### Response:\n{\n  "AND": {\n    "left": {\n      "AND": {\n        "left": {\n          "AND": {\n            "left": {\n              "AND": {\n                "left": {\n                  "AND": {\n                    "left": {\n                      "AND": {\n                        "left": {\n                          "AND": {\n                            "left": {\n                              "AND": {\n                                "left": {\n                                  "raw_text": "- Pre-menarche",\n                                  "Condition": [\n                                    "menarche"\n                                  ]\n                                },\n                                "right": {\n                                  "raw_text": "or post-menopause",\n                                  "Condition": [\n                                    "menopause"\n                                  ]\n                                }\n                              }\n                            },\n                            "right": {\n                              "OR": {\n                                "left": {\n                                  "raw_text": "- Contraindications to cabergoline (e.g., cardiac valve disorder;",\n                                  "Condition": [\n                                    "contraindications",\n                                    "cardiac valve disorder"\n                                  ],\n                                  "Drug": [\n                                    "cabergoline"\n                                  ]\n                                },\n                                "right": {\n                                  "OR": {\n                                    "left": {\n                                      "raw_text": "pulmonary,",\n                                      "Condition": [\n                                        "pulmonary"\n                                      ]\n                                    },\n                                    "right": {\n                                      "OR": {\n                                        "left": {\n                                          "raw_text": "pericardial,",\n                                          "Condition": [\n                                            "pericardial"\n                                          ]\n                                        },\n                                        "right": {\n                                          "raw_text": "retroperitoneal fibrotic disorder;",\n                                          "Condition": [\n                                            "retroperitoneal fibrotic disorder"\n                                          ]\n                                        }\n                                      }\n                                    }\n                                  }\n                                }\n                              }\n                            }\n                          }\n                        },\n                        "right": {\n                          "OR": {\n                            "left": {\n                              "raw_text": "- Significant mental",\n                              "Condition": [\n                                "mental"\n                              ]\n                            },\n                            "right": {\n                              "raw_text": "or chronic systemic illness that might confound pain assessment or the ability to complete the study",\n                              "Condition": [\n                                "illness"\n                              ]\n                            }\n                          }\n                        }\n                      }\n                    },\n                    "right": {\n                      "OR": {\n                        "left": {\n                          "raw_text": "- Pregnant,",\n                          "Condition": [\n                            "Pregnant"\n                          ]\n                        },\n                        "right": {\n                          "OR": {\n                            "left": {\n                              "raw_text": "breastfeeding,",\n                              "Condition": [\n                                "breastfeeding"\n                              ]\n                            },\n                            "right": {\n                              "raw_text": "or planning to become pregnant in the next 6 months",\n                              "Condition": [\n                                "pregnant"\n                              ]\n                            }\n                          }\n                        }\n                      }\n                    }\n                  }\n                },\n                "right": {\n                  "raw_text": "- Impaired liver function (ALT > 2x normal) or liver disease",\n                  "Condition": [\n                    "liver function",\n                    "liver disease"\n                  ],\n                  "Observation": [\n                    "ALT"\n                  ]\n                }\n              }\n            },\n            "right": {\n              "OR": {\n                "left": {\n                  "raw_text": "- Breast cancer,",\n                  "Condition": [\n                    "Breast cancer"\n                  ]\n                },\n                "right": {\n                  "raw_text": "current or previous",\n                  "Condition": [\n                    "previous"\n                  ]\n                }\n              }\n            }\n          }\n        },\n        "right": {\n          "OR": {\n            "left": {\n              "raw_text": "- Thromboembolic disease,",\n              "Condition": [\n                "Thromboembolic disease"\n              ]\n            },\n            "right": {\n              "raw_text": "current or previous",\n              "Condition": [\n                "previous"\n              ]\n            }\n          }\n        }\n      }\n    },\n    "right": {\n      "OR": {\n        "left": {\n          "raw_text": "- Use of other drugs that affect dopamine (e.g., phenothiazines,",\n          "Drug": [\n            "drugs",\n            "phenothiazines"\n          ]\n        },\n        "right": {\n          "OR": {\n            "left": {\n              "raw_text": "metoclopramide,",\n              "Drug": [\n                "metoclopramide"\n              ]\n            },\n            "right": {\n              "raw_text": "butyrophenones)",\n              "Drug": [\n                "butyrophenones"\n              ]\n            }\n          }\n        }\n      }\n    }\n  }\n}<|eot_id|>']
