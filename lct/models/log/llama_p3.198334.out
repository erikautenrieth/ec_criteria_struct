        "left": {
          "AND": {
            "left": {
              "AND": {
                "left": {
                  "raw_text": "- The patient or his / her representative has been informed about the implementation of the study, its objectives, its constraints, the rights of the patient"
                },
                "right": {
                  "raw_text": "and must have received the newsletter and no opposition of the study."
                }
              }
            },
            "right": {
              "raw_text": "- The patient must be an affiliate or beneficiary of a health insurance plan.",
              "Observation": [
                "health insurance plan"
              ]
            }
          }
        },
        "right": {
          "raw_text": "- The patient is at least 18 years old."
        }
      }
    },
    "right": {
      "raw_text": "- The patient has septic shock as defined by the 3rd International Conference for the definition of sepsis and septic shock",
      "Condition": [
        "septic shock",
        "sepsis"
      ]
    }
  }
}
