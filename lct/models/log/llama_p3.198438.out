   "raw_text": "4. Have received prior radiation to maximally tolerated levels to any critical normal organ.",\n                          "Observation": [\n                            "radiation"\n                          ]\n                        }\n                      }\n                    },\n                    "right": {\n                      "raw_text": "5. Clinically significant cardiac disease.",\n                      "Condition": [\n                        "cardiac disease"\n                      ]\n                    }\n                  }\n                },\n                "right": {\n                  "raw_text": "6. Active, uncontrolled serious infection.",\n                  "Condition": [\n                    "infection"\n                  ]\n                }\n              }\n            },\n            "right": {\n              "AND": {\n                "left": {\n                  "raw_text": "7. Have other non-myeloid malignancy",\n                  "Condition": [\n                    "malignancy"\n                  ]\n                },\n                "right": {\n                  "raw_text": "within 2 years of entry (with exceptions)."\n                }\n              }\n            }\n          }\n        },\n        "right": {\n          "raw_text": "8. Psychiatric disorder that would preclude study participation",\n          "Condition": [\n            "Psychiatric disorder"\n          ]\n        }\n      }\n    },\n    "right": {\n      "AND": {\n        "left": {\n          "raw_text": "9. Previous solid organ transplant (prior treatment with SCT is allowed"\n        },\n        "right": {\n          "NOT": {\n            "left": {\n              "OR": {\n                "left": {\n                  "raw_text": "but not if patient has GVHD",\n                  "Condition": [\n                    "GVHD"\n                  ]\n                },\n                "right": {\n                  "raw_text": "or is still receiving immunosuppression/GVHD therapy).",\n                  "Condition": [\n                    "GVHD"\n                  ]\n                }\n              }\n            }\n          }\n        }\n      }\n    }\n  }\n}<|eot_id|>']
