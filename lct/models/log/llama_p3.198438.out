                    "right": {
                      "raw_text": "or type 2 diabetes",
                      "Condition": [
                        "diabetes"
                      ]
                    }
                  }
                },
                "right": {
                  "raw_text": "- Age \u2265 18 years"
                }
              }
            },
            "right": {
              "raw_text": "- Ability to read English"
            }
          }
        },
        "right": {
          "raw_text": "- Duration of diabetes \u2265 6 months (DSME cohort only)",
          "Condition": [
            "diabetes"
          ]
        }
      }
    },
    "right": {
      "raw_text": "- A1C \u2265 8.0% (DSME cohort only)",
      "Observation": [
        "A1C"
      ]
    }
  }
}
