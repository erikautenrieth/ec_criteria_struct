                      "Condition": [
                        "systemic diseases"
                      ]
                    },
                    "right": {
                      "OR": {
                        "left": {
                          "raw_text": "c) vision,"
                        },
                        "right": {
                          "OR": {
                            "left": {
                              "raw_text": "hearing"
                            },
                            "right": {
                              "OR": {
                                "left": {
                                  "raw_text": "or vestibular problems, d) Severe trauma",
                                  "Observation": [
                                    "trauma"
                                  ],
                                  "Condition": [
                                    "vestibular problems"
                                  ]
                                },
                                "right": {
                                  "raw_text": "or traffic accident which has had an impact on the cervical area.",
                                  "Observation": [
                                    "traffic accident"
                                  ],
                                  "Condition": [
                                    "impact"
