e included and separated by the logical operators, without omitting any words or information.\n- The output should only contain the JSON object, without any additional text or formatting.\n- Ensure that the JSON output strictly follows these rules and accurately represents the logical structure of the input eligibility criteria.\n\n### Input:\n-  Fetal distress requiring fast delivery.\n-  Patients with hypersensitivity, allergic response, resistance to the drugs used in this study (fentanyl, ropivacaine, lidocaine).\n-  Patients who is not possible for regional anesthesia\n-  Patients who refused to participate in this study.\n-  Patients who cannot read or understand the agreement.\n-  Patients whose weight is less than 50kg or exceeds 100kg.\n\n### Response:\n{\n  "AND": {\n    "left": {\n      "AND": {\n        "left": {\n          "AND": {\n            "left": {\n              "AND": {\n                "left": {\n                  "AND": {\n                    "left": {\n                      "raw_text": "- Fetal distress requiring fast delivery.",\n                      "Condition": [\n                        "Fetal distress"\n                      ]\n                    },\n                    "right": {\n                      "OR": {\n                        "left": {\n                          "raw_text": "- Patients with hypersensitivity, allergic response,",\n                          "Condition": [\n                            "hypersensitivity"\n                          ]\n                        },\n                        "right": {\n                          "raw_text": "resistance to the drugs used in this study (fentanyl, ropivacaine, lidocaine).",\n                          "Drug": [\n                            "drugs",\n                            "fentanyl",\n                            "ropivacaine",\n                            "lidocaine"\n                          ]\n                        }\n                      }\n                    }\n                  }\n                },\n                "right": {\n                  "AND": {\n                    "left": {\n                      "raw_text": "- Patients who is"\n                    },\n                    "right": {\n                      "NOT": {\n                        "left": {\n                          "raw_text": "not possible for regional anesthesia"\n                        }\n                      }\n                    }\n                  }\n                }\n              }\n            },\n            "right": {\n              "raw_text": "- Patients who refused to participate in this study."\n            }\n          }\n        },\n        "right": {\n          "raw_text": "- Patients who cannot read or understand the agreement."\n        }\n      }\n    },\n    "right": {\n      "AND": {\n        "left": {\n          "raw_text": "- Patients whose weight is less than 50kg",\n          "Observation": [\n            "weight"\n          ]\n        },\n        "right": {\n          "raw_text": "or exceeds 100kg."\n        }\n      }\n    }\n  }\n}<|eot_id|>']
