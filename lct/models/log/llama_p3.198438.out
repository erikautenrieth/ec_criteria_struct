                                }
                              }
                            }
                          }
                        },
                        "right": {
                          "raw_text": "- User with electric-acoustic stimulation (EAS; user of an EAS audio processor)",
                          "Condition": [
                            "electric-acoustic stimulation",
                            "EAS"
                          ]
                        }
                      }
                    },
                    "right": {
