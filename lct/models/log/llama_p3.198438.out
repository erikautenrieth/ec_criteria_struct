                                  "AND": {
                                    "left": {
                                      "raw_text": "- Patient is CMV (cytomegalo virus)-",
                                      "Condition": [
                                        "CMV",
                                        "cytomegalo virus"
                                      ]
                                    },
                                    "right": {
                                      "NOT": {
                                        "left": {
                                          "raw_text": "negative and receiving a kidney from a CMV-positive donor.",
                                          "Condition": [
                                            "CMV"
                                          ]
                                        }
                                      }
                                    }
                                  }
                                }
                              }
                            },
                            "right": {
                              "raw_text": "- Positive T-cell lymphocytotoxic cross match.",
                              "Observation": [
                                "T-cell lymphocytotoxic cross match"
                              ]
                            }
                          }
                        },
                        "right": {
                          "OR": {
                            "left": {
                              "raw_text": "- Patient has a known contraindication to any of the protocol-specified treatments."
                            },
                            "right": {
                              "OR": {
                                "left": {
                                  "raw_text": "- Patient with prior kidney transplant"
                                },
                                "right": {
                                  "AND": {
                                    "left": {
                                      "raw_text": "or"
                                    },
                                    "right": {
                                      "NOT": {
                                        "left": {
                                          "raw_text": "non-renal solid organ transplant."
                                        }
                                      }
                                    }
                                  }
                                }
                              }
                            }
                          }
                        }
                      }
                    },
                    "right": {
                      "AND": {
                        "left": {
                          "raw_text": "- Patient had been diagnosed with a malignancy within 5 years prior to study entry,",
                          "Condition": [
                            "malignancy"
                          ]
                        },
                        "right": {
                          "NOT": {
                            "left": {
                              "OR": {
                                "left": {
                                  "raw_text": "excluding non-metastatic basal"
                                },
                                "right": {
                                  "raw_text": "or squamous cell carcinoma of the skin.",
                                  "Condition": [
                                    "carcinoma"
                                  ]
                                }
                              }
                            }
                          }
                        }
                      }
                    }
                  }
                },
                "right": {
                  "raw_text": "- Female patients who are breast-feeding.",
                  "Condition": [
                    "breast-feeding"
                  ]
                }
              }
            },
            "right": {
              "raw_text": "- Female patients with a positive pregnancy test.",
              "Observation": [
                "pregnancy test"
              ],
              "Condition": [
                "pregnancy"
              ]
            }
          }
        }
      }
    },
    "right": {
      "raw_text": ""
    }
  }
}
