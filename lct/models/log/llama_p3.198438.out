                         ]\n                                    }\n                                  }\n                                },\n                                "right": {\n                                  "AND": {\n                                    "left": {\n                                      "raw_text": "-"\n                                    },\n                                    "right": {\n                                      "NOT": {\n                                        "left": {\n                                          "AND": {\n                                            "left": {\n                                              "raw_text": "Inability to sit steady",\n                                              "Condition": [\n                                                "sit steady"\n                                              ]\n                                            },\n                                            "right": {\n                                              "raw_text": "and upright for the Optical Coherence Tomography (OCT)."\n                                            }\n                                          }\n                                        }\n                                      }\n                                    }\n                                  }\n                                }\n                              }\n                            },\n                            "right": {\n                              "OR": {\n                                "left": {\n                                  "raw_text": "- Complications during surgery, including posterior capsular rupture,",\n                                  "Condition": [\n                                    "posterior capsular rupture"\n                                  ]\n                                },\n                                "right": {\n                                  "OR": {\n                          