                      "antihypertensive therapy"\n                              ]\n                            }\n                          }\n                        }\n                      }\n                    },\n                    "right": {\n                      "raw_text": "- Thrombocytopenia (<100,000 platelets/microL)",\n                      "Condition": [\n                        "Thrombocytopenia"\n                      ]\n                    }\n                  }\n                },\n                "right": {\n                  "OR": {\n                    "left": {\n                      "raw_text": "- Renal abnormality (Progressive renal insufficiency (serum creatinine >1.1 mg/dL",\n                      "Condition": [\n                        "renal insufficiency",\n                        "Renal abnormality"\n                      ],\n                      "Observation": [\n                        "serum creatinine"\n                      ]\n                    },\n                    "right": {\n                      "raw_text": "or doubling of serum creatinine concentration in the absence of other renal disease))",\n                      "Observation": [\n                        "serum creatinine concentration"\n                      ],\n                      "Condition": [\n                        "renal disease"\n                      ]\n                    }\n                  }\n                }\n              }\n            },\n            "right": {\n              "raw_text": "- Pulmonary edema",\n              "Condition": [\n                "Pulmonary edema"\n              ]\n            }\n          }\n        },\n        "right": {\n          "AND": {\n            "left": {\n              "raw_text": "15 English-speaking pregnant controls",\n              "Condition": [\n                "pregnant"\n              ]\n            },\n            "right": {\n              "AND": {\n                "left": {\n                  "raw_tex