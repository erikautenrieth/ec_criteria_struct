e included and separated by the logical operators, without omitting any words or information.\n- The output should only contain the JSON object, without any additional text or formatting.\n- Ensure that the JSON output strictly follows these rules and accurately represents the logical structure of the input eligibility criteria.\n\n### Input:\n1. Known allergies to iodides\n2. Known history of coagulopathy\n3. Women who are pregnant or breastfeeding, or for whom possibility of pregnancy was not ruled out\n\n### Response:\n{\n  "AND": {\n    "left": {\n      "AND": {\n        "left": {\n          "raw_text": "1. Known allergies to iodides",\n          "Drug": [\n            "iodides"\n          ]\n        },\n        "right": {\n          "raw_text": "2. Known history of coagulopathy",\n          "Condition": [\n            "coagulopathy"\n          ]\n        }\n      }\n    },\n    "right": {\n      "OR": {\n        "left": {\n          "raw_text": "3. Women who are pregnant",\n          "Condition": [\n            "pregnant"\n          ]\n        },\n        "right": {\n          "OR": {\n            "left": {\n              "raw_text": "or breastfeeding,",\n              "Condition": [\n                "breastfeeding"\n              ]\n            },\n            "right": {\n              "AND": {\n                "left": {\n                  "raw_text": "or for whom possibility of pregnancy",\n                  "Condition": [\n                    "pregnancy"\n                  ]\n                },\n                "right": {\n                  "NOT": {\n                    "left": {\n                      "raw_text": "was not ruled out"\n                    }\n                  }\n                }\n              }\n            }\n          }\n        }\n      }\n    }\n  }\n}<|eot_id|>']
