                                },
                                "right": {
                                  "raw_text": "or any monoclonal antibody for immunomodulation within 6 months prior to first dosing.",
                                  "Drug": [
                                    "monoclonal antibody"
                                  ]
                                }
                              }
                            }
                          }
                        }
                      }
                    },
                    "right": {
                      "OR": {
