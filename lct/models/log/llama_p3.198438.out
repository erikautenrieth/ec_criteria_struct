              }
            },
            "right": {
              "raw_text": "11. Any changes to medication in the preceding month",
              "Drug": [
                "medication"
              ]
            }
          }
        },
        "right": {
          "OR": {
            "left": {
              "raw_text": "12. Patients with hypersensitive to Revestive",
              "Condition": [
