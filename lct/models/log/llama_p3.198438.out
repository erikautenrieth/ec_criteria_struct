                                }
                              }
                            }
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "right": {
          "raw_text": "- patients having preserved their graft > 2 years",
          "Observation": [
            "graft"
          ]
        }
      }
    },
    "right": {
      "raw_text": "- having agreed to the use for research purposes in transplantation of the remains of the DNA and serum samples taken as part of the care of which the remains are available",
