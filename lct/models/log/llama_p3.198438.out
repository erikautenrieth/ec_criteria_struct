     ],\n                  "Condition": [\n                    "medical conditions"\n                  ]\n                },\n                "right": {\n                  "raw_text": "or taking contraindicated medications",\n                  "Drug": [\n                    "medications"\n                  ]\n                }\n              }\n            }\n          }\n        },\n        "right": {\n          "OR": {\n            "left": {\n              "raw_text": "- be pregnant,",\n              "Condition": [\n                "pregnant"\n              ]\n            },\n            "right": {\n              "OR": {\n                "left": {\n                  "raw_text": "nursing,",\n                  "Condition": [\n                    "nursing"\n                  ]\n                },\n                "right": {\n                  "raw_text": "or planning on becoming pregnant during the course of the study.",\n                  "Condition": [\n                    "pregnant"\n                  ]\n                }\n              }\n            }\n          }\n        }\n      }\n    },\n    "right": {\n      "OR": {\n        "left": {\n          "raw_text": "- have any other illness,",\n          "Condition": [\n            "illness"\n          ]\n        },\n        "right": {\n          "OR": {\n            "left": {\n              "raw_text": "condition,",\n              "Condition": [\n                "condition"\n              ]\n            },\n            "right": {\n              "OR": {\n                "left": {\n                  "raw_text": "or use of medications, which in the opinion of the PI and/or admitting physician would",\n                  "Drug": [\n                    "medications"\n                  ]\n                },\n                "right": {\n                  "NOT": {\n                    "left": {\n                      "OR": {\n                        "left": {\n                          "raw_text": "preclude safe"\n       