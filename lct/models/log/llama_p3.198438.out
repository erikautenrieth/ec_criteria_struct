e included and separated by the logical operators, without omitting any words or information.\n- The output should only contain the JSON object, without any additional text or formatting.\n- Ensure that the JSON output strictly follows these rules and accurately represents the logical structure of the input eligibility criteria.\n\n### Input:\n-  azoospermia\n-  smoke\n-  use drugs\n-  use drugs with proven fertility toxicity\n-  exposition to any environmental or occupational toxic substances\n-  exposition to radiation or heat\n-  orchitis secondary to mumps\n-  sexually transmitted diseases\n-  history of cryptorchidism\n-  previous testicular torsion\n-  genitourinary anomalies\n-  alterations of the epididymis or deferens\n-  inguinal surgery\n\n### Response:\n{\n  "AND": {\n    "left": {\n      "AND": {\n        "left": {\n          "AND": {\n            "left": {\n              "AND": {\n                "left": {\n                  "AND": {\n                    "left": {\n                      "AND": {\n                        "left": {\n                          "AND": {\n                            "left": {\n                              "AND": {\n                                "left": {\n                                  "AND": {\n                                    "left": {\n                                      "AND": {\n                                        "left": {\n                                          "AND": {\n                                            "left": {\n                                              "AND": {\n                                                "left": {\n                                                  "raw_text": "- azoospermia",\n                                                  "Condition": [\n                                                    "azoospermia"\n                                                  ]\n                                                },\n                                                "right": {\n                                                  "raw_text": "- smoke",\n                                                  "Observation": [\n                                                    "smoke"\n                                                  ]\n                                                }\n                                              }\n                                            },\n                                            "right": {\n                                              "raw_text": "- use drugs",\n                                              "Drug": [\n                                                "drugs"\n                                              ]\n                                            }\n                                          }\n                                        },\n                                        "right": {\n                                          "raw_text": "- use drugs with proven fertility toxicity",\n                                          "Drug": [\n                                            "drugs"\n                                          ],\n                                          "Condition": [\n                                            "fertility"\n                                          ]\n                                        }\n                                      }\n                                    },\n                                    "right": {\n                                      "OR": {\n                                        "left": {\n                                          "raw_text": "- exposition to any environmental"\n                                        },\n                                        "right": {\n                                          "raw_text": "or occupational toxic substances",\n                                          "Drug": [\n                                            "toxic substances"\n                                          ]\n                                        }\n                                      }\n                                    }\n                                  }\n                                },\n                                "right": {\n                                  "OR": {\n                                    "left": {\n                                      "raw_text": "- exposition to radiation"\n                                    },\n                                    "right": {\n                                      "raw_text": "or heat"\n                                    }\n                                  }\n                                }\n                              }\n                            },\n                            "right": {\n                              "raw_text": "- orchitis secondary to mumps",\n                              "Condition": [\n                                "orchitis",\n                                "mumps"\n                              ]\n                            }\n                          }\n                        },\n                        "right": {\n                          "raw_text": "- sexually transmitted diseases",\n                          "Condition": [\n                            "sexually transmitted diseases"\n                          ]\n                        }\n                      }\n                    },\n                    "right": {\n                      "raw_text": "- history of cryptorchidism",\n                      "Condition": [\n                        "cryptorchidism"\n                      ]\n                    }\n                  }\n                },\n                "right": {\n                  "raw_text": "- previous testicular torsion",\n                  "Condition": [\n                    "testicular torsion"\n                  ]\n                }\n              }\n            },\n            "right": {\n              "raw_text": "- g