e included and separated by the logical operators, without omitting any words or information.\n- The output should only contain the JSON object, without any additional text or formatting.\n- Ensure that the JSON output strictly follows these rules and accurately represents the logical structure of the input eligibility criteria.\n\n### Input:\n- Full term healthy infant aged 3-95 days\n\n### Response:\n{\n"OR": [\n{"OR": [\n{"OR": [\n{"OR": [\n{"OR": [\n{"OR": [\n{"OR": [\n{"OR": [\n{"OR": [\n{"OR": [\n{"OR": [\n{"OR": [\n{"OR": [\n{"OR": [\n{"OR": [\n{"OR": [\n{"OR": [\n{"OR": [\n{"OR": [\n{"OR": [\n{"OR": [\n{"OR": [\n{"OR": [\n{"OR": [\n{"OR": [\n{"OR": [\n{"OR": [\n{"OR": [\n{"OR": [\n{"OR": [\n{"OR": [\n{"OR": [\n{"OR": [\n{"OR": [\n{"OR": [\n{"OR": [\n{"OR": [\n{"OR": [\n{"OR": [\n{"OR": [\n{"OR": [\n{"OR": [\n{"OR": [\n{"OR": [\n{"OR": [\n{"OR": [\n{"OR": [\n{"OR": [\n{"OR": [\n{"OR": [\n{"OR": [\n{"OR": [\n{"OR": [\n{"OR": [\n{"OR": [\n{"OR": [\n{"OR": [\n{"OR": [\n{"OR": [\n{"OR": [\n{"OR": [\n{"OR": [\n{"OR": [\n{"OR": [\n{"OR": [\n{"OR": [\n{"OR": [\n{"OR": [\n{"OR": [\n{"OR": [\n{"OR": [\n{"OR": [\n{"OR": [\n{"OR": [\n{"OR": [\n{"OR": [\n{"OR": [\n{"OR": [\n{"OR": [\n{"OR": [\n{"OR": [\n{"OR": [\n{"OR": [\n{"OR": [\n{"OR": [\n{"OR": [\n{"OR": [\n{"OR": [\n{"OR": [\n{"OR": [\n{"OR": [\n{"OR": [\n{"OR": [\n{"OR": [\n{"OR": [\n{"OR": [\n{"OR": [\n{"OR": [\n{"OR": [\n{"OR": [\n{"OR": [\n{"OR": [\n{"OR": [\n{"OR": [\n{"OR": [\n{"OR": [\n{"OR": [\n{"OR": [\n{"OR": [\n{"OR": [\n{"OR": [\n{"OR": [\n{"OR": [\n{"OR": [\n{"OR": [\n{"OR": [\n{"OR": [\n{"OR": [\n{"OR": [\n{"OR": [\n{"OR": [\n{"OR": [\n{"OR": [\n{"OR": [\n{"OR": [\n{"OR": [\n{"OR": [\n{"OR": [\n{"OR": [\n{"OR": [\n{"OR": [\n{"OR": [\n{"OR": [\n{"OR": [\n{"OR": [\n{"OR": [\n{"OR": [\n{"OR": [\n{"OR": [\n{"OR": [\n{"OR": [\n{"OR": [\n{"OR": [\n{"OR": [\n{"OR": [\n{"OR": [\n{"OR": [\n{"OR": [\n{"OR": [\n{"OR": [\n{"OR": [\n{"OR": [\n{"OR": [\n{"OR": [\n{"OR": [\n{"OR": [\n{"OR": [\n{"OR": [\n{"OR": [\n{"