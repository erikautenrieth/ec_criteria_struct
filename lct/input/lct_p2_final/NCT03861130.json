{
  "AND": {
    "left": {
      "AND": {
        "left": {
          "AND": {
            "left": {
              "AND": {
                "left": {
                  "AND": {
                    "left": {
                      "AND": {
                        "left": {
                          "AND": {
                            "left": {
                              "AND": {
                                "left": {
                                  "AND": {
                                    "left": {
                                      "raw_text": "- Affected children will be recruited if the treating clinician has made a diagnosis of possible Kawasaki disease (even if they do not fulfil the criteria below for Kawasaki disease)."
                                    },
                                    "right": {
                                      "raw_text": "The current standard diagnostic criteria for KD (Circulation 2001 103 335-336 doi: 10.1161/01.CIR 103.2.335) are:"
                                    }
                                  }
                                },
                                "right": {
                                  "AND": {
                                    "left": {
                                      "raw_text": "The presence of fever"
                                    },
                                    "right": {
                                      "raw_text": "for at least five days plus four of the following criteria:"
                                    }
                                  }
                                }
                              }
                            },
                            "right": {
                              "OR": {
                                "left": {
                                  "raw_text": "1. Changes in the peripheral extremities Acute: erythema"
                                },
                                "right": {
                                  "OR": {
                                    "left": {
                                      "raw_text": "and oedema of hands"
                                    },
                                    "right": {
                                      "raw_text": "and feet Convalescent: membranous desquamation of fingertips"
                                    }
                                  }
                                }
                              }
                            }
                          }
                        },
                        "right": {
                          "raw_text": "2. Polymorphous exanthema"
                        }
                      }
                    },
                    "right": {
                      "AND": {
                        "left": {
                          "raw_text": "3. Bilateral painless bulbar conjunctival injection"
                        },
                        "right": {
                          "NOT": {
                            "left": {
                              "raw_text": "without exudate"
                            }
                          }
                        }
                      }
                    }
                  }
                },
                "right": {
                  "OR": {
                    "left": {
                      "raw_text": "4. Changes in lips"
                    },
                    "right": {
                      "OR": {
                        "left": {
                          "raw_text": "and oral cavity: erythema"
                        },
                        "right": {
                          "OR": {
                            "left": {
                              "raw_text": "and cracking of lips,"
                            },
                            "right": {
                              "OR": {
                                "left": {
                                  "raw_text": "strawberry tongue,"
                                },
                                "right": {
                                  "OR": {
                                    "left": {
                                      "raw_text": "diffuse injection of oral"
                                    },
                                    "right": {
                                      "raw_text": "and pharyngeal mucosae"
                                    }
                                  }
                                }
                              }
                            }
                          }
                        }
                      }
                    }
                  }
                }
              }
            },
            "right": {
              "AND": {
                "left": {
                  "raw_text": "5. Cervical lymphadenopathy (>1.5cm diameter), usually unilateral Patients meeting not all of these criteria may meet the criteria for atypical Kawasaki disease, ie. if they have fever"
                },
                "right": {
                  "OR": {
                    "left": {
                      "raw_text": "and two or three of the above criteria and elevation of CRP"
                    },
                    "right": {
                      "raw_text": "or echocardiographic evidence of coronary artery dilatation."
                    }
                  }
                }
              }
            }
          }
        },
        "right": {
          "raw_text": "Parents of affected child must be biological parents."
        }
      }
    },
    "right": {
      "NOT": {
        "left": {
          "AND": {
            "left": {
              "raw_text": "- children who do"
            },
            "right": {
              "NOT": {
                "left": {
                  "raw_text": "not have a diagnosis of possible Kawasaki disease"
                }
              }
            }
          }
        }
      }
    }
  }
}