{
  "inclusion_criteria": [
    {
      "and": [
        {
          "disease": "adenocarcinoma of the prostate",
          "attributes": {
            "confirmation": ["histologically", "cytologically"],
            "metastasis": "bone",
            "detection_methods": ["CT", "MRI", "bone scan"]
          }
        },
        {
          "treatment": "androgen deprivation therapy",
          "attributes": {
            "start_timeframe": "<= 30 days"
          }
        }
      ]
    },
    {
      "optional": true,
      "treatment": "palliative radiation therapy",
      "attributes": {
        "timeframe": "<= 4 weeks",
        "discretion": "investigator"
      }
    }
  ],
  "exclusion_criteria": [
    {
      "not": {
        "disease_type": ["neuroendocrine", "small cell", "transitional cell cancer of the prostate"]
      }
    },
    {
      "not": {
        "condition": ["abnormal bone metabolism"],
        "specific_conditions": ["Paget's disease", "untreated hyperthyroidism", "untreated hyperprolactinemia", "untreated Cushing's disease"]
      }
    },
    {
      "not": {
        "medication": "calcitonin",
        "timeframe": "< 14 days"
      }
    },
    {
      "not": {
        "medication_history": "bisphosphonates",
        "attributes": {
          "previous_use": "any"
        }
      }
    },
    {
      "not": {
        "procedure": "major surgery",
        "timeframe": "< 4 weeks"
      }
    },
    {
      "not": {
        "treatment": "adjuvant chemotherapy",
        "timeframe": "< 6 months"
      }
    },
    {
      "not": {
        "treatment": "chemotherapy",
        "attributes": {
          "for": "metastatic disease",
          "previous": true
        }
      }
    },
    {
      "not": {
        "treatment": "hormonal therapy",
        "attributes": {
          "setting": "adjuvant",
          "timeframe": "< 12 months",
          "duration": "<= 6 months"
        }
      }
    },
    {
      "not": {
        "history_of": "malignancy",
        "timeframe": "< 5 years",
        "exceptions": ["basal cell carcinoma of the skin", "squamous cell carcinoma of the skin"]
      }
    },
    {
      "not": {
        "history_of": "allergy or drug reactions",
        "to": ["bisphosphonates"]
      }
    }
  ]
}
