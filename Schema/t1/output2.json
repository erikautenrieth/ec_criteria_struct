{
  "InclusionCriteria": {
    "AND": [
      {
        "condition": "Histologically or cytologically confirmed adenocarcinoma of the prostate"
      },
      {
        "AND": [
          {
            "condition": "Metastatic bone disease",
            "verificationMethod": ["CT", "MRI", "bone scan"]
          },
          {
            "OR": [
              {
                "condition": "Plans to start androgen deprivation therapy within 30 days"
              },
              {
                "condition": "Already started androgen deprivation therapy",
                "timeframe": "< 30 days"
              }
            ]
          }
        ]
      },
      {
        "OR": [
          {
            "condition": "Eligible for palliative radiation therapy",
            "timeframe": "first 4 weeks of protocol therapy",
            "discretion": "investigators"
          },
          {
            "NOT": {
              "condition": "Lymph node or visceral metastases only"
            }
          }
        ]
      }
    ]
  },
  "ExclusionCriteria": {
    "AND": [
      {
        "NOT": {
          "condition": "Types of cancer",
          "types": ["neuroendocrine", "small cell", "transitional cell"]
        }
      },
      {
        "NOT": {
          "condition": "Abnormal bone metabolism conditions",
          "types": ["Paget's disease", "untreated hyperthyroidism", "untreated hyperprolactinemia", "untreated Cushing's disease"]
        }
      },
      {
        "NOT": {
          "condition": "Recent use of calcitonin",
          "timeframe": "< 14 days before registration"
        }
      },
      {
        "NOT": {
          "condition": "Previous use of bisphosphonates"
        }
      },
      {
        "NOT": {
          "condition": "Major surgery",
          "timeframe": "< 4 weeks of registration"
        }
      },
      {
        "NOT": {
          "condition": "Adjuvant chemotherapy",
          "timeframe": "< 6 months of registration"
        }
      },
      {
        "NOT": {
          "condition": "Previous chemotherapy for metastatic disease"
        }
      },
      {
        "NOT": {
          "condition": "Hormonal therapy in adjuvant setting",
          "restrictions": {
            "timeframe": "< 12 months of registration",
            "duration": "not exceed 6 months"
          }
        }
      },
      {
        "NOT": {
          "condition": "Prior history of malignancy",
          "timeframe": "< 5 years",
          "exceptions": ["basal cell carcinoma of the skin", "squamous cell carcinoma of the skin"]
        }
      },
      {
        "NOT": {
          "condition": "History of allergy or drug reactions",
          "specifics": ["bisphosphonates"]
        }
      }
    ]
  }
}
