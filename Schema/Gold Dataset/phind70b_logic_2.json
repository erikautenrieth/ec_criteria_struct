{
  "inclusionCriteria": [
    {
      "id": "1",
      "condition": "Overweight or obese subjects",
      "subConditions": [
        {
          "id": "1.1",
          "condition": "according to body mass index (BMI)"
        }
      ]
    },
    {
      "id": "2",
      "condition": "Fasting plasma glucose value between 100 and 125 mg/dl",
      "subConditions": [
        {
          "id": "2.1",
          "condition": "with impaired fasting glucose or impaired glucose tolerance confirmed with oral glucose tolerance test (OGTT)"
        }
      ]
    },
    {
      "id": "3",
      "condition": "Total cholesterol values ≥ 200 mg/dl"
    }
  ],
  "exclusionCriteria": [
    {
      "id": "4",
      "condition": "Patients with neoplastic and liver diseases, renal failure",
      "subConditions": [
        {
          "id": "4.1",
          "condition": "Patients with neoplastic diseases"
        },
        {
          "id": "4.2",
          "condition": "Patients with liver diseases"
        },
        {
          "id": "4.3",
          "condition": "Patients with renal failure"
        }
      ]
    },
    {
      "id": "5",
      "condition": "Patients with type 1 or 2 diabetes mellitus",
      "subConditions": [
        {
          "id": "5.1",
          "condition": "Patients with type 1 diabetes mellitus"
        },
        {
          "id": "5.2",
          "condition": "Patients with type 2 diabetes mellitus"
        }
      ]
    },
    {
      "id": "6",
      "condition": "Pregnant or breastfeeding women",
      "subConditions": [
        {
          "id": "6.1",
          "condition": "Pregnant women"
        },
        {
          "id": "6.2",
          "condition": "Breastfeeding women"
        }
      ]
    },
    {
      "id": "7",
      "condition": "Hypersensitivity to any of the ingredients"
    },
    {
      "id": "8",
      "condition": "Therapy with lipid-lowering drugs"
    },
    {
      "id": "9",
      "condition": "Use of products containing red yeast rice"
    }
  ]
}