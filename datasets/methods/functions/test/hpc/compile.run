#!/bin/bash
#SBATCH --output slurm.%N.%j.out     # STDOUT (%N: nodename, %j: job-ID)
#SBATCH --error slurm.%N.%j.err      # STDERR
#SBATCH --partition=gpu              # partition (queue)
#SBATCH --ntasks 30                  # number of tasks/cores
#SBATCH --mem 30000                  # memory per node in MB
#SBATCH --time 1:00:00              # total runtime of job allocation

module load gcc/8.2.0
module load cuda/11.6


eval "$(conda shell.bash hook)"

conda activate unifold

pip install -e .

#conda env create -f environment.yml