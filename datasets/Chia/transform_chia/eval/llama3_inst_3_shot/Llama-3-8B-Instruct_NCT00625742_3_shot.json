{
    "IC": {
        "IC1": {
            "IC1.1": "Are referred to the Cachexia Clinic",
            "IC1.2": "with involuntary weight loss of >5% of their premorbid weight",
            "IC1.3": "within the previous 6 months.",
            "operators": [
                "AND",
                "OR"
            ]
        },
        "IC2": "Are 18 years of age or older",
        "IC3": {
            "IC3.1": "Have a Karnofsky performance score",
            "IC3.2": "of 60 or higher.",
            "operators": [
                "OR"
            ]
        },
        "IC4": "Can maintain oral food intake during the study",
        "IC5": {
            "IC5.1": "Can understand the study procedures",
            "IC5.2": "and",
            "IC5.3": "can sign an informed consent form.",
            "operators": [
                "AND",
                "OR"
            ]
        },
        "IC6": "Are not currently taking melatonin",
        "IC7": {
            "IC7.1": "Are taking megestrol acetate",
            "IC7.2": "and",
            "IC7.3": "continue to lose weight despite at least 2 weeks of therapy.",
            "operators": [
                "AND",
                "OR"
            ]
        },
        "IC8": {
            "IC8.1": "Have a calculated creatinine clearance",
            "IC8.2": "of >/= 60 cc/min.",
            "operators": [
                "OR"
            ]
        }
    },
    "EC": {
        "EC1": {
            "EC1.1": "Have dementia",
            "EC1.2": "or delirium (as determined by the palliative care specialist)",
            "EC1.3": "at study entry.",
            "operators": [
                "OR"
            ]
        },
        "EC2": "Are pregnant",
        "EC3": {
            "EC3.1": "Have been taking corticosteroids",
            "EC3.2": "for longer than 48 hours.",
            "operators": [
                "OR"
            ]
        },
        "EC4": {
            "EC4.1": "Have pulmonary edema",
            "EC4.2": ", ascites",
            "EC4.3": "or pitting edema on clinical examination.",
            "operators": [
                "OR",
                "OR"
            ]
        },
        "EC5": "Are unable to walk",
        "EC6": {
            "EC6.1": "Have a history of serious adverse gastrointestinal events",
            "EC6.2": "(i.e., bleeding or perforation),",
            "EC6.3": "history of a coagulopathy",
            "EC6.4": "or current anti-coagulant use.",
            "operators": [
                "OR",
                "OR",
                "OR"
            ]
        },
        "EC7": {
            "EC7.1": "Have an ALT/AST",
            "EC7.2": ">3x upper limit of normal.",
            "operators": [
                "OR"
            ]
        },
        "EC8": "Patients on methotrexate",
        "EC9": {
            "EC9.1": "Patients taking melatonin receptor agonists",
            "EC9.2": "(such as Rozerem[ramelteon]).",
            "operators": [
                "OR"
            ]
        }
    }
}