{
    "EC": {
        "EC1": "Exclusions Related to Cardiovascular Disease",
        "EC2": "1. History of uncontrolled hypertension",
        "EC3": "2. Persistent hypotension at Screening.",
        "EC4": {
            "EC4.1": "3. Evidence or history of left-sided heart disease",
            "EC4.2": "and/or clinically significant cardiac disease",
            "EC4.3": "in which pulmonary hypertension",
            "EC4.4": "is more likely WHO Group 2.",
            "operators": [
                "OR",
                "OR",
                "AND"
            ]
        },
        "EC5": "4. Acute decompensated heart failure within 1 month of Screening.",
        "EC6": {
            "EC6.1": "5. Recent",
            "EC6.2": "initiation (<8 weeks from Screening) or planned initiation of cardiopulmonary rehabilitation exercise program.",
            "operators": [
                "OR"
            ]
        },
        "EC7": "Exclusions Related to Pulmonary Disease",
        "EC8": {
            "EC8.1": "6. Newly diagnosed with PAH and not",
            "EC8.2": "on PAH-specific therapy.",
            "operators": [
                "OR"
            ]
        },
        "EC9": "7. Pulmonary hypertension due to:",
        "EC10": "1. Uncorrected congenital systemic-to-pulmonary shunt.",
        "EC11": {
            "EC11.1": "2. Pulmonary veno-occlusive disease",
            "EC11.2": "and/or pulmonary capillary hemangiomatosis",
            "operators": [
                "OR"
            ]
        },
        "EC12": "3. Persistent pulmonary hypertension of the newborn",
        "EC13": "4. WHO clinical classification Groups 2-5",
        "EC14": {
            "EC14.1": "8. Evidence of significant airway",
            "EC14.2": "and/or parenchymal lung disease.",
            "operators": [
                "OR"
            ]
        },
        "EC15": {
            "EC15.1": "9. Chronic infection related to tuberculosis",
            "EC15.2": "or fungal",
            "EC15.3": "or mycobacterial disease.",
            "operators": [
                "OR",
                "OR"
            ]
        },
        "EC16": "Exclusions Based on Other Medical Conditions",
        "EC17": {
            "EC17.1": "10. Chronic infections including, but not limited to tuberculosis (TB)",
            "EC17.2": ", hepatitis B virus (HBV)",
            "EC17.3": "or hepatitis C virus (HCV).",
            "operators": [
                "OR",
                "OR"
            ]
        },
        "EC18": {
            "EC18.1": "11. History of portal hypertension",
            "EC18.2": "or chronic liver disease, including positive serology for infection",
            "EC18.3": "with HCV and/or HBV.",
            "operators": [
                "OR",
                "OR"
            ]
        },
        "EC19": "12. Evidence of active infection requiring intravenous or oral antibiotics within 4 weeks of Screening.",
        "EC20": "13. Body mass index ≥35.0 at Screening.",
        "EC21": "14. History of obstructive sleep apnea.",
        "EC22": {
            "EC22.1": "15. History of malignancy within the last 5 years,",
            "EC22.2": "except nonmelanoma skin cancer and cervical carcinoma in situ",
            "EC22.3": "treated with curative intent.",
            "operators": [
                "NOT",
                "NOT",
                "AND"
            ]
        },
        "EC23": {
            "EC23.1": "16. Neuropsychiatric",
            "EC23.2": "disorders",
            "EC23.3": "/symptoms or psychological conditions.",
            "operators": [
                "OR",
                "OR"
            ]
        },
        "EC24": {
            "EC24.1": "17. Pregnancy",
            "EC24.2": "or breast-feeding",
            "operators": [
                "OR"
            ]
        },
        "EC25": {
            "EC25.1": "18. Prior treatment with B cell",
            "EC25.2": "or lymphocyte-depleting agents (eg, rituximab",
            "EC25.3": ", Campath)",
            "operators": [
                "OR",
                "OR"
            ]
        },
        "EC26": "Exclusions Based on Concomitant Medication Use",
        "EC27": "19. Concurrent regular use of another leukotriene pathway inhibitor, including over-the-counter medications or herbal remedies.",
        "EC28": "Exclusions Based on Laboratory Values",
        "EC29": "20. Significant/chronic renal insufficiency.",
        "EC30": "21. Transaminases (alanine transaminase, aspartate transaminase) levels >3 × upper limit of normal (ULN) and/or bilirubin level >2 × ULN.",
        "EC31": "22. Absolute neutrophil count <1500 mm3.",
        "EC32": "23. Hemoglobin concentration <9 g/dL at Screening.",
        "EC33": {
            "EC33.1": "24. Hepatic dysfunction",
            "EC33.2": "as defined by Child-Pugh Class B or C",
            "operators": [
                "AND"
            ]
        }
    }
}