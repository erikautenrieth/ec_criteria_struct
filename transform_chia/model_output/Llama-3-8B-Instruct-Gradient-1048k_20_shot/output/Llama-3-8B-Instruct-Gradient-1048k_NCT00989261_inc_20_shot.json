"{\n  \"AND\": {\n    \"left\": {\n      \"OR\": {\n        \"left\": {\n          \"raw_text\": \"1. Males and females age ≥18 years in second relapse or refractory.\"\n        },\n        \"right\": {\n          \"OR\": {\n            \"left\": {\n              \"raw_text\": \"2. Males and females age ≥60 years in first relapse or refractory.\"\n            }\n          }\n        }\n      },\n    \"right\": {\n      \"AND\": {\n        \"left\": {\n          \"AND\": {\n            \"left\": {\n              \"raw_text\": \"3. Must have baseline bone marrow sample taken.\"\n            },\n            \"right\": {\n              \"AND\": {\n                \"left\": {\n                  \"raw_text\": \"4. Morphologically documented primary AML or AML secondary to myelodysplastic syndrome (MDS with ≥20% bone marrow or peripheral blasts), as defined by the World Health Organization (WHO) criteria, confirmed by pathology review at treating institution.\"\n                }\n            }\n          }\n        },\n        \"right\": {\n          \"AND\": {\n            \"left\": {\n              \"AND\": {\n                \"left\": {\n                  \"raw_text\": \"5. Able to swallow the liquid study drug.\"\n                },\n                \"right\": {\n                  \"AND\": {\n                    \"left\": {\n                      \"raw_text\": \"6. ECOG performance status of 0 to 2\"\n                    },\n                    \"right\": {\n                      \"AND\": {\n                        \"left\": {\n                          \"raw_text\": \"7. In the absence of rapidly progressing disease, the interval from prior treatment to time of AC220 administration will be at least 2 weeks for cytotoxic agents or at least 5 half-lives for noncytotoxic agents. The use of chemotherapeutic or antileukemic agents other than hydroxyurea is not permitted during the study with the possible exception of intrathecal (IT) therapy at the discretion of the Investigator and with the agreement of the Sponsor.\"\n                        }\n                      }\n                    }\n                }\n              }\n            }\n          }\n        },\n        \"right\": {\n          \"AND\": {\n            \"left\": {\n              \"AND\": {\n                \"left\": {\n                  \"raw_text\": \"8. Persistent chronic clinically significant non-hematological toxicities from prior treatment must be ≤Grade 1.\"\n                },\n                \"right\": {\n                  \"AND\": {\n                    \"left\": {\n                      \"raw_text\": \"9. Prior therapy with FLT3 inhibitors is permitted, except previous treatment with AC220.\"\n                    }\n                  }\n                }\n              }\n            }\n          }\n        },\n        \"right\": {\n          \"AND\": {\n            \"left\": {\n              \"AND\": {\n                \"left\": {\n                  \"raw_text\": \"10. Serum creatinine ≤1.5 × ULN and glomerular filtration rate (GFR) > 30 mL/min.\"\n                },\n                \"right\": {\n                  \"AND\": {\n                    \"left\": {\n                      \"raw_text\": \"11. Serum potassium, magnesium, and calcium levels should be at least within institutional normal limits.\"\n                    }\n                  }\n                }\n              }\n            }\n          }\n        },\n        \"right\": {\n          \"AND\": {\n            \"left\": {\n              \"AND\": {\n                \"left\": {\n                  \"raw_text\": \"12. Total serum bilirubin ≤1.5 × ULN.\"\n                },\n                \"right\": {\n                  \"AND\": {\n                    \"left\": {\n                      \"rawtext\": \"13. Serum aspartate transaminase (AST) and/or alanine transaminase (ALT) ≤2.5 × ULN.\"\n                    }\n                  }\n                }\n              }\n            }\n          }\n        },\n        \"right\": {\n          \"AND\": {\n            \"left\": {\n              \"AND\": {\n                \"left\": {\n                  \"rawtext\": \"14. Females of childbearing potential must have a negative pregnancy test (urine β-hCG).\"\n                },\n                \"right\": {\n                  \"AND\": {\n                    \"left\": {\n                      \"rawtext\": \"15. Females of childbearing potential and sexually mature males must agree to use a medically accepted method of contraception throughout the study.\"\n                    }\n                  }\n                }\n              }\n            }\n          }\n        },\n        \"right\": {\n          \"AND\": {\n            \"left\": {\n              \"rawtext\": \"16. Written informed consent must be provided.\"\n            }\n          }\n        }\n      }\n  }\n}"