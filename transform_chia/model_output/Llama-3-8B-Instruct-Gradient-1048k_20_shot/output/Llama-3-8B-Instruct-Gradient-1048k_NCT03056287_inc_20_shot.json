"{\n  \"AND\": {\n    \"left\": {\n      \"OR\": {\n        \"left\": {\n          \"raw_text\": \"1) age 50-70\"\n        },\n        \"right\": {\n          \"OR\": {\n            \"left\": {\n              \"raw_text\": \"2) stroke within the past 6 to 60 months,\"\n            },\n            \"right\": {\n              \"OR\": {\n                \"left\": {\n                  \"raw_text\": \"3) major depressive disorder (PHQ-9 > 10) and diagnosed using the Structured Clinical Interview for Depression (SCID) according to the Diagnostic and Statistical Manual of Mental Disorders, Fourth Edition (DSM-IV),\"\n                },\n                \"right\": {\n                  \"OR\": {\n                    \"left\": {\n                      \"raw_text\": \"4) residual paresis in the lower extremity (Fugl-Meyer LE motor score <34),\"\n                    },\n                    \"right\": {\n                      \"OR\": {\n                        \"left\": {\n                          \"raw_text\": \"5) ability to walk without assistance and without an AFO on the treadmill ≥ 30 seconds at speeds ranging from 0.2-0.8 m/s,\"\n                        },\n                        \"right\": {\n                          \"OR\": {\n                            \"left\": {\n                              \"raw_text\": \"6) no antidepressant medications or clinically able to discontinue medications,\"\n                            },\n                            \"right\": {\n                              \"OR\": {\n                                \"left\": {\n                                  \"raw_text\": \"7) HRSD question #9 regarding suicide <2,\"\n                                },\n                                \"right\": {\n                                  \"OR\": {\n                                    \"left\": {\n                                      \"raw_text\": \"8) provision of informed consent. In addition, all subjects who meet criteria for the training portion must complete an exercise tolerance test and be cleared for participation by the study cardiologist.\"\n                                    }\n                                  }\n                                }\n                            }\n                        }\n                    }\n                }\n            }\n          }\n        }\n      }\n    }\n  }\n}"