"{\n  \"AND\": {\n    \"left\": {\n      \"OR\": {\n        \"left\": {\n          \"raw_text\": \"Decompensated heart failure or hemodynamic instability\"\n        },\n        \"right\": {\n          \"OR\": {\n            \"left\": {\n              \"raw_text\": \"Prior coronary revascularization (PCI or CABG) or myocardial infarction (as evidenced by previously elevated CPK-MB or troponin levels)\"\n            },\n            \"right\": {\n              \"OR\": {\n                \"left\": {\n                  \"raw_text\": \"Accelerating angina or unstable angina\"\n                },\n                \"right\": {\n                  \"OR\": {\n                    \"left\": {\n                      \"raw_text\": \"Inability to physically tolerate MRI or implanted objects that are MRI incompatible\"\n                    },\n                    \"right\": {\n                      \"OR\": {\n                        \"left\": {\n                          \"raw_text\": \"Inability to provide written informed consent obtained at time of study enrollment.\"\n                        },\n                        \"right\": {\n                          \"OR\": {\n                            \"left\": {\n                              \"raw_text\": \"Severe claustrophobia\"\n                            },\n                            \"right\": {\n                              \"OR\": {\n                                \"left\": {\n                                  \"raw_text\": \"Advanced heart block or sinus node dysfunction\"\n                                },\n                                \"right\": {\n                                  \"OR\": {\n                                    \"raw_text\": \"Hypersensitivity or allergic reaction to regadenoson or adenosine\"\n                                    },\n                                    \"right\": {\n                                      \"OR\": {\n                                        \"left\": {\n             