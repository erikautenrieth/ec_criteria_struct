"{\n  \"AND\": {\n    \"left\": {\n      \"OR\": {\n        \"left\": {\n          \"raw_text\": \"diagnosed with PD by a neurologist (Fahn and Elton, 1987)\"}\n        },\n        \"right\": {\n          \"AND\": {\n            \"left\": {\n              \"OR\": {\n                \"left\": {\n                  \"raw_text\": \"aged 30 to 85 years\"}\n                },\n                \"right\": {\n                  \"OR\": {\n                    \"left\": {\n                      \"raw_text\": \"and at modified Hoehn and Yahr (H&Y) stage 1.5 to 3 (Hoehn and Yahr,1967; Goetz et al., 2004)\"}\n                    }\n                }\n            },\n            \"right\": {\n              \"AND\": {\n                \"OR\": {\n                  \"left\": {\n                    \"raw_text\": \"able and willing to give written consent for participation in the study\"}\n                },\n                \"right\": {\n                  \"OR\": {\n                    \"left\": {\n                      \"raw_text\": \"and living at home in the community\"}\n                }\n            },\n            \"right\": {\n              \"AND\": {\n                \"OR\": {\n                  \"left\": {\n                    \"raw_text\": \"and able to walk independently for 30 metres with or without an assistive device\"}\n                }\n            }\n          }\n        }\n      }\n    }\n  }\n}"