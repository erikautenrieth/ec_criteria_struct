"{\n  \"AND\": {\n    \"left\": {\n      \"AND\": {\n        \"left\": {\n          \"raw_text\": \"Women who are in their first 5 years of menopause\"\n        },\n        \"right\": {\n          \"AND\": {\n            \"left\": {\n              \"AND\": {\n                \"left\": {\n                  \"raw_text\": \"Have a T score between -1 and -2.49 at the femoral neck, total hip, or L1-L4 spine\"\n                },\n                \"right\": {\n                  \"raw_text\": \"or L1-L4 spine\"\n                }\n              }\n            },\n            \"right\": {\n              \"AND\": {\n                \"raw_text\": \"Be 19 years of age or older\"\n              }\n            }\n          }\n        },\n        \"right\": {\n          \"AND\": {\n            \"raw_text\": \"Have their health care provider's permission to enroll in the study.\"\n          }\n        }\n      }\n    }\n  }\n}"