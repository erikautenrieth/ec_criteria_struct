"{\n  \"AND\": {\n    \"left\": {\n      \"OR\": {\n        \"left\": {\n          \"raw_text\": \"Person is under 18 years of age.\"\n        },\n        \"right\": {\n          \"OR\": {\n            \"left\": {\n              \"raw_text\": \"Person who weighs more than 136kg.\"\n            },\n            \"right\": {\n              \"OR\": {\n                \"left\": {\n                  \"raw_text\": \"Person who weighs less than 50kg.\"\n                },\n                \"right\": {\n                  \"OR\": {\n                    \"left\": {\n                      \"raw_text\": \"Person who is pregnant.\"\n                    },\n                    \"right\": {\n                      \"OR\": {\n                        \"left\": {\n                          \"raw_text\": \"Person has a history of chronic skin breakdown on the residual limb.\"\n                        },\n                        \"right\": {\n                          \"OR\": {\n                            \"left\": {\n                              \"raw_text\": \"Person has conditions that would prevent participation and pose increased risk (e.g. unstable cardiovascular conditions that preclude physical activity such as walking).\"\n                            },\n                            \"right\": {\n                              \"OR\": {\n                                \"left\": {\n                                  \"raw_text\": \"Person falls = once a week due to the reasons that could not be corrected by the new prosthesis (for ex. problems with vestibular system).\"\n                                },\n                                \"right\": {\n                                  \"OR\": {\n                                    \"left\": {\n                                      \"raw_text\": \"Person is using under arm axillary crutches or walker.\"\n                                    },\n                                    \"right\": {\n                                      