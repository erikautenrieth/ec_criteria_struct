"{\n  \"AND\": {\n    \"left\": {\n      \"OR\": {\n        \"left\": {\n          \"raw_text\": \"Genotype 2, 3, 5 or 6 infection.\"\n        },\n        \"right\": {\n          \"AND\": {\n            \"left\": {\n              \"raw_text\": \"Decompensated cirrhosis defined by the presence of actual or previous history of clinical decompensation including ascites, hepatic encephalopathy, variceal bleeding or spontaneous bacterial peritonitis, or a Child-Pugh B or C.\"\n            },\n            \"right\": {\n              \"AND\": {\n                \"left\": {\n                  \"raw_text\": \"Hepatocellular carcinoma after liver transplantation.\"\n                },\n                \"right\": {\n                  \"AND\": {\n                    \"left\": {\n                      \"raw_text\": \"Total bilirubin > 3 mg/dL.\"\n                    },\n                    \"right\": {\n                      \"AND\": {\n                        \"left\": {\n                          \"raw_text\": \"Immunosuppression with cyclosporine or an mTOR inhibitor (everolimus or sirolimus).\"\n                        },\n                        \"right\": {\n                          \"AND\": {\n                            \"left\": {\n                              \"raw_text\": \"Severe extrahepatic diseases: cardiovascular, respiratory, cerebrovascular and poorly controlled diabetes.\"\n                            },\n                            \"right\": {\n                              \"AND\": {\n                                \"left\": {\n                                  \"raw_text\": \"Platelets < 75 x 109 cells/L.\"\n                                },\n                                \"right\": {\n                                  \"AND\": {\n                                    \"raw_text\": \"Neutrophil count < 0.5 x 109 cells/L.\"\n                                    },\n                                    \"right\": {\n                                      \"AND\": {\n                                        \"raw_text\": \"Hemoglobin < 9 g/dL.\"\n                                        },\n                                        \"right\": {\n                                          \"AND\": {\n                                            \"raw_text\": \"Albumin < 3g/dL.\"\n                                            },\n                                            \"right\": {\n                                              \"AND\": {\n                                                \"raw text\": \"HIV infection.\"\n                                                },\n                                                \"right\": {\n                                                  \"AND\": {\n                                                    \"raw text\": \"Hepatitis B infection.\"\n                                                    },\n                                                    \"right\": {\n                                                      \"AND\": {\n                                                        \"raw text\": \"Active intake of toxic amounts of alcohol or recreational drugs.\"\n                                                        },\n                                                        \"right\": {\n                                                          \"AND\": {\n                                                            \"raw text\": \"Females who are pregnant, become to be pregnant or breastfeeding or males whose partners are pregnant, become to be pregnant or breastfeeding.\"\n                                                            },\n                                                            \"right\": {\n                                                              \"AND\": {\n                                                                \"raw text\": \"Intake of disallowed medications including (but not limited to): 1. Antibiotics: clarithromycin, erythromycin, telithromycin, nafcillin, rifampin 2. Antifungals: itraconazole, ketoconazole, voriconazole 3. Antihypertensives: nifedipine 4. Anticonvulsants: carbamazepine, phenytoin, phenobarbital 5. Bosentan 6. Modafinil 7. St.Jonh's Wort 8. Immunosuppressants: cyclosporin, everolimus, sirolimus 9. Diabetes agents: glibenclamide, glyburide 10. Lipid lowering agents: gemfibrozil 11. Eltrombopag 12. Lapatinib 13. HIV medications: efavirenz, etravirine, all ritonavir boosted and unboosted HIV protease inhibitors 14. Statins: simvastatin, fluvastatin, rosuvastatin at doses greater than 10 mg/d, atorvastatin at doses greater than 10 mg/d.\"\n                                                            }\n                                                          }\n                                                      }\n                                                  }\n                                                }\n                                              }\n                                            }\n                                          }\n                                        }\n                                      }\n                                    }\n                                  }\n                                }\n                              }\n                            }\n                          }\n                        }\n                      }\n                    }\n                  }\n                }\n              }\n            }\n          }\n        }\n      }\n    }\n  }\n}"