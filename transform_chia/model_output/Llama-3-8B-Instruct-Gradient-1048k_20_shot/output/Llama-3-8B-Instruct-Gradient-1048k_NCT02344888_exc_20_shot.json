"{\n  \"AND\": {\n    \"left\": {\n      \"OR\": {\n        \"left\": {\n          \"raw_text\": \"Age < 20 or > 35 years.\"\n        },\n        \"right\": {\n          \"OR\": {\n            \"left\": {\n              \"raw_text\": \"Body mass index (BMI) < 18.5 kg/m2 or > 25 kg/m2.\"\n            },\n            \"right\": {\n              \"OR\": {\n                \"left\": {\n                  \"raw_text\": \"Presence of any infertility factor other than anovulatory PCOS.\"\n                },\n                \"right\": {\n                  \"OR\": {\n                    \"left\": {\n                      \"raw_text\": \"Previous history of ovarian surgery or surgical removal of one ovary.\"\n                    },\n                    \"right\": {\n                      \"OR\": {\n                        \"left\": {\n                          \"raw_text\": \"Previous exposure to cytotoxic drugs or pelvic irradiation.\"\n                        },\n                        \"right\": {\n                          \"OR\": {\n                            \"left\": {\n                              \"raw_text\": \"Oral hypoglycemic or hormonal therapy either currently or in the preceding 3 months.\"\n                            },\n                            \"right\": {\n                              \"OR\": {\n                                \"left\": {\n                                  \"raw_text\": \"Metabolic or hormonal abnormalities.\"\n                                }\n                              }\n                            }\n                          }\n                        }\n                    }\n                }\n              }\n            }\n          }\n        }\n      }\n    }\n  }\n}"