"{\n  \"AND\": {\n    \"left\": {\n      \"AND\": {\n        \"left\": {\n          \"raw_text\": \"Lifetime personal history of diagnosis of major depressive disorder according to the DSM-V (American Psychiatric Association, 2013) using the Structured Clinical Interview for DSM-V Axis I Disorders, Research Version, Non-patient Edition (SCID-5-RV for DSM-V; First et al., 2015)\"\n        },\n        \"right\": {\n          \"AND\": {\n            \"left\": {\n              \"raw_text\": \"A history of suicidal ideation and behaviour, including self-harm and/or harm to others.\"\n            },\n            \"right\": {\n              \"AND\": {\n                \"left\": {\n                  \"OR\": {\n                    \"left\": {\n                      \"raw_text\": \"A history of substance abuse and/or dependence.\"\n                    },\n                    \"right\": {\n                      \"OR\": {\n                        \"left\": {\n                          \"raw_text\": \"A positive drug screen for illicit drugs\"\n                        }\n                      }\n                    }\n                  }\n                }\n              }\n            },\n            \"right\": {\n              \"AND\": {\n                \"left\": {\n                  \"OR\": {\n                    \"left\": {\n                      \"raw_text\": \"Substantial alcohol use\"\n                    },\n                    \"right\": {\n                      \"OR\": {\n                        \"left\": {\n                          \"raw_text\": \"Current use of Monoamine Oxidase Inhibitors (MAOIs), including the antibiotic linezolid and the thiazine dye methylthioninium chloride (methylene blue)\"\n                        }\n                      }\n                    }\n                  }\n                }\n              }\n            },\n            \"right\": {\n              \"AND\": {\n                \"left\": {\n                  \"OR\": {\n                    \"left\": {\n                      \"raw_text\": \"Current use of serotonin-precursors (such as L-tryptophan, oxitriptan)\"\n                    },\n                    \"right\": {\n                      \"OR\": {\n                        \"raw_text\": \"Current use of serotonergic drugs (triptans, certain tricyclic antidepressants, lithium, tramadol, St. John's Wort)\"\n                    }\n                  }\n                }\n              }\n            },\n            \"right\": {\n              \"AND\": {\n                \"left\": {\n                  \"OR\": {\n                    \"left\": {\n                      \"raw text\": \"Concomitant use of NSAIDS, ASA, and other anticoagulants.\"\n                    },\n                    \"right\": {\n                      \"OR\": {\n                        \"left\": {\n                          \"raw text\": \"Current use of Thioridazine.\"\n                        }\n                      }\n                    }\n                  }\n                }\n              }\n            },\n            \"right\": {\n              \"AND\": {\n                \"left\": {\n                  \"OR\": {\n                    \"left\": {\n                      \"raw text\": \"Current use of CYP1A2 Inhibitors.\"\n                    },\n                    \"right\": {\n                      \"OR\": {\n                        \"raw text\": \"Current use of Triptans (5HT1 Agonists)\"\n                    }\n                  }\n                }\n              }\n            },\n            \"right\": {\n              \"AND\": {\n                \"left\": {\n                  \"OR\": {\n                    \"left\": {\n                      \"raw text\": \"Blood pressure greater than 140/90 and/or a pulse rate greater than 90 bpm.\"\n                    },\n                    \"right\": {\n                      \"OR\": {\n                        \"raw text\": \"Recent history of myocardial infarction, cerebrovascular accident, cardiac arrhythmias, or unstable heart disease.\"\n                    }\n                  }\n                }\n              }\n            },\n            \"right\": {\n              \"AND\": {\n                \"left\": {\n                  \"OR\": {\n                    \"left\": {\n                      \"raw text\": \"Evidence of significant physical illness contraindicating the use of levomilnacipran and duloxetine found on the physical exam or in the laboratory data obtained during the first week of the study.\"\n                    },\n                    \"right\": {\n                      \"OR\": {\n                        \"raw text\": \"Current use of medication that may affect voiding (ie- anticholinergics)\"\n                    }\n                  }\n                }\n              }\n            },\n            \"right\": {\n              \"AND\": {\n                \"left\": {\n                  \"OR\": {\n                    \"left\": {\n                      \"raw text\": \"History of obstructive urinary disorders and dysuria, prostatic hypertrophy, prostatitis, and other lower urinary tract obstructive disorders.\"\n                    },\n                    \"right\": {\n                      \"OR\": {\n                        \"raw text\": \"History of Stevens-Johnson Syndrome and Erythema multiforme.\"\n                    }\n                  }\n                }\n              }\n            },\n            \"right\": {\n              \"AND\": {\n                \"left\": {\n                  \"OR\": {\n                    \"left\": {\n                      \"raw text\": \"Diabetes Type I and II.\"\n                    },\n                    \"right\": {\n                      \"OR\": {\n                        \"raw text\": \"Fructose intolerance, glucose-galactose malabsorption or sucrose-isomaltase insufficiency.\"\n                    }\n                  }\n                }\n              }\n            },\n            \"right\": {\n              \"AND\": {\n                \"left\": {\n                  \"OR\": {\n                    \"left\": {\n                      \"raw text\": \"Hepatic Impairment.\"\n                    },\n                    \"right\": {\n                      \"OR\": {\n                        \"raw text\": \"Uncontrolled narrow-angle glaucoma.\"\n                    }\n                  }\n                }\n              }\n            },\n            \"right\": {\n              \"AND\": {\n                \"left\": {\n                  \"OR\": {\n                    \"left\": {\n                      \"raw text\": \"Severe renal impairment.\"\n                    },\n                    \"right\": {\n                      \"OR\": {\n                        \"raw text\": \"History of seizure disorder.\"\n                    }\n                  }\n                }\n              }\n            },\n            \"right\": {\n              \"AND\": {\n                \"left\": {\n                  \"OR\": {\n                    \"left\": {\n                      \"raw text\": \"Anatomically narrow ocular angles.\"\n                    },\n                    \"right\": {\n                      \"OR\": {\n                        \"raw text\": \"Osteoporosis or major risk for bone fractures.\"\n                    }\n                  }\n                }\n              }\n            }\n          }\n      }\n    }\n  }\n}"