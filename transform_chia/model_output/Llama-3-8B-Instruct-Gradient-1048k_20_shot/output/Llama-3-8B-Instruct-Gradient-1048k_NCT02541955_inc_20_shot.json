"{\n  \"AND\": {\n    \"left\": {\n      \"raw_text\": \"Patient must meet 1987 ACR criteria\"\n    },\n    \"right\": {\n      \"AND\": {\n        \"left\": {\n          \"raw_text\": \"Age > 18 years of age\"\n        },\n        \"right\": {\n          \"AND\": {\n            \"left\": {\n              \"OR\": {\n                \"left\": {\n                  \"raw_text\": \"Baseline DAS28/Erythrocyte Sedimentation Rate (ESR) >=3.2\"\n                },\n                \"right\": {\n                  \"raw_text\": \"(Note: DAS28 should be measured within 2 weeks of baseline visit)\"\n                }\n              }\n            },\n            \"right\": {\n              \"AND\": {\n                \"left\": {\n                  \"raw_text\": \"Stable concomitant Disease Modifying Anti-Rheumatic Drugs (DMARDs)\"\n                },\n                \"right\": {\n                  \"raw_text\": \"(Note: DMARDs should be stable for at least 4 weeks prior to baseline visit)\"\n                }\n              }\n            },\n            \"right\": {\n              \"AND\": {\n                \"left\": {\n                  \"raw_text\": \"Stable prednisone <10mg or equivalent\"\n                },\n                \"right\": {\n                  \"raw_text\": \"(Note: Prednisone dose should be stable for at least 4 weeks prior to baseline visit)\"\n                }\n              }\n            },\n            \"right\": {\n              \"AND\": {\n                \"left\": {\n                  \"OR\": {\n                    \"left\": {\n                      \"raw_text\": \"Power Doppler score of >=10\"\n                    },\n                    \"right\": {\n                      \"raw_text\": \"(Note: Power Doppler score should be measured within 2 weeks of baseline visit)\"\n                    }\n                  }\n                }\n              }\n            }\n          }\n        }\n      }\n    }\n  }\n}"