"{\n  \"AND\": {\n    \"left\": {\n      \"OR\": {\n        \"left\": {\n          \"raw_text\": \"19 years old and above.\"\n        },\n        \"right\": {\n          \"AND\": {\n            \"left\": {\n              \"OR\": {\n                \"left\": {\n                  \"raw_text\": \"Patients who previously have received a liver transplant over the last six months and within last three years.\"\n                },\n                \"right\": {\n                  \"OR\": {\n                    \"left\": {\n                      \"raw_text\": \"Patients who are on Tacrolimus immunosuppressive therapy twice a day for at least two weeks.\"\n                    },\n                    \"right\": {\n                      \"AND\": {\n                        \"left\": {\n                          \"raw_text\": \"Patients who have normal liver function and renal function.\"\n                        },\n                        \"right\": {\n                          \"AND\": {\n                            \"left\": {\n                              \"raw_text\": \"Patients who have been monitored without complication such as acute rejection.\"\n                            },\n                            \"right\": {\n                              \"AND\": {\n                                \"left\": {\n                                  \"raw_text\": \"Patients willing to sign his/her consent.\"\n                                }\n                              }\n                            }\n                          }\n                        }\n                      }\n                    }\n                }\n              }\n            }\n          }\n        }\n      }\n    }\n  }\n}"