"{\n  \"AND\": {\n    \"left\": {\n      \"OR\": {\n        \"left\": {\n          \"raw_text\": \"Any concomitant cardiovascular procedure to CABG (i.e. valve, aortic or carotid surgery)\"\n        },\n        \"right\": {\n          \"OR\": {\n            \"left\": {\n              \"raw_text\": \"Acute ST-segment-elevation myocardial infarction (STEMI)\"\n            },\n            \"right\": {\n              \"OR\": {\n                \"left\": {\n                  \"raw_text\": \"NSTE-ACS with cardiogenic shock warranting emergent salvage surgery within 12 hrs from hospital admission\"\n                },\n                \"right\": {\n                  \"OR\": {\n                    \"left\": {\n                      \"raw_text\": \"History of atrial fibrillation or muscle disease (myopathy)\"\n                    },\n                    \"right\": {\n                      \"OR\": {\n                        \"left\": {\n                          \"raw_text\": \"Current renal (creatinine>2x upper limit of normal (ULN), dialysis, kidney transplant) or hepatic dysfunction (AST/ALT>2x ULN, liver transplant or neoplasm)\"\n                        },\n                        \"right\": {\n                          \"OR\": {\n                            \"left\": {\n                              \"raw_text\": \"Inability of oral drug intake\"\n                            }\n                          }\n                        }\n                      }\n                    }\n                }\n              }\n            }\n          }\n        }\n      }\n    }\n  }\n}"