"{\n  \"AND\": {\n    \"left\": {\n      \"AND\": {\n        \"left\": {\n          \"raw_text\": \"Men or non-pregnant women of any ethnic background between the age of 18 and 45 years old\"\n        },\n        \"right\": {\n          \"AND\": {\n            \"left\": {\n              \"OR\": {\n                \"left\": {\n                  \"raw_text\": \"Subjects must be non-smokers (must have refrained from the use of nicotine-containing substances, including tobacco products (e.g. cigarettes, cigars, chewing tobacco, gum, patch or electronic cigarettes) over the previous 2 months and are not currently using tobacco products\"\n                },\n                \"right\": {\n                  \"AND\": {\n                    \"left\": {\n                      \"raw_text\": \"Provide written informed consent before initiation of any study procedures\"\n                    },\n                    \"right\": {\n                      \"AND\": {\n                        \"left\": {\n                          \"raw_text\": \"Available for follow-up for the planned duration of the study\"\n                        },\n                        \"right\": {\n                          \"AND\": {\n                            \"left\": {\n                              \"raw_text\": \"Able to communicate well with the investigators\"\n                            },\n                            \"right\": {\n                              \"AND\": {\n                                \"left\": {\n                                  \"raw_text\": \"Able to adhere to the study protocol schedule, study restrictions and examination schedule\"\n                                },\n                                \"right\": {\n                                  \"AND\": {\n                                    \"left\": {\n                                      \"raw_text\": \"Subjects who are within their ideal body weight (BMI between >17 and =28 kg/m2)\"\n                                    },\n                                    \"right\": {\n                                      \"AND\": {\n                                        \"left\": {\n                                          \"raw_text\": \"Subjects deemed to be healthy as judged by the Medically Accountable Investigator (MAI) and determined by medical history, physical examination and medication history\"\n                                        },\n                                        \"right\": {\n                                          \"AND\": {\n                                            \"left\": {\n                                              \"raw_text\": \"Subjects have no history of the following: ongoing acute or intermittent pain, postoperative pain, respiratory compromise, acute or severe asthma, or constipation (less than 1 bowel movement every 2 days)\"\n                                            }\n                                          }\n                                        }\n                                      }\n                                  }\n                                }\n                            }\n                        }\n                    }\n                }\n              }\n            },\n            \"right\": {\n              \"AND\": {\n                \"left\": {\n                  \"OR\": {\n                    \"left\": {\n                      \"raw_text\": \"Female subjects must be of non-childbearing potential (as defined as surgically sterile [i.e. history of hysterectomy or tubal ligation] or postmenopausal for more than 1 year [no bleeding for 12 consecutive months], or if of childbearing potential must be non-pregnant at the time of enrollment and on the morning of the first day of each study session, and must agree to use hormonal or barrier birth control such as implants, injectables, combined oral contraceptives, some intrauterine devices (IUDs), sexual abstinence or a vasectomized parter\"\n                },\n                \"right\": {\n                  \"AND\": {\n                    \"raw_text\": \"Agrees not to participate in another clinical study/trial during the study period or to participate in an investigational drug study for at least one month after last study session\"\n                },\n                \"right\": {\n                  \"AND\": {\n                    \"raw_text\": \"Agrees not to donate blood to a blood bank throughout participation in the study and for at least 3 months after last study day\"\n                },\n                \"right\": {\n                  \"AND\": {\n                    \"raw_text\": \"Have a normal ECG; must not have the following to be acceptable: pathologic Q wave abnormalities, significant ST-T wave changes, left ventricular hypertrophy, right bundle branch block, left bundle branch block. (sinus rhythm is between 55-100 beats per minute)\"\n                },\n                \"right\": {\n                  \"AND\": {\n                    \"left\": {\n                      \"raw_text\": \"Temperature 35-37.9°C (95-100.3°F)\"\n                    },\n                    \"right\": {\n                      \"AND\": {\n                        \"left\": {\n                          \"raw_text\": \"Systolic blood pressure 90-140 mmHg\"\n                        },\n                        \"right\": {\n                          \"AND\": {\n                            \"left\": {\n                              \"raw_text\": \"Diastolic blood pressure 60-90 mmHg\"\n                            },\n                            \"right\": {\n                              \"AND\": {\n                                \"left\": {\n                                  \"raw_text\": \"Heart rate 55-100 beats per minute\"\n                                },\n                                \"right\": {\n                                  \"AND\": {\n                                    \"raw text\": \"Respiration rate 12-18 breaths per minute\"}\n                                  }\n                                }\n                            }\n                        }\n                    }\n                }\n              }\n            }\n          }\n      }\n  }\n}"