"{\n  \"AND\": {\n    \"left\": {\n      \"AND\": {\n        \"left\": {\n          \"raw_text\": \"Adequate performance status:\"\n        },\n        \"right\": {\n          \"AND\": {\n            \"left\": {\n              \"raw_text\": \"Breast - Karnofsky score > 50;\"\n            },\n            \"right\": {\n              \"AND\": {\n                \"left\": {\n                  \"raw_text\": \"Ovarian, endometrial or cervical - Gynecologic Oncology Group (GOG) performance score ≤2\"\n                },\n                \"right\": {\n                  \"AND\": {\n                    \"left\": {\n                      \"raw_text\": \"If female and of childbearing potential, are willing to use adequate contraception (hormonal, barrier method, abstinence) prior to study entry and for the duration of study participation.\"\n                    },\n                    \"right\": {\n                      \"AND\": {\n                        \"left\": {\n                          \"raw_text\": \"Normal organ function within 14 days of study entry\"\n                        }\n                      }\n                    }\n                }\n            }\n          }\n        },\n        \"right\": {\n          \"AND\": {\n            \"left\": {\n              \"AND\": {\n                \"left\": {\n                  \"raw_text\": \"Diagnosis of one of the following malignancies:\"\n                },\n                \"right\": {\n                  \"AND\": {\n                    \"left\": {\n                      \"raw_text\": \"Metastatic breast cancer (BR)\"\n                    },\n                    \"right\": {\n                      \"AND\": {\n                        \"left\": {\n                          \"raw_text\": \"Metastatic ovarian cancer (OV)\"\n                        },\n                        \"right\": {\n                          \"AND\": {\n                            \"raw_text\": \"Metastatic endometrial cancer (EM)\"\n                            },\n                            \"right\": {\n                              \"AND\": {\n                                \"raw_text\": \"Metastatic cervical cancer (CX)\"\n                                }\n                              }\n                            }\n                          }\n                      }\n                    }\n                }\n            }\n          }\n        },\n        \"right\": {\n          \"AND\": {\n            \"left\": {\n              \"AND\": {\n                \"left\": {\n                  \"raw_text\": \"Measurable metastatic disease (>1cm) in at least one site other than bone-only\"\n                },\n                \"right\": {\n                  \"AND\": {\n                    \"raw_text\": \"Progression on or failure to respond to at least one previous chemotherapy regimen for metastatic disease\"\n                    },\n                    \"right\": {\n                      \"AND\": {\n                        \"left\": {\n                          \"raw_text\": \"Progression on prior therapy with a hormonal agent if estrogen receptor or progesterone receptor positive, and/or with trastuzumab if HER2-neu positive. If patient has progressed through hormone or trastuzumab therapy only, must have received one chemotherapy regimen.\"\n                        },\n                        \"right\": {\n                          \"AND\": {\n                            \"left\": {\n                              \"raw_text\": \"Measurable metastatic disease as defined by Response Evaluation Criteria in Solid Tumors (RECIST)\"\n                            },\n                            \"right\": {\n                              \"AND\": {\n                                \"left\": {\n                                  \"raw_text\": \"Primary tumor must have been diagnosed histologically as either epithelial ovarian cancer, fallopian tube cancer, or primary peritoneal cancer (not borderline or low malignant potential epithelial carcinoma).\"\n                                }\n                              }\n                            }\n                          }\n                      }\n                    }\n                }\n            }\n          }\n        },\n        \"right\": {\n          \"AND\": {\n            \"left\": {\n              \"AND\": {\n                \"left\": {\n                  \"raw_text\": \"Histologically proven recurrent or persistent endometrial cancer that is not amenable to curative treatment with surgery and/or radiation therapy AND has failed 2 previous treatment regimens\"\n                },\n                \"right\": {\n                  \"AND\": {\n                    \"left\": {\n                      \"raw_text\": \"Measurable metastatic disease\"\n                    },\n                    \"right\": {\n                      \"AND\": {\n                        \"raw_text\": \"Histologically proven recurrent or persistent squamous cell carcinoma, adenosquamous carcinoma, or adenocarcinoma of the cervix that is not amenable to curative treatment with surgery and/or radiation therapy AND has failed 2 previous treatment regimens.\"\n                        }\n                      }\n                    }\n                }\n              }\n            }\n          }\n        }\n    }\n  }\n}"