"{\n  \"AND\": {\n    \"left\": {\n      \"OR\": {\n        \"left\": {\n          \"raw_text\": \"Other causes of heart failure other than diastolic dysfunction, such as restrictive cardiomyopathy or infiltrative cardiomyopathy\"\n        },\n        \"right\": {\n          \"OR\": {\n            \"left\": {\n              \"raw_text\": \"Women who are pregnant or nursing\"\n            },\n            \"right\": {\n              \"OR\": {\n                \"raw_text\": \"Liver cirrhosis,\"\n                \"Primary valvular disease,\"\n                \"Acute coronary syndrome,\"\n                \"Causes of PH other than that of heart failure, such as: chronic thromboembolic PH, sickle-cell disease, or sarcoidosis\"\n            }\n          }\n        }\n      }\n    },\n    \"right\": {\n      \"AND\": {\n        \"left\": {\n          \"OR\": {\n            \"left\": {\n              \"raw_text\": \"Severe bradycardia or greater than 1st degree heart block\"\n            },\n            \"right\": {\n              \"OR\": {\n                \"raw_text\": \"Decompensated heart failure\"\n            }\n          }\n        },\n        \"right\": {\n          \"AND\": {\n            \"left\": {\n              \"OR\": {\n                \"left\": {\n                  \"raw_text\": \"Current use of a third generation beta-blocker (nebivolol, carvedilol, or labetalol) or high dose of any beta-blockers (greater than 100 mg daily of metoprolol, or equivalent)\"\n                }\n            }\n          }\n        }\n      }\n  }\n}"