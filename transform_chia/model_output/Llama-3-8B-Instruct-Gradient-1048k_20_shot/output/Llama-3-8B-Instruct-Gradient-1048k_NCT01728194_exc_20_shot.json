"{\n  \"AND\": {\n    \"left\": {\n      \"AND\": {\n        \"left\": {\n          \"raw_text\": \"Psychotic depression by DSM-IV, i.e., presence of delusions with a SCID-R score higher than 2;\"\n        },\n        \"right\": {\n          \"AND\": {\n            \"left\": {\n              \"OR\": {\n                \"left\": {\n                  \"raw_text\": \"High suicide risk, i.e. intent or plan to attempt suicide in near future;\"\n                },\n                \"right\": {\n                  \"AND\": {\n                    \"left\": {\n                      \"raw_text\": \"Presence of any Axis I psychiatric disorder (other than unipolar major depression) or substance abuse;\"\n                    },\n                    \"right\": {\n                      \"AND\": {\n                        \"left\": {\n                          \"raw_text\": \"History of psychiatric disorders other than unipolar major depression or generalized anxiety disorder (bipolar disorder, hypomania, and dysthymia are exclusion criteria);\"\n                        },\n                        \"right\": {\n                          \"AND\": {\n                            \"left\": {\n                              \"raw_text\": \"Dementia: Diagnosis of dementia by DSM-IV;\"}\n                            },\n                            \"right\": {\n                              \"AND\": {\n                                \"left\": {\n                                  \"raw_text\": \"Mild Cognitive Impairment (MCI);\"}\n                                },\n                                \"right\": {\n                                  \"AND\": {\n                                    \"raw_text\": \"Acute or severe medical illness, i.e., delirium, metastatic cancer, decompensated cardiac, liver or kidney failure, major surgery, stroke or myocardial infarction during the three months prior to entry; or use of drugs known to cause depression, e.g., reserpine, alpha-methyl-dopa, steroids, sympathomimetics withdrawal;\"}\n                                    }\n                                }\n                            }\n                        }\n                    }\n                }\n            },\n            \"right\": {\n              \"AND\": {\n                \"left\": {\n                  \"OR\": {\n                    \"left\": {\n                      \"raw_text\": \"Neurological brain disease and/or history of electroconvulsive therapy;\"}\n                    },\n                    \"right\": {\n                      \"AND\": {\n                        \"left\": {\n                          \"raw_text\": \"History of any use of citalopram or escitalopram during the current episode or need for drugs that may interact with these agents, i.e. drug metabolized by the 2D6 P450 isoenzyme system;\"}\n                        }\n                    }\n                }\n            },\n            \"right\": {\n              \"AND\": {\n                \"left\": {\n                  \"AND\": {\n                    \"left\": {\n                      \"raw_text\": \"Current involvement in psychotherapy;\"}\n                    },\n                    \"right\": {\n                      \"AND\": {\n                        \"left\": {\n                          \"raw_text\": \"Contraindications to MRI scanning including cardiac pacemaker, metallic objects and metallic implants contraindicating MRI, cardiac stent, claustrophobia;\"}\n                        }\n                    }\n                }\n            },\n            \"right\": {\n              \"AND\": {\n                \"left\": {\n                  \"AND\": {\n                    \"left\": {\n                      \"raw_text\": \"Inability to speak English;\"}\n                    },\n                    \"right\": {\n                      \"AND\": {\n                        \"left\": {\n                          \"raw text\": \"Corrected visual acuity < 20/70; Color blindness.\"\n                        }\n                    }\n                }\n            }\n          }\n        }\n      }\n    }\n  }\n}"