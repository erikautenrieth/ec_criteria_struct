"{\n  \"AND\": {\n    \"left\": {\n      \"OR\": {\n        \"left\": {\n          \"raw_text\": \"1. Comorbidity with other severe or chronic eye conditions that in the judgment of the investigator will interfere with study assessments, such as corneal opacities and scars, dystrophies, epithelial scarring, infections, blood clots, etc.\"\n        },\n        \"right\": {\n          \"OR\": {\n            \"left\": {\n              \"raw_text\": \"2. Best corrected visual acuity (BCVA) at baseline <20/200.\"\n            },\n            \"right\": {\n              \"OR\": {\n                \"left\": {\n                  \"raw_text\": \"3. Has a condition or history that, in the opinion of the investigator, may interfere significantly with the subject's participation in the study.\"\n                },\n                \"right\": {\n                  \"OR\": {\n                    \"left\": {\n                      \"raw_text\": \"4. A woman who is pregnant, nursing an infant, or planning a pregnancy.\"\n                    },\n                    \"right\": {\n                      \"OR\": {\n                        \"left\": {\n                          \"raw_text\": \"5. Has a known adverse reaction and/or sensitivity to the study drug or its components.\"\n                        },\n                        \"right\": {\n                          \"OR\": {\n                            \"left\": {\n                              \"raw text\": \"6. Routine use (more than twice a week) of a chlorinated swimming pool.\"\n                            },\n                            \"right\": {\n                              \"OR\": {\n                                \"left\": {\n                                  \"raw text\": \"7. Unwilling or unable to cease using the following medications during the study period: Topical ocular cyclosporine (e.g. Restasis®), anti-histamines, antipsychotics, or eye gels.\"\n                                },\n                                \"right\": {\n                                  \"OR\": {\n                                    \"left\": {\n                                      \"raw text\": \"8. Currently enrolled in an investigational drug or device study or have used an investigational drug or device within 30 days prior to Visit 1.\"\n                                    }\n                                  }\n                                }\n                            }\n                        }\n                    }\n                }\n            }\n          }\n        }\n      }\n  }\n}"