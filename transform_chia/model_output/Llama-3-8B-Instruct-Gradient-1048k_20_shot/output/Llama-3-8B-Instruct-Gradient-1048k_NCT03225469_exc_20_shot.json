"{\n  \"AND\": {\n    \"left\": {\n      \"OR\": {\n        \"left\": {\n          \"raw_text\": \"1. History of colorectal surgery\"\n        },\n        \"right\": {\n          \"OR\": {\n            \"left\": {\n              \"raw_text\": \"2. Suspected or known digestive tract obstruction, stricture, or perforation\"\n            },\n            \"right\": {\n              \"OR\": {\n                \"left\": {\n                  \"raw_text\": \"3. Serious status of illness, such as severe renal failure whose creatinine clearance<30 ml/min, New York Heart Association grade III or grade IV congestive heart failure, or hemodynamic instability, etc.\"\n                },\n                \"right\": {\n                  \"OR\": {\n                    \"left\": {\n                      \"raw_text\": \"4. Incapable of completing bowel preparation，such as dysphagia, allergy to purgatives, or impaired mental status, etc.\"\n                    },\n                    \"right\": {\n                      \"OR\": {\n                        \"left\": {\n                          \"raw_text\": \"5. Pregnancy or breastfeeding\"\n                        },\n                        \"right\": {\n                          \"OR\": {\n                            \"left\": {\n                              \"raw_text\": \"6. Incomplete colonoscopy due to causes except poor bowel preparation\"\n                            },\n                            \"right\": {\n                              \"OR\": {\n                                \"left\": {\n                                  \"raw_text\": \"7. Unable to give informed consent\"\n                                },\n                                \"right\": {\n                                  \"OR\": {\n                                    \"left\": {\n                                      \"raw_text\": \"8. Have participated in the study before.\"\n                                    }\n                                  }\n                                }\n                            }\n                        }\n                    }\n                }\n              }\n            }\n          }\n        }\n      }\n  }\n}"