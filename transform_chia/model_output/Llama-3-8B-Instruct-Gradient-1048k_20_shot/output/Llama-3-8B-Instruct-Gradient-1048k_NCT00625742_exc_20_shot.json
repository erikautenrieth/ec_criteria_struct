"{\n  \"AND\": {\n    \"left\": {\n      \"OR\": {\n        \"left\": {\n          \"raw_text\": \"1. Have dementia or delirium (as determined by the palliative care specialist) at study entry.\"\n        },\n        \"right\": {\n          \"OR\": {\n            \"left\": {\n              \"raw_text\": \"2. Are pregnant.\"\n            },\n            \"right\": {\n              \"OR\": {\n                \"left\": {\n                  \"raw_text\": \"3. Have been taking corticosteroids for longer than 48 hours.\"\n                },\n                \"right\": {\n                  \"OR\": {\n                    \"left\": {\n                      \"raw_text\": \"4. Have pulmonary edema, ascites or pitting edema on clinical examination.\"\n                    },\n                    \"right\": {\n                      \"OR\": {\n                        \"left\": {\n                          \"raw_text\": \"5. Are unable to walk.\"\n                        }\n                      }\n                    }\n                  }\n                }\n              }\n            }\n          }\n        },\n        \"right\": {\n          \"OR\": {\n            \"left\": {\n              \"raw_text\": \"6. Have a history of serious adverse gastrointestinal events (i.e., bleeding or perforation), history of a coagulopathy or current anti-coagulant use.\"\n            },\n            \"right\": {\n              \"OR\": {\n                \"left\": {\n                  \"raw_text\": \"7. Have an ALT/AST>3x upper limit of normal.\"\n                },\n                \"right\": {\n                  \"OR\": {\n                    \"left\": {\n                      \"raw_text\": \"8. Patients on methotrexate.\"\n                    },\n                    \"right\": {\n                      \"OR\": {\n                        \"raw_text\": \"9. Patients taking melatonin receptor agonists (such as Rozerem® [ramelteon]).\"\n                        }\n                      }\n     