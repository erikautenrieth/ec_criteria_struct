"{\n  \"AND\": {\n    \"left\": {\n      \"OR\": {\n        \"left\": {\n          \"raw_text\": \"Subject has indeterminate, ulcerative, antibiotic-associated colitis.\"\n        },\n        \"right\": {\n          \"AND\": {\n            \"left\": {\n              \"raw_text\": \"Subject has stool positive for ova and parasite and for Clostridium difficule toxins within 3 months prior to enrollment.\"\n            },\n            \"right\": {\n              \"AND\": {\n                \"left\": {\n                  \"raw_text\": \"Subject with other known infectious cause of abdominal symptoms.\"\n                },\n                \"right\": {\n                  \"AND\": {\n                    \"left\": {\n                      \"raw_text\": \"Subject with clinical evidence of renal disease with the past 6 months, defined as estimated glomerular filtration rate (GFR) outside the normal reference range.\"\n                    },\n                    \"right\": {\n                      \"AND\": {\n                        \"left\": {\n                          \"raw_text\": \"Subject with known history of intestinal obstruction or current obstructive symptoms, such as severe abdominal pain with accompanying nausea or vomiting, based on investigator judgment.\"\n                        },\n                        \"right\": {\n                          \"AND\": {\n                            \"left\": {\n                              \"raw_text\": \"Subject with a diagnosis of gastroparesis or small bowel or large bowel dysmotility.\"\n                            },\n                            \"right\": {\n                              \"AND\": {\n                                \"left\": {\n                                  \"raw_text\": \"Subjects with a history of small bowel or colonic resection.\"\n                                },\n                                \"right\": {\n                                  \"AND\": {\n                                    \"raw_text\": \"Subject with any current condition believed to have an increased risk of capsule retention such as suspected or known bowel obstruction, stricture, or fistula.\"\n                                    }\n                                }\n                            }\n                          }\n                        }\n                      }\n                    }\n                  }\n                }\n              }\n            }\n          }\n        },\n        \"right\": {\n          \"AND\": {\n            \"left\": {\n              \"AND\": {\n                \"left\": {\n                  \"raw_text\": \"Subject has used non-steroidal anti-inflammatory drugs including aspirin, two times per week, during the 4 weeks preceding enrollment. Low dose aspirin regimens (< 100 mg daily) are acceptable and not exclusionary.\"\n                },\n                \"right\": {\n                  \"AND\": {\n                    \"left\": {\n                      \"raw_text\": \"Subject suffers from any condition, such as swallowing problems, that precludes compliance with study and/or device instructions.\"\n                    },\n                    \"right\": {\n                      \"AND\": {\n                        \"left\": {\n                          \"raw text\": \"Subject with cardiac pacemaker or other implanted electromedical device.\"\n                        }\n                      }\n                    }\n                  }\n                }\n              }\n            }\n          }\n        },\n        \"right\": {\n          \"AND\": {\n            \"left\": {\n              \"AND\": {\n                \"left\": {\n                  \"raw text\": \"Subject has an allergy or other known contraindication to the medications used in the study.\"\n                },\n                \"right\": {\n                  \"AND\": {\n                    \"left\": {\n                      \"raw text\": \"Subject is pregnant (documented by a positive pregnancy test) or is actively breast-feeding.\"\n                    },\n                    \"right\": {\n                      \"AND\": {\n                        \"raw text\": \"Subject is considered to be a part of a vulnerable population (eg. prisoners or those without sufficient mental capacity).\"\n                    }\n                  }\n                }\n              }\n            }\n          }\n        },\n        \"right\": {\n          \"AND\": {\n            \"left\": {\n              \"AND\": {\n                \"left\": {\n                  \"raw text\": \"Subject has a known contraindication to MRE or IC.\"\n                },\n                \"right\": {\n                  \"AND\": {\n                    \"left\": {\n                      \"raw text\": \"Subject has participated in a drug or device research study within 30 days of enrollment that may interfere with the subject's safety or ability to participate in the study.\"\n                    }\n                  }\n                }\n              }\n            }\n          }\n        },\n        \"right\": {\n          \"AND\": {\n            \"left\": {\n              \"AND\": {\n                \"left\": {\n                  \"raw text\": \"Subject has any medical condition that would make it unsafe for them to participate, per Investigator's descretion.\"\n                }\n              }\n            }\n          }\n    }\n  }\n}"