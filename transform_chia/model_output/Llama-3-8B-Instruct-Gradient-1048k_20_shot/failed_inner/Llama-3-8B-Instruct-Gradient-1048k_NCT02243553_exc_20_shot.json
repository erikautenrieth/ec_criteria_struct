{
  "AND": {
    "left": {
      "OR": {
        "left": {
          "raw_text": "1. History or presence of allergy to the study drugs or their components or drugs of their class, or a history of drug or other allergy that, in the opinion of the physician responsible, contraindicates their participation"
        },
        "right": {
          "AND": {
            "left": {
              "OR": {
                "left": {
                  "raw_text": "2. Any finding of the medical examination (including blood pressure, pulse rate and electrocardiogram) deviating from normal and of clinical relevance"
                },
                "right": {
                  "OR": {
                    "left": {
                      "raw_text": "3. History or diagnosis of any significant medical conditions: Including but not limited to gastrointestinal, hepatic, renal, respiratory, cardiovascular, metabolic, immunologic, hematological, psychiatric, neurological, oncological or hormonal disorders"
                    },
                    "right": {
                      "OR": {
                        "left": {
                          "raw_text": "4. Known elevated liver enzymes in past clinical trials with any compound (experimental or marketed)"
                        },
                        "right": {
                          "OR": {
                            "left": {
                              "raw_text": "5. Clinically relevant laboratory abnormalities (e.g. Hgb<11g/dL, Hct<30g/dL, total cholesterol >240mg/dL, triglycerides >500mg/dL, fasting glucose >130mg/dL, liver function tests >2.5x upper limit of normal, baseline international normalized ratio >1.2)"
                            },
                            "right": {
                              "OR": {
                                "left": {
                                  "raw text": "6. History of evidence of clinically significant hepatic, cardiac, pulmonary, endocrine, immunological, gastrointestinal, hematological, vascular or collagen disease"
                                },
                                "right": {
                                  "OR": {
                                    "left": {
                                      "raw text": "7. History of alcohol abuse or use of any illicit drugs"
                                    },
                                    "right": {
                                      "OR": {
                                        "left": {
                                          "raw text": "8. Unable to abstain from more than one beer or alcohol equivalent per day for the duration of the study"
                                        },
                                        "right": {
                                          "OR": {
                                            "left": {
                                              "raw text": "9. Use of tobacco products and/or history of smoking within the past 2 months"
                                            },
                                            "right": {
                                              "OR": {
                                                "raw text": "10. Pregnant or breast feeding"
                                                },
                                                "right": {
                                                  "OR": {
                                                    "raw text": "11. Sexually active women of childbearing age who do not use an acceptable barrier method of birth control"
                                                    },
                                                    "right": {
                                                      "OR": {
                                                        "raw text": "12. Hypersensitivity to caffeine, warfarin, vitamin K, omeprazole, dextromethorphan, midazolam, tipranavir, ritonavir or their excipients"
                                                        },
                                                        "right": {
                                                          "OR": {
                                                            "raw text": "13. Concomitant treatment with other experimental compounds"
                                                            },
                                                            "right": {
                                                              "OR": {
                                                                "raw text": "14. Concomitant administration of any prescription or over the counter medications known to alter P450 enzyme or P-gp activity"
                                                                },
                                                                "right": {
                                                                  "OR": {
                                                                    "raw text": "15. Concomitant administration of any prescription or over the counter medications known to be highly dependent on P450 or P-gp for clearance for which elevated plasma concentrations are known to be associated with serious toxicity"
                                                                    },
                                                                    "right": {
                                                                      "OR": {
                                                                        "raw text": "16. Concomitant administration of any food product known to alter P450 enzyme or P-gp activity such as grapefruit juice, Seville oranges"
                                                                        },
                                                                        "right": {
                                                                          "OR": {
                                                                            "raw text": "17. Concomitant administration of any drug that could affect bleeding (e.g. aspirin, clopidogrel, ticlopidine, warfarin, heparin, low-molecular weight heparin)"
                                                                            },
                                                                            "right": {
                                                                              "OR": {
                                                                                "raw text": "18. Concomitant administration of oral contraceptives (may be included with 7-day washout period)"
                                                                                },
                                                                                "right": {
                                                                                  "OR": {
                                                                                    "raw text": "19. Concomitant administration of any herbal medications"
                                                                                    },
                                                                                    "right": {
                                                                                      "OR": {
                                                                                        "raw text": "20. Inadequate venous access"
                                                                                        },
                                                                                        "right": {
                                                                                      "OR": {
                                                                                        "raw text": "21. Renal or hepatic insufficiency"
                                                                                        },
                                                                                        "right": {
                                                                                      "OR": {
                                                                                        "raw text": "22. Clinically unacceptable result at the screening physical examination"
                                                                                        },
                                                                                        "right": {
                                                                                      "OR": {
                                                                                        "raw text": "23. Use of investigational medications within 30 days before study entry"
                                                                                        },
                                                                                        "right": {
                                                                                      "OR": {
                                                                                        "raw text": "24. HIV-positive"
                                                                                        },
                                                                                        "right": {
                                                                                      "OR": {
                                                                                        "raw text": "25. Body Mass Index (BMI) > 30 kg/m²"
                                                                                        }
                      }
                    }
                }
            }
        }
      }
    }
  }
}