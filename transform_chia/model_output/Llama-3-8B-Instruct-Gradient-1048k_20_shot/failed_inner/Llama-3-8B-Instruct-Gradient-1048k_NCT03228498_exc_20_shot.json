{
  "AND": {
    "left": {
      "AND": {
        "left": {
          "raw_text": "1. Absence of objectionable cognitive impairment or presence of dementia of severe degree defined by CDR score > 2.0."
        },
        "right": {
          "AND": {
            "left": {
              "raw_text": "2. Unavailability of brain MRI (in case of absolute contraindications, the use of cranial CT is allowed)."
            },
            "right": {
              "AND": {
                "left": {
                  "raw_text": "3. Expected poor compliance with the study protocol."
                },
                "right": {
                  "AND": {
                    "left": {
                      "raw_text": "4. Past diagnosis of major depression, schizophrenia, major anxiety syndrome, or manic- depressive illness."
                    },
                    "right": {
                      "AND": {
                        "left": {
                          "raw_text": "5. Diagnosis of degenerative cognitive impairment based on clinical and/or neuroradiological findings (i.e., patients with prevailing memory impairment, or with medial temporal atrophy on brain MRI in absence of evident vascular abnormalities; i.e., Alzheimer disease as defined using the National Institute of Neurological and Communicative Disorders and Stroke/Alzheimer's Disease and Related Disorders Association criteria, Parkinson disease, Huntington disease, frontotemporal dementia)."
                        },
                        "right": {
                          "AND": {
                            "raw text": "6. Diagnosis of cognitive impairment from other causes (i.e., vitamine B12 and folic acid deficiency, thyroid disorders, metabolic diseases, head trauma, tumor or infections of the central nervous system, normal pressure hydrocephalus)."
                            }
                        }
                      }
                    },
                    "right": {
                      "AND": {
                        "left": {
                          "raw text": "7. Medical conditions expected to progress, recur, or change to such a degree to interfere with the assessment of the clinical and mental status."
                        }
                      }
                    },
                    "right": {
                      "AND": {
                        "left": {
                          "raw text": "8. Clinically relevant cardiac or pulmonary insufficiency."
                        }
                      }
                    },
                    "right": {
                      "AND": {
                        "left": {
                          "raw text": "9. Relevant electrocardiograph abnormalities; bradycardia (50 bpm) or tachycardia (120 bpm) under resting conditions."
                        }
                      }
                    },
                    "right": {
                      "AND": {
                        "left": {
                          "raw text": "10. Myocardial infarction within the past 6 months."
                        }
                      }
                    },
                    "right": {
                      "AND": {
                        "left": {
                          "raw text": "11. Stroke still requiring neurological rehabilitation."
                        }
                      }
                    },
                    "right": {
                      "AND": {
                        "left": {
                          "raw text": "12. Severe/untreated blood pressure (systolic 180 mm Hg, diastolic 95 mm Hg)."
                        }
                      }
                    },
                    "right": {
                      "AND": {
                        "left": {
                          "raw text": "13. Clinically relevant liver function impairment."
                        }
                      }
                    },
                    "right": {
                      "AND": {
                        "left": {
                          "raw text": "14. Insulin-dependent diabetes mellitus."
                        }
                      }
                    },
                    "right": {
                      "AND": {
                        "left": {
                          "raw text": "15. Idiopathic epilepsy and anti-epileptic treatment."
                        }
                      }
                    },
                    "right": {
                      "AND": {
                        "left": {
                          "raw text": "16. Severe anemia (Hb <10 mg/dL)."
                        }
                      }
                    },
                    "right": {
                      "AND": {
                        "left": {
                          "raw text": "17. Severe gastrointestinal disease."
                        }
                      }
                    },
                    "right": {
                      "AND": {
                        "left": {
                          "raw text": "18. Cancer."
                        }
                      }
                    },
                    "right": {
                      "AND": {
                        "left": {
                          "raw text": "19. Known intolerance to study drugs."
                        }
                      }
                    },
                    "right": {
                      "AND": {
                        "left": {
                          "raw text": "20. Coexistent serious illnesses that would imply a drop-out before the end of the trial."
                        }
                      }
                    }
              }
            }
          }
        }
      }
    }
  }
}