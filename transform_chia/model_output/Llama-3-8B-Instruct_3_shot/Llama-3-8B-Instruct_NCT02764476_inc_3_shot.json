"{\n  \"AND\": {\n    \"left\": {\n      \"AND\": {\n        \"left\": {\n          \"AND\": {\n            \"left\": {\n              \"raw_text\": \"Adults\"\n            },\n            \"right\": {\n              \"AND\": {\n                \"left\": {\n                  \"raw_text\": \"18-65 years\"\n                },\n                \"right\": {\n                  \"raw_text\": \"who are diagnosed with functional neurologic symptom or conversion disorder.\"\n                }\n              }\n            }\n          }\n        },\n        \"right\": {\n          \"AND\": {\n            \"left\": {\n              \"OR\": {\n                \"left\": {\n                  \"raw_text\": \"If diagnosis of seizure type then video EEG with diagnosis confirmed by board-certified neurologist with subspecialty training in epilepsy and clinical neurophysiology using the criteria of the International Classification of the Epilepsies is required.\"\n                },\n                \"right\": {\n                  \"OR\": {\n                    \"left\": {\n                      \"raw_text\": \"If diagnosis of motor type, documented and clinically established levels of diagnostic certainty (Williams,1995) confirmed by 2 neurologists is required.\"\n                    }\n                  }\n                }\n              }\n            },\n            \"right\": {\n              \"AND\": {\n                \"left\": {\n                  \"raw_text\": \"Participants must have at least one symptom per month in the month prior to enrollment\"\n                },\n                \"right\": {\n                  \"AND\": {\n                    \"left\": {\n                      \"raw_text\": \"Fluency in English spoken language\"\n                    }\n                  }\n                }\n              }\n            }\n          }\n        }\n      }\n    }\n  }\n}"