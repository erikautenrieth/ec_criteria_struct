"{\n  \"AND\": {\n    \"left\": {\n      \"OR\": {\n        \"left\": {\n          \"raw_text\": \"History of organic brain disease\"\n        },\n        \"right\": {\n          \"OR\": {\n            \"left\": {\n              \"raw_text\": \"DSM-IV diagnosis of Alcohol or Substance Dependence within the last six months (except nicotine)\"\n            },\n            \"right\": {\n              \"OR\": {\n                \"left\": {\n                  \"raw_text\": \"or DSM-5 diagnosis of Substance Use Disorder in the last six months (except nicotine)\"\n                }\n              }\n            }\n          }\n        }\n      }\n    },\n    \"right\": {\n      \"OR\": {\n        \"left\": {\n          \"raw_text\": \"DSM-IV diagnosis of Alcohol or Substance Abuse within the last one month (except nicotine)\"\n        },\n        \"right\": {\n          \"OR\": {\n            \"left\": {\n              \"raw_text\": \"or DSM-5 diagnosis of Substance Use Disorder in the last six months (except nicotine)\"\n            }\n          }\n        }\n      }\n    }\n  },\n  \"AND\": {\n    \"left\": {\n      \"OR\": {\n        \"left\": {\n          \"raw_text\": \"Pregnancy or lactation\"\n        },\n        \"right\": {\n          \"OR\": {\n            \"left\": {\n              \"raw_text\": \"Severe liver dysfunction (LFT 3X upper limit of normal)\"\n            },\n            \"right\": {\n              \"OR\": {\n                \"left\": {\n                  \"raw_text\": \"Previous known hypersensitivity to tetracyclines\"\n                },\n                \"right\": {\n                  \"OR\": {\n                    \"left\": {\n                      \"raw_text\": \"Current treatment with tetracycline or derivative\"\n                    },\n                    \"right\": {\n                      \"OR\": {\n                        \"left\": {\n                          \"raw_text\": \"Treatment with oral contraceptives (unless a second form of birth control is used and documented)\"\n                        },\n                        \"right\": {\n                          \"OR\": {\n                            \"left\": {\n                              \"raw_text\": \"Treatment with cholestyramine or colestipol\"\n                            },\n                            \"right\": {\n                              \"OR\": {\n                                \"left\": {\n                                  \"raw_text\": \"Treatment with Urinary alkalinizers (e.g., sodium lactate, potassium citrate)\"\n                                },\n                                \"right\": {\n                                  \"OR\": {\n                                    \"left\": {\n                                      \"raw_text\": \"Treatment with warfarin\"\n                                    },\n                                    \"right\": {\n                                      \"OR\": {\n                                        \"left\": {\n                                          \"raw_text\": \"Treatment with bupropion, varenicline, or nicotine replacement products in the month prior to study inclusion\"\n                                        },\n                                        \"right\": {\n                                          \"OR\": {\n                                            \"left\": {\n                                              \"raw_text\": \"Less than two months treatment of adjunctive medications AND less than one month on same dose: beta blockers, antidepressants, mood stabilizers, antianxiety medications.\"\n                                            },\n                                            \"right\": {\n                                              \"OR\": {\n                                                \"left\": {\n                                                  \"raw_text\": \"Medical condition whose pathology or treatment would significantly increase the risk associated with the proposed protocol.\"\n                                                },\n                                                \"right\": {\n                                                  \"OR\": {\n                                                    \"left\": {\n                                                      \"raw_text\": \"History of head injury, seizures, or stroke\"\n                                                    },\n                                                    \"right\": {\n                                                      \"OR\": {\n                                                        \"left\": {\n                                                          \"raw_text\": \"Positive urine toxicology screen for substances of non-therapeutic use prior to craving assessments\"\n                                                        }\n                                                      }\n                                                    }\n                                                  }\n                                                }\n                                              }\n                                            }\n                                          }\n                                        }\n                                      }\n                                    }\n                                  }\n                                }\n                              }\n                            }\n                          }\n                        }\n                      }\n                    }\n                  }\n                }\n              }\n            }\n          }\n        }\n      }\n    }\n  }\n}"