{
  "AND": {
    "left": {
      "AND": {
        "left": {
          "OR": {
            "left": {
              "raw_text": "Absence of objectionable cognitive impairment"
            },
            "right": {
              "NOT": {
                "left": {
                  "raw_text": "or presence of dementia of severe degree defined by CDR score > 2.0."
                }
              }
            }
          }
        },
        "right": {
          "AND": {
            "left": {
              "NOT": {
                "left": {
                  "raw_text": "Unavailability of brain MRI"
                }
              }
            },
            "right": {
              "OR": {
                "left": {
                  "raw_text": "(in case of absolute contraindications, the use of cranial CT is allowed)."
                }
              }
            }
          }
        }
      }
    },
    "right": {
      "AND": {
        "left": {
          "OR": {
            "left": {
              "raw_text": "Expected poor compliance with the study protocol."
            },
            "right": {
              "OR": {
                "left": {
                  "raw_text": "Past diagnosis of major depression"
                },
                "right": {
                  "OR": {
                    "left": {
                      "raw_text": "schizophrenia"
                    },
                    "right": {
                      "OR": {
                        "left": {
                          "raw_text": "major anxiety syndrome"
                        },
                        "right": {
                          "raw_text": "or manic- depressive illness."
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "right": {
          "AND": {
            "left": {
              "OR": {
                "left": {
                  "raw_text": "Diagnosis of degenerative cognitive impairment"
                },
                "right": {
                  "OR": {
                    "left": {
                      "raw_text": "based on clinical and/or neuroradiological findings"
                    },
                    "right": {
                      "OR": {
                        "left": {
                          "raw_text": "(i.e., patients with prevailing memory impairment"
                        },
                        "right": {
                          "OR": {
                            "left": {
                              "raw_text": ", or with medial temporal atrophy on brain MRI in absence of evident vascular abnormalities; i.e., Alzheimer disease as defined using the National Institute of Neurological and Communicative Disorders and Stroke/Alzheimer's Disease and Related Disorders Association criteria, Parkinson disease, Huntington disease, frontotemporal dementia)."
                            }
                          }
                        }
                      }
                    }
                  }
                },
                "right": {
                  "OR": {
                    "left": {
                      "raw_text": "Diagnosis of cognitive impairment from other causes"
                    },
                    "right": {
                      "OR": {
                        "left": {
                          "raw_text": "(i.e., vitamine B12 and folic acid deficiency"
                        },
                        "right": {
                          "OR": {
                            "left": {
                              "raw_text": ", thyroid disorders, metabolic diseases, head trauma, tumor or infections of the central nervous system, normal pressure hydrocephalus)."
                            }
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}