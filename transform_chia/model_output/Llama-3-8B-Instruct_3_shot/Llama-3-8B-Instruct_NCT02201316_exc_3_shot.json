"{\n  \"AND\": {\n    \"left\": {\n      \"OR\": {\n        \"left\": {\n          \"raw_text\": \"Current or chronic history of liver disease\"\n        },\n        \"right\": {\n          \"OR\": {\n            \"left\": {\n              \"raw_text\": \"or known hepatic or biliary abnormalities\"\n            },\n            \"right\": {\n              \"NOT\": {\n                \"left\": {\n                  \"OR\": {\n                    \"left\": {\n                      \"raw_text\": \"with the exception of Gilbert's syndrome\"\n                    },\n                    \"right\": {\n                      \"raw_text\": \"or asymptomatic gallstones\"\n                    }\n                  }\n                }\n              }\n            }\n          }\n        }\n      }\n    },\n    \"right\": {\n      \"AND\": {\n        \"left\": {\n          \"OR\": {\n            \"left\": {\n              \"raw_text\": \"History of regular alcohol consumption within 6 months of the study defined as:\"\n            },\n            \"right\": {\n              \"AND\": {\n                \"left\": {\n                  \"raw_text\": \"An average weekly intake of >21 units for males or >14 units for females.\"\n                },\n                \"right\": {\n                  \"raw_text\": \"One unit is equivalent to 8 gram of alcohol: a half-pint (approximately 240 milliliter [mL]) of beer, 1 glass (100 mL) of wine or 1 (25 mL) measure of spirits.\"\n                }\n              }\n            }\n          },\n          \"right\": {\n            \"AND\": {\n              \"left\": {\n                \"OR\": {\n                  \"left\": {\n                    \"raw_text\": \"History of sensitivity to heparin\"\n                    },\n                    \"right\": {\n                      \"raw_text\": \"or heparin-induced thrombocytopenia.\"\n                    }\n                  }\n                },\n                \"right\": {\n                  \"AND\