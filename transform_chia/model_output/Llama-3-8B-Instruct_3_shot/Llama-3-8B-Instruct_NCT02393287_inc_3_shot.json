"{\n  \"AND\": {\n    \"left\": {\n      \"AND\": {\n        \"left\": {\n          \"raw_text\": \"Age ≥ 18 years\"\n        }\n      }\n    },\n    \"right\": {\n      \"AND\": {\n        \"left\": {\n          \"AND\": {\n            \"left\": {\n              \"raw_text\": \"Patient with breast cancer\"\n            },\n            \"right\": {\n              \"OR\": {\n                \"left\": {\n                  \"raw_text\": \"histologically proven, metastatic\"\n                },\n                \"right\": {\n                  \"raw_text\": \"or locally advanced\"\n                }\n              }\n            }\n          }\n        },\n        \"right\": {\n          \"AND\": {\n            \"left\": {\n              \"AND\": {\n                \"left\": {\n                  \"raw_text\": \"Patient treated by Eribulin\"\n                },\n                \"right\": {\n                  \"OR\": {\n                    \"left\": {\n                      \"raw_text\": \"between January and October 2014\"\n                    },\n                    \"right\": {\n                      \"raw_text\": \"(for the retrospective part) or between November 2014 and September 2015\"\n                    }\n                  }\n                }\n              }\n            },\n            \"right\": {\n              \"AND\": {\n                \"left\": {\n                  \"raw_text\": \"Patient with at least an assessment of the response to Eribulin\"\n                }\n              }\n            }\n          }\n        }\n      }\n    }\n  }\n}"