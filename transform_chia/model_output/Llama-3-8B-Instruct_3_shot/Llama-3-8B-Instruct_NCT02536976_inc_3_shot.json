"{\n  \"AND\": {\n    \"left\": {\n      \"AND\": {\n        \"left\": {\n          \"raw_text\": \"Aged 25-80 at screening.\"\n        },\n        \"right\": {\n          \"OR\": {\n            \"left\": {\n              \"raw_text\": \"Subjects older than 80 will be allowed at the discretion of the PI.\"\n            }\n          }\n        }\n      }\n    },\n    \"right\": {\n      \"AND\": {\n        \"left\": {\n          \"raw_text\": \"Ambulatory (defined as able to ambulate at least 10 meters, with or without assistance).\"\n        },\n        \"right\": {\n          \"AND\": {\n            \"left\": {\n              \"raw_text\": \"Clinical Diagnosis of PD based on the United Kingdom Brain Bank diagnostic criteria for PD.\"\n            },\n            \"right\": {\n              \"AND\": {\n                \"left\": {\n                  \"AND\": {\n                    \"left\": {\n                      \"raw_text\": \"At least 8 micturitions per 24 hours\"\n                    },\n                    \"right\": {\n                      \"AND\": {\n                        \"left\": {\n                          \"raw_text\": \"and\"\n                        },\n                        \"right\": {\n                          \"raw_text\": \"at least 3 urgency episodes per 3-day diary.\"\n                        }\n                      }\n                    }\n                  }\n                },\n                \"right\": {\n                  \"AND\": {\n                    \"left\": {\n                      \"raw_text\": \"A MoCA score between 19 and 28 (inclusive) at screening.\"\n                    },\n                    \"right\": {\n                      \"OR\": {\n                        \"left\": {\n                          \"raw_text\": \"For those on cognitive enhancers (donepezil, rivastigmine, memantine, galantamine) a MoCA score between 19 and 29 (inclusive) at screening.\"\n                        }\n                      }\n                    }\n                  }\n                }\n              }\n            }\n          }\n        }\n      }\n    },\n    \"right\": {\n      \"AND\": {\n        \"left\": {\n          \"raw_text\": \"Provide informed consent to participate in the study and understand that they may withdraw their consent at any time without prejudice to their future medical care.\"\n        },\n        \"right\": {\n          \"AND\": {\n            \"left\": {\n              \"raw_text\": \"Be cognitively capable, in the opinion of investigator, to understand and provide such informed consent.\"\n            },\n            \"right\": {\n              \"AND\": {\n                \"left\": {\n                  \"OR\": {\n                    \"left\": {\n                      \"raw_text\": \"Be cognitively capable to complete the required questionnaires and assessments,\"\n                    },\n                    \"right\": {\n                      \"raw_text\": \"OR have a care partner who is willing and capable to assist them in the completion of these tasks.\"\n                    }\n                  }\n                },\n                \"right\": {\n                  \"AND\": {\n                    \"left\": {\n                      \"raw_text\": \"Be on a stable regimen of antiparkinson's medications at least 30 days prior to screening, and be expected to remain on a stable dose for the duration of the study.\"\n                    },\n                    \"right\": {\n                      \"OR\": {\n                        \"left\": {\n                          \"raw_text\": \"If taking cognitive enhancers (donepezil, rivastigmine, memantine, galantamine), must be on stable dose at least 30 days prior to screening, and be expected to remain on a stable dose for the duration of the study.\"\n                        }\n                      }\n                    }\n                  }\n                }\n              }\n            }\n          }\n        }\n      }\n    }\n  }\n}"