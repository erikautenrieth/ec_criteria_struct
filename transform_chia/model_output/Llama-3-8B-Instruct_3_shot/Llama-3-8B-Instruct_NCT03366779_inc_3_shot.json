"{\n  \"AND\": {\n    \"left\": {\n      \"AND\": {\n        \"left\": {\n          \"raw_text\": \"Age 18 to 75 years old\"\n        },\n        \"right\": {\n          \"OR\": {\n            \"left\": {\n              \"raw_text\": \"(male or female).\"\n            }\n          }\n        }\n      }\n    },\n    \"right\": {\n      \"AND\": {\n        \"left\": {\n          \"AND\": {\n            \"left\": {\n              \"raw_text\": \"Patients with posterior or posterolateral disc herniations\"\n            },\n            \"right\": {\n              \"AT\": {\n                \"left\": {\n                  \"raw_text\": \"at one level between L1 and S1\"\n                }\n              }\n            }\n          },\n          \"right\": {\n            \"AND\": {\n              \"left\": {\n                \"raw_text\": \"with radiographic confirmation of neural compression using CT and/or MRI.\"\n                },\n              \"right\": {\n                \"AND\": {\n                  \"left\": {\n                    \"raw_text\": \"At least six (6) weeks of failed, conservative treatment prior to surgery, or requires immediate surgery to prevent permanent disability.\"\n                    },\n                  \"right\": {\n                    \"AND\": {\n                      \"left\": {\n                        \"raw_text\": \"Minimum posterior disc height of 5mm at the index level(s).\"\n                        },\n                      \"right\": {\n                        \"AND\": {\n                          \"left\": {\n                            \"raw_text\": \"Lower back pain and/or sciatica with or without spinal claudication.\"\n                            },\n                          \"right\": {\n                            \"AND\": {\n                              \"left\": {\n                                \"raw_text\": \"Oswestry Questionnaire score of at least 40/100 at baseline.\"\n                                },\n          