"{\n  \"AND\": {\n    \"left\": {\n      \"AND\": {\n        \"left\": {\n          \"raw_text\": \"Provision of written informed consent\"\n        },\n        \"right\": {\n          \"raw_text\": \"(by patient or appropriate designee according to local regulations) prior to any study specific procedures.\"\n        }\n      }\n    },\n    \"right\": {\n      \"AND\": {\n        \"left\": {\n          \"AND\": {\n            \"left\": {\n              \"raw_text\": \"Aged 18 years or older\"\n            },\n            \"right\": {\n              \"OR\": {\n                \"left\": {\n                  \"raw_text\": \"male\"\n                },\n                \"right\": {\n                  \"raw_text\": \"or female.\"\n                }\n              }\n            }\n          }\n        },\n        \"right\": {\n          \"AND\": {\n            \"left\": {\n              \"OR\": {\n                \"left\": {\n                  \"raw_text\": \"History of stable angina pectoris\"\n                },\n                \"right\": {\n                  \"AND\": {\n                    \"left\": {\n                      \"raw_text\": \"with angiographic evidence of CAD\"\n                    },\n                    \"right\": {\n                      \"raw_text\": \"(diameter stenosis = 50%) in major, i.e., left main, left anterior descending, left circumflex, and right coronary arteries.\"\n                    }\n                  }\n                }\n              },\n              \"right\": {\n                \"OR\": {\n                  \"left\": {\n                    \"raw_text\": \"History of previous myocardial infarction (MI)\"\n                  },\n                  \"right\": {\n                    \"raw_text\": \"or History of coronary revascularization, i.e., percutaneous coronary intervention (PCI) or coronary artery bypass graft (CABG), not including the elective PCI during the index hospitalization\"\n                  }\n                }\n              }\n            },\n            \"right\": {\n              \"AND\": {\n                \"left\": {\n                  \"OR\": {\n                    \"left\": {\n                      \"raw_text\": \"Documented history of type 2 diabetes mellitus.\"\n                    }\n                  }\n                },\n                \"right\": {\n                  \"AND\": {\n                    \"left\": {\n                      \"raw_text\": \"Post-procedural residual diameter stenosis of the treated lesions\"\n                    },\n                    \"right\": {\n                      \"OR\": {\n                        \"left\": {\n                          \"raw_text\": \"< 20% in patients with stent implantation\"\n                        },\n                        \"right\": {\n                          \"raw_text\": \"or < 50% in those with balloon angioplasty\"\n                        }\n                      }\n                    }\n                  }\n                }\n              },\n              \"right\": {\n                \"AND\": {\n                  \"left\": {\n                    \"raw_text\": \"Post-procedural thrombolysis in myocardial infarction (TIMI) grade 3 flow in treated vessels\"\n                  },\n                  \"right\": {\n                    \"AND\": {\n                      \"left\": {\n                        \"raw_text\": \"Negative cardiac troponin test before the index elective PCI.\"\n                      }\n                    }\n                  }\n                }\n              }\n            }\n          }\n        }\n      }\n    }\n  }\n}"