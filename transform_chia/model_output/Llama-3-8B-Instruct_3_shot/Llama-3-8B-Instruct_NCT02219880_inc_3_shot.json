"{\n  \"AND\": {\n    \"left\": {\n      \"AND\": {\n        \"left\": {\n          \"raw_text\": \"Aged between 18-70 years\"\n        },\n        \"right\": {\n          \"AND\": {\n            \"left\": {\n              \"raw_text\": \"Meets the Diagnostic and Statistical Manual (DSM) IV and DSM-V diagnostic criteria for generalised anxiety disorder (GAD) based on structured interview (Mini International Neuropsychiatric Interview-Plus 6 [MINI-Plus 6]. Note that while the MINI-Plus 6 uses the DSM-IV criteria, the same criteria are used in the DSM-V)\"\n            },\n            \"right\": {\n              \"AND\": {\n                \"left\": {\n                  \"raw_text\": \"Presents with anxiety (Hamilton Anxiety Rating Scale = 18) at the time of study entry\"\n                },\n                \"right\": {\n                  \"AND\": {\n                    \"left\": {\n                      \"raw_text\": \"Fluent in written and spoken English\"\n                    },\n                    \"right\": {\n                      \"AND\": {\n                        \"left\": {\n                          \"raw_text\": \"Provides a signed copy of the consent form\"\n                        },\n                        \"right\": {\n                          \"NOT\": {\n                            \"left\": {\n                              \"raw_text\": \"Primary diagnosis other than GAD\"\n                            }\n                          }\n                        }\n                      }\n                    }\n                  }\n                }\n              }\n            }\n          }\n        }\n      }\n    },\n    \"right\": {\n      \"AND\": {\n        \"left\": {\n          \"OR\": {\n            \"left\": {\n              \"raw_text\": \"Presentation of moderate to severe depressive symptoms (Montgomery-Asberg Rating Scale: MADRS = 18 at time of study entry or = 24 at any time during study)\"\n            },\n            \"right\": {\n              \"OR\": {\n                \"left\": {\n                  \"raw_text\": \"Presentation of suicidal ideation (= 3 on MADRS suicidal thoughts domain at time of study entry or at any time during study)\"\n                }\n              }\n            }\n          }\n        },\n        \"right\": {\n          \"AND\": {\n            \"left\": {\n              \"OR\": {\n                \"left\": {\n                  \"raw_text\": \"Current diagnosis of bipolar disorder or schizophrenia on structured interview (MINI Plus)\"\n                },\n                \"right\": {\n                  \"OR\": {\n                    \"left\": {\n                      \"raw_text\": \"Current substance/alcohol use disorder on structured interview (MINI Plus)\"\n                    }\n                  }\n                }\n              }\n            },\n            \"right\": {\n              \"AND\": {\n                \"left\": {\n                  \"OR\": {\n                    \"left\": {\n                      \"raw_text\": \"Currently taking an antidepressant, mood stabiliser, antipsychotic, anticonvulsant, warfarin or thyroxin, or current regular use (more than 2 days per week) of a benzodiazepine or opioid-based analgesic\"\n                    },\n                    \"right\": {\n                      \"OR\": {\n                        \"left\": {\n                          \"raw_text\": \"Current use of a psychotropic nutraceutical (e.g. St John's wort)\"\n                        }\n                      }\n                    }\n                  }\n                },\n                \"right\": {\n                  \"AND\": {\n                    \"left\": {\n                      \"OR\": {\n                        \"left\": {\n                          \"raw_text\": \"Previous intolerance to kava\"\n                        }\n                      }\n                    },\n                    \"right\": {\n                      \"AND\": {\n                        \"left\": {\n                          \"raw_text\": \"Three or more failed trials of pharmacotherapy for the current GAD episode\"\n                        },\n                        \"right\": {\n                          \"AND\": {\n                            \"left\": {\n                              \"raw_text\": \"Recently commenced psychotherapy (within four weeks of study entry)\"\n                            },\n                            \"right\": {\n                              \"NOT\": {\n                                \"left\": {\n                                  \"OR\": {\n                                    \"left\": {\n                                      \"raw_text\": \"Known or suspected clinically unstable systemic medical disorder\"\n                                    },\n                                    \"right\": {\n                                      \"OR\": {\n                                        \"left\": {\n                                          \"raw_text\": \"Diagnosed hepato-biliary disease/inflammation\"\n                                        },\n                                        \"right\": {\n                                          \"OR\": {\n                                            \"left\": {\n                                              \"raw_text\": \"Elevated liver enzymes at baseline blood test\"\n                                            }\n                                          }\n                                        }\n                                      }\n                                    }\n                                  }\n                                }\n                              }\n                            }\n                          }\n                        }\n                      }\n                    }\n                  }\n                }\n              }\n            }\n          }\n        }\n      }\n    }\n  }\n}"