"{\n  \"AND\": {\n    \"left\": {\n      \"raw_text\": \"19 years old and above.\"\n    },\n    \"right\": {\n      \"AND\": {\n        \"left\": {\n          \"OR\": {\n            \"left\": {\n              \"raw_text\": \"Patients who previously have received a liver transplant\"\n            },\n            \"right\": {\n              \"AND\": {\n                \"left\": {\n                  \"raw_text\": \"over the last six months\"\n                },\n                \"right\": {\n                  \"AND\": {\n                    \"left\": {\n                      \"raw_text\": \"and within last three years.\"\n                    }\n                  }\n                }\n              }\n            }\n          },\n          \"right\": {\n            \"AND\": {\n              \"left\": {\n                \"raw_text\": \"Patients who are on Tacrolimus immunosuppressive therapy\"\n              },\n              \"right\": {\n                \"AND\": {\n                  \"left\": {\n                    \"raw_text\": \"twice a day for at least two weeks.\"\n                    }\n                  }\n                }\n              }\n            }\n          }\n        },\n        \"right\": {\n          \"AND\": {\n            \"left\": {\n              \"AND\": {\n                \"left\": {\n                  \"raw_text\": \"Patients who have normal liver function\"\n                },\n                \"right\": {\n                  \"raw_text\": \"and renal function.\"\n                }\n              }\n            },\n            \"right\": {\n              \"AND\": {\n                \"left\": {\n                  \"raw_text\": \"Patients who have been monitored without complication\"\n                },\n                \"right\": {\n                  \"raw_text\": \"such as acute rejection.\"\n                }\n              }\n            }\n          }\n        }\n      }\n    },\n    \"right\": {\n      \"raw_text\": \"Patients willing to sign his/her consent.\"\n    }\n  }\n}"