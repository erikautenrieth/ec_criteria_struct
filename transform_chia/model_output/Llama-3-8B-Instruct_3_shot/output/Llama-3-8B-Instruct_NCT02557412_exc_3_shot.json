"{\n  \"OR\": {\n    \"left\": {\n      \"AND\": {\n        \"left\": {\n          \"raw_text\": \"Apnea-hypopnea index of less than 5 h-1\"\n        },\n        \"right\": {\n          \"raw_text\": \"or greater than 30 h-1.\"\n        }\n      }\n    }\n  },\n  \"AND\": {\n    \"left\": {\n      \"raw_text\": \"Predominance of central apneas and hypopneas, defined as more than 25% of all respiratory events.\"\n    },\n    \"right\": {\n      \"OR\": {\n        \"left\": {\n          \"raw_text\": \"Professional drivers, risk profession or respiratory failure (according to criteria of the clinical pathway for diagnosis and treatment of sleep-disordered breathing).\"\n        }\n      }\n    }\n  },\n  \"OR\": {\n    \"left\": {\n      \"raw_text\": \"Very excessive daytime sleepiness (Epworth Sleepiness Scale> 18).\"\n    },\n    \"right\": {\n      \"OR\": {\n        \"left\": {\n          \"raw_text\": \"Morbid obesity (BMI> 40 kg / m2).\"\n        },\n        \"right\": {\n          \"raw_text\": \"Prior treatment with CPAP.\"\n        }\n      }\n    }\n  }\n}"