"{\n  \"AND\": {\n    \"left\": {\n      \"AND\": {\n        \"left\": {\n          \"NOT\": {\n            \"left\": {\n              \"raw_text\": \"Is not a habitual wearer of Avaira sphere lenses\"\n            }\n          }\n        },\n        \"right\": {\n          \"AND\": {\n            \"left\": {\n              \"NOT\": {\n                \"left\": {\n                  \"OR\": {\n                    \"left\": {\n                      \"raw_text\": \"Has a CL prescription outside the range of the available parameters of the study lenses.\"\n                    },\n                    \"right\": {\n                      \"raw_text\": \"Has a spectacle cylinder ≥1.00D of cylinder in either eye.\"\n                    }\n                  }\n                }\n              }\n            },\n            \"right\": {\n              \"AND\": {\n                \"left\": {\n                  \"raw_text\": \"Has a history of not achieving comfortable CL wear (5 days per week; > 8 hours/day)\"\n                },\n                \"right\": {\n                  \"AND\": {\n                    \"left\": {\n                      \"raw_text\": \"Has contact lens best corrected distance vision worse than 20/25 (0.10 logMAR) in either eye.\"\n                    },\n                    \"right\": {\n                      \"OR\": {\n                        \"left\": {\n                          \"raw_text\": \"Presence of clinically significant (grade 2-4) anterior segment abnormalities\"\n                        },\n                        \"right\": {\n                          \"OR\": {\n                            \"left\": {\n                              \"raw_text\": \"Presence of ocular or systemic disease or need of medications which might interfere with contact lens wear.\"\n                            },\n                            \"right\": {\n                              \"OR\": {\n                                \"left\": {\n                         