"{\n  \"AND\": {\n    \"left\": {\n      \"OR\": {\n        \"left\": {\n          \"raw_text\": \"Age 18 years\"\n        },\n        \"right\": {\n          \"raw_text\": \"or older\"\n        }\n      }\n    },\n    \"right\": {\n      \"AND\": {\n        \"left\": {\n          \"raw_text\": \"Mechanical ventilation\"\n        },\n        \"right\": {\n          \"AND\": {\n            \"left\": {\n              \"AND\": {\n                \"left\": {\n                  \"raw_text\": \"IAP between\"\n                },\n                \"right\": {\n                  \"AND\": {\n                    \"left\": {\n                      \"raw_text\": \"12 and 20 mmHg\"\n                    },\n                    \"right\": {\n                      \"raw_text\": \"in at least two consecutive measurements within 1-12 h\"\n                    }\n                  }\n                }\n              },\n              \"right\": {\n                \"AND\": {\n                  \"left\": {\n                    \"raw_text\": \"Spontaneous breathing activity of at least\"\n                  },\n                  \"right\": {\n                    \"raw_text\": \"6 breaths/minute\"\n                    }\n                  }\n                }\n              }\n            },\n            \"right\": {\n              \"AND\": {\n                \"left\": {\n                  \"raw_text\": \"RASS score between\"\n                },\n                \"right\": {\n                  \"raw_text\": \"0 and -4\"\n                    }\n                }\n              },\n              \"right\": {\n                \"raw_text\": \"Physician-led sedation (if sedated; as opposed to nurse-led protocol)\"\n              }\n            }\n          }\n        }\n      }\n    }\n  }\n}"