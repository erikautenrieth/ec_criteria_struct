"{\n  \"AND\": {\n    \"left\": {\n      \"OR\": {\n        \"left\": {\n          \"raw_text\": \"Risk of severe alcohol withdrawal (e.g. history of seizures or delirium tremens)\"\n        },\n        \"right\": {\n          \"OR\": {\n            \"left\": {\n              \"raw_text\": \"Current Moderate or Severe Substance Use Disorder, other than Alcohol, Nicotine or Caffeine Use Disorders\"\n            },\n            \"right\": {\n              \"OR\": {\n                \"left\": {\n                  \"raw_text\": \"Lifetime history of Bipolar Disorder, Schizophrenia or Schizoaffective Disorder\"\n                },\n                \"right\": {\n                  \"AND\": {\n                    \"left\": {\n                      \"raw_text\": \"Any current psychiatric disorder, other than Alcohol Use Disorder, that, in the judgment of the investigator, will require treatment that will interfere with study participation.\"\n                    },\n                    \"right\": {\n                      \"OR\": {\n                        \"left\": {\n                          \"raw_text\": \"Current severe depression (HAM-D >24) or anxiety (HAM-A >24)\"\n                        },\n                        \"right\": {\n                          \"raw_text\": \"Significant suicide or violence risk\"\n                        }\n                      }\n                    }\n                  }\n                }\n              }\n            }\n          }\n        }\n      }\n    },\n    \"right\": {\n      \"AND\": {\n        \"left\": {\n          \"OR\": {\n            \"left\": {\n              \"raw_text\": \"Currently taking any psychotropic medications\"\n            },\n            \"right\": {\n              \"OR\": {\n                \"left\": {\n                  \"raw_text\": \"Legally mandated to participate in treatment\"\n                },\n                \"right\": {\n                  \"raw_text\": \"History of prior treatment with disulfiram\"\n                }\n              }\n            }\n          },\n          \"right\": {\n            \"OR\": {\n              \"left\": {\n                \"raw_text\": \"Sufficiently socially unstable as to preclude participation (e.g. homeless)\"\n              },\n              \"right\": {\n                \"OR\": {\n                  \"left\": {\n                    \"raw_text\": \"Contraindications to disulfiram treatment (liver disease, kidney disease, cardiac disease, seizure disorder, hypothyroidism, diabetes mellitus, pregnancy or lactation, allergy to disulfiram or thiuran derivatives)\"\n                    },\n                    \"right\": {\n                      \"OR\": {\n                        \"left\": {\n                          \"raw_text\": \"Neurological or medical conditions that would interfere with MRI scanning (e.g. history of stroke, seizure, brain tumor, brain infection, traumatic brain injury, multiple sclerosis, dementia, metal device in body, pregnancy, claustrophobia, color blindness, severe hearing impairment, weight>300 lbs., wheelchair-bound)\"\n                        },\n                        \"right\": {\n                          \"OR\": {\n                            \"left\": {\n                              \"raw_text\": \"Currently taking medications containing alcohol, metronidazole, isoniazid, paraldehyde, phenytoin, warfarin, or theophylline.\"\n                            },\n                            \"right\": {\n                              \"raw_text\": \"Significant alcohol withdrawal (CIWA>8) at screening, after confirming a blood alcohol level of zero.\"\n                            }\n                          }\n                        }\n                      }\n                    }\n                  }\n                }\n              }\n            }\n          }\n        }\n      }\n    }\n  }\n}"