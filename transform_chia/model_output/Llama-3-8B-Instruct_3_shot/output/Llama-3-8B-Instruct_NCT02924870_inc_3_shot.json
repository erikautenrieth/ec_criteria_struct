"{\n  \"AND\": {\n    \"left\": {\n      \"raw_text\": \"subjects older than 35 years\"\n    },\n    \"right\": {\n      \"AND\": {\n        \"left\": {\n          \"AND\": {\n            \"left\": {\n              \"raw_text\": \"diagnosis of moderate to very severe COPD\"\n            },\n            \"right\": {\n              \"raw_text\": \"(FEV1 <80% predicted), according to the GesEPOC criteria, established at least 3 months\"\n            }\n          }\n        },\n        \"right\": {\n          \"AND\": {\n            \"left\": {\n              \"OR\": {\n                \"left\": {\n                  \"raw_text\": \"current smoker\"\n                },\n                \"right\": {\n                  \"raw_text\": \"with an accumulated consumption >10 packs x year\"\n                }\n              }\n            },\n            \"right\": {\n              \"raw_text\": \"or former smoker\"\n            }\n          }\n        },\n        \"right\": {\n          \"raw_text\": \"hospital admission for COPD exacerbation\"\n        }\n      }\n    }\n  }\n}"