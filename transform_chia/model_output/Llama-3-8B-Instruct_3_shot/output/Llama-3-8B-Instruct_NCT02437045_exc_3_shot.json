"{\n  \"AND\": {\n    \"left\": {\n      \"AND\": {\n        \"left\": {\n          \"raw_text\": \"Patient not expected to survive more than 4 days\"\n        },\n        \"right\": {\n          \"OR\": {\n            \"left\": {\n              \"raw_text\": \"Patient allergic to a penicillin\"\n            },\n            \"right\": {\n              \"raw_text\": \"or a carbapenem\"\n            }\n          }\n        }\n      }\n    },\n    \"right\": {\n      \"AND\": {\n        \"left\": {\n          \"NOT\": {\n            \"left\": {\n              \"raw_text\": \"Patient with significant polymicrobial bacteraemia (that is, a Gram positive skin contaminant in one set of blood cultures is not regarded as significant polymicrobial bacteraemia).\"\n            }\n          }\n        },\n        \"right\": {\n          \"AND\": {\n            \"left\": {\n              \"NOT\": {\n                \"left\": {\n                  \"raw_text\": \"Treatment is not with the intent to cure the infection (that is, palliative care is an exclusion).\"\n                }\n              }\n            },\n            \"right\": {\n              \"OR\": {\n                \"left\": {\n                  \"raw_text\": \"Pregnancy\"\n                },\n                \"right\": {\n                  \"raw_text\": \"or breast-feeding.\"\n                }\n              }\n            }\n          }\n        }\n      }\n    }\n  }\n}"