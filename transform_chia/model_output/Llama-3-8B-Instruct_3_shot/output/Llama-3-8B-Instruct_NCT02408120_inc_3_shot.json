"{\n  \"AND\": {\n    \"left\": {\n      \"OR\": {\n        \"left\": {\n          \"raw_text\": \"Subjects admitted to the hospital with acute\"\n        },\n        \"right\": {\n          \"OR\": {\n            \"left\": {\n              \"raw_text\": \"or chronic medical illnesses\"\n            },\n            \"right\": {\n              \"OR\": {\n                \"left\": {\n                  \"raw_text\": \"or for elective and emergency surgical illness\"\n                },\n                \"right\": {\n                  \"raw_text\": \"or trauma\"\n                }\n              }\n            }\n          }\n        }\n      }\n    },\n    \"right\": {\n      \"AND\": {\n        \"left\": {\n          \"raw_text\": \"Known history of Type 2 diabetes mellitus for >3 months\"\n        },\n        \"right\": {\n          \"AND\": {\n            \"left\": {\n              \"raw_text\": \"Treated with either diet alone, any combination of oral antidiabetic agents, non-insulin injectables or insulin therapy\"\n            },\n            \"right\": {\n              \"AND\": {\n                \"left\": {\n                  \"AND\": {\n                    \"left\": {\n                      \"raw_text\": \"Blood glucose levels between\"\n                    },\n                    \"right\": {\n                      \"raw_text\": \">140 mg and <400 mg/dL\"\n                    }\n                  }\n                },\n                \"right\": {\n                  \"NOT\": {\n                    \"left\": {\n                      \"raw_text\": \"without laboratory evidence of diabetic ketoacidosis\"\n                    }\n                  }\n                }\n              }\n            }\n          }\n        }\n      }\n    }\n  }\n}"