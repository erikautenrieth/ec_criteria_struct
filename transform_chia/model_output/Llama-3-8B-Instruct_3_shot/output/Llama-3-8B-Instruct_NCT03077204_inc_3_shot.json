"{\n  \"AND\": {\n    \"left\": {\n      \"AND\": {\n        \"left\": {\n          \"raw_text\": \"Age>18 years\"\n        },\n        \"right\": {\n          \"AND\": {\n            \"left\": {\n              \"raw_text\": \"Scheduled 1 or 2-level ACDF spine surgery\"\n            },\n            \"right\": {\n              \"AND\": {\n                \"left\": {\n                  \"raw_text\": \"The capacity to provide informed consent.\"\n                },\n                \"right\": {\n                  \"AND\": {\n                    \"left\": {\n                      \"OR\": {\n                        \"left\": {\n                          \"raw_text\": \"Degenerative Disc Disease\"\n                        },\n                        \"right\": {\n                          \"raw_text\": \"(as defined by neck pain of discogenic origin with degeneration of the disc confirmed by patient history and radiographic studies)\"\n                        }\n                      }\n                    },\n                    \"right\": {\n                      \"OR\": {\n                        \"left\": {\n                          \"raw_text\": \"Trauma\"\n                        },\n                        \"right\": {\n                          \"OR\": {\n                            \"left\": {\n                              \"raw_text\": \"(including fractures)\"\n                            },\n                            \"right\": {\n                              \"OR\": {\n                                \"left\": {\n                                  \"raw_text\": \"Tumors\"\n                                },\n                                \"right\": {\n                                  \"OR\": {\n                                    \"left\": {\n                                      \"raw_text\": \"Deformities or curvatures\"\n                                    },\n                                    \"right\": {\n                                      \"