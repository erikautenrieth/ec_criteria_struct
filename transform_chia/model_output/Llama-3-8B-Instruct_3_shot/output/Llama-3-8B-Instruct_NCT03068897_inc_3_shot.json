"{\n  \"AND\": {\n    \"left\": {\n      \"AND\": {\n        \"left\": {\n          \"raw_text\": \"Present to ED primary for management of LBP, defined as pain originating between the lower border of the scapulae and the upper gluteal folds.\"\n        },\n        \"right\": {\n          \"NOT\": {\n            \"left\": {\n              \"OR\": {\n                \"left\": {\n                  \"raw_text\": \"Flank pain, that is pain originating from tissues lateral to the paraspinal muscles, will not be included.\"\n                }\n              }\n            }\n          }\n        }\n      }\n    },\n    \"right\": {\n      \"AND\": {\n        \"left\": {\n          \"raw_text\": \"Musculoskeletal etiology of low back.\"\n        },\n        \"right\": {\n          \"NOT\": {\n            \"left\": {\n              \"OR\": {\n                \"left\": {\n                  \"raw_text\": \"non-musculoskeletal etiologies such as urinary tract infection, ovarian cysts, or influenza like illness will be excluded.\"\n                }\n              }\n            }\n          }\n        }\n      }\n    }\n  },\n  \"AND\": {\n    \"left\": {\n      \"AND\": {\n        \"left\": {\n          \"raw_text\": \"Patient is to be discharged home.\"\n        },\n        \"right\": {\n          \"NOT\": {\n            \"left\": {\n              \"raw_text\": \"Patients admitted to the hospital are more likely to be treated with parenteral medication and therefore are not appropriate for this study.\"\n            }\n          }\n        }\n      }\n    },\n    \"right\": {\n      \"AND\": {\n        \"left\": {\n          \"raw_text\": \"Age 18-64 Enrollment will be limited to adults younger than 65 years because of the increased risk of adverse medication effects in the elderly.\"\n        }\n      }\n    }\n  },\n  \"AND\": {\n    \"left\": {\n      \"AND\": {\n        \"left\": {\n          \"raw_text\": \"Non-radicular pain.\"\n        },\n        \"right\": {\n          \"NOT\": {\n            \"left\": {\n              \"raw_text\": \"Patients will be excluded if the pain radiates below the gluteal folds in a radicular pattern.\"\n            }\n          }\n        }\n      }\n    },\n    \"right\": {\n      \"AND\": {\n        \"left\": {\n          \"raw_text\": \"Pain duration <2 weeks (336 hours).\"\n        },\n        \"right\": {\n          \"NOT\": {\n            \"left\": {\n              \"raw_text\": \"Patients with more than two weeks of pain are at increased risk of poor pain and functional outcomes.(9)\"\n            }\n          }\n        }\n      }\n    }\n  },\n  \"AND\": {\n    \"left\": {\n      \"AND\": {\n        \"left\": {\n          \"raw_text\": \"Prior to the acute attack of LBP, back pain cannot occur more frequently than once per month.\"\n        },\n        \"right\": {\n          \"NOT\": {\n            \"left\": {\n              \"raw_text\": \"Patients with more frequent back pain are at increased risk of poor pain and functional outcomes.(9)\"\n            }\n          }\n        }\n      }\n    },\n    \"right\": {\n      \"AND\": {\n        \"left\": {\n          \"raw_text\": \"Non-traumatic LBP: no substantial and direct trauma to the back within the previous month\"\n        },\n        \"right\": {\n          \"AND\": {\n            \"left\": {\n              \"raw_text\": \"Functionally impairing back pain: A baseline score of > 5 on the Roland-Morris Disability Questionnaire\"\n            }\n          }\n        }\n      }\n    }\n  }\n}"