"{\n  \"AND\": {\n    \"left\": {\n      \"OR\": {\n        \"left\": {\n          \"raw_text\": \"Coagulopathies (with prothrombin concentration less than 60% or INR more than 1.5)\"\n        }\n      }\n    },\n    \"right\": {\n      \"AND\": {\n        \"left\": {\n          \"raw_text\": \"In-ability to postpone anti-coagulation medications.\"\n        },\n        \"right\": {\n          \"OR\": {\n            \"left\": {\n              \"raw_text\": \"Infection or injury or a lesion at the block site.\"\n            },\n            \"right\": {\n              \"raw_text\": \"Suspected cervical vertebral column injury necessitating using a neck collar.\"\n            }\n          }\n        }\n      }\n    }\n  },\n  \"AND\": {\n    \"left\": {\n      \"OR\": {\n        \"left\": {\n          \"raw_text\": \"A compromised lung on the contralateral side of the block (Pneumothorax, hemothorax or Pneumonectomy).\"\n        }\n      }\n    },\n    \"right\": {\n      \"AND\": {\n        \"left\": {\n          \"raw_text\": \"Traumatic vascular injuries or operative interventions (Surgical harvesting) involving arteries of the upper limb on the operative side.\"\n        },\n        \"right\": {\n          \"OR\": {\n            \"left\": {\n              \"raw_text\": \"Patients with communication difficulties.\"\n            },\n            \"right\": {\n              \"OR\": {\n                \"left\": {\n                  \"raw_text\": \"Hypersensitivity to local anesthetics and/or Dexamethasone.\"\n                },\n                \"right\": {\n                  \"raw_text\": \"Patients on perioperative intravenous (IV) steroids.\"\n                }\n              }\n            }\n          }\n        }\n      }\n    }\n  }\n}"