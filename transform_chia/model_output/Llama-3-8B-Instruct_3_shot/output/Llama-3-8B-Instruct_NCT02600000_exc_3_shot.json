"{\n  \"AND\": {\n    \"left\": {\n      \"OR\": {\n        \"left\": {\n          \"raw_text\": \"Unstable angina;\"\n        },\n        \"right\": {\n          \"OR\": {\n            \"left\": {\n              \"raw_text\": \"Myocardial infarction\"\n            },\n            \"right\": {\n              \"AND\": {\n                \"left\": {\n                  \"raw_text\": \"and heart surgery\"\n                },\n                \"right\": {\n                  \"raw_text\": \"up to three months before the survey;\"\n                }\n              }\n            }\n          }\n        }\n      }\n    },\n    \"right\": {\n      \"OR\": {\n        \"left\": {\n          \"raw_text\": \"Chronic respiratory diseases;\"\n        },\n        \"right\": {\n          \"OR\": {\n            \"left\": {\n              \"raw_text\": \"Hemodynamic instability;\"\n            },\n            \"right\": {\n              \"OR\": {\n                \"left\": {\n                  \"raw_text\": \"Trauma recent face,\"\n                },\n                \"right\": {\n                  \"AND\": {\n                    \"left\": {\n                      \"raw_text\": \"nausea and vomiting.\"\n                    }\n                  }\n                }\n              }\n            }\n          }\n        }\n      }\n    }\n  },\n  \"AND\": {\n    \"left\": {\n      \"OR\": {\n        \"left\": {\n          \"raw_text\": \"Orthopedic and neurological diseases\"\n        },\n        \"right\": {\n          \"raw_text\": \"that may preclude the achievement of the cardiopulmonary test and Cardiac Rehabilitation exercises;\"\n        }\n      }\n    },\n    \"right\": {\n      \"OR\": {\n        \"left\": {\n          \"raw_text\": \"Psychological and / or cognitive impairments\"\n        },\n        \"right\": {\n          \"raw_text\": \"that restrict them to respond to questionnaires;\"\n        }\n      }\n    }\n  }\n}"