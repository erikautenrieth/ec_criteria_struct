"{\n  \"AND\": {\n    \"left\": {\n      \"raw_text\": \"Female with a persisting pregnancy of unknown location:\"\n    },\n    \"right\": {\n      \"AND\": {\n        \"left\": {\n          \"raw_text\": \"A pregnancy of unknown location is defined as a pregnancy in a woman with a positive pregnancy test but no definitive signs of pregnancy in the uterus or adnexa on ultrasound imaging.\"\n        },\n        \"right\": {\n          \"AND\": {\n            \"left\": {\n              \"raw_text\": \"A definitive sign of gestation includes ultrasound visualization of a gestational sac with a yolk sac (with or without an embryo) in the uterus or in the adnexa.\"\n            },\n            \"right\": {\n              \"AND\": {\n                \"left\": {\n                  \"raw_text\": \"Ultrasound must be performed within 7 days prior to randomization.\"\n                }\n              }\n            }\n          }\n        }\n      }\n    },\n    \"right\": {\n      \"AND\": {\n        \"left\": {\n          \"raw_text\": \"Persistence of hCG is defined as at least 2 serial hCG values (over 2-14 days), showing < 15% rise per day, or < 50% fall between the first and last value.\"\n        }\n      },\n      \"right\": {\n        \"AND\": {\n          \"left\": {\n            \"AND\": {\n              \"left\": {\n                \"raw_text\": \"Patient is hemodynamically stable,\"\n              },\n              \"right\": {\n                \"raw_text\": \"hemoglobin >10 mg/dL\"\n              }\n            }\n          },\n          \"right\": {\n            \"raw_text\": \"Greater than or 18 years of age\"\n          }\n        }\n      }\n    }\n  }\n}"