"{\n  \"AND\": {\n    \"left\": {\n      \"AND\": {\n        \"left\": {\n          \"AND\": {\n            \"left\": {\n              \"raw_text\": \"Adults (18 and older)\"\n            },\n            \"right\": {\n              \"AND\": {\n                \"left\": {\n                  \"raw_text\": \"with physiologically confirmed SA\"\n                },\n                \"right\": {\n                  \"OR\": {\n                    \"left\": {\n                      \"raw_text\": \"or mild-moderate asthma\"\n                    }\n                  }\n                }\n              }\n            }\n          },\n          \"right\": {\n            \"AND\": {\n              \"left\": {\n                \"raw_text\": \"and followed by an asthma specialist for at least 6 months.\"\n              }\n            }\n          }\n        }\n      },\n      \"right\": {\n        \"AND\": {\n          \"left\": {\n            \"raw_text\": \"Must agree to have regular clinic visits (minimum 3-4 per year for SA, 1-2 for mild-moderate asthma).\"\n          }\n        },\n        \"right\": {\n          \"AND\": {\n            \"left\": {\n              \"raw_text\": \"Must have good compliance with medications\"\n            },\n            \"right\": {\n              \"raw_text\": \"Patients with asthma and COPD.\"\n            }\n          }\n        }\n      }\n    }\n  }\n}"