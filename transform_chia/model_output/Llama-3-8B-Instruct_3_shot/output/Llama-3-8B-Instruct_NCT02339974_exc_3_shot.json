"{\n  \"AND\": {\n    \"left\": {\n      \"AND\": {\n        \"left\": {\n          \"raw_text\": \"Heart Team assessment of operability\"\n        },\n        \"right\": {\n          \"raw_text\": \"(the heart team considers the patient to be a good surgical candidate).\"\n        }\n      }\n    },\n    \"right\": {\n      \"AND\": {\n        \"left\": {\n          \"OR\": {\n            \"left\": {\n              \"raw_text\": \"Evidence of an acute myocardial infarction\"\n            },\n            \"right\": {\n              \"raw_text\": \"= 1 month (30 days) before the intended treatment [defined as: Q wave MI, or non-Q wave MI with total CK elevation of CK-MB = twice normal in the presence of MB elevation and/or troponin level elevation (WHO definition)].\"\n            }\n          }\n        },\n        \"right\": {\n          \"AND\": {\n            \"left\": {\n              \"raw_text\": \"Untreated, severe, left sided valvular heart disease including mitral regurgitation or stenosis, and aortic regurgitation or stenosis.\"\n            },\n            \"right\": {\n              \"AND\": {\n                \"left\": {\n                  \"raw_text\": \"Mean pulmonary artery pressures =40mmHG and PVR >4 woods units as assessed by right heart catheterization.\"\n                },\n                \"right\": {\n                  \"AND\": {\n                    \"left\": {\n                      \"raw_text\": \"Any therapeutic invasive cardiac procedure resulting in a permanent implant that is performed within 30 days of the index procedure. Examples of permanent implant would include any new heart valve. Implantation of a permanent pacemaker is excluded.\"\n                    },\n                    \"right\": {\n                      \"AND\": {\n                        \"left\": {\n                          \"OR\": {\n                            \"left\": {\n                              \"raw_text\": \"Patients with planned concomitant surgical or transcatheter ablation for Atrial Fibrillation.\"\n                            },\n                            \"right\": {\n                              \"OR\": {\n                                \"left\": {\n                                  \"raw_text\": \"Leukopenia (WBC < 3000 cell/mL), acute anemia (Hgb < 9 g/dL), Thrombocytopenia (Plt < 50,000 cell/mL).\"\n                                },\n                                \"right\": {\n                                  \"AND\": {\n                                    \"left\": {\n                                      \"raw_text\": \"Hemodynamic or respiratory instability requiring inotropic support, mechanical ventilation or mechanical heart assistance within 30 days of screening evaluation.\"\n                                    },\n                                    \"right\": {\n                                      \"AND\": {\n                                        \"left\": {\n                                          \"raw_text\": \"Need for emergency surgery for any reason.\"\n                                        },\n                                        \"right\": {\n                                          \"AND\": {\n                                            \"left\": {\n                                              \"raw_text\": \"Left ventricular ejection fraction <40%.\"\n                                            },\n                                            \"right\": {\n                                              \"AND\": {\n                                                \"left\": {\n                                                  \"raw_text\": \"Echocardiographic evidence of intracardiac mass, thrombus or vegetation.\"\n                                                },\n                                                \"right\": {\n                                                  \"AND\": {\n                                                    \"left\": {\n                                                      \"raw_text\": \"Active upper GI bleeding within 3 months (90 days) prior to procedure.\"\n                                                    },\n                                                    \"right\": {\n                                                      \"AND\": {\n                                                        \"left\": {\n                                                          \"raw_text\": \"A known contraindication or hypersensitivity to all anticoagulation regimens, or inability to be anticoagulated for the study procedure.\"\n                                                        },\n                                                        \"right\": {\n                                                          \"AND\": {\n                                                            \"left\": {\n                                                              \"raw_text\": \"Recent CVA clinically confirmed (by neurologist) or neuroimaging confirmed stroke or transient ischemic attack (TIA) within 6 months (180 days) of the procedure.\"\n                                                            },\n                                                            \"right\": {\n                                                              \"AND\": {\n                                                                \"left\": {\n                                                                  \"raw_text\": \"Estimated life expectancy < 1 year from conditions other than TR.\"\n                                                                },\n                                                                \"right\": {\n                                                                  \"AND\": {\n                                                                    \"left\": {\n                                                                      \"raw_text\": \"Expectation that patient will not improve despite treatment of tricuspid regurgitation\"\n                                                                    },\n                                                                    \"right\": {\n                                                                      \"AND\": {\n                                                                        \"left\": {\n                                                                          \"raw_text\": \"Currently participating in another investigational cardiac device study or any other clinical trial, including drugs or biologics. Note: Trials requiring extended follow-up for products that were investigational, but have since become commercially available, are not considered investigational trials.\"\n                                                                        },\n                                                                        \"right\": {\n                                                                          \"AND\": {\n                                                                            \"left\": {\n                                                                              \"raw_text\": \"Active bacterial endocarditis within 6 months (180 days) of procedure.\"\n                                                                            },\n                                                                            \"right\": {\n                                                                              \"AND\": {\n                                                                                \"left\": {\n                                                                                  \"raw_text\": \"Patients with signs or symptoms of SVC syndrome, or hepatic cirrhosis not felt due to passive congestion from TR.\"\n                                                                                }\n                                                                              }\n                                                                            }\n                                                                          }\n                                                                        }\n                                                                      }\n                                                                    }\n                                                                  }\n                                                                }\n                                                              }\n                                                            }\n                                                          }\n                                                        }\n                                                      }\n                                                    }\n                                                  }\n                                                }\n                                              }\n                                            }\n                                          }\n                                        }\n                                      }\n                                    }\n                                  }\n                                }\n                              }\n                            }\n                          }\n                        }\n                      }\n                    }\n                  }\n                }\n              }\n            }\n          }\n        }\n      }\n    }\n  }\n}"