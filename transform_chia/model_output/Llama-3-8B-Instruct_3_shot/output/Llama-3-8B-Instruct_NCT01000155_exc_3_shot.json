"{\n  \"AND\": {\n    \"left\": {\n      \"OR\": {\n        \"left\": {\n          \"raw_text\": \"Subjects with hemoglobin SC or SB+ thalassemia\"\n        },\n        \"right\": {\n          \"raw_text\": \"Subjects on chronic transfusion program\"\n        }\n      }\n    },\n    \"right\": {\n      \"AND\": {\n        \"left\": {\n          \"NOT\": {\n            \"left\": {\n              \"raw_text\": \"Subjects who have received RBC transfusions cannot have >15% adult hemoglobin\"\n            }\n          }\n        },\n        \"right\": {\n          \"AND\": {\n            \"left\": {\n              \"OR\": {\n                \"left\": {\n                  \"raw_text\": \"Known positive status for HIV\"\n                },\n                \"right\": {\n                  \"OR\": {\n                    \"left\": {\n                      \"raw_text\": \"active hepatitis B\"\n                    },\n                    \"right\": {\n                      \"raw_text\": \"or hepatitis C\"\n                    }\n                  }\n                }\n              }\n            },\n            \"right\": {\n              \"AND\": {\n                \"left\": {\n                  \"OR\": {\n                    \"left\": {\n                      \"raw_text\": \"Pregnant\"\n                    },\n                    \"right\": {\n                      \"raw_text\": \"or breast feeding women\"\n                    }\n                  }\n                },\n                \"right\": {\n                  \"AND\": {\n                    \"left\": {\n                      \"raw_text\": \"Individuals with a history of malignancy are ineligible except for the following circumstances.\"\n                    },\n                    \"right\": {\n                      \"AND\": {\n                        \"left\": {\n                          \"raw_text\": \"Individuals with a history of malignancy are eligible if they have been disease-free for at least 5 years and ar