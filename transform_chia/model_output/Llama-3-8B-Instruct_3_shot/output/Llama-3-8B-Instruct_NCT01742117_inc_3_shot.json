"{\n  \"AND\": {\n    \"left\": {\n      \"AND\": {\n        \"left\": {\n          \"raw_text\": \"Patient >18 years of age\"\n        },\n        \"right\": {\n          \"AND\": {\n            \"left\": {\n              \"OR\": {\n                \"left\": {\n                  \"raw_text\": \"Patient presents with acute coronary syndrome\"\n                },\n                \"right\": {\n                  \"raw_text\": \"or stable coronary artery disease\"\n                }\n              }\n            },\n            \"right\": {\n              \"AND\": {\n                \"left\": {\n                  \"raw_text\": \"Patient is eligible for PCI\"\n                },\n                \"right\": {\n                  \"AND\": {\n                    \"left\": {\n                      \"raw_text\": \"Patient is willing and able to provide informed written consent\"\n                    },\n                    \"right\": {\n                      \"NOT\": {\n                        \"left\": {\n                          \"OR\": {\n                            \"left\": {\n                              \"raw_text\": \"Patient not able to receive 12 months of dual anti-platelet therapy\"\n                            },\n                            \"right\": {\n                              \"OR\": {\n                                \"left\": {\n                                  \"raw_text\": \"Failure of index PCI\"\n                                },\n                                \"right\": {\n                                  \"OR\": {\n                                    \"left\": {\n                                      \"raw_text\": \"Patient or physician refusal to enroll in the study\"\n                                    },\n                                    \"right\": {\n                                      \"raw_text\": \"Patient with known CYP2C19 genotype prior to randomization\"\n                                    }\n                                  }\n                                }\n                              }\n                            }\n                          }\n                        }\n                      }\n                    }\n                  }\n                }\n              }\n            }\n          }\n        }\n      }\n    },\n    \"right\": {\n      \"AND\": {\n        \"left\": {\n          \"NOT\": {\n            \"left\": {\n              \"OR\": {\n                \"left\": {\n                  \"raw_text\": \"Planned revascularization of any vessel within 30 days post-index procedure and/or of the target vessel(s) within 12 months post-procedure\"\n                },\n                \"right\": {\n                  \"OR\": {\n                    \"left\": {\n                      \"raw_text\": \"Anticipated discontinuation of clopidogrel or ticagrelor within the 12 month follow up period, example for elective surgery\"\n                    },\n                    \"right\": {\n                      \"OR\": {\n                        \"left\": {\n                          \"raw_text\": \"Serum creatinine >2.5 mg/dL within 7 days of index procedure\"\n                        },\n                        \"right\": {\n                          \"OR\": {\n                            \"left\": {\n                              \"raw_text\": \"Platelet count <80,000 or >700,000 cells/mm3, or white blood cell count <3,000 cells/mm3 if persistent (at least 2 abnormal values) within 7 days prior to index procedure.\"\n                            },\n                            \"right\": {\n                              \"OR\": {\n                                \"left\": {\n                                  \"raw_text\": \"History of intracranial hemorrhage\"\n                                },\n                                \"right\": {\n                                  \"OR\": {\n                                    \"left\": {\n                                      \"raw_text\": \"Known hypersensitivity to clopidogrel or ticagrelor or any of its components\"\n                                    },\n                                    \"right\": {\n                                      \"OR\": {\n                                        \"left\": {\n                                          \"raw_text\": \"Patient is participating in an investigational drug or device clinical trial that has not reached its primary endpoint\"\n                                        },\n                                        \"right\": {\n                                          \"OR\": {\n                                            \"left\": {\n                                              \"raw_text\": \"Patient previously enrolled in this study\"\n                                            },\n                                            \"right\": {\n                                              \"OR\": {\n                                                \"left\": {\n                                                  \"raw_text\": \"Patient is pregnant, lactating, or planning to become pregnant within 12 months\"\n                                                },\n                                                \"right\": {\n                                                  \"OR\": {\n                                                    \"left\": {\n                                                      \"raw_text\": \"Patient has received an organ transplant or is on a waiting list for an organ transplant\"\n                                                    },\n                                                    \"right\": {\n                                                      \"OR\": {\n                                                        \"left\": {\n                                                          \"raw_text\": \"Patient is receiving or scheduled to receive chemotherapy within 30 days before or after the procedure\"\n                                                        },\n                                                        \"right\": {\n                                                          \"OR\": {\n                                                            \"left\": {\n                                                              \"raw_text\": \"Patient is receiving immunosuppressive therapy or has known immunosuppressive or autoimmune disease (e.g., human immunodeficiency virus, systemic lupus erythematous, etc.)\"\n                                                            },\n                                                            \"right\": {\n                                                              \"OR\": {\n                                                                \"left\": {\n                                                                  \"raw_text\": \"Patient is receiving chronic oral anticoagulation therapy (i.e., vitamin K antagonist, direct thrombin inhibitor, Factor Xa inhibitor)\"\n                                                                },\n                                                                \"right\": {\n                                                                  \"OR\": {\n                                                                    \"left\": {\n                                                                      \"raw_text\": \"Concomitant use of simvastatin/lovastatin > 40 mg qd\"\n                                                                    },\n                                                                    \"right\": {\n                                                                      \"OR\": {\n                                                                        \"left\": {\n                                                                          \"raw_text\": \"Concomitant use of potent CYP3A4 inhibitors (atazanavir, clarithromycin, indinavir, itraconazole, ketoconazole, nefazodon