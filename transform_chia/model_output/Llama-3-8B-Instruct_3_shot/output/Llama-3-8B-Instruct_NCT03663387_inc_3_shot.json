"{\n  \"AND\": {\n    \"left\": {\n      \"AND\": {\n        \"left\": {\n          \"AND\": {\n            \"left\": {\n              \"raw_text\": \"Male\"\n            },\n            \"right\": {\n              \"raw_text\": \"and female subjects\"\n            }\n          },\n          \"right\": {\n            \"AND\": {\n              \"left\": {\n                \"raw_text\": \"between 40-85 years old\"\n              },\n              \"right\": {\n                \"NOT\": {\n                  \"left\": {\n                    \"raw_text\": \"will be enrolled. Younger subjects are not included as the risk for brain amyloid lesions is too low\"\n                  }\n                }\n              }\n            }\n          }\n        }\n      },\n      \"right\": {\n        \"AND\": {\n          \"left\": {\n            \"AND\": {\n              \"left\": {\n                \"raw_text\": \"All subjects will speak English as their first language\"\n              },\n              \"right\": {\n                \"OR\": {\n                  \"left\": {\n                    \"raw_text\": \"or demonstrate proficiency in English (defined as reaching a scaled score of > 11 on the WAIS vocabulary test)\"\n                  }\n                }\n              }\n            }\n          },\n          \"right\": {\n            \"AND\": {\n              \"left\": {\n                \"AND\": {\n                  \"left\": {\n                    \"raw_text\": \"All subjects will have normal cognition at baseline:\"\n                  },\n                  \"right\": {\n                    \"AND\": {\n                      \"left\": {\n                        \"raw_text\": \"a Clinical Dementia Rating CDR=0, Global Deterioration Scale GDS<2.\"\n                      }\n                    }\n                  }\n                }\n              },\n              \"right\": {\n                \"AND\": {\n                  \"left\": {\n                    \"raw_text\": \"All subjects will be in good general health and able to participate in the LP and imaging exams.\"\n                  },\n                  \"right\": {\n                    \"raw_text\": \"This determination is made by the study neurologist and reviewed at a consensus meeting for each subject.\"\n                  }\n                }\n              }\n            }\n          }\n        }\n      }\n    }\n  }\n}"