"{\n  \"AND\": {\n    \"left\": {\n      \"AND\": {\n        \"left\": {\n          \"raw_text\": \"Patients with chronic heart failure\"\n        },\n        \"right\": {\n          \"OR\": {\n            \"left\": {\n              \"raw_text\": \"of New York Heart Association Class II\"\n            },\n            \"right\": {\n              \"raw_text\": \"or III\"\n            }\n          }\n        }\n      },\n      \"right\": {\n        \"AND\": {\n          \"left\": {\n            \"raw_text\": \"a left ventricular ejection fraction of\"\n          },\n          \"right\": {\n            \"OR\": {\n              \"left\": {\n                \"raw_text\": \"= 40% for patients in NYHA class II\"\n                },\n              \"right\": {\n                \"raw_text\": \"or = 45% for patients in NYHA class III\"\n                }\n              }\n            }\n          }\n        }\n      }\n    },\n    \"right\": {\n      \"AND\": {\n        \"left\": {\n          \"AND\": {\n            \"left\": {\n              \"raw_text\": \"a hemoglobin level at the screening visit\"\n            },\n            \"right\": {\n              \"raw_text\": \"between 9.5-13.5 g/dl\"\n            }\n          }\n        },\n        \"right\": {\n          \"AND\": {\n            \"left\": {\n              \"raw_text\": \"and iron deficiency, which is defined as\"\n            },\n            \"right\": {\n              \"OR\": {\n                \"left\": {\n                  \"raw_text\": \"serum ferritin level < 100µg/l\"\n                },\n                \"right\": {\n                  \"AND\": {\n                    \"left\": {\n                      \"raw_text\": \"or between 100 and 299 µg/l\"\n                    },\n                    \"right\": {\n                      \"raw_text\": \"when transferring saturation is < 20%\"\n                    }\n                  }\n                }\n              }\n            }\n          }\n        }\n      }\n    }\n  },\n  \"AND\": {\n    \"left\": {\n      \"raw_text\": \"Age =18 years\"\n    },\n    \"right\": {\n      \"AND\": {\n        \"left\": {\n          \"raw_text\": \"Obtained informed consent\"\n        },\n        \"right\": {\n          \"raw_text\": \"Stable pharmacological therapy during the last 4 weeks (with the exception of diuretics)\"\n        }\n      }\n    }\n  }\n}"