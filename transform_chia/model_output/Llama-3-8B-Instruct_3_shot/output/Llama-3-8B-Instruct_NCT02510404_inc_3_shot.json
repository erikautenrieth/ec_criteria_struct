"{\n  \"OR\": {\n    \"left\": {\n      \"raw_text\": \"1. Diagnosis of primary immunodeficiency with established plan to undergo myeloablative or non-myeloablative allogeneic hematopoietic stem cell transplant for treatment thereof or diagnosis of a form of primary immunodeficiency for which hematopoietic stem cell transplantation is not indicated.\"\n    },\n    \"right\": {\n      \"AND\": {\n        \"left\": {\n          \"raw_text\": \"2. Active infection with EBV, CMV, and/or Adenovirus, unable to be successfully controlled with standard therapy.\"\n        },\n        \"right\": {\n          \"NOT\": {\n            \"left\": {\n              \"raw_text\": \"3. Steroids less than 0.5 mg/kg/day prednisone\"\n            }\n          }\n        }\n      }\n    }\n  },\n  \"AND\": {\n    \"left\": {\n      \"AND\": {\n        \"left\": {\n          \"raw_text\": \"4. Karnofsky/Lansky score of ≥ 50\"\n        },\n        \"right\": {\n          \"AND\": {\n            \"left\": {\n              \"raw_text\": \"5. ANC greater than 500/µL.\"\n            },\n            \"right\": {\n              \"AND\": {\n                \"left\": {\n                  \"raw_text\": \"6. Bilirubin <2x, AST <3x, Serum creatinine <2x upper limit of normal, Hgb >8.0\"\n                }\n              }\n            }\n          }\n        }\n      },\n      \"right\": {\n        \"AND\": {\n          \"left\": {\n            \"raw_text\": \"7. Pulse oximetry of > 90% on room air\"\n          },\n          \"right\": {\n            \"AND\": {\n              \"left\": {\n                \"raw_text\": \"8. Negative pregnancy test (if female of childbearing potential)\"\n              },\n              \"right\": {\n                \"AND\": {\n                  \"left\": {\n                    \"raw_text\": \"9. Patient or parent/guardian capable of providing informed consent.\"\n                  }\n                }\n              }\n            }\n          }\n        }\n      }\n    }\n  }\n}"