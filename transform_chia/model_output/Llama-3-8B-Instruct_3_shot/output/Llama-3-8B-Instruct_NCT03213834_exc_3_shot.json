"{\n  \"AND\": {\n    \"left\": {\n      \"OR\": {\n        \"left\": {\n          \"raw_text\": \"age <18 years;\"\n        },\n        \"right\": {\n          \"OR\": {\n            \"left\": {\n              \"raw_text\": \"Pregnancy\"\n            },\n            \"right\": {\n              \"raw_text\": \"or inability to give informed written consent;\"\n            }\n          }\n        }\n      }\n    },\n    \"right\": {\n      \"AND\": {\n        \"left\": {\n          \"OR\": {\n            \"left\": {\n              \"raw_text\": \"previous thoracic surgery or thrombolytic therapy for pleural infection;\"\n            },\n            \"right\": {\n              \"raw_text\": \"medical thoracoscopy cannot be performed within 48 hours;\"\n            }\n          }\n        },\n        \"right\": {\n          \"AND\": {\n            \"left\": {\n              \"OR\": {\n                \"left\": {\n                  \"raw_text\": \"inability to tolerate procedure due to hemodynamic instability or severe hypoxemia;\"\n                },\n                \"right\": {\n                  \"raw_text\": \"inability to correct coagulopathy;\"\n                }\n              }\n            },\n            \"right\": {\n              \"raw_text\": \"presence of a homogeneously echogenic effusion on pleural US27 -\"\n            }\n          }\n        }\n      }\n    }\n  }\n}"