"{\n  \"AND\": {\n    \"left\": {\n      \"OR\": {\n        \"left\": {\n          \"raw_text\": \"Abdominal\"\n        },\n        \"right\": {\n          \"raw_text\": \"and complex cervical cerclage (e.g. bulging bag)\"\n        }\n      }\n    },\n    \"right\": {\n      \"AND\": {\n        \"left\": {\n          \"raw_text\": \"Contraindication to neuraxial anesthesia\"\n        },\n        \"right\": {\n          \"AND\": {\n            \"left\": {\n              \"OR\": {\n                \"left\": {\n                  \"raw_text\": \"Known hypersensitivity to chloroprocaine\"\n                },\n                \"right\": {\n                  \"OR\": {\n                    \"left\": {\n                      \"raw_text\": \"(a.k.a. Ester allergy), paraaminobenzoic acid (PABA)\"\n                    },\n                    \"right\": {\n                      \"raw_text\": \"or bupivacaine (a.k.a. Amide allergy)\"\n                    }\n                  }\n                }\n              }\n            },\n            \"right\": {\n              \"OR\": {\n                \"left\": {\n                  \"raw_text\": \"Pseudocholinesterase deficiency\"\n                },\n                \"right\": {\n                  \"raw_text\": \"Concomitant use with ergot-type oxytocic drugs\"\n                }\n              }\n            }\n          }\n        }\n      }\n    }\n  }\n}"