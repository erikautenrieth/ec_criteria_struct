"{\n  \"OR\": {\n    \"left\": {\n      \"raw_text\": \"Pregnancy (a negative serum or urine pregnancy test should be available for women of child-bearing potential before study inclusion) or lactation\"\n    }\n  }\n},\n{\n  \"AND\": {\n    \"left\": {\n      \"AND\": {\n        \"left\": {\n          \"raw_text\": \"Women of childbearing potential\"\n        },\n        \"right\": {\n          \"NOT\": {\n            \"left\": {\n              \"raw_text\": \"who do not practice a medically accepted highly effective contraception during the trial and one month beyond\"\n            }\n          }\n        }\n      }\n    },\n    \"right\": {\n      \"AND\": {\n        \"left\": {\n          \"OR\": {\n            \"left\": {\n              \"raw_text\": \"History of hypersensitivity to the investigational medicinal product\"\n            },\n            \"right\": {\n              \"OR\": {\n                \"left\": {\n                  \"raw_text\": \"or to any drug with similar chemical structure\"\n                },\n                \"right\": {\n                  \"OR\": {\n                    \"left\": {\n                      \"raw_text\": \"or to any excipient present in the pharmaceutical form of the investigational medicinal product\"\n                    }\n                  }\n                }\n              }\n            }\n          },\n          \"right\": {\n            \"AND\": {\n              \"left\": {\n                \"raw_text\": \"Participation in another clinical trial during the present clinical trial or within the last three months\"\n              },\n              \"right\": {\n                \"AND\": {\n                  \"left\": {\n                    \"raw_text\": \"Medical or psychological condition that would not permit completion of the trial or signing of informed consent\"\n                  },\n                  \"right\": {\n                    \"AND\": {\n                      \"left\": {\n                        \"raw_text\": \"Use of a fibrinolytic agent, surgical thrombectomy, interventional (catheter-directed) thrombus aspiration or lysis, or use of a cava filter to treat the index episode of PE\"\n                      },\n                      \"right\": {\n                        \"AND\": {\n                          \"left\": {\n                            \"raw_text\": \"Treatment with any therapeutically dosed anticoagulant for more than 48 hours prior to enrolment\"\n                          },\n                          \"right\": {\n                            \"AND\": {\n                              \"left\": {\n                                \"raw_text\": \"Need for long-term treatment with a low molecular weight heparin, vitamin K antagonists or NOAC, for an indication other than the index PE episode, or for antiplatelet agents except acetylsalicylic acid at a dosage =100 mg/day;\"\n                              },\n                              \"right\": {\n                                \"AND\": {\n                                  \"left\": {\n                                    \"raw_text\": \"Active bleeding or known significant bleeding risk (e.g., gastrointestinal ulcer, malignant neoplasms, injuries or recent surgeries of the brain, spinal cord or eyes, recent intracranial bleedings, known or suspected esophagus varices, aneurysms or intraspinal or intracranial vascular abnormalities)\"\n                                  },\n                                  \"right\": {\n                                    \"AND\": {\n                                      \"left\": {\n                                        \"raw_text\": \"Artificial heart valves requiring treatment with an anticoagulant\"\n                                      },\n                                      \"right\": {\n                                        \"AND\": {\n                                          \"left\": {\n                                            \"raw_text\": \"Renal insufficiency with estimated creatinine clearance <30 ml/min/1.73m2\"\n                                          },\n                                          \"right\": {\n                                            \"AND\": {\n                                              \"left\": {\n                                                \"raw_text\": \"Chronic liver disease with aminotransferase levels two times or more above the local upper limit of normal range\"\n                                              },\n                                              \"right\": {\n                                                \"AND\": {\n                                                  \"left\": {\n                                                    \"raw_text\": \"Concomitant administration of strong inhibitors of P-glycoprotein like ketoconazole, cyclosporin, itraconazole or dronedarone\"\n                                                  },\n                                                  \"right\": {\n                                                    \"AND\": {\n                                                      \"left\": {\n                                                        \"raw_text\": \"Unwillingness or inability to adhere to treatment or to the follow-up visits\"\n                                                      },\n                                                      \"right\": {\n                                                        \"AND\": {\n                                                          \"left\": {\n                                                            \"raw_text\": \"Life expectancy less than 6 months\"\n                                                          }\n                                                        }\n                                                      }\n                                                    }\n                                                  }\n                                  