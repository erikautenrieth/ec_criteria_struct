"{\n  \"AND\": {\n    \"left\": {\n      \"OR\": {\n        \"left\": {\n          \"raw_text\": \"Anaphylactic reaction to a previous dose of TIV(trivalent influenza vaccine)\"\n        },\n        \"right\": {\n          \"AND\": {\n            \"left\": {\n              \"raw_text\": \"Known IgE( Immunoglobulin E)-mediated hypersensitivity to eggs\"\n            },\n            \"right\": {\n              \"OR\": {\n                \"left\": {\n                  \"raw_text\": \"manifested as hives, swelling of the mouth and throat, difficulty in breathing, hypotension, or shock\"\n                }\n              }\n            }\n          }\n        }\n      }\n    },\n    \"right\": {\n      \"AND\": {\n        \"left\": {\n          \"raw_text\": \"Guillain-Barré syndrome within eight weeks of a previous influenza vaccine\"\n        },\n        \"right\": {\n          \"OR\": {\n            \"left\": {\n              \"raw_text\": \"Anaphylactic reaction to neomycin\"\n            },\n            \"right\": {\n              \"AND\": {\n                \"left\": {\n                  \"raw_text\": \"Patients who have had influenza vaccine in two of the three previous years\"\n                }\n              }\n            }\n          }\n        }\n      }\n    }\n  }\n}"