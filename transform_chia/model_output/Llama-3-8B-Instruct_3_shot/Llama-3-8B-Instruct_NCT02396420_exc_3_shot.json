"{\n  \"AND\": {\n    \"left\": {\n      \"OR\": {\n        \"left\": {\n          \"raw_text\": \"History of prostate, bladder, or rectal cancer\"\n        },\n        \"right\": {\n          \"OR\": {\n            \"left\": {\n              \"raw_text\": \"History of transurethral resection of the prostate (TURP)\"\n            },\n            \"right\": {\n              \"OR\": {\n                \"left\": {\n                  \"raw_text\": \"open prostate surgery, or radiofrequency or microwave therapies\"\n                }\n              }\n            }\n          }\n        }\n      },\n      \"right\": {\n        \"OR\": {\n          \"left\": {\n            \"raw_text\": \"History of open bladder, rectosigmoid colon, or other pelvic surgery\"\n          },\n          \"right\": {\n            \"AND\": {\n              \"left\": {\n                \"raw_text\": \"Patient is unwilling to discontinue alpha blockers 1 month after study treatment\"\n              },\n              \"right\": {\n                \"raw_text\": \"Patient is unwilling to discontinue 5-alph reductase inhibitors 1 month after study treatment\"\n              }\n            }\n          }\n        }\n      }\n    },\n    \"right\": {\n      \"AND\": {\n        \"left\": {\n          \"OR\": {\n            \"left\": {\n              \"raw_text\": \"Neurogenic bladder or other neurologic disorder impacting bladder function such as Parkinson's disease, multiple sclerosis, cerebral vascular accident or diabetes\"\n            }\n          },\n          \"right\": {\n            \"OR\": {\n              \"left\": {\n                \"raw_text\": \"Any other confounding bladder or urethral pathology, including urethral stricture, bladder neck contracture, or bladder atonia\"\n              }\n            }\n          }\n        },\n        \"right\": {\n          \"OR\": {\n            \"left\": {\n              \"raw_text\": \"Active prostatitis or urinary tract infection\"\n            },\