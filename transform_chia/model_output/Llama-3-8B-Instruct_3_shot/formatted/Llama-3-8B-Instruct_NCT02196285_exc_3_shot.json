        "left": {
          "raw_text": "Serious adverse reaction to any vaccination, as respiratory difficulty, angioedema and anaphylaxis;"
        },
        "right": {
          "OR": {
            "left": {
              "raw_text": "Acute or chronic disease, as diabetes, heart disease, systemic arterial hypertension;"
            },
            "right": {
              "AND": {
                "left": {
                  "raw_text": "Use of anti-allergic with antigen injections in a maximum timeline of 14 days before the vaccination;"
                },
                "right": {
                  "OR": {
                    "left": {
                      "raw_text": "Use of immunoglobulin in the past 12 months before the study vaccination;"
                    },
                    "right": {
                      "OR": {
                        "left": {
                          "raw_text": "Use of blood products within 12 months before the vaccination;"
                        },
                        "right": {
                          "OR": {
                            "left": {
                              "raw_text": "Use of any vaccine type within 30 days before the vaccination of the study;"
                            },
                            "right": {
                              "AND": {
                                "left": {
                                  "raw_text": "Chronic use of any medication, except homeopathy, and trivial ones, as nasal physiologic solution and vitamins;"
                                },
                                "right": {
                                  "OR": {
                                    "left": {
                                      "raw_text": "Previous immunosuppressive or cytotoxic medication, in the last 6 months. Individuals who have made use of this kind of medication in non-immunosuppressant doses, as nasal corticosteroid for allergic rhinitis of topic corticosteroid for non-complicated dermatitis, for more than 14 days, are allowed to be included in the study."
                                    },
                                    "right": {
                                      "OR": {
                                        "left": {
                                          "raw_text": "Use of any kind of medication under investigation within one year before the vaccination."
                                        },
                                        "right": {
                                          "AND": {
                                            "left": {
                                              "raw_text": "Unstable asthma or which may have required urgent care, hospitalization or intubation within the last 2 years, or which requires use of oral or intravenous corticosteroid."
                                            },
                                            "right": {
                                              "OR": {
                                                "left": {
                                                  "raw_text": "Coagulopathies diagnosed by a physician or report of capillary fragility (ex: bruises or bleedings without justifiable cause;"
                                                },
                                                "right": {
                                                  "OR": {
                                                    "left": {
                                                      "raw_text": "Convulsions, except the ones caused by fever, before 2 years old;"
                                                    },
                                                    "right": {
                                                      "AND": {
                                                        "left": {
                                                          "raw_text": "Psychiatric disease which difficults the adherence to the protocol, such as psychosis, obsessive-compulsive disorders, bipolar disease under treatment, diseases which require treatment with lithium and suicidal ideas in the last 5 years from the inclusion;"
                                                        },
                                                        "right": {
                                                          "OR": {
                                                            "left": {
                                                              "raw_text": "Active malignant (p.e. any kind of cancer) or treated disease, to which the individual may relapse during the study;"
                                                            },
                                                            "right": {
                                                              "OR": {
                                                                "left": {
                                                                  "raw_text": "Asplenia (absence of spleen or its removal);"
                                                                },
                                                                "right": {
                                                                  "OR": {
                                                                    "left": {
                                                                      "raw_text": "Positive HIV in the screening examination of history of any immunosuppressant disease;"
                                                                    },
                                                                    "right": {
                                                                      "OR": {
                                                                        "left": {
                                                                          "raw_text": "Positive serology for C hepatitis in the screening evaluation;"
                                                                        },
                                                                        "right": {
                                                                          "OR": {
                                                                            "left": {
                                                                              "raw_text": "Positive Antigen HBs in the screening evaluation;"
                                                                            },
                                                                            "right": {
                                                                              "OR": {
                                                                                "left": {
                                                                                  "raw_text": "Alcoholism (CAGE criteria), used for detection of abusive drinkers or alcoholic, validated in the Brazilian population with sensibility of 88% and specificity of 83%, if two or more answers, among four possible, are afirmative(Mansur and Monteiro, 1983), or according to medical decision;"
                                                                                },
                                                                                "right": {
                                                                                  "OR": {
                                                                                    "left": {
                                                                                      "raw_text": "Abuse of illicit drugs, according to medical decision;"
                                                                                    },
                                                                                    "right": {
                                                                                      "OR": {
                                                                                        "left": {
                                                                                          "raw_text": "Acquired or congenital immunodeficiency;"
                                                                                        },
                                                                                        "right": {
                                                                                          "OR": {
                                                                                            "left": {
                                                                                              "raw_text": "Allergy to the vaccine compounds, as egg, neomycin and gelatin."
