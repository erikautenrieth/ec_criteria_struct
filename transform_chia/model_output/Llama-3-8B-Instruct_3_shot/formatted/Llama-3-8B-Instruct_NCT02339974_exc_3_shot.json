            }
          }
        },
        "right": {
          "AND": {
            "left": {
              "raw_text": "Untreated, severe, left sided valvular heart disease including mitral regurgitation or stenosis, and aortic regurgitation or stenosis."
            },
            "right": {
              "AND": {
                "left": {
                  "raw_text": "Mean pulmonary artery pressures =40mmHG and PVR >4 woods units as assessed by right heart catheterization."
