"{\n  \"AND\": {\n    \"left\": {\n      \"OR\": {\n        \"left\": {\n          \"raw_text\": \"Aged 18 years or older\"\n        },\n        \"right\": {\n          \"OR\": {\n            \"left\": {\n              \"raw_text\": \"male\"\n            },\n            \"right\": {\n              \"raw_text\": \"or female.\"\n            }\n          }\n        }\n      }\n    },\n    \"right\": {\n      \"AND\": {\n        \"left\": {\n          \"raw_text\": \"Systolic heart failure with New York Heart Association (NYHA) class II-III.\"\n        },\n        \"right\": {\n          \"AND\": {\n            \"left\": {\n              \"raw_text\": \"Left ventricular ejection fraction (LVEF) less than 40% by echocardiography during screening and randomization.\"\n            },\n            \"right\": {\n              \"AND\": {\n                \"left\": {\n                  \"raw_text\": \"SCH (TSH: upper limits of normal (ULN) -10mIU/L, and FT4 level within reference range).\"\n                },\n                \"right\": {\n                  \"AND\": {\n                    \"left\": {\n                      \"raw_text\": \"Having received standard HF therapy for at least 2 weeks, having reached target dose or max tolerable dose.\"\n                    },\n                    \"right\": {\n                      \"raw_text\": \"Provided informed consent.\"\n                    }\n                  }\n                }\n              }\n            }\n          }\n        }\n      }\n    }\n  }\n}"