"{\n  \"AND\": {\n    \"left\": {\n      \"AND\": {\n        \"left\": {\n          \"raw_text\": \"Established Osteoarthritis (Kellgren-Lawrence > 3)\"\n        },\n        \"right\": {\n          \"AND\": {\n            \"left\": {\n              \"raw_text\": \"Minimum joint space > 2 mm as measured on AP radiograph\"\n            },\n            \"right\": {\n              \"AND\": {\n                \"left\": {\n                  \"raw_text\": \"Hip dysplasia (center edge angle < 20° on AP radiograph)\"\n                },\n                \"right\": {\n                  \"NOT\": {\n                    \"left\": {\n                      \"OR\": {\n                        \"left\": {\n                          \"raw_text\": \"Patients with clinically significant cardiovascular, renal, hepatic, endocrine disease, cancer or diabetes\"\n                        },\n                        \"right\": {\n                          \"OR\": {\n                            \"left\": {\n                              \"raw_text\": \"Patients with ongoing infection including HIV and Hepatitis\"\n                            },\n                            \"right\": {\n                              \"raw_text\": \"Patient with history of osteomyelitis/septic arthritis\"\n                            }\n                          }\n                        }\n                      }\n                    }\n                  }\n                }\n              }\n            }\n          }\n        }\n      },\n      \"right\": {\n        \"AND\": {\n          \"left\": {\n            \"OR\": {\n              \"left\": {\n                \"raw_text\": \"Anticoagulation therapy\"\n              },\n              \"right\": {\n                \"OR\": {\n                  \"left\": {\n                    \"raw_text\": \"Patients who are pregnant or breast feeding\"\n                    },\n                    \"right\": {\n                      \"OR\": {\n                        \"le