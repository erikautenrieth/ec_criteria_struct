"{\n  \"AND\": {\n    \"left\": {\n      \"AND\": {\n        \"left\": {\n          \"raw_text\": \"Aged 5 years to less than 12 years at Visit 1.\"\n        },\n        \"right\": {\n          \"raw_text\": \"At least 15 (25%) children of the total study population must be aged 5 to less than 8 years.\"\n        }\n      }\n    },\n    \"right\": {\n      \"AND\": {\n        \"left\": {\n          \"OR\": {\n            \"left\": {\n              \"raw_text\": \"Male\"\n            },\n            \"right\": {\n              \"raw_text\": \"or pre-menarchial female subjects.\"\n            }\n          }\n        },\n        \"right\": {\n          \"AND\": {\n            \"left\": {\n              \"raw_text\": \"Subjects must be pre-adolescent without any signs of puberty (Tanner Stage 1).\"\n            },\n            \"right\": {\n              \"AND\": {\n                \"left\": {\n                  \"raw_text\": \"Normal range for their height and weight. Weight and height measurements should fall within the percentile range 3-97% of normal values for age according to Danish growth charts.\"\n                },\n                \"right\": {\n                  \"AND\": {\n                    \"left\": {\n                      \"raw_text\": \"Have a documented diagnosis of persistent asthma, as defined by the National Institutes of Health for at least 3 months prior to the Screening Visit.\"\n                    },\n                    \"right\": {\n                      \"AND\": {\n                        \"left\": {\n                          \"raw_text\": \"A pre-bronchodilatory forced expiratory flow in 1 second (FEV1) at Visit 1 (Screening) >=80% predicted.\"\n                        },\n                        \"right\": {\n                          \"raw_text\": \"There should be no Short acting beta-agonist (SABA) use within 4 hours of this measurement.\"\n                      }\n                    }\n                  }\n                }\n              }\n            }\n          }\n        }\n      }\n    }\n  }\n  }\n}"