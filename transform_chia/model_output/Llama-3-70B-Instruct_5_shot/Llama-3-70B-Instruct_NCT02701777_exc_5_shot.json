"{\n  \"AND\": {\n    \"left\": {\n      \"raw_text\": \"Uncontrolled medical problems including pulmonary, cardiovascular or orthopedic disease\"\n    },\n    \"right\": {\n      \"AND\": {\n        \"left\": {\n          \"raw_text\": \"Any debilitating disease prior to the SCI that caused exercise intolerance\"\n        },\n        \"right\": {\n          \"AND\": {\n            \"left\": {\n              \"OR\": {\n                \"left\": {\n                  \"raw_text\": \"Premorbid, ongoing major depression\"\n                },\n                \"right\": {\n                  \"OR\": {\n                    \"left\": {\n                      \"raw_text\": \"or psychosis\"\n                    },\n                    \"right\": {\n                      \"raw_text\": \"altered cognitive status\"\n                    }\n                  }\n                }\n              }\n            },\n            \"right\": {\n              \"AND\": {\n                \"left\": {\n                  \"raw_text\": \"History of head injury or stroke\"\n                },\n                \"right\": {\n                  \"AND\": {\n                    \"left\": {\n                      \"raw_text\": \"Metal plate in skull\"\n                    },\n                    \"right\": {\n                      \"AND\": {\n                        \"left\": {\n                          \"raw_text\": \"History of seizures\"\n                        },\n                        \"right\": {\n                          \"AND\": {\n                            \"left\": {\n                              \"raw_text\": \"Receiving drugs acting primarily on the central nervous system, which lower the seizure threshold\"\n                            },\n                            \"right\": {\n                              \"AND\": {\n                                \"left\": {\n                                  \"raw_text\": \"Pregnant females\"\n                                },\n          