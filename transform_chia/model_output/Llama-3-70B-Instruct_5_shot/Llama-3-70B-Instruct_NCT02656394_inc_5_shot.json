"{\n  \"AND\": {\n    \"left\": {\n      \"OR\": {\n        \"left\": {\n          \"raw_text\": \"Male\"\n        },\n        \"right\": {\n          \"raw_text\": \"female\"\n        }\n      }\n    },\n    \"right\": {\n      \"AND\": {\n        \"left\": {\n          \"raw_text\": \"of any race, at least 18 years of age at Visit 1 Screening.\"\n        },\n        \"right\": {\n          \"AND\": {\n            \"left\": {\n              \"raw_text\": \"Has provided verbal and written informed consent.\"\n            },\n            \"right\": {\n              \"AND\": {\n                \"left\": {\n                  \"raw_text\": \"Be able and willing to follow instructions, including participation in all study assessments and visits.\"\n                },\n                \"right\": {\n                  \"AND\": {\n                    \"left\": {\n                      \"raw_text\": \"Currently being treated for glaucoma using at least two medications, and be willing to continue on the same regime.\"\n                    },\n                    \"right\": {\n                      \"AND\": {\n                        \"left\": {\n                          \"raw_text\": \"Suffers from at least two of the symptoms in the GLIA™ Glaucoma Medication Ocular Side Effect Symptoms Questionnaire at a severity of 2 (moderate) or more.\"\n                        },\n                        \"right\": {\n                          \"AND\": {\n                            \"left\": {\n                              \"raw_text\": \"If a woman of childbearing potential\"\n                            },\n                            \"right\": {\n                              \"AND\": {\n                                \"left\": {\n                                  \"raw_text\": \"have a negative urine pregnancy test at Visit 1\"\n                                },\n                                \"right\": {\n                                  \"raw_text\": \"and be using an adequate method of birth control throughout the study period.\"\n                                }\n                              }\n                            }\n                          }\n                        }\n                      }\n                    }\n                  }\n                }\n              }\n            }\n          }\n        }\n      }\n    }\n  }\n}"