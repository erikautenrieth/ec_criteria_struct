"{\n  \"AND\": {\n    \"left\": {\n      \"AND\": {\n        \"left\": {\n          \"raw_text\": \"Controlled hypertension:\"\n        },\n        \"right\": {\n          \"OR\": {\n            \"left\": {\n              \"AND\": {\n                \"left\": {\n                  \"raw_text\": \"systolic BP < 150\"\n                },\n                \"right\": {\n                  \"AND\": {\n                    \"left\": {\n                      \"raw_text\": \"and diastolic BP < 90 mmHg\"\n                    },\n                    \"right\": {\n                      \"raw_text\": \"in persons aged 60 years or older\"\n                    }\n                  }\n                }\n              }\n            },\n            \"right\": {\n              \"AND\": {\n                \"left\": {\n                  \"raw_text\": \"systolic BP < 140\"\n                },\n                \"right\": {\n                  \"AND\": {\n                    \"left\": {\n                      \"raw_text\": \"and diastolic BP < 90 mmHg\"\n                    },\n                    \"right\": {\n                      \"raw_text\": \"in persons 40 through 59 years according to the JNC 8th guideline\"\n                    }\n                  }\n                }\n              }\n            }\n          }\n        }\n      }\n    },\n    \"right\": {\n      \"AND\": {\n        \"left\": {\n          \"raw_text\": \"Evidence of diastolic dysfunction showing E/E' > 10\"\n        },\n        \"right\": {\n          \"AND\": {\n            \"left\": {\n              \"raw_text\": \"The patient agrees to the study protocol\"\n            },\n            \"right\": {\n              \"AND\": {\n                \"left\": {\n                  \"raw_text\": \"and the schedule of clinical and echocardiographic follow-up\"\n                },\n                \"right\": {\n                  \"AND\": {\n                    \"left\": {\n                      \"raw_text\": \"and provides informed, written consent\"\n                    },\n                    \"right\": {\n                      \"raw_text\": \"as approved by the appropriate Institutional Review Board/Ethical Committee of the respective clinical site\"\n                    }\n                  }\n                }\n              }\n            }\n          }\n        }\n      }\n    }\n  }\n}"