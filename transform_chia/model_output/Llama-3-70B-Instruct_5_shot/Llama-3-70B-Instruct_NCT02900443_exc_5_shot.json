"{\n  \"AND\": {\n    \"left\": {\n      \"OR\": {\n        \"left\": {\n          \"AND\": {\n            \"left\": {\n              \"raw_text\": \"Overlap syndrome with Primary Sclerosing Cholangitis (PSC)\"\n            },\n            \"right\": {\n              \"OR\": {\n                \"left\": {\n                  \"raw_text\": \"or Primary Biliary Cholangitis (PBC)\"\n                },\n                \"right\": {\n                  \"AND\": {\n                    \"left\": {\n                      \"raw_text\": \"(Paris criteria, strong positive Anti-Mitochondrial Antibodies (AMA)\"\n                    },\n                    \"right\": {\n                      \"OR\": {\n                        \"left\": {\n                          \"raw_text\": \", past liver biopsy\"\n                        },\n                        \"right\": {\n                          \"raw_text\": \"or cholangiographic findings compatible with PBC or PSC)\"\n                        }\n                      }\n                    }\n                  }\n                }\n              }\n            }\n          }\n        },\n        \"right\": {\n          \"AND\": {\n            \"left\": {\n              \"raw_text\": \"Presentation with acute liver failure\"\n            },\n            \"right\": {\n              \"AND\": {\n                \"left\": {\n                  \"raw_text\": \"defined as presence of hepatic encephalopathy\"\n                },\n                \"right\": {\n                  \"raw_text\": \"and coagulopathy (INR > 1.5)\"\n                }\n              }\n            }\n          }\n        }\n      }\n    },\n    \"right\": {\n      \"AND\": {\n        \"left\": {\n          \"raw_text\": \"Current treatment with prednisone/prednisolone and/or immunosuppressive medication for an indication other than autoimmune hepatitis\"\n        },\n        \"right\": {\n          \"AND\": {\n            \"left\": {\n              \"raw_text\": \"Current systemic infection\"\n            },\n            \"right\": {\n              \"AND\": {\n                \"left\": {\n                  \"raw_text\": \"Other clinically significant medical conditions that could interfere with the trial\"\n                },\n                \"right\": {\n                  \"AND\": {\n                    \"left\": {\n                      \"AND\": {\n                        \"left\": {\n                          \"raw_text\": \"If female of childbearing potential\"\n                        },\n                        \"right\": {\n                          \"OR\": {\n                            \"left\": {\n                              \"raw_text\": \"known pregnancy\"\n                            },\n                            \"right\": {\n                              \"raw_text\": \"or unwilling to practice anticontraceptive measures\"\n                            }\n                          }\n                        }\n                      },\n                      \"right\": {\n                        \"AND\": {\n                          \"left\": {\n                            \"raw_text\": \"History of noncompliance with medical regimens\"\n                          },\n                          \"right\": {\n                            \"OR\": {\n                              \"left\": {\n                                \"raw_text\": \"or patients who are considered to be potentially unreliable\"\n                              },\n                              \"right\": {\n                                \"raw_text\": \"or unable to participate\"\n                              }\n                            }\n                          }\n                        }\n                      }\n                    }\n                  }\n                }\n              }\n            }\n          }\n        }\n      }\n    }\n  }\n}"