"{\n  \"AND\": {\n    \"left\": {\n      \"AND\": {\n        \"left\": {\n          \"raw_text\": \"Adult (>18 years of age and older) patients\"\n        },\n        \"right\": {\n          \"AND\": {\n            \"left\": {\n              \"raw_text\": \"who have or will have undergone surgical resection or biopsy of a supratentorial brain tumor\"\n            },\n            \"right\": {\n              \"raw_text\": \"and are able to consent for themselves.\"\n            }\n          }\n        }\n      }\n    },\n    \"right\": {\n      \"raw_text\": \"Able to be randomized prior to or up to 48 hours after surgery.\"\n    }\n  }\n}"