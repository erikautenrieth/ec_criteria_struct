"{\n  \"AND\": {\n    \"left\": {\n      \"raw_text\": \"Anaphylactic reaction to a previous dose of TIV(trivalent influenza vaccine)\"\n    },\n    \"right\": {\n      \"AND\": {\n        \"left\": {\n          \"raw_text\": \"Known IgE( Immunoglobulin E)-mediated hypersensitivity to eggs manifested as hives, swelling of the mouth and throat, difficulty in breathing, hypotension, or shock\"\n        },\n        \"right\": {\n          \"AND\": {\n            \"left\": {\n              \"raw_text\": \"Guillain-Barré syndrome within eight weeks of a previous influenza vaccine\"\n            },\n            \"right\": {\n              \"AND\": {\n                \"left\": {\n                  \"raw_text\": \"Anaphylactic reaction to neomycin\"\n                },\n                \"right\": {\n                  \"raw_text\": \"Patients who have had influenza vaccine in two of the three previous years\"\n                }\n              }\n            }\n          }\n        }\n      }\n    }\n  }\n}"