"{\n  \"AND\": {\n    \"left\": {\n      \"OR\": {\n        \"left\": {\n          \"raw_text\": \"Men\"\n        },\n        \"right\": {\n          \"raw_text\": \"women\"\n        }\n      }\n    },\n    \"right\": {\n      \"AND\": {\n        \"left\": {\n          \"raw_text\": \"aged 18 years or older\"\n        },\n        \"right\": {\n          \"OR\": {\n            \"left\": {\n              \"AND\": {\n                \"left\": {\n                  \"raw_text\": \"Patients presenting for CMR with the clinical diagnosis of hypertrophic cardiomyopathy\"\n                },\n                \"right\": {\n                  \"AND\": {\n                    \"left\": {\n                      \"raw_text\": \"based on left ventricular wall thickness of at least =15 mm\"\n                    },\n                    \"right\": {\n                      \"raw_text\": \"in the absence of any other cardiac or systemic cause of hypertrophy\"\n                    }\n                  }\n                }\n              }\n            },\n            \"right\": {\n              \"OR\": {\n                \"left\": {\n                  \"AND\": {\n                    \"left\": {\n                      \"raw_text\": \"Patients presenting for CMR with the clinical diagnosis of idiopathic dilated cardiomyopathy\"\n                    },\n                    \"right\": {\n                      \"AND\": {\n                        \"left\": {\n                          \"raw_text\": \"based upon left ventricular ejection fraction =40%\"\n                        },\n                        \"right\": {\n                          \"AND\": {\n                            \"left\": {\n                              \"raw_text\": \"LV end-diastolic diameter =55 mm\"\n                            },\n                            \"right\": {\n                              \"raw_text\": \"or left ventricular end-systolic diameter =45 mm, and the absence of coronary stenoses on angiography.\"\n                            }\n                          }\n                        }\n                      }\n                    }\n                  }\n                },\n                \"right\": {\n                  \"raw_text\": \"Patients presenting for CMR evaluation of chest pain but without evidence of obstructive coronary artery disease either by coronary angiography or stress testing.\"\n                }\n              }\n            }\n          }\n        }\n      }\n    }\n  }\n}"