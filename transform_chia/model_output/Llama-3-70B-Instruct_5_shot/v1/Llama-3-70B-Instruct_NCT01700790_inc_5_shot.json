"{\n  \"AND\": {\n    \"left\": {\n      \"OR\": {\n        \"left\": {\n          \"raw_text\": \"Antiretroviral naive\"\n        },\n        \"right\": {\n          \"OR\": {\n            \"left\": {\n              \"AND\": {\n                \"left\": {\n                  \"raw_text\": \"Taking Kaletra containing regimen\"\n                },\n                \"right\": {\n                  \"raw_text\": \"with suppressed viral load.\"\n                }\n              }\n            },\n            \"right\": {\n              \"OR\": {\n                \"left\": {\n                  \"AND\": {\n                    \"left\": {\n                      \"raw_text\": \"Taking an NNRTI or integrase containing regimen\"\n                    },\n                    \"right\": {\n                      \"raw_text\": \"without prior history of use of PI for more than 2 weeks\"\n                    }\n                  }\n                },\n                \"right\": {\n                  \"OR\": {\n                    \"left\": {\n                      \"AND\": {\n                        \"left\": {\n                          \"raw_text\": \"Taking an NNRTI or integrase containing regimen\"\n                        },\n                        \"right\": {\n                          \"raw_text\": \"with prior exposure to PI greater than 2 weeks. It must be clearly stated in the source document that PI was switched to another agent for convenience.\"\n                        }\n                      }\n                    },\n                    \"right\": {\n                      \"AND\": {\n                        \"left\": {\n                          \"raw_text\": \"Taking another PI containing regimens\"\n                        },\n                        \"right\": {\n                          \"raw_text\": \"with suppressed viral load. It must be clearly stated in source document that if another PI was used for greater than 2 weeks the regimen was switched to another agent for convenience. Subjects with prior history of PI use may be enrolled, if there is a genotype showing no resistance to Kaletra\"\n                        }\n                      }\n                    }\n                  }\n                }\n              }\n            }\n          }\n        }\n      }\n    },\n    \"right\": {\n      \"AND\": {\n        \"left\": {\n          \"raw_text\": \"Be at least 18 years of age and able to give informed consent.\"\n        },\n        \"right\": {\n          \"AND\": {\n            \"left\": {\n              \"raw_text\": \"Diagnosed with TB by criteria per Brazilian Ministry of Health\"\n            },\n            \"right\": {\n              \"AND\": {\n                \"left\": {\n                  \"raw_text\": \"Have a good clinical response to TB.\"\n                },\n                \"right\": {\n                  \"AND\": {\n                    \"left\": {\n                      \"raw_text\": \"Tolerating tuberculosis therapy containing rifampin for the 2 weeks prior to screening,except for persons taking protease inhibitors at time of diagnosis of TB.,. Subjects taking protease inhibitors will be screened and initiate visit 1 within 3 days of starting TB medication\"\n                    },\n                    \"right\": {\n                      \"raw_text\": \"HIV positive with documentation present in source document.\"\n                    }\n                  }\n                }\n              }\n            }\n          }\n        }\n      }\n    }\n  }\n  }\n  }\n}"