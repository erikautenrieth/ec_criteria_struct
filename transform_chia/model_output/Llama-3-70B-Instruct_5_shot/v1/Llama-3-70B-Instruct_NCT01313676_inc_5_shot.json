"{\n  \"AND\": {\n    \"left\": {\n      \"raw_text\": \"Type of subject: outpatient.\"\n    },\n    \"right\": {\n      \"AND\": {\n        \"left\": {\n          \"raw_text\": \"Informed consent: Subjects must give their signed and dated written informed consent to participate.\"\n        },\n        \"right\": {\n          \"AND\": {\n            \"left\": {\n              \"OR\": {\n                \"left\": {\n                  \"raw_text\": \"Gender: Male\"\n                },\n                \"right\": {\n                  \"raw_text\": \"or female. Female subjects must be post-menopausal or using a highly effective method for avoidance of pregnancy. The decision to include or exclude women of childbearing potential may be made at the discretion of the investigator in accordance with local practice in relation to adequate contraception.\"\n                }\n              }\n            },\n            \"right\": {\n              \"AND\": {\n                \"left\": {\n                  \"AND\": {\n                    \"left\": {\n                      \"raw_text\": \"Age: >=40\"\n                    },\n                    \"right\": {\n                      \"raw_text\": \"and <=80 years of age at Screening (Visit 1).\"\n                    }\n                  }\n                },\n                \"right\": {\n                  \"AND\": {\n                    \"left\": {\n                      \"raw_text\": \"Tobacco use: Subjects with a current or prior history of >=10 pack-years of cigarette smoking at screening (Visit 1).\"\n                    },\n                    \"right\": {\n                      \"raw_text\": \"Previous smokers are defined as those who have stopped smoking for at least 6 months prior to Visit 1.\"\n                    }\n                  }\n                }\n              }\n            }\n          }\n        }\n      }\n    }\n  }\n}"