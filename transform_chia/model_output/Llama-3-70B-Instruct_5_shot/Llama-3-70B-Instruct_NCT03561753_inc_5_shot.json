"{\n  \"AND\": {\n    \"left\": {\n      \"raw_text\": \"Newly diagnosed and untreated sputum smear positive tuberculosis patient\"\n    },\n    \"right\": {\n      \"AND\": {\n        \"left\": {\n          \"raw_text\": \"Pulmonary lesion consistent with TB by radiological examination\"\n        },\n        \"right\": {\n          \"AND\": {\n            \"left\": {\n              \"raw_text\": \"Positive sputum culture, identification of bacterial type confirmed Mycobacterium tuberculosis. MGIT drug sensitivity test (DST) results are sensitive of the first-line drugs (isoniazid, streptomycin, rifampicin and ethambutol).\"\n            },\n            \"right\": {\n              \"AND\": {\n                \"left\": {\n                  \"AND\": {\n                    \"left\": {\n                      \"raw_text\": \"Age 18 years\"\n                    },\n                    \"right\": {\n                      \"raw_text\": \"-65 years old\"\n                    }\n                  }\n                },\n                \"right\": {\n                  \"AND\": {\n                    \"left\": {\n                      \"OR\": {\n                        \"left\": {\n                          \"raw_text\": \"Males\"\n                        },\n                        \"right\": {\n                          \"raw_text\": \"non-pregnant, non-nursing females\"\n                        }\n                      }\n                    },\n                    \"right\": {\n                      \"AND\": {\n                        \"left\": {\n                          \"raw_text\": \"Serum or plasma aminotransferases (AST, ALT) less than 3 times the upper limit of normal\"\n                        },\n                        \"right\": {\n                          \"AND\": {\n                            \"left\": {\n                              \"raw_text\": \"Serum or plasma total bilirubin less than or equal to 2.5 times the upper limit of normal\"\n                            },\n                            \"right\": {\n                              \"AND\": {\n                                \"left\": {\n                                  \"raw_text\": \"Serum or plasma creatinine level less than or equal to 2 times the upper limit of normal\"\n                                },\n                                \"right\": {\n                                  \"AND\": {\n                                    \"left\": {\n                                      \"raw_text\": \"Serum or plasma potassium level greater than or equal to 3.5 meq/L\"\n                                    },\n                                    \"right\": {\n                                      \"AND\": {\n                                        \"left\": {\n                                          \"raw_text\": \"Hemoglobin level of 7.0 g/dL or greater\"\n                                        },\n                                        \"right\": {\n                                          \"AND\": {\n                                            \"left\": {\n                                              \"raw_text\": \"Platelet count of 100,000/mm3 or greater\"\n                                            },\n                                            \"right\": {\n                                              \"AND\": {\n                                                \"left\": {\n                                                  \"raw_text\": \"For women of childbearing potential, a negative pregnancy test is required during screening\"\n                                                },\n                                                \"right\": {\n                                                  \"AND\": {\n                                                    \"left\": {\n                                                      \"raw_text\": \"Provides written informed consent\"\n                                                    },\n              