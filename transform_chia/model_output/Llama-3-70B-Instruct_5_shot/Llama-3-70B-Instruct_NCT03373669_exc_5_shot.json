"{\n  \"AND\": {\n    \"left\": {\n      \"OR\": {\n        \"left\": {\n          \"raw_text\": \"Presence of a significant medical or psychiatric condition\"\n        },\n        \"right\": {\n          \"OR\": {\n            \"left\": {\n              \"raw_text\": \"Examples include: Diagnosis and treatment of tuberculosis (TB) or HIV\"\n            },\n            \"right\": {\n              \"OR\": {\n                \"left\": {\n                  \"raw_text\": \", renal insufficiency\"\n                },\n                \"right\": {\n                  \"OR\": {\n                    \"left\": {\n                      \"raw_text\": \", hepatic disease\"\n                    },\n                    \"right\": {\n                      \"OR\": {\n                        \"left\": {\n                          \"raw_text\": \", oral or parenteral medication known to affect the immune function\"\n                        },\n                        \"right\": {\n                          \"OR\": {\n                            \"left\": {\n                              \"raw_text\": \"such as corticosteroids\"\n                            },\n                            \"right\": {\n                              \"OR\": {\n                                \"left\": {\n                                  \"raw_text\": \"other immunosuppressant drugs\"\n                                },\n                                \"right\": {\n                                  \"OR\": {\n                                    \"left\": {\n                                      \"raw_text\": \"or behavioural or memory issues\"\n                                    },\n                                    \"right\": {\n                                      \"raw_text\": \"Ever having received oral cholera vaccine.\"\n                                    }\n                                  }\n                                }\n                              }\n                            }\n                          }\n                        }\n                      }\n                    }\n                  }\n                }\n              }\n            }\n          }\n        }\n      }\n    },\n    \"right\": {\n      \"AND\": {\n        \"left\": {\n          \"raw_text\": \"Receipt of an investigational product (within 30 days before vaccination).\"\n        },\n        \"right\": {\n          \"AND\": {\n            \"left\": {\n              \"raw_text\": \"History of diarrhoea in 7 days prior to first dose of vaccine (defined as =3 unformed loose stools in 24 hours).\"\n            },\n            \"right\": {\n              \"AND\": {\n                \"left\": {\n                  \"raw_text\": \"History of chronic diarrhea (lasting for more than 2 weeks in the past 6 months)\"\n                },\n                \"right\": {\n                  \"AND\": {\n                    \"left\": {\n                      \"raw_text\": \"Current use of laxatives, antacids, or other agents to lower stomach acidity?\"\n                    },\n                    \"right\": {\n                      \"raw_text\": \"Planning to become pregnant in the next 2 years.\"\n                    }\n                  }\n                }\n              }\n            }\n          }\n        }\n      }\n    }\n  }\n}"