"{\n  \"AND\": {\n    \"left\": {\n      \"raw_text\": \"Patients with histologically confirmed diagnosis of colorectal cancer presenting with unresectable stage IV (UICC) disease (primary tumor may be present)\"\n    },\n    \"right\": {\n      \"AND\": {\n        \"left\": {\n          \"raw_text\": \"Patients who are feasible for treatment with FOLFOX (prior adjuvant or palliative treatment is allowed)\"\n        },\n        \"right\": {\n          \"AND\": {\n            \"left\": {\n              \"raw_text\": \"ECOG Performance status ≤ 1\"\n            },\n            \"right\": {\n              \"AND\": {\n                \"left\": {\n                  \"raw_text\": \"Life expectancy > 3 months\"\n                },\n                \"right\": {\n                  \"AND\": {\n                    \"left\": {\n                      \"raw_text\": \"Age ≥18 years\"\n                    },\n                    \"right\": {\n                      \"AND\": {\n                        \"left\": {\n                          \"AND\": {\n                            \"left\": {\n                              \"raw_text\": \"Haematologic function as follows (5% deviation allowed): ANC ≥ 1.5 x 109/L\"\n                            },\n                            \"right\": {\n                              \"AND\": {\n                                \"left\": {\n                                  \"raw_text\": \"platelets ≥ 100 x109/L\"\n                                },\n                                \"right\": {\n                                  \"raw_text\": \"hemoglobin ≥ 9 g/dl or 5.59 mmol/l\"\n                                }\n                              }\n                            }\n                          },\n                          \"right\": {\n                            \"AND\": {\n                              \"left\": {\n                                \"AND\": {\n                                  \"left\": {\n                                   