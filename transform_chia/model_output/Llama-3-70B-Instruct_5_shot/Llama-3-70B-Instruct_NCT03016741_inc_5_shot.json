"{\n  \"AND\": {\n    \"left\": {\n      \"AND\": {\n        \"left\": {\n          \"raw_text\": \"Have diagnosis of prostate cancer\"\n        },\n        \"right\": {\n          \"AND\": {\n            \"left\": {\n              \"raw_text\": \"and have received treatment with GnRH agonist or antagonist therapy for at least 1 month prior to enrollment.\"\n            },\n            \"right\": {\n              \"AND\": {\n                \"left\": {\n                  \"raw_text\": \"Willing and able to complete survey questionnaires in English without assistance through the duration of the study.\"\n                },\n                \"right\": {\n                  \"AND\": {\n                    \"left\": {\n                      \"raw_text\": \"Age = 18 years.\"\n                    },\n                    \"right\": {\n                      \"AND\": {\n                        \"left\": {\n                          \"raw_text\": \"Ability to understand and the willingness to sign a written informed consent document written in English that is approved by an institutional review board.\"\n                        },\n                        \"right\": {\n                          \"AND\": {\n                            \"left\": {\n                              \"OR\": {\n                                \"left\": {\n                                  \"raw_text\": \"Have newly diagnosed metastatic hormone sensitive prostate cancer (mHSPC)\"\n                                },\n                                \"right\": {\n                                  \"raw_text\": \"or castration-resistant metastatic prostate cancer (mCRPC) and eligible to undergo treatment with abiraterone acetate (mHSPC or mCRPC) or enzalutamide (mCRPC)\"\n                                }\n                              }\n                            },\n                            \"right\": {\n                              \"AND\": {\n                                \"left\": {\n                                  \"raw_text\": \"Patients may have received the following prior AR directed therapy prior to enrollment: bicalutamide, ketoconazole.\"\n                                },\n                                \"right\": {\n                                  \"AND\": {\n                                    \"left\": {\n                                      \"raw_text\": \"Prior to enrollment, patients may have received treatment with abiraterone acetate or enzalutamide for no more than 14 days before completing baseline studies.\"\n                                    },\n                                    \"right\": {\n                                      \"AND\": {\n                                        \"left\": {\n                                          \"raw_text\": \"Patients may have received chemotherapy for hormone-sensitive metastatic prostate cancer only, but it must not have lasted for more than 6 months.\"\n                                        },\n                                        \"right\": {\n                                          \"AND\": {\n                                            \"left\": {\n                                              \"raw_text\": \"At least 12 months must have elapsed since completion of chemotherapy.\"\n                                            },\n                                            \"right\": {\n                                              \"AND\": {\n                                                \"left\": {\n                                                  \"raw_text\": \"Patients may have received prior definitive radiation therapy or surgery.\"\n                                                },\n                                                \"right\": {\n                                                  \"AND\": {\n                                                    \"left\": {\n                                                      \"raw_text\": \"At least 60 days must have elapsed since completion of definitive radiation therapy or surgery and patient must have only grade 2 or less adverse effects at the time of registration.\"\n                                                    },\n                                                    \"right\": {\n                                                      \"raw_text\": \"Enrollment during palliative radiation of = 10 days, or radiation of = 10 days during the duration of the study\"\n                                                    }\n                                                  \"right\": {\n                                                      \"raw_text\": \"Patients must be able to take oral medication.\"\n                                                    }\n                                                  \"right\": {\n                                                      \"raw_text\": \"Patients must be able to take oral medication\"\n                                                    }\n                                                  \"right\": {\n                                                      \"raw_text\": \"Patients must be able to take oral medication\"\n                                                  \"right\": {\n                                                      \"raw_text\": \"Patients must be able to take oral medication.assistantassistant \"raw_text\": \"raw_text\": \"Patients must be able to take oral medication\"\assistantassistant \"raw_text\": \"raw_text\": \"Patients must be able to take oralassistant \"raw_text\": \"raw_text\": \"raw_text\": \"Patients must be able to take oral medication\"raw_text\": \"raw_text\": \"raw_text\": \"raw_text\": \"raw_text\": \"raw_text\": \"raw_textassistantassistantassistant