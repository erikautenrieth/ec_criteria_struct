"{\n  \"AND\": {\n    \"left\": {\n      \"raw_text\": \"estimated glomerular filtration rate (eGFR) > 60 ml/min\"\n    },\n    \"right\": {\n      \"AND\": {\n        \"left\": {\n          \"raw_text\": \"preserved left ventricular ejection fraction (>= 50%) on echocardiography\"\n        },\n        \"right\": {\n          \"OR\": {\n            \"left\": {\n              \"AND\": {\n                \"left\": {\n                  \"raw_text\": \"HEALTHY: normal cardiac structure and function on echocardiography\"\n                },\n                \"right\": {\n                  \"AND\": {\n                    \"left\": {\n                      \"raw_text\": \"BP < 140/90\"\n                    }\n                  }\n                }\n              }\n            },\n            \"right\": {\n              \"OR\": {\n                \"left\": {\n                  \"AND\": {\n                    \"left\": {\n                      \"raw_text\": \"HYPERTENSIVE: history of BP >140/90\"\n                    },\n                    \"right\": {\n                      \"AND\": {\n                        \"left\": {\n                          \"raw_text\": \"1 or more antihypertensive medications\"\n                        },\n                        \"right\": {\n                          \"AND\": {\n                            \"left\": {\n                              \"raw_text\": \"LV ejection fraction (LVEF) at least 50%\"\n                            },\n                            \"right\": {\n                              \"raw_text\": \"current BP < 160/90\"\n                            }\n                          }\n                        }\n                      }\n                    }\n                  }\n                },\n                \"right\": {\n                  \"AND\": {\n                    \"left\": {\n                      \"raw_text\": \"HFpEF: physician-confirmed diagnosis of HF\"\n                    },\n                    \"right