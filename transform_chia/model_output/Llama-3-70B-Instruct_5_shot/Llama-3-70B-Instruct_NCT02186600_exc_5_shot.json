"{\n  \"AND\": {\n    \"left\": {\n      \"raw_text\": \"Have osteoporosis\"\n    },\n    \"right\": {\n      \"AND\": {\n        \"left\": {\n          \"raw_text\": \"Have a 10 yr probability of hip fracture >3% or major fracture >20% based on results of the FRAX tool\"\n        },\n        \"right\": {\n          \"AND\": {\n            \"left\": {\n              \"raw_text\": \"Currently take bisphosphonates, estrogen replacement therapy, glucocorticosteroids, or other drugs affecting bone\"\n            },\n            \"right\": {\n              \"AND\": {\n                \"left\": {\n                  \"raw_text\": \"Currently participate in a resistance training or high impact weight bearing exercise program two or more times weekly\"\n                },\n                \"right\": {\n                  \"AND\": {\n                    \"left\": {\n                      \"raw_text\": \"Weigh >300 lbs\"\n                    },\n                    \"right\": {\n                      \"AND\": {\n                        \"left\": {\n                          \"raw_text\": \"Have abnormal results for the following laboratory tests: serum 25(OH)D; serum creatinine; serum calcium; PTH; TSH\"\n                        },\n                        \"right\": {\n                          \"raw_text\": \"Have Paget's disease, heart disease, uncontrolled hypertension, renal disease, or other concomitant conditions that prohibit participation in exercises, risedronate therapy, or use of CaD supplements.\"\n                        }\n                      }\n                    }\n                  }\n                }\n              }\n            }\n          }\n        }\n      }\n    }\n  }\n}"