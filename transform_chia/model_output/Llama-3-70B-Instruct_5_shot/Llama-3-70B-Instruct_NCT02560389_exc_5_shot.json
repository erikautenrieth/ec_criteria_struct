"{\n  \"AND\": {\n    \"left\": {\n      \"OR\": {\n        \"left\": {\n          \"raw_text\": \"Claustrophobia\"\n        },\n        \"right\": {\n          \"raw_text\": \"or the inability to lie still in a confined space\"\n        }\n      }\n    },\n    \"right\": {\n      \"AND\": {\n        \"left\": {\n          \"OR\": {\n            \"left\": {\n              \"raw_text\": \"Major medical disorders\"\n            },\n            \"right\": {\n              \"raw_text\": \"(e.g., HIV, cancer)\"\n            }\n          }\n        },\n        \"right\": {\n          \"AND\": {\n            \"left\": {\n              \"OR\": {\n                \"left\": {\n                  \"raw_text\": \"Magnetic metallic implants\"\n                },\n                \"right\": {\n                  \"raw_text\": \"(such as screws, pins, shrapnel remnants, aneurysm clips, artificial heart valves, inner ear (cochlear) implants, artificial joints, and vascular stents)\"\n                }\n              }\n            },\n            \"right\": {\n              \"AND\": {\n                \"left\": {\n                  \"raw_text\": \"Electronic or magnetic implants\"\n                },\n                \"right\": {\n                  \"raw_text\": \"such as pacemakers\"\n                }\n              }\n            }\n          }\n        }\n      }\n    }\n  },\n  \"right\": {\n    \"AND\": {\n      \"left\": {\n        \"OR\": {\n          \"left\": {\n            \"raw_text\": \"Permanent makeup\"\n          },\n          \"right\": {\n            \"raw_text\": \"or tattoos with metallic dyes\"\n          }\n        }\n      },\n      \"right\": {\n        \"AND\": {\n          \"left\": {\n            \"raw_text\": \"Currently pregnant\"\n          },\n          \"right\": {\n            \"AND\": {\n              \"left\": {\n                \"raw_text\": \"A self-reported history of loss of consciousness\"\n              },\n              \"right\": {\n        