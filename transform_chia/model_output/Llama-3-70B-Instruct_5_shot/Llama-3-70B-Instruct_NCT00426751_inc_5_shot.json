"{\n  \"AND\": {\n    \"left\": {\n      \"AND\": {\n        \"left\": {\n          \"OR\": {\n            \"left\": {\n              \"raw_text\": \"Women must be postmenopausal (i.e.12 months without menstrual period)\"\n            },\n            \"right\": {\n              \"raw_text\": \"or surgically sterile\"\n            }\n          }\n        },\n        \"right\": {\n          \"NOT\": {\n            \"left\": {\n              \"raw_text\": \"women of child bearing potential\"\n            }\n          }\n        }\n      }\n    },\n    \"right\": {\n      \"AND\": {\n        \"left\": {\n          \"AND\": {\n            \"left\": {\n              \"raw_text\": \"Acute myocardial infarction < 12 h defined as:\"\n            },\n            \"right\": {\n              \"AND\": {\n                \"left\": {\n                  \"raw_text\": \"Angina or equivalent symptoms > 20 min\"\n                },\n                \"right\": {\n                  \"raw_text\": \"and ST elevation in 2 contiguous ECG leads (= 2 mm precordial lead, = 1 mm limb lead)\"\n                }\n              }\n            }\n          }\n        },\n        \"right\": {\n          \"AND\": {\n            \"left\": {\n              \"raw_text\": \"Planned primary percutaneous coronary intervention\"\n            },\n            \"right\": {\n              \"raw_text\": \"The subject has given written informed, dated consent to participate in the study\"\n            }\n          }\n        }\n      }\n    }\n  }\n}"