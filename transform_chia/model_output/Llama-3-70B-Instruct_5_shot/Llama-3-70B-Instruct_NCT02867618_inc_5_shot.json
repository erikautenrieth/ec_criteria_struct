"{\n  \"AND\": {\n    \"left\": {\n      \"OR\": {\n        \"left\": {\n          \"AND\": {\n            \"left\": {\n              \"raw_text\": \"Phase I: Patients must have histologically confirmed R/R NHL or HL (defined by WHO criteria)\"\n            },\n            \"right\": {\n              \"AND\": {\n                \"left\": {\n                  \"OR\": {\n                    \"left\": {\n                      \"raw_text\": \"Patients with chronic lymphocytic leukemia (CLL)\"\n                    },\n                    \"right\": {\n                      \"raw_text\": \"and small lymphocytic lymphoma (SLL) are eligible\"\n                    }\n                  }\n                },\n                \"right\": {\n                  \"AND\": {\n                    \"left\": {\n                      \"raw_text\": \"In addition, patients with NHL other than diffuse large B cell lymphomas (DLBCL) must have received at least 2 prior therapies\"\n                    },\n                    \"right\": {\n                      \"raw_text\": \"Patients with DLBCL and HL will be eligible if there is no available standard therapy\"\n                    }\n                  }\n                }\n              }\n            }\n          }\n        },\n        \"right\": {\n          \"AND\": {\n            \"left\": {\n              \"raw_text\": \"Phase II: Patients must have histologically confirmed R/R NHL (as defined by WHO criteria)\"\n            },\n            \"right\": {\n              \"AND\": {\n                \"left\": {\n                  \"raw_text\": \"Patients with NHL other than diffuse large B cell lymphomas (DLBCL) must have received at least 2 prior therapies\"\n                },\n                \"right\": {\n                  \"raw_text\": \"Patients with DLBCL will be eligible if there is no available standard therapy\"\n                }\n              }\n            }\n          }\n        }\n      }\n    },\n    \"right\": {\n      \"AND\": {\n        \"left\": {\n          \"raw_text\": \"Must have received front line chemotherapy\"\n        },\n        \"right\": {\n          \"AND\": {\n            \"left\": {\n              \"raw_text\": \"No upper limit for the number of prior therapies\"\n            },\n            \"right\": {\n              \"AND\": {\n                \"left\": {\n                  \"OR\": {\n                    \"left\": {\n                      \"raw_text\": \"Evaluable Disease in the Phase I\"\n                    },\n                    \"right\": {\n                      \"raw_text\": \"measurable disease in the Phase II\"\n                    }\n                  }\n                },\n                \"right\": {\n                  \"AND\": {\n                    \"left\": {\n                      \"raw_text\": \"Age > 18 years\"\n                    },\n                    \"right\": {\n                      \"AND\": {\n                        \"left\": {\n                          \"raw_text\": \"ECOG performance status < 2\"\n                        },\n                        \"right\": {\n                          \"AND\": {\n                            \"left\": {\n                              \"raw_text\": \"Patients must have adequate organ and marrow function\"\n                            },\n                            \"right\": {\n                              \"raw_text\": \"Adequate Contraception\"\n                            }\n                          }\n                        }\n                      }\n                    }\n                  }\n                }\n              }\n            }\n          }\n        }\n      }\n    }\n  }\n}"