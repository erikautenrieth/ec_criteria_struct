"{\n  \"AND\": {\n    \"left\": {\n      \"raw_text\": \"Adult patients (= 18 years)\"\n    },\n    \"right\": {\n      \"AND\": {\n        \"left\": {\n          \"raw_text\": \"Patient on hemodialysis treatment for at least 1 month\"\n        },\n        \"right\": {\n          \"AND\": {\n            \"left\": {\n              \"raw_text\": \"Patient with a history of, or presenting a new episode of atrial fibrillation (either permanent or paroxysmal).\"\n            },\n            \"right\": {\n              \"AND\": {\n                \"left\": {\n                  \"raw_text\": \"Patient with a CHADS2VASC score =2\"\n                },\n                \"right\": {\n                  \"AND\": {\n                    \"left\": {\n                      \"OR\": {\n                        \"left\": {\n                          \"raw_text\": \"HASBLED score =3\"\n                        },\n                        \"right\": {\n                          \"OR\": {\n                            \"left\": {\n                              \"raw_text\": \"HASBLED = CHADS2VASC score\"\n                            },\n                            \"right\": {\n                              \"OR\": {\n                                \"left\": {\n                                  \"raw_text\": \"recent history of severe bleeding (type 3a, 3b, 3c), particularly cerebral or gastrointestinal\"\n                                },\n                                \"right\": {\n                                  \"raw_text\": \"OR (4) prior recurrent (>2) history of falls.\"\n                                }\n                              }\n                            }\n                          }\n                        }\n                      }\n                    },\n                    \"right\": {\n                      \"AND\": {\n                        \"left\": {\n                          \"raw_text\": \"Patient capable of understanding information about the study an