"{\n  \"AND\": {\n    \"left\": {\n      \"AND\": {\n        \"left\": {\n          \"raw_text\": \"Patients with Ph (BCR/ABL) positive de novo\"\n        },\n        \"right\": {\n          \"raw_text\": \"< 55 years old (it is advisable to include patients over 55 years LAL07OPH protocol).\"\n        }\n      }\n    },\n    \"right\": {\n      \"AND\": {\n        \"left\": {\n          \"raw_text\": \"Performance status 0-2 (Appendix B) may include patients with performance status > 2 attributable to LAL.\"\n        },\n        \"right\": {\n          \"AND\": {\n            \"left\": {\n              \"raw_text\": \"Patients without functional impairment of organs: liver function: total bilirubin, AST, ALT, alfa-GT and alkaline phosphatase less than 3 times the upper limit of normal laboratory\"\n            },\n            \"right\": {\n              \"AND\": {\n                \"left\": {\n                  \"raw_text\": \"renal function: serum creatinine < 2 mg/dL or clearance creatinine > 30 ml/min (except renal function attributable to LAL)\"\n                },\n                \"right\": {\n                  \"AND\": {\n                    \"left\": {\n                      \"raw_text\": \"cardiac function (Appendix B) normal: ventricular EF > 50%, absence of severe chronic respiratory disease.\"\n                    },\n                    \"right\": {\n                      \"raw_text\": \"In the event that alterations are secondary to the disease is at the discretion of the investigator to determine if the patient can be included in the trial.\"\n                    }\n                  }\n                }\n              }\n            }\n          }\n        }\n      }\n    }\n  }\n}"