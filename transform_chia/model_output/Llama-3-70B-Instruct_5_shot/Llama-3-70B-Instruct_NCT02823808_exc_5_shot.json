"{\n  \"AND\": {\n    \"left\": {\n      \"AND\": {\n        \"left\": {\n          \"raw_text\": \"The use of weight-lowering drugs\"\n        },\n        \"right\": {\n          \"OR\": {\n            \"left\": {\n              \"raw_text\": \"any investigational blood-glucose\"\n            },\n            \"right\": {\n              \"raw_text\": \"or lipid-lowering agent (other than statins or ezetimibe) within the past 3 months\"\n            }\n          }\n        }\n      }\n    },\n    \"right\": {\n      \"AND\": {\n        \"left\": {\n          \"raw_text\": \"Previous treatment with systemic corticosteroids\"\n        },\n        \"right\": {\n          \"OR\": {\n            \"left\": {\n              \"raw_text\": \"or a change in dosage of thyroid hormones\"\n            },\n            \"right\": {\n              \"raw_text\": \"in the previous 6 weeks\"\n            }\n          }\n        }\n      }\n    }\n  },\n  \"right\": {\n    \"AND\": {\n      \"left\": {\n        \"raw_text\": \"The use of insulin within the 3 months prior to screening\"\n      },\n      \"right\": {\n        \"raw_text\": \"Others\"\n      }\n    }\n  }\n}"