"{\n  \"AND\": {\n    \"left\": {\n      \"AND\": {\n        \"left\": {\n          \"raw_text\": \"Subjects must have recurrent or persistent platinum-resistant epithelial ovarian, fallopian tube, or primary peritoneal carcinoma with measureable disease (as defined by RECIST 1.1.) after first or second line platinum-based chemotherapy, for which treatment with PLD is indicated.\"\n        },\n        \"right\": {\n          \"AND\": {\n            \"left\": {\n              \"raw_text\": \"Platinum-based therapy is defined as treatment with carboplatin, cisplatin or another organoplatinum compound.\"\n            },\n            \"right\": {\n              \"AND\": {\n                \"left\": {\n                  \"raw_text\": \"Platinum-resistant is defined as having a platinum-free interval (PFI) of < 12 months after first- or second-line platinum-based chemotherapy, or having disease progression while receiving second-line platinum-based chemotherapy.\"\n                },\n                \"right\": {\n                  \"AND\": {\n                    \"left\": {\n                      \"raw_text\": \"Subjects are allowed to have received, but are not required to have received:\"\n                    },\n                    \"right\": {\n                      \"AND\": {\n                        \"left\": {\n                          \"raw_text\": \"one additional cytotoxic regimen and/or PARP inhibitor for management of recurrent or persistent disease.\"\n                        },\n                        \"right\": {\n                          \"AND\": {\n                            \"left\": {\n                              \"raw_text\": \"biologic therapy (e.g., bevacizumab) as part of their primary treatment regimen or part of their treatment for management of recurrent or persistent disease.\"\n                            },\n                            \"right\": {\n                              \"AND\": {\n                                \"left\": {\n                                  \"raw_text\": \"Histologic documentation of the original primary tumor.\"\n                                },\n                                \"right\": {\n                                  \"AND\": {\n                                    \"left\": {\n                                      \"raw_text\": \"Documented radiographic disease progression < 12 months after the last dose of first- or second-line platinum-based chemotherapy.\"\n                                    },\n                                    \"right\": {\n                                      \"AND\": {\n                                        \"left\": {\n                                          \"raw_text\": \"Subjects in Phase 2 must have disease amenable to biopsy and must be willing to undergo pre- and post-treatment tumor biopsies\"\n                                        },\n                                        \"right\": {\n                                          \"raw_text\": \"Optional for Phase 1\"\n                                        }\n                                      }\n                                    \"right\": {\n                                      \"raw_text\": \"ECOG performance status of 0 or 1.\"\n                                      }\n                                    \"right\": {\n                                      \"raw_text\": \"Laboratory parameters for vital functions\"\n                                    }\n                                    \"right\": {\n                                      \"raw_text\": \"Age ≥ 18 years\"\n                                    \"right\": {\n                                      \"raw_text\": \"Age ≥ 18 years\"\n                                    \"right\": {\n                                      \"raw_text\": \"Age ≥ 18 yearsassistant \"raw_text\": \"Age ≥ 18 yearsassistantassistant \"right\": \"Age ≥ 18