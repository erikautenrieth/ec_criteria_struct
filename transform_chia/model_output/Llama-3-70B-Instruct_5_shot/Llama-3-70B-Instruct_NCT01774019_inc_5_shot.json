"{\n  \"AND\": {\n    \"left\": {\n      \"raw_text\": \"Age 18 or older\"\n    },\n    \"right\": {\n      \"AND\": {\n        \"left\": {\n          \"AND\": {\n            \"left\": {\n              \"raw_text\": \"Willing and able to comply with the study procedures\"\n            },\n            \"right\": {\n              \"raw_text\": \"and provide written informed consent to participate in the study\"\n            }\n          }\n        },\n        \"right\": {\n          \"AND\": {\n            \"left\": {\n              \"raw_text\": \"Diagnosis of probable pancreatic cancer, distal common bile duct (CBD) cholangiocarcinoma and other periampullary cancers (histology not required)\"\n            },\n            \"right\": {\n              \"AND\": {\n                \"left\": {\n                  \"raw_text\": \"Biliary obstructive symptoms or signs\"\n                },\n                \"right\": {\n                  \"AND\": {\n                    \"left\": {\n                      \"raw_text\": \"Bilirubin level at/above 100 umol per liter (5.8 mg/dL)\"\n                    },\n                    \"right\": {\n                      \"AND\": {\n                        \"left\": {\n                          \"raw_text\": \"Distal biliary obstruction consistent with pancreatic cancer, distal CBD cholangiocarcinoma or other periampullary malignancy\"\n                        },\n                        \"right\": {\n                          \"AND\": {\n                            \"left\": {\n                              \"raw_text\": \"Location of distal biliary obstruction is such that it would allow the proximal end of a stent to be positioned at least 2cm from the hilum\"\n                            },\n                            \"right\": {\n                              \"AND\": {\n                                \"left\": {\n                                  \"raw_text\": \"Patients deemed as resectable by pancreatic protocol CT or MRI\"\n    