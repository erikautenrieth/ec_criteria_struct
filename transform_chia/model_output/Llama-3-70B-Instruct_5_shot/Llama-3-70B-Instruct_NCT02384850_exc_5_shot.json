"{\n  \"AND\": {\n    \"left\": {\n      \"raw_text\": \"adequately controlled with appropriate therapy or would compromise the patient's ability to tolerate this therapy\"\n    },\n    \"right\": {\n      \"AND\": {\n        \"left\": {\n          \"raw_text\": \"Treatment with any systemic anticancer therapy ≤ 3 weeks prior to cycle 1 day 1\"\n        },\n        \"right\": {\n          \"AND\": {\n            \"left\": {\n              \"OR\": {\n                \"left\": {\n                  \"raw_text\": \"Uncontrolled active infection\"\n                },\n                \"right\": {\n                  \"raw_text\": \"and/or known HIV infection\"\n                }\n              }\n            },\n            \"right\": {\n              \"AND\": {\n                \"left\": {\n                  \"raw_text\": \"Renal failure requiring haemodialysis or peritoneal dialysis\"\n                },\n                \"right\": {\n                  \"AND\": {\n                    \"left\": {\n                      \"OR\": {\n                        \"left\": {\n                          \"raw_text\": \"Patients who are pregnant\"\n                        },\n                        \"right\": {\n                          \"raw_text\": \"or breast-feeding\"\n                        }\n                      }\n                    },\n                    \"right\": {\n                      \"AND\": {\n                        \"left\": {\n                          \"raw_text\": \"Patients with significantly diseased or obstructed gastrointestinal tract, malabsorption, uncontrolled vomiting or diarrhea resulting in inability to swallow oral medications\"\n                        },\n                        \"right\": {\n                          \"AND\": {\n                            \"left\": {\n                              \"raw_text\": \"Presence of symptomatic CNS metastasis\"\n                            },\n                            \"right\": {\n              