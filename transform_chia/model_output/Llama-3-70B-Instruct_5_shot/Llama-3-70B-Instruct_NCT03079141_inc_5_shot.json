"{\n  \"AND\": {\n    \"left\": {\n      \"AND\": {\n        \"left\": {\n          \"raw_text\": \"Age of = 18 years of age\"\n        },\n        \"right\": {\n          \"raw_text\": \"and able to give written informed consent;\"\n        }\n      }\n    },\n    \"right\": {\n      \"AND\": {\n        \"left\": {\n          \"raw_text\": \"Active chronic central serous chorioretinopathy (cCSC);\"\n        },\n        \"right\": {\n          \"AND\": {\n            \"left\": {\n              \"raw_text\": \"Subjective visual loss > 6 weeks, interpreted as onset of active disease;\"\n            },\n            \"right\": {\n              \"AND\": {\n                \"left\": {\n                  \"raw_text\": \"Foveal subretinal fluid (SRF), on optical coherence tomography (OCT), at Baseline Examination;\"\n                },\n                \"right\": {\n                  \"AND\": {\n                    \"left\": {\n                      \"raw_text\": \"=1 ill-defined hyperfluorescent leakage areas on fluorescein angiography (FA) with retinal pigment epithelial window defect(s) that are compatible with cCSC;\"\n                    },\n                    \"right\": {\n                      \"raw_text\": \"Hyperfluorescent areas on indocyanine green angiography (ICGA).\"\n                    }\n                  }\n                }\n              }\n            }\n          }\n        }\n      }\n    }\n  }\n}"