"{\n  \"AND\": {\n    \"left\": {\n      \"raw_text\": \"Prior treatment with gemcitabine, carboplatin (except in the adjuvant setting), or Iniparib.\"\n    },\n    \"right\": {\n      \"AND\": {\n        \"left\": {\n          \"NOT\": {\n            \"left\": {\n              \"NOT\": {\n                \"left\": {\n                  \"OR\": {\n                    \"left\": {\n                      \"raw_text\": \"treated non-melanoma skin cancer\"\n                    },\n                    \"right\": {\n                      \"OR\": {\n                        \"left\": {\n                          \"raw_text\": \"or carcinoma in-situ of any primary site\"\n                        },\n                        \"right\": {\n                          \"OR\": {\n                            \"left\": {\n                              \"raw_text\": \"or invasive cancers treated definitively\"\n                            },\n                            \"right\": {\n                              \"AND\": {\n                                \"left\": {\n                                  \"raw_text\": \"with treatment ending >5 years previously\"\n                                },\n                                \"right\": {\n                                  \"raw_text\": \"and no evidence of recurrences\"\n                                }\n                              }\n                            }\n                          }\n                        }\n                      }\n                    }\n                  }\n                }\n              }\n            }\n          }\n        },\n        \"right\": {\n          \"AND\": {\n            \"left\": {\n              \"OR\": {\n                \"left\": {\n                  \"raw_text\": \"A history of cardiac disease, as defined by:\"\n                },\n                \"right\": {\n                  \"OR\": {\n                    \"left\": {\n                      \"raw_text\": \"Malignant hypertension\"\n                    },\n                    \"right\": {\n                      \"OR\": {\n                        \"left\": {\n                          \"raw_text\": \"Unstable angina\"\n                        },\n                        \"right\": {\n                          \"OR\": {\n                            \"left\": {\n                              \"raw_text\": \"Congestive heart failure\"\n                            },\n                            \"right\": {\n                              \"OR\": {\n                                \"left\": {\n                                  \"raw_text\": \"Myocardial infarction within the previous 6 months\"\n                                },\n                                \"right\": {\n                                  \"raw_text\": \"Symptomatic, unstable or uncontrolled, cardiac arrhythmias. Patients who have stable, rate-controlled atrial fibrillation are eligible for study enrollment\"\n                                }\n                              }\n                            }\n                          }\n                        }\n                      }\n                    }\n                    }\n                  }\n                }\n              }\n            }\n            }\n          }\n        }\n        \"right\": {\n          \"AND\": {\n            \"left\": {\n              \"raw_text\": \"Active brain metastases.\"\n            },\n            \"right\": {\n              \"raw_text\": \"Patients with treated brain metastases are eligible, if (1) radiation therapy was completed at least 2 weeks prior to study entry; (2) follow-up scan shows no disease progression; and (3) patients do not require steroids\"\n            }\n          }\n          \"right\": {\n            \"raw_text\": \"Women who are pregnant or lactating \"right\": \"raw_text\": \"or breastfeeding women\"\n          \"right\": {\n              \"raw_text\": \"or lactating \"right\": \"raw_text\": \"Women wh