"{\n  \"AND\": {\n    \"left\": {\n      \"OR\": {\n        \"left\": {\n          \"raw_text\": \"Pregnancy: Women who are pregnant or lactating.\"\n        },\n        \"right\": {\n          \"AND\": {\n            \"left\": {\n              \"raw_text\": \"Asthma: Subjects with a current diagnosis of asthma.\"\n            },\n            \"right\": {\n              \"raw_text\": \"(Subjects with a prior history of asthma are eligible if they also have a current diagnosis of COPD).\"\n          }\n        }\n      }\n    },\n    \"right\": {\n      \"AND\": {\n        \"left\": {\n          \"raw_text\": \"alpha 1-antitrypsin deficiency: Subjects with known alpha-1 antitrypsin deficiency as the underlying cause of COPD.\"\n        },\n        \"right\": {\n          \"OR\": {\n            \"left\": {\n              \"raw_text\": \"Other respiratory disorders: Subjects with active tuberculosis, lung cancer, bronchiectasis, sarcoidosis, pulmonary fibrosis, interstitial lung diseases or other active pulmonary diseases\"\n            },\n            \"right\": {\n              \"raw_text\": \"Lung resection or transplantation: Subjects with lung resection or transplantation\"\n          }\n        }\n      }\n    }\n    }\n  }\n  \"right\": {\n        \"AND\": {\n          \"left\": {\n              \"raw_text\": \" and201