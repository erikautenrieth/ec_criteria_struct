"{\n  \"AND\": {\n    \"left\": {\n      \"raw_text\": \"Contraindications for spinal anesthesia (like bleeding diathesis or regional infection at site of neuroaxial block)\"\n    },\n    \"right\": {\n      \"AND\": {\n        \"left\": {\n          \"raw_text\": \"Known allergy to Granisetron or local anaesthetic (heavy bupivacaine, Marcaine Spinal 0.5% Heavy, 5mg/ml, AstraZeneca ampule)\"\n        },\n        \"right\": {\n          \"AND\": {\n            \"left\": {\n              \"raw_text\": \"Pregnancy induced hypertension\"\n            },\n            \"right\": {\n              \"AND\": {\n                \"left\": {\n                  \"OR\": {\n                    \"left\": {\n                      \"raw_text\": \"Congenital\"\n                    },\n                    \"right\": {\n                      \"raw_text\": \"or rheumatic heart diseases\"\n                    }\n                  }\n                },\n                \"right\": {\n                  \"AND\": {\n                    \"left\": {\n                      \"raw_text\": \"Antepartum haemorrhage\"\n                    },\n                    \"right\": {\n                      \"AND\": {\n                        \"left\": {\n                          \"raw_text\": \"Fetal destress\"\n                        },\n                        \"right\": {\n                          \"raw_text\": \"or gestational age < 36 week\"\n                        }\n                      }\n                    }\n                  }\n                }\n              }\n            }\n          }\n        }\n      }\n    }\n  }\n}"