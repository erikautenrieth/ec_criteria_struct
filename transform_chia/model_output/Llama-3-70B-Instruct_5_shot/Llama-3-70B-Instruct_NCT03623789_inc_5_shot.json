"{\n  \"AND\": {\n    \"left\": {\n      \"AND\": {\n        \"left\": {\n          \"raw_text\": \"Patients with osteoarthritis of the hip secondary to degeneration\"\n        },\n        \"right\": {\n          \"OR\": {\n            \"left\": {\n              \"raw_text\": \"inflammatory arthritis\"\n            },\n            \"right\": {\n              \"OR\": {\n                \"left\": {\n                  \"raw_text\": \"gouty arthritis\"\n                },\n                \"right\": {\n                  \"OR\": {\n                    \"left\": {\n                      \"raw_text\": \"acetabular dysplasia\"\n                    },\n                    \"right\": {\n                      \"raw_text\": \"or osteonecrosis of the femoral head\"\n                    }\n                  }\n                }\n              }\n            }\n          }\n        }\n      }\n    },\n    \"right\": {\n      \"AND\": {\n        \"left\": {\n          \"AND\": {\n            \"left\": {\n              \"raw_text\": \"Age > 18 years\"\n            },\n            \"right\": {\n              \"raw_text\": \"and < 90 years\"\n            }\n          }\n        },\n        \"right\": {\n          \"AND\": {\n            \"left\": {\n              \"raw_text\": \"Failure of medical treatment or rehabilitation.\"\n            },\n            \"right\": {\n              \"AND\": {\n                \"left\": {\n                  \"raw_text\": \"Hemoglobin > 11g/dl\"\n                },\n                \"right\": {\n                  \"raw_text\": \"No use of non-steroid anti-inflammatory agent one week before operation\"\n                }\n              }\n            }\n          }\n        }\n      }\n    }\n  }\n}"