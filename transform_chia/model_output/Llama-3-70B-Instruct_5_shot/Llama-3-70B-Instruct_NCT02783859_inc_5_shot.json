"{\n  \"AND\": {\n    \"left\": {\n      \"AND\": {\n        \"left\": {\n          \"raw_text\": \"Hospitalised children\"\n        },\n        \"right\": {\n          \"AND\": {\n            \"left\": {\n              \"raw_text\": \"aged 3-mo to 5-yrs\"\n            },\n            \"right\": {\n              \"raw_text\": \"(in Darwin, children have to be Indigenous)\"\n            }\n          }\n        }\n      }\n    },\n    \"right\": {\n      \"AND\": {\n        \"left\": {\n          \"AND\": {\n            \"left\": {\n              \"OR\": {\n                \"left\": {\n                  \"raw_text\": \"temperature >37.5 celsius\"\n                },\n                \"right\": {\n                  \"OR\": {\n                    \"left\": {\n                      \"raw_text\": \"or a history of fever at home\"\n                    },\n                    \"right\": {\n                      \"raw_text\": \"or observed at the referring clinic\"\n                    }\n                  }\n                }\n              }\n            },\n            \"right\": {\n              \"AND\": {\n                \"left\": {\n                  \"raw_text\": \"age-adjusted tachypnoea [respiratory rate>50 if <12-months; respiratory rate>40 if >12-months]\"\n                },\n                \"right\": {\n                  \"AND\": {\n                    \"left\": {\n                      \"raw_text\": \"with chest wall recession\"\n                    },\n                    \"right\": {\n                      \"raw_text\": \"and/or oxygen saturation <92% in air\"\n                    }\n                  }\n                }\n              }\n            }\n          }\n        },\n        \"right\": {\n          \"AND\": {\n            \"left\": {\n              \"raw_text\": \"consolidation on chest X-ray as diagnosed by treating clinician\"\n            },\n            \"right\": {\n              \"AND\": {\n                \"left\": {\n                  \"raw_text\": \"After 1-3 days of IV antibiotics\"\n                },\n                \"right\": {\n                  \"AND\": {\n                    \"left\": {\n                      \"raw_text\": \"are afebrile\"\n                    },\n                    \"right\": {\n                      \"AND\": {\n                        \"left\": {\n                          \"raw_text\": \"with improved respiratory symptoms and signs\"\n                        },\n                        \"right\": {\n                          \"AND\": {\n                            \"left\": {\n                              \"raw_text\": \"oxygen saturation>90% in air\"\n                            },\n                            \"right\": {\n                              \"raw_text\": \"and are ready to be switched to oral amoxicillin-clavulanate\"\n                            }\n                          }\n                        }\n                      }\n                    }\n                  }\n                }\n              }\n            }\n          }\n        }\n      }\n    }\n  }\n}"