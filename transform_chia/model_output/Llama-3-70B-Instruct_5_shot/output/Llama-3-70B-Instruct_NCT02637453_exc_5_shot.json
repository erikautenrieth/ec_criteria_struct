"{\n  \"AND\": {\n    \"left\": {\n      \"OR\": {\n        \"left\": {\n          \"AND\": {\n            \"left\": {\n              \"raw_text\": \"With acute diseases\"\n            },\n            \"right\": {\n              \"OR\": {\n                \"left\": {\n                  \"raw_text\": \"such as acute phase after myocardial infarction\"\n                },\n                \"right\": {\n                  \"OR\": {\n                    \"left\": {\n                      \"raw_text\": \"(within 3 months)\"\n                    },\n                    \"right\": {\n                      \"OR\": {\n                        \"left\": {\n                          \"raw_text\": \"within 3 months after acute heart failure\"\n                        },\n                        \"right\": {\n                          \"raw_text\": \"or new cerebral infarction\"\n                        }\n                      }\n                    }\n                  }\n                }\n              }\n            }\n          }\n        },\n        \"right\": {\n          \"OR\": {\n            \"left\": {\n              \"raw_text\": \"In the list of heart transplantation\"\n            },\n            \"right\": {\n              \"OR\": {\n                \"left\": {\n                  \"raw_text\": \"Expected survival less than 1 year\"\n                },\n                \"right\": {\n                  \"OR\": {\n                    \"left\": {\n                      \"raw_text\": \"With other hemorrhagic diseases and anticoagulant therapy is not allowed\"\n                    },\n                    \"right\": {\n                      \"OR\": {\n                        \"left\": {\n                          \"raw_text\": \"Thrombosis in left atrium\"\n                        },\n                        \"right\": {\n                          \"OR\": {\n                            \"left\": {\n                              \"raw_text\": \"Heart failure, New York Heart Association(NYHA) III/IV or eject fraction(EF)<40%\"\n                            },\n                            \"right\": {\n                              \"OR\": {\n                                \"left\": {\n                                  \"raw_text\": \"Patients with uncontrolled cancer\"\n                                },\n                                \"right\": {\n                                  \"OR\": {\n                                    \"left\": {\n                                      \"raw_text\": \"Significant hepatic or renal impairment\"\n                                    },\n                                    \"right\": {\n                                      \"OR\": {\n                                        \"left\": {\n                                          \"raw_text\": \"(and/or alanine transaminase(ALT) or Aspartate transaminase(AST) >2 times upper limit of normal\"\n                                        },\n                                        \"right\": {\n                                          \"raw_text\": \", creatinine clearance rate(CCr)<50%\"\n                                        }\n                                      }\n                                    }\n                                  }\n                                }\n                              }\n                            }\n                          }\n                        }\n                      }\n                    }\n                  }\n                }\n              }\n            }\n          }\n        }\n      }\n    },\n    \"right\": {\n      \"AND\": {\n        \"left\": {\n          \"raw_text\": \"Previous catheter radiofrequency ablation for AF or cardiac surgery\"\n        },\n        \"right\": {\n          \"raw_text\": \"Pregnant and lactating women, women who plan to become pregnant, or women of child bearing age not using reliable contraceptive measures\"\n        }\n      }\n    }\n  }\n}"