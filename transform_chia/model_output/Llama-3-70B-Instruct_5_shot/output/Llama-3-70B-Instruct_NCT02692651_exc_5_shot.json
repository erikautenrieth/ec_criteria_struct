"{\n  \"AND\": {\n    \"left\": {\n      \"raw_text\": \"Patients with severe-complicated disease that would compromise oral therapy\"\n    },\n    \"right\": {\n      \"AND\": {\n        \"left\": {\n          \"AND\": {\n            \"left\": {\n              \"raw_text\": \"(hypotenstion or shock\"\n            },\n            \"right\": {\n              \"OR\": {\n                \"left\": {\n                  \"raw_text\": \"ileus or bowel obstruction\"\n                },\n                \"right\": {\n                  \"raw_text\": \"megacolon)\"\n                }\n              }\n            }\n          }\n        },\n        \"right\": {\n          \"AND\": {\n            \"left\": {\n              \"raw_text\": \"Patients with an allergy to oral vancomycin or fidaxomicin\"\n            },\n            \"right\": {\n              \"AND\": {\n                \"left\": {\n                  \"raw_text\": \"Patients anticipated to receive metronidazole after enrollment\"\n                },\n                \"right\": {\n                  \"AND\": {\n                    \"left\": {\n                      \"raw_text\": \"Patients who already received oral vancomycin or metronidazole (either oral or intravenous) for > 24 hours within the preceding 72 hours at the time of enrollment\"\n                    },\n                    \"right\": {\n                      \"raw_text\": \"Patients anticipated to receive adjunctive C. difficile therapy (rifaxamin, nitazoxanide, tigecycline) after enrollment\"\n                    }\n                  }\n                }\n              }\n            }\n          }\n        }\n      }\n    }\n  }\n}"