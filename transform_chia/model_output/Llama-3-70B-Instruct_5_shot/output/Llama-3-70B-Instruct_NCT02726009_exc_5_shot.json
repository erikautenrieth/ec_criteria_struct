"{\n  \"AND\": {\n    \"left\": {\n      \"raw_text\": \"Previous or concurrent hormonal management of prostate cancer\"\n    },\n    \"right\": {\n      \"AND\": {\n        \"left\": {\n          \"raw_text\": \"Contraindication for prescription of Firmagon®\"\n        },\n        \"right\": {\n          \"AND\": {\n            \"left\": {\n              \"raw_text\": \"Concurrent treatment with a 5-a-reductase inhibitor\"\n            },\n            \"right\": {\n              \"AND\": {\n                \"left\": {\n                  \"raw_text\": \"Considered as a candidate for curative therapy\"\n                },\n                \"right\": {\n                  \"AND\": {\n                    \"left\": {\n                      \"raw_text\": \"History of severe untreated asthma, anaphylactic reactions or severe urticaria and/or angioedema\"\n                    },\n                    \"right\": {\n                      \"AND\": {\n                        \"left\": {\n                          \"raw_text\": \"QTc interval over 450 msec or risk factors for torsades de pointes or on Class IA and Class III anti arrhythmic medications\"\n                        },\n                        \"right\": {\n                          \"AND\": {\n                            \"left\": {\n                              \"raw_text\": \"Cancer within the last 5 years except prostate cancer and surgically removed basal or squamous cell carcinoma of the skin\"\n                            },\n                            \"right\": {\n                              \"AND\": {\n                                \"left\": {\n                                  \"raw_text\": \"Known or suspected hepatic, symptomatic biliary disease (this includes moderate to severe chronic hepatic impairment)\"\n                                },\n                                \"right\": {\n                                  \"AND\": {\n                                    \"left\": {\n                