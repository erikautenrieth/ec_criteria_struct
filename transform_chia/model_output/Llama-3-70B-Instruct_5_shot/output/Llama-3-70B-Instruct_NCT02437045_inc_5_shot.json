"{\n  \"AND\": {\n    \"left\": {\n      \"AND\": {\n        \"left\": {\n          \"raw_text\": \"Bloodstream infection with Enterobacter spp., Serratia marcescens, Providencia spp., Morganella morganii or Citrobacter freundii (i.e. likely AmpC-producer)\"\n        },\n        \"right\": {\n          \"AND\": {\n            \"left\": {\n              \"raw_text\": \"and susceptibility to 3rd generation cephalosporins (i.e. ceftriaxone, cefotaxime or ceftazidime)\"\n            },\n            \"right\": {\n              \"AND\": {\n                \"left\": {\n                  \"raw_text\": \"meropenem and piperacillin-tazobactam from at least one blood culture draw\"\n                },\n                \"right\": {\n                  \"raw_text\": \"This will be determined in accordance with laboratory methods and susceptibility breakpoints defined by protocols used in the recruiting site laboratories.\"\n                }\n              }\n            }\n          }\n        }\n      }\n    },\n    \"right\": {\n      \"AND\": {\n        \"left\": {\n          \"raw_text\": \"No more than 72 hours has elapsed since the first positive blood culture collection\"\n        },\n        \"right\": {\n          \"raw_text\": \"Patient is aged 18 years and over (>=21y in Singapore)\"\n        }\n      }\n    }\n  }\n}"