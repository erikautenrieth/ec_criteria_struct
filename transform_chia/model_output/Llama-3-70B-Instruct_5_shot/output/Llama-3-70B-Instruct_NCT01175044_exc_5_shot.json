"{\n  \"AND\": {\n    \"left\": {\n      \"OR\": {\n        \"left\": {\n          \"raw_text\": \"Inability to provide informed consent\"\n        },\n        \"right\": {\n          \"OR\": {\n            \"left\": {\n              \"raw_text\": \"or to comply with study assessments\"\n            },\n            \"right\": {\n              \"raw_text\": \"(e.g. due to cognitive impairment or geographic distance).\"\n            }\n          }\n        }\n      }\n    },\n    \"right\": {\n      \"AND\": {\n        \"left\": {\n          \"raw_text\": \"Age = 17.\"\n        },\n        \"right\": {\n          \"AND\": {\n            \"left\": {\n              \"raw_text\": \"Allergy to povidone iodine.\"\n            },\n            \"right\": {\n              \"AND\": {\n                \"left\": {\n                  \"raw_text\": \"Any condition requiring antibiotics 14 days prior to arriving for surgery.\"\n                },\n                \"right\": {\n                  \"AND\": {\n                    \"left\": {\n                      \"raw_text\": \"Patients with chronic immunosuppression (such as HIV/AIDS).\"\n                    },\n                    \"right\": {\n                      \"AND\": {\n                        \"left\": {\n                          \"raw_text\": \"Unable to adhere to follow up schedule and treatment.\"\n                        },\n                        \"right\": {\n                          \"raw_text\": \"Patients scheduled to undergo revision total knee arthroplasty for infectious reasons.\"\n                        }\n                      }\n                    }\n                  }\n                }\n              }\n            }\n          }\n        }\n      }\n    }\n  }\n}"