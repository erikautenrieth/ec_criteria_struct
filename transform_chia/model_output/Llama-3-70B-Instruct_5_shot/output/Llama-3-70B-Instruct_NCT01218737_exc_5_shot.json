"{\n  \"AND\": {\n    \"left\": {\n      \"OR\": {\n        \"left\": {\n          \"raw_text\": \"Surgery\"\n        },\n        \"right\": {\n          \"raw_text\": \"and/or previous ocular pathology (presence of scar/change in the cornea, glaucoma, retinopathies, etc.)\"\n        }\n      }\n    },\n    \"right\": {\n      \"AND\": {\n        \"left\": {\n          \"OR\": {\n            \"left\": {\n              \"raw_text\": \"Patient has diabetes\"\n            },\n            \"right\": {\n              \"raw_text\": \"or is immunodepressed\"\n            }\n          }\n        },\n        \"right\": {\n          \"AND\": {\n            \"left\": {\n              \"raw_text\": \"Any systemic infection during the study\"\n            },\n            \"right\": {\n              \"AND\": {\n                \"left\": {\n                  \"OR\": {\n                    \"left\": {\n                      \"raw_text\": \"Signs\"\n                    },\n                    \"right\": {\n                      \"raw_text\": \"and/or symptoms of ocular inflammation/infection (bacterial, viral, fungal, caused by Chlamydia, by Mycobacterium, Acanthamoeba or of allergic etiology)\"\n                    }\n                  }\n                },\n                \"right\": {\n                  \"AND\": {\n                    \"left\": {\n                      \"raw_text\": \"Have used any systemic or topical antibiotics for ocular infection in the previous 14 days\"\n                    },\n                    \"right\": {\n                      \"raw_text\": \"Patient has known hypersensitivity to any of the components of the formulations used in the study\"\n                    }\n                  }\n                }\n              }\n            }\n          }\n        }\n      }\n    }\n  }\n}"