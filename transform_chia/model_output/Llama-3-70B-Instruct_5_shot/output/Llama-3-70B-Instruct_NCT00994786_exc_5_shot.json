"{\n  \"AND\": {\n    \"left\": {\n      \"raw_text\": \"Patients with any other primary DSM-IV psychiatric diagnosis in addition to Obsessive Compulsive Disorder.\"\n    },\n    \"right\": {\n      \"AND\": {\n        \"left\": {\n          \"OR\": {\n            \"left\": {\n              \"raw_text\": \"Patients who currently fulfil criteria for DSM-IV eating disorder\"\n            },\n            \"right\": {\n              \"OR\": {\n                \"left\": {\n                  \"raw_text\": \", body dysmorphic disorder\"\n                },\n                \"right\": {\n                  \"OR\": {\n                    \"left\": {\n                      \"raw_text\": \"current alcohol or substance abuse\"\n                    },\n                    \"right\": {\n                      \"raw_text\": \"or who have a lifetime history of bipolar disorder.\"\n                    }\n                  }\n                }\n              }\n            }\n          }\n        },\n        \"right\": {\n          \"AND\": {\n            \"left\": {\n              \"raw_text\": \"Patients with a history of Schizophrenia and other psychotic disorders, Delirium, Dementia, and Amnestic and other cognitive disorders.\"\n            },\n            \"right\": {\n              \"AND\": {\n                \"left\": {\n                  \"raw_text\": \"Subjects with a concurrent Axis II Cluster A Personality Disorder\"\n                },\n                \"right\": {\n                  \"OR\": {\n                    \"left\": {\n                      \"raw_text\": \"Borderline\"\n                    },\n                    \"right\": {\n                      \"raw_text\": \"or Antisocial Personality Disorder\"\n                    }\n                  }\n                }\n              }\n            }\n          }\n        }\n      }\n    }\n    }\n  }\n  }\n}"