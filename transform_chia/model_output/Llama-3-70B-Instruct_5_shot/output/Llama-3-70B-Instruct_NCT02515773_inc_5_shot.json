"{\n  \"AND\": {\n    \"left\": {\n      \"AND\": {\n        \"left\": {\n          \"raw_text\": \"Inpatient or outpatient age 8-19 years inclusive\"\n        },\n        \"right\": {\n          \"raw_text\": \"participants must live with a parent, guardian, or caregiver\"\n        }\n      }\n    },\n    \"right\": {\n      \"AND\": {\n        \"left\": {\n          \"raw_text\": \"Fluent in English\"\n        },\n        \"right\": {\n          \"AND\": {\n            \"left\": {\n              \"OR\": {\n                \"left\": {\n                  \"raw_text\": \"Diagnosed or told by a clinician that they have bipolar I\"\n                },\n                \"right\": {\n                  \"OR\": {\n                    \"left\": {\n                      \"raw_text\": \"bipolar II\"\n                    },\n                    \"right\": {\n                      \"OR\": {\n                        \"left\": {\n                          \"raw_text\": \"unspecified bipolar and related disorders\"\n                        },\n                        \"right\": {\n                          \"OR\": {\n                            \"left\": {\n                              \"raw_text\": \"Disruptive Mood Dysregulation Disorder (DMDD)\"\n                            },\n                            \"right\": {\n                              \"OR\": {\n                                \"left\": {\n                                  \"raw_text\": \"cyclothymic disorder\"\n                                },\n                                \"right\": {\n                                  \"OR\": {\n                                    \"left\": {\n                                      \"raw_text\": \"other specified bipolar and related disorders\"\n                                    },\n                                    \"right\": {\n                                      \"raw_text\": \"as well as mood disorder not otherwise specified (if diagnosed in the past as per DSM-IV)\"\n                                    }\n                                  }\n                                }\n                              }\n                            }\n                          }\n                        }\n                      }\n                    }\n                  }\n                }\n              }\n            },\n            \"right\": {\n              \"AND\": {\n                \"left\": {\n                  \"raw_text\": \"Body mass index >85%ile for age and sex by standard growth charts\"\n                },\n                \"right\": {\n                  \"raw_text\": \"Received a new or ongoing prescription for at least one SGA (i.e., olanzapine, clozapine, risperidone, quetiapine, aripiprazole, ziprasidone, iloperidone, lurasidone, paliperidone, brexpiprazole or cariprazine) that is not prescribed as a PRN medication\"\n                }\n              }\n            }\n          }\n        }\n      }\n    }\n  }\n}"