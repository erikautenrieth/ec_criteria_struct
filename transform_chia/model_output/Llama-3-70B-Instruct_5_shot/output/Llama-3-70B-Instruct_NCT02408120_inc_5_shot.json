"{\n  \"AND\": {\n    \"left\": {\n      \"raw_text\": \"Subjects admitted to the hospital with acute or chronic medical illnesses or for elective and emergency surgical illness or trauma\"\n    },\n    \"right\": {\n      \"AND\": {\n        \"left\": {\n          \"raw_text\": \"Known history of Type 2 diabetes mellitus for >3 months\"\n        },\n        \"right\": {\n          \"AND\": {\n            \"left\": {\n              \"raw_text\": \"Treated with either diet alone, any combination of oral antidiabetic agents, non-insulin injectables or insulin therapy\"\n            },\n            \"right\": {\n              \"AND\": {\n                \"left\": {\n                  \"raw_text\": \"Blood glucose levels between >140 mg\"\n                },\n                \"right\": {\n                  \"AND\": {\n                    \"left\": {\n                      \"raw_text\": \"and <400 mg/dL\"\n                    },\n                    \"right\": {\n                      \"NOT\": {\n                        \"left\": {\n                          \"raw_text\": \"without laboratory evidence of diabetic ketoacidosis\"\n                        }\n                      }\n                    }\n                  }\n                }\n              }\n            }\n          }\n        }\n      }\n    }\n  }\n}"