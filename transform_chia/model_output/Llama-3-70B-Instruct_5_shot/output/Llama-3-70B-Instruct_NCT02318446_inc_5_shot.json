"{\n  \"AND\": {\n    \"left\": {\n      \"AND\": {\n        \"left\": {\n          \"raw_text\": \"Diagnosed epileptic patients of either sex\"\n        },\n        \"right\": {\n          \"AND\": {\n            \"left\": {\n              \"raw_text\": \"with age between 10-19 yrs (<19yrs)\"\n            },\n            \"right\": {\n              \"AND\": {\n                \"left\": {\n                  \"raw_text\": \"coming to the medicine Out Patient /In Patient Departments\"\n                },\n                \"right\": {\n                  \"AND\": {\n                    \"left\": {\n                      \"raw_text\": \"and undergoing AED therapy for more than 6 months\"\n                    },\n                    \"right\": {\n                      \"AND\": {\n                        \"left\": {\n                          \"raw_text\": \"Epileptics with high homocysteine levels i.e. > 10.9 µmol/L\"\n                        },\n                        \"right\": {\n                          \"raw_text\": \"(Normal homocysteine levels are 4.3-9.9 µmol/L for male and 3.3-7.2 µmol/L for female adolescent and a high homocysteine concentration is deaned as at least 11.4 µmol/L for male and at least 10.4 µmol/L for female. Gender mean of high homocysteine concentration is 10.9 µmol/L)\"\n                        }\n                      }\n                    }\n                  }\n                }\n              }\n            }\n          }\n        }\n      }\n    }\n  }\n}"