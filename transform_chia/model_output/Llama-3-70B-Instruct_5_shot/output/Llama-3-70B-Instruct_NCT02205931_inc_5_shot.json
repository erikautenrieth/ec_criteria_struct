"{\n  \"AND\": {\n    \"left\": {\n      \"AND\": {\n        \"left\": {\n          \"raw_text\": \"Age between 1 month and 24 months of age\"\n        },\n        \"right\": {\n          \"raw_text\": \"(not beyond second birthday at baseline).\"\n        }\n      }\n    },\n    \"right\": {\n      \"AND\": {\n        \"left\": {\n          \"raw_text\": \"Diagnosis of epilepsy confirmed.\"\n        },\n        \"right\": {\n          \"AND\": {\n            \"left\": {\n              \"raw_text\": \"At least an average of 4 seizures/week in baseline period.\"\n            },\n            \"right\": {\n              \"AND\": {\n                \"left\": {\n                  \"raw_text\": \"Failed response to previous trial of two anti-epileptic drugs. In the case of infantile spasms this could include a trial of corticosteroids.\"\n                },\n                \"right\": {\n                  \"raw_text\": \"Children with written informed consent from parent/guardian.\"\n                }\n              }\n            }\n          }\n        }\n      }\n    }\n  }\n}"