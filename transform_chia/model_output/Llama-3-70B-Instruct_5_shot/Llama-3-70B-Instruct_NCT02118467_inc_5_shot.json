"{\n  \"AND\": {\n    \"left\": {\n      \"raw_text\": \"Age greater than or equal to 18 years old\"\n    },\n    \"right\": {\n      \"raw_text\": \"Requirement for vasoactive drugs via a central venous catheter for the treatment of shock. Shock will be defined as\"\n      \"AND\": {\n        \"left\": {\n          \"OR\": {\n            \"left\": {\n              \"raw_text\": \"mean arterial pressure less than 70 mmHg\"\n            },\n            \"right\": {\n              \"raw_text\": \"or systolic blood pressure less than 100 mmHg despite administration of at least 1000 mL of crystalloid or 500 mL of colloid\"\n            }\n          }\n        },\n        \"right\": {\n          \"NOT\": {\n            \"left\": {\n              \"OR\": {\n                \"left\": {\n                  \"raw_text\": \"unless there is an elevation in the central venous pressure to > 12 mmHg\"\n                },\n                \"right\": {\n                  \"raw_text\": \"or in the pulmonary artery occlusion pressure to > 14 mmHg\"\n                }\n              }\n            }\n          },\n          \"AND\": {\n            \"left\": {\n              \"raw_text\": \"coupled with signs of tissue hypoperfusion\"\n            },\n            \"right\": {\n              \"OR\": {\n                \"left\": {\n                  \"raw_text\": \"altered mental state\"\n                },\n                \"right\": {\n                  \"OR\": {\n                    \"left\": {\n                      \"raw_text\": \"mottled skin\"\n                    },\n                    \"right\": {\n                      \"OR\": {\n                        \"left\": {\n                          \"raw_text\": \"urine output < 0.5 mL/kg body weight for one hour\"\n                        },\n                        \"right\": {\n                          \"raw_text\": \"or a serum lactate level of > 2 mmol per liter\"\n                        }\n                      }\n                    }\n                  }\n                }\n              }\n            }\n          }\n        }\n      }\n    }\n  }\n}"