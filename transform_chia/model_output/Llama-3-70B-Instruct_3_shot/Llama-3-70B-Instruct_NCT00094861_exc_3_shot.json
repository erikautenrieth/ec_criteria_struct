"{\n  \"AND\": {\n    \"left\": {\n      \"raw_text\": \"Metastatic disease (M1)/stage 4 NSCLC\"\n    },\n    \"right\": {\n      \"AND\": {\n        \"left\": {\n          \"AND\": {\n            \"left\": {\n              \"raw_text\": \"Pleural or pericardial effusion greater than 100 ml in volume as documented by appropriate imaging (positron emission tomography [PET], computed tomography [CT] scan or ultrasound)\"\n            },\n            \"right\": {\n              \"NOT\": {\n                \"left\": {\n                  \"AND\": {\n                    \"left\": {\n                      \"raw_text\": \"If an effusion greater than 100 ml is documented by cytology to be free from malignancy\"\n                    },\n                    \"right\": {\n                      \"AND\": {\n                        \"left\": {\n                          \"raw_text\": \"and the investigator feels the patient is capable of receiving chemo/radiotherapy for their primary disease/ NSCLC\"\n                        },\n                        \"right\": {\n                          \"raw_text\": \"the investigator should discuss the patient with the study physician at Amgen\"\n                        }\n                      }\n                    }\n                  }\n                }\n              }\n            }\n          }\n        },\n        \"right\": {\n          \"AND\": {\n            \"left\": {\n              \"raw_text\": \"Effusions smaller than 100 ml would be acceptable, unless the investigator suspects that the effusion is malignant, in which case the effusions should be evaluated by cytology\"\n            },\n            \"right\": {\n              \"AND\": {\n                \"left\": {\n                  \"raw_text\": \"Sponsor approval must be obtained before patient is randomized\"\n                },\n                \"right\": {\n                  \"AND\": {\n                    \"left\": {\n                      \"raw_text\": \"Plan to remove the tumor surgically before completing the protocol chemo/radiotherapy course\"\n                    },\n                    \"right\": {\n                      \"AND\": {\n                        \"left\": {\n                          \"raw_text\": \"Shielding of any part of the esophagus during radiotherapy (including posterior spinal cord shielding)\"\n                        },\n                        \"right\": {\n                          \"AND\": {\n                            \"left\": {\n                              \"raw_text\": \"Prior chemotherapy, radiotherapy, or surgery for NSCLC\"\n                            },\n                            \"right\": {\n                              \"AND\": {\n                                \"left\": {\n                                  \"raw_text\": \"Prior invasive malignancy during the past 3 years other than non-melanomatous skin cancer\"\n                                },\n                                \"right\": {\n                                  \"NOT\": {\n                                    \"left\": {\n                                      \"raw_text\": \"Patients with prior surgically-cured malignancies [eg, stage I breast cancer or prostate cancer, in-situ carcinoma of the cervix, etc] are not excluded\"\n                                    }\n                                  }\n                                }\n                              }\n                            }\n                          }\n                        }\n                      }\n                    }\n                  }\n                }\n              }\n            }\n          }\n        }\n      }\n    }\n  }\n}"