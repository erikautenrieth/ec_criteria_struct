"{\n  \"AND\": {\n    \"left\": {\n      \"AND\": {\n        \"left\": {\n          \"raw_text\": \"Post menopausal women\"\n        },\n        \"right\": {\n          \"AND\": {\n            \"left\": {\n              \"raw_text\": \"with a history of estrogen positive breast cancer\"\n            },\n            \"right\": {\n              \"raw_text\": \"who are receiving aromatase inhibitors for at least one month.\"\n            }\n          }\n        }\n      }\n    },\n    \"right\": {\n      \"AND\": {\n        \"left\": {\n          \"raw_text\": \"Patients must complain of mild to moderate arthralgia.\"\n        },\n        \"right\": {\n          \"AND\": {\n            \"left\": {\n              \"raw_text\": \"Ability to understand and sign informed consent.\"\n            },\n            \"right\": {\n              \"raw_text\": \"Patients meet criteria for low to moderate risk for moderate exercise based on the ACSM guidelines.\"\n            }\n          }\n        }\n      }\n    }\n  }\n}"