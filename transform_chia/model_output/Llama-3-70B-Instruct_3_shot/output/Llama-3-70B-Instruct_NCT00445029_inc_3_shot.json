"{\n  \"AND\": {\n    \"left\": {\n      \"AND\": {\n        \"left\": {\n          \"raw_text\": \"Patients aged from 18 to 65 years old.\"\n        },\n        \"right\": {\n          \"raw_text\": \"Both genders eligible for study.\"\n        }\n      }\n    },\n    \"right\": {\n      \"AND\": {\n        \"left\": {\n          \"raw_text\": \"Female participants must use a contraceptive method.\"\n        },\n        \"right\": {\n          \"AND\": {\n            \"left\": {\n              \"raw_text\": \"Feasibility of patch testing.\"\n            },\n            \"right\": {\n              \"AND\": {\n                \"left\": {\n                  \"raw_text\": \"Participants must be able to understand and sign the Informed Consent, and comply with all aspects of the protocol.\"\n                },\n                \"right\": {\n                  \"AND\": {\n                    \"left\": {\n                      \"raw_text\": \"Patients must be registered in a social security system or with a health insurance coverage\"\n                    },\n                    \"right\": {\n                      \"OR\": {\n                        \"left\": {\n                          \"AND\": {\n                            \"left\": {\n                              \"raw_text\": \"Patients with allergic contact dermatitis to para-phenylenediamine (PPD) based on a history of PPD contact dermatitis\"\n                            },\n                            \"right\": {\n                              \"raw_text\": \"and positive PPD patch tests.\"\n                            }\n                          }\n                        },\n                        \"right\": {\n                          \"AND\": {\n                            \"left\": {\n                              \"raw_text\": \"No history of PPD allergic contact dermatitis\"\n                            },\n                            \"right\": {\n                              \"raw_text\": \"with a negative PPD patch test.\"\n                            }\n                          }\n                        }\n                      }\n                    }\n                  }\n                }\n              }\n            }\n          }\n        }\n      }\n    }\n  }\n}"