"{\n  \"AND\": {\n    \"left\": {\n      \"raw_text\": \"Taking a tetracycline within 6 months or history of adverse reaction to minocycline or another tetracycline.\"\n    },\n    \"right\": {\n      \"AND\": {\n        \"left\": {\n          \"raw_text\": \"Enhanced risk from lumbar puncture, including documented or suspected cerebral mass lesion predisposing to brain herniation or bleeding diathesis.\"\n        },\n        \"right\": {\n          \"AND\": {\n            \"left\": {\n              \"OR\": {\n                \"left\": {\n                  \"raw_text\": \"Pregnancy\"\n                },\n                \"right\": {\n                  \"raw_text\": \"or expectation of pregnancy during the study.\"\n                }\n              }\n            },\n            \"right\": {\n              \"AND\": {\n                \"left\": {\n                  \"OR\": {\n                    \"left\": {\n                      \"raw_text\": \"Active opportunistic infection\"\n                    },\n                    \"right\": {\n                      \"raw_text\": \"or active neurological disease that might confound evaluation.\"\n                    }\n                  }\n                },\n                \"right\": {\n                  \"AND\": {\n                    \"left\": {\n                      \"raw_text\": \"ADC Stage > 1.\"\n                    },\n                    \"right\": {\n                      \"AND\": {\n                        \"left\": {\n                          \"raw_text\": \"Hemoglobin < 10 Gms/dL.\"\n                        },\n                        \"right\": {\n                          \"AND\": {\n                            \"left\": {\n                              \"OR\": {\n                                \"left\": {\n                                  \"raw_text\": \"BUN\"\n                                },\n                                \"right\": {\n                                  \"raw_text\": \"or creatine above the normal limits.\"\n                                }\n                              }\n                            },\n                            \"right\": {\n                              \"raw_text\": \"Taking other drugs known to reduce the metabolism of minocycline and thus increase the probability of toxicity.\"\n                            }\n                          }\n                        }\n                      }\n                    }\n                  }\n                }\n              }\n            }\n          }\n        }\n      }\n    }\n  }\n}"