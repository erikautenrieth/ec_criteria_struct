"{\n  \"AND\": {\n    \"left\": {\n      \"raw_text\": \"any neurological conditions other than PD;\"\n    },\n    \"right\": {\n      \"AND\": {\n        \"left\": {\n          \"raw_text\": \"significant musculoskeletal or cardiopulmonary diseases;\"\n        },\n        \"right\": {\n          \"AND\": {\n            \"left\": {\n              \"raw_text\": \"other disorders that may affect balance or locomotion;\"\n            },\n            \"right\": {\n              \"AND\": {\n                \"left\": {\n                  \"OR\": {\n                    \"left\": {\n                      \"raw_text\": \"taken any structured behavioral or exercise programs in the past 3 months\"\n                    },\n                    \"right\": {\n                      \"raw_text\": \"or they are receiving regular physical rehabilitation at present;\"\n                    }\n                  }\n                },\n                \"right\": {\n                  \"AND\": {\n                    \"left\": {\n                      \"raw_text\": \"unstable condition on anti-parkinsonian medications;\"\n                    },\n                    \"right\": {\n                      \"AND\": {\n                        \"left\": {\n                          \"raw_text\": \"surgical interventions for PD;\"\n                        },\n                        \"right\": {\n                          \"AND\": {\n                            \"left\": {\n                              \"raw_text\": \"communication or cognitive deficits with mini-mental state examination, (MMSE) <24/30 (Folstein et al., 1975);\"\n                            },\n                            \"right\": {\n                              \"raw_text\": \"a history of more than two falls in the previous 12 months.\"\n                            }\n                          }\n                        }\n                      }\n                    }\n                  }\n                }\n              }\n  