"{\n  \"AND\": {\n    \"left\": {\n      \"OR\": {\n        \"left\": {\n          \"AND\": {\n            \"left\": {\n              \"raw_text\": \"Active thromboembolic disease\"\n            },\n            \"right\": {\n              \"OR\": {\n                \"left\": {\n                  \"raw_text\": \"history of thromboembolic disease\"\n                },\n                \"right\": {\n                  \"OR\": {\n                    \"left\": {\n                      \"raw_text\": \"including retinal vein or artery occlusion\"\n                    },\n                    \"right\": {\n                      \"OR\": {\n                        \"left\": {\n                          \"raw_text\": \"known inherited thrombophilia\"\n                        },\n                        \"right\": {\n                          \"raw_text\": \"or family history of thrombosis in a first degree relative\"\n                        }\n                      }\n                    }\n                  }\n                }\n              }\n            }\n          }\n        },\n        \"right\": {\n          \"AND\": {\n            \"left\": {\n              \"raw_text\": \"Subject has a severe medical or psychiatric illness that, in the opinion of the Investigator, would affect subject safety or compliance\"\n            },\n            \"right\": {\n              \"AND\": {\n                \"left\": {\n                  \"NOT\": {\n                    \"left\": {\n                      \"OR\": {\n                        \"left\": {\n                          \"raw_text\": \"Clinical evidence of severe bleeding disorder\"\n                        },\n                        \"right\": {\n                          \"NOT\": {\n                            \"left\": {\n                              \"OR\": {\n                                \"left\": {\n                                  \"raw_text\": \"Patients with mild bleeding disorders such as type 1 von Willebrand disease\"\n                                },\n                                \"right\": {\n                                  \"OR\": {\n                                    \"left\": {\n                                      \"raw_text\": \"mild platelet function defects such as platelet storage pool or release defects\"\n                                    },\n                                    \"right\": {\n                                      \"raw_text\": \"and patients with bleeding due to Ehlers Danlos syndrome\"\n                                    }\n                                  }\n                                }\n                              }\n                            }\n                          }\n                        }\n                      }\n                    }\n                  }\n                },\n                \"right\": {\n                  \"AND\": {\n                    \"left\": {\n                      \"raw_text\": \"Pregnancy within the past 6 months and/or breast-feeding\"\n                    },\n                    \"right\": {\n                      \"AND\": {\n                        \"left\": {\n                          \"raw_text\": \"Use of hormonal contraception (estrogen and progestin) within 3 months of study entry, or anticipated need to initiate estrogen-containing hormonal contraception during the study period\"\n                        },\n                        \"right\": {\n                          \"AND\": {\n                            \"left\": {\n                              \"raw_text\": \"Use of systemic steroids within 1 month of study entry\"\n                            },\n                            \"right\": {\n                              \"AND\": {\n                                \"left\": {\n                                  \"raw_text\": \"History of subarachnoid hemorrhage\"\n                                },\n                                \"right\": {\n                                  \"AND\": {\n                                    \"left\": {\n                                      \"raw_text\": \"History of Hepatitis B, C, or HIV\"\n                                    },\n                                    \"right\": {\n                                      \"AND\": {\n                                        \"left\": {\n                                          \"raw_text\": \"Baseline creatinine >20% above the upper limit of normal for age\"\n                                        },\n                                        \"right\": {\n                                          \"AND\": {\n                                            \"left\": {\n                                              \"raw_text\": \"Severe anemia (hemoglobin <8 g/dL)\"\n                                            },\n                                            \"right\": {\n                                              \"AND\": {\n                                                \"left\": {\n                                                  \"raw_text\": \"Systolic blood pressure <85 or diastolic blood pressure <55\"\n                                                },\n                                                \"right\": {\n                                                  \"AND\": {\n                                                    \"left\": {\n                                                      \"raw_text\": \"Heart rate <50 at time of screening\"\n                                                    },\n                                                    \"right\": {\n                                                      \"NOT\": {\n                                                        \"left\": {\n                                                          \"raw_text\": \"Use of intranasal DDAVP during menses will be permitted, but only if the patient has a history of using DDAVP consistently for ≥3 menstrual cycles prior to study enrollment, so that change in menstrual blood loss due to addition of Lysteda can be assessed. Use of one-time DDAVP during a DDAVP/Stimate challenge is also permitted during the study period, as is use of DDAVP in the event of severe epistaxis, trauma, or surgical procedures during the study period.\"\n                                                        }\n                                                      }\n                                                    }\n                                                  }\n                                                }\n                                              }\n                                            }\n                                          }\n                                        }\n                                      }\n                                    }\n                                  }\n                                }\n                              }\n                            }\n                          }\n                        }\n                      }\n                    }\n                  }\n                }\n              }\n            }\n          }\n        }\n      }\n    }\n  }\n}"