"{\n  \"AND\": {\n    \"left\": {\n      \"raw_text\": \"Treatment with any investigational drug within 30 days of entry to this protocol\"\n    },\n    \"right\": {\n      \"AND\": {\n        \"left\": {\n          \"raw_text\": \"Current treatment with Telbivudine\"\n        },\n        \"right\": {\n          \"AND\": {\n            \"left\": {\n              \"raw_text\": \"Severe hepatitis activity as documented by ALT>10 x ULN\"\n            },\n            \"right\": {\n              \"AND\": {\n                \"left\": {\n                  \"raw_text\": \"History of decompensated cirrhosis (defined as jaundice in the presence of cirrhosis, ascites, bleeding gastric or esophageal varices or encephalopathy)\"\n                },\n                \"right\": {\n                  \"AND\": {\n                    \"left\": {\n                      \"OR\": {\n                        \"left\": {\n                          \"raw_text\": \"Pre-existent neutropenia (neutrophils <1,500/mm3)\"\n                        },\n                        \"right\": {\n                          \"raw_text\": \"or thrombocytopenia (platelets < 90,000/mm3)\"\n                        }\n                      }\n                    },\n                    \"right\": {\n                      \"AND\": {\n                        \"left\": {\n                          \"raw_text\": \"Co-infection with hepatitis C virus, hepatitis D virus or human immunodeficiency virus (HIV)\"\n                        },\n                        \"right\": {\n                          \"AND\": {\n                            \"left\": {\n                              \"raw_text\": \"Other acquired or inherited causes of liver disease: alcoholic liver disease, obesity induced liver disease, drug related liver disease, auto-immune hepatitis, hemochromatosis, Wilson's disease or alpha-1 antitrypsin deficiency\"\n                            },\n                            \"right\": {\n                              \"AND\": {\n                                \"left\": {\n                                  \"raw_text\": \"Alpha fetoprotein > 50 ng/ml\"\n                                },\n                                \"right\": {\n                                  \"AND\": {\n                                    \"left\": {\n                                      \"OR\": {\n                                        \"left\": {\n                                          \"raw_text\": \"Hyper-\"\n                                        },\n                                        \"right\": {\n                                          \"raw_text\": \"or hypothyroidism\"\n                                        }\n                                      }\n                                    },\n                                    \"right\": {\n                                      \"AND\": {\n                                        \"left\": {\n                                          \"raw_text\": \"Immune suppressive treatment within the previous 6 months\"\n                                        },\n                                        \"right\": {\n                                          \"AND\": {\n                                            \"left\": {\n                                              \"raw_text\": \"Contra-indications for alfa-interferon therapy like suspected hypersensitivity to interferon or Peginterferon or any known pre-existing medical condition that could interfere with the patient's participation in and completion of the study.\"\n                                            },\n                                            \"right\": {\n                                              \"AND\": {\n                                                \"left\": {\n                                                  \"OR\": {\n                                                    \"left\": {\n                                                      \"raw_text\": \"Pregnancy\"\n                                                    },\n                                                    \"right\": {\n                                                      \"raw_text\": \"breast-feeding\"\n                                                    }\n                                                  }\n                                                },\n                                                \"right\": {\n                                                  \"AND\": {\n                                                    \"left\": {\n                                                      \"raw_text\": \"Other significant medical illness that might interfere with this study: significant pulmonary dysfunction in the previous 6 months, malignancy other than skin basocellular carcinoma in previous 5 years, immunodeficiency syndromes (e.g. HIV positivity, auto-immune diseases, organ transplants other than cornea and hair transplant)\"\n                                                    },\n                                                    \"right\": {\n                                                      \"AND\": {\n                                                        \"left\": {\n                                                          \"raw_text\": \"Any medical condition requiring, or likely to require chronic systemic administration of steroids, during the course of the study\"\n                                                        },\n                                                        \"right\": {\n                                                          \"AND\": {\n                                                            \"left\": {\n                                                              \"raw_text\": \"Substance abuse, such as alcohol (>80 g/day), I.V. drugs and inhaled drugs in the past 2 years.\"\n                                                            },\n                                                            \"right\": {\n                                                              \"raw_text\": \"Any other condition which in the opinion of the investigator would make the patient unsuitable for enrollment, or could interfere with the patient participating in and completing the study\"\n                                                            }\n                                                          }\n                                                        }\n                                                      }\n                                                    }\n                                                  }\n                                                }\n                                              }\n                                            }\n                                          }\n                                        }\n                                      }\n                                    }\n                                  }\n                                }\n                              }\n                            }\n                          }\n                        }\n                      }\n                    }\n                  }\n                }\n              }\n            }\n          }\n        }\n      }\n    }\n  }\n}"