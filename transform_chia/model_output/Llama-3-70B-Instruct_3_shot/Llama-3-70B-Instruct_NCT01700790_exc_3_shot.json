"{\n  \"AND\": {\n    \"left\": {\n      \"raw_text\": \"Non-compliance with DOTPlus. Alternatively DOT can be done by telephoning patient on a daily basis 5 times a week and having patient annotate taking drug in a log which would be reviewed by clinic staff\"\n    },\n    \"right\": {\n      \"AND\": {\n        \"left\": {\n          \"raw_text\": \"History of being treated for tuberculosis in the prior 2 years\"\n        },\n        \"right\": {\n          \"NOT\": {\n            \"left\": {\n              \"raw_text\": \"unless there is DST, including PCR testing, showing sensitivity to rifamycin.\"\n            }\n          }\n        }\n      }\n    }\n  },\n  \"right\": {\n    \"AND\": {\n      \"left\": {\n        \"raw_text\": \"Known hypersensitivity to rifampin or rifabutin.\"\n      },\n      \"right\": {\n        \"AND\": {\n          \"left\": {\n            \"raw_text\": \"Liver enzymes greater than 2 times ULN.\"\n          },\n          \"right\": {\n            \"AND\": {\n              \"left\": {\n                \"raw_text\": \"Bilirubin greater than 2 times ULN.\"\n              },\n              \"right\": {\n                \"AND\": {\n                  \"left\": {\n                    \"raw_text\": \"Serum creatinine greater than 3 times ULN.\"\n                  },\n                  \"right\": {\n                    \"AND\": {\n                      \"left\": {\n                        \"raw_text\": \"Hemoglobin less than 7.0 gms even if receiving erythropoietin.\"\n                      },\n                      \"right\": {\n                        \"AND\": {\n                          \"left\": {\n                            \"raw_text\": \"Absolute neutrophil count less than 750 cells/mm3 even if receiving G-CSF.\"\n                          },\n                          \"right\": {\n                            \"AND\": {\n                              \"left\": {\n                                \"raw_text\": \"Fasting triglycerides greater than 400 mg/dL.\"\n                              },\n                              \"right\": {\n                                \"AND\": {\n                                  \"left\": {\n                                    \"raw_text\": \"Fasting cholesterol > 1.6 upper limits of normal.\"\n                                  },\n                                  \"right\": {\n                                    \"AND\": {\n                                      \"left\": {\n                                        \"raw_text\": \"GI intolerance of tuberculosis medications requiring discontinuation of tuberculosis medications.\"\n                                      },\n                                      \"right\": {\n                                        \"AND\": {\n                                          \"left\": {\n                                            \"raw_text\": \"Fasting glucose greater 150 mg/dL.\"\n                                          },\n                                          \"right\": {\n                                            \"AND\": {\n                                              \"left\": {\n                                                \"raw_text\": \"Pregnant women.\"\n                                              },\n                                              \"right\": {\n                                                \"AND\": {\n                                                  \"left\": {\n                                                    \"raw_text\": \"Use of one of the prohibited medications\"\n                                                  },\n                                                  \"right\": {\n                                                    \"AND\": {\n                                                      \"left\": {\n                                                        \"raw_text\": \"Any condition that the investigators feel could compromise the use of the current medication