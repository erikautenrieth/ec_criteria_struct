"{\n  \"AND\": {\n    \"left\": {\n      \"AND\": {\n        \"left\": {\n          \"raw_text\": \"History of other significant skin disease\"\n        },\n        \"right\": {\n          \"OR\": {\n            \"left\": {\n              \"raw_text\": \"or skin manifestations of allergic illness\"\n            },\n            \"right\": {\n              \"OR\": {\n                \"left\": {\n                  \"raw_text\": \"or other dermatologic condition\"\n                },\n                \"right\": {\n                  \"NOT\": {\n                    \"left\": {\n                      \"raw_text\": \"except chronic moderate or severe atopic dermatitis\"\n                    }\n                  }\n                }\n              }\n            }\n          }\n        }\n      }\n    },\n    \"right\": {\n      \"AND\": {\n        \"left\": {\n          \"raw_text\": \"that would interfere with the trial assessments or compromise the patient's safety according to the opinion of the Investigator\"\n        },\n        \"right\": {\n          \"AND\": {\n            \"left\": {\n              \"raw_text\": \"Present symptoms of other skin diseases\"\n            },\n            \"right\": {\n              \"NOT\": {\n                \"left\": {\n                  \"raw_text\": \"except chronic atopic dermatitis\"\n                }\n              }\n            }\n          }\n        }\n      }\n    }\n  },\n  \"right\": {\n    \"AND\": {\n      \"left\": {\n        \"raw_text\": \"that could disturb the study assessment and evaluation of the skin\"\n      },\n      \"right\": {\n        \"AND\": {\n          \"left\": {\n            \"raw_text\": \"Current use of any active systemic medication for chronic atopic dermatitis within one month\"\n          },\n          \"right\": {\n            \"AND\": {\n              \"left\": {\n                \"raw_text\": \"Current use of active topical medication in the planned investigational area for chronic atopic dermatitis within two weeks\"\n              },\n              \"right\": {\n                \"AND\": {\n                  \"left\": {\n                    \"raw_text\": \"History of a sunny holiday, UV-light therapy or solarium use within one month before beginning of study treatments, or planning such during the study or within 7 days after the study\"\n                  },\n                  \"right\": {\n                    \"AND\": {\n                      \"left\": {\n                        \"raw_text\": \"Allergy to cis-UCA, or any constituents of the placebo emulsion cream or any constituents of Protopic ointment\"\n                      },\n                      \"right\": {\n                        \"AND\": {\n                          \"left\": {\n                            \"raw_text\": \"History of any skin-related cancer\"\n                          },\n                          \"right\": {\n                            \"AND\": {\n                              \"left\": {\n                                \"raw_text\": \"Congenital or acquired immunodeficiency or ongoing therapy that cause immunosuppression\"\n                              },\n                              \"right\": {\n                                \"AND\": {\n                                  \"left\": {\n                                    \"raw_text\": \"Earlier participation in a clinical study performed with cis-UCA\"\n                                  },\n                                  \"right\": {\n                                    \"AND\": {\n                                      \"left\": {\n                                        \"raw_text\": \"Any clinically significant laboratory test result\"\n                                      },\n                                      \"right\": {\n                                        \"AND\": {\n                                          \"left\": {\n                                            \"raw_text\": \"Suspected current drug or alcohol abuse\"\n                                          },\n                                          \"right\": {\n                                            \"AND\": {\n                                              \"left\": {\n                                                \"raw_text\": \"Clinically significant illness during the 4 weeks prior to the first dose administration\"\n                                              },\n                                              \"right\": {\n                                                \"AND\": {\n                                                  \"left\": {\n                                                    \"raw_text\": \"Any other condition that in the opinion of the Investigator would interfere with the evaluation of the study results or constitute a health hazard for the patient\"\n                                                  },\n                                                  \"right\": {\n                                                    \"AND\": {\n                                                      \"left\": {\n                                                        \"raw_text\": \"Unwillingness or doubtful capacity to comply with the protocol\"\n                                                      },\n                                                      \"right\": {\n                                                        \"raw_text\": \"Doubtful availability to complete the study\"\n                                                      }\n                                                    }\n                                                  }\n                                                }\n                                              }\n                                            }\n                                          }\n                                        }\n                                      }\n                                    }\n                  