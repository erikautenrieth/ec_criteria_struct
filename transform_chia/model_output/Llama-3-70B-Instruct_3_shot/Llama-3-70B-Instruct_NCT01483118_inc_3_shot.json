"{\n  \"AND\": {\n    \"left\": {\n      \"raw_text\": \"Patients aged greater than 18 years of age\"\n    },\n    \"right\": {\n      \"AND\": {\n        \"left\": {\n          \"raw_text\": \"Ability to understand and willingness to comply with the study protocol\"\n        },\n        \"right\": {\n          \"AND\": {\n            \"left\": {\n              \"raw_text\": \"Written informed consent\"\n            },\n            \"right\": {\n              \"AND\": {\n                \"left\": {\n                  \"raw_text\": \"Patients meeting the Rotterdam PCOS workshop criteria for polycystic ovary syndrome\"\n                },\n                \"right\": {\n                  \"AND\": {\n                    \"left\": {\n                      \"OR\": {\n                        \"left\": {\n                          \"raw_text\": \"oligomenorrhea\"\n                        },\n                        \"right\": {\n                          \"raw_text\": \"or amenorrhea\"\n                        }\n                      }\n                    },\n                    \"right\": {\n                      \"AND\": {\n                        \"left\": {\n                          \"OR\": {\n                            \"left\": {\n                              \"raw_text\": \"clinical or biochemical evidence of hyperandrogenism\"\n                            },\n                            \"right\": {\n                              \"raw_text\": \"or ultrasound finding of polycystic appearing ovaries\"\n                            }\n                          }\n                        }\n                      }\n                    }\n                  }\n                }\n              }\n            }\n          }\n        }\n      }\n    }\n  }\n}"