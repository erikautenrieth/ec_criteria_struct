"{\n  \"AND\": {\n    \"left\": {\n      \"AND\": {\n        \"left\": {\n          \"raw_text\": \"Unresectable, histologically confirmed hepatocellular carcinoma\"\n        },\n        \"right\": {\n          \"raw_text\": \"with evident disease limited to liver.\"\n        }\n      }\n    },\n    \"right\": {\n      \"AND\": {\n        \"left\": {\n          \"raw_text\": \"Tissue from tumor must be available.\"\n        },\n        \"right\": {\n          \"OR\": {\n            \"left\": {\n              \"raw_text\": \"This may be paraffin embedded tissue from previous biopsy/resection\"\n            },\n            \"right\": {\n              \"raw_text\": \"or if it is not available, a repeat biopsy must be performed.\"\n            }\n          }\n        }\n      }\n    },\n    \"right\": {\n      \"AND\": {\n        \"left\": {\n          \"NOT\": {\n            \"left\": {\n              \"raw_text\": \"The requirement for biopsy may be waived if alpha-fetoprotein is greater than 500 ng/mL and in the investigators opinion not explained by a concurrent hepatic inflammatory process.\"\n            }\n          }\n        },\n        \"right\": {\n          \"AND\": {\n            \"left\": {\n              \"raw_text\": \"Patients must agree to have a 20 cc blood sample drawn in addition to routine labs with each cycle of chemotherapy.\"\n            },\n            \"right\": {\n              \"AND\": {\n                \"left\": {\n                  \"raw_text\": \"Patients must have measurable disease.\"\n                },\n                \"right\": {\n                  \"raw_text\": \"If prior radiation therapy was administered, measurable disease must be outside the radiation field.\"\n                }\n              }\n            }\n          }\n        }\n      }\n    },\n    \"right\": {\n      \"AND\": {\n        \"left\": {\n          \"raw_text\": \"Patients must have a Zubrod performance status of 0-2.\"\n        },\n        \"right\": {\n          \"AND\": {\n            \"left\": {\n              \"raw_text\": \"Patients must have a predicted life expectancy of at least 12 weeks.\"\n            },\n            \"right\": {\n              \"AND\": {\n                \"left\": {\n                  \"raw_text\": \"Patients must have a pre-treatment granulocyte count (i.e., segmented neutrophils + bands) of greater than or equal to 1,500/mm3\"\n                },\n                \"right\": {\n                  \"AND\": {\n                    \"left\": {\n                      \"raw_text\": \"a hemoglobin level of greater than or equal to 9 gm/dl\"\n                    },\n                    \"right\": {\n                      \"AND\": {\n                        \"left\": {\n                          \"raw_text\": \"and platelet count greater than or equal to 50,000/mm3\"\n                        },\n                        \"right\": {\n                          \"NOT\": {\n                            \"left\": {\n                              \"raw_text\": \"The granulocyte requirement may be waived if in the investigator's opinion the lower count reflects hypersplenism with adequate bone marrow reserves.\"\n                            }\n                          }\n                        }\n                      }\n                    }\n                  }\n                }\n              }\n            }\n          }\n        }\n      }\n    },\n    \"right\": {\n      \"AND\": {\n        \"left\": {\n          \"raw_text\": \"Patients must have adequate renal function as documented by a calculated creatinine clearance ≥ 60.\"\n        },\n        \"right\": {\n          \"AND\": {\n            \"left\": {\n              \"raw_text\": \"Patients must have adequate hepatic function as documented by a serum bilirubin less than or equal to 2x the institutional upper limit of normal\"\n            },\n            \"right\": {\n              \"raw_text\": \"regardless of whether patients have liver involvement secondary to tumor. Patients may not have ascites or the ascites must be responsive to diuretics.\"\n            }\n          }\n        }\n      }\n    }\n  }\n}"