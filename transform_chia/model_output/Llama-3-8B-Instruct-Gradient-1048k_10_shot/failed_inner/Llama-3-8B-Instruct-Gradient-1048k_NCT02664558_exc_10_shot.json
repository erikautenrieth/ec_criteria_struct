{
  "AND": {
    "left": {
      "AND": {
        "left": {
          "raw_text": "Exclusions Related to Cardiovascular Disease"
        },
        "right": {
          "AND": {
            "left": {
              "OR": {
                "left": {
                  "raw_text": "1. History of uncontrolled hypertension"
                },
                "right": {
                  "OR": {
                    "left": {
                      "raw_text": "2. Persistent hypotension at Screening."
                    },
                    "right": {
                      "OR": {
                        "left": {
                          "raw_text": "3. Evidence or history of left-sided heart disease and/or clinically significant cardiac disease in which pulmonary hypertension is more likely WHO Group 2."
                        },
                        "right": {
                          "OR": {
                            "left": {
                              "raw_text": "4. Acute decompensated heart failure within 1 month of Screening."
                            },
                            "right": {
                              "OR": {
                                "left": {
                                  "raw_text": "5. Recent initiation (<8 weeks from Screening) or planned initiation of cardiopulmonary rehabilitation exercise program."
                                }
                              }
                            }
                          }
                        }
                      }
                    }
                }
              }
            }
          }
        },
        "right": {
          "AND": {
            "left": {
              "OR": {
                "left": {
                  "raw_text": "Exclusions Related to Pulmonary Disease"
                },
                "right": {
                  "AND": {
                    "left": {
                      "OR": {
                        "left": {
                          "raw_text": "6. Newly diagnosed with PAH and not on PAH-specific therapy."
                        },
                        "right": {
                          "OR": {
                            "left": {
                              "raw_text": "7. Pulmonary hypertension due to:"
                            },
                            "right": {
                              "OR": {
                                "left": {
                                  "raw_text": "1. Uncorrected congenital systemic-to-pulmonary shunt."
                                },
                                "right": {
                                  "OR": {
                                    "raw_text": "2. Pulmonary veno-occlusive disease and/or pulmonary capillary hemangiomatosis"
                                    },
                                    "right": {
                                      "OR": {
                                        "raw_text": "3. Persistent pulmonary hypertension of the newborn"
                                        },
                                        "right": {
                                          "OR": {
                                            "raw_text": "4. WHO clinical classification Groups 2-5"
                                            },
                                            "right": {
                                              "OR": {
                                                "raw_text": "8. Evidence of significant airway and/or parenchymal lung disease."
                                                }
                                              }
                                            }
                                          }
                                        }
                                      }
                                    }
                                  }
                                }
                              }
                            }
                          }
                        }
                      }
                    }
                }
              }
            }
          }
        },
        "right": {
          "AND": {
            "left": {
              "OR": {
                "left": {
                  "raw_text": "Exclusions Based on Other Medical Conditions"
                },
                "right": {
                  "AND": {
                    "left": {
                      "OR": {
                        "left": {
                          "raw_text": "10. Chronic infections including, but not limited to tuberculosis (TB), hepatitis B virus (HBV) or hepatitis C virus (HCV)."
                        },
                        "right": {
                          "OR": {
                            "left": {
                              "raw_text": "11. History of portal hypertension or chronic liver disease, including positive serology for infection with HCV and/or HBV."
                            },
                            "right": {
                              "OR": {
                                "left": {
                                  "raw_text": "12. Evidence of active infection requiring intravenous or oral antibiotics within 4 weeks of Screening."
                                }
                              }
                            }
                          }
                        }
                      }
                    }
                }
              }
            }
          }
        },
        "right": {
          "AND": {
            "left": {
              "OR": {
                "left": {
                  "rawtext": "13. Body mass index ≥35.0 at Screening."
                },
                "right": {
                  "OR": {
                    "rawtext": "14. History of obstructive sleep apnea."
                }
              }
            }
          }
        },
        "right": {
          "AND": {
            "left": {
              "OR": {
                "left": {
                  "rawtext": "15. History of malignancy within the last 5 years, except nonmelanoma skin cancer and cervical carcinoma in situ treated with curative intent."
                },
                "right": {
                  "OR": {
                    "rawtext": "16. Neuropsychiatric disorders/symptoms or psychological conditions."
                }
              }
            }
          }
        },
        "right": {
          "AND": {
            "left": {
              "OR": {
                "left": {
                  "rawtext": "17. Pregnancy or breast-feeding."
                },
                "right": {
                  "OR": {
                    "rawtext": "18. Prior treatment with B cell or lymphocyte-depleting agents (eg, rituximab, Campath)."
                }
              }
            }
          }
        },
        "right": {
          "AND": {
            "left": {
              "OR": {
                "left": {
                  "rawtext": "19. Concurrent regular use of another leukotriene pathway inhibitor, including over-the-counter medications or herbal remedies."
                },
                "right": {
                  "OR": {
                    "rawtext": "20. Significant/chronic renal insufficiency."
                }
              }
            }
          }
        },
        "right": {
          "AND": {
            "left": {
              "OR": {
                "left": {
                  "rawtext": "21. Transaminases (alanine transaminase, aspartate transaminase) levels >3 × upper limit of normal (ULN) and/or bilirubin level >2 × ULN."
                },
                "right": {
                  "OR": {
                    "rawtext": "22. Absolute neutrophil count <1500 mm3."
                }
              }
            }
          }
        },
        "right": {
          "AND": {
            "left": {
              "OR": {
                "left": {
                  "rawtext": "23. Hemoglobin concentration <9 g/dL at Screening."
                },
                "right": {
                  "OR": {
                    "rawtext": "24. Hepatic dysfunction as defined by Child-Pugh Class B or C."
                }
              }
            }
          }
        }
  }
}