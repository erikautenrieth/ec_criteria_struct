"{\n  \"AND\": {\n    \"left\": {\n      \"OR\": {\n        \"left\": {\n          \"raw_text\": \"Male or female patients 2 to 16 years of age\"\n        },\n        \"right\": {\n          \"OR\": {\n            \"left\": {\n              \"raw_text\": \"Patients who require at least 80% of their caloric intake as PN at study start, and in whom an indication for PN is expected for at least 5 days\"\n            },\n            \"right\": {\n              \"OR\": {\n                \"raw_text\": \"Patients who require a central venous line to receive PN or already have a central venous line in place for other reasons\"\n                },\n                \"right\": {\n                  \"OR\": {\n                    \"left\": {\n                      \"raw_text\": \"Written informed consent from legal representative(s)\"\n                    }\n                  }\n                }\n              }\n            }\n          }\n        }\n      }\n  }\n}"