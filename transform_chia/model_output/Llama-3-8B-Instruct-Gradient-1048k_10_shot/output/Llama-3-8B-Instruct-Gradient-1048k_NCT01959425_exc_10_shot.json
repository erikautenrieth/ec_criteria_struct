"{\n  \"AND\": {\n    \"left\": {\n      \"OR\": {\n        \"left\": {\n          \"raw_text\": \"OAT required for reasons not related to AF (i.e., prosthetic valve, PV stenosis, previous pulmonary embolism, presence of spontaneous echo contrast [SEC] at standard echo performed at 3-months follow-up).\"\n        },\n        \"right\": {\n          \"AND\": {\n            \"left\": {\n              \"OR\": {\n                \"left\": {\n                  \"raw_text\": \"Any cardiac surgery within the past 60 days (2 months) or valvular cardiac surgical procedure at any time (i.e., ventriculotomy, atriotomy, and valve repair or replacement and presence of a prosthetic valve)\"\n                },\n                \"right\": {\n                  \"OR\": {\n                    \"left\": {\n                      \"raw_text\": \"Previous myocardial infarction (MI) or a percutaneous coronary intervention PCI within the past 3 months\"\n                    },\n                    \"right\": {\n                      \"OR\": {\n                        \"raw_text\": \"Awaiting cardiac transplantation or other cardiac surgery within the next 365 days (12 months)\"\n                        },\n                        \"right\": {\n                          \"OR\": {\n                            \"left\": {\n                              \"raw_text\": \"Documented left atrial thrombus\"\n                            },\n                            \"right\": {\n                              \"OR\": {\n                                \"left\": {\n                                  \"raw_text\": \"Significant pulmonary disease, (e.g., restrictive pulmonary disease, constrictive or COPD) or any other disease or malfunction of the lungs or respiratory system that produces chronic symptoms\"\n                                },\n                                \"right\": {\n                                  \"OR\": {\n                                    \"raw_text\": \"Significant medical problem that in the opinion of the investigator would preclude enrollment in this study\"\n                                    },\n                                    \"right\": {\n                                      \"OR\": {\n                                        \"raw_text\": \"Women who are pregnant (as evidenced by pregnancy test if pre-menopausal)\"\n                                        },\n                                        \"right\": {\n                                          \"OR\": {\n                                            \"raw_text\": \"Acute illness or active systemic infection or sepsis\"\n                                            },\n                                            \"right\": {\n                                              \"OR\": {\n                                                \"raw_text\": \"Unstable angina\"\n                                                },\n                                                \"right\": {\n                                                  \"OR\": {\n                                                    \"raw_text\": \"Contraindication to anticoagulation (i.e., heparin, warfarin or another commercially available anticoagulation medication)\"\n                                                    },\n                                                    \"right\": {\n                                                      \"OR\": {\n                                                        \"raw_text\": \"History of blood clotting or bleeding abnormalities\"\n                                                        },\n                                                        \"right\": {\n                                                          \"OR\": {\n                                                            \"raw_text\": \"Life expectancy less than 360 days (12 months)\"\n                                                            },\n                                                            \"right\": {\n                                                              \"OR\": {\n                                                                \"raw_text\": \"Uncontrolled Heart Failure or NYHA Class III or IV heart failure\"\n                                                                },\n                                                                \"right\": {\n                                                                  \"OR\": {\n                                                                    \"raw_text\": \"Enrollment in a clinical study evaluating another device or drug, within the past 6 months\"\n                                                                    },\n                                                                    \"right\": {\n                                                                      \"OR\": {\n                                                                        \"raw_text\": \"Unable or unwilling to comply with protocol requirements\"\n                                                                        }\n                                                                  }\n                                                              }\n                                                            }\n                                                          }\n                                                        }\n                                                      }\n                                                    }\n                                                  }\n                                                }\n                                              }\n                                            }\n                                          }\n                                        }\n                                      }\n                                    }\n                                  }\n                                }\n          }\n        }\n 