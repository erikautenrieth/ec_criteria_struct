"{\n  \"AND\": {\n    \"left\": {\n      \"AND\": {\n        \"left\": {\n          \"raw_text\": \"Physically healthy adults age 18-55 who meet DSM-5 criteria for insomnia\"\n        },\n        \"right\": {\n          \"AND\": {\n            \"left\": {\n              \"raw_text\": \"and Criterion A (exposure to a traumatic event) for PTSD.\"\n            },\n            \"right\": {\n              \"AND\": {\n                \"left\": {\n                  \"raw_text\": \"The index trauma must have occurred within the past 5 years and at least 3 months before enrolling,\"\n                },\n                \"right\": {\n                  \"AND\": {\n                    \"left\": {\n                      \"raw_text\": \"and insomnia symptoms must have started or worsened after the exposure to the index trauma.\"\n                    }\n                  }\n                }\n              }\n            }\n          }\n        }\n    }\n  }\n}"