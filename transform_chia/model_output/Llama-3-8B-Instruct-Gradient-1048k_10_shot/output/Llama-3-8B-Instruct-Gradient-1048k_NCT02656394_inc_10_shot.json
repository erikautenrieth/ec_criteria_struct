"{\n  \"AND\": {\n    \"left\": {\n      \"OR\": {\n        \"left\": {\n          \"raw_text\": \"1. Male or female of any race, at least 18 years of age at Visit 1 Screening.\"\n        },\n        \"right\": {\n          \"OR\": {\n            \"left\": {\n              \"raw_text\": \"2. Has provided verbal and written informed consent.\"\n            },\n            \"right\": {\n              \"OR\": {\n                \"left\": {\n                  \"raw_text\": \"3. Be able and willing to follow instructions, including participation in all study assessments and visits.\"\n                },\n                \"right\": {\n                  \"OR\": {\n                    \"left\": {\n                      \"raw_text\": \"4. Currently being treated for glaucoma using at least two medications, and be willing to continue on the same regime.\"\n                    },\n                    \"right\": {\n                      \"OR\": {\n                        \"left\": {\n                          \"raw_text\": \"5. Suffers from at least two of the symptoms in the GLIA™ Glaucoma Medication Ocular Side Effect Symptoms Questionnaire at a severity of 2 (moderate) or more.\"\n                        },\n                        \"right\": {\n                          \"OR\": {\n                            \"left\": {\n                              \"raw_text\": \"6. If a woman of childbearing potential, have a negative urine pregnancy test at Visit 1 and be using an adequate method of birth control throughout the study period.\"\n                            }\n                          }\n                        }\n                      }\n                    }\n                  }\n                }\n              }\n            }\n          }\n    }\n  }\n}"