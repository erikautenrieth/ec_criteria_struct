"{\n  \"AND\": {\n    \"left\": {\n      \"OR\": {\n        \"left\": {\n          \"raw_text\": \"Male or female =18 years of age at Visit 1\"\n        },\n        \"right\": {\n          \"OR\": {\n            \"raw_text\": \"Documentation of a CF diagnosis\"\n            }\n          }\n        }\n      },\n    \"right\": {\n      \"AND\": {\n        \"left\": {\n          \"OR\": {\n            \"left\": {\n              \"raw_text\": \"Enrolled in the Cystic Fibrosis Foundation National Patient Registry (CFFNPR) prior to Visit 1 (US sites only)\"\n            },\n            \"right\": {\n              \"OR\": {\n                \"raw_text\": \"At the time of Visit 1, there is a plan to initiate IV antibiotics for a pulmonary exacerbation\"\n                }\n          }\n        }\n      },\n    \"right\": {\n      \"AND\": {\n        \"left\": {\n          \"OR\": {\n            \"left\": {\n              \"raw_text\": \"Performed spirometry at Visit 1 and Visit 2 and willing to perform spirometry at Visit 3\"\n            },\n            \"right\": {\n              \"OR\": {\n                \"raw_text\": \"Completed the CRISS questionnaire at Visit 1 and Visit 2 and willing to complete the Cystic Fibrosis Respiratory Symptoms Diary (CFRSD) questionnaire at Visit 3\"\n                }\n          }\n        }\n      },\n    \"right\": {\n      \"AND\": {\n        \"left\": {\n          \"OR\": {\n            \"left\": {\n              \"raw_text\": \"Willing to adhere to a specific treatment duration determined by initial response to treatment and subsequent randomization\"\n            },\n            \"right\": {\n              \"OR\": {\n                \"raw_text\": \"Willing to return for follow up Visit 3\"\n                }\n          }\n        }\n      },\n    \"right\": {\n      \"AND\": {\n        \"left\": {\n          \"OR\": {\n            \"left\": {\n              \"raw_text\": \"Written informed consent obtained from the subject or subject's legal representative\"\n            }\n          }\n        }\n      }\n    }\n  }\n}"