"{\n  \"AND\": {\n    \"left\": {\n      \"AND\": {\n        \"left\": {\n          \"raw_text\": \"Approved clinical indication for pectoral pacemaker exchange (e.g. elective replacement indication (ERI), end of service (EOS))\"},\n        \"right\": {\n          \"OR\": {\n            \"left\": {\n              \"raw_text\": \"a single or dual chamber MRI conditional pacemaker (BSCI) or\"},\n            \"right\": {\n              \"OR\": {\n                \"raw_text\": \"Any comparable successor IPG (MRI conditional system, BSCI) compatible with\"},\n            \"right\": {\n              \"AND\": {\n                \"left\": {\n                  \"raw_text\": \"Implanted Fineline-II-leads (BSCI), MRI conditional\"},\n                \"right\": {\n                  \"AND\": {\n                    \"left\": {\n                      \"raw_text\": \"The ascertained lead impedance is between 200 and 1500 Ohm.\"\n                    }\n                  }\n                }\n              }\n            }\n          }\n        },\n        \"right\": {\n          \"AND\": {\n            \"left\": {\n              \"OR\": {\n                \"left\": {\n                  \"raw_text\": \"All pacing capture thresholds (PCT) do not exceed 2.0 V @0.4 or 0.5 ms in pacemaker dependent patients\"},\n                \"right\": {\n                  \"OR\": {\n                    \"left\": {\n                      \"raw_text\": \"Male or female 18 years or older\"},\n                    \"right\": {\n                      \"OR\": {\n                        \"raw_text\": \"Understand the nature of the procedure\"},\n                        \"right\": {\n                          \"OR\": {\n                            \"raw_text\": \"Give written informed consent\"},\n                            \"right\": {\n                              \"OR\": {\n                                \"raw_text\": \"Able to complete all testing required by the clinical protocol\"},\n                