"{\n  \"AND\": {\n    \"left\": {\n      \"OR\": {\n        \"left\": {\n          \"raw_text\": \"1. Taking a tetracycline within 6 months or history of adverse reaction to minocycline or another tetracycline.\"\n        },\n        \"right\": {\n          \"OR\": {\n            \"left\": {\n              \"raw_text\": \"2. Enhanced risk from lumbar puncture, including documented or suspected cerebral mass lesion predisposing to brain herniation or bleeding diathesis.\"\n            },\n            \"right\": {\n              \"OR\": {\n                \"left\": {\n                  \"raw_text\": \"3. Pregnancy or expectation of pregnancy during the study.\"\n                },\n                \"right\": {\n                  \"OR\": {\n                    \"left\": {\n                      \"raw_text\": \"4. Active opportunistic infection or active neurological disease that might confound evaluation.\"\n                    },\n                    \"right\": {\n                      \"OR\": {\n                        \"left\": {\n                          \"raw_text\": \"5. ADC Stage > 1.\"\n                        },\n                        \"right\": {\n                          \"OR\": {\n                            \"left\": {\n                              \"raw_text\": \"6. Hemoglobin < 10 Gms/dL.\"\n                            },\n                            \"right\": {\n                              \"OR\": {\n                                \"left\": {\n                                  \"raw_text\": \"7. BUN or creatine above the normal limits.\"\n                                },\n                                \"right\": {\n                                  \"OR\": {\n                                    \"left\": {\n                                      \"raw_text\": \"8. Taking other drugs known to reduce the metabolism of minocycline and thus increase the probability of toxicity.\"\n                                    }\n                                  }\n                                }\n                              }\n                            }\n                          }\n                        }\n                      }\n                    }\n                  }\n                }\n              }\n            }\n          }\n        }\n      }\n  }\n}"