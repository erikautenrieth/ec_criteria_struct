"{\n  \"AND\": {\n    \"left\": {\n      \"AND\": {\n        \"left\": {\n          \"raw_text\": \"Patients with chronic heart failure of New York Heart Association Class II or III, a left ventricular ejection fraction of = 40% for patients in NYHA class II or = 45% for patients in NYHA class III, a hemoglobin level at the screening visit between 9.5-13.5 g/dl, and iron deficiency, which is defined as serum ferritin level < 100µg/l or between 100 and 299 µg/l, when transferring saturation is < 20%.\",\n        \"right\": {\n          \"AND\": {\n            \"left\": {\n              \"raw_text\": \"Age =18 years\"\n            },\n            \"right\": {\n              \"AND\": {\n                \"left\": {\n                  \"raw_text\": \"Obtained informed consent\"\n                },\n                \"right\": {\n                  \"AND\": {\n                    \"left\": {\n                      \"raw_text\": \"Stable pharmacological therapy during the last 4 weeks (with the exception of diuretics)\"\n                    }\n                  }\n                }\n              }\n            }\n          }\n        }\n      }\n  }\n}"