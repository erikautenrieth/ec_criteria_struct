"{\n  \"AND\": {\n    \"left\": {\n      \"OR\": {\n        \"left\": {\n          \"raw_text\": \"Psychiatric disorders other than insomnia, PTSD and specific phobias; including bipolar and psychotic disorders and meeting criteria for DSM-5 moderate alcohol or drug use disorders within the past year.\"\n        },\n        \"right\": {\n          \"OR\": {\n            \"left\": {\n              \"raw_text\": \"Diagnosis of a sleep disorder other than insomnia including PSG findings of apnea/hypopnea or periodic limb movement indices > 10/hour;\"}\n            },\n            \"right\": {\n              \"OR\": {\n                \"left\": {\n                  \"raw_text\": \"Medical conditions that require consistent use of medication or compromise sleep;\"}\n                },\n                \"right\": {\n                  \"OR\": {\n                    \"left\": {\n                      \"raw_text\": \"History of moderate to severe traumatic brain injury or mild traumatic brain injury with ongoing post-concussive symptoms;\"}\n                    },\n                    \"right\": {\n                      \"OR\": {\n                        \"raw_text\": \"Suicidal ideation with intent to act or with specific plan and intent in the past 6 months (Type 4 - 5 ideation on the Columbia Suicide Severity Rating Scale) or a concerning history of prior suicidal behavior.\"\n                        },\n                        \"right\": {\n                          \"OR\": {\n                            \"left\": {\n                              \"raw_text\": \"Caffeine use exceeding 5 cups of coffee per day or its equivalent;\"}\n                            },\n                            \"right\": {\n                              \"OR\": {\n                                \"left\": {\n                                  \"raw_text\": \"Habitual bedtimes after 3 AM, habitual rise times after 10 AM, or habitual napping > 1hour/day;\"}\n                                },\n                                \"right\": {\n                                  \"OR\": {\n                                    \"raw_text\": \"Pregnancy or breastfeeding, or expecting to conceive while in study;\"}\n                                    },\n                                    \"right\": {\n                                      \"OR\": {\n                                        \"raw_text\": \"Positive urine toxicology.\"\n                                        }\n                                      }\n                                    }\n                                }\n                            }\n                        }\n                    }\n                }\n            }\n          }\n      }\n  }\n}"