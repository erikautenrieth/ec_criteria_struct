"{\n  \"AND\": {\n    \"left\": {\n      \"OR\": {\n        \"left\": {\n          \"raw_text\": \"The patients have other cancers at the same time or have the history of other cancers except controlled skin basal cell carcinoma or skin squamous cell carcinoma or carcinoma in situ of cervix uterus;\"\n        },\n        \"right\": {\n          \"OR\": {\n            \"left\": {\n              \"raw_text\": \"The patients have active infections that were not suitable for chemotherapy;\"\n            },\n            \"right\": {\n              \"OR\": {\n                \"raw_text\": \"The patients have severe non-cancerous diseases.\"\n                },\n                \"right\": {\n                  \"OR\": {\n                    \"left\": {\n                      \"raw_text\": \"The patients have history of neoadjuvant hormone therapy.\"\n                    },\n                    \"right\": {\n                      \"OR\": {\n                        \"raw_text\": \"The patients have bilateral breast cancers or DCIS or metastatic breast cancers.\"\n                        },\n                        \"right\": {\n                          \"OR\": {\n                            \"raw_text\": \"The patients are undergoing current administration of anti-cancer therapies, or are attending other clinical trials.\"\n                            },\n                            \"right\": {\n                              \"OR\": {\n                                \"raw_text\": \"The patients are pregnant or lactational, or they refuse to practice contraception during the whole trial.\"\n                                },\n                                \"right\": {\n                                  \"OR\": {\n                                    \"raw_text\": \"The patients are in some special conditions that they can't understand the written informed consent, such as they are demented or hawkish.\"\n                                    },\n                                    \"right\": {\n                                      \"OR\": {\n                                        \"raw_text\": \"The patients have allergic history or contraindication of tamoxifen.\"\n                                        }\n                                      }\n                                    }\n                                  }\n                                }\n                            }\n                        }\n                    }\n                }\n            }\n          }\n        }\n      }\n    }\n  }\n}"