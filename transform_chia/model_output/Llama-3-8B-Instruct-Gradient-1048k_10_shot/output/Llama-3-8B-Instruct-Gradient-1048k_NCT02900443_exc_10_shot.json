"{\n  \"AND\": {\n    \"left\": {\n      \"OR\": {\n        \"left\": {\n          \"raw_text\": \"Overlap syndrome with Primary Sclerosing Cholangitis (PSC) or Primary Biliary Cholangitis (PBC) (Paris criteria, strong positive Anti-Mitochondrial Antibodies (AMA), past liver biopsy or cholangiographic findings compatible with PBC or PSC).\"\n        },\n        \"right\": {\n          \"OR\": {\n            \"left\": {\n              \"raw_text\": \"Presentation with acute liver failure, defined as presence of hepatic encephalopathy and coagulopathy (INR > 1.5)\"\n            },\n            \"right\": {\n              \"OR\": {\n                \"left\": {\n                  \"raw_text\": \"Current treatment with prednisone/prednisolone and/or immunosuppressive medication for an indication other than autoimmune hepatitis\"\n                },\n                \"right\": {\n                  \"OR\": {\n                    \"left\": {\n                      \"raw_text\": \"Current systemic infection\"\n                    },\n                    \"right\": {\n                      \"OR\": {\n                        \"left\": {\n                          \"raw_text\": \"Other clinically significant medical conditions that could interfere with the trial\"\n                        }\n                      }\n                    }\n                  }\n                }\n            }\n          }\n        },\n        \"right\": {\n          \"AND\": {\n            \"left\": {\n              \"OR\": {\n                \"left\": {\n                  \"raw_text\": \"If female of childbearing potential: known pregnancy, or unwilling to practice anticontraceptive measures.\"\n                },\n                \"right\": {\n                  \"OR\": {\n                    \"left\": {\n                      \"raw_text\": \"History of noncompliance with medical regimens, or patients who are considered to be potentially unreliable or unable to participate\"\n                    },\n                    \"right\": {\n                      \"OR\": {\n                        \"left\": {\n                          \"raw_text\": \"Mental instability or incompetence, such that the validity of informed consent or compliance with the trial is uncertain\"\n                        }\n                      }\n                    }\n                  }\n                }\n              }\n            }\n          }\n        }\n  }\n}"