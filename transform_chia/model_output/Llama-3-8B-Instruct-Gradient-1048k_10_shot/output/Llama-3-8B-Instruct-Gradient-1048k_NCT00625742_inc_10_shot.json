"{\n  \"AND\": {\n    \"left\": {\n      \"OR\": {\n        \"left\": {\n          \"raw_text\": \"1. Are referred to the Cachexia Clinic with involuntary weight loss of >5% of their premorbid weight within the previous 6 months.\"\n        },\n        \"right\": {\n          \"OR\": {\n            \"left\": {\n              \"raw_text\": \"2. Are 18 years of age or older.\"\n            },\n            \"right\": {\n              \"OR\": {\n                \"raw_text\": \"3. Have a Karnofsky performance score of 60 or higher.\"\n                },\n                \"right\": {\n                  \"OR\": {\n                    \"left\": {\n                      \"raw_text\": \"4. Can maintain oral food intake during the study.\"\n                    },\n                    \"right\": {\n                      \"OR\": {\n                        \"raw_text\": \"5. Can understand the study procedures and can sign an informed consent form.\"\n                        },\n                        \"right\": {\n                          \"OR\": {\n                            \"left\": {\n                              \"raw_text\": \"6. Are not currently taking melatonin.\"\n                            },\n                            \"right\": {\n                              \"OR\": {\n                                \"left\": {\n                                  \"raw_text\": \"7. Are taking megestrol acetate and continue to lose weight despite at least 2 weeks of therapy.\"\n                                },\n                                \"right\": {\n                                  \"OR\": {\n                                    \"left\": {\n                                      \"raw_text\": \"8. Have a calculated creatinine clearance of >/= 60 cc/min.\"\n                                    }\n                                  }\n                                }\n                            }\n                          }\n                        }\n                    }\n                  }\n                }\n            }\n          }\n        }\n    }\n  }\n}"