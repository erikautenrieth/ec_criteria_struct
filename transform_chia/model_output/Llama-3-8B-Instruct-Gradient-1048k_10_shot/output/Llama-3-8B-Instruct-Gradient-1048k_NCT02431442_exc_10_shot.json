"{\n  \"AND\": {\n    \"left\": {\n      \"AND\": {\n        \"left\": {\n          \"raw_text\": \"Fasting blood glucose >126 mg/dL at screening. Heterozygous subjects will be excluded for a fasting blood glucose >140 mg/dL.\"\n        },\n        \"right\": {\n          \"AND\": {\n            \"left\": {\n              \"raw_text\": \"Resting heart rate <45 bpm or >90 bpm at screening.\"\n            },\n            \"right\": {\n              \"AND\": {\n                \"left\": {\n                  \"raw_text\": \"Abnormal thyroid stimulating hormone (TSH) or thyroxine (T4) levels on screening.\"\n                },\n                \"right\": {\n                  \"AND\": {\n                    \"left\": {\n                      \"raw_text\": \"Elevated ALT or serum creatinine on screening or any clinically significant abnormalities on screening laboratory tests as determined by the Investigator.\"\n                    },\n                    \"right\": {\n                      \"AND\": {\n                        \"left\": {\n                          \"raw_text\": \"History of medically treated diabetes or of treated or medically diagnosed hypertension. Heterozygous subjects who have diagnosed hypertension and are well controlled on treatment (Refer to Exclusion Criteria 20 below), are eligible..\"\n                        },\n                        \"right\": {\n                          \"AND\": {\n                            \"left\": {\n                              \"raw_text\": \"Presence of a skin lesion suspicious for malignancy, unless excised prior to Day 1.\"\n                            },\n                            \"right\": {\n                              \"AND\": {\n                                \"left\": {\n                                  \"raw_text\": \"History of malignancy except for treated cervical carcinoma in situ in the past 5 years.\"\n                                },\n                                \"right\": {\n                                  \"AND\": {\n                                    \"raw_text\": \"Active or history of any clinically significant medical condition including renal, hepatic, pulmonary, gastrointestinal, cardiovascular, genitourinary, endocrine, immunologic, metabolic, neurologic, psychiatric or hematological disease, based on Investigator judgment.\"\n                                    },\n                                    \"right\": {\n                                      \"AND\": {\n                                        \"left\": {\n                                          \"raw_text\": \"Acute illness or history of illness, which in the opinion of the Investigator, could pose a threat or harm to the subject or obscure interpretation of laboratory test results or interpretation of study data.\"\n                                        },\n                                        \"right\": {\n                                          \"AND\": {\n                                            \"left\": {\n                                              \"raw_text\": \"Positive hepatitis B surface antigen, positive hepatitis C antibody or positive HIV test at screening or a history of positive testing (e.g. liver biopsy, serology) suggesting acute or chronic hepatitis.\"\n                                            },\n                                            \"right\": {\n                                              \"AND\": {\n                                                \"raw_text\": \"Abnormal 12-lead electrocardiogram (ECG) at screening or pre-dose (Day -1 or Day 1), except minor deviations deemed to be of no clinical significance by the Investigator.\"\n                                                },\n                                                \"right\": {\n                                                  \"AND\": {\n                                                    \"left\": {\n                                                      \"raw_text\": \"Received any experimental drugs or devices within 30 days or 5 half lives, whichever is longer, prior to dosing.\"\n                                                    },\n                                                    \"right\": {\n                                                      \"AND\": {\n                                                        \"left\": {\n                                                          \"raw_text\": \"Ongoing participation in a prior clinical study at the time of screening.\"\n                                                        },\n                                                        \"right\": {\n                                                          \"AND\": {\n                                                            \"raw_text\": \"Blood donation within 60 days prior to screening or intent to donate within 60 days after Final Study Visit.\"\n                                                            },\n                                                            \"right\": {\n                                                              \"AND\": {\n                                                                \"raw_text\": \"Hospitalization for major surgery including but not limited to abdominal, thoracic, or cardiovascular surgery within the past 3 months prior to screening, or for a clinically significant non-surgical illness, based on Investigator judgment, within the past 3 months.\"\n                                                                },\n                                                                \"right\": {\n                                                                  \"AND\": {\n                                                                    \"raw text\": \"Planned elective surgery within 30 days of the Final Study Visit.\"\n                                                                    },\n                                                                    \"right\": {\n                                                                      \"AND\": {\n                                                                        \"raw text\": \"Poor venous access or inability to tolerate venipuncture.\"\n                                                                        },\n                                                                        \"right\": {\n                                                                          \"AND\": {\n                                                                            \"left\": {\n                                                                              \"raw text\": \"History of significant drug hypersensitivity or anaphylaxis.\"\n                                                                            },\n                                                                            \"right\": {\n                                                                              \"AND\": {\n                                                                                \"left\": {\n                                                                                  \"raw text\": \"History of hypersensitivity to proteins (e.g., allergy shots).\"\n                                                                                },\n                                                                                \"right\": {\n                                                                                  \"AND\": {\n                                                                                    \"Use of prescription medications on a regular basis. The last use of any prescription medication must have been greater than 5 half-lives for that drug before receiving study drug. Hormonal contraception is allowed for female subjects.\"\n                                                                                    },\n                                                                                    \"right\": {\n                                                                                      \"AND\": {\n                                                                                        \"Use of prescription medications not listed above may be allowed at the discretion of the Investigator upon consultation with Rhythm.\"\n                                                                                      },\n                                                                                      \"right\": {\n                                                                                        \"Use of a non-prescription drug and herbal substances during the study (through the Final Study Visit). The last dose of any non-prescription drug must have been taken greater than 5 half-lives for that drug before receiving study drug.\"\n                                                                                      },\n                                                                                      \"right\": {\n                                                                                        \"Inability to attend all study visits or to comply with protocol requirements including fasting and restrictions on alcohol, caffeine, nicotine and concomitant medication intake.\"\n                                                                                      },\n                                                                                      \"right\": {\n                                                                                        \"A significant history of drug/solvent abuse within 5 years of screening or a positive test for drugs of abuse test at screening or on Day -1.\"\n                                                                                      },\n                                                                                      \"right\": {\n                                                                                        \"Positive alcohol (breath test) or nicotine screen at Screening Visit or Day 1 (positive nicotine screen does not apply to heterozygous cohort).\"\n                                                                                      },\n                                                                                      \"right\": {\n                                                                                        \"History of alcohol abuse (defined as average intake of three or more units of alcohol per day) within 5 years of the Screening Visit.\"\n                                                                                      },\n                                                                                      \"right\": {\n                                                                                        \"History of tobacco or tobacco product use unless abstinent for at least one year prior to the Screening Visit. This criterion does not apply to heterozygous subjects.\"\n                                                                                      },\n                                                                                      \"right\": {\n                                                                                        \"Previously randomized and dosed in this study. This criterion does not apply to heterozygous subjects.\"\n                                                                                      },\n                                                                                      \"right\": {\n                                                                                        \"Any other reason, which in the opinion of the Investigator would confound proper evaluation of the study.\"\n                                                                                      }\n                    }\n                }\n            }\n          }\n        }\n      }\n    }\n  }\n}"