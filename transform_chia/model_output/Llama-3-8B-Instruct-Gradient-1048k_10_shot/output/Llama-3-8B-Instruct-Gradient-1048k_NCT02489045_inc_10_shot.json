"{\n  \"AND\": {\n    \"left\": {\n      \"AND\": {\n        \"left\": {\n          \"raw_text\": \"Be scheduled for trans-jugular liver biopsy the day of the ultrasound procedure.\"\n        },\n        \"right\": {\n          \"AND\": {\n            \"left\": {\n              \"raw_text\": \"Be at least 21 years of age.\"\n            },\n            \"right\": {\n              \"AND\": {\n                \"OR\": {\n                  \"left\": {\n                    \"raw_text\": \"Be medically stable.\"\n                  },\n                  \"right\": {\n                    \"OR\": {\n                      \"left\": {\n                        \"raw_text\": \"If a female of child-bearing potential, must have a negative pregnancy test.\"\n                      }\n                    }\n                  }\n                }\n              }\n            }\n          }\n        },\n        \"right\": {\n          \"AND\": {\n            \"left\": {\n              \"OR\": {\n                \"left\": {\n                  \"raw_text\": \"Be conscious and able to comply with study procedures.\"\n                },\n                \"right\": {\n                  \"OR\": {\n                    \"left\": {\n                      \"raw_text\": \"Have read and signed the IRB-approved Informed Consent form for participating in the study.\"\n                    }\n                  }\n                }\n              }\n            }\n          }\n        }\n      }\n  }\n}"