"{\n  \"AND\": {\n    \"left\": {\n      \"AND\": {\n        \"left\": {\n          \"raw_text\": \"Capacity to provide informed consent before any trial-related activities\"\n        },\n        \"right\": {\n          \"AND\": {\n            \"left\": {\n              \"OR\": {\n                \"left\": {\n                  \"raw_text\": \"Established T2DM (=3months)\"\n                },\n                \"right\": {\n                  \"AND\": {\n                    \"left\": {\n                      \"raw_text\": \"HbA1c = 9% if on triple therapy or = 10% on diet & exercise or monotherapy or dual therapy\"}\n                    },\n                    \"right\": {\n                      \"AND\": {\n                        \"left\": {\n                          \"raw_text\": \"Current glucose lowering therapy either mono, dual or triple of any combination of metformin, sulphonylurea, DPP-IV inhibitor, GLP-1 therapy or an SGLT2 +/- diet and exercise\"}\n                        },\n                        \"right\": {\n                          \"AND\": {\n                            \"left\": {\n                              \"raw_text\": \"Poorly managed diet controlled diabetes (with HbA1c > 6.5%, not currently taking any glucose lowering therapy, meeting BMI inclusion range)\"}\n                            },\n                            \"right\": {\n                              \"AND\": {\n                                \"left\": {\n                                  \"raw_text\": \"Body mass index > 30Kg/m2 or > 27.5 Kg/m2 (South Asian),\"}\n                                \"right\": {\n                                  \"AND\": {\n                                    \"left\": {\n                                      \"raw_text\": \"Diagnosis of T2DM before the age of 60 years of age\"}\n                                    },\n                                    \"right\": {\n                                      \"AND\": {\n                              