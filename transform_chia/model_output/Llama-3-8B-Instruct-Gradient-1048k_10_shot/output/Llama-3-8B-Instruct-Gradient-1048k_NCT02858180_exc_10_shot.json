"{\n  \"AND\": {\n    \"left\": {\n      \"OR\": {\n        \"left\": {\n          \"raw_text\": \"Chronic HCV Infection with Genotype 2 or 3\"\n        },\n        \"right\": {\n          \"raw_text\": \"Amiodarone. Subjects previously treated with amiodarone must have stopped the amiodarone at least 60 days prior to day 1 of SOF/LDV FDC\"\n        }\n      }\n    },\n    \"right\": {\n      \"AND\": {\n        \"left\": {\n          \"OR\": {\n            \"left\": {\n              \"raw_text\": \"Carbamazepine, phenytoin, phenobarbital, oxcarbazepine\"\n            },\n            \"right\": {\n              \"OR\": {\n                \"raw_text\": \"Rifabutin, rifampin or rifapentine\"\n                }\n            }\n          }\n        },\n        \"right\": {\n          \"AND\": {\n            \"left\": {\n              \"OR\": {\n                \"left\": {\n                  \"raw_text\": \"HIV regimens containing tenofovir or tipranavir/ritonavir\"\n                },\n                \"right\": {\n                  \"OR\": {\n                    \"raw_text\": \"St. John's wort\"\n                    }\n                }\n            }\n          }\n        },\n        \"right\": {\n          \"AND\": {\n            \"left\": {\n              \"OR\": {\n                \"left\": {\n                  \"raw_text\": \"Rosuvastatin\"\n                },\n                \"right\": {\n                  \"OR\": {\n                    \"raw_text\": \"Have any serious or active medical or psychiatric illness which, in the opinion of the investigator, would interfere with subject treatment, assessment, or compliance\"\n                }\n            }\n          }\n        },\n        \"right\": {\n          \"AND\": {\n            \"left\": {\n              \"OR\": {\n                \"left\": {\n                  \"raw_text\": \"History of hepatic encephalopathy or variceal hemorrhage\"\n                },\n                \"right\": {\n                  \"OR\": {\n                    \"raw_text\": \"Hepatitis B surface antigen positive\"\n                    }\n                }\n            }\n          }\n        },\n        \"right\": {\n          \"AND\": {\n            \"left\": {\n              \"OR\": {\n                \"left\": {\n                  \"raw_text\": \"Hemoglobin (Hb) < 8 g/dL\"\n                },\n                \"right\": {\n                  \"OR\": {\n                    \"raw_text\": \"Platelets = 50,000/mm3\"\n                    }\n                }\n            }\n          }\n        },\n        \"right\": {\n          \"AND\": {\n            \"left\": {\n              \"OR\": {\n                \"left\": {\n                  \"raw_text\": \"alanine aminotransferase (ALT), aspartase aminotransferase (AST), or alkaline phosphatase = 10 times upper limit of normal(ULN)\"\n                },\n                \"right\": {\n                  \"OR\": {\n                    \"raw_text\": \"Total bilirubin > 3 mg/dl\"\n                    }\n                }\n            }\n          }\n        },\n        \"right\": {\n          \"AND\": {\n            \"left\": {\n              \"OR\": {\n                \"raw_text\": \"Severe renal impairment creatinine clearance (CrCl), i.e. < 30 mL/min.\"\n                },\n                \"right\": {\n                  \"OR\": {\n                    \"raw text\": \"History of major organ transplantation with an existing functional graft.\"\n                    }\n                }\n            }\n          }\n        },\n        \"right\": {\n          \"AND\": {\n            \"left\": {\n              \"OR\": {\n                \"raw text\": \"History of clinically-significant drug allergy to nucleoside/nucleotide analogs.\"\n                }\n            }\n          }\n        },\n        \"right\": {\n          \"AND\": {\n            \"left\": {\n              \"OR\": {\n                \"raw text\": \"Pregnant women or women planning to become pregnant\"\n                },\n                \"right\": {\n                  \"OR\": {\n                    \"raw text\": \"Women who are breastfeeding\"\n                    }\n                }\n            }\n          }\n        },\n        \"right\": {\n          \"AND\": {\n            \"left\": {\n              \"OR\": {\n                \"raw text\": \"Active or recent history (= 1 year) of drug or alcohol abuse\"\n                }\n            }\n          }\n        }\n      }\n  }\n}"