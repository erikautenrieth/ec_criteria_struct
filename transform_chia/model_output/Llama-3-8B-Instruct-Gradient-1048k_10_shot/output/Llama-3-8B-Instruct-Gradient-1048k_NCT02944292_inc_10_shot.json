"{\n  \"AND\": {\n    \"left\": {\n      \"raw_text\": \"Age 18 years or older\"\n    },\n    \"right\": {\n      \"AND\": {\n        \"left\": {\n          \"OR\": {\n            \"left\": {\n              \"raw_text\": \"Mechanical ventilation\"\n            },\n            \"right\": {\n              \"OR\": {\n                \"left\": {\n                  \"raw_text\": \"IAP between 12 and 20 mmHg in at least two consecutive measurements within 1-12 h\"\n                },\n                \"right\": {\n                  \"OR\": {\n                    \"left\": {\n                      \"raw_text\": \"Spontaneous breathing activity of at least 6 breaths/minute\"\n                    },\n                    \"right\": {\n                      \"OR\": {\n                        \"raw_text\": \"RASS score between 0 and -4\"\n                        },\n                        \"right\": {\n                          \"OR\": {\n                            \"left\": {\n                              \"raw_text\": \"Physician-led sedation (if sedated; as opposed to nurse-led protocol)\"\n                            }\n                          }\n                        }\n                    }\n                }\n            }\n          }\n        }\n      }\n    }\n  }\n}"