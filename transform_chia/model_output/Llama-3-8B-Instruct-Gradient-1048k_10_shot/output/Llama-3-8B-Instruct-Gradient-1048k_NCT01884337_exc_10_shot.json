"{\n  \"AND\": {\n    \"left\": {\n      \"OR\": {\n        \"left\": {\n          \"raw_text\": \"Women who are pregnant or breastfeeding\"\n        },\n        \"right\": {\n          \"OR\": {\n            \"left\": {\n              \"raw_text\": \"Known or suspected, acquired or bleeding or coagulation disorder in the subject or a first degree relative\"\n            },\n            \"right\": {\n              \"OR\": {\n                \"left\": {\n                  \"raw_text\": \"Active bleeding or at high risk for bleeding.\"\n                },\n                \"right\": {\n                  \"OR\": {\n                    \"left\": {\n                      \"raw_text\": \"Brain, spinal, ophthalmologic, or major surgery or trauma within the past 90 days other than the elective knee/hip surgery\"\n                    },\n                    \"right\": {\n                      \"OR\": {\n                        \"raw_text\": \"Active hepatobiliary disease\"\n                        }\n                      }\n                    }\n                  }\n                }\n              }\n            }\n          }\n        },\n        \"right\": {\n          \"AND\": {\n            \"left\": {\n              \"OR\": {\n                \"left\": {\n                  \"raw_text\": \"Hemoglobin <9 g/dL\"\n                },\n                \"right\": {\n                  \"OR\": {\n                    \"left\": {\n                      \"raw_text\": \"Platelet count <100,000/mm3\"\n                    },\n                    \"right\": {\n                      \"OR\": {\n                        \"raw_text\": \"Creatinine clearance <30 mL/min\"\n                        }\n                      }\n                    }\n                  }\n                }\n              }\n            }\n          }\n        }\n  }\n}"