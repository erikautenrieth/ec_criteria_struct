"{\n  \"AND\": {\n    \"left\": {\n      \"OR\": {\n        \"left\": {\n          \"raw_text\": \"Type 1 diabetes (autoantibody positive).\"\n        },\n        \"right\": {\n          \"AND\": {\n            \"left\": {\n              \"OR\": {\n                \"left\": {\n                  \"raw_text\": \"Any history of receiving GLP-1 analogues or dipeptidyl peptidase inhibitors within 6 months\"\n                },\n                \"right\": {\n                  \"OR\": {\n                    \"left\": {\n                      \"raw_text\": \"Known severe heart failure, classified as NYHA 4.\"\n                    },\n                    \"right\": {\n                      \"OR\": {\n                        \"left\": {\n                          \"raw_text\": \"Active myocarditis; malfunctioning artificial heart valve.\"\n                        },\n                        \"right\": {\n                          \"OR\": {\n                            \"left\": {\n                              \"raw_text\": \"History of ventricular tachycardia within 3 months before study entry; second- or third-degree atrioventricular block.\"\n                            },\n                            \"right\": {\n                              \"OR\": {\n                                \"left\": {\n                                  \"raw_text\": \"Supine systolic blood pressure <85 mm Hg or >200 mm Hg at screening.\"\n                                },\n                                \"right\": {\n                                  \"OR\": {\n                                    \"left\": {\n                                      \"Primary renal impairment, creatinine clearance < 45 ml/min if treated with metformin.\"\n                                    },\n                                    \"right\": {\n                                      \"OR\": {\n                                        \"left\": {\n                                          \"raw_text\": \"Uncorrected hypokalemia or hyperkalemia (potassium <3.5 mmol/l or >5.5 mmol/l).\"\n                                        },\n                                        \"right\": {\n                                          \"OR\": {\n                                            \"left\": {\n                                              \"raw_text\": \"Significant anemia (Hb < 90 g/l)\"\n                                            },\n                                            \"right\": {\n                                              \"OR\": {\n                                                \"raw_text\": \"Severe gastrointestinal disease, including gastroparesis. As judged by the Investigator.\"\n                                                }\n                                              }\n                                            }\n                                        }\n                                      }\n                                    }\n                                }\n                            }\n                          }\n                        }\n                      }\n                    }\n                }\n            }\n          }\n        },\n        \"right\": {\n          \"AND\": {\n            \"left\": {\n              \"OR\": {\n                \"left\": {\n                  \"raw_text\": \"Body mass index (BMI) > 45 kg/m2.\"\n                },\n                \"right\": {\n                  \"OR\": {\n                    \"left\": {\n                      \"raw_text\": \"Malignant neoplasm requiring chemotherapy, surgery, radiation or palliative therapy in the previous 5 years. Patients with intraepithelial squamous cell carcinoma of the skin treated with topical 5FU and subjects with basal cell skin cancer are allowed to enter the trial.\"\n                    },\n                    \"right\": {\n                      \"OR\": {\n                        \"left\": {\n                          \"raw_text\": \"Females of child bearing potential who are pregnant, breast-feeding or intend to become pregnant.\"\n                        },\n                        \"right\": {\n                          \"OR\": {\n                            \"raw_text\": \"Current drug and alcohol abuse.\"\n                            },\n                            \"right\": {\n                              \"OR\": {\n                                \"left\": {\n                                  \"raw text\": \"History of acute or chronic pancreatitis. As judged by the Investigator.\"\n                                },\n                                \"right\": {\n                                  \"OR\": {\n                                    \"Subjects considered by the Investigator to be unsuitable for the study.\"\n                                    }\n                                  }\n                                }\n                            }\n                          }\n                        }\n                      }\n                    }\n                }\n            }\n          }\n        }\n      }\n    }\n  }\n}"