"{\n  \"AND\": {\n    \"left\": {\n      \"OR\": {\n        \"left\": {\n          \"raw_text\": \"1. For subjects in Cohort A: previous therapy for more than 48 hours with any parenteral antibiotic with activity against S. aureus within 72 hours of positive blood culture results.\"\n        },\n        \"right\": {\n          \"OR\": {\n            \"left\": {\n              \"raw_text\": \"2. For subjects in Cohort B: previous therapy for more than 48 hours with any parenteral antibiotic with activity against MRSA, except vancomycin and/or daptomycin, within 72 hours of positive blood culture results confirming persistence.\"\n            },\n            \"right\": {\n              \"AND\": {\n                \"left\": {\n                  \"OR\": {\n                    \"left\": {\n                      \"raw_text\": \"3. Previous episode of S. aureus bacteremia within 3 months.\"\n                    },\n                    \"right\": {\n                      \"AND\": {\n                        \"left\": {\n                          \"OR\": {\n                            \"left\": {\n                              \"raw_text\": \"4. Known left-sided endocarditis or prosthetic heart valve.\"\n                            },\n                            \"right\": {\n                              \"OR\": {\n                                \"left\": {\n                                  \"raw_text\": \"5. Osteomyelitis or prosthetic joint infection except new onset nonhardware-associated vertebral osteomyelitis.\"\n                                },\n                                \"right\": {\n                                  \"OR\": {\n                                    \"raw_text\": \"6. History of any hypersensitivity or allergic reaction to any β-lactam antibacterial agent.\"\n                                    },\n                                    \"right\": {\n                                      \"OR\": {\n                                        \"left\": {\n                                          \"raw_text\": \"7. Evidence of significant hepatic, hematologic, or immunologic impairment.\"\n                                        },\n                                        \"right\": {\n                                          \"OR\": {\n                                            \"raw_text\": \"8. Pregnant or nursing females.\"\n                                            }\n                                          }\n                                        }\n                                      }\n                                    }\n                                  }\n                                }\n                            }\n                          }\n                        }\n                      }\n                    }\n                  }\n                }\n              }\n            }\n          }\n    }\n  }\n}"