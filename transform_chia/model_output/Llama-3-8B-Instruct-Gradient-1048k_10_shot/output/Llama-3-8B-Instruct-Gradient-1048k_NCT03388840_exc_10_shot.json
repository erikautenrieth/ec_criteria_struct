"{\n  \"AND\": {\n    \"left\": {\n      \"OR\": {\n        \"left\": {\n          \"raw_text\": \"Patients with Non-androgenetic causes of hair loss.\"\n        },\n        \"right\": {\n          \"OR\": {\n            \"left\": {\n              \"raw_text\": \"Female patients with androgenetic alopecia.\"\n            },\n            \"right\": {\n              \"OR\": {\n                \"raw_text\": \"Patients who received anti-hair loss treatment within the past six months.\"\n                },\n                \"right\": {\n                  \"OR\": {\n                    \"left\": {\n                      \"raw_text\": \"Patients with history of bleeding disorders or on anticoagulant therapy.\"\n                    },\n                    \"right\": {\n                      \"OR\": {\n                        \"left\": {\n                          \"raw_text\": \"Patients with history of chronic liver disease, cancer or connective tissue disorders.\"\n                        },\n                        \"right\": {\n                          \"OR\": {\n                            \"left\": {\n                              \"raw_text\": \"Patients with current scalp infection.\"\n                            }\n                          }\n                        }\n                      }\n                    }\n                }\n            }\n          }\n        }\n      }\n  }\n}"