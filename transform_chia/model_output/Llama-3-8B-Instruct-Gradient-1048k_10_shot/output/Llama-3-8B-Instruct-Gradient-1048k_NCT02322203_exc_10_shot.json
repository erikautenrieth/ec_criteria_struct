"{\n  \"AND\": {\n    \"left\": {\n      \"OR\": {\n        \"left\": {\n          \"raw_text\": \"Subjects taking any lipid modification therapy, including but not limited to statins, fibrates and bile acid sequestrants.\"\n        },\n        \"right\": {\n          \"OR\": {\n            \"left\": {\n              \"raw_text\": \"Subjects taking fish oil or any other supplements, which in the investigator s opinion may interfere with the study.\"\n            },\n            \"right\": {\n              \"OR\": {\n                \"left\": {\n                  \"raw_text\": \"Subjects with acute liver disease or active peptic ulcer disease.\"\n                },\n                \"right\": {\n                  \"OR\": {\n                    \"left\": {\n                      \"raw_text\": \"Subjects with elevated uric acid levels greater than 10 mg/dL or gout.\"\n                    },\n                    \"right\": {\n                      \"OR\": {\n                        \"left\": {\n                          \"raw_text\": \"Pregnancy or women currently breastfeeding.\"\n                        },\n                        \"right\": {\n                          \"OR\": {\n                            \"left\": {\n                              \"raw_text\": \"Female subjects taking hormonal contraceptives or hormone replacement therapy may be included in this study only if they have been on a stable dose for at least 3 months.\"\n                            },\n                            \"right\": {\n                              \"OR\": {\n                                \"left\": {\n                                  \"raw_text\": \"BMI less than 18.5.\"\n                                },\n                                \"right\": {\n                                  \"OR\": {\n                                    \"raw_text\": \"Subjects with weight that varies greater than 20% over the past 3 months.\"\n                                    }\n                                  }\n                                }\n                            }\n                          }\n                        }\n                      }\n                    }\n                  }\n                }\n              }\n            }\n          }\n        },\n        \"right\": {\n          \"AND\": {\n            \"left\": {\n              \"OR\": {\n                \"left\": {\n                  \"raw_text\": \"Subjects initiating new medications or patients on multiple medications may also be excluded.\"\n                },\n                \"right\": {\n                  \"OR\": {\n                    \"left\": {\n                      \"raw_text\": \"Inability to swallow capsules.\"\n                    },\n                    \"right\": {\n                      \"OR\": {\n                        \"raw_text\": \"Patients with a history of type I or type II diabetes or HbA1c greater than 6.5%.\"\n                        },\n                        \"right\": {\n                          \"OR\": {\n                            \"raw_text\": \"Volunteers may also be excluded, if in the opinion of the study investigators, they have some other condition or disorder that may adversely affect the outcome of the study or the safety of the volunteer.\"\n                            }\n                          }\n                        }\n                      }\n                    }\n                  }\n                }\n              }\n            }\n          }\n        }\n      }\n  }\n}"