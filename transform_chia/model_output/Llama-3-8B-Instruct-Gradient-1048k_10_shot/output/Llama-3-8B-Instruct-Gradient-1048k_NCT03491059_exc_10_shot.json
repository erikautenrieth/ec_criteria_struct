"{\n  \"AND\": {\n    \"left\": {\n      \"NOT\": {\n        \"left\": {\n          \"raw_text\": \"not a regular user of e-cigarettes\"\n        }\n      },\n      \"right\": {\n        \"AND\": {\n          \"left\": {\n            \"OR\": {\n              \"left\": {\n                \"raw_text\": \"pregnant or lactating (only excluded from imaging study)\"\n              },\n              \"right\": {\n                \"OR\": {\n                  \"left\": {\n                    \"raw_text\": \"prisoner\"\n                  }\n              }\n            },\n            \"right\": {\n              \"AND\": {\n                \"left\": {\n                  \"OR\": {\n                    \"left\": {\n                      \"raw_text\": \"incapable of giving informed consent\"\n                    },\n                    \"right\": {\n                      \"OR\": {\n                        \"left\": {\n                          \"raw_text\": \"unable to lie flat on the scanner for extended periods of time\"\n                        }\n                    }\n                  }\n                }\n              },\n              \"right\": {\n                \"OR\": {\n                  \"left\": {\n                    \"OR\": {\n                      \"left\": {\n                        \"raw_text\": \"unstable medical condition like heart disease, uncontrolled hypertension, thyroid disease, diabetes, renal or liver impairment, or glaucoma\"\n                      },\n                      \"right\": {\n                        \"OR\": {\n                          \"raw_text\": \"prostatic hypertrophy, stroke, or ulcer in past year\"\n                        }\n                    }\n                  }\n                },\n                \"right\": {\n                  \"OR\": {\n                    \"OR\": {\n                      \"left\": {\n                        \"raw_text\": \"psychiatric conditions such as schizophrenia, adult ADHD, or bipolar disorder\"\n                      },\n                      \"right\": {\n                        \"OR\": {\n                          \"raw_text\": \"current or regular use of psychiatric medications such as tranquilizers, antipsychotics, and/or antidepressants\"\n                        }\n                    }\n                  }\n                },\n                \"right\": {\n                  \"OR\": {\n                    \"left\": {\n                      \"raw_text\": \"use of medications that are inducers of CYP2A6 (a nicotine metabolizing enzyme) such as rifampicin, dexamethasone, phenobarbital, and other anti-convulsant drugs\"\n                    },\n                    \"right\": {\n                      \"OR\": {\n                        \"raw_text\": \"unable to communicate in English\"\n                    }\n                  }\n                },\n                \"right\": {\n                  \"OR\": {\n                    \"left\": {\n                      \"OR\": {\n                        \"left\": {\n                          \"raw_text\": \"current use of smokeless tobacco, tobacco cigarettes (5 and fewer a day)\"\n                      },\n                      \"right\": {\n                        \"OR\": {\n                          \"raw_text\": \"occasional use of pipes is permitted if subject abstains for the week prior to the study\"\n                      }\n                    }\n                  }\n                },\n                \"right\": {\n                  \"OR\": {\n                    \"left\": {\n                      \"raw_text\": \"older than 80 years\"\n                    }\n                  }\n                }\n              }\n            }\n          }\n        }\n      }\n    }\n  }\n}"