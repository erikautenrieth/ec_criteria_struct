"{\n  \"AND\": {\n    \"left\": {\n      \"OR\": {\n        \"left\": {\n          \"raw_text\": \"Confirmed diagnosis of non-Burkitt B-lineage ALL\"\n        },\n        \"right\": {\n          \"raw_text\": \"or confirmed diagnosis of B-cell ALL with t(9;22) (Philadelphia chromosome) or t(4;11) translocation, or confirmed diagnosis of T-lineage ALL with t(12;21) translocation.\"\n        }\n      },\n    \"right\": {\n      \"AND\": {\n        \"left\": {\n          \"raw_text\": \"1 to 17 years of age (before 18th birthday)\"\n        },\n        \"right\": {\n          \"AND\": {\n            \"left\": {\n              \"raw_text\": \"Renal function within normal range for age\"\n            },\n            \"right\": {\n              \"AND\": {\n                \"left\": {\n                  \"raw_text\": \"Liver function within normal range for age\"\n                },\n                \"right\": {\n                  \"AND\": {\n                    \"left\": {\n                      \"raw_text\": \"Able to participate in the full 2 years of treatment.\"\n                    }\n                  }\n                }\n              }\n            }\n          }\n        }\n      }\n  }\n}"