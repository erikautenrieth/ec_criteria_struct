"{\n  \"AND\": {\n    \"left\": {\n      \"OR\": {\n        \"left\": {\n          \"raw_text\": \"Patients undergoing bilateral hip or knee replacement;\"\n        },\n        \"right\": {\n          \"OR\": {\n            \"left\": {\n              \"raw_text\": \"Patients undergoing total hip or knee replacement who have been enrolled in this study for a prior hip or knee replacement;\"\n            },\n            \"right\": {\n              \"OR\": {\n                \"raw_text\": \"Patients who are concurrently enrolled in another active interventional clinical trial testing a drug or intervention known or believed to interact with aspirin, warfarin, or rivaroxaban;\"\n            }\n          }\n        }\n      },\n    \"right\": {\n      \"AND\": {\n        \"left\": {\n          \"OR\": {\n            \"left\": {\n              \"raw_text\": \"Patients who have a contraindication to two or more of the three study prophylaxis regimens;\"\n            },\n            \"right\": {\n              \"OR\": {\n                \"left\": {\n                  \"raw_text\": \"Women who are pregnant or breastfeeding, as well as those of reproductive potential unless there is a negative urine pregnancy test on the day of surgery;\"\n                },\n                \"right\": {\n                  \"OR\": {\n                    \"left\": {\n                      \"raw_text\": \"Patients on chronic (longer than the prior 6 months) anticoagulation other than with antiplatelet medications;\"\n                    },\n                    \"right\": {\n                      \"OR\": {\n                        \"left\": {\n                          \"raw_text\": \"Patients with documented gastrointestinal, cerebral, or other hemorrhage within 3 months of the operation;\"\n                        },\n                        \"right\": {\n                          \"OR\": {\n                            \"left\": {\n                              \"raw_text\": \"Patients with a known diagnosis of defective hemostasis and past history of clinical bleeding requiring transfusion and treatment;\"\n                            },\n                            \"right\": {\n                              \"OR\": {\n                                \"left\": {\n                                  \"raw_text\": \"Patients who have had an operative procedure involving the eye, ear, or central nervous system within one month;\"\n                                },\n                                \"right\": {\n                                  \"OR\": {\n                                    \"raw_text\": \"Patients with severe uncontrolled hypertension with systolic BP > 220mmHg or diastolic BP > 120mmHg;\"\n                                    },\n                                    \"right\": {\n                                      \"OR\": {\n                                        \"raw_text\": \"Patients with an absolute body weight of less than 41 kilograms (90.4 lbs) at baseline visit;\"\n                                        },\n                                        \"right\": {\n                                          \"OR\": {\n                                            \"raw_text\": \"Vulnerable patient populations including prisoners and institutionalized individuals.\"\n                                            }\n                                          }\n                                        }\n                                      }\n                                  }\n                                }\n                            }\n                          }\n                        }\n                      }\n                    }\n                  }\n                }\n              }\n            }\n          }\n        }\n      }\n  }\n}"