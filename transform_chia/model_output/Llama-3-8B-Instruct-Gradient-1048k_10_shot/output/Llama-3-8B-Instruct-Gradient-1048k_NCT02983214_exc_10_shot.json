"{\n  \"AND\": {\n    \"left\": {\n      \"OR\": {\n        \"left\": {\n          \"raw_text\": \"Congestive heart failure, history of ventricular tachycardia, ventricular fibrillation or multifocal ventricular extrasystoles or QTc prolongation.\"\n        },\n        \"right\": {\n          \"OR\": {\n            \"left\": {\n              \"raw_text\": \"Patients with atrial fibrillation taking any anticoagulant therapy or patients with a history of cardioembolic ischemic stroke or hemorrhagic stroke.\"\n            },\n            \"right\": {\n              \"OR\": {\n                \"left\": {\n                  \"raw_text\": \"Patients with a history (= 12 months) of acute coronary syndrome receiving dual antiplatelet therapy, or patients receiving monotherapy with aspirin.\"\n                },\n                \"right\": {\n                  \"OR\": {\n                    \"left\": {\n                      \"raw_text\": \"Patients with hepatic impairment (child-Pugh staging, calibration = 5) or renal impairment (creatinine clearance = 30ml / min), recent peptic ulcer, a history of hypersensitivity to cilostazol, cancer patients undergoing treatment.\"\n                    }\n                  }\n                }\n              }\n            }\n          }\n        }\n      }\n    }\n  }\n}"