"{\n  \"AND\": {\n    \"left\": {\n      \"OR\": {\n        \"left\": {\n          \"raw_text\": \"Has any clinically significant condition or situation (eg, anatomical malformation that complicates intubation) other than the condition being studied that, in the opinion of the investigator, would interfere with the trial evaluations or optimal participation in the trial.\"\n        },\n        \"right\": {\n          \"OR\": {\n            \"left\": {\n              \"raw_text\": \"Has a neuromuscular disorder that may affect NMB and/or trial assessments.\"\n            },\n            \"right\": {\n              \"OR\": {\n                \"left\": {\n                  \"raw_text\": \"Is dialysis-dependent or has (or is suspected of having) severe renal insufficiency (defined as estimated glomerular filtration rate (eGFR) <30 ml/min).\"\n                },\n                \"right\": {\n                  \"OR\": {\n                    \"left\": {\n                      \"raw_text\": \"Has or is suspected of having a family or personal history of malignant hyperthermia.\"\n                    },\n                    \"right\": {\n                      \"OR\": {\n                        \"left\": {\n                          \"raw_text\": \"Has or is suspected of having an allergy to study treatments or its/their excipients, to opioids/opiates, muscle relaxants or their excipients, or other medication(s) used during general anesthesia.\"\n                        }\n                      }\n                    }\n                  }\n                }\n              }\n            }\n          }\n        }\n      }\n    }\n  }\n}"