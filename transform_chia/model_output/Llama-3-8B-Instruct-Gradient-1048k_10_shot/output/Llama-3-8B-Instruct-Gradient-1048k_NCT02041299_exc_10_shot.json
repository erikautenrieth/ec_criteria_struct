"{\n  \"AND\": {\n    \"left\": {\n      \"OR\": {\n        \"left\": {\n          \"raw_text\": \"Thalassemia syndromes;\"\n        },\n        \"right\": {\n          \"OR\": {\n            \"left\": {\n              \"raw_text\": \"Myelodysplastic syndrome (MDS) or myelofibrosis;\"\n            },\n            \"right\": {\n              \"OR\": {\n                \"left\": {\n                  \"raw_text\": \"Diamond Blackfan anemia;\"\n                },\n                \"right\": {\n                  \"OR\": {\n                    \"raw_text\": \"Primary bone marrow failure;\"\n                    \"baseline LIC >30 mg/g dw (measured by MRI);\"}\n                }\n            }\n          }\n        },\n        \"right\": {\n          \"AND\": {\n            \"left\": {\n              \"raw_text\": \"Unable or unwilling to undergo a 7 day washout period if currently being treated with deferiprone or deferoxamine or deferasirox;\"\n            },\n            \"right\": {\n              \"AND\": {\n                \"left\": {\n                  \"raw_text\": \"Previous discontinuation of treatment with deferiprone or deferoxamine due to adverse events;\"\n                },\n                \"right\": {\n                  \"AND\": {\n                    \"left\": {\n                      \"raw_text\": \"History or presence of hypersensitivity or idiosyncratic reaction to deferiprone or deferoxamine;\"\n                    },\n                    \"right\": {\n                      \"AND\": {\n                        \"left\": {\n                          \"raw_text\": \"Treated with hydroxyurea within 30 days;\"\n                        }\n                      }\n                    }\n                }\n            }\n          }\n        },\n        \"right\": {\n          \"AND\": {\n            \"left\": {\n              \"raw_text\": \"History of malignancy;\"\n            },\n            \"right\": {\n              \"AND\": {\n                \"left\": {\n                  \"OR\": {\n                    \"left\": {\n                      \"raw_text\": \"Evidence of abnormal liver function (serum ALT level(s) > 5 times upper limit of normal at screening or creatinine levels >2 times upper limit of normal at screening);\"}\n                    },\n                    \"right\": {\n                      \"AND\": {\n                        \"left\": {\n                          \"raw_text\": \"A serious, unstable illness, as judged by the Investigator, during the past 3 months before screening/baseline visit including but not limited to: hepatic, renal, gastro-enterologic, respiratory, cardiovascular, endocrinologic, neurologic or immunologic disease;\"}\n                    }\n                  }\n                }\n            }\n          }\n        },\n        \"right\": {\n          \"AND\": {\n            \"left\": {\n              \"raw_text\": \"Clinically significant abnormal 12-lead ECG findings;\"}\n            \"right\": {\n              \"AND\": {\n                \"left\": {\n                  \"raw_text\": \"Cardiac MRI T2* <10ms;\"}\n                \"right\": {\n                  \"raw_text\": \"Myocardial infarction, cardiac arrest or cardiac failure within 1 year before screening/baseline visit;\"}\n                \"right\": {\n                  \"OR\": {\n                    \"left\": {\n                      \"raw_text\": \"Unable to undergo MRI\"}\n                    \"right\": {\n                      \"OR\": {\n                        \"left\": {\n                          \"raw_text\": \"Presence of metallic objects such as artificial joints, inner ear (cochlear) implants, brain aneurysm clips, pacemakers, and metallic foreign bodies in the eye or other body areas that would prevent use of MRI imaging.\"\n                        }\n                      }\n                    }\n                }\n              }\n            }\n          }\n        }\n      }\n    }\n  }\n}"