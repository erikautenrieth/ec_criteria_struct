"{\n  \"AND\": {\n    \"left\": {\n      \"AND\": {\n        \"left\": {\n          \"raw_text\": \"Histologically confirmed PD-L1 status defined NSCLC. Biopsy must be within 70 days of first treatment with pembrolizumab.\"\n        },\n        \"right\": {\n          \"AND\": {\n            \"left\": {\n              \"raw_text\": \"ECOG performance status 2.\"\n            },\n            \"right\": {\n              \"AND\": {\n                \"left\": {\n                  \"raw_text\": \"Life expectancy > 12 weeks.\"\n                },\n                \"right\": {\n                  \"AND\": {\n                    \"left\": {\n                      \"raw_text\": \"Uni-dimensionally measurable disease according to Response Evaluation Criteria in Solid Tumours (RECIST) v1.1\"\n                    },\n                    \"right\": {\n                      \"AND\": {\n                        \"left\": {\n                          \"raw_text\": \"Computerised Tomography (CT) scan of chest and abdomen within 28 days of starting pembrolizumab.\"\n                        },\n                        \"right\": {\n                          \"AND\": {\n                            \"left\": {\n                              \"raw_text\": \"Adequate haematological function: Platelet count ≥100 x 109 /L. Neutrophils ≥1.5 x 109/L. Haemoglobin ≥ 9g/dL.\"\n                            },\n                            \"right\": {\n                              \"AND\": {\n                                \"left\": {\n                                  \"raw_text\": \"Adequate hepatic function: Serum bilirubin ≤1.5 x upper limit of normal (ULN). Serum transaminases ≤2.5 x ULN.\"\n                                },\n                                \"right\": {\n                                  \"AND\": {\n                                    \"left\": {\n                                      \"raw_text\": \"Adequate renal function: Creatinine clearance <1.5 times ULN concurrent with