"{\n  \"AND\": {\n    \"left\": {\n      \"OR\": {\n        \"left\": {\n          \"raw_text\": \"Current inpatient hospitalization or active suicidal ideation requiring referral for inpatient hospitalization for safety.\"\n        },\n        \"right\": {\n          \"OR\": {\n            \"left\": {\n              \"raw_text\": \"History of psychotic disorder or manic episode diagnosed by MINI-KID\"\n            },\n            \"right\": {\n              \"OR\": {\n                \"left\": {\n                  \"raw_text\": \"History of substance dependence diagnosis by MINI-KID (excluding tobacco) or positive urine toxicology.\"\n                },\n                \"right\": {\n                  \"OR\": {\n                    \"left\": {\n                      \"raw_text\": \"Pregnancy (urine pregnancy tests on the day of scans for menstruating girls).\"\n                    },\n                    \"right\": {\n                      \"OR\": {\n                        \"raw_text\": \"Inability to provide written informed consent according to the Yale Human Investigation Committee (HIC) guidelines in English.\"\n                        }\n                    }\n                  }\n                }\n              }\n            }\n          }\n        }\n    }\n  }\n}"