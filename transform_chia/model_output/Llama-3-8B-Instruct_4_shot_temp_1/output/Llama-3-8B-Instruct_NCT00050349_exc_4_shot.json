{
  "OR": {
    "left": {
      "raw_text": "Patients with symptomatic CNS metastases"
    },
    "right": {
      "raw_text": "or leptomeningeal involvement"
    }
  },
  "OR": {
    "left": {
      "AND": {
        "left": {
          "raw_text": "Patients with known brain metastases"
        },
        "right": {
          "NOT": {
            "left": {
              "OR": {
                "left": {
                  "raw_text": "unless these metastases have been treated"
                },
                "right": {
                  "AND": {
                    "left": {
                      "raw_text": "and/or have been stable for at least six months prior to study start"
                    },
                    "right": {
                      "raw_text": ". Subjects with a history of brain metastases must have a head CT with contrast to document either response or progression."
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "right": {
      "OR": {
        "left": {
          "raw_text": "Patients with bone metastases as the only site(s) of measurable disease"
        }
      },
      "OR": {
        "left": {
          "raw_text": "Patients with hepatic artery chemoembolization within the last 6 months"
        },
        "right": {
          "AND": {
            "left": {
              "raw_text": "(one month if there are other sites of measurable disease)"
            }
          }
        }
      },
      "OR": {
        "left": {
          "raw_text": "Patients who have been previously treated with radioactive directed therapies"
        }
      },
      "OR": {
        "left": {
          "raw_text": "Patients who have been previously treated with epothilone"
        }
      },
      "OR": {
        "left": {
          "OR": {
            "left": {
              "raw_text": "Patients with any peripheral neuropathy"
            },
            "right": {
              "raw_text": "or unresolved diarrhea greater than Grade 1"
            }
          }
        }
      },
      "OR": {
        "left": {
          "AND": {
            "left": {
              "raw_text": "Patients with severe cardiac insufficiency"
            },
            "right": {
              "OR": {
                "left": {
                  "raw_text": "patients taking Coumadin"
                },
                "right": {
                  "AND": {
                    "left": {
                      "raw_text": "or other warfarin-containing agents"
                    },
                    "right": {
                      "NOT": {
                        "left": {
                          "OR": {
                            "left": {
                              "raw_text": "with the exception of low dose"
                            },
                            "right": {
                              "AND": {
                                "left": {
                                  "raw_text": "warfarin (1 mg or less)"
                                },
                                "right": {
                                  "OR": {
                                    "left": {
                                      "raw_text": "for the maintenance of in-dwelling lines"
                                    },
                                    "right": {
                                      "raw_text": "or ports"
                                    }
                                  }
                                }
                              }
                            }
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "OR": {
          "left": {
            "AND": {
              "left": {
                "raw_text": "Patients taking any experimental therapies"
              },
              "right": {
                "OR": {
                  "left": {
                    "raw_text": "history of another malignancy"
                  },
                  "right": {
                    "AND": {
                      "left": {
                        "raw_text": "within 5 years prior to study entry"
                      },
                      "right": {
                        "NOT": {
                          "left": {
                            "OR": {
                              "left": {
                                "raw_text": "except curatively treated non-melanoma skin cancer"
                              },
                              "right": {
                                "OR": {
                                  "left": {
                                    "raw_text": ", prostate cancer"
                                  },
                                  "right": {
                                    "raw_text": ", or cervical cancer in situ"
                                  }
                                }
                              }
                            }
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "OR": {
            "left": {
              "OR": {
                "left": {
                  "raw_text": "Patients with active or suspected acute or chronic uncontrolled infection"
                },
                "right": {
                  "raw_text": "including abcesses or fistulae"
                }
              }
            }
          },
          "OR": {
            "left": {
              "AND": {
                "left": {
                  "raw_text": "Patients with a medical or psychiatric illness"
                },
                "right": {
                  "OR": {
                    "left": {
                      "raw_text": "that would preclude study or informed consent"
                    },
                    "right": {
                      "OR": {
                        "left": {
                          "raw_text": "and/or history of noncompliance to medical regimens"
                        },
                        "right": {
                          "OR": {
                            "left": {
                              "raw_text": "or inability or unwillingness to return for all scheduled visits"
                            }
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "OR": {
            "left": {
              "raw_text": "HIV+ patients"
            }
          },
          "OR": {
            "left": {
              "OR": {
                "left": {
                  "raw_text": "Pregnant"
                },
                "right": {
                  "raw_text": "or lactating females."
                }
              }
            }
          }
        }
      }
    }
  }
}