{
  "AND": {
    "left": {
      "AND": {
        "left": {
          "raw_text": "Heart Team assessment of operability"
        },
        "right": {
          "raw_text": "(the heart team considers the patient to be a good surgical candidate)."
        }
      }
    },
    "right": {
      "AND": {
        "left": {
          "OR": {
            "left": {
              "raw_text": "Evidence of an acute myocardial infarction"
            },
            "right": {
              "raw_text": "= 1 month (30 days) before the intended treatment [defined as: Q wave MI, or non-Q wave MI with total CK elevation of CK-MB = twice normal in the presence of MB elevation and/or troponin level elevation (WHO definition)]."
            }
          }
        },
        "right": {
          "AND": {
            "left": {
              "OR": {
                "left": {
                  "raw_text": "Untreated, severe, left sided valvular heart disease"
                },
                "right": {
                  "OR": {
                    "left": {
                      "raw_text": "including mitral regurgitation or stenosis, and aortic regurgitation or stenosis."
                    }
                  }
                }
              }
            },
            "right": {
              "AND": {
                "left": {
                  "OR": {
                    "left": {
                      "raw_text": "Mean pulmonary artery pressures =40mmHG and PVR >4 woods units as assessed by right heart catheterization."
                    }
                  }
                },
                "right": {
                  "AND": {
                    "left": {
                      "OR": {
                        "left": {
                          "raw_text": "Any therapeutic invasive cardiac procedure resulting in a permanent implant"
                        },
                        "right": {
                          "raw_text": "that is performed within 30 days of the index procedure. Examples of permanent implant would include any new heart valve. Implantation of a permanent pacemaker is excluded."
                        }
                      }
                    },
                    "right": {
                      "AND": {
                        "left": {
                          "OR": {
                            "left": {
                              "raw_text": "Patients with planned concomitant surgical or transcatheter ablation for Atrial Fibrillation."
                            }
                          }
                        },
                        "right": {
                          "AND": {
                            "left": {
                              "OR": {
                                "left": {
                                  "raw_text": "Leukopenia (WBC < 3000 cell/mL), acute anemia (Hgb < 9 g/dL), Thrombocytopenia (Plt < 50,000 cell/mL)."
                                }
                              }
                            },
                            "right": {
                              "AND": {
                                "left": {
                                  "OR": {
                                    "left": {
                                      "raw_text": "Hemodynamic or respiratory instability requiring inotropic support, mechanical ventilation or mechanical heart assistance within 30 days of screening evaluation."
                                    }
                                  }
                                },
                                "right": {
                                  "AND": {
                                    "left": {
                                      "OR": {
                                        "left": {
                                          "raw_text": "Need for emergency surgery for any reason."
                                        }
                                      }
                                    },
                                    "right": {
                                      "AND": {
                                        "left": {
                                          "OR": {
                                            "left": {
                                              "raw_text": "Left ventricular ejection fraction <40%."
                                            }
                                          }
                                        },
                                        "right": {
                                          "AND": {
                                            "left": {
                                              "OR": {
                                                "left": {
                                                  "raw_text": "Echocardiographic evidence of intracardiac mass, thrombus or vegetation."
                                                }
                                              }
                                            }
                                          }
                                        }
                                      }
                                    }
                                  }
                                }
                              }
                            }
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}