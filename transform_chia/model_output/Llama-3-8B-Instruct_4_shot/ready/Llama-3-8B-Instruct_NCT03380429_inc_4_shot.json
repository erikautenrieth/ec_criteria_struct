{
  "AND": {
    "left": {
      "AND": {
        "left": {
          "OR": {
            "left": {
              "raw_text": "Subjects aged 18 years or older"
            },
            "right": {
              "raw_text": "at the time of signing the informed consent."
            }
          }
        },
        "right": {
          "AND": {
            "left": {
              "OR": {
                "left": {
                  "raw_text": "Subjects with documented physician diagnosis of asthma"
                },
                "right": {
                  "raw_text": "as their primary respiratory disease."
                }
              }
            },
            "right": {
              "AND": {
                "left": {
                  "raw_text": "ACT score <20 at screening visit."
                },
                "right": {
                  "AND": {
                    "left": {
                      "OR": {
                        "left": {
                          "raw_text": "Non-smokers (never smoked or not smoking for >6 months with <10 pack years history"
                        },
                        "right": {
                          "raw_text": "(Pack years = [cigarettes per day smoked/20] multiplied by number of years smoked)."
                        }
                      }
                    },
                    "right": {
                      "AND": {
                        "left": {
                          "OR": {
                            "left": {
                              "raw_text": "Male or female subjects will be included."
                            },
                            "right": {
                              "OR": {
                                "left": {
                                  "raw_text": "A female subject is eligible to participate if she is not pregnant, not breastfeeding, and at least one of the following conditions applies:"
                                },
                                "right": {
                                  "OR": {
                                    "left": {
                                      "raw_text": "(i) Not a woman of childbearing potential (WOCBP)."
                                    },
                                    "right": {
                                      "OR": {
                                        "left": {
                                          "raw_text": "(ii) A WOCBP who agrees to follow the contraceptive guidance during the treatment period and for at least 5 days] after the last dose of study treatment."
                                        }
                                      }
                                    }
                                  }
                                }
                              }
                            }
                          },
                          "right": {
                            "AND": {
                              "left": {
                                "raw_text": "Capable of giving signed informed consent which includes compliance with the requirements and restrictions listed in the consent form and protocol."
                              },
                              "right": {
                                "AND": {
                                  "left": {
                                    "raw_text": "Subject understands and is willing, able, and likely to comply with study procedures and restrictions."
                                  },
                                  "right": {
                                    "AND": {
                                      "left": {
                                        "raw_text": "Subject must be able to read in a language supported by the smart phone app in their region."
                                      },
                                      "right": {
                                        "AND": {
                                          "left": {
                                            "raw_text": "Subject must have been on maintenance therapy (Fixed dose combination ICS/LABA) for 3 months, cannot have changed dose in the month prior to screening and be able to change to an equivalent dose of RELVAR/BREO for the duration of the study."
                                          },
                                          "right": {
                                            "AND": {
                                              "left": {
                                                "raw_text": "Other background asthma medication such as anti-leukotrienes and oral corticosteroids are permitted provided the dose has been stable for 1 month prior to screening."
                                              },
                                              "right": {
                                                "AND": {
                                                  "left": {
                                                    "raw_text": "Subject must be able to change to Salbutamol/Albuterol MDI rescue for the duration of the study and judged capable of withholding albuterol/salbutamol for at least 6 hours prior to study visits."
                                                  },
                                                  "right": {
                                                    "AND": {
                                                      "left": {
                                                        "raw_text": "Subject must have their own Android or iPhone operating system (IOS) smart phone and a data package suitable for the installation and running of the app and sending and receiving data."
                                                      },
                                                      "right": {
                                                        "AND": {
                                                          "left": {
                                                            "raw_text": "Data used by the CIS is approximately 1 megabyte (MB) per month as a maximum; this is less data than a 1 minute video streamed from YouTube (2MB)."
                                                          },
                                                          "right": {
                                                            "AND": {
                                                              "left": {
                                                                "raw_text": "Subjects must be willing and able to download the app on their personal smart phone and keep it turned on for the duration of the study."
                                                              },
                                                              "right": {
                                                                "AND": {
                                                                  "left": {
                                                                    "raw_text": "This will also require Bluetooth to be turned on for duration of the study."
                                                                  },
                                                                  "right": {
                                                                    "AND": {
                                                                      "left": {
                                                                        "raw_text": "Subjects will also have to turn on mobile data for the app for the duration of study; unless travelling and when extra data roaming costs could be incurred."
                                                                      }
                                                                    }
                                                                  }
                                                                }
                                                              }
                                                            }
                                                          }
                                                        }
                                                      }
                                                    }
                                                  }
                                                }
                                              }
                                            }
                                          }
                                        }
                                      }
                                    }
                                  }
                                }
                              }
                            }
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "right": {
      "AND": {
        "left": {
          "raw_text": "ACT score <20 at randomization visit (visit 2)."
