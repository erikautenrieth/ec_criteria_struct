{
  "AND": {
    "left": {
      "OR": {
        "left": {
          "raw_text": "Patients with symptomatic CNS metastases"
        },
        "right": {
          "raw_text": "or leptomeningeal involvement"
        }
      }
    },
    "right": {
      "AND": {
        "left": {
          "AND": {
            "left": {
              "raw_text": "Patients with known brain metastases"
            },
            "right": {
              "NOT": {
                "left": {
                  "OR": {
                    "left": {
                      "raw_text": "unless these metastases have been treated"
                    },
                    "right": {
                      "AND": {
                        "left": {
                          "raw_text": "and/or have been stable for at least six months prior to study start."
                        },
                        "right": {
                          "raw_text": "Subjects with a history of brain metastases must have a head CT with contrast to document either response or progression."
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "right": {
            "AND": {
              "left": {
                "raw_text": "Patients with bone metastases as the only site(s) of measurable disease"
              },
              "right": {
                "OR": {
                  "left": {
                    "raw_text": "Patients with hepatic artery chemoembolization within the last 6 months"
                  },
                  "right": {
                    "AND": {
                      "left": {
                        "raw_text": "(one month if there are other sites of measurable disease)"
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "right": {
          "AND": {
            "left": {
              "OR": {
                "left": {
                  "raw_text": "Patients who have been previously treated with radioactive directed therapies"
                },
                "right": {
                  "raw_text": "Patients who have been previously treated with epothilone"
                }
              }
            },
            "right": {
              "AND": {
                "left": {
                  "OR": {
                    "left": {
                      "raw_text": "Patients with any peripheral neuropathy"
                    },
                    "right": {
                      "AND": {
                        "left": {
                          "raw_text": "or unresolved diarrhea greater than Grade 1"
                        }
                      }
                    }
                  }
                },
                "right": {
                  "AND": {
                    "left": {
                      "raw_text": "Patients with severe cardiac insufficiency"
                    },
                    "right": {
                      "OR": {
                        "left": {
                          "raw_text": "patients taking Coumadin"
                        },
                        "right": {
                          "AND": {
                            "left": {
                              "raw_text": "or other warfarin-containing agents"
                            },
                            "right": {
                              "NOT": {
                                "left": {
                                  "OR": {
                                    "left": {
                                      "raw_text": "with the exception of low dose warfarin (1 mg or less)"
                                    },
                                    "right": {
                                      "OR": {
                                        "left": {
                                          "raw_text": "for the maintenance of in-dwelling lines"
                                        },
                                        "right": {
                                          "raw_text": "or ports"
                                        }
                                      }
                                    }
                                  }
                                }
                              }
                            }
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
