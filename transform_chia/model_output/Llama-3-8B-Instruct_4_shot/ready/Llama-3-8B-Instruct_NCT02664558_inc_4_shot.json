{
  "AND": {
    "left": {
      "OR": {
        "left": {
          "raw_text": "Male"
        },
        "right": {
          "raw_text": "or female"
        }
      }
    },
    "right": {
      "AND": {
        "left": {
          "raw_text": "Has a diagnosis of WHO Group 1 PAH"
        },
        "right": {
          "AND": {
            "left": {
              "raw_text": "Right heart catheterization performed at Screening with results that are:"
            },
            "right": {
              "AND": {
                "left": {
                  "AND": {
                    "left": {
                      "raw_text": "Mean pulmonary arterial pressure ≥25 mmHg"
                    },
                    "right": {
                      "raw_text": "(at rest) and"
                    }
                  },
                  "right": {
                    "AND": {
                      "left": {
                        "raw_text": "Pulmonary venous hypertension (measured as pulmonary capillary wedge pressure (PCWP) ≤15 mmHg"
                      },
                      "right": {
                        "OR": {
                          "left": {
                            "raw_text": "If PCWP is not available, then mean left atrial pressure or left ventricular end-diastolic pressure ≤15 mmHg"
                          },
                          "right": {
                            "raw_text": "in the absence of left atrial obstruction."
                          }
                        }
                      }
                    }
                  }
                },
                "right": {
                  "AND": {
                    "left": {
                      "raw_text": "Pulmonary vascular resistance (PVR) ≥300 dyn•s/cm5"
                    },
                    "right": {
                      "raw_text": "(3.75 Wood units)"
                    }
                  }
                }
              }
            }
          }
        },
        "right": {
          "AND": {
            "left": {
              "OR": {
                "left": {
                  "raw_text": "Has WHO/NYHA-FC of II"
                },
                "right": {
                  "raw_text": "or III"
                }
              }
            },
            "right": {
              "AND": {
                "left": {
                  "raw_text": "Be on stable dose of at least one of the following PAH-specific therapies:"
                },
                "right": {
                  "OR": {
                    "left": {
                      "raw_text": "endothelin receptor antagonist"
                    },
                    "right": {
                      "OR": {
                        "left": {
                          "raw_text": "an agent acting on the nitric oxide pathway (phosphodiesterase type 5 inhibitor or soluble guanylate cyclase stimulator)"
                        },
                        "right": {
                          "OR": {
                            "left": {
                              "raw_text": "and/or a prostacyclin or prostacyclin analog"
                            }
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "AND": {
    "left": {
      "AND": {
        "left": {
          "raw_text": "Has a 6-minute walk distance that is ≥150 and ≤500 meters"
        }
      }
    },
    "right": {
      "AND": {
        "left": {
          "raw_text": "Have a ventilation-perfusion scan that rules out thromboembolic disease"
        }
      }
    }
  }
}