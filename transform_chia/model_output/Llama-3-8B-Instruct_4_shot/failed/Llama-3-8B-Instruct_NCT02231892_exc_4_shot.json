"{\n  \"AND\": {\n    \"left\": {\n      \"OR\": {\n        \"left\": {\n          \"AND\": {\n            \"left\": {\n              \"raw_text\": \"Personal history of stroke, brain lesions, previous neurosurgery, any personal history of seizure or fainting episode of unknown cause, or head trauma resulting in loss of consciousness, lasting over 30 minutes or with sequela lasting longer than two days.\"\n            },\n            \"right\": {\n              \"raw_text\": \"Justification: Stroke or head trauma can lower the seizure threshold, and are therefore contra-indications for TMS. Fainting episodes or syncope of unknown cause could indicate an undiagnosed condition associated with seizures.\"\n            }\n          }\n        },\n        \"right\": {\n          \"AND\": {\n            \"left\": {\n              \"raw_text\": \"Screening tool: TMS adult safety questionnaire, Medical History.\"\n            }\n          }\n        }\n      }\n    },\n    \"right\": {\n      \"OR\": {\n        \"left\": {\n          \"AND\": {\n            \"left\": {\n              \"raw_text\": \"First-degree family history of any neurological disorder with a potentially hereditary basis, including migraines, epilepsy, or multiple sclerosis.\"\n            },\n            \"right\": {\n              \"raw_text\": \"Justification: Neurological disorders can lower the seizure threshold, and are therefore contra-indications for TMS. First-degree family history of certain neurological disorders with a hereditary component increases the risk of the subject having an undiagnosed condition that is associated with lowered seizure threshold.\"\n            }\n          }\n        },\n        \"right\": {\n          \"AND\": {\n            \"left\": {\n              \"raw_text\": \"Screening tool: TMS adult safety screening, Medical History.\"\n            }\n          }\n        }\n      }\n    }\n  }\n}\n{\n  \"AND\": {\n    \"left\": {\n      \"OR\": {\n        \"left\": {\n          \"AND\": {\n            \"left\": {\n              \"raw_text\": \"Cardiac pacemakers, neural stimulators, implantable defibrillator, implanted medication pumps, intracardiac lines, or acute, unstable cardiac disease, with intracranial implants (e.g. aneurysm clips, shunts, stimulators, cochlear implants, or electrodes) or any other metal object within or near the head that precludes MRI scanning.\"\n            },\n            \"right\": {\n              \"raw_text\": \"Justification: Any metal around the head is a contraindication for both MRI and TMS, as both methods involve exposure to a relatively strong magnetic field.\"\n            }\n          }\n        },\n        \"right\": {\n          \"AND\": {\n            \"left\": {\n              \"raw_text\": \"Screening tool: TMS adult safety screening, MRI safety screening, Medical History.\"\n            }\n          }\n        }\n      }\n    },\n    \"right\": {\n      \"OR\": {\n        \"left\": {\n          \"AND\": {\n            \"left\": {\n              \"raw_text\": \"Noise-induced hearing loss or tinnitus.\"\n            },\n            \"right\": {\n              \"raw_text\": \"Justification: individuals with noise-induced hearing problems may be particularly vulnerable to the acoustic noise generated by TMS and MRI equipment.\"\n            }\n          }\n        },\n        \"right\": {\n          \"AND\": {\n            \"left\": {\n              \"raw_text\": \"Screening tools: TMS adult safety screening.\"\n            }\n          }\n        }\n      }\n    }\n  }\n}\n{\n  \"AND\": {\n    \"left\": {\n      \"OR\": {\n        \"left\": {\n          \"AND\": {\n            \"left\": {\n              \"raw_text\": \"Current use (any use in the past 4 weeks, chronic use within 6 past six months) of any investigational drug or of any medications with psychotropic, anti or pro-convulsive action.\"\n            },\n            \"right\": {\n              \"raw_text\": \"Justification: The use of certain medications or drugs can lower seizure threshold and is therefore contra-indicated for TMS.\"\n            }\n          }\n        },\n        \"right\": {\n          \"AND\": {\n            \"left\": {\n              \"raw_text\": \"Screening tools: MRI safety screening questionnaire, Medical history, Medical Assessments: Urine toxicology analyzes for presence of a broad range of prescription and nonprescription drugs.\"\n            }\n          }\n        }\n      }\n    },\n    \"right\": {\n      \"OR\": {\n        \"left\": {\n          \"AND\": {\n            \"left\": {\n              \"raw_text\": \"Lifetime history of major depressive disorder, schizophrenia, bipolar disorder, mania, or hypomania.\"\n            },\n            \"right\": {\n              \"raw_text\": \"Justification: The population of interest here is a healthy control population with no psychiatric disorders. In subjects with depression, bipolar disorder, mania or hypomania, there is a small chance that TMS can trigger (hypo)manic symptoms.\"\n            }\n          }\n        },\n        \"right\": {\n          \"AND\": {\n            \"left\": {\n              \"raw_text\": \"Screening tools: SCID Screen Patient Questionnaire. Potential diagnoses will be further evaluated by a counsellor.\"\n            }\n          }\n        }\n      }\n    }\n  }\n}\n{\n  \"AND\": {\n    \"left\": {\n      \"OR\": {\n        \"left\": {\n          \"AND\": {\n            \"left\": {\n              \"raw_text\": \"Meet current DSM V criteria for moderate to severe substance use disorder (excluding nicotine), smoke daily, or urine toxicology positive for any illicit substance inconsistent with history given.\"\n            },\n            \"right\": {\n              \"raw_text\": \"Justification: The population of interest here is a healthy control population with no substance use disorder. Current use of illicit substances could impact on seizure threshold and is therefore contra-indicated for TMS.\"\n            }\n          }\n        },\n        \"right\": {\n          \"AND\": {\n            \"left\": {\n              \"raw_text\": \"Screening tools: SCID Screen Patient Questionnaire. Potential diagnoses will be further evaluated by a counsellor, Drug Use Survey (DUS), Substance Use Disorder Evaluation, Medical Assessments: urine qualitative drug screen is performed for methadone, benzodiazepines, cocaine, amphetamine/methamphetamine, opiates, barbiturates, and tetrahydrocannabinol.\"\n            }\n          }\n        }\n      }\n    },\n    \"right\": {\n      \"OR\": {\n        \"left\": {\n          \"AND\": {\n            \"left\": {\n              \"raw_text\": \"Have met DSM V criteria for moderate to severe substance use disorder (excluding nicotine, alcohol and cannabis) in the past, or have met DSM V criteria for moderate to severe substance use disorder for cannabis or alcohol in the past 5 years.\"\n            },\n            \"right\": {\n              \"raw_text\": \"Justification: the population of interest here is a healthy control population with no present or past substance use disorder.\"\n            }\n          }\n        },\n        \"right\": {\n          \"AND\": {\n            \"left\": {\n              \"raw_text\": \"Screening tools: SCID Screen Patient Questionnaire. Potential diagnoses will be further evaluated by a counselor. Drug Use Survey (DUS), Substance Use Disorder Evaluation.\"\n            }\n          }\n        }\n      }\n    }\n  }\n}\n{\n  \"AND\": {\n    \"left\": {\n      \"OR\": {\n        \"left\": {\n          \"AND\": {\n            \"left\": {\n              \"raw_text\": \"History of myocardial infarction, angina, congestive heart failure, cardiomyopathy, stroke or transient ischemic attack, or any heart condition currently under medical care.\"\n            },\n            \"right\": {\n              \"raw_text\": \"Justification: the risk of TMS for individuals with a heart condition is unknown.\"\n            }\n          }\n        },\n        \"right\": {\n          \"AND\": {\n            \"left\": {\n              \"raw_text\": \"Screening tool: physical assessment (EKG), medical history.\"\n            }\n          }\n        }\n      }\n    },\n    \"right\": {\n      \"OR\": {\n        \"left\": {\n          \"AND\": {\n            \"left\": {\n              \"raw_text\": \"Pregnant women or women with reproductive potential who are sexually active and not using an acceptable form of contraception.\"\n            },\n            \"right\": {\n              \"raw_text\": \"Justification: it is unknown whether