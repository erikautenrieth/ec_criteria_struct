{
  "AND": {
    "left": {
      "AND": {
        "left": {
          "OR": {
            "left": {
              "raw_text": "Unresectable, histologically confirmed hepatocellular carcinoma"
            },
            "right": {
              "raw_text": "with evident disease limited to liver."
            }
          }
        },
        "right": {
          "AND": {
            "left": {
              "raw_text": "Tissue from tumor must be available."
            },
            "right": {
              "AND": {
                "left": {
                  "OR": {
                    "left": {
                      "raw_text": "This may be paraffin embedded tissue from previous biopsy/resection"
                    },
                    "right": {
                      "OR": {
                        "left": {
                          "raw_text": "or if it is not available, a repeat biopsy must be performed."
                        },
                        "right": {
                          "AND": {
                            "left": {
                              "raw_text": "The requirement for biopsy may be waived if alpha-fetoprotein is greater than 500 ng/mL"
                            },
                            "right": {
                              "OR": {
                                "left": {
                                  "raw_text": "and in the investigators opinion not explained by a concurrent hepatic inflammatory process."
                                }
                              }
                            }
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "right": {
      "AND": {
        "left": {
          "AND": {
            "left": {
              "raw_text": "Patients must agree to have a 20 cc blood sample drawn in addition to routine labs with each cycle of chemotherapy."
            },
            "right": {
              "AND": {
                "left": {
                  "OR": {
                    "left": {
                      "raw_text": "Patients must have measurable disease."
                    },
                    "right": {
                      "AND": {
                        "left": {
                          "raw_text": "If prior radiation therapy was administered, measurable disease must be outside the radiation field."
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "right": {
          "AND": {
            "left": {
              "OR": {
                "left": {
                  "raw_text": "Patients must have a Zubrod performance status of 0-2."
                },
                "right": {
                  "OR": {
                    "left": {
                      "raw_text": "Patients must have a predicted life expectancy of at least 12 weeks."
                    },
                    "right": {
                      "AND": {
                        "left": {
                          "OR": {
                            "left": {
                              "raw_text": "Patients must have a pre-treatment granulocyte count (i.e., segmented neutrophils + bands) of greater than or equal to 1,500/mm3"
                            },
                            "right": {
                              "OR": {
                                "left": {
                                  "raw_text": "a hemoglobin level of greater than or equal to 9 gm/dl"
                                },
                                "right": {
                                  "OR": {
                                    "left": {
                                      "raw_text": "and platelet count greater than or equal to 50,000/mm3."
                                    }
                                  }
                                }
                              }
                            }
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
