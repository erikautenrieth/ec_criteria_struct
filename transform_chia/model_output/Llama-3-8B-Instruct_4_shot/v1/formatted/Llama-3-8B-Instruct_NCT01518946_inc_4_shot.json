        "left": {
          "OR": {
            "left": {
              "raw_text": "Male"
            },
            "right": {
              "raw_text": "and female subjects"
            }
          }
        },
        "right": {
          "AND": {
            "left": {
              "raw_text": "must be 18 years of age or older"
            },
            "right": {
              "raw_text": "and ambulatory."
            }
          }
        }
      },
      "right": {
        "AND": {
          "left": {
            "OR": {
              "left": {
                "raw_text": "Females of child-bearing potential (FOCP)"
                },
                "right": {
                  "AND": {
                    "left": {
                      "raw_text": "must have a negative serum beta human chorionic gonadotropin (HCG) pregnancy test."
                    }
                  }
                }
              }
            },
            "right": {
              "AND": {
                "left": {
                  "raw_text": "A documented history of severe Symptomatic Orthostatic Hypotension (SOH)"
                },
                "right": {
                  "AND": {
                    "left": {
                      "raw_text": "that, in the judgment of the treating physician, has required treatment with midodrine HCl,"
                    },
                    "right": {
                      "AND": {
                        "left": {
                          "raw_text": "and has been at a stable dose for at least 3 months."
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "right": {
      "AND": {
        "left": {
          "AND": {
            "left": {
              "raw_text": "The subject has manifested at least 1 of the following symptoms while standing"
            },
            "right": {
              "OR": {
                "left": {
                  "raw_text": "or had a medical history of 1 of the following when not treated for orthostatic hypotension (OH):"
                },
                "right": {
                  "OR": {
                    "left": {
                      "raw_text": "dizziness,"
                    },
                    "right": {
                      "OR": {
                        "left": {
                          "raw_text": "lightheadedness,"
                        },
                        "right": {
                          "OR": {
                            "left": {
                              "raw_text": "feeling faint,"
                            },
                            "right": {
                              "OR": {
                                "left": {
                                  "raw_text": "or feeling like they might black out."
                                }
                              }
                            }
                          }
                        }
                      }
                    }
                  }
