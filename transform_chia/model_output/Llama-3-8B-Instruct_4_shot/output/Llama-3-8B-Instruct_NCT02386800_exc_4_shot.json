"{\n  \"AND\": {\n    \"left\": {\n      \"AND\": {\n        \"left\": {\n          \"raw_text\": \"Patient has participated in a combination trial\"\n        },\n        \"right\": {\n          \"AND\": {\n            \"left\": {\n              \"raw_text\": \"where ruxolitinib was dispensed in combination with another study medication\"\n            },\n            \"right\": {\n              \"raw_text\": \"and the patient is still receiving combination therapy.\"\n            }\n          }\n        }\n      },\n    },\n    \"right\": {\n      \"OR\": {\n        \"left\": {\n          \"OR\": {\n            \"left\": {\n              \"raw_text\": \"Pregnant\"\n            },\n            \"right\": {\n              \"raw_text\": \"or nursing (lactating) women\"\n            }\n          },\n          \"right\": {\n            \"raw_text\": \", where pregnancy is defined as the state of a female after conception and until the termination of gestation, confirmed by a positive hCG laboratory test.\"\n          }\n        },\n        \"right\": {\n          \"AND\": {\n            \"left\": {\n              \"raw_text\": \"Women of child-bearing potential, defined as all women physiologically capable of becoming pregnant\"\n            },\n            \"right\": {\n              \"NOT\": {\n                \"left\": {\n                  \"OR\": {\n                    \"left\": {\n                      \"raw_text\": \"unless they are using highly effective methods of contraception throughout the study duration inclusive of the 30-day safety follow up.\"\n                    }\n                  }\n                }\n              }\n            }\n          }\n        }\n      }\n    }\n  }\n}"