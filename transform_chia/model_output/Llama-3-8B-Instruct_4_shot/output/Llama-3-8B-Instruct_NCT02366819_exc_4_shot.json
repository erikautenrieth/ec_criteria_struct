"{\n  \"AND\": {\n    \"left\": {\n      \"OR\": {\n        \"left\": {\n          \"raw_text\": \"Previous or concurrent malignancy\"\n        },\n        \"right\": {\n          \"NOT\": {\n            \"left\": {\n              \"OR\": {\n                \"left\": {\n                  \"raw_text\": \"except for adequately treated basal cell\"\n                },\n                \"right\": {\n                  \"OR\": {\n                    \"left\": {\n                      \"raw_text\": \"or squamous cell skin cancer\"\n                    },\n                    \"right\": {\n                      \"OR\": {\n                        \"left\": {\n                          \"raw_text\": \", in situ cervical cancer\"\n                        },\n                        \"right\": {\n                          \"OR\": {\n                            \"left\": {\n                              \"raw_text\": \", or any other cancer for which the patient has been previously treated and the lifetime recurrence risk is less than 30%\"\n                            }\n                          }\n                        }\n                      }\n                    }\n                  }\n                }\n              }\n            }\n          }\n        }\n      }\n    },\n    \"right\": {\n      \"AND\": {\n        \"left\": {\n          \"OR\": {\n            \"left\": {\n              \"raw_text\": \"Inflammatory bowel disease that is uncontrolled or on active treatment\"\n            },\n            \"right\": {\n              \"raw_text\": \"(Crohn's disease, ulcerative colitis)\"\n            }\n          }\n        },\n        \"right\": {\n          \"AND\": {\n            \"left\": {\n              \"OR\": {\n                \"left\": {\n                  \"raw_text\": \"Diarrhea, grade 1 or greater\"\n                },\n                \"right\": {\n                  \"raw_text\": \"by the National Cancer Institute Common Terminology Criteria for Adverse E