{
  "AND": {
    "left": {
      "AND": {
        "left": {
          "AND": {
            "left": {
              "AND": {
                "left": {
                  "AND": {
                    "left": {
                      "AND": {
                        "left": {
                          "AND": {
                            "left": {
                              "raw_text": "Subject must have a diagnosis of COPD"
                            },
                            "right": {
                              "raw_text": "based on the American Thoracic Society (ATS)/ European Respiratory Society (ERS) criteria."
                            }
                          }
                        },
                        "right": {
                          "OR": {
                            "left": {
                              "raw_text": "Male"
                            },
                            "right": {
                              "OR": {
                                "left": {
                                  "raw_text": "or female subjects"
                                },
                                "right": {
                                  "AND": {
                                    "left": {
                                      "raw_text": "aged >=40 years"
                                    },
                                    "right": {
                                      "OR": {
                                        "left": {
                                          "raw_text": "Females must be of Non Child Bearing Potential"
                                        },
                                        "right": {
                                          "AND": {
                                            "left": {
                                              "raw_text": "The definition of Non Child Bearing Potential is as following:"
                                            },
                                            "right": {
                                              "AND": {
                                                "left": {
                                                  "raw_text": "Females, regardless of their age"
                                                },
                                                "right": {
                                                  "OR": {
                                                    "left": {
                                                      "raw_text": "with functioning ovaries"
                                                    },
                                                    "right": {
                                                      "AND": {
                                                        "left": {
                                                          "raw_text": "and who have a current documented tubal ligation"
                                                        },
                                                        "right": {
                                                          "OR": {
                                                            "left": {
                                                              "raw_text": "or hysterectomy"
                                                            },
                                                            "right": {
                                                              "OR": {
                                                                "left": {
                                                                  "raw_text": ", or females who are post-menopausal"
                                                                  }
                                                              }
                                                            }
                                                          }
                                                        }
                                                      }
                                                    }
                                                  }
                                                }
                                              }
                                            }
                                          }
                                        }
                                      }
                                    }
                                  }
                                }
                              }
                            }
                          }
                        }
                      }
                    },
                    "right": {
                      "AND": {
                        "left": {
                          "raw_text": "Have diagnosed COPD stage III or IV according to GOLD criteria:"
                        },
                        "right": {
                          "AND": {
                            "left": {
                              "raw_text": "a baseline post-bronchodilator Forced Expiratory Volume, measured at 1 second (FEV1) <50% of predicted normal"
                            },
                            "right": {
                              "AND": {
                                "left": {
                                  "raw_text": "and a baseline post-bronchodilator FEV1/Inspiratory Vital Capacity (IVC) ratio <70%"
                                }
                              }
                            }
                          }
                        }
                      }
                    }
                  }
                },
                "right": {
                  "AND": {
                    "left": {
                      "raw_text": "Have experienced at least 2 moderate or severe COPD exacerbations leading to medical consultation"
                    },
                    "right": {
                      "raw_text": "(requiring oral corticosteroids or increasing dosage of oral corticosteroids and/or antibiotics or hospitalization) within the 12 months preceding Visit 1."
                    }
                  }
                }
              }
            },
            "right": {
              "AND": {
                "left": {
                  "raw_text": "Have stable COPD medication within 4 weeks prior to Visit 1"
                },
                "right": {
                  "raw_text": "(no new medication added and no dosage changes in medication)."
                }
              }
            }
          }
        },
        "right": {
          "OR": {
            "left": {
              "raw_text": "Current or ex-smokers"
            },
            "right": {
              "AND": {
                "left": {
                  "raw_text": "with a smoking history of at least 10 pack years"
                },
                "right": {
                  "raw_text": "(number of pack years = [number of cigarettes per day / 20] x number of years smoked, e.g., 20 cigarettes per day for 10 years, or 10 cigarettes per day for 20 years)."
                }
              }
            }
          }
        }
      }
    },
    "right": {
      "AND": {
        "left": {
          "raw_text": "Are currently managed at home (outpatients), are ambulatory and able to travel to the clinic."
        },
        "right": {
          "raw_text": "Subjects can be treated with all relevant COPD medication. This includes vaccines, inhaled short-acting beta-2-agonists as needed, short-acting or long-acting anticholinergics (tiotropium), systemic beta-2-agonists, theophylline, mucolytics, antioxidants, beta-1-agonists (for cardiovascular indication), non-invasive ventilation, long term oxygen therapy and can have Cor Pulmonale."
        }
      }
    }
  }
}