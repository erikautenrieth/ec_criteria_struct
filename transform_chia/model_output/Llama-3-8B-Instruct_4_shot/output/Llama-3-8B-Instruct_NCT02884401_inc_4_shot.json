"{\n  \"AND\": {\n    \"left\": {\n      \"AND\": {\n        \"left\": {\n          \"AND\": {\n            \"left\": {\n              \"OR\": {\n                \"left\": {\n                  \"raw_text\": \"Participants must present a diagnosis of osteoporosis\"\n                },\n                \"right\": {\n                  \"AND\": {\n                    \"left\": {\n                      \"raw_text\": \"based on DXA measurement of the bone mineral density\"\n                    },\n                    \"right\": {\n                      \"AND\": {\n                        \"left\": {\n                          \"raw_text\": \"at the femur neck and/or total hip and/or lumbar spine\"\n                        },\n                        \"right\": {\n                          \"raw_text\": \"(T value 2.5 SD or more below the young female adult mean) within the past 24 months.\"\n                        }\n                      }\n                    }\n                  }\n                }\n              }\n            },\n            \"right\": {\n              \"AND\": {\n                \"left\": {\n                  \"NOT\": {\n                    \"left\": {\n                      \"OR\": {\n                        \"left\": {\n                          \"raw_text\": \"Not in treatment with anti-resorptive agents\"\n                        },\n                        \"right\": {\n                          \"raw_text\": \"(like bisphosphonates and denosumab) for more than 4 consecutive years, in order to reduce the risk of medication-related osteonecrosis of the jaws (Lo et al., 2010).\"\n                        }\n                      }\n                    }\n                  }\n                },\n                \"right\": {\n                  \"AND\": {\n                    \"left\": {\n                      \"raw_text\": \"= 50 years old.\"\n                    },\n                    \"right\": {\n                      \"AND\": {\n                        \"left\": {\n                          \"raw_text\": \"In self-reported menopause, defined as the permanent cessation of ovulation, for at least one year\"\n                        },\n                        \"right\": {\n                          \"raw_text\": \"(Soules et al., 2001).\"\n                        }\n                      }\n                    }\n                  }\n                }\n              }\n            }\n          }\n        },\n        \"right\": {\n          \"AND\": {\n            \"left\": {\n              \"AND\": {\n                \"left\": {\n                  \"AND\": {\n                    \"left\": {\n                      \"raw_text\": \"Edentulous area involving a maximum of two teeth\"\n                    },\n                    \"right\": {\n                      \"raw_text\": \"(wisdom teeth and second molars are excluded) and presenting at least one neighbouring tooth\"\n                    }\n                  },\n                  \"right\": {\n                    \"raw_text\": \"(e.g. gap in the area of a second premolar and first molar, with first premolar in place).\"\n                  }\n                },\n                \"right\": {\n                  \"AND\": {\n                    \"left\": {\n                      \"AND\": {\n                        \"left\": {\n                          \"raw_text\": \"Residual alveolar width = 4 mm\"\n                        },\n                        \"right\": {\n                          \"raw_text\": \"(Milinkovic and Cordaro, 2014), residual alveolar height >8 mm, enough inter-arch space for a crown\"\n                        }\n                      },\n                      \"right\": {\n                        \"raw_text\": \"(at least 5 mm) and a minimum distance of 7 mm from the adjacent teeth\"\n                      }\n                    }\n                  }\n                }\n              },\n              \"right\": {\n                \"AND\": {\n                  \"left\": {\n                    \"raw_text\": \"Possibility to restore a functional occlusion with a minimum of four occlusal units\"\n                  },\n                  \"right\": {\n                    \"raw_text\": \"(i.e. pairs of occluding posterior teeth).\"\n                  }\n                },\n                \"right\": {\n                  \"AND\": {\n                    \"left\": {\n                      \"raw_text\": \"Willingness to replace the missing tooth/teeth with dental implants\"\n                    },\n                    \"right\": {\n                      \"raw_text\": \"Registration with a GDP.\"\n                    }\n                  }\n                }\n              }\n            }\n          }\n        }\n      }\n    }\n  }\n}"