"{\n  \"AND\": {\n    \"left\": {\n      \"AND\": {\n        \"left\": {\n          \"OR\": {\n            \"left\": {\n              \"raw_text\": \"1. Be able to give valid informed consent\"\n            },\n            \"right\": {\n              \"AND\": {\n                \"left\": {\n                  \"AND\": {\n                    \"left\": {\n                      \"raw_text\": \"2. Be 18 55 years of age.\"\n                    },\n                    \"right\": {\n                      \"OR\": {\n                        \"left\": {\n                          \"raw_text\": \"1. Justification: Many neural processes change with age, and these changes could introduce unwanted variability in both behavioral and MRI signals. In addition, the risk of difficult-to-detect medical abnormalities such as silent cerebral infarcts increases with age.\"\n                        },\n                        \"right\": {\n                          \"raw_text\": \"2. Screening tool: History. Government-issued forms of identification (e.g. driver s license, birth certificate) will be required when participant appears to be out of age range.\"\n                        }\n                      }\n                    }\n                  }\n                },\n                \"right\": {\n                  \"AND\": {\n                    \"left\": {\n                      \"raw_text\": \"3. Be in good health.\"\n                    },\n                    \"right\": {\n                      \"OR\": {\n                        \"left\": {\n                          \"raw_text\": \"1. Justification: Many illnesses may alter neural functioning as well as fMRI signals.\"\n                        },\n                        \"right\": {\n                          \"raw_text\": \"2. Screening tools: Medical Assessment, Medical History and Physical Examination.\"\n                        }\n                      }\n                    }\n                  }\n                }\n              }\n            }\n          }\n        },\n        \"right\": {\n          \"AND\": {\n            \"left\": {\n              \"raw_text\": \"4. Right-handed.\"\n            },\n            \"right\": {\n              \"OR\": {\n                \"left\": {\n                  \"raw_text\": \"1. Justification: Using right-handed individuals will reduce variability in BOLD MRI data.\"\n                },\n                \"right\": {\n                  \"raw_text\": \"2. Screening tool: Edinburgh Handedness Inventory.\"\n                }\n              }\n            }\n          }\n        }\n      }\n    },\n    \"right\": {\n      \"AND\": {\n        \"left\": {\n          \"raw_text\": \"5. Estimated IQ greater than or equal to 85\"\n        },\n        \"right\": {\n          \"OR\": {\n            \"left\": {\n              \"raw_text\": \"1. Justification: Subjects must be able to perform a cognitively challenging task to a high standard.\"\n            },\n            \"right\": {\n              \"raw_text\": \"2. Screening tool: Wechsler Abbreviated Scale of Intelligence.\"\n            }\n          }\n        }\n      }\n    }\n  }\n}"