"{\n  \"OR\": {\n    \"left\": {\n      \"AND\": {\n        \"left\": {\n          \"raw_text\": \"Males\"\n        },\n        \"right\": {\n          \"raw_text\": \"or non-pregnant, non-nursing females\"\n        }\n      },\n      \"right\": {\n        \"AND\": {\n          \"left\": {\n            \"AND\": {\n              \"left\": {\n                \"raw_text\": \"between the ages of\"\n              },\n              \"right\": {\n                \"raw_text\": \"2-65 years\"\n              }\n            }\n          }\n        }\n      }\n    }\n  },\n  \"AND\": {\n    \"left\": {\n      \"OR\": {\n        \"left\": {\n          \"raw_text\": \"LTBI diagnosis as per Canadian TB Standards\"\n        },\n        \"right\": {\n          \"OR\": {\n            \"left\": {\n              \"raw_text\": \"using either the Tuberculin Skin Test (TST)\"\n            },\n            \"right\": {\n              \"raw_text\": \"or the Interferon Gamma Release Assay (IGRA)\"\n            }\n          }\n        }\n      }\n    },\n    \"right\": {\n      \"OR\": {\n        \"left\": {\n          \"AND\": {\n            \"left\": {\n              \"raw_text\": \"Children 2-5 years\"\n            },\n            \"right\": {\n              \"AND\": {\n                \"left\": {\n                  \"raw_text\": \"with negative TSTs\"\n                },\n                \"right\": {\n                  \"AND\": {\n                    \"left\": {\n                      \"raw_text\": \"who have been in close contact with a case of active TB disease recently\"\n                    }\n                  }\n                }\n              }\n            }\n          },\n          \"right\": {\n            \"AND\": {\n              \"left\": {\n                \"raw_text\": \"Able and willing to provide fully informed consent\"\n              },\n              \"right\": {\n                \"OR\": {\n                  \"left\": {\n                    \"raw_text\": \"or parent/guardian able to provide consent\"\n                  }\n                }\n              }\n            }\n          }\n        }\n      }\n    }\n  }\n}"