{
  "OR": [
    {
      "AND": {
        "left": {
          "raw_text": "Patients with stable"
        },
        "right": {
          "OR": [
            {
              "raw_text": "Canadian Cardiovascular Society 1, 2, 3 or 4"
            },
            {
              "raw_text": "or unstable"
            },
            {
              "OR": [
                {
                  "raw_text": "Braunwald class IB"
                },
                {
                  "raw_text": "IC"
                },
                {
                  "raw_text": "IIB"
                },
                {
                  "raw_text": "IIC"
                },
                {
                  "raw_text": "IIIB"
                },
                {
                  "raw_text": "IIIC"
                }
              ]
            }
          ]
        }
      },
      "right": {
        "AND": {
          "left": {
            "OR": [
              {
                "raw_text": "atypical chest pain"
              },
              {
                "raw_text": "or even those who are asymptomatic"
              }
            ]
          },
          "right": {
            "raw_text": "provided they have documented myocardial ischaemia"
          }
        }
      }
    },
    {
      "raw_text": "Patients who are eligible for coronary revascularization"
    },
    {
      "AND": {
        "left": {
          "raw_text": "At least 2 lesions"
        },
        "right": {
          "raw_text": "located in different vessels and in different territories"
        }
      },
      "right": {
        "raw_text": "potentially amenable to stent implantation"
      }
    },
    {
      "raw_text": "de novo native vessels"
    },
    {
      "AND": {
        "left": {
          "raw_text": "Multivessel disease"
        },
        "right": {
          "AND": {
            "left": {
              "raw_text": "with at least one significant stenosis"
            },
            "right": {
              "raw_text": "in LAD"
            }
          }
        }
      },
      "right": {
        "AND": {
          "left": {
            "raw_text": "with treatment of the lesion"
          },
          "right": {
            "raw_text": "in another major epicardial coronary artery"
          }
        }
      }
    },
    {
      "AND": {
        "left": {
          "raw_text": "Total occluded vessels"
        },
        "right": {
          "OR": [
            {
              "raw_text": "One total occluded major epicardial vessel"
            },
            {
              "raw_text": "or side branch"
            }
          ]
        }
      },
      "right": {
        "AND": {
          "left": {
            "raw_text": "can be included and targeted"
          },
          "right": {
            "raw_text": "as long as one other major vessel has a significant stenosis amenable for SA"
          }
        }
      }
    },
    {
      "raw_text": "provided the age of occlusion is less than one month"
    },
    {
      "raw_text": "e.g. recent instability, infarction with ECG changes in the area subtended by the occluded vessel"
    },
    {
      "AND": {
        "left": {
          "raw_text": "Patients with total occluded vessels of unknown duration"
        },
        "right": {
          "OR": [
            {
              "raw_text": "or existing longer than one month"
            },
            {
              "raw_text": "and a reference over 1.50 mm"
            }
          ]
        }
      },
      "right": {
        "raw_text": "should not be included"
      }
    },
    {
      "raw_text": "not even as a third or fourth vessel to be dilated"
    },
    {
      "raw_text": "Significant stenosis has been defined as a stenosis of more than 50%"
    },
    {
      "right": {
        "raw_text": "in luminal diameter"
      }
    },
    {
      "right": {
        "raw_text": "(in at least one view, on visual interpretation or preferably by QCA)"
      }
    },
    {
      "raw_text": "Left ventricular ejection fraction should be at least 30%"
    }
  ]
}