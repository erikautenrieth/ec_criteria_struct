"{\n  \"AND\": {\n    \"left\": {\n      \"OR\": {\n        \"left\": {\n          \"raw_text\": \"Form of diagnosed psoriasis other than chronic plaque psoriasis\"\n        },\n        \"right\": {\n          \"raw_text\": \"(i.e. guttate, erythrodermic, pustular)\"\n        }\n      }\n    },\n    \"right\": {\n      \"AND\": {\n        \"left\": {\n          \"OR\": {\n            \"left\": {\n              \"raw_text\": \"Diagnosis of other active, ongoing skin diseases\"\n            },\n            \"right\": {\n              \"raw_text\": \"or skin infections that may interfere with examination of psoriasis lesions\"\n            }\n          }\n        },\n        \"right\": {\n          \"AND\": {\n            \"left\": {\n              \"OR\": {\n                \"left\": {\n                  \"raw_text\": \"Ongoing use of other psoriasis treatment including but not limited to\"\n                },\n                \"right\": {\n                  \"OR\": {\n                    \"left\": {\n                      \"raw_text\": \"topical or systemic corticosteroids\"\n                    },\n                    \"right\": {\n                      \"OR\": {\n                        \"left\": {\n                          \"raw_text\": \"other topical medications (i.e. coal tar)\"\n                        },\n                        \"right\": {\n                          \"OR\": {\n                            \"left\": {\n                              \"raw_text\": \"oral or biologic medications for the treatment of psoriasis\"\n                            },\n                            \"right\": {\n                              \"raw_text\": \"and UV therapy. The following washout periods will be required:\"\n                            }\n                          }\n                        }\n                      }\n                    }\n                  }\n                },\n                \"right\": {\n                  \"AND\": {\n                    \"left\": {\n                      \"raw_text\": \"2 weeks for topical therapy; 2 weeks for phototherapy; 12 weeks for biologic or targeted therapies; 4 weeks for other systemic therapies\"\n                    }\n                  }\n                }\n              }\n            },\n            \"right\": {\n              \"OR\": {\n                \"left\": {\n                  \"raw_text\": \"Use of oral estrogen therapy, excluding oral contraceptive pills\"\n                }\n              }\n            }\n          }\n        }\n      }\n    },\n    \"right\": {\n      \"AND\": {\n        \"left\": {\n          \"OR\": {\n            \"left\": {\n              \"raw_text\": \"Women who are pregnant, nursing, or of child-bearing potential who are unwilling to use appropriate method(s) of contraception.\"\n            }\n          }\n        },\n        \"right\": {\n          \"OR\": {\n            \"left\": {\n              \"raw_text\": \"Patients unwilling to limit exposure to UV light\"\n            }\n          }\n        }\n      }\n    }\n  }\n}"