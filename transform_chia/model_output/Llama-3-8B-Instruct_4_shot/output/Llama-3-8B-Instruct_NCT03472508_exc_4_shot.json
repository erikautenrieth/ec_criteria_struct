"{\n  \"AND\": {\n    \"left\": {\n      \"OR\": {\n        \"left\": {\n          \"raw_text\": \"(1)Women who are pregnant and/or lactating; or women who intend to conceive within a year;\"\n        },\n        \"right\": {\n          \"raw_text\": \"(2)History of allergies to enalapril, folic acid or other components of the compound drug;\"\n        }\n      }\n    },\n    \"right\": {\n      \"AND\": {\n        \"left\": {\n          \"OR\": {\n            \"left\": {\n              \"raw_text\": \"(3)History of adverse reactions or intolerance to enalapril or other ACE inhibitors, or drugs or supplements containing folic acid;\"\n            },\n            \"right\": {\n              \"raw_text\": \"(4)Diagnosis or suspicion of secondary hypertension;\"\n            }\n          }\n        },\n        \"right\": {\n          \"AND\": {\n            \"left\": {\n              \"OR\": {\n                \"left\": {\n                  \"raw_text\": \"(5)Known serious medical conditions, including:\"\n                },\n                \"right\": {\n                  \"AND\": {\n                    \"left\": {\n                      \"OR\": {\n                        \"left\": {\n                          \"raw_text\": \"Cardiovascular: patients with clinically diagnosed cardiac dysfunction (NYHA class III and above), hypertrophic obstructive cardiomyopathy, clinically significant valvular heart disease, acute coronary syndrome within the last 3 months, or percutaneous coronary intervention (PCI), or coronary artery bypass graft (CABG);\"\n                        },\n                        \"right\": {\n                          \"OR\": {\n                            \"left\": {\n                              \"raw_text\": \"or abnormal pre-enrollment ECG test results with clinically significant arrhythmias (atrial flutter, atrial fibrillation, grade II-III atrioventricular block, etc.);\"\n                            },\n                            \"right\": {\n                              \"raw_text\": \"Digestive: a previous diagnosis of various types of viral hepatitis that are still in the active phase;\"\n                            }\n                          }\n                        }\n                      }\n                    },\n                    \"right\": {\n                      \"AND\": {\n                        \"left\": {\n                          \"OR\": {\n                            \"left\": {\n                              \"raw_text\": \"abnormal pre-enrollment liver function test results (ALT, AST, GGT, TBIL, or DBIL 3 times higher than normal, ALB = 30g/L);\"\n                            },\n                            \"right\": {\n                              \"OR\": {\n                                \"left\": {\n                                  \"raw_text\": \"gastrectomy and/or gastrojejunostomy;\"\n                                },\n                                \"right\": {\n                                  \"raw_text\": \"gastrointestinal dysfunction;\"\n                                }\n                              }\n                            }\n                          }\n                        },\n                        \"right\": {\n                          \"AND\": {\n                            \"left\": {\n                              \"OR\": {\n                                \"left\": {\n                                  \"raw_text\": \"Urinary: pre-enrollment serum creatinine greater than 200umol/L;\"\n                                },\n                                \"right\": {\n                                  \"OR\": {\n                                    \"left\": {\n                                      \"raw_text\": \"clinical diagnosis of renal artery stenosis, isolated kidney, kidney transplantation and/or other diseases;\"\n                                    },\n                                    \"right\": {\n                                      \"raw_text\": \"Endocrine: type 1 diabetes or uncontrolled type 2 diabetes (fasting blood glucose above 11.1 mmol/L at pre-enrollment);\"\n                                    }\n                                  }\n                                }\n                              }\n                            },\n                            \"right\": {\n                              \"AND\": {\n                                \"left\": {\n                                  \"OR\": {\n                                    \"left\": {\n                                      \"raw_text\": \"previous diagnosis of hyperthyroidism and failure to correct;\"\n                                    },\n                                    \"right\": {\n                                      \"raw_text\": \"Respiratory: pulmonary heart disease;\"\n                                    }\n                                  }\n                                },\n                                \"right\": {\n                                  \"AND\": {\n                                    \"left\": {\n                                      \"OR\": {\n                                        \"left\": {\n                                          \"raw_text\": \"Neuropsychiatric: recent transient ischemic attack or stroke (within the last 3 months);\"\n                                        },\n                                        \"right\": {\n                                          \"OR\": {\n                                            \"left\": {\n                                              \"raw_text\": \"peripheral or severe autonomic dysfunction;\"\n                                            },\n                                            \"right\": {\n                                              \"raw_text\": \"mental or nervous system dysfunction, inability to express desire;\"\n                                            }\n                                          }\n                                        }\n                                      }\n                                    },\n                                    \"right\": {\n                                      \"OR\": {\n                                        \"left\": {\n                                          \"raw_text\": \"known drug or alcohol dependence;\"\n                                        },\n                                        \"right\": {\n                                          \"raw_text\": \"Malignancy, malnutrition, hematopoietic disorders and other serious diseases.\"\n                                        }\n                                      }\n                                    }\n                                  }\n                                }\n                              }\n                            }\n                          }\n                        }\n                      }\n                    }\n                  }\n                }\n              }\n            }\n          }\n        }\n      }\n    }\n  }\n}"