"{\n  \"AND\": {\n    \"left\": {\n      \"AND\": {\n        \"left\": {\n          \"OR\": {\n            \"left\": {\n              \"raw_text\": \"Male\"\n            },\n            \"right\": {\n              \"raw_text\": \"and female patients\"\n            }\n          }\n        },\n        \"right\": {\n          \"AND\": {\n            \"left\": {\n              \"raw_text\": \"between the ages of 18-65 years, inclusive\"\n            }\n          }\n        }\n      }\n    },\n    \"right\": {\n      \"AND\": {\n        \"left\": {\n          \"AND\": {\n            \"left\": {\n              \"raw_text\": \"Patients (or legal representative) willing and able to provide written Informed Consent Form.\"\n            }\n          }\n        },\n        \"right\": {\n          \"AND\": {\n            \"left\": {\n              \"NOT\": {\n                \"left\": {\n                  \"OR\": {\n                    \"left\": {\n                      \"raw_text\": \"Psychiatric patients already diagnosed of schizophrenia\"\n                    },\n                    \"right\": {\n                      \"OR\": {\n                        \"left\": {\n                          \"raw_text\": \"or bipolar disorder, according to the Diagnostic and Statistical Manual of Mental Disorders- IV\"\n                        },\n                        \"right\": {\n                          \"OR\": {\n                            \"left\": {\n                              \"raw_text\": \", Diagnostic and Statistical Manual of Mental Disorders- V\"\n                            },\n                            \"right\": {\n                              \"raw_text\": \"or International Code of Disease criteria.\"\n                            }\n                          }\n                        }\n                      }\n                    }\n                  }\n                }\n              }\n            },\n            \"right\": {\n              \"AND\": {\n                \"left\": {\n                  \"NOT\": {\n                    \"left\": {\n                      \"OR\": {\n                        \"left\": {\n                          \"raw_text\": \"Patients with an on-going agitation episode\"\n                        },\n                        \"right\": {\n                          \"OR\": {\n                            \"left\": {\n                              \"raw_text\": \"or with a previous one within the 6 months prior to screening\"\n                            },\n                            \"right\": {\n                              \"raw_text\": \", attended and managed in the hospital setting.\"\n                            }\n                          }\n                        }\n                      }\n                    }\n                  }\n                },\n                \"right\": {\n                  \"AND\": {\n                    \"left\": {\n                      \"NOT\": {\n                        \"left\": {\n                          \"OR\": {\n                            \"left\": {\n                              \"raw_text\": \"Previously treated with ADASUVE® with a positive outcome\"\n                            },\n                            \"right\": {\n                              \"raw_text\": \"(responders) according to (CGI-I) scale (defined as having a CGI-I score of 1 or 2 at 2 hours after administration of the inhalation)\"\n                            }\n                          }\n                        }\n                      }\n                    },\n                    \"right\": {\n                      \"AND\": {\n                        \"left\": {\n                          \"NOT\": {\n                            \"left\": {\n                              \"OR\": {\n                                \"left\": {\n                                  \"raw_text\": \"Patients free of active respiratory disease\"\n                                },\n                                \"right\": {\n                                  \"OR\": {\n                                    \"left\": {\n                                      \"raw_text\": \"such as acute respiratory signs/symptoms (e.g., wheezing)\"\n                                    },\n                                    \"right\": {\n                                      \"OR\": {\n                                        \"left\": {\n                                          \"raw_text\": \"or with active airways disease (asthma, chronic obstructive pulmonary disease or emphysema).\"\n                                        }\n                                      }\n                                    }\n                                  }\n                                }\n                              }\n                            }\n                          }\n                        },\n                        \"right\": {\n                          \"AND\": {\n                            \"left\": {\n                              \"raw_text\": \"Requirement of family or other caregiver support at study investigator criteria\"\n                            },\n                            \"right\": {\n                              \"raw_text\": \"(defined as a patient's relative or caregiver (male or female) = 80 year old, who spend = 3 consecutive hours with patient, with good physical and psychological health status and without physical limitations, reading and writing educational level and able to understand and follow the study procedures).\"\n                            }\n                          }\n                        }\n                      }\n                    },\n                    \"right\": {\n                      \"AND\": {\n                        \"left\": {\n                          \"raw_text\": \"Availability of patient's medical records data about the previous treatment with ADASUVE® at hospital setting.\"\n                        }\n                      }\n                    }\n                  }\n                }\n              }\n            }\n          }\n        }\n      }\n    },\n    \"right\": {\n      \"AND\": {\n        \"left\": {\n          \"OR\": {\n            \"left\": {\n              \"raw_text\": \"If a female is of childbearing potential and sexually active\"\n            },\n            \"right\": {\n              \"NOT\": {\n                \"left\": {\n                  \"OR\": {\n                    \"left\": {\n                      \"raw_text\": \"except if female is surgically sterile\"\n                    },\n                    \"right\": {\n                      \"OR\": {\n                        \"left\": {\n                          \"raw_text\": \"or post-menopausal with history of no menses for at least 24 months\"\n                        },\n                        \"right\": {\n                          \"raw_text\": \"), patient must be non-lactating and non-pregnant (with a negative pregnancy test result at baseline visit)\"\n                        }\n                      }\n                    }\n                  }\n                }\n              }\n            }\n          },\n          \"right\": {\n            \"AND\": {\n              \"left\": {\n                \"raw_text\": \"and have to agree to use a medically acceptable and effective birth control method throughout the study and for one week following the end of the study.\"\n              }\n            }\n          }\n        }\n      }\n    }\n  }\n}"