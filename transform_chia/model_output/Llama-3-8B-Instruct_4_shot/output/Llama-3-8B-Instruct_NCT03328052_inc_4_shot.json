"{\n  \"AND\": {\n    \"left\": {\n      \"AND\": {\n        \"left\": {\n          \"raw_text\": \"Patients with a clinical diagnosis of depression\"\n        },\n        \"right\": {\n          \"raw_text\": \"who in the judgement of their physician require medication management may be eligible for enrollment.\"\n        }\n      },\n      \"right\": {\n        \"AND\": {\n          \"left\": {\n            \"raw_text\": \"A score of 10 or more on the PHQ-9 instrument will be required for enrollment.\"\n          },\n          \"right\": {\n            \"AND\": {\n              \"left\": {\n                \"OR\": {\n                  \"left\": {\n                    \"raw_text\": \"Some practices utilize the PHQ-2\"\n                    },\n                    \"right\": {\n                      \"raw_text\": \"and PHQ-9 are part of routine screening for depression.\"\n                    }\n                  }\n                },\n                \"right\": {\n                  \"raw_text\": \"If the tests are performed routinely, they do not need to be repeated for study eligibility, and may be performed prior to informed consent for this study.\"\n                }\n              },\n              \"right\": {\n                \"AND\": {\n                  \"left\": {\n                    \"raw_text\": \"If, however, the PHQ-9 is not routinely performed, informed consent must be performed prior to administration.\"\n                    },\n                    \"right\": {\n                      \"AND\": {\n                        \"left\": {\n                          \"raw_text\": \"Patients with a score below 10 will be considered screen failures and will not be enrolled or offered the MYnd testing.\"\n                        }\n                      }\n                    }\n                  }\n                }\n              }\n            }\n          }\n        }\n      }\n    },\n    \"right\": {\n      \"AND\": {\n        \"left\": {\n          \"OR\": {\n            \"left\": {\n              \"raw_text\": \"Patients with non-psychotic comorbid conditions may be included.\"\n            }\n          }\n        },\n        \"right\": {\n          \"AND\": {\n            \"left\": {\n              \"raw_text\": \"Patients must be either medication treatment naïve for behavioral illnesses or have no active medication treatments for at least 1 month prior to enrollment.\"\n            },\n            \"right\": {\n              \"AND\": {\n                \"left\": {\n                  \"raw_text\": \"Prohibited medications at the time of enrollment will include stimulants, benzodiazepines and THC.\"\n                  },\n                  \"right\": {\n                    \"raw_text\": \"Prior therapy with these agents is permitted with a washout of >30 days.\"\n                    }\n                  }\n                }\n              }\n            }\n          }\n        },\n        \"right\": {\n          \"AND\": {\n            \"left\": {\n              \"raw_text\": \"Patients must have private medical insurance coverage through Horizon Blue Cross Blue Shield.\"\n            },\n            \"right\": {\n              \"raw_text\": \"This is limited to insured commercial members, including HMO, and excluding, for the avoidance of doubt, members of self-insured customers or Medicare or Medicaid programs.\"\n              }\n            }\n          }\n        }\n      }\n    }\n  }\n}"