                             \"right\": {\n                                      \"OR\": {\n                                        \"left\": {\n                                          \"raw_text\": \"Clinically significant pericardial effusion (eg, moderate or larger or with hemodynamic compromise)\"\n                                        },\n                                        \"right\": {\n                                          \"OR\": {\n                                            \"left\": {\n                                              \"raw_text\": \"Significant renal or hepatic disease as evidenced by a serum creatinine greater than 1.5× upper limit of normal (ULN), serum transaminases greater than 3× ULN, or total bilirubin greater than 1.5× ULN in absence of Gilbert's syndrome\"\n                                            },\n                                            \"right\": {\n                                              \"OR\": {\n                                                \"left\": {\n                                                  \"raw_text\": \"Any suicidal ideation with intent with or without a plan, at the time of or within 6 months of Screening, as indicated by answering 'Yes' to questions 4 or 5 on the Suicidal Ideation section of the Columbia-Suicide Severity Rating Scale (C-SSRS)\"\n                                                },\n                                                \"right\": {\n                                                  \"OR\": {\n                                                    \"left\": {\n                                                      \"raw_text\": \"Any suicidal behavior in the past based on the C-SSRS\"\n                                                    },\n                                                    \"right\": {\n                                                      \"OR\": {\n                                                        \"left\": {\n                         