{
  "AND": {
    "left": {
      "AND": {
        "left": {
          "raw_text": "Diagnosis of sickle cell disease"
        },
        "right": {
          "OR": {
            "left": {
              "raw_text": "Clinically significant disease defined as at least 1 painful episode per year averaged over the previous 3 years"
            },
            "right": {
              "OR": {
                "left": {
                  "raw_text": "or a history of priapism"
                },
                "right": {
                  "OR": {
                    "left": {
                      "raw_text": "stroke"
                    },
                    "right": {
                      "OR": {
                        "left": {
                          "raw_text": "acute chest syndrome"
                        },
                        "right": {
                          "OR": {
                            "left": {
                              "raw_text": "avascular necrosis"
                            },
                            "right": {
                              "OR": {
                                "left": {
                                  "raw_text": "multi-organ failure"
                                },
                                "right": {
                                  "raw_text": "or the need for chronic narcotic medications for pain from sickle cell disease"
                                }
                              }
                            }
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      },
      "right": {
        "AND": {
          "left": {
            "raw_text": "Must have failed a previous attempt at treatment with hydroxyurea"
          },
          "right": {
            "OR": {
              "left": {
                "raw_text": "defined as the inability to achieve a significant absolute increase in % fetal hemoglobin"
              },
              "right": {
                "OR": {
                  "left": {
                    "raw_text": "or the inability to tolerate hydroxyurea treatment due to severe side effects such as but not limited to myelosuppression"
                  },
                  "right": {
                    "OR": {
                      "left": {
                        "raw_text": "gastrointestinal symptoms"
                      },
                      "right": {
                        "OR": {
                          "left": {
                            "raw_text": "edema"
                          },
                          "right": {
                            "raw_text": "or hepatic enzyme elevations"
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "right": {
      "AND": {
        "left": {
          "raw_text": "18 years of age or older"
        },
        "right": {
          "AND": {
            "left": {
              "raw_text": "Hematologic laboratory values as outlined in the protocol"
            },
            "right": {
              "raw_text": "Non-hematologic laboratory values as outlined in the protocol"
            }
          }
        }
      }
    }
  },
  "AND": {
    "left": {
      "raw_text": "Must agree not to donate blood or other bodily fluid while taking the study drug and for 28 days thereafter"
    },
    "right": {
      "AND": {
        "left": {
          "raw_text": "Women of child-bearing potential (WCBP) must have a negative serum pregnancy test 72 hours or less prior to starting treatment"
        },
        "right": {
          "AND": {
            "left": {
              "raw_text": "Women of child-bearing potential and men must agree to use 2 forms of adequate contraception prior to study entry and for the duration of study participation"
            }
          }
        }
      }
    }
  }
}