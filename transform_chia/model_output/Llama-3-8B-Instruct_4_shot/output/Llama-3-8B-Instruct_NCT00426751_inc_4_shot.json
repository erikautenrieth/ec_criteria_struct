"{\n  \"AND\": {\n    \"left\": {\n      \"OR\": {\n        \"left\": {\n          \"raw_text\": \"Women must be postmenopausal\"\n        },\n        \"right\": {\n          \"raw_text\": \"(i.e. 12 months without menstrual period), or surgically sterile\"\n        }\n      }\n    },\n    \"right\": {\n      \"AND\": {\n        \"left\": {\n          \"raw_text\": \"In cases of doubt a pregnancy test should be performed.\"\n        },\n        \"right\": {\n          \"OR\": {\n            \"left\": {\n              \"raw_text\": \"Acute myocardial infarction < 12 h defined as:\"\n            },\n            \"right\": {\n              \"AND\": {\n                \"left\": {\n                  \"AND\": {\n                    \"left\": {\n                      \"raw_text\": \"1. Angina or equivalent symptoms > 20 min\"\n                    },\n                    \"right\": {\n                      \"raw_text\": \"and\"\n                    }\n                  },\n                  \"right\": {\n                    \"AND\": {\n                      \"left\": {\n                        \"raw_text\": \"2. ST elevation in 2 contiguous ECG leads (= 2 mm precordial lead, = 1 mm limb lead).\"\n                      },\n                      \"right\": {\n                        \"raw_text\": \"This ECG recording serves as baseline ECG, i.e. ECG I.\"\n                      }\n                    }\n                  }\n                }\n              },\n              \"right\": {\n                \"raw_text\": \"Planned primary percutaneous coronary intervention\"\n              }\n            }\n          }\n        },\n        \"right\": {\n          \"raw_text\": \"The subject has given written informed, dated consent to participate in the study\"\n        }\n      }\n    }\n  }\n}"