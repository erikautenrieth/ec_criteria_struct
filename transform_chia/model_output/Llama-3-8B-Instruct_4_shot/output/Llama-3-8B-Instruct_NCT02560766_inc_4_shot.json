"{\n  \"AND\": {\n    \"left\": {\n      \"OR\": {\n        \"left\": {\n          \"raw_text\": \"Male and female adolescent patients\"\n        },\n        \"right\": {\n          \"raw_text\": \", aged 13 to 17 years\"\n        }\n      }\n    },\n    \"right\": {\n      \"AND\": {\n        \"left\": {\n          \"AND\": {\n            \"left\": {\n              \"raw_text\": \"diagnosed with RLS based on the IRLSSG consensus criteria (Allen RP 2014)\"\n            },\n            \"right\": {\n              \"raw_text\": \"(Appendix 2)\"\n            }\n          }\n        },\n        \"right\": {\n          \"AND\": {\n            \"left\": {\n              \"AND\": {\n                \"left\": {\n                  \"raw_text\": \"Total RLS severity score of 15 or greater on the IRLS rating scale\"\n                },\n                \"right\": {\n                  \"AND\": {\n                    \"left\": {\n                      \"raw_text\": \"at Visit 1 (screening) and at Visit 2 (baseline)\"\n                    },\n                    \"right\": {\n                      \"raw_text\": \"(Appendix 8)\"\n                    }\n                  }\n                }\n              }\n            },\n            \"right\": {\n              \"AND\": {\n                \"left\": {\n                  \"raw_text\": \"RLS symptoms for at least 4 of 7 consecutive evenings/nights during the screening period\"\n                }\n              }\n            }\n          }\n        }\n      }\n    },\n    \"right\": {\n      \"AND\": {\n        \"left\": {\n          \"AND\": {\n            \"left\": {\n              \"raw_text\": \"Body weight greater than 33.4 kg\"\n            },\n            \"right\": {\n              \"AND\": {\n                \"left\": {\n                  \"raw_text\": \"and a healthy weight using age-based body mass index (BMI) range\"\n                },\n                \"right\": {\n                  \"raw_text\": \"5th-85th percentile