"{\n  \"AND\": {\n    \"left\": {\n      \"AND\": {\n        \"left\": {\n          \"AND\": {\n            \"left\": {\n              \"OR\": {\n                \"left\": {\n                  \"raw_text\": \"Adults 18-65 years\"\n                },\n                \"right\": {\n                  \"raw_text\": \"who are diagnosed with functional neurologic symptom\"\n                }\n              }\n            },\n            \"right\": {\n              \"OR\": {\n                \"left\": {\n                  \"raw_text\": \"or conversion disorder.\"\n                }\n              }\n            }\n          }\n        },\n        \"right\": {\n          \"AND\": {\n            \"left\": {\n              \"IF\": {\n                \"condition\": \"diagnosis of seizure type\",\n                \"then\": {\n                  \"AND\": {\n                    \"left\": {\n                      \"raw_text\": \"video EEG with diagnosis confirmed by board-certified neurologist\"\n                    },\n                    \"right\": {\n                      \"AND\": {\n                        \"left\": {\n                          \"raw_text\": \"with subspecialty training in epilepsy and clinical neurophysiology using the criteria of the International Classification of the Epilepsies\"\n                        }\n                      }\n                    }\n                  }\n                }\n              },\n              \"ELSE\": {\n                \"AND\": {\n                  \"left\": {\n                    \"AND\": {\n                      \"left\": {\n                        \"OR\": {\n                          \"left\": {\n                            \"raw_text\": \"diagnosis of motor type\"\n                          },\n                          \"right\": {\n                            \"raw_text\": \"documented and clinically established levels of diagnostic certainty (Williams,1995)\"\n                          }\n                        }\n