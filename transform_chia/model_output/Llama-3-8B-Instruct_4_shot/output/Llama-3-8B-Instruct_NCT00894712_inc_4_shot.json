"{\n  \"AND\": {\n    \"left\": {\n      \"AND\": {\n        \"left\": {\n          \"raw_text\": \"Must have pathologically confirmed invasive adenocarcinoma\"\n        },\n        \"right\": {\n          \"OR\": {\n            \"left\": {\n              \"raw_text\": \"or ductal carcinoma in situ of the breast.\"\n            }\n          }\n        }\n      }\n    },\n    \"right\": {\n      \"AND\": {\n        \"left\": {\n          \"raw_text\": \"Patients must have undergone segmental mastectomy (i.e., lumpectomy).\"\n        },\n        \"right\": {\n          \"AND\": {\n            \"left\": {\n              \"NOT\": {\n                \"left\": {\n                  \"raw_text\": \"Patients must not have received prior radiation therapy to the breast.\"\n                }\n              }\n            },\n            \"right\": {\n              \"AND\": {\n                \"left\": {\n                  \"NOT\": {\n                    \"left\": {\n                      \"raw_text\": \"Patients must not have active local-regional disease prior to registration.\"\n                    }\n                  }\n                },\n                \"right\": {\n                  \"AND\": {\n                    \"left\": {\n                      \"NOT\": {\n                        \"left\": {\n                          \"raw_text\": \"Patients must not be pregnant because of the potential for fetal harm as a result of radiation treatment.\"\n                        }\n                      }\n                    },\n                    \"right\": {\n                      \"AND\": {\n                        \"left\": {\n                          \"OR\": {\n                            \"left\": {\n                              \"raw_text\": \"Women of child-bearing age will be given a serum pregnancy test prior to study entry to ensure they are not pregnant.\"\n                            },\n                            \"right\": {\n                              \"raw_text\": \"They will also be counseled on the importance of avoiding pregnancy and hormonal contraception while undergoing radiation therapy.\"\n                            }\n                          }\n                        },\n                        \"right\": {\n                          \"AND\": {\n                            \"left\": {\n                              \"NOT\": {\n                                \"left\": {\n                                  \"raw_text\": \"Patients must not have a serious medical or psychiatric illness which prevents informed consent or compliance with treatment.\"\n                                }\n                              }\n                            },\n                            \"right\": {\n                              \"AND\": {\n                                \"left\": {\n                                  \"raw_text\": \"All patients must be informed of the investigational nature of this study and give written informed consent in accordance with institutional and federal guidelines.\"\n                                }\n                              }\n                            }\n                          }\n                        }\n                      }\n                    }\n                  }\n                }\n              }\n            }\n          }\n        }\n      }\n    }\n  }\n}"