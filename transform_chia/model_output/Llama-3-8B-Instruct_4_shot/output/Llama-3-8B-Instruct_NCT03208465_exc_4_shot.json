"{\n  \"AND\": {\n    \"left\": {\n      \"OR\": {\n        \"left\": {\n          \"raw_text\": \"Contraindications to empagliflozin, Sitagliptin\"\n        },\n        \"right\": {\n          \"OR\": {\n            \"left\": {\n              \"raw_text\": \"DPP4 inhibitors or Sodium-glucose cotransporter-2(SGLT2) inhibitors within the previous 4 weeks\"\n            },\n            \"right\": {\n              \"raw_text\": \"within the previous 4 weeks\"\n            }\n          }\n        }\n      }\n    },\n    \"right\": {\n      \"AND\": {\n        \"left\": {\n          \"OR\": {\n            \"left\": {\n              \"raw_text\": \"Insulin requiring diabetes\"\n            },\n            \"right\": {\n              \"OR\": {\n                \"left\": {\n                  \"raw_text\": \"Poor glucose control (HbA1C>10 %)\"\n                },\n                \"right\": {\n                  \"raw_text\": \"or Acute coronary syndrome\"\n                }\n              }\n            }\n          },\n          \"right\": {\n            \"AND\": {\n              \"left\": {\n                \"OR\": {\n                  \"left\": {\n                    \"raw_text\": \"Stent placement within the previous 6 months\"\n                  },\n                  \"right\": {\n                    \"OR\": {\n                      \"left\": {\n                        \"raw_text\": \"Previous coronary artery bypass graft surgery within the previous 6 months\"\n                      },\n                      \"right\": {\n                        \"raw_text\": \"or Planned revascularization within 6 months\"\n                      }\n                    }\n                  }\n                },\n                \"right\": {\n                  \"AND\": {\n                    \"left\": {\n                      \"OR\": {\n                        \"left\": {\n                          \"raw_text\": \"Heart failure requiring loop diuretics\"\n                        },\n    