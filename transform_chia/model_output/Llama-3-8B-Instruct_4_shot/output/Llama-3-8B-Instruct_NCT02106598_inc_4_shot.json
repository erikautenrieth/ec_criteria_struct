"{\n  \"AND\": {\n    \"left\": {\n      \"AND\": {\n        \"left\": {\n          \"raw_text\": \"18 years of age or older\"\n        },\n        \"right\": {\n          \"AND\": {\n            \"left\": {\n              \"OR\": {\n                \"left\": {\n                  \"raw_text\": \"Histologically confirmed diagnosis of melanoma\"\n                },\n                \"right\": {\n                  \"OR\": {\n                    \"left\": {\n                      \"raw_text\": \"breast cancer\"\n                    },\n                    \"right\": {\n                      \"raw_text\": \"or gynecologic cancer at MSKCC\"\n                    }\n                  }\n                }\n              }\n            },\n            \"right\": {\n              \"AND\": {\n                \"left\": {\n                  \"OR\": {\n                    \"left\": {\n                      \"raw_text\": \"Newly-diagnosed or recurrent (local, regional, metastatic) malignant melanoma or breast cancer patients in whom SLN mapping is indicated\"\n                    },\n                    \"right\": {\n                      \"OR\": {\n                        \"left\": {\n                          \"raw_text\": \"Residual clinically or radiographically evident tumor, including primary cutaneous and mucosal melanomas\"\n                        },\n                        \"right\": {\n                          \"raw_text\": \"Prior radiation therapy, chemotherapy, or surgery in patients requiring flap reconstruction in the head and neck region.\"\n                        }\n                      }\n                    }\n                  }\n                },\n                \"right\": {\n                  \"OR\": {\n                    \"left\": {\n                      \"raw_text\": \"Newly diagnosed patients with previous excisional biopsy.\"\n                    },\n                    \"right\": {\n                      \"OR\": {\n                        \"left\": {\n                          \"raw_text\": \"Newly-diagnosed gynecologic cancer patients in whom SLN mapping and surgical excision is indicated\"\n                        },\n                        \"right\": {\n                          \"raw_text\": \"OR Normal baseline cardiac function based upon pre-operative evaluation\"\n                        }\n                      }\n                    }\n                  }\n                }\n              }\n            }\n          }\n        }\n      }\n    },\n    \"right\": {\n      \"AND\": {\n        \"left\": {\n          \"OR\": {\n            \"left\": {\n              \"raw_text\": \"At the discretion of the operating surgeon, ANC>1000/mcl and platelets>100,000/mcl.\"\n            },\n            \"right\": {\n              \"OR\": {\n                \"left\": {\n                  \"raw_text\": \"At the discretion of the operating surgeon, Bilirubin level of < 2.0 mg/dl in the absence of a history of Gilbert's disease (or pattern consistent with Gilbert's).\"\n                },\n                \"right\": {\n                  \"raw_text\": \"For melanoma patients, If patients have a history of malignancy other than melanoma, and other skin cancers in the past five years, their inclusion is up to the discretion of the physician.\"\n                }\n              }\n            }\n          },\n          \"right\": {\n            \"AND\": {\n              \"left\": {\n                \"raw_text\": \"All patients of childbearing and child-creating age must be using an acceptable form of birth control\"\n              },\n              \"right\": {\n                \"raw_text\": \"Women who are pre-menopausal must have a negative serum pregnancy test\"\n              }\n            }\n          }\n        }\n      }\n    }\n  }\n}"