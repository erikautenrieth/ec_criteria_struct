"{\n  \"AND\": {\n    \"left\": {\n      \"OR\": {\n        \"left\": {\n          \"raw_text\": \"patients affected by mono-lateral symptomatic knee articular degenerative pathology\"\n        },\n        \"right\": {\n          \"AND\": {\n            \"left\": {\n              \"raw_text\": \"with history of chronic (for at least 4 months) pain\"\n            },\n            \"right\": {\n              \"OR\": {\n                \"left\": {\n                  \"raw_text\": \"or swelling;\"\n                }\n              }\n            }\n          }\n        }\n      }\n    },\n    \"right\": {\n      \"AND\": {\n        \"left\": {\n          \"raw_text\": \"imaging findings of degenerative changes of the joint\"\n        },\n        \"right\": {\n          \"OR\": {\n            \"left\": {\n              \"raw_text\": \"osteoarthritis\"\n            },\n            \"right\": {\n              \"OR\": {\n                \"left\": {\n                  \"raw_text\": \"or chondropathy\"\n                },\n                \"right\": {\n                  \"AND\": {\n                    \"left\": {\n                      \"raw_text\": \"with Kellgren Lawrence Score from 0 to 3\"\n                    },\n                    \"right\": {\n                      \"raw_text\": \"at X-ray evaluation.\"\n                    }\n                  }\n                }\n              }\n            }\n          }\n        }\n      }\n    }\n  }\n}"