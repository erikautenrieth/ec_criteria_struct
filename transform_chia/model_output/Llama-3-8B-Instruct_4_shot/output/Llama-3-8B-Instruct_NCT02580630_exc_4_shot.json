"{\n  \"AND\": {\n    \"left\": {\n      \"OR\": {\n        \"left\": {\n          \"raw_text\": \"Earlier operations in the foot and leg, that is judged to complicate training\"\n        },\n        \"right\": {\n          \"OR\": {\n            \"left\": {\n              \"raw_text\": \"known arthritis\"\n            },\n            \"right\": {\n              \"raw_text\": \"known diabetes\"\n            }\n          }\n        }\n      },\n      \"right\": {\n        \"AND\": {\n          \"left\": {\n            \"OR\": {\n              \"left\": {\n                \"raw_text\": \"Leg ulcerations or infections in the foot.\"\n              },\n              \"right\": {\n                \"raw_text\": \"Judged unable to comply with the training protocol.\"\n              }\n            }\n          },\n          \"right\": {\n            \"OR\": {\n              \"left\": {\n                \"raw_text\": \"Daily use of pain killers\"\n              },\n              \"right\": {\n                \"AND\": {\n                  \"left\": {\n                    \"raw_text\": \"Glucocorticosteroid injection to the diseased achilles tendon within the last 6 months.\"\n                  },\n                  \"right\": {\n                    \"OR\": {\n                      \"left\": {\n                        \"raw_text\": \"Earlier allergic reactions to glucocorticosteroid\"\n                      },\n                      \"right\": {\n                        \"raw_text\": \"or local anesthetic.\"\n                      }\n                    }\n                  }\n                }\n              }\n            }\n          }\n        }\n      }\n    },\n    \"right\": {\n      \"OR\": {\n        \"left\": {\n          \"raw_text\": \"Pregnancy or planning to become pregnant\"\n        },\n        \"right\": {\n          \"raw_text\": \"BMI above 30.\"\n        }\n      }\n    }\n  }\n}"