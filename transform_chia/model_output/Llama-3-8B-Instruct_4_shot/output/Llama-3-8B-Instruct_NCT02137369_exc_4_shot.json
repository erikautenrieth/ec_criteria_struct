"{\n  \"AND\": {\n    \"left\": {\n      \"OR\": {\n        \"left\": {\n          \"raw_text\": \"Lifetime history of Bipolar Disorder\"\n        },\n        \"right\": {\n          \"OR\": {\n            \"left\": {\n              \"raw_text\": \"Dementia\"\n            },\n            \"right\": {\n              \"OR\": {\n                \"left\": {\n                  \"raw_text\": \"Autism Spectrum Disorder\"\n                },\n                \"right\": {\n                  \"OR\": {\n                    \"left\": {\n                      \"raw_text\": \"Schizophrenia\"\n                    },\n                    \"right\": {\n                      \"OR\": {\n                        \"left\": {\n                          \"raw_text\": \"or any other Psychotic Disorder.\"\n                        }\n                      }\n                    }\n                  }\n                }\n              }\n            }\n          }\n        }\n      },\n      \"right\": {\n        \"AND\": {\n          \"left\": {\n            \"OR\": {\n              \"left\": {\n                \"raw_text\": \"Psychotic symptoms occurring at any time during the current major depressive episode.\"\n              }\n            },\n            \"right\": {\n              \"OR\": {\n                \"left\": {\n                  \"raw_text\": \"Current (past 12 months) diagnosis of Panic disorder\"\n                },\n                \"right\": {\n                  \"OR\": {\n                    \"left\": {\n                      \"raw_text\": \"Obsessive Compulsive Disorder\"\n                    },\n                    \"right\": {\n                      \"OR\": {\n                        \"left\": {\n                          \"raw_text\": \"Posttraumatic Stress Disorder\"\n                        },\n                        \"right\": {\n                          \"OR\": {\n                            \"left\": {\n                              \"raw_text\": \"Anorexia Nervosa\"\n                            },\n                            \"right\": {\n                              \"raw_text\": \"or Bulimia Nervosa.\"\n                            }\n                          }\n                        }\n                      }\n                    }\n                  }\n                }\n              }\n            }\n          },\n          \"right\": {\n            \"AND\": {\n              \"left\": {\n                \"OR\": {\n                  \"left\": {\n                    \"raw_text\": \"Alcohol or Drug Dependence within 12 months\"\n                  },\n                  \"right\": {\n                    \"raw_text\": \"or Abuse within 3 months (excluding nicotine and caffeine) of baseline visit, as assessed by history and urine drug screen.\"\n                  }\n                }\n              },\n              \"right\": {\n                \"OR\": {\n                  \"left\": {\n                    \"raw_text\": \"Clinical evidence of a severe Personality Disorder\"\n                  },\n                  \"right\": {\n                    \"raw_text\": \"as assessed by the study psychiatrist, which would impede participation or completion of the trial.\"\n                  }\n                }\n              }\n            }\n          }\n        }\n      }\n    }\n  }\n}"