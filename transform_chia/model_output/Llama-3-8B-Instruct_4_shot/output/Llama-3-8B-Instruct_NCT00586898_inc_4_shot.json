"{\n  \"AND\": {\n    \"left\": {\n      \"OR\": {\n        \"left\": {\n          \"raw_text\": \"Patients residing in the following clinical states\"\n        },\n        \"right\": {\n          \"AND\": {\n            \"left\": {\n              \"raw_text\": \"wit! be considered:\"\n            },\n            \"right\": {\n              \"AND\": {\n                \"left\": {\n                  \"OR\": {\n                    \"left\": {\n                      \"raw_text\": \"A. Rising PSA:\"\n                    },\n                    \"right\": {\n                      \"AND\": {\n                        \"left\": {\n                          \"raw_text\": \"Patients with a history of localized disease who have undergone definitive radiation or surgery.\"\n                        },\n                        \"right\": {\n                          \"AND\": {\n                            \"left\": {\n                              \"raw_text\": \"These patients must demonstrate progression of disease biochemically as outlined below.\"\n                            },\n                            \"right\": {\n                              \"raw_text\": \"Patients in this group may not have radiographically evident disease.\"\n                            }\n                          }\n                        }\n                      },\n                    },\n                    \"right\": {\n                      \"OR\": {\n                        \"left\": {\n                          \"raw_text\": \"B. Non-castrate metastatic:\"\n                        },\n                        \"right\": {\n                          \"AND\": {\n                            \"left\": {\n                              \"raw_text\": \"Patients must present with radiographic evidence of metastatic disease at the time of diagnosis or after treatment for localized disease.\"\n                            },\n                            \"right\": {\n                              \"AND\": {\n                                \"left\": {\n                                  \"raw_text\": \"These patients must show newly detected disease or progressing disease in bone or in soft tissue.\"\n                                },\n                                \"right\": {\n                                  \"AND\": {\n                                    \"left\": {\n                                      \"raw_text\": \"Biochemical progression is defined as:\"\n                                    },\n                                    \"right\": {\n                                      \"AND\": {\n                                        \"left\": {\n                                          \"raw_text\": \"minimum no. of determinations: 3\"\n                                        },\n                                        \"right\": {\n                                          \"AND\": {\n                                            \"left\": {\n                                              \"raw_text\": \"Interval: >2 weeks\"\n                                            },\n                                            \"right\": {\n                                              \"AND\": {\n                                                \"left\": {\n                                                  \"raw_text\": \"Minimal Baseline PSA value (ng/ml): 2\"\n                                                },\n                                                \"right\": {\n                                                  \"AND\": {\n                                                    \"left\": {\n                                                      \"raw_text\": \"Minimal % increase in range of values: 50%\"\n                                                    }\n                                                  }\n                                                }\n                                              }\n                                            }\n                                          }\n                                        }\n                                      }\n                                    }\n                                  }\n                                }\n                              }\n                            }\n                          }\n                        }\n                      }\n                    }\n                  }\n                }\n              }\n            }\n          }\n        }\n      }\n    },\n    \"right\": {\n      \"AND\": {\n        \"left\": {\n          \"raw_text\": \"Diagnosis of prostate adenocarcinoma histologically confirmed at MSKCC.\"\n        },\n        \"right\": {\n          \"AND\": {\n            \"left\": {\n              \"raw_text\": \"Patient must have level of serum testosterone above the lower limit of normal.\"\n            },\n            \"right\": {\n              \"AND\": {\n                \"left\": {\n                  \"raw_text\": \"Karnofskcy performance status (KPS) >_70%.\"\n                },\n                \"right\": {\n                  \"AND\": {\n                    \"left\": {\n                      \"raw_text\": \"Patients must have adequate organ function as defined by the following laboratory criteria:\"\n                    },\n                    \"right\": {\n                      \"AND\": {\n                        \"left\": {\n                          \"raw_text\": \"WBC >_3500/mm3, platelet count >_100,000/mm3.\"\n                        },\n                        \"right\": {\n                          \"AND\": {\n                            \"left\": {\n                              \"raw_text\": \"Bilirubin <2.0 mg/dl or SGOT <3.0 X the upper limit of normal.\"\n                            },\n                            \"right\": {\n                              \"AND\": {\n                                \"left\": {\n                                  \"raw_text\": \"Creatinine <_1.6 mg/dl or creatinine clearance >_60 cc/min.\"\n                                }\n                              }\n                            }\n                          }\n                        }\n                      }\n                    }\n                  }\n                }\n              }\n            }\n          }\n        }\n      }\n    }\n  }\n  \"OR\": {\n    \"left\": {\n      \"raw_text\": \"Prior hormonal therapy is allowed as:\"\n    },\n    \"right\": {\n      \"AND\": {\n        \"left\": {\n          \"raw_text\": \"1. Neoadjuvant treatment prior to radiation therapy or radical prostatectomy, provided that the total duration of exposure does not exceed 10 months.\"\n        },\n        \"right\": {\n          \"OR\": {\n            \"left\": {\n              \"raw_text\": \"2. One cycle of intermittent therapy up to a maximum exposure of 10 months.\"\n            }\n          }\n        }\n      }\n    }\n  },\n  \"AND\": {\n    \"left\": {\n      \"raw_text\": \"Patients must be at least 18 years of age.\"\n    },\n    \"right\": {\n      \"raw_text\": \"Patients must have signed an informed consent document stating that they understand the investigational nature of the proposed treatment\"\n    }\n  }\n}"