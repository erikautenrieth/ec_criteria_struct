{
  "AND": {
    "left": {
      "OR": {
        "left": {
          "AND": {
            "left": {
              "raw_text": "Patients residing in the following clinical states"
            },
            "right": {
              "AND": {
                "left": {
                  "raw_text": "A. Rising PSA"
                },
                "right": {
                  "AND": {
                    "left": {
                      "raw_text": "Patients with a history of localized disease"
                    },
                    "right": {
                      "AND": {
                        "left": {
                          "raw_text": "who have undergone definitive radiation or surgery"
                        },
                        "right": {
                          "AND": {
                            "left": {
                              "raw_text": "These patients must demonstrate progression of disease biochemically as outlined below"
                            },
                            "right": {
                              "raw_text": "Patients in this group may not have radiographically evident disease"
                            }
                          }
                        }
                      }
                    }
                  }
                },
                "OR": {
                  "left": {
                    "raw_text": "B. Non-castrate metastatic"
                  },
                  "right": {
                    "AND": {
                      "left": {
                        "raw_text": "Patients must present with radiographic evidence of metastatic disease"
                      },
                      "right": {
                        "AND": {
                          "left": {
                            "raw_text": "at the time of diagnosis or after treatment for localized disease"
                          },
                          "right": {
                            "AND": {
                              "left": {
                                "raw_text": "These patients must show newly detected disease or progressing disease in bone or in soft tissue"
                              },
                              "right": {
                                "raw_text": "Biochemical progression is defined as: minimum no. of determinations: 3 Interval: >2 weeks Minimal Baseline PSA value (ng/ml): 2 Minimal % increase in range of values: 50%"
                              }
                            }
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "right": {
          "AND": {
            "left": {
              "raw_text": "Diagnosis of prostate adenocarcinoma histologically confirmed at MSKCC"
            },
            "right": {
              "AND": {
                "left": {
                  "raw_text": "Patient must have level of serum testosterone above the lower limit of normal"
                },
                "right": {
                  "AND": {
                    "left": {
                      "raw_text": "Karnofsky performance status (KPS) >70%"
                    },
                    "right": {
                      "AND": {
                        "left": {
                          "raw_text": "Patients must have adequate organ function as defined by the following laboratory criteria"
                        },
                        "right": {
                          "AND": {
                            "left": {
                              "raw_text": "WBC >3500/mm3"
                            },
                            "right": {
                              "AND": {
                                "left": {
                                  "raw_text": "platelet count >100,000/mm3"
                                },
                                "right": {
                                  "AND": {
                                    "left": {
                                      "raw_text": "Bilirubin <2.0 mg/dl or SGOT <3.0 X the upper limit of normal"
                                    },
                                    "right": {
                                      "AND": {
                                        "left": {
                                          "raw_text": "Creatinine <1.6 mg/dl or creatinine clearance >60 cc/min"
                                        }
                                      }
                                    }
                                  }
                                }
                              }
                            }
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "right": {
      "AND": {
        "left": {
          "raw_text": "Prior hormonal therapy is allowed as:"
        },
        "right": {
          "OR": {
            "left": {
              "raw_text": "1. Neoadjuvant treatment prior to radiation therapy or radical prostatectomy, provided that the total duration of exposure does not exceed 10 months"
            },
            "right": {
              "raw_text": "2. One cycle of intermittent therapy up to a maximum exposure of 10 months"
            }
          }
        }
      }
    }
  }
