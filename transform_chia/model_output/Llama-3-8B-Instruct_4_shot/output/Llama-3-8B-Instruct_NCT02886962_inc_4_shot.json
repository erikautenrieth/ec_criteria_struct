"{\n  \"AND\": {\n    \"left\": {\n      \"AND\": {\n        \"left\": {\n          \"raw_text\": \"Adult patients\"\n        },\n        \"right\": {\n          \"raw_text\": \"(= 18 years)\"\n        }\n      }\n    },\n    \"right\": {\n      \"AND\": {\n        \"left\": {\n          \"OR\": {\n            \"left\": {\n              \"raw_text\": \"Patient on hemodialysis treatment for at least 1 month\"\n            }\n          }\n        },\n        \"right\": {\n          \"AND\": {\n            \"left\": {\n              \"OR\": {\n                \"left\": {\n                  \"raw_text\": \"Patient with a history of, or presenting a new episode of atrial fibrillation\"\n                }\n              }\n            },\n            \"right\": {\n              \"AND\": {\n                \"left\": {\n                  \"OR\": {\n                    \"left\": {\n                      \"raw_text\": \"Patient with a CHADS2VASC score =2\"\n                    }\n                    }\n                  }\n                },\n                \"right\": {\n                  \"AND\": {\n                    \"left\": {\n                      \"OR\": {\n                        \"left\": {\n                          \"raw_text\": \"Patient with high risk of bleeding as defined by\"\n                        }\n                      }\n                    },\n                    \"right\": {\n                      \"OR\": {\n                        \"left\": {\n                          \"OR\": {\n                            \"left\": {\n                              \"raw_text\": \"(1) HASBLED score =3\"\n                            },\n                            \"right\": {\n                              \"OR\": {\n                                \"left\": {\n                                  \"raw_text\": \"OR (2) HASBLED = CHADS2VASC score,\"\n                                },\n                                \"right\": {\n                                  \"