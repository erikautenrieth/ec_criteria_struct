"{\n  \"AND\": {\n    \"left\": {\n      \"OR\": {\n        \"left\": {\n          \"raw_text\": \"Patient not expected to survive more than 4 days\"\n        },\n        \"right\": {\n          \"OR\": {\n            \"left\": {\n              \"raw_text\": \"Patient allergic to a penicillin or a carbapenem\"\n            },\n            \"right\": {\n              \"raw_text\": \"\"\n            }\n          }\n        }\n      }\n    },\n    \"right\": {\n      \"AND\": {\n        \"left\": {\n          \"NOT\": {\n            \"left\": {\n              \"raw_text\": \"Patient with significant polymicrobial bacteraemia\"\n            }\n          }\n        },\n        \"right\": {\n          \"AND\": {\n            \"left\": {\n              \"NOT\": {\n                \"left\": {\n                  \"raw_text\": \"Treatment is not with the intent to cure the infection\"\n                }\n              }\n            },\n            \"right\": {\n              \"OR\": {\n                \"left\": {\n                  \"raw_text\": \"Pregnancy\"\n                },\n                \"right\": {\n                  \"raw_text\": \"or breast-feeding.\"\n                }\n              }\n            }\n          }\n        }\n      }\n    }\n  },\n  \"AND\": {\n    \"left\": {\n      \"NOT\": {\n        \"left\": {\n          \"raw_text\": \"Use of concomitant antimicrobials in the first 4 days after enrolment with known activity against Gram-negative bacilli\"\n        }\n      }\n    },\n    \"right\": {\n      \"OR\": {\n        \"left\": {\n          \"raw_text\": \"Severe acute illness as defined by Pitt bacteraemia score of >4\"\n        },\n        \"right\": {\n          \"raw_text\": \"Likely source to be from (proven or suspected at the time of randomisation) the central nervous system, e.g. brain abscess, post-surgical meningitis, shunt infection\"\n        }\n      }\n    }\n  }\n}"