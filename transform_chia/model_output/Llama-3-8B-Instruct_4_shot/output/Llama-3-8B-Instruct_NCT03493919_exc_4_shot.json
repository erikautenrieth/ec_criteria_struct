"{\n  \"AND\": {\n    \"left\": {\n      \"OR\": {\n        \"left\": {\n          \"raw_text\": \"Progressive, unstable or uncontrolled clinical conditions.\"\n        },\n        \"right\": {\n          \"OR\": {\n            \"left\": {\n              \"raw_text\": \"Hypersensitivity, including allergy, to any component of vaccines, medicinal products or medical equipment whose use is foreseen in this study.\"\n            },\n            \"right\": {\n              \"OR\": {\n                \"left\": {\n                  \"raw_text\": \"Clinical conditions representing a contraindication to intramuscular vaccination and blood draws.\"\n                },\n                \"right\": {\n                  \"OR\": {\n                    \"left\": {\n                      \"raw_text\": \"Clinical conditions.\"\n                    },\n                    \"right\": {\n                      \"AND\": {\n                        \"left\": {\n                          \"raw_text\": \"Systemic administration of corticosteroids (PO/IV/IM) within 90 days prior to informed consent.\"\n                        },\n                        \"right\": {\n                          \"AND\": {\n                            \"left\": {\n                              \"raw_text\": \"Administration of antineoplastic and immunomodulating agents or radiotherapy within 90 days prior to informed consent.\"\n                            },\n                            \"right\": {\n                              \"OR\": {\n                                \"left\": {\n                                  \"raw_text\": \"Received immunoglobulins or any blood products within 180 days prior to informed consent.\"\n                                },\n                                \"right\": {\n                                  \"OR\": {\n                                    \"left\": {\n                                      \"raw_text\": \"Received an investigational or non-registered medicinal product within 30 days prior to informed consent.\"\n                                    },\n                                    \"right\": {\n                                      \"OR\": {\n                                        \"left\": {\n                                          \"raw_text\": \"Any other clinical condition that, in the opinion of the investigator, might pose additional risk to the subject due to participation in the study.\"\n                                        },\n                                        \"right\": {\n                                          \"OR\": {\n                                            \"left\": {\n                                              \"raw_text\": \"Any history of meningococcal vaccination or meningococcal and gonorrhoea diseases.\"\n                                            },\n                                            \"right\": {\n                                              \"OR\": {\n                                                \"left\": {\n                                                  \"raw_text\": \"Enrolment in any activity requiring a blood donation greater than 50 mL during the period starting 30 days before the first study visit (Day -83, Day -60 or Day -30) or for the duration of the study period.\"\n                                                },\n                                                \"right\": {\n                                                  \"AND\": {\n                                                    \"left\": {\n                                                      \"raw_text\": \"Administration of long-acting immune-modifying drugs at any time during the study period\"\n                                                    },\n                                                    \"right\": {\n                                                      \"OR\": {\n                                                        \"left\": {\n                                                          \"raw_text\": \"Subjects with blood disorders.\"\n                                                        },\n                                                        \"right\": {\n                                                          \"OR\": {\n                                                            \"left\": {\n                                                              \"raw_text\": \"Subjects with a history of difficulty in providing blood samples\"\n                                                            },\n                                                            \"right\": {\n                                                              \"OR\": {\n                                                                \"left\": {\n                                                                  \"raw_text\": \"Any antibiotic intake 7 days prior to blood collection.\"\n                                                                },\n                                                                \"right\": {\n                                                                  \"OR\": {\n                                                                    \"left\": {\n                                                                      \"raw_text\": \"Subjects who donated >450 mL of blood within 60 days prior to any blood collection visits.\"\n                                                                    },\n                                                                    \"right\": {\n                                                                      \"OR\": {\n                                                                        \"left\": {\n                                                                          \"raw_text\": \"Subjects who lost >200 mL during a single apheresis or who lost red blood cells on more than one occasion during apheresis within the previous 60 days.\"\n                                                                        },\n                                                                        \"right\": {\n                                                                          \"OR\": {\n                                                                            \"left\": {\n                                                                              \"raw_text\": \"Concurrently participating in another clinical study, at any time during the study period, in which the subject has been or will be exposed to an investigational or a non-investigational vaccine/product\"\n                                                                            },\n                                                                            \"right\": {\n                                                                              \"OR\": {\n                                                                                \"left\": {\n                                                                                  \"raw_text\": \"Ongoing anaemia as indicated by haemoglobin values below the lower limit of the laboratory-specified reference range. If the finger prick method demonstrates an anaemia, no further protocol procedures will be performed, and the subject will be referred for appropriate medical management. The subject may participate in this study following therapy and evidence that the anaemia has been resolved.\"\n                                                                                },\n                                                                                \"right\": {\n                                                                                  \"OR\": {\n                                                                                    \"left\": {\n                                                                                      \"raw_text\": \"History of any reaction or hypersensitivity likely to be exacerbated by any component of the vaccines.\"\n                                                                                    },\n                                                                                    \"right\": {\n                                                                                      \"OR\": {\n                                                                                        \"left\": {\n                                                                                          \"raw_text\": \"Pregnant or lactating female.\"\n                                                                                        },\n                                                                                        \"right\": {\n                                                                                          \"OR\": {\n                                                                                            \"left\": {\n                                                                                              \"raw_text\": \"Female planning to become pregnant or planning to discontinue contraceptive precautions.\"\n                                                                                            },\n                                                                                            \"right\": {\n                                                                                              \"OR\": {\n                                                                                                \"left\": {\n                                                                                                  \"raw_text\": \"Any confirmed or suspected immunosuppressive or immunodeficiency condition based on medical history and physical examination\"\n                                                                                                },\n                                                                                      