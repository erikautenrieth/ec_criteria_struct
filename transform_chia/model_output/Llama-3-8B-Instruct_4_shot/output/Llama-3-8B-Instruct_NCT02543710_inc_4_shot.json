"{\n  \"AND\": {\n    \"left\": {\n      \"OR\": {\n        \"left\": {\n          \"raw_text\": \"All patients referred to a participating research centre\"\n        },\n        \"right\": {\n          \"OR\": {\n            \"left\": {\n              \"raw_text\": \"with suspicion of\"\n            },\n            \"right\": {\n              \"raw_text\": \"or confirmed endometrial cancer.\"\n            }\n          }\n        }\n      }\n    },\n    \"right\": {\n      \"AND\": {\n        \"left\": {\n          \"OR\": {\n            \"left\": {\n              \"raw_text\": \"Patients with endometrial\"\n            },\n            \"right\": {\n              \"OR\": {\n                \"left\": {\n                  \"raw_text\": \"or epithelial ovarian cancer\"\n                },\n                \"right\": {\n                  \"raw_text\": \"who following routine clinical guidelines are offered weekly taxane (paclitaxel) treatment.\"\n                }\n              }\n            }\n          }\n        },\n        \"right\": {\n          \"AND\": {\n            \"left\": {\n              \"raw_text\": \"This will often be a third or fourth line treatment, i.e. patients with advanced disease.\"\n            },\n            \"right\": {\n              \"AND\": {\n                \"left\": {\n                  \"raw_text\": \"Technical possibility to obtain a new tissue biopsy\"\n                },\n                \"right\": {\n                  \"raw_text\": \"to determine stathmin level in the tumour recurrence.\"\n                }\n              }\n            }\n          }\n        }\n      }\n    }\n  }\n}"