"{\n  \"AND\": {\n    \"left\": {\n      \"AND\": {\n        \"left\": {\n          \"OR\": {\n            \"left\": {\n              \"raw_text\": \"Healthy male\"\n            },\n            \"right\": {\n              \"raw_text\": \"and/or female subjects\"\n            }\n          }\n        },\n        \"right\": {\n          \"AND\": {\n            \"left\": {\n              \"AND\": {\n                \"left\": {\n                  \"raw_text\": \"between the ages of 18\"\n                },\n                \"right\": {\n                  \"raw_text\": \"and 55 years\"\n                }\n              }\n            },\n            \"right\": {\n              \"AND\": {\n                \"left\": {\n                  \"raw_text\": \"with body mass index (BMI) of ≥ 18\"\n                },\n                \"right\": {\n                  \"raw_text\": \"and ≤ 33 kg/m2\"\n                }\n              }\n            }\n          }\n        }\n      },\n      \"right\": {\n        \"AND\": {\n          \"left\": {\n            \"AND\": {\n              \"left\": {\n                \"raw_text\": \"with body weight ≥ 50\"\n                },\n                \"right\": {\n                  \"raw_text\": \"and ≤ 90 kg at screening.\"\n                }\n              }\n            }\n          },\n          \"right\": {\n            \"AND\": {\n              \"left\": {\n                \"AND\": {\n                  \"left\": {\n                    \"OR\": {\n                      \"left\": {\n                        \"raw_text\": \"Females must have been surgically sterilized\"\n                      },\n                      \"right\": {\n                        \"OR\": {\n                          \"left\": {\n                            \"raw_text\": \"at least 6 months before screening\"\n                          },\n                          \"right\": {\n                            \"OR\": {\n                              \"left\": {\n             