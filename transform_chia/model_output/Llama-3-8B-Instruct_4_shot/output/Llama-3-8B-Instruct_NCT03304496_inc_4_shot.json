"{\n  \"AND\": {\n    \"left\": {\n      \"AND\": {\n        \"left\": {\n          \"OR\": {\n            \"left\": {\n              \"raw_text\": \"Men\"\n            },\n            \"right\": {\n              \"raw_text\": \"and women\"\n            }\n          }\n        },\n        \"right\": {\n          \"AND\": {\n            \"left\": {\n              \"raw_text\": \"older than 18 years\"\n            },\n            \"right\": {\n              \"AND\": {\n                \"left\": {\n                  \"raw_text\": \"scheduled consecutively to perform a coronary procedure\"\n                },\n                \"right\": {\n                  \"raw_text\": \"in the department of hemodynamics of the National Institute of Cardiology \"Ignacio Chavez\"\"\n                }\n              }\n            }\n          }\n        }\n      },\n    \"right\": {\n      \"AND\": {\n        \"left\": {\n          \"OR\": {\n            \"left\": {\n              \"raw_text\": \"Patients may have any of the following indications for cardiac catheterization:\"\n            },\n            \"right\": {\n              \"OR\": {\n                \"left\": {\n                  \"raw_text\": \"Thoracic pain under study.\"\n                },\n                \"right\": {\n                  \"OR\": {\n                    \"left\": {\n                      \"raw_text\": \"Stable chronic coronary disease.\"\n                    },\n                    \"right\": {\n                      \"OR\": {\n                        \"left\": {\n                          \"raw_text\": \"Acute myocardial infarction with ST segment elevation, not perfused (without timely reperfusion therapy) with less than 4 weeks of evolution.\"\n                        },\n                        \"right\": {\n                          \"OR\": {\n                            \"left\": {\n                              \"raw_text\": \"Acute myocardial infarction with ST-segment elevation, successful thrombolytic therapy, which will undergo drug-invasive therapy.\"\n                            },\n                            \"right\": {\n                              \"OR\": {\n                                \"left\": {\n                                  \"raw_text\": \"Acute myocardial infarction without ST segment elevation.\"\n                                },\n                                \"right\": {\n                                  \"OR\": {\n                                    \"left\": {\n                                      \"raw_text\": \"Unstable angina.\"\n                                    },\n                                    \"right\": {\n                                      \"OR\": {\n                                        \"left\": {\n                                          \"raw_text\": \"Any acute coronary syndrome, to intervene non-infarct-related artery.\"\n                                        },\n                                        \"right\": {\n                                          \"OR\": {\n                                            \"left\": {\n                                              \"raw_text\": \"Disease of any heart valve.\"\n                                            },\n                                            \"right\": {\n                                              \"OR\": {\n                                                \"left\": {\n                                                  \"raw_text\": \"Myocarditis or pericarditis.\"\n                                                },\n                                                \"right\": {\n                                                  \"OR\": {\n                                                    \"left\": {\n                                                      \"raw_text\": \"Dilated cardiomyopathy.\"\n                                                    },\n                                                    \"right\": {\n               