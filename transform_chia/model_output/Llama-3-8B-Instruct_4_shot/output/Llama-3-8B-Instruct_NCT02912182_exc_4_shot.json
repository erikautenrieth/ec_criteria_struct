"{\n  \"OR\": {\n    \"left\": {\n      \"OR\": {\n        \"left\": {\n          \"raw_text\": \"tinnitus\"\n        },\n        \"right\": {\n          \"raw_text\": \"or hearing loss\"\n        }\n      },\n      \"right\": {\n        \"raw_text\": \"with same debut as vertigo\"\n      }\n    }\n  },\n  \"AND\": {\n    \"left\": {\n      \"OR\": {\n        \"left\": {\n          \"raw_text\": \"history of bleeding peptic ulcer\"\n        },\n        \"right\": {\n          \"raw_text\": \"or glaucoma\"\n        }\n      }\n    },\n    \"right\": {\n      \"OR\": {\n        \"left\": {\n          \"OR\": {\n            \"left\": {\n              \"raw_text\": \"pregnancy\"\n            },\n            \"right\": {\n              \"raw_text\": \"or non-acceptance to use anticonception measures during 13 days after debut\"\n            }\n          }\n        },\n        \"right\": {\n          \"OR\": {\n            \"left\": {\n              \"raw_text\": \"high blood pressure >180 systolic, 105, diastolic\"\n            },\n            \"right\": {\n              \"raw_text\": \"or ketoacidosis with a Base Excess >=2\"\n            }\n          }\n        }\n      }\n    }\n  },\n  \"AND\": {\n    \"left\": {\n      \"OR\": {\n        \"left\": {\n          \"raw_text\": \"psychic disorder (not including mild depression)\"\n        },\n        \"right\": {\n          \"raw_text\": \"or serious infection (neutropenia, tuberculosis)\"\n        }\n      }\n    },\n    \"right\": {\n      \"OR\": {\n        \"left\": {\n          \"raw_text\": \"chronic otitis\"\n        },\n        \"right\": {\n          \"raw_text\": \"or history of vertiginous disease; Ménière, Vertiginous migraine, atypical BPPV\"\n        }\n      }\n    }\n  }\n}"