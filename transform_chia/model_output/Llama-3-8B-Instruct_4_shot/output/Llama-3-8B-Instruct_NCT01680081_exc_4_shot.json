{
  "AND": {
    "left": {
      "OR": {
        "left": {
          "raw_text": "Contraindication of CT"
        },
        "right": {
          "OR": {
            "left": {
              "raw_text": "Known allergy to iodinated contrast media"
            },
            "right": {
              "raw_text": "or history of contrast-induced nephropathy"
            }
          }
        }
      }
    },
    "right": {
      "OR": {
        "left": {
          "raw_text": "Decreased renal function"
        },
        "right": {
          "AND": {
            "left": {
              "raw_text": "elevated serum creatinine"
            },
            "right": {
              "raw_text": "(>1.5mg/dl)"
            }
          }
        }
      }
    }
  },
  "AND": {
    "left": {
      "OR": {
        "left": {
          "raw_text": "Contraindication to beta-blockers"
        },
        "right": {
          "OR": {
            "left": {
              "raw_text": "Severe arrhythmia"
            },
            "right": {
              "AND": {
                "left": {
                  "raw_text": "arterial fibrillation"
                },
                "right": {
                  "OR": {
                    "left": {
                      "raw_text": "or uncontrolled tachyarrhythmia"
                    },
                    "right": {
                      "raw_text": ", or advanced atrioventricular block (second or third degree heart block)"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "right": {
      "OR": {
        "left": {
          "raw_text": "Contraindication of MRI"
        },
        "right": {
          "OR": {
            "left": {
              "raw_text": "Claustrophobia"
            },
            "right": {
              "OR": {
                "left": {
                  "raw_text": "Metallic hazards"
                },
                "right": {
                  "raw_text": "Pacemaker implant"
                }
              }
            }
          }
        }
      }
    }
  },
  "AND": {
    "left": {
      "OR": {
        "left": {
          "raw_text": "Unstable or uncooperative patients"
        },
        "right": {
          "OR": {
            "left": {
              "raw_text": "Limited life expectancy due to cancer"
            },
            "right": {
              "OR": {
                "left": {
                  "raw_text": "or end-stage renal or liver disease"
                }
              }
            }
          }
        }
      }
    },
    "right": {
      "OR": {
        "left": {
          "raw_text": "Evidence of severe symptomatic heart failure"
        },
        "right": {
          "raw_text": "(NYHA Class III or IV)"
        }
      }
    }
  },
  "AND": {
    "left": {
      "OR": {
        "left": {
          "raw_text": "Previous myocardial infarction"
        },
        "right": {
          "OR": {
            "left": {
              "raw_text": "coronary artery intervention"
            },
            "right": {
              "OR": {
                "left": {
                  "raw_text": "coronary artery bypass surgery"
                },
                "right": {
                  "raw_text": ", or other cardiac surgery"
                }
              }
            }
          }
        }
      }
    }
  }
}