"{\n  \"AND\": {\n    \"left\": {\n      \"OR\": {\n        \"left\": {\n          \"AND\": {\n            \"left\": {\n              \"raw_text\": \"Expected performance of PCI < 60 minutes from diagnosis (qualifying ECG)\"\n            },\n            \"right\": {\n              \"raw_text\": \"or inability to arrive at the catheterisation laboratory within 3 hours\"\n            }\n          }\n        },\n        \"right\": {\n          \"OR\": {\n            \"left\": {\n              \"raw_text\": \"Previous CABG\"\n            },\n            \"right\": {\n              \"OR\": {\n                \"left\": {\n                  \"raw_text\": \"Left bundle branch block or ventricular pacing\"\n                },\n                \"right\": {\n                  \"raw_text\": \"or Patients with cardiogenic shock - Killip Class 4\"\n                }\n              }\n            }\n          }\n        }\n      }\n    },\n    \"right\": {\n      \"AND\": {\n        \"left\": {\n          \"OR\": {\n            \"left\": {\n              \"raw_text\": \"Patients with a body weight < 55 kg (known or estimated)\"\n            },\n            \"right\": {\n              \"OR\": {\n                \"left\": {\n                  \"raw_text\": \"Uncontrolled hypertension, defined as sustained blood pressure = 180/110 mm Hg\"\n                },\n                \"right\": {\n                  \"AND\": {\n                    \"left\": {\n                      \"raw_text\": \"(systolic BP = 180 mm Hg and/or diastolic BP = 110 mm Hg) prior to randomisation\"\n                    }\n                  }\n                }\n              }\n            }\n          },\n          \"right\": {\n            \"OR\": {\n              \"left\": {\n                \"raw_text\": \"Known prior stroke or TIA\"\n              },\n              \"right\": {\n                \"AND\": {\n                  \"left\": {\n                    \"raw_text\": \"Recent administration of any i.v. or s.c. anticoagulation within 12 hours\"\n                  },\n                  \"right\": {\n                    \"OR\": {\n                      \"left\": {\n                        \"raw_text\": \"including unfractionated heparin, enoxaparin, and/or bivalirudin\"\n                      },\n                      \"right\": {\n                        \"OR\": {\n                          \"left\": {\n                            \"raw_text\": \"or current use of oral anticoagulation (i.e. warfarin or a NOACs)\"\n                          }\n                        }\n                      }\n                    }\n                  }\n                }\n              }\n            }\n          }\n        }\n      }\n    }\n  }\n}"