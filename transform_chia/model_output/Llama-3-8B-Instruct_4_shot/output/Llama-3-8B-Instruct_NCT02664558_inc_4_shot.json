"{\n  \"AND\": {\n    \"left\": {\n      \"OR\": {\n        \"left\": {\n          \"raw_text\": \"Male\"\n        },\n        \"right\": {\n          \"raw_text\": \"or female\"\n        }\n      }\n    },\n    \"right\": {\n      \"AND\": {\n        \"left\": {\n          \"raw_text\": \"Has a diagnosis of WHO Group 1 PAH\"\n        },\n        \"right\": {\n          \"AND\": {\n            \"left\": {\n              \"raw_text\": \"Right heart catheterization performed at Screening with results that are:\"\n            },\n            \"right\": {\n              \"AND\": {\n                \"left\": {\n                  \"AND\": {\n                    \"left\": {\n                      \"raw_text\": \"Mean pulmonary arterial pressure ≥25 mmHg\"\n                    },\n                    \"right\": {\n                      \"raw_text\": \"(at rest) and\"\n                    }\n                  },\n                  \"right\": {\n                    \"AND\": {\n                      \"left\": {\n                        \"raw_text\": \"Pulmonary venous hypertension (measured as pulmonary capillary wedge pressure (PCWP) ≤15 mmHg\"\n                      },\n                      \"right\": {\n                        \"OR\": {\n                          \"left\": {\n                            \"raw_text\": \"If PCWP is not available, then mean left atrial pressure or left ventricular end-diastolic pressure ≤15 mmHg\"\n                          },\n                          \"right\": {\n                            \"raw_text\": \"in the absence of left atrial obstruction.\"\n                          }\n                        }\n                      }\n                    }\n                  }\n                },\n                \"right\": {\n                  \"AND\": {\n                    \"left\": {\n                      \"raw_text\": \"Pulmonary vascular resistance (PVR) ≥300 dyn•s/cm5\"\n                    },\n                    \"right\": {\n      