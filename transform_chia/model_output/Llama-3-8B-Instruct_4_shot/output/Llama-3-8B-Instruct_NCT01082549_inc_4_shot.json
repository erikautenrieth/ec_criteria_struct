{
  "AND": {
    "left": {
      "OR": {
        "left": {
          "AND": {
            "left": {
              "AND": {
                "left": {
                  "AND": {
                    "left": {
                      "AND": {
                        "left": {
                          "AND": {
                            "left": {
                              "raw_text": "Newly diagnosed"
                            },
                            "right": {
                              "raw_text": ", stage IV squamous cell lung cancer."
                            }
                          }
                        },
                        "right": {
                          "OR": {
                            "left": {
                              "raw_text": "This includes patients who present with disseminated metastases"
                            },
                            "right": {
                              "OR": {
                                "left": {
                                  "raw_text": "and those with a malignant pleural"
                                },
                                "right": {
                                  "raw_text": "or pericardial effusion (i.e., formerly stage IIIB in the 6th TNM staging system)"
                                }
                              }
                            }
                          }
                        }
                      }
                    },
                    "right": {
                      "OR": {
                        "left": {
                          "raw_text": "Patients who have received prior adjuvant therapy"
                        },
                        "right": {
                          "AND": {
                            "left": {
                              "raw_text": "for early-stage lung cancer"
                            },
                            "right": {
                              "raw_text": "are eligible if at least 12 months have elapsed from that treatment."
                            }
                          }
                        }
                      }
                    }
                  }
                },
                "right": {
                  "AND": {
                    "left": {
                      "raw_text": "Histologically confirmed squamous cell bronchogenic carcinoma"
                    },
                    "right": {
                      "OR": {
                        "left": {
                          "raw_text": "Patients whose tumors contain mixed non-small cell histologies"
                        },
                        "right": {
                          "AND": {
                            "left": {
                              "raw_text": "are eligible, as long as squamous carcinoma is the predominant histology."
                            },
                            "right": {
                              "OR": {
                                "left": {
                                  "raw_text": "Mixed tumors with small cell anaplastic elements are not eligible."
                                }
                              }
                            }
                          }
                        }
                      }
                    }
                  }
                }
              }
            },
            "right": {
              "AND": {
                "left": {
                  "raw_text": "Patients with previous radiotherapy"
                },
                "right": {
                  "OR": {
                    "left": {
                      "raw_text": "as definitive therapy for locally advanced non-small cell lung cancer"
                    },
                    "right": {
                      "AND": {
                        "left": {
                          "raw_text": "are eligible, as long as the recurrence is outside the original radiation therapy port."
                        },
                        "right": {
                          "OR": {
                            "left": {
                              "raw_text": "Radiation therapy must have been completed >4 weeks prior to the initiation of study treatment."
                            }
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "right": {
          "OR": {
            "left": {
              "raw_text": "Patients who have received chemo/radiation for locally advanced NSCLC are not eligible."
            }
          }
        }
      }
    },
    "right": {
      "OR": {
        "left": {
          "AND": {
            "left": {
              "AND": {
                "left": {
                  "raw_text": "Presence of evaluable (measureable or non-measurable) disease"
                }
              }
            },
            "right": {
              "OR": {
                "left": {
                  "raw_text": "ECOG Performance Status of 0"
                },
                "right": {
                  "OR": {
                    "left": {
                      "raw_text": "or 1."
                    }
                  }
                }
              }
            }
          }
        },
        "right": {
          "AND": {
            "left": {
              "AND": {
                "left": {
                  "AND": {
                    "left": {
                      "AND": {
                        "left": {
                          "AND": {
                            "left": {
                              "raw_text": "Laboratory values as follows"
                            }
                          }
                        },
                        "right": {
                          "OR": {
                            "left": {
                              "raw_text": "Absolute neutrophil count (ANC) >1,500/microL"
                            },
                            "right": {
                              "AND": {
                                "left": {
                                  "raw_text": "and platelets >100,000/microL"
                                },
                                "right": {
                                  "OR": {
                                    "left": {
                                      "raw_text": "(≤72 hours prior to initial treatment)."
                                    }
                                  }
                                }
                              }
                            }
                          }
                        }
                      }
                    },
                    "right": {
                      "OR": {
                        "left": {
                          "raw_text": "Hemoglobin >9 g/dL"
                        },
                        "right": {
                          "OR": {
                            "left": {
                              "raw_text": "Bilirubin < ULN"
                            }
                          }
                        }
                      }
                    }
                  }
                },
                "right": {
                  "OR": {
                    "left": {
                      "raw_text": "Alanine aminotransferase (ALT) and aspartate aminotransferase (AST) ≤2.5 times the upper limit of normal"
                    },
                    "right": {
                      "OR": {
                        "left": {
                          "raw_text": "if no liver involvement"
                        },
                        "right": {
                          "OR": {
                            "left": {
                              "raw_text": "or ≤5 times the upper limit of normal with liver involvement."
                            }
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}