"{\n  \"AND\": {\n    \"left\": {\n      \"OR\": {\n        \"left\": {\n          \"raw_text\": \"Males\"\n        },\n        \"right\": {\n          \"raw_text\": \"and females\"\n        }\n      },\n      \"right\": {\n        \"AND\": {\n          \"left\": {\n            \"raw_text\": \"≥ 18 years old.\"\n          }\n        }\n      }\n    },\n    \"right\": {\n      \"AND\": {\n        \"left\": {\n          \"raw_text\": \"Clinical diagnosis of type 1 diabetes\"\n        },\n        \"right\": {\n          \"AND\": {\n            \"left\": {\n              \"raw_text\": \"for at least one year.\"\n            }\n          }\n        }\n      }\n    }\n  },\n  \"AND\": {\n    \"left\": {\n      \"AND\": {\n        \"left\": {\n          \"raw_text\": \"The subject will have been on insulin pump therapy\"\n        },\n        \"right\": {\n          \"AND\": {\n            \"left\": {\n              \"raw_text\": \"for at least 3 months\"\n            },\n            \"right\": {\n              \"raw_text\": \"and currently using a fast actin insulin analog (Lispro, Aspart or Guilisine).\"\n            }\n          }\n        }\n      }\n    },\n    \"right\": {\n      \"AND\": {\n        \"left\": {\n          \"raw_text\": \"Last (less than 3 months) HbA1c ≤ 10%.\"\n        }\n      }\n    }\n  },\n  \"AND\": {\n    \"left\": {\n      \"raw_text\": \"Currently using carbohydrate counting as the meal insulin dose strategy.\"\n    }\n  }\n}"