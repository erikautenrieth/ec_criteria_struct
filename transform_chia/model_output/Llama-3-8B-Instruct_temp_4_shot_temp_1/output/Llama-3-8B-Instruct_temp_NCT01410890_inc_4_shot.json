{
  "AND": {
    "left": {
      "AND": {
        "left": {
          "raw_text": "The patient and/or the patient's parent/legal guardian is willing and able to provide signed informed consent."
        }
      },
      "right": {
        "OR": {
          "left": {
            "raw_text": "The patient has a confirmed GAA enzyme deficiency"
          },
          "right": {
            "AND": {
              "left": {
                "raw_text": "from skin, blood, or muscle tissue"
              },
              "right": {
                "OR": {
                  "left": {
                    "raw_text": "and/or"
                  },
                  "right": {
                    "raw_text": "2 confirmed GAA gene mutations."
                  }
                }
              }
            }
          }
        }
      }
    },
    "right": {
      "AND": {
        "left": {
          "OR": {
            "left": {
              "raw_text": "Infant and toddler Pompe disease patients"
            },
            "right": {
              "AND": {
                "left": {
                  "raw_text": "can be included in the study only under condition (minimal body weight)"
                },
                "right": {
                  "AND": {
                    "left": {
                      "raw_text": "that the trial-related blood loss"
                    },
                    "right": {
                      "AND": {
                        "left": {
                          "raw_text": "including any losses in the maneuver"
                        },
                        "right": {
                          "raw_text": "will not exceed 3 percent of the total blood volume during a period of 4 weeks"
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "right": {
          "OR": {
            "left": {
              "raw_text": "and will not exceed 1 percent at any single time."
            }
          }
        }
      }
    }
  },
  "AND": {
    "left": {
      "AND": {
        "left": {
          "raw_text": "The patient, if female and of childbearing potential,"
        },
        "right": {
          "AND": {
            "left": {
              "raw_text": "must have a negative pregnancy test"
            },
            "right": {
              "raw_text": "(urine beta-human chorionic gonadotropin) at screening."
            }
          }
        }
      }
    },
    "right": {
      "AND": {
        "left": {
          "raw_text": "Note: All female patients of childbearing potential"
        },
        "right": {
          "AND": {
            "left": {
              "raw_text": "and sexually mature males"
            },
            "right": {
              "raw_text": "must agree to use a medically accepted method of contraception throughout the study."
            }
          }
        }
      }
    }
  },
  "AND": {
    "left": {
      "AND": {
        "left": {
          "raw_text": "For patients previously treated with alglucosidase alfa"
        },
        "right": {
          "AND": {
            "left": {
              "raw_text": "the patient has received alglucosidase alfa"
            },
            "right": {
              "raw_text": "for at least 6 months."
            }
          }
        }
      }
    }
  }
