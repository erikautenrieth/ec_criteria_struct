"{\n  \"AND\": {\n    \"left\": {\n      \"AND\": {\n        \"left\": {\n          \"raw_text\": \"Aged at least 18 years\"\n        }\n      },\n      \"right\": {\n        \"AND\": {\n          \"left\": {\n            \"OR\": {\n              \"left\": {\n                \"raw_text\": \"The presence of a solid, malignant tumour\"\n              },\n              \"right\": {\n                \"NOT\": {\n                  \"left\": {\n                    \"raw_text\": \"excluding lymphoma\"\n                  }\n                }\n              }\n            }\n          },\n          \"right\": {\n            \"AND\": {\n              \"left\": {\n                \"raw_text\": \"that is resistance to standard therapies\"\n              },\n              \"right\": {\n                \"OR\": {\n                  \"left\": {\n                    \"raw_text\": \"or for which no standard therapies exist\"\n                  }\n                }\n              }\n            }\n          }\n        }\n      }\n    },\n    \"right\": {\n      \"AND\": {\n        \"left\": {\n          \"AND\": {\n            \"left\": {\n              \"raw_text\": \"The presence of at least one lesion\"\n            },\n            \"right\": {\n              \"raw_text\": \"that can be accurately assessed at baseline by Computerised Tomography (CT), Magnetic Resonance Imaging (MRI) or plain X-ray and is suitable for repeated assessment\"\n            }\n          }\n        },\n        \"right\": {\n          \"raw_text\": \"Estimated life expectancy of more than 12 weeks\"\n        }\n      }\n    }\n  }\n}"