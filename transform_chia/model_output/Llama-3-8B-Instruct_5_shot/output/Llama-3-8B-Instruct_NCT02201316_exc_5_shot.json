"{\n  \"AND\": {\n    \"left\": {\n      \"OR\": {\n        \"left\": {\n          \"raw_text\": \"Current or chronic history of liver disease\"\n        },\n        \"right\": {\n          \"OR\": {\n            \"left\": {\n              \"raw_text\": \"or known hepatic or biliary abnormalities\"\n            },\n            \"right\": {\n              \"NOT\": {\n                \"left\": {\n                  \"OR\": {\n                    \"left\": {\n                      \"raw_text\": \"with the exception of Gilbert's syndrome\"\n                    },\n                    \"right\": {\n                      \"raw_text\": \"or asymptomatic gallstones.\"\n                    }\n                  }\n                }\n              }\n            }\n          }\n        }\n      }\n    },\n    \"right\": {\n      \"AND\": {\n        \"left\": {\n          \"OR\": {\n            \"left\": {\n              \"raw_text\": \"History of regular alcohol consumption within 6 months of the study\"\n            },\n            \"right\": {\n              \"AND\": {\n                \"left\": {\n                  \"raw_text\": \"defined as: An average weekly intake of >21 units for males\"\n                },\n                \"right\": {\n                  \"OR\": {\n                    \"left\": {\n                      \"raw_text\": \"or >14 units for females. One unit is equivalent to 8 gram of alcohol: a half-pint (approximately 240 milliliter [mL]) of beer, 1 glass (100 mL) of wine or 1 (25 mL) measure of spirits.\"\n                    }\n                  }\n                }\n              }\n            }\n          }\n        },\n        \"right\": {\n          \"AND\": {\n            \"left\": {\n              \"OR\": {\n                \"left\": {\n                  \"raw_text\": \"History of sensitivity to heparin or heparin-induced thrombocytopenia.\"\n                },\n                \"right\": {\n                  \"raw_text\": \"or a history of drug or other allergy that, in the opinion of the investigator or GSK Medical Monitor, contraindicates their participation.\"\n                }\n              }\n            },\n            \"right\": {\n              \"AND\": {\n                \"left\": {\n                  \"raw_text\": \"Gastrointestinal disease or with gastrointestinal surgical history which can affect the absorption of the investigational product.\"\n                }\n              }\n            }\n          }\n        }\n      }\n    }\n  }\n}"