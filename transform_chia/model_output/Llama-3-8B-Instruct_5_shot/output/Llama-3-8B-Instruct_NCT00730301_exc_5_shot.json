"{\n  \"AND\": {\n    \"left\": {\n      \"OR\": {\n        \"left\": {\n          \"raw_text\": \"Prior endobronchial treatment for emphysema\"\n        },\n        \"right\": {\n          \"OR\": {\n            \"left\": {\n              \"raw_text\": \"Pleural or interstitial disease that precludes surgery\"\n            },\n            \"right\": {\n              \"raw_text\": \"or prior lung transplant, LVRS, median sternotomy, bullectomy or lobectomy\"\n            }\n          }\n        }\n      }\n    },\n    \"right\": {\n      \"AND\": {\n        \"left\": {\n          \"OR\": {\n            \"left\": {\n              \"raw_text\": \"Clinically significant bronchiectasis\"\n            },\n            \"right\": {\n              \"OR\": {\n                \"left\": {\n                  \"raw_text\": \"Pulmonary nodule requiring surgery\"\n                },\n                \"right\": {\n                  \"raw_text\": \"or history of recurrent respiratory infections (> 3 hospitalization in the last year)\"\n                }\n              }\n            }\n          }\n        },\n        \"right\": {\n          \"AND\": {\n            \"left\": {\n              \"OR\": {\n                \"left\": {\n                  \"raw_text\": \"Clinically significant (> 4 Tablespoons per day) sputum production\"\n                },\n                \"right\": {\n                  \"OR\": {\n                    \"left\": {\n                      \"raw_text\": \"Fever, elevated white cell count, or other evidence of active infection\"\n                    },\n                    \"right\": {\n                      \"raw_text\": \"or dysrhythmia that might pose a risk during exercise or training\"\n                    }\n                  }\n                }\n              }\n            },\n            \"right\": {\n              \"AND\": {\n                \"left\": {\n                  \"OR\": {\n                    \"left\": {\n                      \"raw_text\