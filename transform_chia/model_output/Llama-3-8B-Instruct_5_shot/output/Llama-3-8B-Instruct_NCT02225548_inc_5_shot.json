"{\n  \"AND\": {\n    \"left\": {\n      \"AND\": {\n        \"left\": {\n          \"raw_text\": \"Diagnosis of idiopathic Parkinson's disease\"\n        },\n        \"right\": {\n          \"AND\": {\n            \"left\": {\n              \"raw_text\": \"that is optimally treated (motor fluctuations <20% of subject's awake time)\"\n            },\n            \"right\": {\n              \"AND\": {\n                \"left\": {\n                  \"OR\": {\n                    \"left\": {\n                      \"raw_text\": \"Subjects may be on levodopa therapy\"\n                    },\n                    \"right\": {\n                      \"raw_text\": \"but must be stable at the time of entry into the study\"\n                    }\n                  }\n                }\n              }\n            }\n          }\n        }\n      },\n      \"right\": {\n        \"AND\": {\n          \"left\": {\n            \"AND\": {\n              \"left\": {\n                \"raw_text\": \"Sexually active (i.e. =1 attempt/week) males\"\n              },\n              \"right\": {\n                \"AND\": {\n                  \"left\": {\n                    \"raw_text\": \"40 - 64 years of age (inclusive) at time of screening\"\n                  }\n                }\n              }\n            }\n          },\n          \"right\": {\n            \"AND\": {\n              \"left\": {\n                \"AND\": {\n                  \"left\": {\n                    \"raw_text\": \"Diagnosis of moderate erectile dysfunction\"\n                  },\n                  \"right\": {\n                    \"raw_text\": \"(defined according to the NIH Consensus Development Panel on Impotence) for more than 6 months and demonstrating and incomplete response to tadalafil alone\"\n                    }\n                  }\n                }\n              }\n            }\n          }\n        }\n      }\n    }\n  }\n}"