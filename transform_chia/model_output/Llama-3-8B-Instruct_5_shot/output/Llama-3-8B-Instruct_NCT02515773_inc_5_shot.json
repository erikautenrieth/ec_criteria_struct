"{\n  \"AND\": {\n    \"left\": {\n      \"AND\": {\n        \"left\": {\n          \"OR\": {\n            \"left\": {\n              \"raw_text\": \"Inpatient\"\n            },\n            \"right\": {\n              \"OR\": {\n                \"left\": {\n                  \"raw_text\": \"or outpatient\"\n                },\n                \"right\": {\n                  \"raw_text\": \"age 8-19 years inclusive\"\n                }\n              }\n            }\n          }\n        },\n        \"right\": {\n          \"AND\": {\n            \"left\": {\n              \"raw_text\": \"participants must live with a parent, guardian, or caregiver\"\n            },\n            \"right\": {\n              \"AND\": {\n                \"left\": {\n                  \"raw_text\": \"Fluent in English\"\n                },\n                \"right\": {\n                  \"AND\": {\n                    \"left\": {\n                      \"OR\": {\n                        \"left\": {\n                          \"raw_text\": \"Diagnosed or told by a clinician that they have any of the following bipolar spectrum disorders (BSD): bipolar I, bipolar II, unspecified bipolar and related disorders, Disruptive Mood Dysregulation Disorder (DMDD), cyclothymic disorder, other specified bipolar and related disorders, as well as mood disorder not otherwise specified (if diagnosed in the past as per DSM-IV)\"\n                        },\n                        \"right\": {\n                          \"raw_text\": \"Body mass index >85%ile for age and sex by standard growth charts\"\n                        }\n                      }\n                    },\n                    \"right\": {\n                      \"AND\": {\n                        \"left\": {\n                          \"raw_text\": \"Received a new or ongoing prescription for at least one SGA (i.e., olanzapine, clozapine, risperidone, quetiapine, aripiprazole, ziprasidone, iloperidone, lurasidone, paliperidone, brexpiprazole or cariprazine) that is not prescribed as a PRN medication\"\n                        }\n                      }\n                    }\n                  }\n                }\n              }\n            }\n          }\n        }\n    }\n  }\n}"