"{\n  \"AND\": {\n    \"left\": {\n      \"OR\": {\n        \"left\": {\n          \"raw_text\": \"Current or past diagnoses of other Axis I psychiatric disorders\"\n        },\n        \"right\": {\n          \"NOT\": {\n            \"left\": {\n              \"OR\": {\n                \"left\": {\n                  \"raw_text\": \"except for generalized anxiety disorder (GAD) symptoms occurring during a depressive episode\"\n                }\n              }\n            }\n          }\n        }\n      }\n    },\n    \"right\": {\n      \"AND\": {\n        \"left\": {\n          \"OR\": {\n            \"left\": {\n              \"raw_text\": \"History of alcohol or drug dependence\"\n            },\n            \"right\": {\n              \"raw_text\": \"or abuse in the last three years\"\n            }\n          }\n        },\n        \"right\": {\n          \"AND\": {\n            \"left\": {\n              \"OR\": {\n                \"left\": {\n                  \"raw_text\": \"History of developmental disorder\"\n                },\n                \"right\": {\n                  \"raw_text\": \"or IQ score < 70\"\n                }\n              }\n            },\n            \"right\": {\n              \"AND\": {\n                \"left\": {\n                  \"OR\": {\n                    \"left\": {\n                      \"raw_text\": \"Presence of acute suicidality\"\n                    },\n                    \"right\": {\n                      \"raw_text\": \"or acute grief (< 1 month)\"\n                    }\n                  }\n                },\n                \"right\": {\n                  \"AND\": {\n                    \"left\": {\n                      \"OR\": {\n                        \"left\": {\n                          \"raw_text\": \"Current or past psychosis\"\n                        },\n                        \"right\": {\n                          \"raw_text\": \"or Primary neurological disorder, including but not limited