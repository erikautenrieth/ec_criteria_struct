"{\n  \"AND\": {\n    \"left\": {\n      \"raw_text\": \"Adult acute myeloid leukemia\"\n    },\n    \"right\": {\n      \"AND\": {\n        \"left\": {\n          \"AND\": {\n            \"left\": {\n              \"raw_text\": \"Age: ≥18\"\n            },\n            \"right\": {\n              \"raw_text\": \"and ≤ 60\"\n            }\n          }\n        },\n        \"right\": {\n          \"AND\": {\n            \"left\": {\n              \"OR\": {\n                \"left\": {\n                  \"raw_text\": \"Clinical condition of the patient allows to carry out induction therapy:\"\n                },\n                \"right\": {\n                  \"AND\": {\n                    \"left\": {\n                      \"raw_text\": \"ECOG performance status: ≤ 2\"\n                    },\n                    \"right\": {\n                      \"raw_text\": \"and the Hematopoietic Cell Transplant-Co-morbidity Index (HCT-I): ≤3\"\n                    }\n                  }\n                }\n              }\n            },\n            \"right\": {\n              \"AND\": {\n                \"left\": {\n                  \"raw_text\": \"Informed consent to participate in the study (ICF signed)\"\n                },\n                \"right\": {\n                  \"AND\": {\n                    \"left\": {\n                      \"raw_text\": \"The second early induction start criteria is in addition to the listed above, the percentage of the blasts on the level >10% on 7th day.\"\n                    }\n                  }\n                }\n              }\n            }\n          }\n        }\n      }\n    }\n  }\n}"