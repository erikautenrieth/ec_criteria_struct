                "left": {
                  "raw_text": "of one the following SRI's: fluoxetine 80 mg/day"
                },
                "right": {
                  "OR": {
                    "left": {
                      "raw_text": "paroxetine 60 mg/day"
                    },
                    "right": {
                      "OR": {
                        "left": {
                          "raw_text": "fluvoxamine 300 mg/day"
                        },
                        "right": {
                          "OR": {
                            "left": {
                              "raw_text": "clomipramine 250 mg/day"
                            },
                            "right": {
                              "OR": {
                                "left": {
                                  "raw_text": "sertraline 200 mg/day"
                                },
                                "right": {
                                  "OR": {
                                    "left": {
                                      "raw_text": "citalopram 60 mg/day"
                                    },
                                    "right": {
                                      "OR": {
                                        "left": {
                                          "raw_text": "escitalopram 30 mg/day"
                                        }
                                      }
                                    }
                                  }
                                }
                              }
                            }
                          }
                        }
                      }
                    }
                  }
                }
              },
              "AND": {
                "left": {
                  "raw_text": "and demonstrating a non or partial responses to SRI treatment"
                },
                "right": {
                  "OR": {
                    "left": {
                      "raw_text": "CGI-I of 3 or 4"
                    },
                    "right": {
                      "raw_text": "Y-BOCS reduction of < 35%"
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
