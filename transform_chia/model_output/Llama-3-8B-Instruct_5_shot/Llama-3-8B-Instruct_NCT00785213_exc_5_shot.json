"{\n  \"AND\": {\n    \"left\": {\n      \"OR\": {\n        \"left\": {\n          \"raw_text\": \"Recent participation (within 28 days) in other research studies\"\n        },\n        \"right\": {\n          \"raw_text\": \"Recent significant blood donation or plasma donation\"\n        }\n      }\n    },\n    \"right\": {\n      \"AND\": {\n        \"left\": {\n          \"OR\": {\n            \"left\": {\n              \"raw_text\": \"Pregnant\"\n            },\n            \"right\": {\n              \"raw_text\": \"or lactating\"\n            }\n          }\n        },\n        \"right\": {\n          \"AND\": {\n            \"left\": {\n              \"OR\": {\n                \"left\": {\n                  \"raw_text\": \"Test positive at screening for human immunodeficiency virus (HIV)\"\n                },\n                \"right\": {\n                  \"OR\": {\n                    \"left\": {\n                      \"raw_text\": \"hepatitis B surface antigen (HbsAg)\"\n                    },\n                    \"right\": {\n                      \"raw_text\": \"or hepatitis C virus (HCV)\"\n                    }\n                  }\n                }\n              }\n            },\n            \"right\": {\n              \"AND\": {\n                \"left\": {\n                  \"raw_text\": \"Recent (2-year) history or evidence of alcoholism or drug abuse\"\n                },\n                \"right\": {\n                  \"AND\": {\n                    \"left\": {\n                      \"OR\": {\n                        \"left\": {\n                          \"raw_text\": \"History or presence of significant cardiovascular\"\n                        },\n                        \"right\": {\n                          \"OR\": {\n                            \"left\": {\n                              \"raw_text\": \"pulmonary, hepatic, gallbladder or biliary tract, renal, hematologic, gastrointestinal, endocrine, immunologic, dermatologic, neur