"{\n  \"AND\": {\n    \"left\": {\n      \"OR\": {\n        \"left\": {\n          \"raw_text\": \"Established pre-existing diabetes\"\n        },\n        \"right\": {\n          \"AND\": {\n            \"left\": {\n              \"raw_text\": \"including unrecognised diabetes defined as a fasting plasma glucose = 7.0mmol/L\"\n            },\n            \"right\": {\n              \"OR\": {\n                \"left\": {\n                  \"raw_text\": \"and/ or HbA1c = 48mmol/mol\"\n                }\n              }\n            }\n          }\n        }\n      },\n      \"right\": {\n        \"OR\": {\n          \"left\": {\n            \"raw_text\": \"Contraindications to metformin therapy\"\n          },\n          \"right\": {\n            \"AND\": {\n              \"left\": {\n                \"raw_text\": \"creatinine = 130µmol/L\"\n              },\n              \"right\": {\n                \"OR\": {\n                  \"left\": {\n                    \"raw_text\": \"alanine transaminase = 2.0 x upper limit normal\"\n                  },\n                  \"right\": {\n                    \"raw_text\": \"previous intolerance to metformin\"\n                  }\n                }\n              }\n            }\n          }\n        }\n      }\n    }\n  },\n  \"right\": {\n    \"AND\": {\n      \"left\": {\n        \"OR\": {\n          \"left\": {\n            \"raw_text\": \"Planned continued antenatal care\"\n          },\n          \"right\": {\n            \"raw_text\": \"/ delivery at centre not included in trial\"\n          }\n        }\n      },\n      \"right\": {\n        \"OR\": {\n          \"left\": {\n            \"raw_text\": \"Planned fast for cultural/ religious reasons e.g. Ramadan\"\n          }\n        }\n      }\n    }\n  }\n}"