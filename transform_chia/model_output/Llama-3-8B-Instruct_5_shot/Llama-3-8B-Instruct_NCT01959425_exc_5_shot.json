"{\n  \"AND\": {\n    \"left\": {\n      \"NOT\": {\n        \"left\": {\n          \"OR\": {\n            \"left\": {\n              \"raw_text\": \"OAT required for reasons related to AF\"\n            },\n            \"right\": {\n              \"OR\": {\n                \"left\": {\n                  \"raw_text\": \"(i.e., prosthetic valve, PV stenosis, previous pulmonary embolism, presence of spontaneous echo contrast [SEC] at standard echo performed at 3-months follow-up)\"\n                }\n              }\n            }\n          }\n        }\n      }\n    },\n    \"right\": {\n      \"AND\": {\n        \"left\": {\n          \"OR\": {\n            \"left\": {\n              \"raw_text\": \"Any cardiac surgery within the past 60 days (2 months)\"\n            },\n            \"right\": {\n              \"OR\": {\n                \"left\": {\n                  \"raw_text\": \"or valvular cardiac surgical procedure at any time (i.e., ventriculotomy, atriotomy, and valve repair or replacement and presence of a prosthetic valve)\"\n                }\n              }\n            }\n          }\n        },\n        \"right\": {\n          \"AND\": {\n            \"left\": {\n              \"OR\": {\n                \"left\": {\n                  \"raw_text\": \"Previous myocardial infarction (MI) or a percutaneous coronary intervention PCI within the past 3 months\"\n                },\n                \"right\": {\n                  \"raw_text\": \"or awaiting cardiac transplantation or other cardiac surgery within the next 365 days (12 months)\"\n                }\n              }\n            },\n            \"right\": {\n              \"AND\": {\n                \"left\": {\n                  \"OR\": {\n                    \"left\": {\n                      \"raw_text\": \"Documented left atrial thrombus\"\n                    },\n                    \"right\": {\n                      \"raw_text\": \"or significant pulmonary disease, (e.g., restrictive pulmonary disease, constrictive or COPD) or any other disease or malfunction of the lungs or respiratory system that produces chronic symptoms\"\n                    }\n                  }\n                },\n                \"right\": {\n                  \"AND\": {\n                    \"left\": {\n                      \"raw_text\": \"Significant medical problem that in the opinion of the investigator would preclude enrollment in this study\"\n                    },\n                    \"right\": {\n                      \"raw_text\": \"Women who are pregnant (as evidenced by pregnancy test if pre-menopausal)\"\n                    }\n                  }\n                }\n              }\n            }\n          }\n        }\n      }\n  }\n}"