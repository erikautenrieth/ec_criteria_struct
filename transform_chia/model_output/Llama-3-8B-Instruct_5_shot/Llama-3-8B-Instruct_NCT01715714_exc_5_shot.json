"{\n  \"AND\": {\n    \"left\": {\n      \"OR\": {\n        \"left\": {\n          \"raw_text\": \"Any concomitant cardiovascular procedure to CABG\"\n        },\n        \"right\": {\n          \"raw_text\": \"(i.e. valve, aortic or carotid surgery)\"\n        }\n      }\n    },\n    \"right\": {\n      \"OR\": {\n        \"left\": {\n          \"raw_text\": \"Acute ST-segment-elevation myocardial infarction (STEMI)\"\n        },\n        \"right\": {\n          \"AND\": {\n            \"left\": {\n              \"raw_text\": \"NSTE-ACS\"\n            },\n            \"right\": {\n              \"raw_text\": \"with cardiogenic shock warranting emergent salvage surgery within 12 hrs from hospital admission\"\n            }\n          }\n        }\n      }\n    }\n  },\n  \"AND\": {\n    \"left\": {\n      \"OR\": {\n        \"left\": {\n          \"raw_text\": \"History of atrial fibrillation\"\n        },\n        \"right\": {\n          \"raw_text\": \"or muscle disease (myopathy)\"\n        }\n      }\n    },\n    \"right\": {\n      \"AND\": {\n        \"left\": {\n          \"OR\": {\n            \"left\": {\n              \"raw_text\": \"Current renal\"\n            },\n            \"right\": {\n              \"OR\": {\n                \"left\": {\n                  \"raw_text\": \"(creatinine>2x upper limit of normal (ULN), dialysis, kidney transplant)\"\n                }\n              }\n            }\n          }\n        },\n        \"right\": {\n          \"OR\": {\n            \"left\": {\n              \"raw_text\": \"or hepatic dysfunction\"\n            },\n            \"right\": {\n              \"OR\": {\n                \"left\": {\n                  \"raw_text\": \"(AST/ALT>2x ULN, liver transplant or neoplasm)\"\n                }\n              }\n            }\n          }\n        }\n      }\n    }\n  },\n  \"AND\": {\n    \"left\": {\n      \"raw_text\": \"Inability of oral drug intake\"\n    }\n  }\n}"