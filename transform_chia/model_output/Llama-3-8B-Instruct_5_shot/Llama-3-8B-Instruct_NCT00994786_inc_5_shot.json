"{\n  \"AND\": {\n    \"left\": {\n      \"AND\": {\n        \"left\": {\n          \"raw_text\": \"Must be an outpatient\"\n        },\n        \"right\": {\n          \"raw_text\": \"with a primary DSM-IV Obsessive-Compulsive Disorder\"\n        }\n      },\n      \"right\": {\n        \"AND\": {\n          \"left\": {\n            \"raw_text\": \"Patients must have a score of greater than 20\"\n          },\n          \"right\": {\n            \"raw_text\": \"on the Yale-Brown Obsessive Compulsive Scale (Y-BOCS; Goodman et al., 1989b)\"\n          }\n        }\n      }\n    },\n    \"right\": {\n      \"AND\": {\n        \"left\": {\n          \"OR\": {\n            \"left\": {\n              \"raw_text\": \"Diagnosis of comorbid DSM-IV major depressive episode\"\n            },\n            \"right\": {\n              \"AND\": {\n                \"left\": {\n                  \"raw_text\": \"will be allowed in the study provided that the diagnosis is secondary to OCD\"\n                },\n                \"right\": {\n                  \"AND\": {\n                    \"left\": {\n                      \"raw_text\": \"they have a baseline Montgomery Depression Rating Scale (MADRS) score of less than or equal to 19\"\n                    },\n                    \"right\": {\n                      \"raw_text\": \"and the onset of OCD predates the onset of the current episode of depression by five or more years\"\n                    }\n                  }\n                }\n              }\n            }\n          }\n        },\n        \"right\": {\n          \"AND\": {\n            \"left\": {\n              \"raw_text\": \"The ability to comprehend and comply with protocol requirements\"\n            },\n            \"right\": {\n              \"raw_text\": \"Written consent must be provided prior to study entry\"\n            }\n          }\n        }\n      }\n    }\n  }\n}"