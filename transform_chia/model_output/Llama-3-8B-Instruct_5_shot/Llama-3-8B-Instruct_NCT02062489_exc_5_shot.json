"{\n  \"AND\": {\n    \"left\": {\n      \"OR\": {\n        \"left\": {\n          \"raw_text\": \"The patients have other cancers at the same time\"\n        },\n        \"right\": {\n          \"OR\": {\n            \"left\": {\n              \"raw_text\": \"or have the history of other cancers except controlled skin basal cell carcinoma\"\n            },\n            \"right\": {\n              \"OR\": {\n                \"left\": {\n                  \"raw_text\": \"or skin squamous cell carcinoma\"\n                },\n                \"right\": {\n                  \"raw_text\": \"or carcinoma in situ of cervix uterus;\"\n                }\n              }\n            }\n          }\n        }\n      }\n    },\n    \"right\": {\n      \"AND\": {\n        \"left\": {\n          \"OR\": {\n            \"left\": {\n              \"raw_text\": \"The patients have active infections that were not suitable for chemotherapy\"\n            },\n            \"right\": {\n              \"OR\": {\n                \"left\": {\n                  \"raw_text\": \"The patients have severe non-cancerous diseases\"\n                }\n              }\n            }\n          }\n        },\n        \"right\": {\n          \"AND\": {\n            \"left\": {\n              \"OR\": {\n                \"left\": {\n                  \"raw_text\": \"The patients have history of neoadjuvant hormone therapy\"\n                }\n              }\n            },\n            \"right\": {\n              \"OR\": {\n                \"left\": {\n                  \"raw_text\": \"The patients have bilateral breast cancers or DCIS or metastatic breast cancers\"\n                }\n              }\n            }\n          }\n        }\n      }\n    }\n  }\n}"