"{\n  \"AND\": {\n    \"left\": {\n      \"AND\": {\n        \"left\": {\n          \"raw_text\": \"The study will include 40 post-deep peel women\"\n        },\n        \"right\": {\n          \"AND\": {\n            \"left\": {\n              \"raw_text\": \"(exoderm), older than 18 years old\"\n            },\n            \"right\": {\n              \"AND\": {\n                \"left\": {\n                  \"raw_text\": \"treated by the same dermatologist (dr. Landau)\"\n                }\n              }\n            }\n          }\n        }\n      }\n    },\n    \"right\": {\n      \"AND\": {\n        \"left\": {\n          \"OR\": {\n            \"left\": {\n              \"raw_text\": \"The treatment group will receive 5 consecutive daily hyperbaric treatments\"\n            },\n            \"right\": {\n              \"AND\": {\n                \"left\": {\n                  \"raw_text\": \"1 hours long each, at 2 ATF, starting from day 7 to peel\"\n                }\n              }\n            }\n          }\n        },\n        \"right\": {\n          \"AND\": {\n            \"left\": {\n              \"raw_text\": \"Prior to treatment, each patient will be signed on informed consent\"\n            },\n            \"right\": {\n              \"AND\": {\n                \"left\": {\n                  \"raw_text\": \"and will have complete physical examination\"\n                }\n              }\n            }\n          }\n        }\n      }\n    }\n  }\n}\n{\n  \"AND\": {\n    \"left\": {\n      \"AND\": {\n        \"left\": {\n          \"raw_text\": \"The control group will be matched by the following parameters: age, skin color and type, and indication for peeling\"\n        }\n      }\n    },\n    \"right\": {\n      \"AND\": {\n        \"left\": {\n          \"raw_text\": \"and will be picked up by the dermatologist\"\n        }\n      }\n    }\n  }\n}"