"{\n  \"AND\": {\n    \"left\": {\n      \"NOT\": {\n        \"left\": {\n          \"OR\": {\n            \"left\": {\n              \"raw_text\": \"Have not received influenza vaccination in the past\"\n            },\n            \"right\": {\n              \"OR\": {\n                \"left\": {\n                  \"raw_text\": \"or cannot be vaccinated due to previous severe reaction to influenza vaccine\"\n                },\n                \"right\": {\n                  \"OR\": {\n                    \"left\": {\n                      \"raw_text\": \"egg, latex, or thimerosol allergies\"\n                    },\n                    \"right\": {\n                      \"raw_text\": \"or refusal of vaccination\"\n                    }\n                  }\n                }\n              }\n            }\n          }\n        }\n      }\n    },\n    \"right\": {\n      \"AND\": {\n        \"left\": {\n          \"NOT\": {\n            \"left\": {\n              \"raw_text\": \"Participant has received a community available influenza vaccine within <6 months\"\n            }\n          }\n        },\n        \"right\": {\n          \"AND\": {\n            \"left\": {\n              \"OR\": {\n                \"left\": {\n                  \"raw_text\": \"History of Guillain-Barré syndrome\"\n                }\n              }\n            },\n            \"right\": {\n              \"AND\": {\n                \"left\": {\n                  \"OR\": {\n                    \"left\": {\n                      \"raw_text\": \"Immunosuppressive disorders or medications\"\n                    }\n                  }\n                },\n                \"right\": {\n                  \"raw_text\": \"(including oral prednisone >10 mg daily, recent chemotherapy treatment)\"\n                }\n              }\n            }\n          }\n        }\n      }\n    }\n  },\n  \"right\": {\n    \"AND\": {\n      \"left\": {\n        \"raw_text\": \"Emergency cases as determin