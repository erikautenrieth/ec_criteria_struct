"{\n  \"AND\": {\n    \"left\": {\n      \"OR\": {\n        \"left\": {\n          \"raw_text\": \"Male\"\n        },\n        \"right\": {\n          \"raw_text\": \"and/or female\"\n        }\n      }\n    },\n    \"right\": {\n      \"AND\": {\n        \"left\": {\n          \"AND\": {\n            \"left\": {\n              \"raw_text\": \"Incipient and established diabetic nephropathy\"\n            },\n            \"right\": {\n              \"AND\": {\n                \"left\": {\n                  \"raw_text\": \"urinary albumin excretion ≥ 100 mg/day but ≤ 2000 mg/day\"\n                }\n              }\n            }\n          }\n        },\n        \"right\": {\n          \"AND\": {\n            \"left\": {\n              \"AND\": {\n                \"left\": {\n                  \"raw_text\": \"Glomerular filtration rate (GFR) ≥ 40 ml/min\"\n                },\n                \"right\": {\n                  \"raw_text\": \"(estimated using Modification of Diet in Renal Disease (MDRD) formula) in the last 4 months\"\n                }\n              }\n            },\n            \"right\": {\n              \"AND\": {\n                \"left\": {\n                  \"AND\": {\n                    \"left\": {\n                      \"raw_text\": \"Female patients must be postmenopausal\"\n                    },\n                    \"right\": {\n                      \"OR\": {\n                        \"left\": {\n                          \"raw_text\": \"or must have had a bilateral oophorectomy\"\n                        },\n                        \"right\": {\n                          \"OR\": {\n                            \"left\": {\n                              \"raw_text\": \"or must have been surgically sterilized\"\n                            },\n                            \"right\": {\n                              \"raw_text\": \"or hysterectomized at least 6 months prior to screening\"\n                            }\n                  