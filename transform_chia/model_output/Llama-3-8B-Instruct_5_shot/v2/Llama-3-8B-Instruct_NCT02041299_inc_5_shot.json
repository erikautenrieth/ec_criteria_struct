"{\n  \"AND\": {\n    \"left\": {\n      \"OR\": {\n        \"left\": {\n          \"raw_text\": \"Male\"\n        },\n        \"right\": {\n          \"raw_text\": \"or female\"\n        }\n      },\n      \"right\": {\n        \"AND\": {\n          \"left\": {\n            \"raw_text\": \"= 2 years of age\"\n          },\n          \"right\": {\n            \"AND\": {\n              \"left\": {\n                \"raw_text\": \"Have sickle cell disease\"\n              },\n              \"right\": {\n                \"OR\": {\n                  \"left\": {\n                    \"raw_text\": \"(confirmed by Hb electrophoresis or more specific tests)\"\n                  },\n                  \"right\": {\n                    \"raw_text\": \"or other conditions with iron overload from repeated blood transfusions\"\n                  }\n                }\n              }\n            },\n            \"right\": {\n              \"AND\": {\n                \"left\": {\n                  \"raw_text\": \"Baseline LIC >7 mg/g dw\"\n                },\n                \"right\": {\n                  \"raw_text\": \"(measured by MRI)\"\n                }\n              }\n            }\n          }\n        }\n      }\n    },\n    \"right\": {\n      \"AND\": {\n        \"left\": {\n          \"raw_text\": \"Patients who have received no less than 20 transfusions of RBCs\"\n        },\n        \"right\": {\n          \"AND\": {\n            \"left\": {\n              \"raw_text\": \"Patients who have received at least 1 transfusion per year in the last 2 years\"\n            },\n            \"right\": {\n              \"raw_text\": \"and who are expected to have a continuing requirement (based on Investigator's judgement) during the duration of the trial\"\n            }\n          }\n        }\n      }\n    }\n  }\n}"