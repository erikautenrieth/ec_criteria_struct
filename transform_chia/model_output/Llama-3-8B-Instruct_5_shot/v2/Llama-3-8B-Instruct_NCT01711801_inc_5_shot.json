"{\n  \"AND\": {\n    \"left\": {\n      \"AND\": {\n        \"left\": {\n          \"raw_text\": \"Healthy male volunteers\"\n        },\n        \"right\": {\n          \"AND\": {\n            \"left\": {\n              \"OR\": {\n                \"left\": {\n                  \"raw_text\": \"18 to 45 years of age, inclusive\"\n                }\n              }\n            },\n            \"right\": {\n              \"AND\": {\n                \"left\": {\n                  \"raw_text\": \"Healthy status is defined by absence of evidence of any active or chronic disease following a detailed medical and surgical history, a complete physical examination including vital signs, 12-lead ECG, hematology, blood chemistry, serology and urinalysis\"\n                }\n              }\n            }\n          }\n        }\n      },\n      \"right\": {\n        \"AND\": {\n          \"left\": {\n            \"raw_text\": \"Body mass index (BMI) 18 to 30 kg/m2 inclusive\"\n          },\n          \"right\": {\n            \"AND\": {\n              \"left\": {\n                \"OR\": {\n                  \"left\": {\n                    \"raw_text\": \"Male subjects (whether surgically sterilized or not) with female partners of child-bearing potential must use two forms of contraception, one of which must be a barrier method, for the duration of the study and for 77 days after the last dose\"\n                  }\n                }\n              }\n            }\n          }\n        }\n      }\n    }\n  }\n}"