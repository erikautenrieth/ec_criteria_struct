{
  "OR":{
    "left":{
      "AND":{
        "left":{
          "raw_text":"1. Have dementia or delirium"
        },
        "right":{
          "raw_text":"(as determined by the palliative care specialist) at study entry."
        }
      }
    },
    "right":{
      "OR":{
        "left":{
          "raw_text":"2. Are pregnant"
        }
      }
    }
  },
  "OR":{
    "left":{
      "AND":{
        "left":{
          "raw_text":"3. Have been taking corticosteroids"
        },
        "right":{
          "raw_text":"for longer than 48 hours."
        }
      }
    },
    "right":{
      "OR":{
        "left":{
          "raw_text":"4. Have pulmonary edema"
        },
        "right":{
          "OR":{
            "left":{
              "raw_text":"ascites"
            },
            "right":{
              "raw_text":"or pitting edema on clinical examination."
            }
          }
        }
      }
    }
  },
  "OR":{
    "left":{
      "raw_text":"5. Are unable to walk"
    }
  },
  "OR":{
    "left":{
      "AND":{
        "left":{
          "raw_text":"6. Have a history of serious adverse gastrointestinal events"
        },
        "right":{
          "raw_text":"(i.e., bleeding or perforation),"
        }
      },
      "right":{
        "OR":{
          "left":{
            "raw_text":"history of a coagulopathy"
          },
          "right":{
            "raw_text":"or current anti-coagulant use."
          }
        }
      }
    }
  },
  "OR":{
    "left":{
      "AND":{
        "left":{
          "raw_text":"7. Have an ALT/AST"
        },
        "right":{
          "raw_text">3x upper limit of normal."
        }
      }
    }
  },
  "OR":{
    "left":{
      "raw_text":"8. Patients on methotrexate"
    }
  },
  "OR":{
    "left":{
      "raw_text":"9. Patients taking melatonin receptor agonists"
    }
  }
}