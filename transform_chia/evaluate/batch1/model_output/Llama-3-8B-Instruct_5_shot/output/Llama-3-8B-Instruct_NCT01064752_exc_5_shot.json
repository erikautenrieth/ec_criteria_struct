"{\n  \"AND\": {\n    \"left\": {\n      \"AND\": {\n        \"left\": {\n          \"AND\": {\n            \"left\": {\n              \"OR\": {\n                \"left\": {\n                  \"raw_text\": \"Taking a tetracycline within 6 months\"\n                },\n                \"right\": {\n                  \"OR\": {\n                    \"left\": {\n                      \"raw_text\": \"or history of adverse reaction to minocycline or another tetracycline\"\n                    },\n                    \"right\": {\n                      \"raw_text\": \"or history of adverse reaction to other antibiotics\"\n                    }\n                  }\n                }\n              }\n            },\n            \"right\": {\n              \"OR\": {\n                \"left\": {\n                  \"raw_text\": \"Enhanced risk from lumbar puncture\"\n                },\n                \"right\": {\n                  \"OR\": {\n                    \"left\": {\n                      \"raw_text\": \"including documented or suspected cerebral mass lesion predisposing to brain herniation\"\n                    },\n                    \"right\": {\n                      \"OR\": {\n                        \"left\": {\n                          \"raw_text\": \"or bleeding diathesis or history of bleeding diathesis\"\n                        },\n                        \"right\": {\n                          \"raw_text\": \"or history of stroke or transient ischemic attack\"\n                        }\n                      }\n                    }\n                  }\n                }\n              }\n            }\n          }\n        },\n        \"right\": {\n          \"OR\": {\n            \"left\": {\n              \"raw_text\": \"Pregnancy or expectation of pregnancy during the study\"\n            },\n            \"right\": {\n              \"OR\": {\n                \"left\": {\n                  \"raw_text\": \"Active opportunistic infection\"\n                },\n                \"right\": {\n                  \"OR\": {\n                    \"left\": {\n                      \"raw_text\": \"or active neurological disease that might confound evaluation\"\n                    },\n                    \"right\": {\n                      \"raw_text\": \"or history of neurological disease that might confound evaluation\"\n                    }\n                  }\n                }\n              }\n            }\n          }\n        }\n      }\n    },\n    \"right\": {\n      \"AND\": {\n        \"left\": {\n          \"AND\": {\n            \"left\": {\n              \"OR\": {\n                \"left\": {\n                  \"raw_text\": \"ADC Stage > 1\"\n                },\n                \"right\": {\n                  \"OR\": {\n                    \"left\": {\n                      \"raw_text\": \"or ADC Stage = 1 with high risk features\"\n                    },\n                    \"right\": {\n                      \"raw_text\": \"or ADC Stage = 1 with intermediate risk features\"\n                    }\n                  }\n                }\n              }\n            },\n            \"right\": {\n              \"OR\": {\n                \"left\": {\n                  \"raw_text\": \"Hemoglobin < 10 Gms/dL\"\n                },\n                \"right\": {\n                  \"OR\": {\n                    \"left\": {\n                      \"raw_text\": \"or BUN or creatine above the normal limits\"\n                    },\n                    \"right\": {\n                      \"raw_text\": \"or history of kidney disease or liver disease\"\n                    }\n                  }\n                }\n              }\n            }\n          }\n        },\n        \"right\": {\n          \"OR\": {\n            \"left\": {\n              \"raw_text\": \"Taking other drugs known to reduce the metabolism of minocycline and thus increase the probability of toxicity\"\n            },\n            \"