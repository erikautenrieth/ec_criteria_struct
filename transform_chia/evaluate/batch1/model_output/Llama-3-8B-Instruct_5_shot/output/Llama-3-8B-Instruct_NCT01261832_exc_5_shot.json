"{\n  \"AND\": {\n    \"left\": {\n      \"AND\": {\n        \"left\": {\n          \"AND\": {\n            \"left\": {\n              \"AND\": {\n                \"left\": {\n                  \"OR\": {\n                    \"left\": {\n                      \"raw_text\": \"Have a known hypersensitivity or contraindication to heparin\"\n                    },\n                    \"right\": {\n                      \"OR\": {\n                        \"left\": {\n                          \"raw_text\": \"or aspirin\"\n                        },\n                        \"right\": {\n                          \"OR\": {\n                            \"left\": {\n                              \"raw_text\": \"or clopidogrel\"\n                            },\n                            \"right\": {\n                              \"raw_text\": \"or cilostazol\"\n                            }\n                          }\n                        }\n                      }\n                    }\n                  }\n                },\n                \"right\": {\n                  \"OR\": {\n                    \"left\": {\n                      \"raw_text\": \"Have uncontrolled hypertension\"\n                    },\n                    \"right\": {\n                      \"raw_text\": \"or a history of bleeding diathesis or known coagulopathy (including heparin-induced thrombocytopenia), or refuses blood transfusions.\"\n                    }\n                  }\n                }\n              }\n            },\n            \"right\": {\n              \"AND\": {\n                \"left\": {\n                  \"raw_text\": \"Have a baseline hemogram with Hb<10g/dL\"\n                },\n                \"right\": {\n                  \"OR\": {\n                    \"left\": {\n                      \"raw_text\": \"or PLT count<100,000/μL\"\n                    },\n                    \"right\": {\n                      \"raw_text\": \"or patients already taking warfarin, cilostazol or any other type of anti-platelet agents except aspirin and clopidogrel.\"\n                    }\n                  }\n                }\n              }\n            }\n          }\n        },\n        \"right\": {\n          \"OR\": {\n            \"left\": {\n              \"raw_text\": \"Have gastrointestinal or genitourinary bleeding within the prior 3 months, or major surgery within 2 months.\"\n            },\n            \"right\": {\n              \"raw_text\": \"or be pregnant.\"\n            }\n          }\n        }\n      }\n    }\n  }\n}"