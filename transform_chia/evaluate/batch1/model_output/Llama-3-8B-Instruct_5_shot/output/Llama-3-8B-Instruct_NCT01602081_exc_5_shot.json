"{\n  \"AND\": {\n    \"left\": {\n      \"AND\": {\n        \"left\": {\n          \"AND\": {\n            \"left\": {\n              \"OR\": {\n                \"left\": {\n                  \"raw_text\": \"Have had a prior surgical procedure for anal fistula\"\n                },\n                \"right\": {\n                  \"OR\": {\n                    \"left\": {\n                      \"raw_text\": \"such as fistulotomy, fistulectomy, LIFT, cutting seton, or advancement flap procedure\"\n                    },\n                    \"right\": {\n                      \"raw_text\": \"or have had a prior treatment for anal fistula that has failed.\"\n                    }\n                  }\n                }\n              }\n            },\n            \"right\": {\n              \"OR\": {\n                \"left\": {\n                  \"raw_text\": \"Have a fistula with multiple tracts\"\n                },\n                \"right\": {\n                  \"raw_text\": \"or have a recto-vaginal fistula.\"\n                }\n              }\n            }\n          }\n        },\n        \"right\": {\n          \"AND\": {\n            \"left\": {\n              \"raw_text\": \"Have an active infection in the anal fistula\"\n            },\n            \"right\": {\n              \"OR\": {\n                \"left\": {\n                  \"raw_text\": \"or have a physical allergy to porcine products\"\n                },\n                \"right\": {\n                  \"raw_text\": \"or have cultural objections to porcine products.\"\n                }\n              }\n            }\n          }\n        }\n      }\n    },\n    \"right\": {\n      \"AND\": {\n        \"left\": {\n          \"raw_text\": \"Are not medically fit to undergo the LIFT procedure as judged by the treating physician\"\n        },\n        \"right\": {\n          \"OR\": {\n            \"left\": {\n              \"raw_text\": \"or have a prior diagnosis of collagen disorder\"\n            },\n            \"right\": {\n              \"OR\": {\n                \"left\": {\n                  \"raw_text\": \"or have a history of Crohn's Disease, Irritable Bowel Syndrome, radiation therapy in the rectoanal region.\"\n                }\n              }\n            }\n          }\n        }\n      }\n    }\n  }\n}"