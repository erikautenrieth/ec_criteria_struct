"{\n  \"AND\": {\n    \"left\": {\n      \"AND\": {\n        \"left\": {\n          \"AND\": {\n            \"left\": {\n              \"AND\": {\n                \"left\": {\n                  \"OR\": {\n                    \"left\": {\n                      \"raw_text\": \"Have had a history of myocardial infarction\"\n                    },\n                    \"right\": {\n                      \"OR\": {\n                        \"left\": {\n                          \"raw_text\": \"or unstable angina\"\n                        },\n                        \"right\": {\n                          \"raw_text\": \"or silent ischemia\"\n                        }\n                      }\n                    }\n                  }\n                },\n                \"right\": {\n                  \"AND\": {\n                    \"left\": {\n                      \"raw_text\": \"with documented ischemia\"\n                    },\n                    \"right\": {\n                      \"raw_text\": \"by stress test or other diagnostic test.\"\n                    }\n                  }\n                }\n              }\n            },\n            \"right\": {\n              \"OR\": {\n                \"left\": {\n                  \"raw_text\": \"Have a history of coronary artery disease\"\n                },\n                \"right\": {\n                  \"OR\": {\n                    \"left\": {\n                      \"raw_text\": \"or have a family history of coronary artery disease.\"\n                    },\n                    \"right\": {\n                      \"raw_text\": \"Have a history of peripheral artery disease.\"\n                    }\n                  }\n                }\n              }\n            }\n          }\n        },\n        \"right\": {\n          \"AND\": {\n            \"left\": {\n              \"raw_text\": \"Are eligible for intracoronary stenting\"\n            },\n            \"right\": {\n              \"raw_text\": \"and have a reference vessel size of at least 2.5 mm by visual estimation.\"\n            }\n          }\n        }\n      }\n    },\n    \"right\": {\n      \"AND\": {\n        \"left\": {\n          \"raw_text\": \"Have at least one CTO lesion located in a proximal or mid epicardial coronary artery.\"\n        },\n        \"right\": {\n          \"OR\": {\n            \"left\": {\n              \"raw_text\": \"Have two CTO lesions, one of which is located in a proximal or mid epicardial coronary artery.\"\n            },\n            \"right\": {\n              \"raw_text\": \"Have a history of myocardial infarction or unstable angina.\"\n            }\n          }\n        }\n      }\n    }\n  }\n}"