"{\n  \"AND\": {\n    \"left\": {\n      \"OR\": {\n        \"left\": {\n          \"raw_text\": \"Have received prior chemotherapy for unresectable disease\"\n        },\n        \"right\": {\n          \"raw_text\": \"or have received prior radiation therapy for unresectable disease\"\n        }\n      }\n    },\n    \"right\": {\n      \"AND\": {\n        \"left\": {\n          \"OR\": {\n            \"left\": {\n              \"raw_text\": \"Have any active or uncontrolled infection, including known HIV infection\"\n            },\n            \"right\": {\n              \"OR\": {\n                \"left\": {\n                  \"raw_text\": \"Have active hepatitis B\"\n                },\n                \"right\": {\n                  \"raw_text\": \"or have active hepatitis C and liver tests qualify\"\n                }\n              }\n            }\n          }\n        },\n        \"right\": {\n          \"AND\": {\n            \"left\": {\n              \"raw_text\": \"Do not have psychiatric disorders that would interfere with consent or follow-up\"\n            },\n            \"right\": {\n              \"OR\": {\n                \"left\": {\n                  \"raw_text\": \"Are not pregnant or lactating\"\n                },\n                \"right\": {\n                  \"AND\": {\n                    \"left\": {\n                      \"raw_text\": \"Are men and women of reproductive potential\"\n                    },\n                    \"right\": {\n                      \"raw_text\": \"and have agreed to use an effective contraceptive method\"\n                    }\n                  }\n                }\n              }\n            }\n          }\n        }\n      }\n    }\n  }\n}"