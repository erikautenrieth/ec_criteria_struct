"{\n  \"AND\": {\n    \"left\": {\n      \"OR\": {\n        \"left\": {\n          \"raw_text\": \"Have had a concomitant cardiovascular procedure with CABG\"\n        },\n        \"right\": {\n          \"OR\": {\n            \"left\": {\n              \"raw_text\": \"Have had an acute ST-segment-elevation myocardial infarction (STEMI)\"\n            },\n            \"right\": {\n              \"OR\": {\n                \"left\": {\n                  \"raw_text\": \"Have had a non-ST-segment-elevation acute coronary syndrome (NSTE-ACS) with cardiogenic shock warranting emergent salvage surgery within 12 hours from hospital admission\"\n                },\n                \"right\": {\n                  \"raw_text\": \"Have had a history of atrial fibrillation or muscle disease (myopathy)\"\n                }\n              }\n            }\n          }\n        }\n      },\n      \"right\": {\n        \"OR\": {\n          \"left\": {\n            \"raw_text\": \"Have had a current renal dysfunction (creatinine > 2 x upper limit of normal (ULN), dialysis, kidney transplant) or hepatic dysfunction (AST/ALT > 2 x ULN, liver transplant or neoplasm)\"\n          },\n          \"right\": {\n            \"raw_text\": \"Have been unable to take oral medications\"\n          }\n        }\n      }\n    }\n  }\n}"