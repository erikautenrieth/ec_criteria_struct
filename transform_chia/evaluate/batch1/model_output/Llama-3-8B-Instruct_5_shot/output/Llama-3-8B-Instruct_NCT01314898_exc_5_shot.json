"{\n  \"AND\": {\n    \"left\": {\n      \"AND\": {\n        \"left\": {\n          \"AND\": {\n            \"left\": {\n              \"OR\": {\n                \"left\": {\n                  \"raw_text\": \"Supine BP >140 mm Hg systolic or >90 mm Hg diastolic\"\n                },\n                \"right\": {\n                  \"OR\": {\n                    \"left\": {\n                      \"raw_text\": \"or <100 mm Hg systolic or <60 mm Hg diastolic\"\n                    },\n                    \"right\": {\n                      \"raw_text\": \"based on the average of the triplicate measurements.\"\n                    }\n                  }\n                }\n              }\n            },\n            \"right\": {\n              \"OR\": {\n                \"left\": {\n                  \"raw_text\": \"Serum potassium >=5.1 mmol/L or <3.5 mmol/L\"\n                },\n                \"right\": {\n                  \"raw_text\": \"at screening, confirmed by a single repeat if deemed necessary.\"\n                }\n              }\n            }\n          }\n        },\n        \"right\": {\n          \"OR\": {\n            \"left\": {\n              \"raw_text\": \"Estimated GFR <60 mL/min/1.73 m2 using the Cockcroft-Gault formula\"\n            },\n            \"right\": {\n              \"raw_text\": \"measurement of the individual parameters following at least 5 minutes of rest at Screening.\"\n            }\n          }\n        }\n      }\n    }\n  }\n}"