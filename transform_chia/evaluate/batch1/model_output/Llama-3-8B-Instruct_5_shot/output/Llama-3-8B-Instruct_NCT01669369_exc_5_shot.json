"{\n  \"AND\": {\n    \"left\": {\n      \"AND\": {\n        \"left\": {\n          \"AND\": {\n            \"left\": {\n              \"AND\": {\n                \"left\": {\n                  \"OR\": {\n                    \"left\": {\n                      \"raw_text\": \"Have received prior treatment with chemotherapy\"\n                    },\n                    \"right\": {\n                      \"OR\": {\n                        \"left\": {\n                          \"raw_text\": \"or surgery for any reason.\"\n                        },\n                        \"right\": {\n                          \"raw_text\": \"Have received prior treatment with radiotherapy.\"\n                        }\n                      }\n                    }\n                  }\n                },\n                \"right\": {\n                  \"OR\": {\n                    \"left\": {\n                      \"raw_text\": \"Have a history of secondary osteosarcoma\"\n                    },\n                    \"right\": {\n                      \"OR\": {\n                        \"left\": {\n                          \"raw_text\": \"or well-differentiated parosteal osteosarcoma.\"\n                        },\n                        \"right\": {\n                          \"raw_text\": \"Have a history of bone metastasis.\"\n                        }\n                      }\n                    }\n                  }\n                }\n              }\n            },\n            \"right\": {\n              \"OR\": {\n                \"left\": {\n                  \"raw_text\": \"Have evident dysfunction of cardiac, liver, or kidney function.\"\n                },\n                \"right\": {\n                  \"OR\": {\n                    \"left\": {\n                      \"raw_text\": \"Be pregnant or breastfeeding.\"\n                    },\n                    \"right\": {\n                      \"raw_text\": \"Have any other condition that would make it difficult to participate in the study.\"\n                    }\n                  }\n                }\n              }\n            }\n          }\n        },\n        \"right\": {\n          \"raw_text\": \"Have a life expectancy of at least 6 months.\"\n        }\n      }\n    },\n    \"right\": {\n      \"raw_text\": \"Have a Karnofsky Performance Status (KPS) of at least 60.\"\n    }\n  }\n}"