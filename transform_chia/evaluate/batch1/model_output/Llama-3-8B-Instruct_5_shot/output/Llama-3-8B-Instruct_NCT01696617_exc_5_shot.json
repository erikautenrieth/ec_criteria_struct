"{\n  \"AND\": {\n    \"left\": {\n      \"AND\": {\n        \"left\": {\n          \"AND\": {\n            \"left\": {\n              \"AND\": {\n                \"left\": {\n                  \"OR\": {\n                    \"left\": {\n                      \"raw_text\": \"Have a history of hypersensitivity to aripiprazole\"\n                    },\n                    \"right\": {\n                      \"raw_text\": \"or any other component of the study medication.\"\n                    }\n                  }\n                },\n                \"right\": {\n                  \"OR\": {\n                    \"left\": {\n                      \"raw_text\": \"Have a primary diagnosis of major depressive disorder (MDD) with psychotic features, bipolar disorder, schizophrenia, schizoaffective disorder, other psychotic disorder, or anxiety disorder.\"\n                    },\n                    \"right\": {\n                      \"OR\": {\n                        \"left\": {\n                          \"raw_text\": \"Have a history of alcohol or drug abuse within the past 12 months.\"\n                        },\n                        \"right\": {\n                          \"OR\": {\n                            \"left\": {\n                              \"raw_text\": \"Have a diagnosis of dementia.\"\n                            },\n                            \"right\": {\n                              \"raw_text\": \"or have a clinically significant current Axis II (DSM-IV-TR) diagnosis.\"\n                            }\n                          }\n                        }\n                      }\n                    }\n                  }\n                }\n              }\n            },\n            \"right\": {\n              \"OR\": {\n                \"left\": {\n                  \"raw_text\": \"Have a significant risk of suicide, as corroborated by a score of >= 5 on item 10 (suicidal thoughts) on the Montgomery-Asberg Depression Rating Scale (MADRS) or by clinical judgment of the investigator.\"\n                },\n                \"right\": {\n                  \"raw_text\": \"or have a history of suicidal behavior or suicidal ideation.\"\n                }\n              }\n            }\n          }\n        },\n        \"right\": {\n          \"OR\": {\n            \"left\": {\n              \"raw_text\": \"Be pregnant or breast-feeding.\"\n            },\n            \"right\": {\n              \"OR\": {\n                \"left\": {\n                  \"raw_text\": \"Have a serious medical illness, including cardiac, hepatic, renal, respiratory, endocrinologic, neurologic, or hematologic disease or physical disorder judged to significantly affect central nervous system function.\"\n                },\n                \"right\": {\n                  \"OR\": {\n                    \"left\": {\n                      \"raw_text\": \"Be taking antipsychotics, mood stabilizers, or any psychotropic medications besides antidepressants, except benzodiazepines, beta blockers, or hypnotics.\"\n                    },\n                    \"right\": {\n                      \"raw_text\": \"or have a history of treatment failure with aripiprazole.\"\n                    }\n                  }\n                }\n              }\n            }\n          }\n        }\n      }\n    }\n  }\n}"