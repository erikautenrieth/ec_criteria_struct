"{\n  \"AND\": {\n    \"left\": {\n      \"AND\": {\n        \"left\": {\n          \"AND\": {\n            \"left\": {\n              \"AND\": {\n                \"left\": {\n                  \"OR\": {\n                    \"left\": {\n                      \"raw_text\": \"Have a history of choroidal neovascularization caused by other eye diseases\"\n                    },\n                    \"right\": {\n                      \"raw_text\": \"or other ocular conditions that could affect the results of the study.\"\n                    }\n                  }\n                },\n                \"right\": {\n                  \"OR\": {\n                    \"left\": {\n                      \"raw_text\": \"Have undergone ocular surgery within the past 3 months\"\n                    },\n                    \"right\": {\n                      \"raw_text\": \"or have a history of uveitis.\"\n                    }\n                  }\n                }\n              }\n            },\n            \"right\": {\n              \"OR\": {\n                \"left\": {\n                  \"raw_text\": \"Have intraocular pressure higher than 25 mmHg, or glaucoma\"\n                },\n                \"right\": {\n                  \"raw_text\": \"or have a history of systemic or ocular thromboembolic events.\"\n                }\n              }\n            }\n          }\n        },\n        \"right\": {\n          \"raw_text\": \"Have a history of other eye diseases or conditions that could affect the results of the study.\"\n        }\n      }\n    }\n  }\n}"