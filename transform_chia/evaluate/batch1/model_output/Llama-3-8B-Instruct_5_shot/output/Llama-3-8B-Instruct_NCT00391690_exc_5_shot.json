"{\n  \"AND\": {\n    \"left\": {\n      \"AND\": {\n        \"left\": {\n          \"AND\": {\n            \"left\": {\n              \"AND\": {\n                \"left\": {\n                  \"OR\": {\n                    \"left\": {\n                      \"raw_text\": \"Have received prior treatment with a bisphosphonate\"\n                    },\n                    \"right\": {\n                      \"OR\": {\n                        \"left\": {\n                          \"raw_text\": \"Have a history of diseases with influence on bone metabolism\"\n                        },\n                        \"right\": {\n                          \"raw_text\": \"such as Paget's disease and primary hyperparathyroidism.\"\n                        }\n                      }\n                    }\n                  }\n                },\n                \"right\": {\n                  \"OR\": {\n                    \"left\": {\n                      \"raw_text\": \"Have clinically symptomatic brain metastases\"\n                    },\n                    \"right\": {\n                      \"OR\": {\n                        \"left\": {\n                          \"raw_text\": \"Have severe physical or psychological concomitant diseases\"\n                        },\n                        \"right\": {\n                          \"raw_text\": \"that might impair compliance with the provisions of the study protocol or that might impair the assessment of drug or patient safety, e.g. clinically significant ascites, cardiac failure, NYHA III or IV, clinically relevant pathologic findings in ECG.\"\n                        }\n                      }\n                    }\n                  }\n                }\n              }\n            },\n            \"right\": {\n              \"OR\": {\n                \"left\": {\n                  \"raw_text\": \"Have known hypersensitivity to zoledronic acid or other bisphosphonates\"\n                },\n                \"right\": {\n                  \"OR\": {\n                    \"left\": {\n                      \"raw_text\": \"Have used other investigational drugs 30 days prior to the date of randomization\"\n                    },\n                    \"right\": {\n                      \"OR\": {\n                        \"left\": {\n                          \"raw_text\": \"Have known history or present abuse of alcohol or drugs\"\n                        },\n                        \"right\": {\n                          \"raw_text\": \"or subjects who, in the opinion of the investigator, are unlikely to cooperate fully during the study.\"\n                        }\n                      }\n                    }\n                  }\n                }\n              }\n            }\n          }\n        },\n        \"right\": {\n          \"OR\": {\n            \"left\": {\n              \"raw_text\": \"Have current active dental problems including infection of the teeth or jawbone\"\n            },\n            \"right\": {\n              \"OR\": {\n                \"left\": {\n                  \"raw_text\": \"Have recent (within 6 weeks) or planned dental or jaw surgery\"\n                },\n                \"right\": {\n                  \"raw_text\": \"(e.g. extraction, implants) or have a current or prior diagnosis of osteonecrosis of the jaw (ONJ), of exposed bone in the mouth, or of slow healing after dental procedures.\"\n                }\n              }\n            }\n          }\n        }\n      }\n    }\n  }\n}"