"{\n  \"AND\": {\n    \"left\": {\n      \"AND\": {\n        \"left\": {\n          \"AND\": {\n            \"left\": {\n              \"OR\": {\n                \"left\": {\n                  \"raw_text\": \"Have a history of hemoglobin SC or SB+ thalassemia\"\n                },\n                \"right\": {\n                  \"raw_text\": \"or are on a chronic transfusion program\"\n                }\n              }\n            },\n            \"right\": {\n              \"AND\": {\n                \"left\": {\n                  \"raw_text\": \"Have not received RBC transfusions with >15% adult hemoglobin\"\n                },\n                \"right\": {\n                  \"OR\": {\n                    \"left\": {\n                      \"raw_text\": \"Have known positive status for HIV, active hepatitis B or hepatitis C\"\n                    },\n                    \"right\": {\n                      \"OR\": {\n                        \"left\": {\n                          \"raw_text\": \"are pregnant or breast feeding women\"\n                        },\n                        \"right\": {\n                          \"raw_text\": \"or have a history of malignancy except for the following circumstances:\"\n                        }\n                      }\n                    }\n                  }\n                }\n              }\n            }\n          }\n        },\n        \"right\": {\n          \"AND\": {\n            \"left\": {\n              \"raw_text\": \"Have been disease-free for at least 5 years and are deemed by the investigator to be at low risk for recurrence of that malignancy\"\n            },\n            \"right\": {\n              \"OR\": {\n                \"left\": {\n                  \"raw_text\": \"or have been diagnosed and adequately treated within the past 5 years with cervical or breast cancer in situ, and basal cell or squamous cell carcinoma of the skin\"\n                },\n                \"right\": {\n                  \"raw_text\": \"or have a history of thrombosis or other reason (other than sickle cell disease) for enhanced thrombotic risk\"\n                }\n              }\n            }\n          }\n        }\n      },\n      \"right\": {\n        \"OR\": {\n          \"left\": {\n            \"raw_text\": \"Have unresolved infections\"\n          },\n          \"right\": {\n            \"OR\": {\n              \"left\": {\n                \"raw_text\": \"have severe or uncontrolled medical conditions that could compromise study participation\"\n              },\n              \"right\": {\n                \"OR\": {\n                  \"left\": {\n                    \"raw_text\": \"are on fetal hemoglobin inducing agents\"\n                  },\n                  \"right\": {\n                    \"OR\": {\n                      \"left\": {\n                        \"raw_text\": \"are on any other experimental treatment within 90 days of the first dose of study drug or who have not recovered from the side effects of such therapy\"\n                      },\n                      \"right\": {\n                        \"raw_text\": \"or have known allergic reaction to a histone deacetylase inhibitor\"\n                      }\n                    }\n                  }\n                }\n              }\n            }\n          }\n        }\n      }\n    }\n  }\n}"