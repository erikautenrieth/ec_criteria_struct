"{\n  \"AND\": {\n    \"left\": {\n      \"AND\": {\n        \"left\": {\n          \"AND\": {\n            \"left\": {\n              \"AND\": {\n                \"left\": {\n                  \"OR\": {\n                    \"left\": {\n                      \"raw_text\": \"Have been treated with anti-diabetic medication\"\n                    },\n                    \"right\": {\n                      \"raw_text\": \"or have a history of diabetes\"\n                    }\n                  }\n                },\n                \"right\": {\n                  \"OR\": {\n                    \"left\": {\n                      \"raw_text\": \"Pregnant or nursing women.\"\n                    },\n                    \"right\": {\n                      \"raw_text\": \"or have a history of pregnancy or nursing.\"\n                    }\n                  }\n                }\n              }\n            },\n            \"right\": {\n              \"AND\": {\n                \"left\": {\n                  \"raw_text\": \"Impaired liver function (ALT > 120 U/L)\"\n                },\n                \"right\": {\n                  \"raw_text\": \"or have a history of liver disease.\"\n                }\n              }\n            }\n          }\n        },\n        \"right\": {\n          \"AND\": {\n            \"left\": {\n              \"raw_text\": \"Impaired renal function (Serum creatinine >1.5 mg/dL in male, >1.4 mg/dL in female)\"\n            },\n            \"right\": {\n              \"raw_text\": \"or have a history of kidney disease.\"\n            }\n          }\n        }\n      }\n    },\n    \"right\": {\n      \"OR\": {\n        \"left\": {\n          \"raw_text\": \"Recently suffered from MI or CVA.\"\n        },\n        \"right\": {\n          \"raw_text\": \"or have a history of cardiovascular disease.\"\n        }\n      }\n    }\n  }\n}"