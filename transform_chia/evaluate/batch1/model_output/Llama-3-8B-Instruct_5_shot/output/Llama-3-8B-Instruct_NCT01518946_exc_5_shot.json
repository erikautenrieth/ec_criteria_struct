"{\n  \"AND\": {\n    \"left\": {\n      \"OR\": {\n        \"left\": {\n          \"raw_text\": \"Pregnant or lactating female\"\n        },\n        \"right\": {\n          \"raw_text\": \"or supine hypertension greater than 180mmHg systolic and 110mmHg diastolic BP\"\n        }\n      }\n    },\n    \"right\": {\n      \"AND\": {\n        \"left\": {\n          \"OR\": {\n            \"left\": {\n              \"raw_text\": \"Pre-existing sustained supine hypertension\"\n            },\n            \"right\": {\n              \"raw_text\": \"or had these measurements at the Screening Visit.\"\n            }\n          }\n        },\n        \"right\": {\n          \"AND\": {\n            \"left\": {\n              \"OR\": {\n                \"left\": {\n                  \"raw_text\": \"Concomitant medications of interest are excluded\"\n                },\n                \"right\": {\n                  \"raw_text\": \"unless reviewed and discussed with the Medical Monitor or Study Physician and documented prior to enrolling the subject.\"\n                }\n              }\n            },\n            \"right\": {\n              \"OR\": {\n                \"left\": {\n                  \"raw_text\": \"Principal Investigator deems any clinical laboratory test abnormality to be clinically significant\"\n                },\n                \"right\": {\n                  \"raw_text\": \"or subject has participated in other studies of investigational drugs or devices within 30 days prior to enrollment in this study.\"\n                }\n              }\n            }\n          }\n        }\n      }\n    }\n  }\n}"