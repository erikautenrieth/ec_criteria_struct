"{\n  \"AND\": {\n    \"left\": {\n      \"AND\": {\n        \"left\": {\n          \"AND\": {\n            \"left\": {\n              \"OR\": {\n                \"left\": {\n                  \"raw_text\": \"Have a history of localized disease\"\n                },\n                \"right\": {\n                  \"OR\": {\n                    \"left\": {\n                      \"raw_text\": \"or have undergone definitive radiation or surgery\"\n                    },\n                    \"right\": {\n                      \"raw_text\": \"and demonstrate progression of disease biochemically\"\n                    }\n                  }\n                }\n              },\n              \"right\": {\n                \"OR\": {\n                  \"left\": {\n                    \"raw_text\": \"or have radiographically evident disease\"\n                    },\n                    \"right\": {\n                      \"raw_text\": \"or have newly detected disease or progressing disease in bone or in soft tissue\"\n                    }\n                  }\n                }\n              }\n            },\n            \"right\": {\n              \"AND\": {\n                \"left\": {\n                  \"raw_text\": \"Have biochemical progression defined as\"\n                },\n                \"right\": {\n                  \"AND\": {\n                    \"left\": {\n                      \"raw_text\": \"minimum no. of determinations: 3\"\n                    },\n                    \"right\": {\n                      \"AND\": {\n                        \"left\": {\n                          \"raw_text\": \"Interval: >2 weeks\"\n                        },\n                        \"right\": {\n                          \"AND\": {\n                            \"left\": {\n                              \"raw_text\": \"Minimal Baseline PSA value (ng/ml): 2\"\n                            },\n                            \"right\": {\n                              \"AND\": {\n                                \"left\": {\n                                  \"raw_text\": \"Minimal % increase in range of values: 50%\"\n                                }\n                              }\n                            }\n                          }\n                        }\n                      }\n                    }\n                  }\n                }\n              }\n            }\n          }\n        },\n        \"right\": {\n          \"AND\": {\n            \"left\": {\n              \"raw_text\": \"Have a diagnosis of prostate adenocarcinoma histologically confirmed at MSKCC\"\n            },\n            \"right\": {\n              \"AND\": {\n                \"left\": {\n                  \"raw_text\": \"Have a level of serum testosterone above the lower limit of normal\"\n                },\n                \"right\": {\n                  \"AND\": {\n                    \"left\": {\n                      \"raw_text\": \"Have Karnofsky performance status (KPS) >_70%\"\n                    },\n                    \"right\": {\n                      \"AND\": {\n                        \"left\": {\n                          \"raw_text\": \"Have adequate organ function as defined by the following laboratory criteria\"\n                        },\n                        \"right\": {\n                          \"AND\": {\n                            \"left\": {\n                              \"raw_text\": \"WBC >_3500/mm3, platelet count >_100,000/mm3\"\n                            },\n                            \"right\": {\n                              \"AND\": {\n                                \"left\": {\n                                  \"raw_text\": \"Bilirubin <2.0 mg/dl or SGOT <3.0 X the upper limit of normal\"\n                                },\n                                \"right\": {\n                                  \"AND\": {\n                                    \"left\": {\n                                      \"raw_text\": \"Creatinine <_1.6 mg/dl or creatinine clearance >_60 cc/min\"\n                                    }\n                                  }\n                                }\n                              }\n                            }\n                          }\n                        }\n                      }\n                    }\n                  }\n                }\n              }\n            }\n          }\n        }\n      }\n    },\n    \"right\": {\n      \"AND\": {\n        \"left\": {\n          \"raw_text\": \"Patients must be at least 18 years of age\"\n        },\n        \"right\": {\n          \"AND\": {\n            \"left\": {\n              \"raw_text\": \"Patients must have signed an informed consent document stating that they understand the investigational nature of the proposed treatment\"\n            }\n          }\n        }\n      }\n    }\n  }\n}"