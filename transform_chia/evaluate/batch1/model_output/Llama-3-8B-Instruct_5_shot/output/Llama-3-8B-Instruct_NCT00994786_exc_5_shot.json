"{\n  \"AND\": {\n    \"left\": {\n      \"AND\": {\n        \"left\": {\n          \"AND\": {\n            \"left\": {\n              \"AND\": {\n                \"left\": {\n                  \"OR\": {\n                    \"left\": {\n                      \"raw_text\": \"Have a history of DSM-IV psychiatric diagnosis\"\n                    },\n                    \"right\": {\n                      \"OR\": {\n                        \"left\": {\n                          \"raw_text\": \"other than Obsessive Compulsive Disorder.\"\n                        },\n                        \"right\": {\n                          \"raw_text\": \"Have a lifetime history of bipolar disorder.\"\n                        }\n                      }\n                    }\n                  }\n                },\n                \"right\": {\n                  \"OR\": {\n                    \"left\": {\n                      \"raw_text\": \"Have a current Axis II Cluster A Personality Disorder\"\n                    },\n                    \"right\": {\n                      \"OR\": {\n                        \"left\": {\n                          \"raw_text\": \"Borderline or Antisocial Personality Disorder.\"\n                        },\n                        \"right\": {\n                          \"raw_text\": \"Have a history of Schizophrenia and other psychotic disorders.\"\n                        }\n                      }\n                    }\n                  }\n                }\n              }\n            },\n            \"right\": {\n              \"OR\": {\n                \"left\": {\n                  \"raw_text\": \"Have a history of more than three adequate trials with an SSRI.\"\n                },\n                \"right\": {\n                  \"OR\": {\n                    \"left\": {\n                      \"raw_text\": \"Have had an adequate trial of pregabalin.\"\n                    },\n                    \"right\": {\n                      \"raw_text\": \"Have initiated psychotherapy in the last 4 months prior to the first visit.\"\n                    }\n                  }\n                }\n              }\n            }\n          }\n        },\n        \"right\": {\n          \"OR\": {\n            \"left\": {\n              \"raw_text\": \"Have a history of seizure disorders (except for febrile seizures in childhood).\"\n            },\n            \"right\": {\n              \"OR\": {\n                \"left\": {\n                  \"raw_text\": \"Have thyroid pathology, the treatment of which has not been stabilized for at least three months.\"\n                },\n                \"right\": {\n                  \"raw_text\": \"Have a current seizure disorder, organic brain disorder or a history of seizure disorders.\"\n                }\n              }\n            }\n          }\n        }\n      }\n    },\n    \"right\": {\n      \"OR\": {\n        \"left\": {\n          \"raw_text\": \"Have a history or evidence of a medical condition that would expose them to an increased risk of a significant adverse event or interfere with assessments of safety and efficacy during the trial.\"\n        },\n        \"right\": {\n          \"OR\": {\n            \"left\": {\n              \"raw_text\": \"Have a history of more than three adequate trials with an SSRI.\"\n            },\n            \"right\": {\n              \"raw_text\": \"Have had an adequate trial of pregabalin.\"\n            }\n          }\n        }\n      }\n    }\n  }\n}"