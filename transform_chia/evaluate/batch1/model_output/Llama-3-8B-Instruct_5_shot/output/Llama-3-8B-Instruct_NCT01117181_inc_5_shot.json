"{\n  \"AND\": {\n    \"left\": {\n      \"AND\": {\n        \"left\": {\n          \"AND\": {\n            \"left\": {\n              \"AND\": {\n                \"left\": {\n                  \"OR\": {\n                    \"left\": {\n                      \"raw_text\": \"Have a diagnosis of probable Alzheimer's disease (NINCDS-ADRDA criteria)\"\n                    },\n                    \"right\": {\n                      \"OR\": {\n                        \"left\": {\n                          \"raw_text\": \"with a Mini-Mental State Exam (MMSE) score of 10-26 inclusive\"\n                        },\n                        \"right\": {\n                          \"raw_text\": \"or MMSE scores above 26 in those who nevertheless meet criteria for AD may be allowed with Steering Committee approval on a case by case basis\"\n                        }\n                      }\n                    }\n                  }\n                },\n                \"right\": {\n                  \"AND\": {\n                    \"left\": {\n                      \"raw_text\": \"Have clinically significant apathy for at least four weeks\"\n                    },\n                    \"right\": {\n                      \"OR\": {\n                        \"left\": {\n                          \"raw_text\": \"with a frequency of apathy assessed by the Neuropsychiatric Inventory (NPI) of 'Very frequently'\"\n                        },\n                        \"right\": {\n                          \"OR\": {\n                            \"left\": {\n                              \"raw_text\": \"or a frequency of apathy assessed by the NPI of 'Frequently' or 'Often' AND a severity of apathy assessed by the NPI of 'Moderate' or 'Marked'\"\n                            },\n                            \"right\": {\n                              \"raw_text\": \"or a frequency of apathy assessed by the NPI of 'Often' AND a severity of apathy assessed by the NPI of 'Severe'\"\n                            }\n                          }\n                        }\n                      }\n                    }\n                  }\n                }\n              }\n            },\n            \"right\": {\n              \"AND\": {\n                \"left\": {\n                  \"raw_text\": \"Have a medication for apathy that is appropriate, in the opinion of the study physician\"\n                },\n                \"right\": {\n                  \"raw_text\": \"and have provision of informed consent for participation in the study by patient or surrogate (if the patient is unable to provide informed consent) and caregiver\"\n                }\n              }\n            }\n          }\n        },\n        \"right\": {\n          \"AND\": {\n            \"left\": {\n              \"raw_text\": \"Have availability of primary caregiver, who spends greater than ten hours a week with the patient and supervises his/her care, to accompany the patient to study visits and to participate in the study\"\n            },\n            \"right\": {\n              \"AND\": {\n                \"left\": {\n                  \"raw_text\": \"Have sufficient fluency, of both the patient and caregiver, in written and spoken English to participate in study visits, physical exams, and outcome assessments\"\n                },\n                \"right\": {\n                  \"raw_text\": \"and have no change to AD medications within the month preceding randomization, including starting, stopping, or dosage modifications\"\n                }\n              }\n            }\n          }\n        }\n      }\n    },\n    \"right\": {\n      \"OR\": {\n        \"left\": {\n          \"raw_text\": \"Treatment with stable doses of selective serotonin reuptake inhibitor antidepressants (SSRIs) is appropriate if stable for 3 months prior to randomization\"\n        },\n        \"right\": {\n          \"OR\": {\n            \"left\": {\n              \"raw_text\": \"Other psychotropics (with the exclusion of antipsychotics), if stable for 3 months, may be allowed only with Steering Committee approval on a case by case basis\"\n            },\n            \"right\": {\n              \"raw_text\": \"or a history of depression or anxiety disorder that has been stable for at least 6 months prior to randomization\"\n            }\n          }\n        }\n      }\n    }\n  }\n}"