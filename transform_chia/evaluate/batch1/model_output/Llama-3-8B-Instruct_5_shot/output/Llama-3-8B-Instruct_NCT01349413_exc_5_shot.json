"{\n  \"AND\": {\n    \"left\": {\n      \"AND\": {\n        \"left\": {\n          \"AND\": {\n            \"left\": {\n              \"AND\": {\n                \"left\": {\n                  \"OR\": {\n                    \"left\": {\n                      \"raw_text\": \"Have a history of acid reflux or heartburn symptoms\"\n                    },\n                    \"right\": {\n                      \"OR\": {\n                        \"left\": {\n                          \"raw_text\": \"or gastroesophageal reflux disease (GERD)\"\n                        },\n                        \"right\": {\n                          \"raw_text\": \"or dyspepsia.\"\n                        }\n                      }\n                    }\n                  }\n                },\n                \"right\": {\n                  \"OR\": {\n                    \"left\": {\n                      \"raw_text\": \"Have a history of gastric surgery\"\n                    },\n                    \"right\": {\n                      \"raw_text\": \"or have had a gastric bypass procedure.\"\n                    }\n                  }\n                }\n              }\n            },\n            \"right\": {\n              \"OR\": {\n                \"left\": {\n                  \"raw_text\": \"Have a known hypersensitivity to proton pump inhibitors (PPIs)\"\n                },\n                \"right\": {\n                  \"raw_text\": \"or have had a history of PPI use.\"\n                }\n              }\n            }\n          }\n        },\n        \"right\": {\n          \"OR\": {\n            \"left\": {\n              \"raw_text\": \"Have a history of H. pylori infection\"\n            },\n            \"right\": {\n              \"raw_text\": \"or have had a history of Helicobacter pylori (H. pylori) eradication therapy.\"\n            }\n          }\n        }\n      }\n    },\n    \"right\": {\n      \"AND\": {\n        \"left\": {\n          \"raw_text\": \"Have a history of organic pathology identified by upper endoscopy or other investigations.\"\n        },\n        \"right\": {\n          \"OR\": {\n            \"left\": {\n              \"raw_text\": \"Have a sliding hiatus hernia as defined by flap valve grade IV disruption of morphology at gastro-esophageal junction.\"\n            },\n            \"right\": {\n              \"raw_text\": \"or have a concurrent medication that affects gastrointestinal motility.\"\n            }\n          }\n        }\n      }\n    }\n  }\n}"