"{\n  \"AND\": {\n    \"left\": {\n      \"AND\": {\n        \"left\": {\n          \"AND\": {\n            \"left\": {\n              \"AND\": {\n                \"left\": {\n                  \"OR\": {\n                    \"left\": {\n                      \"raw_text\": \"Have a history of underlying infectious disease\"\n                    },\n                    \"right\": {\n                      \"OR\": {\n                        \"left\": {\n                          \"raw_text\": \"such as HIV, tuberculosis, or chronic viral hepatitis\"\n                        },\n                        \"right\": {\n                          \"raw_text\": \"or other chronic infectious diseases.\"\n                        }\n                      }\n                    }\n                  }\n                },\n                \"right\": {\n                  \"OR\": {\n                    \"left\": {\n                      \"raw_text\": \"Have a chromosomal abnormality\"\n                    },\n                    \"right\": {\n                      \"OR\": {\n                        \"left\": {\n                          \"raw_text\": \"such as Down syndrome, Turner syndrome, or other chromosomal disorders\"\n                        },\n                        \"right\": {\n                          \"raw_text\": \"or other genetic disorders.\"\n                        }\n                      }\n                    }\n                  }\n                }\n              }\n            },\n            \"right\": {\n              \"OR\": {\n                \"left\": {\n                  \"raw_text\": \"Have a metabolic disorder\"\n                },\n                \"right\": {\n                  \"OR\": {\n                    \"left\": {\n                      \"raw_text\": \"such as diabetes, hyperthyroidism, or other endocrine disorders\"\n                    },\n                    \"right\": {\n                      \"raw_text\": \"or other metabolic disorders.\"\n                    }\n                  }\n                }\n              }\n            }\n          }\n        },\n        \"right\": {\n          \"OR\": {\n            \"left\": {\n              \"raw_text\": \"Have a specific brain-related disorder\"\n            },\n            \"right\": {\n              \"OR\": {\n                \"left\": {\n                  \"raw_text\": \"such as tuberous sclerosis, neurofibromatosis, or other brain-related disorders\"\n                },\n                \"right\": {\n                  \"raw_text\": \"or other brain-related disorders.\"\n                }\n              }\n            }\n          }\n        }\n      }\n    },\n    \"right\": {\n      \"OR\": {\n        \"left\": {\n          \"raw_text\": \"Have a history of fetal cytomegalovirus infection\"\n        },\n        \"right\": {\n          \"OR\": {\n            \"left\": {\n              \"raw_text\": \"or other congenital infections.\"\n            },\n            \"right\": {\n              \"raw_text\": \"or other congenital infections.\"\n            }\n          }\n        }\n      }\n    }\n  }\n}"