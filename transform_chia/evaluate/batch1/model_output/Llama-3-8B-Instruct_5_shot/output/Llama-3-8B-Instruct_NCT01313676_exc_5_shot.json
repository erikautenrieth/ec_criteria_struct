"{\n  \"AND\": {\n    \"left\": {\n      \"AND\": {\n        \"left\": {\n          \"AND\": {\n            \"left\": {\n              \"OR\": {\n                \"left\": {\n                  \"raw_text\": \"Pregnant or lactating women\"\n                },\n                \"right\": {\n                  \"OR\": {\n                    \"left\": {\n                      \"raw_text\": \"Subjects with a current diagnosis of asthma\"\n                    },\n                    \"right\": {\n                      \"OR\": {\n                        \"left\": {\n                          \"raw_text\": \"Subjects with known alpha-1 antitrypsin deficiency as the underlying cause of COPD\"\n                        },\n                        \"right\": {\n                          \"OR\": {\n                            \"left\": {\n                              \"raw_text\": \"Subjects with active tuberculosis, lung cancer, bronchiectasis, sarcoidosis, pulmonary fibrosis, pulmonary hypertension, interstitial lung diseases or other active pulmonary diseases\"\n                            },\n                            \"right\": {\n                              \"OR\": {\n                                \"left\": {\n                                  \"raw_text\": \"Subjects with lung volume reduction surgery within the 12 months prior to Screening or having had a lung transplant\"\n                                },\n                                \"right\": {\n                                  \"OR\": {\n                                    \"left\": {\n                                      \"raw_text\": \"Subjects with a moderate/severe COPD exacerbation that has not resolved at least 14 days prior to Visit 1 and at least 30 days following the last dose of oral corticosteroids (if applicable)\"\n                                    },\n                                    \"right\": {\n                                      \"OR\": {\n                                        \"left\": {\n                                          \"raw_text\": \"Subjects with current severe heart failure (New York Heart Association class IV)\"\n                                        },\n                                        \"right\": {\n                                          \"OR\": {\n                                            \"left\": {\n                                              \"raw_text\": \"Subjects with a known ejection fraction of <30% or if they have an implantable cardioverter defibrillator (ICD)\"\n                                            },\n                                            \"right\": {\n                                              \"OR\": {\n                                                \"left\": {\n                                                  \"raw_text\": \"Any life-threatening condition with life expectancy <3 years, other than vascular disease or COPD, that might prevent the subject from completing the study\"\n                                                },\n                                                \"right\": {\n                                                  \"OR\": {\n                                                    \"left\": {\n                                                      \"raw_text\": \"Subjects will be excluded if on renal replacement therapy (hemodialysis or peritoneal)\"\n                                                    },\n                                                    \"right\": {\n                                                      \"OR\": {\n                                                        \"left\": {\n                                                          \"raw_text\": \"Subjects with a history of hypersensitivity to any of the study medications (e.g. beta-agonists, corticosteroid) or components of the inhalation powder (e.g. lactose, magnesium stearate)\"\n                                                        },\n                                                        \"right\": {\n                                                          \"OR\": {\n                                                            \"left\": {\n                                                              \"raw_text\": \"Patients with a history of severe milk protein allergy that, in the opinion of the study physician, contraindicates the subject's participation\"\n                                                            },\n                                                            \"right\": {\n                                                              \"OR\": {\n                                                                \"left\": {\n                                                                  \"raw_text\": \"Subjects with a known or suspected history of alcohol or drug abuse within the last 2 years\"\n                                                                },\n                                                                \"right\": {\n                                                                  \"OR\": {\n                                                                    \"left\": {\n                                                                      \"raw_text\": \"Subjects receiving treatment with long-term oxygen therapy (LTOT) or nocturnal oxygen therapy required for greater than 12 hours a day\"\n                                                                    },\n                                                                    \"right\": {\n                                                                      \"OR\": {\n                                                                        \"left\": {\n                                                                          \"raw_text\": \"Study investigators, sub-investigators, study coordinators, employees of a participating investigator or immediate family members of the aforementioned are excluded from participating in this study\"\n                                                                        },\n                                                                        \"right\": {\n                                                                          \"OR\": {\n                                                                            \"left\": {\n                                                                              \"raw_text\": \"Use of the following medications within the following time intervals prior to Visit 1 or during the study (unless otherwise specified)\"\n                                                                            },\n                                                                            \"right\": {\n                                                                              \"OR\": {\n                                                                                \"left\": {\n                                                                                  \"raw_text\": \"Inhaled Long acting beta-agonists (LABA) 48 hours\"\n                                                                                },\n                                                                                \"right\": {\n                                                                                  \"OR\": {\n                                                                                    \"left\": {\n                                                                                      \"raw_text\": \"ICS/LABA combination products 48 hours\"\n                                                                                    },\n                                                                                    \"right\": {\n                                                                                      \"OR\": {\n                                                                                        \"left\": {\n                                                                                          \"raw_text\": \"Inhaled corticosteroids 48 hours\"\n                                                                                        },\n                                                                                        \"right\": {\n                                                                                          \"OR\": {\n                                                                                            \"left\": {\n                                                                                              \"raw_text\": \"Tiotropium 1 week\"\n                                                                                            },\n                                                                                            \"right\": {\n                                                                                              \"OR\": {\n                                                                                                \"left\": {\n                                                                                                  \"raw_text\": \"Systemic, Oral, parenteral, intra-articular corticosteroids 30 days (oral and systemic corticosteroids may be used to treat COPD exacerbations during the study)\"\n                                                                                                },\n                                                                                                \"right\": {\n                                                                                                  \"OR\": {\n                                                                                                    \"left\": {\n                                                                                                      \"raw_text\": \"Cytochrome P450 3A4 strong inhibitors including but not limited to antiretrovirals (protease inhibitors) (e.g. Indinavir, Nelfinavir, Ritonavir, Saquinavir); Imidazole and Triazole anti-fungals (e.g. Ketaconazole, Itraconazole); Clarithromycin, Telithromycin, Amiodarone, and Nefazodone 6 weeks\"\n                                                                                                    },\n                                                                                                  \"right\": {\n                                                                                                    \"OR\": {\n                                                                                                      \"left\": {\n                                                                                                        \"raw_text\": \"Grapefruit is allowed up to Visit 1, then limited to no more than one glass of grapefruit juice (250 mL/ 8 ounces) or one grapefruit per day\"\n                                                                                                      },\n                                                                                                      \"right\": {\n                                                                                                        \"OR\": {\n                                                                                                          \"left\": {\n                                                                                                            \"raw_text\": \"Any other investigational drug 30 days or 5 half lives whichever is longer\"\n                                                                                                          }\n                                                                                                        }\n                                                                                                      }\n                                                                                                    }\n                                                                                                  }\n                                                                                              }\n                                                                                          }\n                                                                                      }\n                                                                                    }\n                                                                                  }\n                                                                                }\n                                                                              }\n                                                                            }\n                                                                          }\n                                                                        }\n                                                                      }\n                                                                    }\n                                                                  }\n                                                                }\n                                                              }\n                                                            }\n                                                          }\n                                                        }\n                                                      }\n                                                    }\n                                                  }\n                                                }\n                                              }\n                                            }\n                                          }\n                                        }\n                                      }\n                                    }\n                                  }\n                                }\n                              }\n                            }\n                          }\n                        }\n                      }\n                    }\n                  }\n                }\n              }\n            }\n          }\n        }\n      }\n    }\n  }\n}"