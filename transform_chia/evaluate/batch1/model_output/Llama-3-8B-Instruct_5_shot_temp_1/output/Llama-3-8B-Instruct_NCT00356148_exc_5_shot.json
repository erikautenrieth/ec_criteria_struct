"{\n  \"AND\": {\n    \"left\": {\n      \"AND\": {\n        \"left\": {\n          \"AND\": {\n            \"left\": {\n              \"AND\": {\n                \"left\": {\n                  \"OR\": {\n                    \"left\": {\n                      \"raw_text\": \"Have a history of ductal carcinoma in situ (DCIS)\"\n                    },\n                    \"right\": {\n                      \"OR\": {\n                        \"left\": {\n                          \"raw_text\": \"or distant metastatic stage\"\n                        },\n                        \"right\": {\n                          \"raw_text\": \"or receiving neoadjuvant therapy\"\n                        }\n                      }\n                    }\n                  }\n                },\n                \"right\": {\n                  \"OR\": {\n                    \"left\": {\n                      \"raw_text\": \"Have a history of receiving antibiotics within the prior 3 months\"\n                    },\n                    \"right\": {\n                      \"OR\": {\n                        \"left\": {\n                          \"raw_text\": \"or have a history of immunodeficiency\"\n                        },\n                        \"right\": {\n                          \"raw_text\": \"or have a remote infection\"\n                        }\n                      }\n                    }\n                  }\n                }\n              }\n            },\n            \"right\": {\n              \"OR\": {\n                \"left\": {\n                  \"raw_text\": \"or have a history of reaction to study antibiotics\"\n                },\n                \"right\": {\n                  \"raw_text\": \"or denial of signing the consent form\"\n                }\n              }\n            }\n          }\n        },\n        \"right\": {\n          \"raw_text\": \"or have a history of other cancer (except non-melanoma skin cancer)\"\n        }\n      }\n    }\n  }\n}"