"{\n  \"AND\": {\n    \"left\": {\n      \"OR\": {\n        \"left\": {\n          \"raw_text\": \"Have received prior chemotherapy for unresectable disease\"\n        },\n        \"right\": {\n          \"raw_text\": \"or have received prior radiation therapy for unresectable disease\"\n        }\n      }\n    },\n    \"right\": {\n      \"AND\": {\n        \"left\": {\n          \"OR\": {\n            \"left\": {\n              \"raw_text\": \"Have any active or uncontrolled infection, including known HIV infection\"\n            },\n            \"right\": {\n              \"OR\": {\n                \"left\": {\n                  \"raw_text\": \"or have active hepatitis B\"\n                },\n                \"right\": {\n                  \"raw_text\": \"or have active hepatitis C with liver tests qualifying for study participation\"\n                }\n              }\n            }\n          },\n          \"right\": {\n            \"OR\": {\n              \"left\": {\n                \"raw_text\": \"Have psychiatric disorders that would interfere with consent or follow-up\"\n              },\n              \"right\": {\n                \"OR\": {\n                  \"left\": {\n                    \"raw_text\": \"or be pregnant or lactating\"\n                  },\n                  \"right\": {\n                    \"OR\": {\n                      \"left\": {\n                        \"raw_text\": \"or be men or women of reproductive potential without an effective contraceptive method\"\n                      }\n                    }\n                  }\n                }\n              }\n            }\n          }\n        }\n      }\n    }\n  }\n}"