"{\n  \"AND\": {\n    \"left\": {\n      \"AND\": {\n        \"left\": {\n          \"AND\": {\n            \"left\": {\n              \"AND\": {\n                \"left\": {\n                  \"OR\": {\n                    \"left\": {\n                      \"raw_text\": \"History of radiation therapy to the brain or spine\"\n                    },\n                    \"right\": {\n                      \"OR\": {\n                        \"left\": {\n                          \"raw_text\": \"or other areas that would result in overlap with the planned radiation fields\"\n                        },\n                        \"right\": {\n                          \"raw_text\": \"or would compromise the ability to deliver the planned radiation dose.\"\n                        }\n                      }\n                    }\n                  }\n                },\n                \"right\": {\n                  \"OR\": {\n                    \"left\": {\n                      \"raw_text\": \"Active or uncontrolled bleeding or bleeding diathesis\"\n                    },\n                    \"right\": {\n                      \"OR\": {\n                        \"left\": {\n                          \"raw_text\": \"or coagulopathy that would increase the risk of bleeding during or after radiotherapy.\"\n                        },\n                        \"right\": {\n                          \"raw_text\": \"or would compromise the ability to deliver the planned radiation dose.\"\n                        }\n                      }\n                    }\n                  }\n                }\n              }\n            },\n            \"right\": {\n              \"OR\": {\n                \"left\": {\n                  \"raw_text\": \"History of angioplasty with stenting\"\n                },\n                \"right\": {\n                  \"raw_text\": \"or other vascular interventions that would increase the risk of bleeding or compromise the ability to deliver the planned radiation dose.\"\n                }\n              }\n            }\n          }\n        },\n        \"right\": {\n          \"raw_text\": \"or other medical conditions that would increase the risk of bleeding or compromise the ability to deliver the planned radiation dose.\"\n        }\n      }\n    },\n    \"right\": {\n      \"raw_text\": \"or other contra-indications of radiotherapy.\"\n    }\n  }\n}"