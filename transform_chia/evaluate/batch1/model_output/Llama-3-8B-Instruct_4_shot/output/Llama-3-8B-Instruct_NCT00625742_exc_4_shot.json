{
  "OR": {
    "left": {
      "AND": {
        "left": {
          "raw_text": "1. Have dementia or delirium (as determined by the palliative care specialist) at study entry."
        }
      }
    },
    "right": {
      "OR": {
        "left": {
          "raw_text": "2. Are pregnant"
        }
      }
    }
  }
}

{
  "OR": {
    "left": {
      "AND": {
        "left": {
          "raw_text": "3. Have been taking corticosteroids for longer than 48 hours."
        }
      }
    }
  }
}

{
  "OR": {
    "left": {
      "AND": {
        "left": {
          "raw_text": "4. Have pulmonary edema, ascites or pitting edema on clinical examination."
        }
      }
    }
  }
}

{
  "OR": {
    "left": {
      "AND": {
        "left": {
          "raw_text": "5. Are unable to walk."
        }
      }
    }
  }
}

{
  "OR": {
    "left": {
      "AND": {
        "left": {
          "OR": {
            "left": {
              "raw_text": "6. Have a history of serious adverse gastrointestinal events (i.e., bleeding or perforation),"
            },
            "right": {
              "OR": {
                "left": {
                  "raw_text": "history of a coagulopathy"
                },
                "right": {
                  "raw_text": "or current anti-coagulant use."
                }
              }
            }
          }
        }
      }
    }
  }
}

{
  "OR": {
    "left": {
      "AND": {
        "left": {
          "raw_text": "7. Have an ALT/AST>3x upper limit of normal."
        }
      }
    }
  }
}

{
  "OR": {
    "left": {
      "AND": {
        "left": {
          "raw_text": "8. Patients on methotrexate."
        }
      }
    }
  }
}

{
  "OR": {
    "left": {
      "AND": {
        "left": {
          "raw_text": "9. Patients taking melatonin receptor agonists (such as Rozerem [ramelteon])."
        }
      }
    }
  }
}