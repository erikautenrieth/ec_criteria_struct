"{\n  \"AND\": {\n    \"left\": {\n      \"AND\": {\n        \"left\": {\n          \"AND\": {\n            \"left\": {\n              \"AND\": {\n                \"left\": {\n                  \"raw_text\": \"Stable or unstable angina pectoris and ischemia\"\n                },\n                \"right\": {\n                  \"OR\": {\n                    \"left\": {\n                      \"raw_text\": \"or atypical chest pain\"\n                    },\n                    \"right\": {\n                      \"raw_text\": \"or asymptomatic with documented myocardial ischaemia\"\n                    }\n                  }\n                }\n              }\n            },\n            \"right\": {\n              \"raw_text\": \"Eligible for coronary revascularization\"\n            }\n          }\n        },\n        \"right\": {\n          \"AND\": {\n            \"left\": {\n              \"raw_text\": \"At least 2 lesions in different vessels and territories\"\n            },\n            \"right\": {\n              \"raw_text\": \"potentially amenable to stent implantation\"\n            }\n          }\n        }\n      }\n    },\n    \"right\": {\n      \"AND\": {\n        \"left\": {\n          \"AND\": {\n            \"left\": {\n              \"raw_text\": \"de novo native vessels\"\n            },\n            \"right\": {\n              \"raw_text\": \"Multivessel disease with at least one significant stenosis in LAD\"\n            }\n          }\n        },\n        \"right\": {\n          \"AND\": {\n            \"left\": {\n              \"raw_text\": \"and with treatment of the lesion in another major epicardial coronary artery\"\n            },\n            \"right\": {\n              \"raw_text\": \"Left ventricular ejection fraction at least 30%\"\n            }\n          }\n        }\n      }\n    }\n  }\n}"