"{\n  \"AND\": {\n    \"left\": {\n      \"AND\": {\n        \"left\": {\n          \"AND\": {\n            \"left\": {\n              \"raw_text\": \"Adequate performance status\"\n            },\n            \"right\": {\n              \"OR\": {\n                \"left\": {\n                  \"raw_text\": \"Breast - Karnofsky score > 50\"\n                },\n                \"right\": {\n                  \"OR\": {\n                    \"left\": {\n                      \"raw_text\": \"Ovarian, endometrial or cervical - Gynecologic Oncology Group (GOG) performance score ≤2\"\n                    },\n                    \"right\": {\n                      \"raw_text\": \"If female and of childbearing potential, are willing to use adequate contraception\"\n                    }\n                  }\n                }\n              }\n            }\n          }\n        },\n        \"right\": {\n          \"raw_text\": \"Normal organ function within 14 days of study entry\"\n        }\n      }\n    },\n    \"right\": {\n      \"AND\": {\n        \"left\": {\n          \"OR\": {\n            \"left\": {\n              \"raw_text\": \"Metastatic breast cancer (BR)\"\n            },\n            \"right\": {\n              \"OR\": {\n                \"left\": {\n                  \"raw_text\": \"Metastatic ovarian cancer (OV)\"\n                },\n                \"right\": {\n                  \"OR\": {\n                    \"left\": {\n                      \"raw_text\": \"Metastatic endometrial cancer (EM)\"\n                    },\n                    \"right\": {\n                      \"raw_text\": \"Metastatic cervical cancer (CX)\"\n                    }\n                  }\n                }\n              }\n            }\n          }\n        },\n        \"right\": {\n          \"AND\": {\n            \"left\": {\n              \"raw_text\": \"Measurable metastatic disease (>1cm) in at least one site other than bone-only\"\n            },\n            \"