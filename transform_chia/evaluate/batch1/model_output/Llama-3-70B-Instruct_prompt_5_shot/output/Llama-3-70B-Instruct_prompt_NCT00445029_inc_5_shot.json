"{\n  \"AND\": {\n    \"left\": {\n      \"AND\": {\n        \"left\": {\n          \"AND\": {\n            \"left\": {\n              \"AND\": {\n                \"left\": {\n                  \"raw_text\": \"Age between 18 and 65 years old\"\n                },\n                \"right\": {\n                  \"raw_text\": \"Both genders eligible for study\"\n                }\n              }\n            },\n            \"right\": {\n              \"AND\": {\n                \"left\": {\n                  \"raw_text\": \"Female participants must use a contraceptive method\"\n                },\n                \"right\": {\n                  \"raw_text\": \"Feasibility of patch testing\"\n                }\n              }\n            }\n          }\n        },\n        \"right\": {\n          \"AND\": {\n            \"left\": {\n              \"raw_text\": \"Ability to understand and sign the Informed Consent\"\n            },\n            \"right\": {\n              \"raw_text\": \"and comply with all aspects of the protocol\"\n            }\n          }\n        }\n      }\n    },\n    \"right\": {\n      \"OR\": {\n        \"left\": {\n          \"AND\": {\n            \"left\": {\n              \"raw_text\": \"Allergic patients with a history of PPD contact dermatitis\"\n            },\n            \"right\": {\n              \"raw_text\": \"and positive PPD patch tests\"\n            }\n          }\n        },\n        \"right\": {\n          \"AND\": {\n            \"left\": {\n              \"raw_text\": \"Healthy volunteers with no history of PPD allergic contact dermatitis\"\n            },\n            \"right\": {\n              \"raw_text\": \"and a negative PPD patch test\"\n            }\n          }\n        }\n      }\n    }\n  }\n}"