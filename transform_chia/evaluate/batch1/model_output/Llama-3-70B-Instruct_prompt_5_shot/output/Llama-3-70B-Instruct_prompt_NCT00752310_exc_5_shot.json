"{\n  \"AND\": {\n    \"left\": {\n      \"AND\": {\n        \"left\": {\n          \"NOT\": {\n            \"left\": {\n              \"raw_text\": \"Positive HIV 1 or HIV 2 test at screening\"\n            }\n          }\n        },\n        \"right\": {\n          \"NOT\": {\n            \"left\": {\n              \"raw_text\": \"History of significant skin disease such as, but not limited to rash or eruptions, drug allergies, food allergy, dermatitis, eczema, psoriasis, or urticaria\"\n            }\n          }\n        }\n      }\n    },\n    \"right\": {\n      \"AND\": {\n        \"left\": {\n          \"NOT\": {\n            \"left\": {\n              \"raw_text\": \"History of allergy to drugs such as, but not limited to, sulphonamides and penicillins\"\n            }\n          }\n        },\n        \"right\": {\n          \"AND\": {\n            \"left\": {\n              \"NOT\": {\n                \"left\": {\n                  \"raw_text\": \"Previously demonstrated clinically significant allergy or hypersensitivity to any of the excipients of the investigational medication administered in this trial\"\n                }\n              }\n            },\n            \"right\": {\n              \"AND\": {\n                \"left\": {\n                  \"NOT\": {\n                    \"left\": {\n                      \"raw_text\": \"Female subject of childbearing potential without use of effective nonhormonal birth control methods, or not willing to continue practicing these birth control methods for at least 30 days after the end of the treatment period\"\n                    }\n                  }\n                },\n                \"right\": {\n                  \"NOT\": {\n                    \"left\": {\n                      \"raw_text\": \"Positive pregnancy test or breast feeding at screening\"\n                    }\n                  }\n                }\n              }\n            }\n          }\n        }\n      }\n    }\n  }\n}"