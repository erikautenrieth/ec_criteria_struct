"{\n  \"AND\": {\n    \"left\": {\n      \"AND\": {\n        \"left\": {\n          \"AND\": {\n            \"left\": {\n              \"AND\": {\n                \"left\": {\n                  \"raw_text\": \"HIV infection with plasma and CSF HIV RNA concentrations > 1,000 copies/ mL\"\n                },\n                \"right\": {\n                  \"raw_text\": \"(available after baseline LP)\"\n                }\n              }\n            },\n            \"right\": {\n              \"AND\": {\n                \"left\": {\n                  \"raw_text\": \"Off antiretroviral therapy (ART) for > 6 weeks before the study\"\n                },\n                \"right\": {\n                  \"raw_text\": \"and no plans to begin treatment for the study duration\"\n                }\n              }\n            }\n          }\n        },\n        \"right\": {\n          \"AND\": {\n            \"left\": {\n              \"raw_text\": \"Predicted adherence to the medication\"\n            },\n            \"right\": {\n              \"AND\": {\n                \"left\": {\n                  \"raw_text\": \"Capable of providing informed consent\"\n                },\n                \"right\": {\n                  \"AND\": {\n                    \"left\": {\n                      \"raw_text\": \"> 18 years old\"\n                    },\n                    \"right\": {\n                      \"AND\": {\n                        \"left\": {\n                          \"raw_text\": \"CD4 cell counts >150 cells/μL\"\n                        },\n                        \"right\": {\n                          \"raw_text\": \"When available, subjects will be screened for stability of blood CD4 and HIV RNA levels\"\n                        }\n                      }\n                    }\n                  }\n                }\n              }\n            }\n          }\n        }\n      }\n    },\n    \"right\": {\n      \"raw_text\": \"\"\n    }\n  }\n}"