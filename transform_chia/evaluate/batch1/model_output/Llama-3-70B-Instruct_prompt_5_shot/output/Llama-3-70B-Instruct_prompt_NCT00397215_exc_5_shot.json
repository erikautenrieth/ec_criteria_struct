"{\n  \"AND\": {\n    \"left\": {\n      \"AND\": {\n        \"left\": {\n          \"AND\": {\n            \"left\": {\n              \"AND\": {\n                \"left\": {\n                  \"OR\": {\n                    \"left\": {\n                      \"raw_text\": \"Has received licensed MF59-containing vaccines\"\n                    },\n                    \"right\": {\n                      \"OR\": {\n                        \"left\": {\n                          \"raw_text\": \"such as Fluad or Addigrip\"\n                        },\n                        \"right\": {\n                          \"OR\": {\n                            \"left\": {\n                              \"raw_text\": \"or virosome-based influenza vaccines\"\n                            },\n                            \"right\": {\n                              \"raw_text\": \"such as Inflexal V, InfectoVac Flu or Invivac during the 2006-2007 influenza season.\"\n                            }\n                          }\n                        }\n                      }\n                    }\n                  }\n                },\n                \"right\": {\n                  \"OR\": {\n                    \"left\": {\n                      \"raw_text\": \"Has received licensed vaccines within 2 weeks\"\n                    },\n                    \"right\": {\n                      \"OR\": {\n                        \"left\": {\n                          \"raw_text\": \"(for inactivated vaccines) or 4 weeks\"\n                        },\n                        \"right\": {\n                          \"raw_text\": \"(for live vaccines) prior to enrolment in this study.\"\n                        }\n                      }\n                    }\n                  }\n                }\n              }\n            },\n            \"right\": {\n              \"OR\": {\n                \"left\": {\n                  \"raw_text\": \"Has planned administration of a vaccine not foreseen by the study protocol\"\n                },\n                \"right\": {\n                  \"raw_text\": \"up to 30 days after the second vaccination with H5N1 vaccine.\"\n                }\n              }\n            }\n          }\n        },\n        \"right\": {\n          \"OR\": {\n            \"left\": {\n              \"raw_text\": \"Has chronic administration of immunosuppressants or other immune-modifying drugs\"\n            },\n            \"right\": {\n              \"raw_text\": \"within six months prior to the first administration of the study vaccine.\"\n            }\n          }\n        }\n      }\n    },\n    \"right\": {\n      \"OR\": {\n        \"left\": {\n          \"raw_text\": \"Has any confirmed or suspected immunosuppressive or immunodeficient condition\"\n        },\n        \"right\": {\n          \"raw_text\": \"based on medical history and physical examination.\"\n        }\n      }\n    }\n  }\n}"