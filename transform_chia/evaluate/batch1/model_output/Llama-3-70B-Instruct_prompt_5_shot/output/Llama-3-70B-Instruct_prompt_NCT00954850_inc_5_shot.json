"{\n  \"AND\": {\n    \"left\": {\n      \"AND\": {\n        \"left\": {\n          \"raw_text\": \"Adults (18 and older)\"\n        },\n        \"right\": {\n          \"OR\": {\n            \"left\": {\n              \"raw_text\": \"with physiologically confirmed SA\"\n            },\n            \"right\": {\n              \"raw_text\": \"or mild-moderate asthma\"\n            }\n          }\n        }\n      }\n    },\n    \"right\": {\n      \"AND\": {\n        \"left\": {\n          \"raw_text\": \"followed by an asthma specialist for at least 6 months\"\n        },\n        \"right\": {\n          \"AND\": {\n            \"left\": {\n              \"raw_text\": \"Must agree to have regular clinic visits\"\n            },\n            \"right\": {\n              \"raw_text\": \"(minimum 3-4 per year for SA, 1-2 for mild-moderate asthma)\"\n            }\n          }\n        }\n      }\n    }\n  }\n}"