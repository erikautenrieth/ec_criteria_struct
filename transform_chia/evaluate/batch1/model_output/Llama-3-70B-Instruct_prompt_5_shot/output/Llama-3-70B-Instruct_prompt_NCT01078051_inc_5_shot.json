"{\n  \"AND\": {\n    \"left\": {\n      \"AND\": {\n        \"left\": {\n          \"AND\": {\n            \"left\": {\n              \"AND\": {\n                \"left\": {\n                  \"raw_text\": \"Age > 18 years\"\n                },\n                \"right\": {\n                  \"raw_text\": \"De novo lesion CTO\"\n                }\n              }\n            },\n            \"right\": {\n              \"AND\": {\n                \"left\": {\n                  \"raw_text\": \"Reference vessel size 2.5 mm by visual estimation\"\n                },\n                \"right\": {\n                  \"raw_text\": \"At least one CTO lesions located in proximal or mid epicardial coronary artery\"\n                }\n              }\n            }\n          }\n        },\n        \"right\": {\n          \"AND\": {\n            \"left\": {\n              \"raw_text\": \"Angiographically defined total occlusion over 3 months\"\n            },\n            \"right\": {\n              \"OR\": {\n                \"left\": {\n                  \"raw_text\": \"If no definite symptom with total occlusion\"\n                },\n                \"right\": {\n                  \"raw_text\": \"two experienced operators decide CTO in consideration of angiographical morphology\"\n                }\n              }\n            }\n          }\n        }\n      }\n    },\n    \"right\": {\n      \"raw_text\": \"Patients who are eligible for intracoronary stenting\"\n    }\n  }\n}"