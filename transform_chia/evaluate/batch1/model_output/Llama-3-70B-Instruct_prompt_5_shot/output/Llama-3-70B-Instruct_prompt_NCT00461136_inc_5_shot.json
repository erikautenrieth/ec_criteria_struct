"{\n  \"AND\": {\n    \"left\": {\n      \"AND\": {\n        \"left\": {\n          \"AND\": {\n            \"left\": {\n              \"AND\": {\n                \"left\": {\n                  \"AND\": {\n                    \"left\": {\n                      \"raw_text\": \"Male and/or female patients from 30-80 years of age\"\n                    },\n                    \"right\": {\n                      \"raw_text\": \"with a diagnosis of Type 2 diabetes (WHO criteria)\"\n                    }\n                  }\n                },\n                \"right\": {\n                  \"AND\": {\n                    \"left\": {\n                      \"raw_text\": \"Incipient and established diabetic nephropathy\"\n                    },\n                    \"right\": {\n                      \"raw_text\": \"(urinary albumin excretion ≥ 100 mg/day but ≤ 2000 mg/day)\"\n                    }\n                  }\n                }\n              }\n            },\n            \"right\": {\n              \"AND\": {\n                \"left\": {\n                  \"raw_text\": \"Glomerular filtration rate (GFR) ≥ 40 ml/min\"\n                },\n                \"right\": {\n                  \"raw_text\": \"(estimated using Modification of Diet in Renal Disease (MDRD) formula) in the last 4 months\"\n                }\n              }\n            }\n          }\n        },\n        \"right\": {\n          \"AND\": {\n            \"left\": {\n              \"raw_text\": \"Female patients must be postmenopausal\"\n            },\n            \"right\": {\n              \"OR\": {\n                \"left\": {\n                  \"raw_text\": \"or must have had a bilateral oophorectomy\"\n                },\n                \"right\": {\n                  \"OR\": {\n                    \"left\": {\n                      \"raw_text\": \"or must have been surgically sterilized\"\n                    },\n                    \"right\": {\n                      \"raw_text\": \"or hysterectomized at least 6 months prior to screening\"\n                    }\n                  }\n                }\n              }\n            }\n          }\n        }\n      }\n    },\n    \"right\": {\n      \"AND\": {\n        \"left\": {\n          \"AND\": {\n            \"left\": {\n              \"raw_text\": \"Patients on ongoing hypertensive therapy must have a blood pressure ≥ 135/85 mm Hg\"\n            },\n            \"right\": {\n              \"raw_text\": \"but lower than 170/105 mm Hg at baseline (Day -1)\"\n            }\n          }\n        },\n        \"right\": {\n          \"raw_text\": \"and patients must be on stable antihypertensive medications for at least 8 weeks prior to baseline (Day -1)\"\n        }\n      }\n    }\n  }\n}"