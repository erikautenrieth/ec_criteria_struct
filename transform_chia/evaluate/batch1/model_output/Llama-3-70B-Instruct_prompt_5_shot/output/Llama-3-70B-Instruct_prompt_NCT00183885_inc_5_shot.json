"{\n  \"AND\": {\n    \"left\": {\n      \"AND\": {\n        \"left\": {\n          \"AND\": {\n            \"left\": {\n              \"AND\": {\n                \"left\": {\n                  \"raw_text\": \"Unresectable, histologically confirmed hepatocellular carcinoma\"\n                },\n                \"right\": {\n                  \"raw_text\": \"with evident disease limited to liver\"\n                }\n              }\n            },\n            \"right\": {\n              \"AND\": {\n                \"left\": {\n                  \"raw_text\": \"Tissue from tumor must be available\"\n                },\n                \"right\": {\n                  \"OR\": {\n                    \"left\": {\n                      \"raw_text\": \"This may be paraffin embedded tissue from previous biopsy/resection\"\n                    },\n                    \"right\": {\n                      \"raw_text\": \"or if it is not available, a repeat biopsy must be performed\"\n                    }\n                  }\n                }\n              }\n            }\n          }\n        },\n        \"right\": {\n          \"AND\": {\n            \"left\": {\n              \"raw_text\": \"Patients must agree to have a 20 cc blood sample drawn\"\n            },\n            \"right\": {\n              \"raw_text\": \"in addition to routine labs with each cycle of chemotherapy\"\n            }\n          }\n        }\n      }\n    },\n    \"right\": {\n      \"AND\": {\n        \"left\": {\n          \"AND\": {\n            \"left\": {\n              \"raw_text\": \"Patients must have measurable disease\"\n            },\n            \"right\": {\n              \"raw_text\": \"If prior radiation therapy was administered, measurable disease must be outside the radiation field\"\n            }\n          }\n        },\n        \"right\": {\n          \"AND\": {\n            \"left\": {\n              \"raw_text\": \"Patients must have a Zubrod performance status of 0-2\