"{\n  \"AND\": {\n    \"left\": {\n      \"AND\": {\n        \"left\": {\n          \"AND\": {\n            \"left\": {\n              \"AND\": {\n                \"left\": {\n                  \"OR\": {\n                    \"left\": {\n                      \"raw_text\": \"Systemic therapy or radiotherapy within 4 weeks prior to Day 1\"\n                    },\n                    \"right\": {\n                      \"OR\": {\n                        \"left\": {\n                          \"raw_text\": \"Prior therapy with agents targeting the DR5 apoptosis pathway\"\n                        },\n                        \"right\": {\n                          \"AND\": {\n                            \"left\": {\n                              \"raw_text\": \"Major surgical procedure, open biopsy, or significant traumatic injury within 4 weeks prior to Day 1\"\n                            },\n                            \"right\": {\n                              \"raw_text\": \"or anticipation of need for major surgical procedure during the course of the study\"\n                            }\n                          }\n                        }\n                      }\n                    }\n                  }\n                },\n                \"right\": {\n                  \"OR\": {\n                    \"left\": {\n                      \"raw_text\": \"Other invasive malignancies within 5 years prior to Day 1\"\n                    },\n                    \"right\": {\n                      \"raw_text\": \"Known active brain metastases\"\n                    }\n                  }\n                }\n              }\n            },\n            \"right\": {\n              \"OR\": {\n                \"left\": {\n                  \"raw_text\": \"Uncontrolled intercurrent illness, including but not limited to ongoing or active infection requiring parenteral antibiotics at enrollment\"\n                },\n                \"right\": {\n                  \"AND