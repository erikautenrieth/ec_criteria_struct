{
  "AND": {
    "left": {
      "raw_text": "Eligible patients must meet the following criteria to be enrolled in the study:"
    },
    "right": {
      "AND": {
        "left": {
          "OR": {
            "left": {
              "raw_text": "1. Newly diagnosed, stage IV squamous cell lung cancer. This includes patients who present with disseminated metastases, and those with a malignant pleural"
            },
            "right": {
              "raw_text": "or pericardial effusion (i.e., formerly stage IIIB in the 6th TNM staging system)."
            }
          }
        },
        "right": {
          "AND": {
            "left": {
              "AND": {
                "left": {
                  "raw_text": "2. Patients who have received prior adjuvant therapy for early-stage lung cancer"
                },
                "right": {
                  "raw_text": "are eligible if at least 12 months have elapsed from that treatment."
                }
              }
            },
            "right": {
              "AND": {
                "left": {
                  "AND": {
                    "left": {
                      "raw_text": "3. Histologically"
                    },
                    "right": {
                      "AND": {
                        "left": {
                          "raw_text": "confirmed squamous cell bronchogenic carcinoma. Patients whose tumors contain mixed non-small cell histologies"
                        },
                        "right": {
                          "NOT": {
                            "left": {
                              "raw_text": "small cell anaplastic elements are not eligible. Cytologic specimens obtained by brushings, washings, or needle aspiration of the defined lesion are acceptable."
                            }
                          }
                        }
                      }
                    }
                  }
                },
                "right": {
                  "AND": {
                    "left": {
                      "AND": {
                        "left": {
                          "raw_text": "4. Patients with previous radiotherapy"
                        },
                        "right": {
                          "NOT": {
                            "left": {
                              "OR": {
                                "left": {
                                  "raw_text": ""
                                },
                                "right": {
                                  "NOT": {
                                    "left": {
                                      "AND": {
                                        "left": {
                                          "raw_text": "chemo/radiation for locally advanced NSCLC are not eligible. Patients who have received palliative radiation therapy"
                                        },
                                        "right": {
                                          "raw_text": "for symptomatic metastases must have completed treatment >14 days prior the initiation of the study treatment."
                                        }
                                      }
                                    }
                                  }
                                }
                              }
                            }
                          }
                        }
                      }
                    },
                    "right": {
                      "AND": {
                        "left": {
                          "raw_text": "5. Presence of evaluable (measureable or non-measurable) disease."
                        },
                        "right": {
                          "AND": {
                            "left": {
                              "raw_text": "6. ECOG Performance Status of 0 or 1."
                            },
                            "right": {
                              "AND": {
                                "left": {
                                  "raw_text": "7. Laboratory values as follows:"
                                },
                                "right": {
                                  "AND": {
                                    "left": {
                                      "raw_text": "Absolute neutrophil count (ANC) >1,500/microL and platelets >100,000/microL (\u226472 hours prior to initial treatment)."
                                    },
                                    "right": {
                                      "AND": {
                                        "left": {
                                          "raw_text": "Hemoglobin >9 g/dL (Note: Patients may be transfused or receive erythropoietin to maintain or exceed this level)."
                                        },
                                        "right": {
                                          "AND": {
                                            "left": {
                                              "raw_text": "Bilirubin < ULN."
                                            },
                                            "right": {
                                              "AND": {
                                                "left": {
                                                  "NOT": {
                                                    "left": {
                                                      "OR": {
                                                        "left": {
                                                          "raw_text": "no liver involvement"
                                                        },
                                                        "right": {
                                                          "raw_text": "or \u22645 times the upper limit of normal with liver involvement."
                                                        }
                                                      }
                                                    }
                                                  }
                                                },
                                                "right": {
                                                  "AND": {
                                                    "left": {
                                                      "OR": {
                                                        "left": {
                                                          "raw_text": "Creatinine"
                                                        },
                                                        "right": {
                                                          "raw_text": "<2.0 mg/dL, or creatinine clearance >40 mL/min (as calculated by the Cockcroft-Gault method."
                                                        }
                                                      }
                                                    },
                                                    "right": {
                                                      "AND": {
                                                        "left": {
                                                          "raw_text": "8. Women of childbearing potential must have a negative serum pregnancy test performed within 7 days prior to start of treatment. Women of childbearing potential or men with partners of childbearing potential must use effective birth control measures during treatment and at least 6 months after the last dose of the study treatment. If a woman becomes pregnant or suspects she is pregnant while participating in this study, she must agree to inform her treating physician immediately. Sexually active men must agree to use a medically acceptable form of birth control during treatment and at least 6 months after the last dose. If a female partner becomes pregnant during the course of the study the treating physician should be informed immediately."
                                                        },
                                                        "right": {
                                                          "AND": {
                                                            "left": {
                                                              "raw_text": "9. >18 years of age."
                                                            },
                                                            "right": {
                                                              "AND": {
                                                                "left": {
                                                                  "raw_text": "10. Ability to understand the nature of this study, give written informed consent, and comply with study requirements."
                                                                },
                                                                "right": {
                                                                  "AND": {
                                                                    "left": {
                                                                      "raw_text": "11. Patients entering this study must be willing to provide tissue from a previous tumor biopsy (if available) for correlative testing. An exception to this is when the national/local regulations prohibits some of the key activities of this research like the export of samples to third countries, storage of coded samples or global gene expression profiling without a pre-specified list of target genes. If tissue is not available, a patient will still be eligible for enrollment into the study."
                                                                    }
                                                                  }
                                                                }
                                                              }
                                                            }
                                                          }
                                                        }
                                                      }
                                                    }
                                                  }
                                                }
                                              }
                                            }
                                          }
                                        }
                                      }
                                    }
                                  }
                                }
                              }
                            }
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}