{
  "AND": {
    "left": {
      "raw_text": "1. Decrease in size of the designated target ulcer(s) by \u2265 30% during the 7-day screening period"
    },
    "right": {
      "AND": {
        "left": {
          "raw_text": "2. Cannot tolerate or comply with compression therapy."
        },
        "right": {
          "AND": {
            "left": {
              "raw_text": "3. An ulcer which shows signs of severe clinical infection, defined as pus oozing from the ulcer site"
            },
            "right": {
              "AND": {
                "left": {
                  "raw_text": "4. An ulcer positive for \u03b2-hemolytic streptococci upon culture"
                },
                "right": {
                  "AND": {
                    "left": {
                      "AND": {
                        "left": {
                          "raw_text": "5. The ulcer"
                        },
                        "right": {
                          "OR": {
                            "left": {
                              "raw_text": "has > 50% slough, significant necrotic tissue"
                            },
                            "right": {
                              "OR": {
                                "left": {
                                  "raw_text": ", bone"
                                },
                                "right": {
                                  "OR": {
                                    "left": {
                                      "raw_text": ", tendon"
                                    },
                                    "right": {
                                      "OR": {
                                        "left": {
                                          "raw_text": ", or capsule exposure"
                                        },
                                        "right": {
                                          "raw_text": "or avascular ulcer beds"
                                        }
                                      }
                                    }
                                  }
                                }
                              }
                            }
                          }
                        }
                      }
                    },
                    "right": {
                      "AND": {
                        "left": {
                          "raw_text": "6. Is highly exuding (i.e. requires daily change of dressing)"
                        },
                        "right": {
                          "AND": {
                            "left": {
                              "raw_text": "7. Ankle brachial pressure index <0.65"
                            },
                            "right": {
                              "AND": {
                                "left": {
                                  "raw_text": "8. Patients with active systemic infections"
                                },
                                "right": {
                                  "AND": {
                                    "left": {
                                      "AND": {
                                        "left": {
                                          "raw_text": "9. Patients with clinically significant"
                                        },
                                        "right": {
                                          "OR": {
                                            "left": {
                                              "raw_text": "medical conditions as determined by the investigator including renal"
                                            },
                                            "right": {
                                              "OR": {
                                                "left": {
                                                  "raw_text": ", hepatic"
                                                },
                                                "right": {
                                                  "OR": {
                                                    "left": {
                                                      "raw_text": ", hematologic"
                                                    },
                                                    "right": {
                                                      "OR": {
                                                        "left": {
                                                          "raw_text": ", neurologic"
                                                        },
                                                        "right": {
                                                          "raw_text": "or immune disease. Examples include but are not limited to:"
                                                        }
                                                      }
                                                    }
                                                  }
                                                }
                                              }
                                            }
                                          }
                                        }
                                      }
                                    },
                                    "right": {
                                      "AND": {
                                        "left": {
                                          "AND": {
                                            "left": {
                                              "raw_text": "1. Renal insufficiency"
                                            },
                                            "right": {
                                              "raw_text": "as an estimated GFR which is < 30 mL/min/1.7m2"
                                            }
                                          }
                                        },
                                        "right": {
                                          "AND": {
                                            "left": {
                                              "raw_text": "2. Abnormal blood biochemistry defined as 3 times that of the upper limit of the normal range."
                                            },
                                            "right": {
                                              "AND": {
                                                "left": {
                                                  "OR": {
                                                    "left": {
                                                      "raw_text": "3. Hepatic insufficiency defined as total bilirubin"
                                                    },
                                                    "right": {
                                                      "raw_text": "> 2 mg/dL or serum albumin < 25 g/L"
                                                    }
                                                  }
                                                },
                                                "right": {
                                                  "AND": {
                                                    "left": {
                                                      "raw_text": "4. HbA1c > 9%"
                                                    },
                                                    "right": {
                                                      "AND": {
                                                        "left": {
                                                          "raw_text": "5. Hemoglobin < 10 g/dL"
                                                        },
                                                        "right": {
                                                          "AND": {
                                                            "left": {
                                                              "raw_text": "6. Hematocrit < 0.30"
                                                            },
                                                            "right": {
                                                              "AND": {
                                                                "left": {
                                                                  "raw_text": "7. Platelet count < 100,000"
                                                                },
                                                                "right": {
                                                                  "AND": {
                                                                    "left": {
                                                                      "OR": {
                                                                        "left": {
                                                                          "raw_text": "10. Presence of an active systemic"
                                                                        },
                                                                        "right": {
                                                                          "OR": {
                                                                            "left": {
                                                                              "raw_text": "or local cancer"
                                                                            },
                                                                            "right": {
                                                                              "AND": {
                                                                                "left": {
                                                                                  "raw_text": "or tumor of any kind"
                                                                                },
                                                                                "right": {
                                                                                  "NOT": {
                                                                                    "left": {
                                                                                      "raw_text": "with the exception of non-melanoma skin cancer)"
                                                                                    }
                                                                                  }
                                                                                }
                                                                              }
                                                                            }
                                                                          }
                                                                        }
                                                                      }
                                                                    },
                                                                    "right": {
                                                                      "AND": {
                                                                        "left": {
                                                                          "OR": {
                                                                            "left": {
                                                                              "raw_text": "11. Patients with severe rheumatoid arthritis"
                                                                            },
                                                                            "right": {
                                                                              "raw_text": "(with more than 20 persistently inflamed joints, or below lower normal limit blood albumin level, or evidence of bone and cartilage damage on x-ray, or inflammation in tissues other than joints) and other collagen vascular diseases."
                                                                            }
                                                                          }
                                                                        },
                                                                        "right": {
                                                                          "AND": {
                                                                            "left": {
                                                                              "raw_text": "12. Patients with active connective tissue disease"
                                                                            },
                                                                            "right": {
                                                                              "AND": {
                                                                                "left": {
                                                                                  "OR": {
                                                                                    "left": {
                                                                                      "raw_text": "13. Treatment"
                                                                                    },
                                                                                    "right": {
                                                                                      "raw_text": "with systemic corticosteroids (>15 mg/day), or current immunosuppressive agents"
                                                                                    }
                                                                                  }
                                                                                },
                                                                                "right": {
                                                                                  "AND": {
                                                                                    "left": {
                                                                                      "OR": {
                                                                                        "left": {
                                                                                          "raw_text": "14. Previous"
                                                                                        },
                                                                                        "right": {
                                                                                          "raw_text": "or current radiation therapy or likelihood to receive this therapy during study participation"
                                                                                        }
                                                                                      }
                                                                                    },
                                                                                    "right": {
                                                                                      "AND": {
                                                                                        "left": {
                                                                                          "OR": {
                                                                                            "left": {
                                                                                              "raw_text": "15. Pregnant"
                                                                                            },
                                                                                            "right": {
                                                                                              "raw_text": "or nursing patients"
                                                                                            }
                                                                                          }
                                                                                        },
                                                                                        "right": {
                                                                                          "AND": {
                                                                                            "left": {
                                                                                              "raw_text": "16. Known prior inability or unavailability to complete required study visits during study participation"
                                                                                            },
                                                                                            "right": {
                                                                                              "AND": {
                                                                                                "left": {
                                                                                                  "raw_text": "17. Significant peripheral edema as per investigator's discretion"
                                                                                                },
                                                                                                "right": {
                                                                                                  "AND": {
                                                                                                    "left": {
                                                                                                      "OR": {
                                                                                                        "left": {
                                                                                                          "raw_text": "18. A psychiatric condition"
                                                                                                        },
                                                                                                        "right": {
                                                                                                          "OR": {
                                                                                                            "left": {
                                                                                                              "raw_text": "(e.g., suicidal ideation) or chronic alcohol"
                                                                                                            },
                                                                                                            "right": {
                                                                                                              "raw_text": "or drug abuse problem, determined from the patient's medical history, which, in the opinion of the investigator, may pose a threat to patient compliance"
                                                                                                            }
                                                                                                          }
                                                                                                        }
                                                                                                      }
                                                                                                    },
                                                                                                    "right": {
                                                                                                      "AND": {
                                                                                                        "left": {
                                                                                                          "raw_text": "19. Use of a platelet-derived growth factor within 28 days before screening"
                                                                                                        },
                                                                                                        "right": {
                                                                                                          "AND": {
                                                                                                            "left": {
                                                                                                              "OR": {
                                                                                                                "left": {
                                                                                                                  "raw_text": "20. Use of any investigational"
                                                                                                                },
                                                                                                                "right": {
                                                                                                                  "raw_text": "drug or therapy within 28 days before screening"
                                                                                                                }
                                                                                                              }
                                                                                                            },
                                                                                                            "right": {
                                                                                                              "AND": {
                                                                                                                "left": {
                                                                                                                  "raw_text": "21. Has any other factor which may, in the opinion of the investigator, compromise participation and/or follow-up in the study"
                                                                                                                }
                                                                                                              }
                                                                                                            }
                                                                                                          }
                                                                                                        }
                                                                                                      }
                                                                                                    }
                                                                                                  }
                                                                                                }
                                                                                              }
                                                                                            }
                                                                                          }
                                                                                        }
                                                                                      }
                                                                                    }
                                                                                  }
                                                                                }
                                                                              }
                                                                            }
                                                                          }
                                                                        }
                                                                      }
                                                                    }
                                                                  }
                                                                }
                                                              }
                                                            }
                                                          }
                                                        }
                                                      }
                                                    }
                                                  }
                                                }
                                              }
                                            }
                                          }
                                        }
                                      }
                                    }
                                  }
                                }
                              }
                            }
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
