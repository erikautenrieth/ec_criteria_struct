{
  "AND": {
    "left": {
      "raw_text": "1. Age 18 years or older"
    },
    "right": {
      "AND": {
        "left": {
          "AND": {
            "left": {
              "raw_text": "2. Diagnosis of venous leg ulcer(s)"
            },
            "right": {
              "AND": {
                "left": {
                  "raw_text": ", as clinically determined by the investigator by a positive venous reflux test"
                },
                "right": {
                  "NOT": {
                    "left": {
                      "raw_text": "not adequately responded to conventional ulcer therapy."
                    }
                  }
                }
              }
            }
          }
        },
        "right": {
          "AND": {
            "left": {
              "raw_text": "3. Designated venous leg ulcer meets the following criteria at both the screening and baseline visits. If the patient has multiple ulcers, at least one ulcer must meet the following criteria at both the screening and baseline visits:"
            },
            "right": {
              "AND": {
                "left": {
                  "raw_text": "1. Present for at least 4 weeks"
                },
                "right": {
                  "AND": {
                    "left": {
                      "raw_text": "2. CEAP Classification Stage 6"
                    },
                    "right": {
                      "AND": {
                        "left": {
                          "AND": {
                            "left": {
                              "raw_text": "3. Surface ulcer"
                            },
                            "right": {
                              "raw_text": "with an area > 15cm2 post debridement"
                            }
                          }
                        },
                        "right": {
                          "AND": {
                            "left": {
                              "AND": {
                                "left": {
                                  "raw_text": "4. Viable, granulating wound"
                                },
                                "right": {
                                  "raw_text": "(investigator discretion)"
                                }
                              }
                            },
                            "right": {
                              "AND": {
                                "left": {
                                  "OR": {
                                    "left": {
                                      "raw_text": "4. Ulcers that extend"
                                    },
                                    "right": {
                                      "OR": {
                                        "left": {
                                          "raw_text": "through the epidermis"
                                        },
                                        "right": {
                                          "AND": {
                                            "left": {
                                              "raw_text": "but not through the muscle, tendon, or bone (Stage II or III ulcers"
                                            },
                                            "right": {
                                              "raw_text": "as defined by the IAET)."
                                            }
                                          }
                                        }
                                      }
                                    }
                                  }
                                },
                                "right": {
                                  "AND": {
                                    "left": {
                                      "OR": {
                                        "left": {
                                          "raw_text": "5. Female patients of childbearing potential must have a negative pregnancy test"
                                        },
                                        "right": {
                                          "OR": {
                                            "left": {
                                              "raw_text": "at screening and must agree to use hormonal contraceptive"
                                            },
                                            "right": {
                                              "OR": {
                                                "left": {
                                                  "raw_text": ", intrauterine device"
                                                },
                                                "right": {
                                                  "OR": {
                                                    "left": {
                                                      "raw_text": ", diaphragm with spermicide"
                                                    },
                                                    "right": {
                                                      "OR": {
                                                        "left": {
                                                          "raw_text": ", condom with spermicide"
                                                        },
                                                        "right": {
                                                          "raw_text": ", or abstinence throughout until 2 weeks after the last administration of study drug"
                                                        }
                                                      }
                                                    }
                                                  }
                                                }
                                              }
                                            }
                                          }
                                        }
                                      }
                                    },
                                    "right": {
                                      "AND": {
                                        "left": {
                                          "raw_text": "6. Signed informed consent"
                                        }
                                      }
                                    }
                                  }
                                }
                              }
                            }
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
