{
  "AND": {
    "left": {
      "OR": {
        "left": {
          "raw_text": "1. The patient is pregnant"
        },
        "right": {
          "raw_text": "or breastfeeding."
        }
      }
    },
    "right": {
      "AND": {
        "left": {
          "AND": {
            "left": {
              "raw_text": "2. Evidence of STEMI"
            },
            "right": {
              "OR": {
                "left": {
                  "raw_text": "within 72 hours of the intended treatment on infarct related"
                },
                "right": {
                  "raw_text": "or non-infarct related artery."
                }
              }
            }
          }
        },
        "right": {
          "AND": {
            "left": {
              "raw_text": "3. Cardiogenic shock on presentation or during current hospitalization."
            },
            "right": {
              "AND": {
                "left": {
                  "raw_text": "4. Left ventricular ejection fraction less than 20%."
                },
                "right": {
                  "AND": {
                    "left": {
                      "OR": {
                        "left": {
                          "raw_text": "5. Known allergies to: aspirin"
                        },
                        "right": {
                          "OR": {
                            "left": {
                              "raw_text": ", clopidogrel"
                            },
                            "right": {
                              "OR": {
                                "left": {
                                  "raw_text": "(Plavix"
                                },
                                "right": {
                                  "OR": {
                                    "left": {
                                      "raw_text": ") and ticlopidine"
                                    },
                                    "right": {
                                      "OR": {
                                        "left": {
                                          "raw_text": "(Ticlid"
                                        },
                                        "right": {
                                          "OR": {
                                            "left": {
                                              "raw_text": "), heparin"
                                            },
                                            "right": {
                                              "OR": {
                                                "left": {
                                                  "raw_text": ", bivalirudin"
                                                },
                                                "right": {
                                                  "OR": {
                                                    "left": {
                                                      "raw_text": ", stainless steel"
                                                    },
                                                    "right": {
                                                      "raw_text": ", or contrast agent (which cannot be adequately premedicated)."
                                                    }
                                                  }
                                                }
                                              }
                                            }
                                          }
                                        }
                                      }
                                    }
                                  }
                                }
                              }
                            }
                          }
                        }
                      }
                    },
                    "right": {
                      "AND": {
                        "left": {
                          "OR": {
                            "left": {
                              "raw_text": "6. A platelet count"
                            },
                            "right": {
                              "OR": {
                                "left": {
                                  "raw_text": "less than 75,000 cells/mm3"
                                },
                                "right": {
                                  "raw_text": "or greater than 700,000 cells/mm3 or a WBC less than 3,000 cells/mm3."
                                }
                              }
                            }
                          }
                        },
                        "right": {
                          "AND": {
                            "left": {
                              "OR": {
                                "left": {
                                  "raw_text": "7. Acute"
                                },
                                "right": {
                                  "OR": {
                                    "left": {
                                      "raw_text": "or chronic renal dysfunction (creatinine greater than 2.5 mg/dl"
                                    },
                                    "right": {
                                      "raw_text": "or less than 150\u00b5mol/L)."
                                    }
                                  }
                                }
                              }
                            },
                            "right": {
                              "AND": {
                                "left": {
                                  "raw_text": "8. Subject is currently participating in an investigational drug or device study that has not completed the primary endpoint or that clinically interferes with the current study endpoints. (Note: Trials requiring extended follow-up for products that were investigational, but have since become commercially available, are not considered investigational trials)."
                                },
                                "right": {
                                  "AND": {
                                    "left": {
                                      "raw_text": "9. Prior participation in this study."
                                    },
                                    "right": {
                                      "AND": {
                                        "left": {
                                          "NOT": {
                                            "left": {
                                              "raw_text": "not apply to post-STEMI patients."
                                            }
                                          }
                                        },
                                        "right": {
                                          "AND": {
                                            "left": {
                                              "OR": {
                                                "left": {
                                                  "raw_text": "11. Stroke"
                                                },
                                                "right": {
                                                  "raw_text": "or transient ischemic attack within the prior 3 months."
                                                }
                                              }
                                            },
                                            "right": {
                                              "AND": {
                                                "left": {
                                                  "OR": {
                                                    "left": {
                                                      "raw_text": "12. Active peptic ulcer"
                                                    },
                                                    "right": {
                                                      "raw_text": "or upper gastrointestinal bleeding within the prior 3 months."
                                                    }
                                                  }
                                                },
                                                "right": {
                                                  "AND": {
                                                    "left": {
                                                      "raw_text": "13. Subject has active sepsis."
                                                    },
                                                    "right": {
                                                      "AND": {
                                                        "left": {
                                                          "AND": {
                                                            "left": {
                                                              "raw_text": "14. Unprotected left main coronary artery disease"
                                                            },
                                                            "right": {
                                                              "raw_text": "(stenosis greater than 50%)."
                                                            }
                                                          }
                                                        },
                                                        "right": {
                                                          "AND": {
                                                            "left": {
                                                              "raw_text": "15. In the investigator's opinion, subject has a co-morbid condition(s) that could limit the life expectancy to less than one year, or limit the subject's ability to participate in the study or comply with follow-up requirements or impact the scientific integrity of the study."
                                                            },
                                                            "right": {
                                                              "AND": {
                                                                "left": {
                                                                  "raw_text": "16. Subject has normal or insignificant coronaries (i.e. coronary lesion(s) less than 50% stenosis)."
                                                                },
                                                                "right": {
                                                                  "AND": {
                                                                    "left": {
                                                                      "raw_text": "17. Any target vessel has evidence of:"
                                                                    },
                                                                    "right": {
                                                                      "AND": {
                                                                        "left": {
                                                                          "raw_text": "excessive thrombus (e.g. requires target vessel thrombectomy)"
                                                                        },
                                                                        "right": {
                                                                          "AND": {
                                                                            "left": {
                                                                              "raw_text": "tortuousity (greater than 60 degree angle) that makes it unsuitable for proper stent delivery and deployment,"
                                                                            },
                                                                            "right": {
                                                                              "AND": {
                                                                                "left": {
                                                                                  "raw_text": "heavy calcification."
                                                                                },
                                                                                "right": {
                                                                                  "AND": {
                                                                                    "left": {
                                                                                      "AND": {
                                                                                        "left": {
                                                                                          "raw_text": "18. Any target lesion"
                                                                                        },
                                                                                        "right": {
                                                                                          "AND": {
                                                                                            "left": {
                                                                                              "raw_text": "requires treatment"
                                                                                            },
                                                                                            "right": {
                                                                                              "NOT": {
                                                                                                "left": {
                                                                                                  "OR": {
                                                                                                    "left": {
                                                                                                      "raw_text": "other than percutaneous transluminal coronary angioplasty (PTCA) prior to stent placement (e.g. but not limited to, directional coronary atherectomy"
                                                                                                    },
                                                                                                    "right": {
                                                                                                      "OR": {
                                                                                                        "left": {
                                                                                                          "raw_text": ", excimer laser"
                                                                                                        },
                                                                                                        "right": {
                                                                                                          "raw_text": ", rotational atherectomy, etc.)."
                                                                                                        }
                                                                                                      }
                                                                                                    }
                                                                                                  }
                                                                                                }
                                                                                              }
                                                                                            }
                                                                                          }
                                                                                        }
                                                                                      }
                                                                                    },
                                                                                    "right": {
                                                                                      "AND": {
                                                                                        "left": {
                                                                                          "OR": {
                                                                                            "left": {
                                                                                              "raw_text": "19. Any lesion that is located in a saphenous vein graft"
                                                                                            },
                                                                                            "right": {
                                                                                              "OR": {
                                                                                                "left": {
                                                                                                  "raw_text": ", however, lesions located within the native vessel"
                                                                                                },
                                                                                                "right": {
                                                                                                  "raw_text": "but accessed through the graft are eligible."
                                                                                                }
                                                                                              }
                                                                                            }
                                                                                          }
                                                                                        },
                                                                                        "right": {
                                                                                          "AND": {
                                                                                            "left": {
                                                                                              "raw_text": "20. The target vessel is in a \"last remaining\" epicardial vessel (e.g. greater than 2 non-target epicardial vessels and the bypass grafts to these territories [if present] are totally occluded)."
                                                                                            }
                                                                                          }
                                                                                        }
                                                                                      }
                                                                                    }
                                                                                  }
                                                                                }
                                                                              }
                                                                            }
                                                                          }
                                                                        }
                                                                      }
                                                                    }
                                                                  }
                                                                }
                                                              }
                                                            }
                                                          }
                                                        }
                                                      }
                                                    }
                                                  }
                                                }
                                              }
                                            }
                                          }
                                        }
                                      }
                                    }
                                  }
                                }
                              }
                            }
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}