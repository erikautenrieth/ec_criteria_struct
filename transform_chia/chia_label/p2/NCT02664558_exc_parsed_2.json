                                                                                                                              "AND": {
                                                                                                                                "left": {
                                                                                                                                  "raw_text": "Exclusions Related to Cardiovascular Disease"
                                                                                                                                },
                                                                                                                                "right": {
                                                                                                                                  "raw_text": "1. History of uncontrolled hypertension"
                                                                                                                                }
                                                                                                                              }
                                                                                                                            },
                                                                                                                            "right": {
                                                                                                                              "raw_text": "2. Persistent hypotension at Screening."
                                                                                                                            }
                                                                                                                          }
                                                                                                                        },
                                                                                                                        "right": {
                                                                                                                          "OR": {
                                                                                                                            "left": {
                                                                                                                              "raw_text": "3. Evidence or history of left-sided heart disease"
                                                                                                                            },
                                                                                                                            "right": {
                                                                                                                              "OR": {
                                                                                                                                "left": {
                                                                                                                                  "raw_text": "and/or clinically significant cardiac disease"
                                                                                                                                },
                                                                                                                                "right": {
                                                                                                                                  "AND": {
                                                                                                                                    "left": {
                                                                                                                                      "raw_text": "in which pulmonary hypertension"
                                                                                                                                    },
                                                                                                                                    "right": {
                                                                                                                                      "raw_text": "is more likely WHO Group 2."
                                                                                                                                    }
                                                                                                                                  }
                                                                                                                                }
                                                                                                                              }
                                                                                                                            }
                                                                                                                          }
                                                                                                                        }
                                                                                                                      }
                                                                                                                    },
                                                                                                                    "right": {
                                                                                                                      "raw_text": "4. Acute decompensated heart failure within 1 month of Screening."
                                                                                                                    }
                                                                                                                  }
                                                                                                                },
                                                                                                                "right": {
                                                                                                                  "OR": {
                                                                                                                    "left": {
                                                                                                                      "raw_text": "5. Recent"
                                                                                                                    },
                                                                                                                    "right": {
                                                                                                                      "raw_text": "initiation (<8 weeks from Screening) or planned initiation of cardiopulmonary rehabilitation exercise program."
                                                                                                                    }
                                                                                                                  }
                                                                                                                }
                                                                                                              }
                                                                                                            },
                                                                                                            "right": {
                                                                                                              "raw_text": "Exclusions Related to Pulmonary Disease"
                                                                                                            }
                                                                                                          }
                                                                                                        },
                                                                                                        "right": {
                                                                                                          "OR": {
                                                                                                            "left": {
                                                                                                              "raw_text": "6. Newly diagnosed with PAH and not"
                                                                                                            },
                                                                                                            "right": {
                                                                                                              "raw_text": "on PAH-specific therapy."
                                                                                                            }
                                                                                                          }
                                                                                                        }
                                                                                                      }
                                                                                                    },
                                                                                                    "right": {
                                                                                                      "raw_text": "7. Pulmonary hypertension due to:"
                                                                                                    }
                                                                                                  }
                                                                                                },
                                                                                                "right": {
                                                                                                  "raw_text": "1. Uncorrected congenital systemic-to-pulmonary shunt."
                                                                                                }
                                                                                              }
                                                                                            },
                                                                                            "right": {
                                                                                              "OR": {
                                                                                                "left": {
                                                                                                  "raw_text": "2. Pulmonary veno-occlusive disease"
                                                                                                },
                                                                                                "right": {
                                                                                                  "raw_text": "and/or pulmonary capillary hemangiomatosis"
                                                                                                }
                                                                                              }
                                                                                            }
                                                                                          }
                                                                                        },
                                                                                        "right": {
                                                                                          "raw_text": "3. Persistent pulmonary hypertension of the newborn"
                                                                                        }
                                                                                      }
                                                                                    },
                                                                                    "right": {
                                                                                      "raw_text": "4. WHO clinical classification Groups 2-5"
                                                                                    }
                                                                                  }
                                                                                },
                                                                                "right": {
                                                                                  "OR": {
                                                                                    "left": {
                                                                                      "raw_text": "8. Evidence of significant airway"
                                                                                    },
                                                                                    "right": {
                                                                                      "raw_text": "and/or parenchymal lung disease."
                                                                                    }
                                                                                  }
                                                                                }
                                                                              }
                                                                            },
                                                                            "right": {
                                                                              "OR": {
                                                                                "left": {
                                                                                  "raw_text": "9. Chronic infection related to tuberculosis"
                                                                                },
                                                                                "right": {
                                                                                  "OR": {
                                                                                    "left": {
                                                                                      "raw_text": "or fungal"
                                                                                    },
                                                                                    "right": {
                                                                                      "raw_text": "or mycobacterial disease."
                                                                                    }
                                                                                  }
                                                                                }
                                                                              }
                                                                            }
                                                                          }
                                                                        },
                                                                        "right": {
                                                                          "raw_text": "Exclusions Based on Other Medical Conditions"
                                                                        }
                                                                      }
                                                                    },
                                                                    "right": {
                                                                      "OR": {
                                                                        "left": {
                                                                          "raw_text": "10. Chronic infections including, but not limited to tuberculosis (TB)"
                                                                        },
                                                                        "right": {
                                                                          "OR": {
                                                                            "left": {
                                                                              "raw_text": ", hepatitis B virus (HBV)"
                                                                            },
                                                                            "right": {
                                                                              "raw_text": "or hepatitis C virus (HCV)."
                                                                            }
                                                                          }
                                                                        }
                                                                      }
                                                                    }
                                                                  }
                                                                },
                                                                "right": {
                                                                  "OR": {
                                                                    "left": {
                                                                      "raw_text": "11. History of portal hypertension"
                                                                    },
                                                                    "right": {
                                                                      "OR": {
                                                                        "left": {
                                                                          "raw_text": "or chronic liver disease, including positive serology for infection"
                                                                        },
                                                                        "right": {
                                                                          "raw_text": "with HCV and/or HBV."
                                                                        }
                                                                      }
                                                                    }
                                                                  }
                                                                }
                                                              }
                                                            },
                                                            "right": {
                                                              "raw_text": "12. Evidence of active infection requiring intravenous or oral antibiotics within 4 weeks of Screening."
                                                            }
                                                          }
                                                        },
                                                        "right": {
                                                          "raw_text": "13. Body mass index \u226535.0 at Screening."
                                                        }
                                                      }
                                                    },
                                                    "right": {
                                                      "raw_text": "14. History of obstructive sleep apnea."
                                                    }
                                                  }
                                                },
                                                "right": {
                                                  "AND": {
                                                    "left": {
                                                      "raw_text": "15. History of malignancy within the last 5 years,"
                                                    },
                                                    "right": {
                                                      "NOT": {
                                                        "left": {
                                                          "NOT": {
                                                            "left": {
                                                              "AND": {
                                                                "left": {
                                                                  "raw_text": "except nonmelanoma skin cancer and cervical carcinoma in situ"
                                                                },
                                                                "right": {
                                                                  "raw_text": "treated with curative intent."
                                                                }
                                                              }
                                                            }
                                                          }
                                                        }
                                                      }
                                                    }
                                                  }
                                                }
                                              }
                                            },
                                            "right": {
                                              "OR": {
                                                "left": {
                                                  "raw_text": "16. Neuropsychiatric"
                                                },
                                                "right": {
                                                  "OR": {
                                                    "left": {
                                                      "raw_text": "disorders"
                                                    },
                                                    "right": {
                                                      "raw_text": "/symptoms or psychological conditions."
                                                    }
                                                  }
                                                }
                                              }
                                            }
                                          }
                                        },
                                        "right": {
                                          "OR": {
                                            "left": {
                                              "raw_text": "17. Pregnancy"
                                            },
                                            "right": {
                                              "raw_text": "or breast-feeding"
                                            }
                                          }
                                        }
                                      }
                                    },
                                    "right": {
                                      "OR": {
                                        "left": {
                                          "raw_text": "18. Prior treatment with B cell"
                                        },
                                        "right": {
                                          "OR": {
                                            "left": {
                                              "raw_text": "or lymphocyte-depleting agents (eg, rituximab"
                                            },
                                            "right": {
                                              "raw_text": ", Campath)"
                                            }
                                          }
                                        }
                                      }
                                    }
                                  }
                                },
                                "right": {
                                  "raw_text": "Exclusions Based on Concomitant Medication Use"
                                }
                              }
                            },
                            "right": {
                              "raw_text": "19. Concurrent regular use of another leukotriene pathway inhibitor, including over-the-counter medications or herbal remedies."
                            }
                          }
                        },
                        "right": {
                          "raw_text": "Exclusions Based on Laboratory Values"
                        }
                      }
                    },
                    "right": {
                      "raw_text": "20. Significant/chronic renal insufficiency."
                    }
                  }
                },
                "right": {
                  "raw_text": "21. Transaminases (alanine transaminase, aspartate transaminase) levels >3 \u00d7 upper limit of normal (ULN) and/or bilirubin level >2 \u00d7 ULN."
                }
              }
            },
            "right": {
              "raw_text": "22. Absolute neutrophil count <1500 mm3."
            }
          }
        },
        "right": {
          "raw_text": "23. Hemoglobin concentration <9 g/dL at Screening."
        }
      }
    },
    "right": {
      "AND": {
        "left": {
          "raw_text": "24. Hepatic dysfunction"
        },
        "right": {
          "raw_text": "as defined by Child-Pugh Class B or C"
        }
      }
    }
  }
