{
  "AND": {
    "left": {
      "OR": {
        "left": {
          "raw_text": "1. Patients with histologically"
        },
        "right": {
          "raw_text": "confirmed diagnosis of colorectal cancer presenting with unresectable stage IV (UICC) disease (primary tumor may be present)"
        }
      }
    },
    "right": {
      "AND": {
        "left": {
          "OR": {
            "left": {
              "raw_text": "2. Patients who are feasible for treatment with FOLFOX (prior adjuvant"
            },
            "right": {
              "raw_text": "or palliative treatment is allowed)"
            }
          }
        },
        "right": {
          "AND": {
            "left": {
              "raw_text": "3. ECOG Performance status \u2264 1"
            },
            "right": {
              "AND": {
                "left": {
                  "raw_text": "4. Life expectancy > 3 months"
                },
                "right": {
                  "AND": {
                    "left": {
                      "raw_text": "5. Age \u226518 years"
                    },
                    "right": {
                      "AND": {
                        "left": {
                          "raw_text": "6. Haematologic function as follows (5% deviation allowed):"
                        },
                        "right": {
                          "AND": {
                            "left": {
                              "raw_text": "ANC \u2265 1.5 x 109/L"
                            },
                            "right": {
                              "AND": {
                                "left": {
                                  "raw_text": "platelets \u2265 100 x109/L"
                                },
                                "right": {
                                  "AND": {
                                    "left": {
                                      "OR": {
                                        "left": {
                                          "raw_text": "hemoglobin \u2265"
                                        },
                                        "right": {
                                          "raw_text": "9 g/dl or 5.59 mmol/l"
                                        }
                                      }
                                    },
                                    "right": {
                                      "AND": {
                                        "left": {
                                          "raw_text": "7. Adequate liver function as follows (10% deviation allowed)"
                                        },
                                        "right": {
                                          "AND": {
                                            "left": {
                                              "raw_text": "serum alanine transaminase (ALT) \u2264 2.5 x ULN (in case of liver metastases < 5 x ULN)"
                                            },
                                            "right": {
                                              "AND": {
                                                "left": {
                                                  "OR": {
                                                    "left": {
                                                      "raw_text": "total bilirubin"
                                                    },
                                                    "right": {
                                                      "raw_text": "\u2264 1.5 x ULN (patients with Gilbert's syndrome total bilirubin \u22642.5 x ULN)"
                                                    }
                                                  }
                                                },
                                                "right": {
                                                  "AND": {
                                                    "left": {
                                                      "raw_text": "8. Adequate renal function as follows (10% deviation allowed)"
                                                    },
                                                    "right": {
                                                      "AND": {
                                                        "left": {
                                                          "raw_text": "\u00b7 creatinine \u2264 1.5 x ULN"
                                                        },
                                                        "right": {
                                                          "AND": {
                                                            "left": {
                                                              "raw_text": "9. Signed written informed consent"
                                                            },
                                                            "right": {
                                                              "AND": {
                                                                "left": {
                                                                  "AND": {
                                                                    "left": {
                                                                      "raw_text": "10. Women of child-bearing potential"
                                                                    },
                                                                    "right": {
                                                                      "raw_text": "must have a negative pregnancy test"
                                                                    }
                                                                  }
                                                                }
                                                              }
                                                            }
                                                          }
                                                        }
                                                      }
                                                    }
                                                  }
                                                }
                                              }
                                            }
                                          }
                                        }
