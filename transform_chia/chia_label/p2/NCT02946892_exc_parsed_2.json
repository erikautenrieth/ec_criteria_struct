{
  "AND": {
    "left": {
      "raw_text": "The use of beta blockers within 2 months of randomization"
    },
    "right": {
      "AND": {
        "left": {
          "OR": {
            "left": {
              "raw_text": "Patients actively listed for transplantation"
            },
            "right": {
              "OR": {
                "left": {
                  "raw_text": "at time of entry into the study or anticipated to undergo heart transplantation"
                },
                "right": {
                  "OR": {
                    "left": {
                      "raw_text": ", interventional catheterization"
                    },
                    "right": {
                      "raw_text": ", or corrective cardiac surgery during the 7 months following entry into the study"
                    }
                  }
                }
              }
            }
          }
        },
        "right": {
          "AND": {
            "left": {
              "OR": {
                "left": {
                  "raw_text": "Sustained"
                },
                "right": {
                  "OR": {
                    "left": {
                      "raw_text": "or symptomatic ventricular dysrhythmias"
                    },
                    "right": {
                      "OR": {
                        "left": {
                          "raw_text": "uncontrolled by"
                        },
                        "right": {
                          "OR": {
                            "left": {
                              "raw_text": "drug therapy or the use of an implantable defibrillator, and/or significant cardiac conduction defects, e.g., 2nd degree"
                            },
                            "right": {
                              "OR": {
                                "left": {
                                  "raw_text": "or 3rd degree AV block"
                                },
                                "right": {
                                  "AND": {
                                    "left": {
                                      "raw_text": ", or sick sinus syndrome"
                                    },
                                    "right": {
                                      "NOT": {
                                        "left": {
                                          "raw_text": "unless a functioning pacemaker is in place"
                                        }
                                      }
                                    }
                                  }
                                }
                              }
                            }
                          }
                        }
                      }
                    }
                  }
                }
              }
            },
            "right": {
              "AND": {
                "left": {
                  "OR": {
                    "left": {
                      "raw_text": "Uncorrected obstructive"
                    },
                    "right": {
                      "OR": {
                        "left": {
                          "raw_text": "or severe regurgitant valve disease"
                        },
                        "right": {
                          "OR": {
                            "left": {
                              "raw_text": ", nondilated cardiomyopathy"
                            },
                            "right": {
                              "raw_text": ", or significant systemic ventricular outflow obstruction"
                            }
                          }
                        }
                      }
                    }
                  }
                },
                "right": {
                  "AND": {
                    "left": {
                      "OR": {
                        "left": {
                          "raw_text": "Known renovascular hypertension"
                        },
                        "right": {
                          "OR": {
                            "left": {
                              "raw_text": "or evidence of pulmonary hypertension (pulmonary vascular resistance > 6 Wood units) unresponsive to vasodilator agents such as oxygen"
                            },
                            "right": {
                              "OR": {
                                "left": {
                                  "raw_text": ", nitroprusside"
                                },
                                "right": {
                                  "raw_text": ", or nitric oxide"
                                }
                              }
                            }
                          }
                        }
                      }
                    },
                    "right": {
                      "AND": {
                        "left": {
                          "OR": {
                            "left": {
                              "raw_text": "History"
                            },
                            "right": {
                              "OR": {
                                "left": {
                                  "raw_text": "or current clinical evidence of moderate-to-severe fixed obstructive pulmonary disease"
                                },
                                "right": {
                                  "OR": {
                                    "left": {
                                      "raw_text": "or severe reactive airway diseases (e.g., asthma) requiring hospitalization"
                                    },
                                    "right": {
                                      "raw_text": "within the past 2 years or patient currently using long-term inhaled bronchodilators"
                                    }
                                  }
                                }
                              }
                            }
                          }
                        },
                        "right": {
                          "AND": {
                            "left": {
                              "OR": {
                                "left": {
                                  "raw_text": "Renal"
                                },
                                "right": {
                                  "OR": {
                                    "left": {
                                      "raw_text": ", hepatic"
                                    },
                                    "right": {
                                      "OR": {
                                        "left": {
                                          "raw_text": ", gastrointestinal"
                                        },
                                        "right": {
                                          "AND": {
                                            "left": {
                                              "raw_text": ", or biliary disorder that could impair absorption, metabolism or excretion"
                                            },
                                            "right": {
                                              "raw_text": "of orally administered medication"
                                            }
                                          }
                                        }
                                      }
                                    }
                                  }
                                }
                              }
                            },
                            "right": {
                              "AND": {
                                "left": {
                                  "OR": {
                                    "left": {
                                      "raw_text": "Concurrent terminal illness"
                                    },
                                    "right": {
                                      "OR": {
                                        "left": {
                                          "raw_text": "or other severe disease"
                                        },
                                        "right": {
                                          "raw_text": "(e.g., active neoplasm) or other significant laboratory value(s) which, in the opinion of the investigator, could preclude participation or survival"
                                        }
                                      }
                                    }
                                  }
                                },
                                "right": {
                                  "AND": {
                                    "left": {
                                      "OR": {
                                        "left": {
                                          "raw_text": "Endocrine disorders such as primary aldosteronism"
                                        },
                                        "right": {
                                          "OR": {
                                            "left": {
                                              "raw_text": ", pheochromocytoma"
                                            },
                                            "right": {
                                              "OR": {
                                                "left": {
                                                  "raw_text": ", hyper"
                                                },
                                                "right": {
                                                  "OR": {
                                                    "left": {
                                                      "raw_text": "- or hypothyroidism"
                                                    },
                                                    "right": {
                                                      "raw_text": ", insulin-dependent diabetes mellitus"
                                                    }
                                                  }
                                                }
                                              }
                                            }
                                          }
                                        }
                                      }
                                    },
                                    "right": {
                                      "AND": {
                                        "left": {
                                          "OR": {
                                            "left": {
                                              "raw_text": "Unwillingness"
                                            },
                                            "right": {
                                              "OR": {
                                                "left": {
                                                  "raw_text": "or inability"
                                                },
                                                "right": {
                                                  "OR": {
                                                    "left": {
                                                      "raw_text": "to cooperate"
                                                    },
                                                    "right": {
                                                      "raw_text": ", or for the parents or guardians to give consent, or for the child to give assent, or any condition of sufficient severity to impair cooperation in the study"
                                                    }
                                                  }
                                                }
                                              }
                                            }
                                          }
                                        },
                                        "right": {
                                          "AND": {
                                            "left": {
                                              "OR": {
                                                "left": {
                                                  "raw_text": "Pregnancy"
                                                },
                                                "right": {
                                                  "OR": {
                                                    "left": {
                                                      "raw_text": "or possible pregnancy"
                                                    },
                                                    "right": {
                                                      "OR": {
                                                        "left": {
                                                          "raw_text": "at time of randomization, or female of child bearing potential who are lactating"
                                                        },
                                                        "right": {
                                                          "NOT": {
                                                            "left": {
                                                              "OR": {
                                                                "left": {
                                                                  "raw_text": "not taking adequate contraceptive precautions (e.g., intrauterine device"
                                                                },
                                                                "right": {
                                                                  "raw_text": "or oral contraceptives for 3 months prior to entry into the study)"
                                                                }
                                                              }
                                                            }
                                                          }
                                                        }
                                                      }
                                                    }
                                                  }
                                                }
                                              }
                                            },
                                            "right": {
                                              "AND": {
                                                "left": {
                                                  "OR": {
                                                    "left": {
                                                      "raw_text": "Use of an investigational drug within 30 days of randomization"
                                                    },
                                                    "right": {
                                                      "raw_text": ", or within 5 half-lives of the investigational drug (the longer period will apply)"
                                                    }
                                                  }
                                                },
                                                "right": {
                                                  "AND": {
                                                    "left": {
                                                      "OR": {
                                                        "left": {
                                                          "raw_text": "History of drug sensitivity"
                                                        },
                                                        "right": {
                                                          "OR": {
                                                            "left": {
                                                              "raw_text": "or allergic reaction to alpha-blockers"
                                                            },
                                                            "right": {
                                                              "raw_text": "or beta-blockers"
                                                            }
                                                          }
                                                        }
                                                      }
                                                    },
                                                    "right": {
                                                      "AND": {
                                                        "left": {
                                                          "OR": {
                                                            "left": {
                                                              "raw_text": "Use of any of the following medications within two weeks of randomization: MAO inhibitors"
                                                            },
                                                            "right": {
                                                              "OR": {
                                                                "left": {
                                                                  "raw_text": ", Calcium channel blockers"
                                                                },
                                                                "right": {
                                                                  "OR": {
                                                                    "left": {
                                                                      "raw_text": ", alpha blockers"
                                                                    },
                                                                    "right": {
                                                                      "OR": {
                                                                        "left": {
                                                                          "raw_text": ", beta blockers"
                                                                        },
                                                                        "right": {
                                                                          "OR": {
                                                                            "left": {
                                                                              "raw_text": ", disopyramide"
                                                                            },
                                                                            "right": {
                                                                              "OR": {
                                                                                "left": {
                                                                                  "raw_text": ", flecainide"
                                                                                },
                                                                                "right": {
                                                                                  "OR": {
                                                                                    "left": {
                                                                                      "raw_text": ", encainide"
                                                                                    },
                                                                                    "right": {
                                                                                      "OR": {
                                                                                        "left": {
                                                                                          "raw_text": ", moricizine"
                                                                                        },
                                                                                        "right": {
                                                                                          "OR": {
                                                                                            "left": {
                                                                                              "raw_text": ", propafenone"
                                                                                            },
                                                                                            "right": {
                                                                                              "OR": {
                                                                                                "left": {
                                                                                                  "raw_text": ", sotalol"
                                                                                                },
                                                                                                "right": {
                                                                                                  "raw_text": ", or beta adrenergic agonists"
                                                                                                }
                                                                                              }
                                                                                            }
                                                                                          }
                                                                                        }
                                                                                      }
                                                                                    }
                                                                                  }
                                                                                }
                                                                              }
                                                                            }
                                                                          }
                                                                        }
                                                                      }
                                                                    }
                                                                  }
                                                                }
                                                              }
                                                            }
                                                          }
                                                        },
                                                        "right": {
                                                          "AND": {
                                                            "left": {
                                                              "OR": {
                                                                "left": {
                                                                  "raw_text": "Hospital admission for protein losing enteropathy"
                                                                },
                                                                "right": {
                                                                  "raw_text": "or plastic bronchitis within 3 months of randomization"
                                                                }
                                                              }
                                                            },
                                                            "right": {
                                                              "AND": {
                                                                "left": {
                                                                  "OR": {
                                                                    "left": {
                                                                      "raw_text": "Active"
                                                                    },
                                                                    "right": {
                                                                      "OR": {
                                                                        "left": {
                                                                          "raw_text": "and/or chronic protein losing enteropathy"
                                                                        },
                                                                        "right": {
                                                                          "AND": {
                                                                            "left": {
                                                                              "raw_text": "or plastic bronchitis"
                                                                            },
                                                                            "right": {
                                                                              "raw_text": "(on inhaled medication to control the plastic bronchitis)."
                                                                            }
                                                                          }
                                                                        }
                                                                      }
                                                                    }
                                                                  }
                                                                },
                                                                "right": {
                                                                  "AND": {
                                                                    "left": {
                                                                      "raw_text": "Hypoalbuminemia defined as serum albumin <2.0g/dL"
                                                                    },
                                                                    "right": {
                                                                      "AND": {
                                                                        "left": {
                                                                          "AND": {
                                                                            "left": {
                                                                              "raw_text": "Renal dysfunction"
                                                                            },
                                                                            "right": {
                                                                              "raw_text": "defined as serum creatinine >2.0mg/dL"
                                                                            }
                                                                          }
                                                                        },
                                                                        "right": {
                                                                          "AND": {
                                                                            "left": {
                                                                              "OR": {
                                                                                "left": {
                                                                                  "raw_text": "Hepatic dysfunction defined as serum AST"
                                                                                },
                                                                                "right": {
                                                                                  "raw_text": "and/or ALT> 3 times upper limit of normal (approximately 120 IU/L however, will vary depending on age),"
                                                                                }
                                                                              }
                                                                            },
                                                                            "right": {
                                                                              "AND": {
                                                                                "left": {
                                                                                  "OR": {
                                                                                    "left": {
                                                                                      "raw_text": "Significant anemia"
                                                                                    },
                                                                                    "right": {
                                                                                      "OR": {
                                                                                        "left": {
                                                                                          "raw_text": "or polycythemia defined as hemoglobin"
                                                                                        },
                                                                                        "right": {
                                                                                          "raw_text": ">18gm/dL or hemoglobin <7gm/dL"
                                                                                        }
                                                                                      }
                                                                                    }
                                                                                  }
                                                                                },
                                                                                "right": {
                                                                                  "AND": {
                                                                                    "left": {
                                                                                      "raw_text": "Severely elevated serum BNP defined as BNP>300pg/ml"
                                                                                    }
                                                                                  }
                                                                                }
                                                                              }
                                                                            }
                                                                          }
                                                                        }
                                                                      }
                                                                    }
                                                                  }
                                                                }
                                                              }
                                                            }
                                                          }
                                                        }
                                                      }
                                                    }
                                                  }
                                                }
                                              }
                                            }
                                          }
                                        }
                                      }
                                    }
                                  }
                                }
                              }
                            }
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
