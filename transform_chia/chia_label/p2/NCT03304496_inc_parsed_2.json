                                }
                              }
                            }
                          }
                        }
                      }
                    },
                    "right": {
                      "AND": {
                        "left": {
                          "raw_text": "Patients may have any of the following indications"
                        },
                        "right": {
                          "OR": {
                            "left": {
                              "raw_text": "for cardiac catheterization: Thoracic pain"
                            },
                            "right": {
