                                "left": {
                                  "raw_text": "under study. Stable chronic coronary disease"
                                },
                                "right": {
                                  "OR": {
                                    "left": {
                                      "raw_text": ". Acute myocardial infarction"
                                    },
                                    "right": {
                                      "AND": {
                                        "left": {
                                          "raw_text": "with ST segment elevation, not perfused ("
                                        },
                                        "right": {
                                          "NOT": {
                                            "left": {
                                              "OR": {
                                                "left": {
                                                  "raw_text": "without timely reperfusion therapy) with less than 4 weeks of evolution. Acute myocardial infarction"
                                                },
                                                "right": {
                                                  "OR": {
                                                    "left": {
                                                      "raw_text": "with ST-segment elevation, successful thrombolytic therapy, which will undergo drug-invasive therapy. Acute myocardial infarction"
                                                    },
                                                    "right": {
                                                      "NOT": {
                                                        "left": {
                                                          "OR": {
                                                            "left": {
                                                              "raw_text": "without ST segment elevation. Unstable angina"
                                                            },
                                                            "right": {
                                                              "OR": {
                                                                "left": {
                                                                  "raw_text": ". Any acute coronary syndrome"
                                                                },
                                                                "right": {
                                                                  "OR": {
                                                                    "left": {
                                                                      "raw_text": ", to intervene non-infarct-related artery. Disease"
                                                                    },
                                                                    "right": {
                                                                      "OR": {
                                                                        "left": {
                                                                          "raw_text": "of any heart valve. Myocarditis"
                                                                        },
                                                                        "right": {
                                                                          "OR": {
                                                                            "left": {
                                                                              "raw_text": "or pericarditis"
                                                                            },
                                                                            "right": {
