{
  "AND": {
    "left": {
      "raw_text": "Subjects must:"
    },
    "right": {
      "AND": {
        "left": {
          "raw_text": "1. Be able to give valid informed consent"
        },
        "right": {
          "AND": {
            "left": {
              "raw_text": "2. Be 18 55 years of age."
            },
            "right": {
              "AND": {
                "left": {
                  "raw_text": "1. Justification: Many neural processes change with age, and these changes could introduce unwanted variability in both behavioral and MRI signals. In addition, the risk of difficult-to-detect medical abnormalities such as silent cerebral infarcts increases with age."
                },
                "right": {
                  "AND": {
                    "left": {
                      "raw_text": "2. Screening tool: History. Government-issued forms of identification (e.g. driver s license, birth certificate) will be required when participant appears to be out of age range."
                    },
                    "right": {
                      "AND": {
                        "left": {
                          "raw_text": "3. Be in good health."
                        },
                        "right": {
                          "AND": {
                            "left": {
                              "raw_text": "1. Justification: Many illnesses may alter neural functioning as well as fMRI signals."
                            },
                            "right": {
                              "AND": {
                                "left": {
                                  "NOT": {
                                    "left": {
                                      "OR": {
                                        "left": {
                                          "raw_text": "disqualify individuals: Cholesterol"
                                        },
                                        "right": {
                                          "OR": {
                                            "left": {
                                              "raw_text": ">250 mg/dl, Hemoglobin"
                                            },
                                            "right": {
                                              "OR": {
                                                "left": {
                                                  "raw_text": "< 10.5 g/dl, WBC"
                                                },
                                                "right": {
                                                  "OR": {
                                                    "left": {
                                                      "raw_text": "< 2400/microl, LFTs"
                                                    },
                                                    "right": {
                                                      "OR": {
                                                        "left": {
                                                          "raw_text": "> 3Xnormal, HCG"
                                                        },
                                                        "right": {
                                                          "OR": {
                                                            "left": {
                                                              "raw_text": "positive, Casual serum glucose"
                                                            },
                                                            "right": {
                                                              "AND": {
                                                                "left": {
                                                                  "raw_text": "> 200 mg/dl, Urine protein > 1+. The MAI will retain discretion to exclude at less extreme values, depending on the clinical presentation. (Serum glucose over 140 mg/dl"
                                                                },
                                                                "right": {
                                                                  "raw_text": "will be followed up with a fasting serum glucose assessment. Those with fasting glucose below 100 mg/dl may be considered for the protocol. Others will be rejected and referred for work-up.) MAI will make the final judgment on any questionable lab results."
                                                                }
                                                              }
                                                            }
                                                          }
                                                        }
                                                      }
                                                    }
                                                  }
                                                }
                                              }
                                            }
                                          }
                                        }
                                      }
                                    }
                                  }
                                },
                                "right": {
                                  "AND": {
                                    "left": {
                                      "raw_text": "4. Right-handed."
                                    },
                                    "right": {
                                      "AND": {
                                        "left": {
                                          "raw_text": "1. Justification: Using right-handed individuals will reduce variability in BOLD MRI data."
                                        },
                                        "right": {
                                          "AND": {
                                            "left": {
                                              "raw_text": "2. Screening tool: Edinburgh Handedness Inventory."
                                            },
                                            "right": {
                                              "AND": {
                                                "left": {
                                                  "raw_text": "5. Estimated IQ greater than or equal to 85"
                                                },
                                                "right": {
                                                  "AND": {
                                                    "left": {
                                                      "raw_text": "1. Justification: Subjects must be able to perform a cognitively challenging task to a high standard."
                                                    },
                                                    "right": {
                                                      "AND": {
                                                        "left": {
                                                          "raw_text": "2. Screening tool: Wechsler Abbreviated Scale of Intelligence."
                                                        }
                                                      }
                                                    }
                                                  }
                                                }
                                              }
                                            }
                                          }
                                        }
                                      }
                                    }
                                  }
                                }
                              }
                            }
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}